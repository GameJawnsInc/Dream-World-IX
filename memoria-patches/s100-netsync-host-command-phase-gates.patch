+        // ============================================================================ the command phase (B4 stage 1)
+        // [ff9mapkit netsync B4] stage 1: "the battle is asking for commands right now". Never throws: a torn-down
+        // HUD or battle system reads CLOSED, which is the safe answer for both consumers (no Ready bit, no intake).
+        private static Boolean HostCommandPhaseOpen(BattleHUD hud, FF9StateBattleSystem btlsys)
+        {
+            try
+            {
+                return hud != null && btlsys != null && btlsys.btl_phase == FF9StateBattleSystem.PHASE_NORMAL
+                       && hud.FF9BMenu_IsEnable();
+            }
+            catch
+            {
+                return false;
+            }
+        }
+
+        // An own battle's rising edge (both pumps, beside the nonce bump): the edge detector starts CLOSED (an
+        // intro is never the command phase) and the once-per-battle refusal lines re-arm.
+        private static void NoteOwnBattleStart()
+        {
+            _hostPhaseOpen = false;
+            _rosterForceTries = 0;
+            _rosterLagFrames = -1;
+            _refuseLogged.Clear();
+        }
+
+        // An own battle's falling edge (Pump's else block; SelfTestPump through Reset): the harness's "last
+        // sample" reads -1 between battles instead of a finished fight's values.
+        private static void NoteOwnBattleEnd()
+        {
+            _hostPhaseOpen = false;
+            _rosterForceTries = 0;
+            _lastSampleFlags = -1;
+            _lastReadyMask = -1;
+        }
+
+        // One read of the command phase per pump tick (both pumps). An EDGE returns true and the caller samples
+        // NOW, so the Ready bit's falling edge reaches the wire inside a frame instead of up to SampleMs late; an
+        // OPENING also arms the roster rebuild, so the first turn never waits out RosterMs. With the calibration
+        // lever pulled it only tracks (the harness lag still measures the pre-stage cadence).
+        private static Boolean TrackCommandPhase()
+        {
+            Boolean open = HostCommandPhaseOpen(UIManager.Battle, FF9StateSystem.Battle.FF9Battle);
+            if (open == _hostPhaseOpen)
+                return false;
+            _hostPhaseOpen = open;
+            _rosterForceTries = 0;
+            if (open)
+            {
+                _phaseOpenFrame = UnityEngine.Time.frameCount;
+                _rosterLagFrames = -1;
+            }
+            if (!HostGatesOn)
+                return false;
+            if (open)
+                _rosterForceTries = RosterForceTries;
+            return true;
+        }
+
+        // After every roster build attempt: a shipped roster ends the opening-edge retries and records how many
+        // frames the opening waited for it; a null one spends a retry.
+        private static void NoteRosterAttempt(Boolean built)
+        {
+            if (built)
+            {
+                _rosterForceTries = 0;
+                if (_rosterLagFrames < 0 && _hostPhaseOpen && _phaseOpenFrame >= 0)
+                    _rosterLagFrames = UnityEngine.Time.frameCount - _phaseOpenFrame;
+            }
+            else if (_rosterForceTries > 0)
+            {
+                _rosterForceTries--;
+            }
+        }
+
+        // THE INTAKE GUARD's refusal: counted every time, logged once per battle per reason (a guest's stale
+        // frames can arrive every tick of an intro).
+        private static void RefuseOutsideCommandPhase(Int32 slot, Int32 action, BattleHUD hud, FF9StateBattleSystem btlsys)
+        {
+            _cmdRefused++;
+            Int32 phase = -1;
+            Boolean menuOn = false;
+            try
+            {
+                if (btlsys != null)
+                    phase = btlsys.btl_phase;
+                menuOn = hud != null && hud.FF9BMenu_IsEnable();
+            }
+            catch { }
+            Int32 key;
+            String why;
+            if (hud == null || btlsys == null)
+            {
+                key = 0x100;
+                why = "no battle HUD";
+            }
+            else if (phase != FF9StateBattleSystem.PHASE_NORMAL)
+            {
+                key = phase;
+                why = PhaseWhy(phase);
+            }
+            else
+            {
+                key = 0x101;
+                why = "the command menu is disabled (paused, a tutorial, or the last enemy falling)";
+            }
+            _refusedWhy = why;
+            if (_refuseLogged.Contains(key))
+                return;
+            _refuseLogged.Add(key);
+            Log.Message("[NetSync] peer command for slot " + slot + " (" + ActionName(action) + ") refused -- not in the "
+                        + "command phase: " + why + " (phase " + phase + ", menu " + (menuOn ? "on" : "off")
+                        + "); cmd_refused=" + _cmdRefused + ", logged once per battle per reason");
+        }
+
+        private static String PhaseWhy(Int32 phase)
+        {
+            switch (phase)
+            {
+                case FF9StateBattleSystem.PHASE_INIT_SYSTEM:
+                case FF9StateBattleSystem.PHASE_ENTER:
+                case FF9StateBattleSystem.PHASE_MENU_ON:
+                    return "the battle intro";
+                case FF9StateBattleSystem.PHASE_EVENT:
+                    return "a scripted battle event";
+                case FF9StateBattleSystem.PHASE_MENU_OFF:
+                    return "the battle is ending (menu off)";
+                case FF9StateBattleSystem.PHASE_VICTORY:
+                    return "the victory";
+                case FF9StateBattleSystem.PHASE_DEFEAT:
+                    return "the defeat";
+                case FF9StateBattleSystem.PHASE_CLOSE:
+                    return "the battle is closing";
+                default:
+                    return "phase " + phase;
+            }
+        }
+
+        private static String ActionName(Int32 action)
+        {
+            switch (action)
+            {
+                case ActAttack: return "Attack";
+                case ActDefend: return "Defend";
+                case ActAbility: return "Ability";
+                case ActItem: return "Item";
+                case ActInstant: return "Instant";
+                default: return "action " + action;
+            }
+        }
+
+        // Every other decline names itself (design 3.8 item 4: the silent returns were mask == 0, a null HUD or
+        // battle system, and the per-action failures after the ready gate) and is counted.
+        private static void Drop(String why)
+        {
+            Log.Message("[NetSync] peer command dropped (" + why + ")");
+            CountDrop(why);
+        }
+
+        private static void CountDrop(String why)
+        {
+            _cmdDropped++;
+            _droppedWhy = why;
+        }
