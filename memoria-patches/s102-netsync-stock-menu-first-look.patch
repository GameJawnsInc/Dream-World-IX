+using System;
+using System.Collections.Generic;
+using FF9;
+using Memoria.Data;
+using Memoria.Prime;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync B4] stage 3 -- THE GUEST'S STOCK COMMAND MENU: THE FIRST LOOK + THE CAPTURE
+    // (studies/battle-coop/B4-B5-DESIGN.md sections 4.1-4.3 and section 7, stage 3 -- the arc's GO/NO-GO).
+    //
+    // The guest's diorama already runs a LIVE stock BattleHUD. Its command menu never opened only because the single
+    // ReadyQueue feeder (HonoluluBattleMain.ProcessActiveTime -> AddPlayerToReady) sits behind !isDebug, which the
+    // diorama sets. B4 opens that menu and so deliberately breaks the b34 invariant "nothing in a diorama fills
+    // ReadyQueue". From this stage the menu CAN open in a diorama -- today only through the SELFTEST BENCH OPENER
+    // (`netsync bmenu open <slot>`, below); stage 8 adds the production ready mirror fed by the host's wire Ready bit
+    // (PeerUnit.Ready) -- so every stock COMMIT it can reach is CAPTURED here instead of executed:
+    //   SendCommand / SendDoubleCastCommand (the FIRST detail only: it casts once, as the digit panel does) /
+    //   SendAutoAttackCommand (Attack at the first live enemy) -> ForwardStockCommand -> ONE v1 type-2 frame (the
+    //   shared EncodeCommand) into the outbox. NEVER btl_cmd.SetCommand locally: that mutates the caster, and the
+    //   ungated CommandEngine would re-simulate the host's fight on the guest's REAL bag (design 3.3).
+    //   SendMixCommand -> refused (SFX 102) BEFORE its fail path's ItemUse (out of the v1 scope; B4.2) -- on Active alone,
+    //   like the side gates below: R9 cannot see that ItemUse, so the calibration lever never lifts it.
+    // and the side paths that mutate without a Send* are gated on Active in BattleHUD: the Vivi auto-magic swap (its
+    // IsZeroMP write), manual Trance, OpenMainMenu (one gate for the AccessMenu button, OnKeyMenu and the main-menu
+    // party swap) and CanForceNextTurn. R9 (stage 2, btl_cmd.SetCommand's head) stands BEHIND all of it: a missed site
+    // becomes one logged refusal (`r9_refused`), never a re-simulation.
+    //
+    // KEYED ON NetSyncDiorama.Active ALONE (the containment predicate -- false in every real battle on both machines),
+    // so vanilla, solo and the host's own fight never reach a line of this file except the harness reads. The one
+    // other input is the selftest-only calibration lever `bmenu capture off` (StockCaptureOn), which bypasses ONLY the
+    // forward: the stock body then runs into R9 -- the proof that the capture fired AND that R9 stands behind it.
+    //
+    // THE OUTBOX holds forwarded frames (cap 8, drop-oldest) for the transport. Stage 3 adds NO production drain on
+    // purpose: nothing in a production diorama can fill a ReadyQueue yet, and the Pump guest-branch drain belongs with
+    // stage 8's ready mirror (design 6.5). The selftest bench reads every forward back DECODED by the host's own
+    // TryDecodeCommand (`netsync.battle.menu.captured`), with no socket.
+    //
+    // THE MENU-WAKE TRACE (risk 2, redone for this stage). Every way a command panel opens inside a diorama:
+    //   (1) BattleHUD.UpdatePlayer's ready loop -> SwitchPlayer, for a ReadyQueue entry. ReadyQueue's feeders:
+    //       AddPlayerToReady (stock caller: ProcessActiveTime, never under isDebug; NEW: the bench opener here, selftest
+    //       + Active only) and two RE-ORDERINGS of existing entries (OnKeyMenu's rotation, SwitchAvailablePlayerOrIdle --
+    //       the latter only after the in-battle main menu, which the OpenMainMenu gate closes). Nothing else adds.
+    //   (2) the auto-battle branch of the same loop (_isAutoAttack, which can carry over from the guest's own fights)
+    //       -> SendAutoAttackCommand: CAPTURED (forwarded as Attack), never its own SetCommand / the Vivi swap; a REFUSED
+    //       auto capture parks the slot (StockAutoRefused) instead of re-forwarding it every frame.
+    //   (3) switchBtlId >= 0 -> SwitchPlayer: its only writer is ProcessActiveTime (ForceNextTurn), never under isDebug.
+    //   (4) ForceNextTurn: consumed only in ProcessActiveTime; CanForceNextTurn now reads false while Active (the LT
+    //       key), and OnKeyMenu's turn-based writes are cleared at ForceDisarm (its only other reset never runs here).
+    //   (5) a portrait click (PanelParty.OnCharacterClick) / OnKeyMenu rotation: SwitchPlayer for an entry ALREADY in
+    //       ReadyQueue and not finished -- a local view change, no commit.
+    // Every COMMIT those panels can reach lands in SendCommand / SendDoubleCastCommand / SendMixCommand (OnKeyConfirm,
+    // OnAllTargetClick, VerifyTarget, CheckDoubleCast -> SetTarget) or SendAutoAttackCommand -- all four captured.
+    // A Memoria merge that adds a BattleHUD SetCommand call needs this census re-run (R9 logs the miss meanwhile).
+    public static partial class NetSyncBattle
+    {
+        private const Int32 StockOutboxCap = 8;
+        private const Int32 StockLogKeysCap = 32;     // once-per-boot log keys (reasons can carry ids)
+        private static readonly Queue<Byte[]> _stockOutbox = new Queue<Byte[]>(StockOutboxCap);
+        private static readonly List<String> _stockLogged = new List<String>(8);
+        private static Boolean _stockTouched;         // this lane opened a slot or captured a commit THIS boot (CloseAll's licence)
+        private static Boolean _stockOutboxDropLogged;
+        private static Boolean _stockLogCapNoted;     // the once-per-boot log-key cap was hit (noted once)
+        private static Int32 _benchOpenMask;          // local slots `bmenu open` queued this boot (and not closed)
+        private static Int32 _autoRefusedMask;        // local slots whose AUTO-BATTLE capture was refused: parked until reopened/closed
+        private static Int32 _stockCaptures;          // forwards -- monotonic per process: read DELTAS
+        private static Int32 _stockRefused;           // commits the capture refused (outside the v1 scope / unmappable)
+        private static String _stockRefusedWhy;       // the last refusal reason (null = none yet)
+        private static Int32 _sideRefused;            // side-path gates that fired inside a diorama -- monotonic
+        private static String _sideRefusedWhy;        // the last one (null = none yet)
+        private static Byte[] _stockLastFrame;        // the last forwarded frame THIS boot (the harness decodes it; null = none)
+        private static Int32 _stockLastLocal = -1;    // ...its LOCAL slot (the HUD's CurrentPlayerIndex at the commit)
+        private static Int32 _stockLastCmd = -1;      // ...the stock command it captured (BattleCommandId)
+        private static String _stockLastSite;         // ...and the commit site ("SendCommand", ...)
+
+        // SELFTEST CALIBRATION LEVER (harness `netsync bmenu capture off`; cleared by every harness release through
+        // HarnessReleaseBench): true = the commit sites run their STOCK bodies inside the diorama (no forward), so R9
+        // must refuse the enqueue -- `r9_refused` +1 and no capture is this stage's red. Read only through
+        // StockCaptureOn, which also needs the selftest role: a lever stranded across an ini edit can never un-capture a
+        // production diorama.
+        public static Boolean BenchStockCaptureOff;
+
+        /// <summary>BattleHUD's capture sites test `NetSyncDiorama.Active &amp;&amp; StockCaptureOn`. True on every
+        /// production machine; false only while the selftest calibration lever is pulled.</summary>
+        public static Boolean StockCaptureOn
+        {
+            get { return !(BenchStockCaptureOff && NetSyncClient.IsSelfTestRole); }
+        }
+
+        // ======================================================================================= the capture
+        /// <summary>
+        /// THE FORWARD (design 4.3): one stock commit -> one v1 type-2 frame in the outbox. Called by BattleHUD's capture
+        /// sites (only while Active). Arguments are the commit as stock would have enqueued it: the LOCAL caster slot, the
+        /// menu, the command, its type (-1 = not in this install's table), the UNPATCHED ability id (the host patches per
+        /// slot) or the item id, the LOCAL target mask and GetSelectMode's 0/1/2 cursor. False = REFUSED (outside the v1
+        /// scope, or a slot with no wire unit): the caller plays SFX 102 and commits nothing. Never throws.
+        /// </summary>
+        public static Boolean ForwardStockCommand(String site, Int32 localSlot, Int32 menu, Int32 cmdId, Int32 cmdType,
+                                                  Int32 id, UInt16 localMask, UInt32 cursor)
+        {
+            try
+            {
+                _stockTouched = true;
+                Int32 action, wireMenu, wireId;
+                String why = V1Action(menu, cmdId, cmdType, id, out action, out wireMenu, out wireId);
+                if (why != null)
+                    return RefuseCapture(site, localSlot, cmdId, why);
+                Int32 wireSlot = NetSyncDiorama.WireIndexForLocal(localSlot);
+                if (wireSlot < 0)
+                    return RefuseCapture(site, localSlot, cmdId, "local slot " + localSlot + " has no wire unit (no host party member seats it)");
+                UInt16 wireMask;
+                why = MapTargetsToWire(localSlot, wireSlot, localMask, out wireMask);
+                if (why != null)
+                    return RefuseCapture(site, localSlot, cmdId, why);
+                if (cursor > 0xFF)
+                    return RefuseCapture(site, localSlot, cmdId, "cursor " + cursor + " does not fit the v1 frame");
+                Byte[] frame = EncodeCommand(wireSlot, action, wireMenu, wireId, wireMask, (Int32)cursor);
+                if (_stockOutbox.Count >= StockOutboxCap)
+                {
+                    _stockOutbox.Dequeue();               // drop-oldest: a stale pick is obsolete anyway
+                    if (!_stockOutboxDropLogged)
+                    {
+                        _stockOutboxDropLogged = true;
+                        Log.Message("[NetSync] stock menu: the outbox hit its cap (" + StockOutboxCap + ") -- oldest frame dropped "
+                                    + "(stage 3 has no production drain; the selftest bench reads `captured`; logged once per boot)");
+                    }
+                }
+                _stockOutbox.Enqueue(frame);
+                _stockCaptures++;
+                _stockLastFrame = frame;
+                _stockLastLocal = localSlot;
+                _stockLastCmd = cmdId;
+                _stockLastSite = site;
+                NetCommand c;
+                TryDecodeCommand(frame, out c);           // the host's own decoder: the log says what the HOST would read
+                Log.Message("[NetSync] stock menu: captured " + site + " -- local slot " + localSlot + " "
+                            + (BattleCommandId)cmdId + " -> v1 frame [" + BitConverter.ToString(frame).Replace('-', ' ')
+                            + "] = slot " + c.Slot + " " + ActionName(c.Action) + " menu " + c.Menu + " id " + c.Id
+                            + " mask 0x" + c.Mask.ToString("X2") + " cursor " + c.Cursor
+                            + "; forwarded, never enqueued locally (captures=" + _stockCaptures + ")");
+                return true;
+            }
+            catch (Exception ex)
+            {
+                return RefuseCapture(site, localSlot, cmdId, "capture fault: " + ex.GetType().Name + ": " + ex.Message);
+            }
+        }
+
+        // The stock commit -> the v1 action vocabulary (design 4.3): Attack menu -> ActAttack; the Defend command ->
+        // ActDefend; an Ability-type command in Ability1/2 -> ActAbility(menu, UNPATCHED id); a Normal/Instant-type
+        // command -> ActInstant(menu); the Item command -> ActItem(id). Menu/id bytes match what the digit panel sends
+        // for the same pick. Null = in scope; else WHY not (Change, Throw, Mix and AccessMenu are B4.2's).
+        private static String V1Action(Int32 menu, Int32 cmdId, Int32 cmdType, Int32 id,
+                                       out Int32 action, out Int32 wireMenu, out Int32 wireId)
+        {
+            action = -1;
+            wireMenu = 0;
+            wireId = 0;
+            BattleCommandId cmd = (BattleCommandId)cmdId;
+            if (cmdType < 0)
+                return "command " + cmd + " is not in this install's command table";
+            if (menu == (Int32)BattleCommandMenu.Attack)
+            {
+                action = ActAttack;
+                return null;
+            }
+            if (cmd == BattleCommandId.Defend)
+            {
+                action = ActDefend;
+                return null;
+            }
+            if (cmd == BattleCommandId.Change || menu == (Int32)BattleCommandMenu.Change)
+                return "Change is outside the v1 command scope (B4.2)";
+            if (menu == (Int32)BattleCommandMenu.Item)
+            {
+                if (cmdType != (Int32)CharacterCommandType.Item)
+                    return cmd + " (a " + (CharacterCommandType)cmdType + " command) is outside the v1 command scope (Throw rides B4.2)";
+                if (id < 0 || id > 0xFFFF || id == (Int32)RegularItem.NoItem)
+                    return "item id " + id + " cannot ride the v1 frame";
+                action = ActItem;
+                wireId = id;
+                return null;
+            }
+            if (menu == (Int32)BattleCommandMenu.Ability1 || menu == (Int32)BattleCommandMenu.Ability2
+                || menu == (Int32)BattleCommandMenu.Defend)
+            {
+                if (cmdType == (Int32)CharacterCommandType.Ability && menu != (Int32)BattleCommandMenu.Defend)
+                {
+                    if (id <= 0 || id > 0xFFFF)
+                        return cmd + ": ability id " + id + " cannot ride the v1 frame";
+                    action = ActAbility;
+                    wireMenu = menu;
+                    wireId = id;
+                    return null;
+                }
+                if (cmdType == (Int32)CharacterCommandType.Normal || cmdType == (Int32)CharacterCommandType.Instant)
+                {
+                    action = ActInstant;
+                    wireMenu = menu;
+                    return null;
+                }
+                return cmd + " (a " + (CharacterCommandType)cmdType + " command in menu " + menu + ") is outside the v1 command scope";
+            }
+            return "menu " + menu + " (" + cmd + ") is outside the v1 command scope";
+        }
+
+        // LOCAL target mask -> WIRE mask (design 4.3): the group masks 0x0F/0xF0/0xFF pass verbatim; enemy bits 4-7 are
+        // identity (both sides spawn the same scene pattern); each player bit maps through the character id. Null = ok.
+        private static String MapTargetsToWire(Int32 localSlot, Int32 wireSlot, UInt16 local, out UInt16 wire)
+        {
+            wire = 0;
+            if (local == 0)
+                return "empty target mask";
+            if (local == 0x0F || local == 0xF0 || local == 0xFF)
+            {
+                wire = local;
+                return null;
+            }
+            UInt16 w = (UInt16)(local & 0xFFF0);
+            for (Int32 l = 0; l < 4; l++)
+            {
+                if ((local & (1 << l)) == 0)
+                    continue;
+                Int32 t = l == localSlot ? wireSlot : NetSyncDiorama.WireIndexForLocal(l);
+                if (t < 0)
+                    return "target slot " + l + " has no wire unit";
+                w |= (UInt16)(1 << t);
+            }
+            wire = w;
+            return null;
+        }
+
+        /// <summary>A commit site that refuses outright inside the diorama (SendMixCommand): counted and logged like any
+        /// capture refusal; nothing is forwarded. The caller plays SFX 102. Never throws.</summary>
+        public static void RefuseStockCommit(String site, Int32 localSlot, Int32 cmdId, String why)
+        {
+            _stockTouched = true;
+            RefuseCapture(site, localSlot, cmdId, why);
+        }
+
+        // Counted on every refusal; logged once per boot per reason (the line is built only when it will be written).
+        // Always false (the caller's return value).
+        private static Boolean RefuseCapture(String site, Int32 localSlot, Int32 cmdId, String why)
+        {
+            try
+            {
+                _stockRefused++;
+                _stockRefusedWhy = why;
+                if (StockLogFirst("refuse " + why))
+                    Log.Message("[NetSync] stock menu: " + site + " for local slot " + localSlot + " ("
+                                + (BattleCommandId)cmdId + ") REFUSED -- " + why + "; nothing forwarded, nothing enqueued locally "
+                                + "(SFX 102; capture_refused=" + _stockRefused + ", logged once per boot per reason)");
+            }
+            catch { }
+            return false;
+        }
+
+        /// <summary>A side-path gate fired inside the diorama (BattleHUD: OpenMainMenu, manual Trance, the Vivi auto-magic
+        /// swap). Counted every time, logged once per boot per path. Never throws.</summary>
+        public static void NoteSideRefused(String what)
+        {
+            try
+            {
+                _sideRefused++;
+                _sideRefusedWhy = what;
+                if (StockLogFirst("side " + what))
+                    Log.Message("[NetSync] stock menu: " + what + " refused inside the diorama -- the fight is "
+                                + "the host's (side_refused=" + _sideRefused + ", logged once per boot per path)");
+            }
+            catch { }
+        }
+
+        // True = this key's FIRST sighting this boot: the caller builds and writes its line. Past the cap a new key is
+        // suppressed (one note, then counters only) -- a true cap, so no reason can ever log per frame.
+        private static Boolean StockLogFirst(String key)
+        {
+            if (_stockLogged.Contains(key))
+                return false;
+            if (_stockLogged.Count >= StockLogKeysCap)
+            {
+                if (!_stockLogCapNoted)
+                {
+                    _stockLogCapNoted = true;
+                    Log.Message("[NetSync] stock menu: " + StockLogKeysCap + " distinct log lines this boot -- further new "
+                                + "reasons are counted (capture_refused / side_refused), not logged");
+                }
+                return false;
+            }
+            _stockLogged.Add(key);
+            return true;
+        }
+
+        /// <summary>BattleHUD.SendAutoAttackCommand: its diorama capture REFUSED this local slot. The slot is parked for
+        /// auto-battle (the ready loop skips it -- see StockAutoRefused) until `bmenu open|close`, CloseAll or the next boot
+        /// clears it (stage 8's ready mirror must clear it whenever it re-feeds the slot). Never throws.</summary>
+        public static void NoteStockAutoRefused(Int32 localSlot)
+        {
+            if (localSlot >= 0 && localSlot < 4)
+                _autoRefusedMask |= 1 << localSlot;
+        }
+
+        /// <summary>BattleHUD.UpdatePlayer's auto-battle branch: true = skip this ready slot (its auto capture was refused
+        /// and nothing has re-armed it). False outside a diorama: the mask is 0 there, and Active is tested too, so even a
+        /// mask stranded by a faulted teardown can never hold back a real battle's auto-attack.</summary>
+        public static Boolean StockAutoRefused(Int32 localSlot)
+        {
+            return _autoRefusedMask != 0 && localSlot >= 0 && localSlot < 4
+                && (_autoRefusedMask & (1 << localSlot)) != 0 && NetSyncDiorama.Active;
+        }
+
+        // ======================================================================================= close / lifecycle
+        /// <summary>
+        /// Close every stock menu this lane opened: the outbox, the bench mask and the auto-battle parking clear always;
+        /// the HUD is touched ONLY if this lane opened a slot or captured a commit this boot (else the engine's HUD is left
+        /// exactly as it is) -- then ReadyQueue/InputFinishList drained of the party slots and SetIdle if a panel is up
+        /// (BattleHUD.NetStockMenuCloseAll: the drain first, SetIdle fault-contained). The licence (_stockTouched) clears
+        /// only once that HUD close has returned, so a fault leaves it for a retry. Called from NetSyncDiorama.ForceDisarm
+        /// (risk 16), `bmenu closeall`, and (stage 5) InjectEnd. Never throws: the persistent BattleHUD outlives the
+        /// battle scene.
+        /// </summary>
+        public static void StockMenuCloseAll(String why)
+        {
+            try
+            {
+                Int32 dropped = _stockOutbox.Count;
+                _stockOutbox.Clear();
+                Int32 bench = _benchOpenMask;
+                _benchOpenMask = 0;
+                _autoRefusedMask = 0;
+                if (!_stockTouched)
+                    return;
+                BattleHUD hud = UIManager.Battle;
+                String setIdleFault = null;
+                Int32 closed = hud != null ? hud.NetStockMenuCloseAll(out setIdleFault) : -1;
+                _stockTouched = false;
+                Log.Message("[NetSync] stock menu: closed all (" + why + ") -- " + (closed < 0 ? "no battle HUD" : closed + " slot(s) drained")
+                            + (bench != 0 ? ", bench-opened mask 0x" + bench.ToString("X") : "")
+                            + (dropped > 0 ? ", " + dropped + " unsent frame(s) discarded" : "")
+                            + (setIdleFault != null ? "; SetIdle FAULTED (" + setIdleFault + ") -- the panel was forced idle "
+                               + "(CurrentPlayerIndex -1, every button group disabled)" : ""));
+            }
+            catch (Exception ex)
+            {
+                try { Log.Message("[NetSync] stock menu: close-all (" + why + ") failed -- " + ex.GetType().Name + ": " + ex.Message); }
+                catch { }
+            }
+        }
+
+        // Every diorama Boot (NoteDioramaBoot): the lane's per-boot state starts clean. The process counters keep counting.
+        private static void NoteStockMenuBoot()
+        {
+            _stockOutbox.Clear();
+            _stockOutboxDropLogged = false;
+            _stockLogged.Clear();
+            _stockLogCapNoted = false;
+            _stockTouched = false;
+            _benchOpenMask = 0;
+            _autoRefusedMask = 0;
+            _stockLastFrame = null;
+            _stockLastLocal = -1;
+            _stockLastCmd = -1;
+            _stockLastSite = null;
+        }
+
+        // Every harness release (HarnessReleaseBench): the capture lever back on. The bench-opened slots close with the
+        // diorama itself (ForceDisarm -> StockMenuCloseAll), which the release also requests.
+        private static void HarnessReleaseStockMenu()
+        {
+            if (BenchStockCaptureOff)
+                Log.Message("[NetSync] harness: stock-menu capture back ON (released with the harness)");
+            BenchStockCaptureOff = false;
+        }
+
+        // ======================================================================================= harness surface (B4 stage 3)
+        // [ff9mapkit netsync B4] stage 3 -- `netsync.battle.menu` keys and the `netsync bmenu` verbs. Read-only reads,
+        // main thread, never throw.
+        public static Int32 HarnessStockCaptures { get { return _stockCaptures; } }
+        public static Int32 HarnessStockRefused { get { return _stockRefused; } }
+        public static String HarnessStockRefusedWhy { get { return _stockRefusedWhy; } }
+        public static Int32 HarnessSideRefused { get { return _sideRefused; } }
+        public static String HarnessSideRefusedWhy { get { return _sideRefusedWhy; } }
+        public static Boolean HarnessStockCaptureOff { get { return !StockCaptureOn; } }
+        public static Int32 HarnessStockOutbox { get { return _stockOutbox.Count; } }
+        public static Int32 HarnessBenchOpenMask { get { return _benchOpenMask; } }
+
+        /// <summary>The last forward of this boot, DECODED by the host's own TryDecodeCommand (wire side), plus the local
+        /// commit it came from. Null = none this boot.</summary>
+        public sealed class StockCaptureView
+        {
+            public Int32 Slot, Action, Menu, Id, Mask, Cursor;   // the frame as the HOST decodes it
+            public Int32 LocalSlot, CmdId;                        // the stock commit (local caster slot, BattleCommandId)
+            public String Site, Hex, ActionName;
+        }
+
+        public static StockCaptureView HarnessLastCapture()
+        {
+            try
+            {
+                Byte[] frame = _stockLastFrame;
+                NetCommand c;
+                if (frame == null || !TryDecodeCommand(frame, out c))
+                    return null;
+                return new StockCaptureView
+                {
+                    Slot = c.Slot,
+                    Action = c.Action,
+                    Menu = c.Menu,
+                    Id = c.Id,
+                    Mask = c.Mask,
+                    Cursor = (Int32)c.Cursor,
+                    LocalSlot = _stockLastLocal,
+                    CmdId = _stockLastCmd,
+                    Site = _stockLastSite,
+                    Hex = BitConverter.ToString(frame).Replace('-', ' '),
+                    ActionName = ActionName(c.Action)
+                };
+            }
+            catch
+            {
+                return null;
+            }
+        }
+
+        /// <summary>
+        /// `netsync bmenu open|close &lt;L&gt; | closeall | capture on|off | mainmenu` (selftest role only):
+        ///   open L     -- THE BENCH OPENER: inside a live diorama in its command phase, put LOCAL party slot L on the stock
+        ///                 ReadyQueue through the stock feeder (AddPlayerToReady, duplicate-guarded) -- the HUD's next ready
+        ///                 pass opens the REAL command panel for it (`battle.turn.slot`, `battle.hud`).
+        ///   close L    -- SetIdle if L's panel is up, then L off ReadyQueue/InputFinishList (a committed slot re-opens
+        ///                 only after a close).
+        ///   closeall   -- StockMenuCloseAll (what InjectEnd and the teardown run).
+        ///   capture    -- the calibration lever (`off` = the stock commit bodies run into R9).
+        ///   mainmenu   -- probe the OpenMainMenu gate through the REAL method (the seat the AccessMenu button, OnKeyMenu
+        ///                 and the main-menu party swap share): refused + `side_refused` +1, or the verb FAILS (the menu is
+        ///                 opening -- the gate is missing).
+        /// </summary>
+        public static Boolean HarnessStockMenu(String op, Int32 arg, out String why)
+        {
+            why = null;
+            if (!Enabled || !NetSyncClient.IsSelfTestRole)
+            {
+                why = "netsync bmenu: needs the selftest role (netsync selftest 1)";
+                return false;
+            }
+            switch (op)
+            {
+                case "capture":
+                    if (arg != 0 && arg != 1)
+                    {
+                        why = "netsync bmenu capture: on|off (1|0)";
+                        return false;
+                    }
+                    BenchStockCaptureOff = arg == 0;
+                    Log.Message("[NetSync] harness: stock-menu capture " + (arg != 0 ? "ON"
+                                : "OFF -- CALIBRATION: inside the diorama the stock commit bodies run (no forward), so R9 must refuse the enqueue"));
+                    return true;
+                case "open":
+                    return BenchOpen(arg, out why);
+                case "close":
+                    return BenchClose(arg, out why);
+                case "closeall":
+                    StockMenuCloseAll("harness `bmenu closeall`");
+                    return true;
+                case "mainmenu":
+                    return BenchProbeMainMenu(out why);
+                default:
+                    why = "netsync bmenu: unknown op '" + op + "' (open|close|closeall|capture|mainmenu)";
+                    return false;
+            }
+        }
+
+        // The opener's gates: a LIVE diorama in its steady command phase -- the same conditions the stage-8 ready mirror
+        // will test (design 4.6), so the bench opens nothing production could not.
+        private static String BenchMenuGate(out BattleHUD hud)
+        {
+            hud = null;
+            if (!NetSyncDiorama.Active)
+                return "needs a live diorama (netsync dioboot <scene>, then wait for battle.turn.enabled)";
+            hud = UIManager.Battle;
+            FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+            if (hud == null || b == null)
+                return "no battle HUD";
+            UIManager.UIState state = PersistenSingleton<UIManager>.Instance.State;
+            if (state != UIManager.UIState.BattleHUD)
+                return "the UI state is " + state + ", not BattleHUD";
+            if (b.btl_phase != FF9StateBattleSystem.PHASE_NORMAL)
+                return "the diorama is in phase " + b.btl_phase + ", not its steady phase (" + FF9StateBattleSystem.PHASE_NORMAL + ")";
+            const Byte need = ff9btl.LOAD_INITNPC | ff9btl.LOAD_INITCHR;
+            if ((b.btl_load_status & need) != need)
+                return "the diorama's units are not final yet";
+            if (!hud.FF9BMenu_IsEnable())
+                return "the HUD's command menu is not enabled yet (wait for battle.turn.enabled)";
+            return null;
+        }
+
+        private static Boolean BenchOpen(Int32 slot, out String why)
+        {
+            why = null;
+            try
+            {
+                if (slot < 0 || slot > 3)
+                {
+                    why = "netsync bmenu open: needs a local party slot 0-3";
+                    return false;
+                }
+                BattleHUD hud;
+                String gate = BenchMenuGate(out hud);
+                if (gate != null)
+                {
+                    why = "netsync bmenu open: " + gate;
+                    return false;
+                }
+                String refusal;
+                if (!hud.NetStockMenuOpen(slot, out refusal))
+                {
+                    why = "netsync bmenu open: " + refusal;
+                    return false;
+                }
+                _stockTouched = true;
+                _benchOpenMask |= 1 << slot;
+                _autoRefusedMask &= ~(1 << slot);         // a reopen re-arms a parked auto-battle refusal (one retry)
+                Log.Message("[NetSync] harness: bench opener -- local slot " + slot + " (wire slot "
+                            + NetSyncDiorama.WireIndexForLocal(slot) + ") is on the stock ReadyQueue; the diorama's command "
+                            + "panel opens on the HUD's next ready pass (every commit is captured, never enqueued locally)");
+                return true;
+            }
+            catch (Exception ex)
+            {
+                why = "netsync bmenu open: faulted -- " + ex.GetType().Name + ": " + ex.Message;
+                return false;
+            }
+        }
+
+        private static Boolean BenchClose(Int32 slot, out String why)
+        {
+            why = null;
+            try
+            {
+                if (slot < 0 || slot > 3)
+                {
+                    why = "netsync bmenu close: needs a local party slot 0-3";
+                    return false;
+                }
+                if (!NetSyncDiorama.Active)
+                {
+                    why = "netsync bmenu close: needs a live diorama";
+                    return false;
+                }
+                BattleHUD hud = UIManager.Battle;
+                if (hud == null)
+                {
+                    why = "netsync bmenu close: no battle HUD";
+                    return false;
+                }
+                Boolean any = hud.NetStockMenuClose(slot);
+                _benchOpenMask &= ~(1 << slot);
+                _autoRefusedMask &= ~(1 << slot);
+                Log.Message("[NetSync] harness: bench close -- local slot " + slot + (any ? " closed (off ReadyQueue/InputFinishList)" : " was not open"));
+                return true;
+            }
+            catch (Exception ex)
+            {
+                why = "netsync bmenu close: faulted -- " + ex.GetType().Name + ": " + ex.Message;
+                return false;
+            }
+        }
+
+        private static Boolean BenchProbeMainMenu(out String why)
+        {
+            why = null;
+            try
+            {
+                if (!NetSyncDiorama.Active)
+                {
+                    why = "netsync bmenu mainmenu: needs a live diorama (a real battle's main menu is stock and is never probed)";
+                    return false;
+                }
+                BattleHUD hud = UIManager.Battle;
+                if (hud == null || PersistenSingleton<UIManager>.Instance.State != UIManager.UIState.BattleHUD)
+                {
+                    why = "netsync bmenu mainmenu: the battle HUD is not the UI state";
+                    return false;
+                }
+                Int32 before = _sideRefused;
+                Boolean opening = hud.NetBenchOpenMainMenu();
+                if (opening)
+                {
+                    why = "netsync bmenu mainmenu: the in-battle main menu is OPENING inside the diorama -- the OpenMainMenu gate is missing";
+                    return false;
+                }
+                if (_sideRefused == before)
+                {
+                    why = "netsync bmenu mainmenu: OpenMainMenu neither opened nor reported its refusal";
+                    return false;
+                }
+                return true;
+            }
+            catch (Exception ex)
+            {
+                why = "netsync bmenu mainmenu: faulted -- " + ex.GetType().Name + ": " + ex.Message;
+                return false;
+            }
+        }
+    }
+}
