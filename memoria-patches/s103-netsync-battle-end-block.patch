+        ///   clear                disarm the bench end and the one-shot (the lever stays; a release resets it)
+        ///   manifest             refused: the result manifest is stage 9
+        /// </summary>
+        public static Boolean HarnessEndBench(String op, Int32 arg, Boolean loading, Byte[] frame, String mode, out String why)
+        {
+            why = null;
+            if (!NetSyncBattle.Enabled || !NetSyncClient.IsSelfTestRole)
+            {
+                why = "netsync endbench: needs the selftest role (netsync selftest 1)";
+                return false;
+            }
+            try
+            {
+                switch (op)
+                {
+                    case "victory":
+                        SetRaw(FF9StateBattleSystem.PHASE_VICTORY, FF9StateBattleSystem.SEQ_VICTORY_CAMERA_MOVE, FF9StateGlobal.BTL_RESULT_VICTORY);
+                        break;
+                    case "pending":
+                        SetRaw(FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_VICTORY, FF9StateGlobal.BTL_RESULT_INITIAL);
+                        break;
+                    case "nopose":
+                        SetRaw(FF9StateBattleSystem.PHASE_CLOSE, FF9StateBattleSystem.SEQ_DEFEATCLOSE_FADEOUT, FF9StateGlobal.BTL_RESULT_VICTORY_NO_POSE);
+                        break;
+                    case "other":
+                        if (arg < 0 || arg > 255)
+                        {
+                            why = "netsync endbench other: needs a btl_result 0-255 (5 interruption, 7 enemy flee, ...)";
+                            return false;
+                        }
+                        SetRaw(FF9StateBattleSystem.PHASE_CLOSE, FF9StateBattleSystem.SEQ_DEFEATCLOSE_FADEOUT, (Byte)arg);
+                        break;
+                    case "defeat":
+                        SetRaw(FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_DEFEAT, FF9StateGlobal.BTL_RESULT_INITIAL);
+                        break;
+                    case "escape":
+                        SetRaw(FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_ESCAPE, FF9StateGlobal.BTL_RESULT_INITIAL);
+                        break;
+                    case "event":
+                        SetRaw(FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_EVENT, FF9StateGlobal.BTL_RESULT_INITIAL);
+                        break;
+                    case "fight":
+                        SetRaw(FF9StateBattleSystem.PHASE_NORMAL, 0, FF9StateGlobal.BTL_RESULT_INITIAL);
+                        break;
+                    case "ui":
+                        if (arg < 0 || arg > 3)
+                        {
+                            why = "netsync endbench ui: needs 0 (battle/other), 1 (BattleResult), 2 (GameOver) or 3 (Title)";
+                            return false;
+                        }
+                        _bUi = (Byte)arg;
+                        break;
+                    case "state":
+                        if (arg < ResStart || arg > ResNone)
+                        {
+                            why = "netsync endbench state: needs a ResultState 0-8 (0 Start .. 6 End, 7 Hide, 8 None) [loading]";
+                            return false;
+                        }
+                        _bState = (Byte)arg;
+                        _bLoading = loading;
+                        break;
+                    case "overflow":
+                    case "afterevent":
+                        if (arg != 0 && arg != 1)
+                        {
+                            why = "netsync endbench " + op + ": needs 0|1";
+                            return false;
+                        }
+                        Byte bit = op == "overflow" ? FlagItemOverflow : FlagAfterEvent;
+                        _bFlags = (Byte)(arg != 0 ? _bFlags | bit : _bFlags & ~bit);
+                        break;
+                    case "cmd":
+                        if (frame != null && (frame.Length == 0 || frame.Length > 64))
+                        {
+                            why = "netsync endbench cmd: needs 1..64 bytes of hex (a v1 command frame is 9)";
+                            return false;
+                        }
+                        _cmdFrame = frame ?? DefaultCmdFrame;
+                        _cmdArmed = true;
+                        _cmdStatus = "armed";
+                        Log.Message("[NetSync] harness: endbench cmd ARMED -- frame [" + BitConverter.ToString(_cmdFrame).Replace('-', ' ')
+                                    + "] goes onto the selftest loopback at the host's next end edge (an own battle's first "
+                                    + "end-kind sample)");
+                        return true;
+                    case "host":
+                        Int32 m = mode == "on" ? ModeOn : mode == "cadence" ? ModeCadence : mode == "off" ? ModeOff : -1;
+                        if (m < 0)
+                        {
+                            why = "netsync endbench host: needs on|cadence|off";
+                            return false;
+                        }
+                        _benchHostMode = m;
+                        Log.Message("[NetSync] harness: end-block host " + ModeName(m).ToUpperInvariant() + (m == ModeOn ? ""
+                                    : m == ModeCadence ? " -- CALIBRATION: the trailer ships on the plain SampleMs cadence (no change-triggered sample; the tracker still counts end_changes)"
+                                    : " -- CALIBRATION: the pre-stage host (no end-block trailer, no change-triggered sample; the tracker still counts end_changes)"));
+                        return true;
+                    case "selftest":
+                        String detail;
+                        Boolean ok = SelfTest(out detail);
+                        Log.Message("[NetSync] harness: battle end-block selftest " + (ok ? "OK (" : "FAIL (") + detail + ")");
+                        if (!ok)
+                            why = "netsync endbench selftest: FAIL -- " + detail;
+                        return ok;
+                    case "clear":
+                        Boolean had = _benchArmed || _cmdArmed;
+                        ClearBench();
+                        Log.Message("[NetSync] harness: endbench cleared" + (had ? " (bench end and command one-shot disarmed)" : " (nothing was armed)"));
+                        return true;
+                    case "manifest":
+                        why = "netsync endbench manifest: the result manifest is stage 9 -- this engine ships the end block only";
+                        return false;
+                    default:
+                        why = "netsync endbench: unknown op '" + op + "' (victory|pending|nopose|other|defeat|escape|event|fight|ui|state|"
+                              + "overflow|afterevent|cmd|host|selftest|clear)";
+                        return false;
+                }
+                return Fabricate(op, out why);
+            }
+            catch (Exception ex)
+            {
+                why = "netsync endbench " + op + ": faulted -- " + ex.GetType().Name + ": " + ex.Message;
+                return false;
+            }
+        }
+
+        private static void SetRaw(Byte phase, Byte seq, Byte result)
+        {
+            _bPhase = phase;
+            _bSeq = seq;
+            _bResult = result;
+        }
+
+        // The template -> an EndBlock exactly as a host would ship it -> the codec -> a type-1 frame -> ParseView. The
+        // parsed block, not the template, becomes the bench end: the bench cannot serve what the codec cannot carry.
+        private static Boolean Fabricate(String op, out String why)
+        {
+            why = null;
+            EndBlock b = new EndBlock();
+            b.Phase = _bPhase;
+            b.Seq = _bSeq;
+            b.Result = _bResult;
+            b.Kind = ClassifyEnd(_bPhase, _bSeq, _bResult);
+            b.Ui = _bUi;
+            b.ResState = _bUi == UiResult ? (Byte)(_bState | (_bLoading ? ResLoadingBit : 0)) : ResNoScreen;
+            b.Flags = _bFlags;
+            b.WinPoseMask = (Byte)(b.Kind == KVictoryPending || b.Kind == KVictory ? 0x0F : 0);
+            UInt16 seq = ++_benchSeq;
+            Int32 unitsEnd;
+            Byte[] payload = NetSyncBattle.BuildEndBenchFrame(seq, BenchNonce, 0, EncodeTrailer(b, null), out unitsEnd);
+            Int32 units;
+            Boolean viewOk;
+            UInt16 parsedSeq;
+            Byte parsedNonce;
+            EndBlock got = NetSyncBattle.ParseEndThroughView(payload, out units, out viewOk, out parsedSeq, out parsedNonce);
+            if (!viewOk)
+            {
+                why = "netsync endbench " + op + ": ParseView rejected the fabricated frame";
+                return false;
+            }
+            if (got == null || !got.SameAs(b) || parsedSeq != seq || parsedNonce != BenchNonce)
+            {
+                why = "netsync endbench " + op + ": the codec mangled the block -- sent " + b + ", parsed "
+                      + (got != null ? got.ToString() : "nothing") + " (seq " + parsedSeq + "/" + seq + ", nonce " + parsedNonce + ")";
+                return false;
+            }
+            _benchEnd = ToPeer(got, parsedNonce, parsedSeq, true);
+            _benchArmed = true;
+            Log.Message("[NetSync] harness: endbench " + op + " -- fabricated " + got + " through the real ParseView ("
+                        + payload.Length + " B frame, trailer at +" + unitsEnd + ", wire seq " + parsedSeq + "); served as the BENCH end");
+            return true;
+        }
+
+        private static void ClearBench()
+        {
+            _benchArmed = false;
+            _benchEnd = default(NetSyncBattle.PeerEnd);
+            _bPhase = FF9StateBattleSystem.PHASE_NORMAL;
+            _bSeq = 0;
+            _bResult = 0;
+            _bUi = UiOther;
+            _bState = 0;
+            _bLoading = false;
+            _bFlags = 0;
+            _cmdArmed = false;
+            _cmdFrame = null;
+            _cmdStatus = null;
+        }
+
+        /// <summary>Every harness release (NetSyncBattle.HarnessReleaseBench): the bench end, the template, the one-shot and
+        /// the calibration lever all go back to rest. Never throws.</summary>
+        internal static void HarnessRelease()
+        {
+            try
+            {
+                if (_benchHostMode != ModeOn)
+                    Log.Message("[NetSync] harness: end-block host back ON (released with the harness)");
+                _benchHostMode = ModeOn;
+                if (_benchArmed || _cmdArmed)
+                    Log.Message("[NetSync] harness: endbench released (bench end / command one-shot disarmed)");
+                ClearBench();
+            }
+            catch { }
+        }
+
+        // ==================================================================================== harness reads (B5 stage 4)
+        // Read-only, main thread, never throw.
+        public static EndBlock HarnessHostEnd { get { return _lastHost; } }
+        public static Int32 HarnessHostEdges { get { return _hostEdges; } }
+        public static Int32 HarnessHostChanges { get { return _hostChanges; } }
+        public static String HarnessHostMode { get { return ModeName(HostMode); } }
+        public static String HarnessCmdStatus { get { return _cmdStatus; } }
+        public static Int32 HarnessTrailerBad { get { return _trailerBad; } }
+        public static Int32 HarnessTrailerSkipped { get { return _trailerSkipped; } }
+        public static String HarnessTrailerBadWhy { get { return _trailerBadWhy; } }
+        public static List<String> HarnessHostTrail() { return new List<String>(_hostTrail); }
+        public static List<String> HarnessPeerTrail() { return new List<String>(_peerTrail); }
+
+        // ==================================================================================== SelfTest
+        /// <summary>
+        /// The stage's offline-provable half: ClassifyEnd (incl. the var-32 pin: MENU_OFF/EVENT is NOT an end; CLOSE + DEFEAT
+        /// is Defeat), ChaseStep (the whole 9x9x2 table, incl. the pins: None is never chased; a host at EndEXPAndAP without
+        /// Loading is never stepped to), and the codec through the REAL ParseView (a full frame round-trips with its units;
+        /// EVERY truncated prefix from the end of the units on keeps the units and refuses the block; a trailer-less frame;
+        /// an unknown-fmt record skipped; foreign bytes; a short block; a manifest body skipped by its len). Pure apart from
+        /// ParseView's own statics (the bad-trailer counter is muted for the sweep). Never throws.
+        /// </summary>
+        public static Boolean SelfTest(out String detail)
+        {
+            List<String> fails = new List<String>();
+            Int32 classify = 0, chase = 0, codec = 0;
+            Boolean wasQuiet = _quiet;
+            try
+            {
+                // ---- ClassifyEnd ----
+                Byte[] fighting = { FF9StateBattleSystem.PHASE_INIT_SYSTEM, FF9StateBattleSystem.PHASE_ENTER, FF9StateBattleSystem.PHASE_MENU_ON, FF9StateBattleSystem.PHASE_NORMAL };
+                foreach (Byte ph in fighting)
+                    ExpectKind(fails, ref classify, ph, 0, FF9StateGlobal.BTL_RESULT_VICTORY, KFighting, "phase " + ph);
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_VICTORY, 0, KVictoryPending, "menu-off victory");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_VICTORY_WITH_ENEMY, 0, KVictoryPending, "menu-off victory-with-enemy");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_DEFEAT, 0, KDefeat, "menu-off defeat");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_ESCAPE, 0, KEscape, "menu-off escape");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_EVENT, 0, KEvent, "PIN seq-2-is-not-an-end (var 32)");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_MENU_OFF, FF9StateBattleSystem.SEQ_MENU_OFF_EVENT, FF9StateGlobal.BTL_RESULT_VICTORY, KEvent, "PIN seq-2-ignores-result");
+                for (Byte s = 0; s <= 2; s++)
+                    ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_VICTORY, s, FF9StateGlobal.BTL_RESULT_VICTORY, KVictory, "victory seq " + s);
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_DEFEAT, 0, FF9StateGlobal.BTL_RESULT_DEFEAT, KDefeat, "defeat");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 0, FF9StateGlobal.BTL_RESULT_VICTORY, KVictoryNoPose, "close victory");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 1, FF9StateGlobal.BTL_RESULT_VICTORY_NO_POSE, KVictoryNoPose, "close no-pose");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 0, FF9StateGlobal.BTL_RESULT_ESCAPE, KEscape, "close escape");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 0, FF9StateGlobal.BTL_RESULT_DEFEAT, KDefeat, "PIN close+defeat-is-defeat");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 0, FF9StateGlobal.BTL_RESULT_GAMEOVER, KDefeat, "close gameover");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 0, FF9StateGlobal.BTL_RESULT_INTERRUPTION, KOtherEnd, "close interruption");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 0, FF9StateGlobal.BTL_RESULT_ENEMY_FLEE, KOtherEnd, "close enemy-flee");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_CLOSE, 0, FF9StateGlobal.BTL_RESULT_INITIAL, KOtherEnd, "close initial");
+                ExpectKind(fails, ref classify, FF9StateBattleSystem.PHASE_EVENT, 0, 0, KEvent, "event");
+                if (IsEndKind(KFighting) || IsEndKind(KEvent) || !IsEndKind(KVictoryPending) || !IsEndKind(KOtherEnd))
+                    fails.Add("IsEndKind");
+
+                // ---- ChaseStep: the whole table against its specification, then the named pins ----
+                for (Int32 l = ResStart; l <= ResNone; l++)
+                {
+                    for (Int32 h = ResStart; h <= ResNone; h++)
+                    {
+                        for (Int32 ld = 0; ld < 2; ld++)
+                        {
+                            Boolean want = ChaseSpec(l, h, ld != 0);
+                            chase++;
+                            if (ChaseStep(l, h, ld != 0) != want)
+                                fails.Add("chase L" + l + " H" + h + (ld != 0 ? "L" : "") + " != " + want);
+                        }
+                    }
+                }
+                for (Int32 l = ResStart; l <= ResNone; l++)
+                    if (ChaseStep(l, ResNone, false) || ChaseStep(l, ResNone, true))
+                        fails.Add("PIN none-is-never-chased (L" + l + ")");
+                if (ChaseStep(ResEndExp, ResEndExp, false) || ChaseStep(ResExpTick, ResEndExp, false))
+                    fails.Add("PIN no-step-at-natural-EndEXPAndAP");
+                if (!ChaseStep(ResExpTick, ResEndExp, true) || !ChaseStep(ResEndExp, ResEndExp, true))
+                    fails.Add("PIN the-host-fade-steps-the-tick-pages");
+                if (!ChaseStep(ResEnd, ResHide, false) || ChaseStep(ResEnd, ResEnd, false) || ChaseStep(ResHide, ResHide, false))
+                    fails.Add("PIN end-steps-only-to-hide");
+                if (ChaseStep(ResStart, -1, false) || ChaseStep(ResStart, 9, false) || ChaseStep(-1, ResHide, false))
+                    fails.Add("chase out-of-range");
+                Int32 stEnd = ResEnd, stHide = ResHide, stNone = ResNone;   // locals: a constant condition would fold away
+                if (stNone <= stHide || stHide != stEnd + 1)
+                    fails.Add("PIN the engine's ResultState order (None after Hide after End)");
+
+                // ---- the codec, through the REAL ParseView ----
+                _quiet = true;
+                EndBlock m = new EndBlock();
+                m.Kind = KVictoryNoPose; m.Phase = FF9StateBattleSystem.PHASE_CLOSE; m.Seq = 1; m.Result = FF9StateGlobal.BTL_RESULT_VICTORY_NO_POSE;
+                m.Ui = UiResult; m.ResState = (Byte)(ResStartGil | ResLoadingBit);
+                m.Flags = (Byte)(FlagAfterEvent | FlagEscapeGil | FlagFieldSong); m.WinPoseMask = 0x0B;
+                Byte[] trailer = EncodeTrailer(m, null);
+                Int32 unitsEnd;
+                Byte[] full = NetSyncBattle.BuildEndBenchFrame(0x1234, 0x5A, 2, trailer, out unitsEnd);
+                Codec(fails, ref codec, "full frame", full, 2, m, 0);
+                for (Int32 cut = unitsEnd; cut < full.Length; cut++)
+                    Codec(fails, ref codec, "prefix " + cut + "/" + full.Length, Prefix(full, cut), 2, null, 0);
+                Byte[] unknown = { TrailerMagic, 0x02, 0x03, 0x00, 0xAA, 0xBB, 0xCC };
+                Codec(fails, ref codec, "unknown fmt skipped", NetSyncBattle.BuildEndBenchFrame(7, 1, 1, Concat(unknown, trailer), out unitsEnd), 1, m, 0);
+                Codec(fails, ref codec, "unknown fmt alone", NetSyncBattle.BuildEndBenchFrame(7, 1, 1, unknown, out unitsEnd), 1, null, 0);
+                Codec(fails, ref codec, "foreign trailing bytes", NetSyncBattle.BuildEndBenchFrame(7, 1, 1, new Byte[] { 0x00, 0x01, 0x02, 0x03, 0x04 }, out unitsEnd), 1, null, 0);
+                Byte[] shortBlock = { TrailerMagic, FmtEnd, 0x05, 0x00, 1, 2, 3, 4, 5 };
+                Codec(fails, ref codec, "short block", NetSyncBattle.BuildEndBenchFrame(7, 1, 1, shortBlock, out unitsEnd), 1, null, 0);
+                Byte[] manifest = new Byte[13];
+                for (Int32 i = 0; i < manifest.Length; i++)
+                    manifest[i] = (Byte)(0xE0 + i);
+                EndBlock mm = m.Clone();
+                mm.Flags |= FlagManifest;
+                Byte[] withManifest = NetSyncBattle.BuildEndBenchFrame(9, 2, 3, EncodeTrailer(m, manifest), out unitsEnd);
+                Codec(fails, ref codec, "manifest skipped by len", withManifest, 3, mm, manifest.Length);
+                for (Int32 cut = unitsEnd; cut < withManifest.Length; cut++)
+                    Codec(fails, ref codec, "manifest prefix " + cut, Prefix(withManifest, cut), 3, null, 0);
+                Byte[] grown = Concat(trailer, new Byte[0]);
+                grown[2] = EndBlockLen + 2;          // a later fmt-1 growth WITHOUT b1: the extra body is skipped
+                Codec(fails, ref codec, "fmt-1 growth skipped", NetSyncBattle.BuildEndBenchFrame(9, 2, 0, Concat(grown, new Byte[] { 0x77, 0x77 }), out unitsEnd), 0, m, 0);
+                Codec(fails, ref codec, "trailer-less frame", NetSyncBattle.BuildEndBenchFrame(3, 3, 4, null, out unitsEnd), 4, null, 0);
+                Codec(fails, ref codec, "trailer-only frame", NetSyncBattle.BuildEndBenchFrame(3, 3, 0, trailer, out unitsEnd), 0, m, 0);
+            }
+            catch (Exception ex)
+            {
+                fails.Add("faulted: " + ex.GetType().Name + ": " + ex.Message);
+            }
+            finally
+            {
+                _quiet = wasQuiet;
+            }
+            String counts = "classify " + classify + ", chase " + chase + " + pins, codec " + codec;
+            if (fails.Count == 0)
+            {
+                detail = counts;
+                return true;
+            }
+            detail = counts + "; " + fails.Count + " failure(s): " + String.Join("; ", fails.GetRange(0, Math.Min(fails.Count, 6)).ToArray())
+                     + (fails.Count > 6 ? "; ..." : "");
+            return false;
+        }
+
+        // The design-5.6 table, restated as data for the sweep (the pins above name the cases a mutant would break).
+        private static Boolean ChaseSpec(Int32 l, Int32 h, Boolean loading)
+        {
+            if (h == ResNone)
+                return false;
+            if (l == ResStart) return h > ResStart;
+            if (l == ResExpTick || l == ResEndExp) return h > ResEndExp || (h == ResEndExp && loading);
+            if (l == ResStartGil) return h > ResStartGil;
+            if (l == ResItemFull) return h > ResItemFull;
+            if (l == ResGilTick) return h > ResGilTick;
+            if (l == ResEnd) return h == ResHide;
+            return false;
+        }
+
+        private static void ExpectKind(List<String> fails, ref Int32 n, Byte phase, Byte seq, Byte result, Byte want, String what)
+        {
+            n++;
+            Byte got = ClassifyEnd(phase, seq, result);
+            if (got != want)
+                fails.Add("classify " + what + ": " + KindName(got) + " != " + KindName(want));
+        }
+
+        private static void Codec(List<String> fails, ref Int32 n, String what, Byte[] payload, Int32 wantUnits, EndBlock want, Int32 wantManifest)
+        {
+            n++;
+            Int32 units;
+            Boolean viewOk;
+            UInt16 seq;
+            Byte nonce;
+            EndBlock got = NetSyncBattle.ParseEndThroughView(payload, out units, out viewOk, out seq, out nonce);
+            if (!viewOk)
+                fails.Add("codec " + what + ": the view was refused (units must be kept)");
+            else if (units != wantUnits)
+                fails.Add("codec " + what + ": " + units + " unit(s) != " + wantUnits);
+            else if (want == null && got != null)
+                fails.Add("codec " + what + ": a block was accepted (" + got + ")");
+            else if (want != null && (got == null || !got.SameAs(want) || got.ManifestLen != wantManifest))
+                fails.Add("codec " + what + ": " + (got != null ? got + " manifest " + got.ManifestLen : "no block") + " != " + want);
+        }
+
+        private static Byte[] Prefix(Byte[] a, Int32 n)
+        {
+            Byte[] p = new Byte[n];
+            Buffer.BlockCopy(a, 0, p, 0, n);
+            return p;
+        }
+
+        private static Byte[] Concat(Byte[] a, Byte[] b)
+        {
+            Byte[] c = new Byte[a.Length + b.Length];
+            Buffer.BlockCopy(a, 0, c, 0, a.Length);
+            Buffer.BlockCopy(b, 0, c, a.Length, b.Length);
+            return c;
+        }
+    }
+}
