+            p.Phase = b.Phase;
+            p.Seq = b.Seq;
+            p.Result = b.Result;
+            p.Ui = b.Ui;
+            p.ResState = b.ResState;
+            p.Flags = b.Flags;
+            p.WinPoseMask = b.WinPoseMask;
+            p.ManifestLen = b.ManifestLen;
