@@ -0,0 +1,35 @@
+using System;
+
+// [ff9mapkit netsync B5] stage 4 -- the co-op half of the stock result screen (studies/battle-coop/B4-B5-DESIGN.md
+// sections 5.2 and 5.6). This stage adds ONLY read accessors: the host's end block (Memoria.Netsync.NetSyncEnd) ships
+// the screen's state machine position and its Loading bit on every type-1 frame, so a guest can follow the host's
+// reward screen state by state. Nothing here writes, and nothing in BattleResultUI.cs calls it: vanilla, solo and the
+// host's own result screen are unchanged. Stage 10 grows this file into the guest's write-nothing replay (seams a-m).
+public partial class BattleResultUI
+{
+    // The ResultState ordinals, pinned to the engine's own (private) enum: NetSyncEnd's chase table and the wire's
+    // resState byte name states by these numbers, so a reordered enum moves them together. None (8) sorts AFTER
+    // Hide (7) -- the chase never steps on it.
+    public const Int32 NetStateStart = (Int32)ResultState.Start;
+    public const Int32 NetStateEXPAndAPTick = (Int32)ResultState.EXPAndAPTick;
+    public const Int32 NetStateEndEXPAndAP = (Int32)ResultState.EndEXPAndAP;
+    public const Int32 NetStateStartGilAndItem = (Int32)ResultState.StartGilAndItem;
+    public const Int32 NetStateItemFullDialog = (Int32)ResultState.ItemFullDialog;
+    public const Int32 NetStateGilTick = (Int32)ResultState.GilTick;
+    public const Int32 NetStateEnd = (Int32)ResultState.End;
+    public const Int32 NetStateHide = (Int32)ResultState.Hide;
+    public const Int32 NetStateNone = (Int32)ResultState.None;
+
+    /// <summary>The screen's current ResultState ordinal (0 Start .. 6 End, 7 Hide, 8 None). Read-only.</summary>
+    public Int32 NetStateRaw
+    {
+        get { return (Int32)this.currentState; }
+    }
+
+    /// <summary>The wire's resState byte: NetStateRaw, bit 7 = Loading (a fade ping-pong or a Show/Hide transition is in
+    /// flight -- the stock screen ignores Confirm then). Read-only.</summary>
+    public Int32 NetStateByte
+    {
+        get { return (this.NetStateRaw & 0x7F) | (this.Loading ? 0x80 : 0); }
+    }
+}
