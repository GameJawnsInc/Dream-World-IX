@@ -0,0 +1,1146 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using Memoria.Data;
+using Memoria.Prime;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync B5] stage 4 -- THE HOST END BLOCK (studies/battle-coop/B4-B5-DESIGN.md sections 5.2 and 6.2;
+    // section 7, stage 4). How the host's battle is ending, and where its result screen stands, ride every type-1 battle
+    // frame as a self-delimiting TRAILER after the unit records:
+    //
+    //   u8 magic = 0xB5, u8 fmt, u16 len (the body length, little-endian)    -- one RECORD; a frame may carry several
+    //   fmt 1 = THE END BLOCK: u8 kind, u8 phase, u8 seq, u8 result, u8 ui, u8 resState, u8 flags, u8 winPoseMask
+    //     kind      0 Fighting, 1 VictoryPending, 2 Victory, 3 VictoryNoPose, 4 Defeat, 5 Escape, 6 OtherEnd,
+    //               7 Event (NOT an end: var 32's MENU_OFF/EVENT parks the host there with result 0)
+    //     phase/seq/result  the raw btl_phase / btl_seq / FF9.btl_result (logs and the harness; kind is derived from them)
+    //     ui        0 battle/other, 1 BattleResult (also while paused over it), 2 GameOver, 3 Title
+    //     resState  ui == 1: the result screen's ResultState 0..8, bit 7 = Loading; else 0xFF
+    //     flags     b0 AfterEvent, b1 a manifest follows (stage 9), b2 item overflow (stage 9's sticky host tap),
+    //               b3 escape_gil, b4 BTL_CONTI_FLD_SONG
+    //     winPoseMask  bit per host btl_data slot that strikes the win pose (victory kinds on a WinPose scene; else 0)
+    //   any bytes of a fmt-1 body past those 8 are the stage-9 manifest (flags b1) or later growth: skipped here.
+    //
+    // NO WIRE BUMP (design 6.2): ParseView on a pre-B5 peer reads exactly `count` units and ignores the rest, and this
+    // engine reads the trailer in its OWN try -- a bad trailer nulls only the end block, never the view (a null view would
+    // stale the lane and pull the guest out early). Unknown fmt -> that record is skipped by its len; truncation -> End =
+    // null, units kept; foreign trailing bytes (no magic) -> End = null.
+    //
+    // CHANGE-TRIGGERED SAMPLING: both pumps compare a cheap per-frame key (phase, seq, result, ui, resState with Loading)
+    // with the last one and sample AT ONCE on a change, so every state the host passes through reaches the wire even when
+    // it lives less than SampleMs (the extra samples consume the shared _seq like any state write). Two receipts:
+    // `end_changes` (the tracker's detections) and `end_edges` (samples a change FORCED, counted inside the pumps' sample
+    // block -- the effect, so a pump that drops the trigger reads 0 there however many changes were detected).
+    //
+    // HOST side: written by NetSyncBattle.SampleOwnBattle (only while the host streams its OWN battle -- co-op off,
+    // vanilla and solo never reach a line of this file). GUEST side: parsed by NetSyncBattle.ParseView and served by
+    // NetSyncBattle.TryGetPeerEnd (stage 5's EndTick consumes it; nothing on the guest acts on it at this stage).
+    //
+    // SELFTEST-ONLY BENCH (`netsync endbench ...`, HarnessEndBench): fabricates an end block, encodes it, wraps it in a
+    // type-1 frame and decodes it through the REAL ParseView -- the bytes -> parse chain a guest runs, minus the socket --
+    // and serves the parsed block through TryGetPeerEnd as a BENCH end (Bench = true). Plus the calibration lever
+    // `endbench host on|cadence|off` and the victory-edge command one-shot `endbench cmd [hex]`.
+    public static class NetSyncEnd
+    {
+        // ---- the trailer (design 6.2) ----
+        public const Byte TrailerMagic = 0xB5;
+        public const Byte FmtEnd = 1;
+        public const Int32 RecordHeaderLen = 4;     // u8 magic, u8 fmt, u16 len
+        public const Int32 EndBlockLen = 8;         // kind phase seq result ui resState flags winPoseMask
+
+        // ---- kind ----
+        public const Byte KFighting = 0;
+        public const Byte KVictoryPending = 1;      // MENU_OFF + a victory seq: the tail has not run yet
+        public const Byte KVictory = 2;             // PHASE_VICTORY: fanfare, poses, victory camera
+        public const Byte KVictoryNoPose = 3;       // PHASE_CLOSE carrying VICTORY / VICTORY_NO_POSE (the fade path)
+        public const Byte KDefeat = 4;
+        public const Byte KEscape = 5;
+        public const Byte KOtherEnd = 6;            // PHASE_CLOSE carrying INTERRUPTION / ENEMY_FLEE / INITIAL
+        public const Byte KEvent = 7;               // a scripted battle event -- NOT an end
+
+        // ---- ui ----
+        public const Byte UiOther = 0;
+        public const Byte UiResult = 1;
+        public const Byte UiGameOver = 2;
+        public const Byte UiTitle = 3;
+
+        // ---- resState ----
+        public const Byte ResNoScreen = 0xFF;       // ui != 1
+        public const Byte ResLoadingBit = 0x80;
+
+        // ---- flags ----
+        public const Byte FlagAfterEvent = 1;
+        public const Byte FlagManifest = 2;         // stage 9: a result manifest follows the 8-byte block
+        public const Byte FlagItemOverflow = 4;     // stage 9: the host's UpdateItem overflowed (sticky)
+        public const Byte FlagEscapeGil = 8;
+        public const Byte FlagFieldSong = 16;       // BTL_CONTI_FLD_SONG
+
+        // ---- the result screen's states, pinned to the engine's own (private) enum through BattleResultUI's partial ----
+        public const Int32 ResStart = BattleResultUI.NetStateStart;
+        public const Int32 ResExpTick = BattleResultUI.NetStateEXPAndAPTick;
+        public const Int32 ResEndExp = BattleResultUI.NetStateEndEXPAndAP;
+        public const Int32 ResStartGil = BattleResultUI.NetStateStartGilAndItem;
+        public const Int32 ResItemFull = BattleResultUI.NetStateItemFullDialog;
+        public const Int32 ResGilTick = BattleResultUI.NetStateGilTick;
+        public const Int32 ResEnd = BattleResultUI.NetStateEnd;
+        public const Int32 ResHide = BattleResultUI.NetStateHide;
+        public const Int32 ResNone = BattleResultUI.NetStateNone;   // sorts AFTER Hide: never chased
+
+        /// <summary>One decoded (or sampled) end block. Public fields: the harness reads them.</summary>
+        public sealed class EndBlock
+        {
+            public Byte Kind, Phase, Seq, Result, Ui, ResState = ResNoScreen, Flags, WinPoseMask;
+            public Int32 ManifestLen;               // fmt-1 body bytes past the block while flags b1 is set (stage 9 parses them)
+
+            public Boolean Loading { get { return ResState != ResNoScreen && (ResState & ResLoadingBit) != 0; } }
+            public Int32 State { get { return ResState == ResNoScreen ? -1 : ResState & 0x7F; } }
+
+            public Boolean SameAs(EndBlock o)
+            {
+                return o != null && Kind == o.Kind && Phase == o.Phase && Seq == o.Seq && Result == o.Result && Ui == o.Ui
+                       && ResState == o.ResState && Flags == o.Flags && WinPoseMask == o.WinPoseMask;
+            }
+
+            public EndBlock Clone()
+            {
+                return (EndBlock)MemberwiseClone();
+            }
+
+            public override String ToString()
+            {
+                return KindName(Kind) + " (phase " + Phase + " seq " + Seq + " result " + Result + "; ui " + Ui + ", res "
+                       + (ResState == ResNoScreen ? "-" : State + (Loading ? "L" : "")) + ", flags 0x" + Flags.ToString("X2")
+                       + ", pose 0x" + WinPoseMask.ToString("X2") + ")";
+            }
+        }
+
+        public static String KindName(Int32 kind)
+        {
+            switch (kind)
+            {
+                case KFighting: return "fighting";
+                case KVictoryPending: return "victory-pending";
+                case KVictory: return "victory";
+                case KVictoryNoPose: return "victory-no-pose";
+                case KDefeat: return "defeat";
+                case KEscape: return "escape";
+                case KOtherEnd: return "other-end";
+                case KEvent: return "event";
+                default: return "kind " + kind;
+            }
+        }
+
+        // ==================================================================================== ClassifyEnd (design 5.2)
+        /// <summary>
+        /// The host's (phase, seq, result) -> kind. Why each branch: var 33 with val != 1 lands in PHASE_CLOSE carrying that
+        /// result (btl_scrp.cs:786-799: a scripted DEFEAT is CLOSE + 3, so CLOSE + DEFEAT/GAMEOVER is Defeat), and var 32
+        /// parks the host in MENU_OFF/EVENT with result 0 (btl_scrp.cs:774-784) -- treating seq 2 as an end would freeze the
+        /// guest, whose reconciler quiesces outside NORMAL. Pure; never throws.
+        /// </summary>
+        public static Byte ClassifyEnd(Byte phase, Byte seq, Byte result)
+        {
+            switch (phase)
+            {
+                case FF9StateBattleSystem.PHASE_MENU_OFF:
+                    if (seq == FF9StateBattleSystem.SEQ_MENU_OFF_VICTORY || seq == FF9StateBattleSystem.SEQ_MENU_OFF_VICTORY_WITH_ENEMY)
+                        return KVictoryPending;
+                    if (seq == FF9StateBattleSystem.SEQ_MENU_OFF_DEFEAT)
+                        return KDefeat;
+                    if (seq == FF9StateBattleSystem.SEQ_MENU_OFF_ESCAPE)
+                        return KEscape;
+                    return KEvent;                  // seq 2 = var 32 / the auto-end transient: NOT an end
+                case FF9StateBattleSystem.PHASE_VICTORY:
+                    return KVictory;
+                case FF9StateBattleSystem.PHASE_DEFEAT:
+                    return KDefeat;
+                case FF9StateBattleSystem.PHASE_CLOSE:
+                    if (result == FF9StateGlobal.BTL_RESULT_VICTORY || result == FF9StateGlobal.BTL_RESULT_VICTORY_NO_POSE)
+                        return KVictoryNoPose;
+                    if (result == FF9StateGlobal.BTL_RESULT_ESCAPE)
+                        return KEscape;
+                    if (result == FF9StateGlobal.BTL_RESULT_DEFEAT || result == FF9StateGlobal.BTL_RESULT_GAMEOVER)
+                        return KDefeat;
+                    return KOtherEnd;               // INTERRUPTION, ENEMY_FLEE (and INITIAL)
+                case FF9StateBattleSystem.PHASE_EVENT:
+                    return KEvent;
+                default:
+                    return KFighting;
+            }
+        }
+
+        /// <summary>True for the kinds the guest presents as the end of the fight (everything but Fighting and Event).</summary>
+        public static Boolean IsEndKind(Int32 kind)
+        {
+            return kind >= KVictoryPending && kind <= KOtherEnd;
+        }
+
+        // ==================================================================================== ChaseStep (design 5.6)
+        /// <summary>
+        /// THE RESULT-SCREEN CHASE (the guest replay, stage 10): may a guest whose screen sits in local state L inject one
+        /// stock Confirm step now that the host reads H (with its Loading bit)? The table:
+        ///   Start                         H &gt; Start
+        ///   EXPAndAPTick, EndEXPAndAP     H &gt; EndEXPAndAP, or H == EndEXPAndAP while the host is Loading (its fade)
+        ///   StartGilAndItem               H &gt; StartGilAndItem
+        ///   ItemFullDialog                H &gt; ItemFullDialog
+        ///   GilTick                       H &gt; GilTick
+        ///   End                           H == Hide
+        /// and NEVER when H == None (None (8) sorts after Hide (7): an AfterEvent / no-result host is not "ahead"), nor from
+        /// Hide or None. A host at EndEXPAndAP without Loading is the natural end of the tick pages -- the local ticks end on
+        /// their own (no injected step). Pure; never throws.
+        /// </summary>
+        public static Boolean ChaseStep(Int32 local, Int32 host, Boolean hostLoading)
+        {
+            if (host == ResNone || host < ResStart || host > ResNone)
+                return false;
+            switch (local)
+            {
+                case ResStart:
+                    return host > ResStart;
+                case ResExpTick:
+                case ResEndExp:
+                    return host > ResEndExp || (host == ResEndExp && hostLoading);
+                case ResStartGil:
+                    return host > ResStartGil;
+                case ResItemFull:
+                    return host > ResItemFull;
+                case ResGilTick:
+                    return host > ResGilTick;
+                case ResEnd:
+                    return host == ResHide;
+                default:
+                    return false;                   // Hide, None, or out of range
+            }
+        }
+
+        // ==================================================================================== the codec
+        /// <summary>One fmt-1 record: header + the 8-byte end block (+ manifest bytes, which set flags b1). Pure.</summary>
+        public static Byte[] EncodeTrailer(EndBlock b, Byte[] manifest)
+        {
+            Int32 extra = manifest != null ? manifest.Length : 0;
+            Int32 len = EndBlockLen + extra;
+            if (len > 0xFFFF)
+                throw new ArgumentOutOfRangeException("manifest", "an end-block body cannot exceed 65535 bytes");
+            Byte[] t = new Byte[RecordHeaderLen + len];
+            t[0] = TrailerMagic;
+            t[1] = FmtEnd;
+            t[2] = (Byte)(len & 0xFF);
+            t[3] = (Byte)(len >> 8);
+            t[4] = b.Kind;
+            t[5] = b.Phase;
+            t[6] = b.Seq;
+            t[7] = b.Result;
+            t[8] = b.Ui;
+            t[9] = b.ResState;
+            t[10] = (Byte)(extra > 0 ? b.Flags | FlagManifest : b.Flags & ~FlagManifest);
+            t[11] = b.WinPoseMask;
+            if (extra > 0)
+                Buffer.BlockCopy(manifest, 0, t, RecordHeaderLen + EndBlockLen, extra);
+            return t;
+        }
+
+        /// <summary>
+        /// Read the trailer records from `offset` to the end of `payload`. Returns the fmt-1 END BLOCK, or null: no trailer
+        /// at all (a pre-B5 host: why = null), or a malformed one (why = the reason: truncated, foreign bytes, short body).
+        /// `skipped` counts unknown-fmt records stepped over. Pure and bounds-checked; never throws.
+        /// </summary>
+        public static EndBlock ReadTrailer(Byte[] payload, Int32 offset, out String why, out Int32 skipped)
+        {
+            why = null;
+            skipped = 0;
+            try
+            {
+                if (payload == null || offset < 0 || offset > payload.Length)
+                {
+                    why = "the unit records overran the frame";
+                    return null;
+                }
+                EndBlock found = null;
+                Int32 p = offset;
+                while (p < payload.Length)
+                {
+                    Int32 left = payload.Length - p;
+                    if (left < RecordHeaderLen)
+                    {
+                        why = "truncated record header (" + left + " byte(s))";
+                        return null;
+                    }
+                    if (payload[p] != TrailerMagic)
+                    {
+                        why = "foreign trailing bytes (0x" + payload[p].ToString("X2") + ", not the 0xB5 magic)";
+                        return null;
+                    }
+                    Byte fmt = payload[p + 1];
+                    Int32 len = payload[p + 2] | (payload[p + 3] << 8);
+                    if (len > left - RecordHeaderLen)
+                    {
+                        why = "truncated fmt-" + fmt + " body (" + (left - RecordHeaderLen) + " of " + len + " byte(s))";
+                        return null;
+                    }
+                    Int32 body = p + RecordHeaderLen;
+                    if (fmt == FmtEnd)
+                    {
+                        if (len < EndBlockLen)
+                        {
+                            why = "short end block (" + len + " of " + EndBlockLen + " byte(s))";
+                            return null;
+                        }
+                        EndBlock e = new EndBlock();
+                        e.Kind = payload[body];
+                        e.Phase = payload[body + 1];
+                        e.Seq = payload[body + 2];
+                        e.Result = payload[body + 3];
+                        e.Ui = payload[body + 4];
+                        e.ResState = payload[body + 5];
+                        e.Flags = payload[body + 6];
+                        e.WinPoseMask = payload[body + 7];
+                        e.ManifestLen = (e.Flags & FlagManifest) != 0 ? len - EndBlockLen : 0;
+                        found = e;                   // the last fmt-1 record wins (an encoder writes exactly one)
+                    }
+                    else
+                    {
+                        skipped++;                   // an unknown fmt: skip it by its len
+                    }
+                    p = body + len;
+                }
+                return found;
+            }
+            catch (Exception ex)
+            {
+                why = "trailer read faulted: " + ex.GetType().Name;
+                return null;
+            }
+        }
+
+        // ParseView's own call (NetSyncBattle): the trailer in its OWN try, malformed ones counted and logged once per
+        // reason per process (the type-1 lane runs at 30 Hz). Never throws.
+        private static Boolean _quiet;              // SelfTest's truncation sweep: no count, no log
+        private static Int32 _trailerBad;           // malformed trailers -- monotonic per process (read deltas)
+        private static Int32 _trailerSkipped;       // unknown-fmt records stepped over -- monotonic per process
+        private static String _trailerBadWhy;
+        private static readonly List<String> _trailerLogged = new List<String>(4);
+
+        internal static EndBlock ReadPeerTrailer(Byte[] payload, Int32 offset)
+        {
+            try
+            {
+                String why;
+                Int32 skipped;
+                EndBlock e = ReadTrailer(payload, offset, out why, out skipped);
+                if (_quiet)
+                    return e;
+                _trailerSkipped += skipped;
+                if (why != null)
+                {
+                    _trailerBad++;
+                    _trailerBadWhy = why;
+                    String key = why.Length > 24 ? why.Substring(0, 24) : why;
+                    if (!_trailerLogged.Contains(key) && _trailerLogged.Count < 16)
+                    {
+                        _trailerLogged.Add(key);
+                        Log.Message("[NetSync] battle frame: end-block trailer ignored -- " + why + "; the unit records are kept "
+                                    + "(trailer_bad=" + _trailerBad + ", logged once per reason)");
+                    }
+                }
+                return e;
+            }
+            catch
+            {
+                return null;
+            }
+        }
+
+        // ==================================================================================== the host side
+        // Sampled only from NetSyncBattle.SampleOwnBattle (an own battle being streamed) and the pumps' change tracker.
+        private const Int64 KeyUnset = -1;
+        private static Int64 _lastHostKey = KeyUnset;
+        private static EndBlock _lastHost;          // the block the last own-battle sample shipped (null between battles)
+        // THE STAGE'S RECEIPTS, kept apart so a bench can tell the detector from the effect (S4-2):
+        private static Int32 _hostChanges;          // end-state changes TrackHostEnd DETECTED this own battle (any lever)
+        private static Int32 _hostEdges;            // samples a change FORCED this own battle: taken with no command-phase
+                                                    // edge and the SampleMs cadence NOT due -- counted by the pumps INSIDE
+                                                    // their sample block (NoteEdgeSample), so a pump that stops honouring
+                                                    // the change trigger reads 0 here while _hostChanges still climbs
