+        private static Byte _hostLoggedUi = 0xFF;
+        private static readonly List<String> _hostTrail = new List<String>(24);
+        private static Int32 _hostTrailKey = -1;
+        private const Int32 TrailCap = 48;
+
+        // SELFTEST CALIBRATION LEVER (harness `netsync endbench host on|cadence|off`; cleared by every harness release):
+        // cadence = the trailer still ships but no change-triggered sample (the plain SampleMs cadence -- a state shorter
+        // than SampleMs can be missed); off = the pre-stage host (no trailer, no change sample). Under BOTH the tracker
+        // keeps TRACKING (end_changes climbs) and only stops asking the pumps to sample -- the lever reverts the stage's
+        // path, not its instrument (as TrackCommandPhase under `hostgates 0`), so end_edges == 0 under it is a red the
+        // pumps earn. Read only through HostMode, which also needs the selftest role: a lever stranded across an ini
+        // edit can never strip a real host.
+        public const Int32 ModeOn = 0, ModeCadence = 1, ModeOff = 2;
+        private static Int32 _benchHostMode = ModeOn;
+        public static Int32 HostMode
+        {
+            get { return _benchHostMode != ModeOn && NetSyncClient.IsSelfTestRole ? _benchHostMode : ModeOn; }
+        }
+
+        private static String ModeName(Int32 mode)
+        {
+            return mode == ModeCadence ? "cadence" : mode == ModeOff ? "off" : "on";
+        }
+
+        // The raw end state. ui reads the UI state machine: BattleResult (or Pause/Quit over it -- the host is still on its
+        // result screen, and the screen's state does not move while paused), GameOver, Title, else 0. Never throws.
+        private static void ReadHostRaw(out Byte phase, out Byte seq, out Byte result, out Byte ui, out Byte resState)
+        {
+            phase = FF9StateBattleSystem.PHASE_INIT_SYSTEM;
+            seq = 0;
+            result = 0;
+            ui = UiOther;
+            resState = ResNoScreen;
+            try
+            {
+                FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+                if (b != null)
+                {
+                    phase = b.btl_phase;
+                    seq = b.btl_seq;
+                }
+                result = FF9StateSystem.Common.FF9.btl_result;
+            }
+            catch { }
+            try
+            {
+                UIManager m = PersistenSingleton<UIManager>.Instance;
+                if (m == null)
+                    return;
+                UIManager.UIState st = m.State;
+                if ((st == UIManager.UIState.Pause || st == UIManager.UIState.Quit) && m.PreviousState == UIManager.UIState.BattleResult)
+                    st = UIManager.UIState.BattleResult;
+                if (st == UIManager.UIState.BattleResult)
+                {
+                    ui = UiResult;
+                    BattleResultUI r = m.BattleResultScene;
+                    if (r != null)
+                        resState = (Byte)r.NetStateByte;
+                }
+                else if (st == UIManager.UIState.GameOver)
+                {
+                    ui = UiGameOver;
+                }
+                else if (st == UIManager.UIState.Title)
+                {
+                    ui = UiTitle;
+                }
+            }
+            catch { }
+        }
+
+        private static Int64 HostKey()
+        {
+            Byte phase, seq, result, ui, resState;
+            ReadHostRaw(out phase, out seq, out result, out ui, out resState);
+            return phase | ((Int64)seq << 8) | ((Int64)result << 16) | ((Int64)resState << 24) | ((Int64)ui << 32);
+        }
+
+        /// <summary>The pumps, every own-battle tick (beside TrackCommandPhase): true = the end key changed since the last
+        /// tick, so sample NOW. It TRACKS under every lever (a change past the battle's first read counts in end_changes)
+        /// but answers true only while HostMode is on. Never throws.</summary>
+        internal static Boolean TrackHostEnd()
+        {
+            try
+            {
+                Int64 key = HostKey();
+                if (key == _lastHostKey)
+                    return false;
+                if (_lastHostKey != KeyUnset)
+                    _hostChanges++;                 // the battle's first read is an acquisition, not a change
+                _lastHostKey = key;
+                return HostMode == ModeOn;
+            }
+            catch
+            {
+                return false;
+            }
+        }
+
+        /// <summary>The pumps, INSIDE their sample block, when that sample exists only because TrackHostEnd fired (no
+        /// command-phase edge, the SampleMs cadence not due): the stage's EFFECT, published as `end_edges`.</summary>
+        internal static void NoteEdgeSample()
+        {
+            _hostEdges++;
+        }
+
+        /// <summary>An own battle's rising edge (both pumps): the tracker, the shipped block and the trail start clean. A
+        /// bench end left armed is disarmed here (see TryGetBenchEnd).</summary>
+        internal static void NoteHostBattleStart()
+        {
+            _lastHostKey = KeyUnset;
+            _lastHost = null;
+            _hostChanges = 0;
+            _hostEdges = 0;
+            _hostLoggedKind = 0xFF;
+            _hostLoggedUi = 0xFF;
+            _hostTrail.Clear();
+            _hostTrailKey = -1;
+            DisarmStaleBenchEnd();
+        }
+
+        /// <summary>An own battle's falling edge (Pump's else block; SelfTestPump through Reset): `host.end` reads null
+        /// between battles. The trail and the edge count stay readable until the next own battle.</summary>
+        internal static void NoteHostBattleEnd()
+        {
+            _lastHostKey = KeyUnset;
+            _lastHost = null;
+        }
+
+        /// <summary>The host end block as it stands now. Never throws (a torn read is a Fighting block).</summary>
+        internal static EndBlock SampleHost()
+        {
+            EndBlock e = new EndBlock();
+            Byte phase, seq, result, ui, resState;
+            ReadHostRaw(out phase, out seq, out result, out ui, out resState);
+            e.Phase = phase;
+            e.Seq = seq;
+            e.Result = result;
+            e.Ui = ui;
+            e.ResState = resState;
+            e.Kind = ClassifyEnd(phase, seq, result);
+            try
+            {
+                BONUS bonus = battle.btl_bonus;
+                if (bonus != null)
+                {
+                    if (bonus.Event)
+                        e.Flags |= FlagAfterEvent;
+                    if (bonus.escape_gil)
+                        e.Flags |= FlagEscapeGil;
+                }
+                if ((FF9StateSystem.Common.FF9.btl_flag & battle.BTL_CONTI_FLD_SONG) != 0)
+                    e.Flags |= FlagFieldSong;
+            }
+            catch { }
+            if (e.Kind == KVictoryPending || e.Kind == KVictory)
+                e.WinPoseMask = SampleWinPose();
+            return e;
+        }
+
+        // Bit per host btl_data slot whose player strikes the win pose: the victory tail's own test (battle.cs, the
+        // SEQ_MENU_OFF_VICTORY* case) -- a WinPose scene, a linked player with hp > 0 and none of BattleEndFull. Carried now,
+        // applied by a later round (owner decision 18). The slot is the btl_id's bit (bounded scan, never GetIndex).
+        private static Byte SampleWinPose()
+        {
+            try
+            {
+                FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+                if (b == null || b.btl_scene == null || !b.btl_scene.Info.WinPose || b.btl_list == null)
+                    return 0;
+                Int32 mask = 0;
+                Int32 guard = 0;
+                for (BTL_DATA d = b.btl_list.next; d != null && guard < 16; d = d.next, guard++)
+                {
+                    if (d.bi.player == 0 || d.cur.hp == 0 || btl_stat.CheckStatus(d, BattleStatusConst.BattleEndFull))
+                        continue;
+                    for (Int32 i = 0; i < 8; i++)
+                        if (d.btl_id == (UInt16)(1 << i))
+                            mask |= 1 << i;
+                }
+                return (Byte)mask;
+            }
+            catch
+            {
+                return 0;
+            }
+        }
+
+        /// <summary>
+        /// NetSyncBattle.SampleOwnBattle, after the unit-count backpatch: append this sample's END BLOCK trailer. The record
+        /// is encoded in full BEFORE the single write, so a fault leaves the frame trailer-less (a pre-B5 frame), never
+        /// half-written. The calibration lever `off` writes nothing. Never throws.
+        /// </summary>
+        internal static void WriteHostTrailer(BinaryWriter bw)
+        {
+            try
+            {
+                if (HostMode == ModeOff)
+                {
+                    _lastHost = null;
+                    return;
+                }
+                EndBlock e = SampleHost();
+                Byte[] t = EncodeTrailer(e, null);
+                bw.Write(t);
+                _lastHost = e;
+                NoteHostShipped(e);
+            }
+            catch
+            {
+                // swallow -- the netsync fail-safe law: the frame ships without a trailer
+            }
+        }
+
+        private static void NoteHostShipped(EndBlock e)
+        {
+            AppendTrail(_hostTrail, ref _hostTrailKey, e);
+            if (e.Kind == _hostLoggedKind && e.Ui == _hostLoggedUi)
+                return;
+            Boolean first = _hostLoggedKind == 0xFF;
+            String was = first ? null : KindName(_hostLoggedKind) + " ui " + _hostLoggedUi;
+            _hostLoggedKind = e.Kind;
+            _hostLoggedUi = e.Ui;
+            if (first && e.Kind == KFighting && e.Ui == UiOther)
+                return;                             // the ordinary opening: nothing to say
+            Log.Message("[NetSync] battle end block (host): " + (was != null ? was + " -> " : "") + e
+                        + " -- shipped on the type-1 lane");
+        }
+
+        // One compact trail entry per DISTINCT (kind, ui, resState) in arrival order: "kind/ui/state" with an L suffix while
+        // Loading, "-" for no result screen ("2/1/2L"). Capped (one "..." marks the cap); the harness reads the whole walk
+        // in one read, whatever its poll rate.
+        private static void AppendTrail(List<String> trail, ref Int32 lastKey, EndBlock e)
+        {
+            Int32 key = e.Kind | (e.Ui << 8) | (e.ResState << 16);
+            if (key == lastKey)
+                return;
+            lastKey = key;
+            if (trail.Count > TrailCap)
+                return;
+            if (trail.Count == TrailCap)
+            {
+                trail.Add("...");
+                return;
+            }
+            trail.Add(e.Kind + "/" + e.Ui + "/" + (e.ResState == ResNoScreen ? "-" : e.State + (e.Loading ? "L" : "")));
+        }
