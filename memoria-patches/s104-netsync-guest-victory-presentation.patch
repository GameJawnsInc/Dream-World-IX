+            }
+            catch (Exception ex)
+            {
+                _endFaulted = true;                      // never per-frame: the presentation stops for this boot
+                try { Log.Error("[NetSync] diorama END presentation faulted -- stopped for this boot (the watcher's stale-lane leave still ends the diorama): " + ex); }
+                catch { }
+            }
+        }
