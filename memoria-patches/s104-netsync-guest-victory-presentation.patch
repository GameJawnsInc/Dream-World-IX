+        /// <summary>
+        /// Called every frame from NetSyncClient.Update: the transport branch right after ReconcileTick, the selftest branch
+        /// right after SelfTestPump (design 6.3). One Boolean read outside a booted diorama. Never throws into the engine.
+        /// </summary>
+        public static void EndTick()
+        {
+            if (!_booted || _endFaulted)
+                return;
+            try
+            {
+                if (!Active || !NetSyncBattle.Enabled || !EndGuestRole)
