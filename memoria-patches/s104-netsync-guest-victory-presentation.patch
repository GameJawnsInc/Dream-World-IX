+        private static void EndWatchdogs(FF9StateBattleSystem b)
+        {
+            Int32 now = Environment.TickCount;
+            if (!_w1Fired && NetSyncEnd.W1Due(b.btl_phase, b.btl_seq, _w1Armed, now - _w1Since))
