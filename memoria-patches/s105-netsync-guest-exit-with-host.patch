+        //     it), so the teardown re-decides it from the host's LATEST terminal block of this boot (EndTick keeps reading it
+        //     through the leave fade). A leave before the host writes its result still carries nothing (the F3.3 residue).
+        //   STAGE 10 HAND-OFF -- the hide tail (the song shutdown + FadeInEx(256)) runs ONCE per return: the replay's own Hide
+        //     tail (seam b, NetReplayHidden) must call NoteReplayHideTail(), which makes the settle skip both halves.
+        //   THE LEVER -- `endbench exit off` (selftest only): the trigger still latches (end_leave.trigger), but no end-leave
+        //     and no settle: the pre-stage guest, which holds until `dioleave` / the stale-lane leave.
+        // The late-join decline (a watcher boot into an already-finished fight) lives in NetSyncClient.DioramaTick.
+        // Vanilla, solo and the host's own battle never reach any of it: every entry point needs a booted diorama.
+        // ---------------------------------------------------------------------------------------
+        private static Boolean _exitSeen;                 // EndTick recorded a block of THIS boot (the bench's or BootedWireNonce's)
+        private static NetSyncBattle.PeerEnd _exitLast;   // ...the latest one: the Leave-time settle reads it
+        private static Int32 _exitTrigger;                // NetSyncEnd.Trigger* latched this boot (TriggerNone = the host has not left)
+        private static String _exitHost;                  // the host's block at the latch, for the lines
+        // TICK-BASELINE LAW: both start from a REAL tick (_exitTryTick an hour back, so the first attempt is never rate-limited);
+        // _exitLatchTick is read only after a latch set it.
+        private static Int32 _exitLatchTick = Environment.TickCount;
+        private static Int32 _exitTryTick = Environment.TickCount - 3600000;
+        private static Int32 _exitTries;                  // Leave() calls the end-leave made this boot
+        private static Int32 _exitDeferred;               // attempts a scene fade deferred this boot (logged once)
+        private static Boolean _exitRequested;            // the end-leave's Leave() issued its Replace
+        private static Int32 _exitRequestMs = -1;         // the latch -> that request (ms)
+        private static String _exitWhy;                   // why the end-leave has not left (yet); null = requested
+        private static Boolean _settled;                  // SettleForReturn ran this boot
+        private static String _settleVia;                 // "end-leave" | "leave" (a ~ press, the watcher, the harness)
+        private static Int32 _stampPending = -1;          // the btl_result the teardown stamps (-1 = none)
+        private static Int32 _stampHost = -1;             // the host's raw result the settle read (-1 = no settle)
+        private static Int32 _stamped = -1;               // what the teardown wrote (-1 = nothing)
+        private static Int32 _stampedWas = -1;            // the guest's own btl_result just before it
+        private static Boolean _musicShut;                // the settle ran battle.ff9ShutdownStateBattleResult
+        private static String _musicWhy;                  // why it did not (a field song kept, the lever); null otherwise
+        private static Boolean _wipeLifted;               // the teardown lifted this boot's injected end fade
+        private static Boolean _settleNoGameOver;         // the diorama scene's NoGameOver at the settle (unreadable = false: a DEFEAT is not carried)
+        private static Boolean _replayHideTail;           // stage 10's replay ran the stock hide tail itself (NoteReplayHideTail)
+        private static Boolean _exitErrLogged;            // one fault line per boot
+
+        // Every Boot (through ResetEndPresentation): the exit, its settle and its receipts start clean (readable after the
+        // teardown until the next boot).
+        private static void ResetExit()
+        {
+            _exitSeen = false;
+            _exitLast = default(NetSyncBattle.PeerEnd);
+            _exitTrigger = NetSyncEnd.TriggerNone;
+            _exitHost = null;
+            _exitLatchTick = Environment.TickCount;
+            _exitTryTick = Environment.TickCount - 3600000;
+            _exitTries = 0;
+            _exitDeferred = 0;
+            _exitRequested = false;
+            _exitRequestMs = -1;
+            _exitWhy = null;
+            _settled = false;
+            _settleVia = null;
+            _stampPending = -1;
+            _stampHost = -1;
+            _stamped = -1;
+            _stampedWas = -1;
+            _musicShut = false;
+            _musicWhy = null;
+            _wipeLifted = false;
+            _settleNoGameOver = false;
+            _replayHideTail = false;
+            _exitErrLogged = false;
+        }
+
+        // The guest is following the host out: the exit latched and the lever is on (EndHudOff reads it too).
+        private static Boolean ExitFollowing
+        {
+            get { return _exitTrigger != NetSyncEnd.TriggerNone && NetSyncEnd.GuestExitMode == NetSyncEnd.ExitModeOn; }
+        }
+
+        // EndTick, every frame of a live booted diorama (a guest role, netsync on), BEFORE the presentation: latch the host's
+        // exit, then try the end-leave. True = the guest is following the host out (present nothing more). Never throws.
+        private static Boolean ExitTick(Boolean ours, NetSyncBattle.PeerEnd e)
+        {
+            try
+            {
+                Int32 mode = NetSyncEnd.GuestExitMode;
+                if (_exitTrigger == NetSyncEnd.TriggerNone)
+                {
+                    Int32 t = ours ? NetSyncEnd.HostExitTrigger(e.Ui, e.ResState) : NetSyncEnd.TriggerNone;
+                    if (t == NetSyncEnd.TriggerNone)
+                    {
+                        _exitWhy = mode == NetSyncEnd.ExitModeOn ? NetSyncEnd.ExitWhy(NetSyncEnd.ExitNotLatched)
+                                                                 : NetSyncEnd.ExitWhy(NetSyncEnd.ExitHeldByLever);
+                        return false;
+                    }
+                    _exitTrigger = t;
+                    _exitLatchTick = Environment.TickCount;
+                    _exitHost = NetSyncEnd.KindName(e.Kind) + " (phase " + e.Phase + " seq " + e.Seq + " result " + e.Result + ", ui "
+                                + e.Ui + ", res " + (e.State < 0 ? "-" : e.State + (e.Loading ? "L" : ""))
+                                + (e.Bench ? ", BENCH end" : ", nonce " + e.Nonce) + ")";
+                    if (mode == NetSyncEnd.ExitModeOn)
+                        NetSyncBattle.StockMenuCloseAll("the host left its battle");   // a no-op unless the B4 lane touched the HUD
+                    Log.Message("[NetSync] diorama END: the host left its battle (" + NetSyncEnd.TriggerName(t) + ": the host's "
+                                + _exitHost + "; presented here: " + (NetSyncEnd.PresentName(_endAction) ?? "nothing") + ") -- "
+                                + (mode == NetSyncEnd.ExitModeOn
+                                    ? "the guest follows it out (the end-leave: Leave at 1 Hz, never into a fade)"
+                                    : "CALIBRATION: `endbench exit off` holds the pre-stage guest here (no end-leave, no settle)"));
+                }
+                Int32 now = Environment.TickCount;
+                Boolean fading;
+                try
+                {
+                    SceneDirector sd = PersistenSingleton<SceneDirector>.Instance;
+                    fading = sd != null && sd.IsFading;
+                }
+                catch
+                {
+                    fading = true;                               // unreadable = assume a fade: never fire a Leave blind
+                }
+                Int32 v = NetSyncEnd.ExitVerdict(mode, true, LeaveRequestedRecently, fading, now - _exitTryTick);
+                switch (v)
+                {
+                    case NetSyncEnd.ExitGo:
+                        break;
+                    case NetSyncEnd.ExitRateLimited:
+                        return true;                             // the last reason stands until the next attempt
+                    case NetSyncEnd.ExitFadeDefer:
+                        _exitTryTick = now;
+                        _exitDeferred++;
+                        _exitWhy = NetSyncEnd.ExitWhy(v);
+                        if (_exitDeferred == 1)
+                            Log.Message("[NetSync] diorama end-leave deferred: a scene fade is in flight -- retrying at 1 Hz "
+                                        + "(logged once per boot; end_leave.deferred counts the tries)");
+                        return true;
+                    case NetSyncEnd.ExitInFlight:
+                        _exitWhy = _exitRequested ? null : NetSyncEnd.ExitWhy(v);
+                        return true;
+                    default:                                     // the lever (the latch is set here)
+                        _exitWhy = NetSyncEnd.ExitWhy(v);
+                        return false;
+                }
+                _exitTryTick = now;
+                _exitTries++;
+                if (_exitTries <= 3 || _exitTries % 10 == 0)
+                    Log.Message("[NetSync] diorama END: end-leave attempt " + _exitTries + ", " + (now - _exitLatchTick) + " ms after "
+                                + "the host's " + NetSyncEnd.TriggerName(_exitTrigger) + " -- Leave() follows");
+                LeaveFrom("end-leave");
+                if (LeaveRequestedRecently)
+                {
+                    _exitRequested = true;
+                    _exitRequestMs = now - _exitLatchTick;
+                    _exitWhy = null;
+                }
+                else
+                {
+                    _exitWhy = "Leave() did not issue its Replace (Memoria.log names why) -- retrying at 1 Hz";
+                }
+                return true;
+            }
+            catch (Exception ex)
+            {
+                _exitWhy = "the exit tick faulted: " + ex.GetType().Name;
+                if (!_exitErrLogged)
+                {
+                    _exitErrLogged = true;
+                    try { Log.Error("[NetSync] diorama end-leave faulted (logged once per boot; the watcher's stale-lane leave still ends the diorama): " + ex); }
+                    catch { }
+                }
+                return false;
+            }
+        }
+
+        // LeaveFrom, after its fade check and before its Replace: once per boot, a Leave of a FINISHED fight (the latest block
+        // of this boot is terminal -- an end kind, or the host on its result screen / Game Over / the title) shuts the battle
+        // song down now and PROVISIONALLY decides the btl_result the teardown stamps (the teardown re-decides it from the host's
+        // latest block, with this scene's NoGameOver read here). A mid-fight opt-out, a manual boot never fed an end block, and
+        // the lever settle nothing. Never throws.
+        private static void SettleForReturn(String via)
+        {
+            if (_settled || !_exitSeen)
+                return;
+            try
+            {
+                NetSyncBattle.PeerEnd e = _exitLast;
+                if (!NetSyncEnd.IsTerminal(e.Kind, e.Ui))
+                    return;
+                if (NetSyncEnd.GuestExitMode != NetSyncEnd.ExitModeOn)
+                {
+                    _musicWhy = "the calibration lever `endbench exit off` (no settle)";
+                    return;
+                }
+                _settled = true;
+                _settleVia = via ?? "leave";
+                // the diorama boots the host's battle scene, so its NoGameOver is the host's: read it while the battle is live
+                // (unreadable = false -- a DEFEAT is then not carried, the pre-stage return)
+                try { _settleNoGameOver = FF9StateSystem.Battle.FF9Battle.btl_scene.Info.NoGameOver; }
+                catch { _settleNoGameOver = false; }
+                _stampHost = e.Result;
+                _stampPending = NetSyncEnd.StampFor(e.Result, _settleNoGameOver);   // provisional: the teardown re-decides it
+                if (_replayHideTail)
+                    _musicWhy = "the replay's own hide tail already shut the songs (stage 10): nothing shut down twice";
+                else if ((e.Flags & NetSyncEnd.FlagFieldSong) != 0)
+                    _musicWhy = "the host keeps its field song (BTL_CONTI_FLD_SONG): nothing shut down";
+                else if ((FF9StateSystem.Common.FF9.btl_flag & battle.BTL_CONTI_FLD_SONG) != 0)
+                    _musicWhy = "this diorama keeps its field song (BTL_CONTI_FLD_SONG): nothing shut down";
+                else
+                {
+                    battle.ff9ShutdownStateBattleResult();       // the stock result screen's hide: fade + stop the current song
+                    _musicShut = true;
+                }
+                Log.Message("[NetSync] diorama END: leaving a finished fight (" + _settleVia + "; the host's " + NetSyncEnd.KindName(e.Kind)
+                            + ", result " + e.Result + ", ui " + e.Ui + ") -- "
+                            + (_musicShut ? "the battle song shut down (ff9ShutdownStateBattleResult)" : _musicWhy)
+                            + "; the teardown stamps " + (_stampPending >= 0 ? "btl_result " + _stampPending
+                                                                             : "no btl_result (the host's " + e.Result + " is not carried"
+                                                                               + (e.Result == FF9StateGlobal.BTL_RESULT_DEFEAT && !_settleNoGameOver
+                                                                                  ? ": a DEFEAT outside a NoGameOver scene is a Game Over in transit)" : ")"))
+                            + " unless the host's latest block says otherwise by then"
+                            + (_endInjected && !_replayHideTail ? ", and lifts the injected end fade" : ""));
+            }
+            catch (Exception ex)
+            {
+                if (!_exitErrLogged)
+                {
+                    _exitErrLogged = true;
+                    try { Log.Error("[NetSync] diorama return settle faulted (logged once per boot): " + ex); }
+                    catch { }
+                }
+            }
+        }
+
+        // ForceDisarm, after Disarm: no battle frame runs any more, and the return's StartEvents has not run yet (OnDestroy
+        // lands first). The btl_result is RE-DECIDED from the host's latest terminal block of this boot (the Leave's decision
+        // was provisional: EndTick kept reading the host through the leave fade) and goes in; this boot's injected end fade is
+        // lifted (any teardown -- an exit ramp or a warp after an injection must not strand a black screen either; the lever
+        // keeps the pre-stage; stage 10's own hide tail lifts it instead). Never throws.
+        private static void ApplyReturnSettle()
+        {
+            try
+            {
+                String done = null;
+                if (_settled && _stamped < 0 && _exitSeen && NetSyncEnd.IsTerminal(_exitLast.Kind, _exitLast.Ui))
+                {
+                    Int32 leaveStamp = _stampPending, leaveHost = _stampHost;
+                    _stampHost = _exitLast.Result;
+                    _stampPending = NetSyncEnd.StampFor(_exitLast.Result, _settleNoGameOver);
+                    if (_stampPending != leaveStamp || _stampHost != leaveHost)
+                        done = "re-decided from the host's latest block (" + NetSyncEnd.KindName(_exitLast.Kind) + ", result " + _stampHost
+                               + ", ui " + _exitLast.Ui + (_settleNoGameOver ? ", a NoGameOver scene" : "") + "): stamp " + leaveStamp
+                               + " -> " + _stampPending + " (the Leave read the host's " + leaveHost + ")";
+                }
+                if (_stampPending >= 0)
+                {
+                    FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                    _stampedWas = ff9.btl_result;
+                    ff9.btl_result = (Byte)_stampPending;
+                    _stamped = _stampPending;
+                    _stampPending = -1;
+                    done = (done == null ? "" : done + "; ") + "btl_result " + _stampedWas + " -> " + _stamped + " (the host's " + _stampHost + ")";
+                }
+                // [fixer S6-R2] once per return: stage 10's replay Hide already ran FadeInEx(256) -- a second call would snap the
+                // subtract back to black (FF9Wipe_FadeInEx sets FadeMode.Sub white first) and restart the 256-frame ramp
+                if (_endInjected && !_wipeLifted && !_replayHideTail && NetSyncEnd.GuestExitMode == NetSyncEnd.ExitModeOn)
+                {
+                    SceneDirector.FF9Wipe_FadeInEx(256);
+                    _wipeLifted = true;
+                    done = (done == null ? "" : done + "; ") + "the injected end fade lifted (FF9Wipe_FadeInEx(256), the stock result "
+                           + "screen's hide tail)";
+                }
+                if (done != null)
+                    Log.Message("[NetSync] diorama END: return settled at the teardown -- " + done);
+            }
+            catch (Exception ex)
+            {
+                try { Log.Error("[NetSync] diorama return settle (teardown) faulted: " + ex); }
+                catch { }
+            }
+        }
+
+        // [ff9mapkit netsync B5] stage 6 -> stage 10 HAND-OFF (fixer S6-R2): the stock result screen's hide tail -- the song
+        // shutdown and FF9Wipe_FadeInEx(256) -- runs ONCE per return. Stage 10's replay Hide (BattleResultUI seam b,
+        // NetReplayHidden) runs that tail itself and MUST call this, so the Leave-time settle skips ff9ShutdownStateBattleResult
+        // and the teardown skips its fade lift. No caller before stage 10 (behaviour-identical until then). Never throws.
+        internal static void NoteReplayHideTail()
+        {
+            if (_booted)
+                _replayHideTail = true;
+        }
