+        public static Int32 HarnessExitDeferred { get { return _exitDeferred; } }
+        public static Boolean HarnessExitRequested { get { return _exitRequested; } }
+        public static Int32 HarnessExitRequestMs { get { return _exitRequestMs; } }
+        public static String HarnessExitWhy { get { return _exitWhy; } }
