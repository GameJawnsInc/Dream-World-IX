+        // The v1 command scope by CLASS (no per-pick id): null = ForwardStockCommand can carry this command; else why not.
+        // V1Action's classification minus its id checks -- keep the two in step.
+        private static String V1Scope(Int32 menu, Int32 cmdId)
+        {
+            BattleCommandId cmd = (BattleCommandId)cmdId;
+            if (menu == (Int32)BattleCommandMenu.AccessMenu || cmd == BattleCommandId.AccessMenu)
+                return "AccessMenu (the in-battle main menu) is outside the v1 command scope";
+            CharacterCommand cc;
+            if (!CharacterCommands.Commands.TryGetValue(cmd, out cc) || cc == null)
+                return null;                                 // stock: the capture refuses it if it is ever picked
+            if (BattleHUD.MixCommandSet.ContainsKey(cmd))
+                return "Mix is outside the v1 command scope (B4.2)";
+            if (menu == (Int32)BattleCommandMenu.Attack || cmd == BattleCommandId.Defend)
+                return null;
+            if (cmd == BattleCommandId.Change || menu == (Int32)BattleCommandMenu.Change)
+                return "Change is outside the v1 command scope (B4.2)";
+            if (menu == (Int32)BattleCommandMenu.Item)
+                return cc.Type == CharacterCommandType.Item ? null
+                     : cmd + " (a " + cc.Type + " command) is outside the v1 command scope (Throw rides B4.2)";
