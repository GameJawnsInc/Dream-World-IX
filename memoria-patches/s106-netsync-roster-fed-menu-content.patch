+                    return null;
+                if (cc.Type == CharacterCommandType.Normal || cc.Type == CharacterCommandType.Instant)
+                    return null;
+                return cmd + " (a " + cc.Type + " command) is outside the v1 command scope (Throw rides B4.2)";
