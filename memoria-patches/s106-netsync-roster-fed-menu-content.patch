+                    continue;
+                Int32 counterpart = other.ListEntry[j];
+                for (Int32 a = 0; a < host.Abilities.Count; a++)
+                    if (host.Abilities[a] != null && host.Abilities[a].Id == counterpart)
+                    {
+                        if (ContentLogFirst("bridge " + localSlot + "/" + menu))
+                            Log.Message("[NetSync] stock menu: local slot " + localSlot + " menu " + m + " shows " + (BattleCommandId)shownCmd
+                                        + " while the roster still lists the host's " + (BattleCommandId)host.CmdId + " -- its rows read the "
+                                        + "counterpart entries through stock's positional normal/trance pairing until the host's next roster "
+                                        + "(logged once per boot)");
+                        return host.Abilities[a];
+                    }
+                return null;
+            }
+            return null;
+        }
+
+        /// <summary>(3) A mirrored slot's ability state from the roster (abilId = the ability-index space GetAbilityState
