+        // ---- (7) the repaint: a content signature of the menu roster, retaken whenever the roster OBJECT changes (the
+        // peer lane re-parses at the pump's rate, the bench re-arms); every content change bumps the generation.
+        private static RosterView _sigRoster;
+        private static Boolean _sigTaken;
+        private static UInt64 _sigValue;                  // 0 = no menu roster
+        private static Int32 _rosterGen;                  // bumps on every change of the menu roster's CONTENT (monotonic)
+        private static Int32 _rosterGenPainted;           // the generation an open menu was last repainted for
+        private static Int32 _muteUntilFrame = -1;        // MuteActiveSound held by a repaint until this frame (-1 = not held)
+
+        private static void TrackRosterGen()
+        {
+            String src;
+            RosterView r = MenuRoster(out src);
+            if (_sigTaken && ReferenceEquals(r, _sigRoster))
+                return;
+            _sigTaken = true;
+            _sigRoster = r;
+            UInt64 sig = r == null ? 0UL : RosterSignature(r);
+            if (sig != _sigValue)
+            {
+                _sigValue = sig;
+                _rosterGen++;
+            }
+        }
+
+        // FNV-1a over every field the panels can draw, in the roster's own slot order (ParseRoster inserts in wire order, so the
+        // same bytes always walk the same order; no allocation -- the HUD calls this per frame on the peer lane). Never 0 for a
+        // roster (0 = none).
+        private static UInt64 RosterSignature(RosterView r)
+        {
+            UInt64 h = 14695981039346656037UL;
+            foreach (KeyValuePair<Int32, List<CmdView>> kv in r.Slots)
+            {
+                h = Fnv(h, 0x5100 + kv.Key);
+                List<CmdView> cmds = kv.Value;
+                if (cmds == null)
+                    continue;
+                foreach (CmdView c in cmds)
+                {
+                    if (c == null)
+                        continue;
+                    h = Fnv(Fnv(Fnv(Fnv(h, c.Menu), c.CmdId), c.Type), c.TargetType);
+                    foreach (AbilView a in c.Abilities)
+                        if (a != null)
+                            h = Fnv(Fnv(Fnv(h, a.Id), a.Mp), (a.Enabled ? 1 : 0) | (a.ForDead ? 2 : 0) | (a.TargetType << 2));
+                }
+            }
+            h = Fnv(h, 0x17E5);
+            foreach (ItemView it in r.Items)
+                if (it != null)
+                    h = Fnv(Fnv(h, it.Id), it.Count | (it.TargetType << 8) | (it.ForDead ? 0x10000 : 0));
+            return h == 0UL ? 1UL : h;
+        }
+
+        private static UInt64 Fnv(UInt64 h, Int32 v)
+        {
+            for (Int32 i = 0; i < 4; i++)
+            {
+                h ^= (Byte)(v >> (8 * i));
+                h *= 1099511628211UL;
+            }
+            return h;
+        }
+
+        /// <summary>(7) BattleHUD.UpdatePlayer, inside a diorama with a menu up: true once per change of the menu roster's
+        /// content (incl. it appearing or vanishing) -- the caller repaints (NetRefreshMenus). The first frame of a menu opened
+        /// after a change also answers true once (a muted, idempotent repaint). Never throws.</summary>
+        public static Boolean StockRosterRepaintDue(Int32 localSlot)
+        {
+            try
+            {
+                TrackRosterGen();
+                if (_rosterGenPainted == _rosterGen)
+                    return false;
+                _rosterGenPainted = _rosterGen;
+                if (!ContentOn(ContentRefresh))
+                    return false;
+                Hit(ContentRefresh);
+                if (ContentLogFirst("refresh " + localSlot))
+                    Log.Message("[NetSync] stock menu: the menu roster changed (generation " + _rosterGen + ") with local slot " + localSlot
+                                + "'s menu up -- repainted under MuteActiveSound (logged once per boot per slot)");
+                return true;
+            }
+            catch (Exception ex)
+            {
+                NoteContentFault("StockRosterRepaintDue", ex);
+                return false;
+            }
+        }
+
+        /// <summary>(7) Hold ButtonGroupState.MuteActiveSound across a content repaint and the 2-frame settle after it (the
+        /// list-refresh cursor-beep law). Released by StockMenuMuteSettle: every HUD frame (BattleHUD.UpdatePlayer calls it
+        /// unguarded -- one field compare when nothing is held), and forced by
+        /// StockMenuCloseAll (every teardown, every injected end) and every boot -- never stranded game-wide.</summary>
+        public static void StockMenuMute()
+        {
