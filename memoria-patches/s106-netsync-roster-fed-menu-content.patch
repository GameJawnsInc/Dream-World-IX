+        // A roster ability by ACTIVE id: in the given menu's command (menu < 0 = any of the slot's commands). Null = absent.
+        private static AbilView FindRosterAbility(List<CmdView> cmds, Int32 menu, Int32 activeId)
+        {
+            for (Int32 i = 0; i < cmds.Count; i++)
+            {
+                CmdView c = cmds[i];
+                if (c == null || (menu >= 0 && c.Menu != menu))
+                    continue;
+                for (Int32 a = 0; a < c.Abilities.Count; a++)
+                    if (c.Abilities[a] != null && c.Abilities[a].Id == activeId)
+                        return c.Abilities[a];
+            }
+            return null;
+        }
