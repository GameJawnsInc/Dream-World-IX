+        // (3) THE TRANCE BRIDGE. The stand-in's Trance bit is mirrored every sample, but the host rebuilds the roster only every
+        // RosterMs, so for up to a roster period the open menu shows the preset's TRANCE command (Dyne, Eidolon, Elan) while the
+        // roster still lists its NORMAL counterpart (Skill, Summon, Flair) -- or the reverse on leaving Trance. ResolveMenuCommand
+        // rightly keeps the local command, but a trance list whose ability ids differ from the normal one's would draw every
+        // row blank. Stock's own rule (SetAbilityTrance) learns trance entry j iff normal entry j is learned, so the row reads
+        // the counterpart's roster entry through that positional pairing (its Enabled flag; the MP column stays stock for a
+        // bridged row -- RosterAbilityMp does not bridge). ONLY when the roster's command for the menu and the shown one are
+        // exactly the stand-in preset's patched {normal, trance} pair (the case ResolveMenuCommand tolerates); anything else
+        // answers null (a blank row). Cheap on the steady path: the roster command equal to the shown one returns at once.
+        private static AbilView TranceBridge(Int32 localSlot, List<CmdView> cmds, Int32 menu, Int32 activeId, Int32 shownCmd)
+        {
+            if (menu < 0 || shownCmd <= 0)
+                return null;
+            CmdView host = null;
+            for (Int32 i = 0; i < cmds.Count; i++)
+                if (cmds[i] != null && cmds[i].Menu == menu)
+                {
+                    host = cmds[i];
+                    break;
+                }
+            if (host == null || host.CmdId == shownCmd || host.Abilities == null)
+                return null;
+            CharacterCommand shown, other;
+            if (!CharacterCommands.Commands.TryGetValue((BattleCommandId)shownCmd, out shown) || shown == null || shown.ListEntry == null
+                || shown.Type != CharacterCommandType.Ability
+                || !CharacterCommands.Commands.TryGetValue((BattleCommandId)host.CmdId, out other) || other == null || other.ListEntry == null
+                || other.Type != CharacterCommandType.Ability)
+                return null;
+            BattleUnit unit = FF9StateSystem.Battle.FF9Battle.GetUnit(localSlot);
+            PLAYER player = unit.Player;
+            PLAYER member = FF9StateSystem.Common.FF9.party.member[unit.Position];
+            CharacterCommandSet set;
+            if (player == null || member == null || !CharacterCommands.CommandSets.TryGetValue(member.PresetId, out set) || set == null)
+                return null;
+            BattleCommandMenu m = (BattleCommandMenu)menu;
+            Int32 normal = (Int32)BattleCommandHelper.Patch(set.GetRegular(m), m, player, unit);
+            Int32 trance = (Int32)BattleCommandHelper.Patch(set.GetTrance(m), m, player, unit);
+            if (normal == trance || !((shownCmd == normal && host.CmdId == trance) || (shownCmd == trance && host.CmdId == normal)))
+                return null;
+            Int32 n = Math.Min(shown.ListEntry.Length, other.ListEntry.Length);
+            for (Int32 j = 0; j < n; j++)
