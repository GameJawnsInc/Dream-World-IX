+                slots.Sort();
+                bw.Write((Byte)slots.Count);
+                foreach (Int32 s in slots)
+                {
+                    List<CmdView> cmds = r.Slots[s] ?? new List<CmdView>();
+                    bw.Write((Byte)s);
+                    bw.Write((Byte)cmds.Count);
+                    foreach (CmdView c in cmds)
+                    {
+                        bw.Write((Byte)c.Menu);
+                        bw.Write((UInt16)c.CmdId);
+                        bw.Write((Byte)c.Type);
+                        bw.Write((Byte)c.TargetType);
+                        Int32 n = Math.Min(c.Abilities.Count, 255);
+                        bw.Write((Byte)n);
+                        for (Int32 i = 0; i < n; i++)
+                        {
+                            AbilView a = c.Abilities[i];
+                            bw.Write((UInt16)a.Id);
+                            bw.Write((Byte)Math.Min(a.Mp, 255));
+                            bw.Write((Byte)((a.Enabled ? 1 : 0) | (a.ForDead ? 2 : 0)));
+                            bw.Write((Byte)a.TargetType);
+                        }
+                    }
+                }
+                bw.Write((UInt16)r.Items.Count);
+                foreach (ItemView it in r.Items)
+                {
+                    bw.Write((UInt16)it.Id);
+                    bw.Write((Byte)Math.Min(it.Count, 255));
+                    bw.Write((Byte)it.TargetType);
+                    bw.Write((Byte)(it.ForDead ? 1 : 0));
+                }
+                return ms.ToArray();
+            }
+        }
