+            if (held && QuitPromptUp())
+            {
+                // [ff9mapkit netsync B4] stage 8 (fixer) -- never under the guest's own Quit prompt (its OnKeyQuit disables the
+                // menu, so the gate fails there): SetIdle's DisableAllGroup would take the prompt's Yes/No (a dead Confirm),
+                // and its Cancel restores QuitUI's stashed CommandGroupButton over a closed panel with CurrentPlayerIndex -1
+                // (every Confirm then throws). The slots stay held; the first tick after the prompt hides reconciles them.
+                if (MirrorLogFirst(KeyQuitDefer))
+                    Log.Message("[NetSync] stock menu: the guest's Quit prompt is up -- the ready mirror holds its slots and settles "
+                                + "them when the prompt hides (logged once per boot)");
+            }
+            else if (held)
+                StockMenuCloseAll("ready mirror: " + (owns ? "waiting: " + BenchMenuGateText(gate) : why));
+            if (!owns && why != null && dioramaActive && MirrorLogFirst(why))
+                Log.Message("[NetSync] stock menu: the ready mirror is not serving -- " + why + "; the digit panel serves the guest's "
+                            + "slots (logged once per boot per reason)");
+        }
+
+        private const String KeyQuitDefer = "quit-prompt defer";
+
+        // The guest's own Quit prompt is showing (QuitUI owns the button groups). Never throws.
+        private static Boolean QuitPromptUp()
+        {
+            try
+            {
+                QuitUI quit = PersistenSingleton<UIManager>.Instance.QuitScene;
+                return quit != null && quit.isShowQuitUI;
+            }
+            catch
+            {
+                return false;
+            }
+        }
+
+        private static void MirrorFault(Exception ex)
+        {
+            try
+            {
+                Boolean first = !_mirrorFaulted;
+                _mirrorFaulted = true;
+                _mirrorFaultWhy = ex.GetType().Name + ": " + ex.Message;
+                _mirrorFaultReason = "the ready mirror faulted this boot (" + _mirrorFaultWhy + ")";
+                StockMenuCloseAll("ready mirror faulted");
+                if (first)
+                    Log.Message("[NetSync] stock menu: the ready mirror FAULTED (" + _mirrorFaultWhy + ") -- the stock menu closed and the "
+                                + "digit panel serves the guest's slots until the next diorama boot");
+            }
+            catch { }
+        }
+
+        // The menu roster (MenuRoster: the bench roster, else the live peer roster under the party mirror) carries this WIRE slot.
+        private static Boolean MenuRosterHas(Int32 wire)
+        {
+            String src;
+            RosterView r = MenuRoster(out src);
+            List<CmdView> cmds;
+            return r != null && r.Slots.TryGetValue(wire, out cmds) && cmds != null;
+        }
+
+        // One serving tick: per guest wire slot, the Ready bit onto the stock queues (design 4.6).
+        private static void MirrorServe(BattleView view, BattleHUD hud)
+        {
+            Int32 now = Environment.TickCount;
+            if (view.Nonce != _mirrorNonce)
+            {
+                _mirrorNonce = view.Nonce;
+                _strandedTurn = 0;                        // a new battle: every slot tries the stock menu again
+                _noRosterWait = 0;                        // ...and every roster wait restarts
+            }
+            Int32 seen = 0, stranded = 0, noRoster = 0;
+            for (Int32 i = 0; i < view.Units.Count; i++)
+            {
+                UnitView u = view.Units[i];
+                if (!u.IsPlayer || u.Index < 0 || u.Index > 3 || (view.GuestSlots & (1 << u.Index)) == 0)
+                    continue;
+                Int32 w = u.Index, wbit = 1 << w;
+                Boolean up = u.Ready && u.Alive;
+                if (!up)
+                    _strandedTurn &= ~wbit;               // the turn is over: a later Ready tries the stock menu again
+                Int32 L = BenchFeedArmed && _feedUnmap == w ? -1 : NetSyncDiorama.LocalIndexForWire(w);
+                if (L < 0)
+                {
+                    _noRosterWait &= ~wbit;
+                    if (up)
+                    {
+                        stranded |= wbit;                 // no local seat: the digit panel serves it (wire-indexed already)
+                        if (MirrorLogFirst(KeyUnmapped[w]))
+                            Log.Message("[NetSync] stock menu: wire slot " + w + " is Ready but has no local seat in this diorama"
+                                        + (BenchFeedArmed && _feedUnmap == w ? " (the bench `unmap` lever)" : " (its character was not seated)")
+                                        + " -- STRANDED: the digit panel serves it (logged once per boot)");
+                    }
+                    continue;
+                }
+                Int32 lbit = 1 << L;
+                seen |= lbit;
+                Boolean queued = hud.ReadyQueue.Contains(L);
+                Boolean finished = hud.InputFinishList.Contains(L);
+                if ((_pendMask & lbit) != 0)
+                {
+                    Boolean obsolete = view.Nonce != _pendNonce[L] || !u.Alive;
+                    if (obsolete || !u.Ready)
+                    {
+                        _pendMask &= ~lbit;
+                        _mirrorMask &= ~lbit;
+                        hud.NetStockMenuClose(L);
+                        if (obsolete)
+                            _mirrorObsolete++;
+                        else
+                            _mirrorAccepted++;
+                        if (MirrorLogFirst((obsolete ? "obsolete " : "accepted ") + L))
+                            Log.Message("[NetSync] stock menu: local slot " + L + " (wire " + w + ") -- the forwarded command "
+                                        + (obsolete ? "is OBSOLETE (" + (view.Nonce != _pendNonce[L] ? "a new battle nonce" : "the host's unit fell") + ")"
+                                                    : "was ACCEPTED (the host's Ready bit fell after " + (now - _pendTick[L]) + " ms)")
+                                        + "; the slot left the stock queues (logged once per boot per slot)");
+                        continue;
+                    }
+                    Int32 seqs = (UInt16)(view.Seq - _pendSeq[L]);
+                    if (now - _pendTick[L] < MirrorRefuseMs || seqs < MirrorRefuseSeqs)
+                        continue;                         // the host has not answered yet: the slot stays shut
+                    _pendMask &= ~lbit;
+                    _mirrorMask &= ~lbit;
+                    _mirrorRefused++;
+                    hud.NetStockMenuClose(L);
+                    queued = finished = false;
+                    FF9Sfx.FF9SFX_Play(102);
+                    if (_mirrorRefuseLogs < MirrorRefuseLogCap)
+                    {
+                        _mirrorRefuseLogs++;
+                        Log.Message("[NetSync] stock menu: local slot " + L + " (wire " + w + ") -- the host's Ready bit is still up "
+                                    + (now - _pendTick[L]) + " ms and " + seqs + " samples after the forwarded command: REFUSED or lost -- "
+                                    + "buzzer, the slot reopens at the root (refused=" + _mirrorRefused
+                                    + (_mirrorRefuseLogs == MirrorRefuseLogCap ? "; further refusals this boot are counted, not logged" : "") + ")");
+                    }
+                    // falls through: its bit is still up, so the slot reopens below
+                }
+                Boolean want = up;
+                if (up && !MenuRosterHas(w))
+                {
+                    if ((_strandedTurn & wbit) == 0)
+                    {
+                        if ((_noRosterWait & wbit) == 0)
+                        {
+                            _noRosterWait |= wbit;        // the wait starts (serving ticks only: a stand-down restarts it)
+                            _noRosterSince[w] = now;
+                        }
+                        else if (now - _noRosterSince[w] >= MirrorNoRosterMs)
+                        {
+                            _noRosterWait &= ~wbit;
+                            _strandedTurn |= wbit;        // the bounded wait ran out: STRANDED for this turn (G7), below
+                            if (MirrorLogFirst(KeyNoRosterStrand[w]))
+                                Log.Message("[NetSync] stock menu: wire slot " + w + " has been Ready " + (now - _noRosterSince[w])
+                                            + " ms with no host menus in the roster -- STRANDED for this turn: the digit panel serves it "
+                                            + "([1] Attack / [2] Defend; G7; logged once per boot per slot)");
+                        }
+                    }
+                    if ((_strandedTurn & wbit) == 0)
+                    {
+                        want = false;                     // the host's menu content has not arrived: wait (never a stand-in's menu)
+                        noRoster |= wbit;
+                        if (MirrorLogFirst(KeyNoRoster[w]))
+                            Log.Message("[NetSync] stock menu: wire slot " + w + " is Ready but the menu roster does not carry it yet -- "
+                                        + "the stock menu waits for the host's menus, at most " + MirrorNoRosterMs
+                                        + " ms (logged once per boot per slot)");
+                    }
+                    else if (queued || finished)
+                    {
+                        hud.NetStockMenuClose(L);         // its menus left mid-turn: off the stock queues before the digit panel serves it
+                        _mirrorClosed++;
+                        _mirrorMask &= ~lbit;
+                        queued = finished = false;
+                    }
+                }
+                else
+                {
+                    _noRosterWait &= ~wbit;               // Ready fell, or the roster carries it: no wait running
+                }
+                if (!want)
+                {
+                    if (queued || finished)
+                    {
+                        hud.NetStockMenuClose(L);
+                        _mirrorClosed++;
+                        if (MirrorLogFirst("closed " + L))
+                            Log.Message("[NetSync] stock menu: local slot " + L + " (wire " + w + ") closed -- its Ready bit fell "
+                                        + "(or the host's unit fell / its menus are gone) (logged once per boot per slot)");
+                    }
+                    _mirrorMask &= ~lbit;
+                    continue;
+                }
+                if ((_strandedTurn & wbit) != 0)
+                {
+                    stranded |= wbit;                     // the stock feeder refused it earlier this turn: the digit panel's
+                    continue;
+                }
+                if (finished)
+                {
+                    hud.NetStockMenuClose(L);             // committed with no verdict pending (a commit outside the mirror): a clean turn
+                    queued = false;
+                }
+                if (!queued)
+                {
+                    String refusal;
+                    if (hud.NetStockMenuOpen(L, out refusal))
+                    {
+                        _mirrorMask |= lbit;
+                        _mirrorFed++;
+                        _stockTouched = true;             // StockMenuCloseAll's licence to touch the HUD
+                        _autoRefusedMask &= ~lbit;        // a re-feed re-arms a parked auto-battle refusal (stage 3)
+                        if (MirrorLogFirst("fed " + L))
+                            Log.Message("[NetSync] stock menu: wire slot " + w + " Ready -> local slot " + L + " is on the stock ReadyQueue; "
+                                        + "the stock command menu opens for it (logged once per boot per slot)");
+                    }
+                    else
+                    {
+                        _strandedTurn |= wbit;
+                        stranded |= wbit;
+                        if (MirrorLogFirst("stranded " + L))
+                            Log.Message("[NetSync] stock menu: wire slot " + w + " is Ready but local slot " + L + " cannot take the stock "
+                                        + "menu (" + refusal + ") -- STRANDED for this turn: the digit panel serves it (G7; logged once per boot per slot)");
+                    }
+                }
+                else
+                {
+                    _mirrorMask |= lbit;                  // already queued and awaiting input: the mirror owns it from here
+                }
+            }
+            Int32 orphan = (_mirrorMask | _pendMask) & ~seen & 0x0F;
+            for (Int32 L = 0; L < 4 && orphan != 0; L++)
+            {
+                if ((orphan & (1 << L)) == 0)
+                    continue;
+                orphan &= ~(1 << L);
+                _mirrorMask &= ~(1 << L);
+                _pendMask &= ~(1 << L);
+                hud.NetStockMenuClose(L);
+                _mirrorClosed++;
+                if (MirrorLogFirst("orphan " + L))
+                    Log.Message("[NetSync] stock menu: local slot " + L + " closed -- no guest unit of the host's lane maps to it any more "
+                                + "(the offer changed or the unit left; logged once per boot per slot)");
+            }
+            _strandedMask = stranded;
+            _noRosterMask = noRoster;
+        }
+
+        // ---------------------------------------------------------------------------------------- the selftest bench feed
+        // [ff9mapkit netsync B4] stage 8 -- `netsync bbench start|stop|ready|caps|mode|freeze|unmap|knob` (selftest role only).
+        // A selftest machine is NOT the host of its own diorama: `dioboot` boots BattleMapDebug with gMode 1, so SelfTestPump's
+        // loopback never samples it and no type-1 lane exists there. The FEED is that lane: every SampleMs (and at once on any
+        // lever change) it builds a type-1 frame in SampleOwnBattle's v10 layout FROM THE DIORAMA'S LIVE UNITS -- each player at
+        // its WIRE index (NetSyncDiorama.WireIndexForLocal; identity on a bench, which seats the guest's own party), the Ready
+        // bits from `ready`, the header flags byte from `caps`, its own nonce -- and runs it through the REAL ParseView into the
+        // production peer view (_peerView / PeerBattleLive: what LivePeerView serves the mirror, the digit panel and the
+        // harness's `netsync.battle.peer`). It then runs Pump's guest branch on it: the control frame as Pump would build it
+        // (recorded), GuestAssistTick (the production digit-panel decision -- AssistInputActive, `assist_slot`, DrawGUI's menu
+        // half) and, standing in for the socket, the BENCH HOST: every forwarded stock frame and every digit-panel frame is
+        // decoded by the host's own TryDecodeCommand and answered -- `mode accept` clears that wire slot's Ready bit at once (the
+        // host queued it), `mode refuse` leaves it up (the host refused). `freeze` stops the frames: the lane goes stale after
+        // StaleMs, exactly as a dead link. `unmap <w>` makes the mirror treat wire slot w as unseated. `knob` forces the
+        // GuestStockMenu knob. The menu content is the bench roster (`bbench roster ...`), which rides the feed's lane. The feed
+        // ends with its diorama (Booted false or a new boot), `bbench stop`, or the harness release. No trailer is appended: the
+        // feed never presents an end (EndTick reads the `endbench` seam).
+        private static Boolean _feedArmed;
+        private static Boolean _feedPublished;        // the feed wrote the peer view (its end clears it)
+        private static Int32 _feedGuestSlots;         // the offer (view.GuestSlots): WIRE slots
+        private static Int32 _feedReady;              // the WIRE Ready bits
+        private static Int32 _feedCaps = CapCommandPhaseGated;
+        private static Boolean _feedRefuse;           // mode: false = accept, true = refuse
+        private static Boolean _feedFrozen;
+        private static Int32 _feedUnmap = -1;         // a WIRE slot the mirror treats as unseated (-1 = none)
+        private static Byte _feedNonce = 0xB8;        // bumped per start (a restart obsoletes a pending command)
+        private static UInt16 _feedSeq = 0x8000;
+        private static Int32 _feedLastTick = Environment.TickCount - 60000;   // tick-baseline law
+        private static Boolean _feedForce;            // a lever changed: build a frame on the next tick
+        private static Boolean _feedMenuOpen;         // the control frame Pump would send this tick (menu open)
+        private static Int32 _feedFrames, _feedTaken, _feedAcceptedN, _feedRefusedN, _feedBad;   // per start
+        private static String _feedLast;              // the last frame the bench host took, decoded, with its verdict
+
+        private static Boolean BenchFeedArmed
+        {
+            get { return _feedArmed && NetSyncClient.IsSelfTestRole; }
+        }
+
+        private static void BenchFeedTick()
+        {
+            try
+            {
+                if (!NetSyncClient.IsSelfTestRole)
+                {
+                    StopFeed("the selftest role ended");
+                    return;
+                }
+                if (!NetSyncDiorama.Booted)
+                {
+                    StopFeed("its diorama ended");
+                    return;
+                }
+                if (!NetSyncDiorama.Active)
+                    return;                               // a scene transition: nothing published this tick (SelfTestPump cleared it)
+                Int32 now = Environment.TickCount;
+                // 1. the bench HOST's intake: what Pump would have handed the socket (production: DrainStockOutbox)
+                while (_stockOutbox.Count > 0)
+                {
+                    BenchTake(_stockOutbox.Dequeue(), "stock menu");
+                    _stockSent++;
+                }
+                // 2. the type-1 lane, through the REAL ParseView
+                if (!_feedFrozen && (_feedForce || now - _feedLastTick > SampleMs))
+                {
+                    _feedForce = false;
+                    _feedLastTick = now;
+                    BattleView v = ParseView(BuildFeedFrame());
+                    if (v != null)
+                    {
+                        _peerView = v;
+                        _peerViewTick = now;
+                        _feedFrames++;
+                    }
+                    else
+                    {
+                        _feedBad++;
+                    }
+                }
+                // 3. Pump's guest branch on it
+                Boolean live = _peerView != null && now - _peerViewTick < StaleMs;
+                PeerBattleLive = live;
+                _feedPublished = true;
+                if (live)
+                {
+                    _feedMenuOpen = FirstReadyGuestSlot(_peerView) >= 0;   // the control frame, unchanged
+                    Byte[] digit = GuestAssistTick(_peerView, _benchRoster);
+                    if (digit != null)
+                        BenchTake(digit, "digit panel");
+                }
+                else
+                {
+                    _feedMenuOpen = false;
+                    AssistInputActive = false;
+                    _assistSlot = -1;
+                    _assistRoster = null;
+                    ResetUi();
+                }
+            }
+            catch (Exception ex)
+            {
+                StopFeed("faulted -- " + ex.GetType().Name + ": " + ex.Message);
+            }
+        }
+
+        // The feed's type-1 frame: SampleOwnBattle's exact v10 layout (header, unit records, no trailer) from the diorama's units.
+        private static Byte[] BuildFeedFrame()
+        {
+            FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+            using (MemoryStream ms = new MemoryStream(420))
+            using (BinaryWriter bw = new BinaryWriter(ms))
+            {
+                bw.Write(_feedSeq++);
+                UInt16 mapNo = 0;
+                try { mapNo = (UInt16)FF9StateSystem.Common.FF9.btlMapNo; } catch { }
+                bw.Write(mapNo);
+                bw.Write((Byte)(_feedGuestSlots & 0x0F));
+                Byte patNum = 0;
+                Byte startType = (Byte)battle_start_type_tags.BTL_START_NORMAL_ATTACK;
+                try
+                {
+                    if (b.btl_scene != null)
+                    {
+                        patNum = b.btl_scene.PatNum;
+                        startType = (Byte)b.btl_scene.Info.StartType;
+                    }
+                }
+                catch { }
+                bw.Write(patNum);
+                bw.Write(startType);
+                bw.Write((Byte)_feedCaps);
+                bw.Write(_feedNonce);
+                bw.Write((UInt16)0xFFFF);                  // songId: unknown
+                Int64 countPos = ms.Position;
+                bw.Write((Byte)0);
+                Int32 count = 0;
+                for (Int32 index = 0; index <= 7 && count < 8; index++)
+                {
+                    BTL_DATA d = b.btl_data[index];
+                    if (d == null || d.btl_id != (UInt16)(1 << index))
+                        continue;
+                    Boolean isPlayer = d.bi.player != 0;
+                    Int32 wire = isPlayer ? NetSyncDiorama.WireIndexForLocal(index) : index;
+                    if (wire < 0 || wire > 7)
+                        continue;
+                    BattleUnit unit = new BattleUnit(d);
+                    Boolean alive = d.cur.hp > 0 && (d.stat.cur & BattleStatus.Death) == 0;
+                    Boolean ready = isPlayer && wire < 4 && (_feedReady & (1 << wire)) != 0;
+                    Byte info = 0;
+                    if (isPlayer) info |= 1;
+                    if (alive) info |= 2;
+                    if (ready) info |= 4;
+                    if (unit.InTrance) info |= 8;
+                    bw.Write((Byte)wire);
+                    bw.Write(info);
+                    bw.Write(unit.CurrentHp);
+                    bw.Write(unit.MaximumHp);
+                    bw.Write(unit.CurrentMp);
+                    bw.Write(unit.MaximumMp);
+                    bw.Write((UInt16)Math.Max((Int16)0, unit.CurrentAtb));
+                    bw.Write((UInt16)Math.Max((Int16)1, unit.MaximumAtb));
+                    WriteName(bw, unit);
+                    bw.Write(d.trance);
+                    count++;
+                }
+                Int64 endPos = ms.Position;
+                ms.Position = countPos;
+                bw.Write((Byte)count);
+                ms.Position = endPos;
+                return ms.ToArray();
+            }
+        }
+
+        // The bench HOST takes one type-2 frame (what the socket would carry to a real host) and answers it per `mode`.
+        private static void BenchTake(Byte[] frame, String source)
+        {
+            NetCommand c;
+            String hex = BitConverter.ToString(frame ?? new Byte[0]).Replace('-', ' ');
+            if (!TryDecodeCommand(frame, out c))
+            {
+                _feedBad++;
+                _feedLast = source + " [" + hex + "] malformed";
+                Log.Message("[NetSync] bench feed: the bench host could not decode a " + source + " frame [" + hex + "]");
+                return;
+            }
+            _feedTaken++;
+            String verdict;
+            if (_feedRefuse)
+            {
+                _feedRefusedN++;
+                verdict = "REFUSED (mode refuse) -- its Ready bit stays up";
+            }
+            else if (c.Slot >= 0 && c.Slot < 4 && (_feedReady & (1 << c.Slot)) != 0)
+            {
+                _feedAcceptedN++;
+                _feedReady &= ~(1 << c.Slot);
+                _feedForce = true;
+                verdict = "ACCEPTED -- wire slot " + c.Slot + "'s Ready bit falls";
+            }
+            else
+            {
+                verdict = "dropped -- wire slot " + c.Slot + " was not Ready (a real host's \"not awaiting input\")";
+            }
+            _feedLast = source + " [" + hex + "] slot " + c.Slot + " " + ActionName(c.Action) + " menu " + c.Menu + " id " + c.Id
+                        + " mask 0x" + c.Mask.ToString("X2") + " cursor " + c.Cursor + ": " + verdict;
+            Log.Message("[NetSync] bench feed: the bench host took a " + _feedLast);
+        }
+
+        private static void StartFeed(Int32 guestSlots)
+        {
+            Boolean restart = _feedArmed;
+            _feedArmed = true;
+            _feedGuestSlots = guestSlots & 0x0F;
+            _feedReady = 0;
+            _feedCaps = CapCommandPhaseGated;
+            _feedRefuse = false;
+            _feedFrozen = false;
+            _feedUnmap = -1;
+            _feedNonce++;
+            _feedForce = true;
+            _feedFrames = _feedTaken = _feedAcceptedN = _feedRefusedN = _feedBad = 0;
+            _feedLast = null;
+            Log.Message("[NetSync] harness: bench feed " + (restart ? "RESTARTED" : "STARTED") + " -- a type-1 frame every " + SampleMs
+                        + " ms from the diorama's live units through the REAL ParseView (guest slots 0x" + _feedGuestSlots.ToString("X")
+                        + ", Ready 0x0, caps 0x" + _feedCaps.ToString("X2") + ", nonce " + _feedNonce + ", mode accept); it stands in for "
+                        + "the host's lane and Pump's guest branch (selftest only)");
+        }
+
+        // Never throws. Clears the production peer view only if this feed wrote it (selftest only: no transport lane exists).
+        private static void StopFeed(String why)
+        {
+            try
+            {
+                if (!_feedArmed)
+                    return;
+                _feedArmed = false;
+                _feedFrozen = false;
+                _feedUnmap = -1;
+                if (_feedPublished)
+                {
+                    _feedPublished = false;
+                    _peerView = null;
+                    PeerBattleLive = false;
+                    AssistInputActive = false;
+                    _assistSlot = -1;
+                    _assistRoster = null;
+                    ResetUi();
+                }
+                Log.Message("[NetSync] harness: bench feed stopped (" + why + ") -- the bench lane is gone (frames " + _feedFrames
+                            + ", taken " + _feedTaken + ", accepted " + _feedAcceptedN + ", refused " + _feedRefusedN + ")");
+            }
+            catch { }
+        }
+
+        private static Boolean ParseBenchInt(String a, Int32 max, out Int32 v)
+        {
+            v = -1;
+            if (String.IsNullOrEmpty(a))
+                return false;
+            Boolean ok = a.StartsWith("0x")
+                ? Int32.TryParse(a.Substring(2), System.Globalization.NumberStyles.HexNumber, null, out v)
+                : Int32.TryParse(a, out v);
+            return ok && v >= 0 && v <= max;
+        }
+
+        // `netsync bbench start|stop|ready|caps|mode|freeze|unmap|knob` (HarnessStockBench routes here; selftest role checked there).
+        private static Boolean BenchFeedVerb(String op, String[] args, out String why)
+        {
+            why = null;
+            String a = args.Length > 0 ? args[0].Trim().ToLowerInvariant() : "";
+            Int32 v;
+            switch (op)
+            {
+                case "start":
+                    if (!ParseBenchInt(a, 0x0F, out v) || v == 0)
+                    {
+                        why = "netsync bbench start: needs the host's guest-slot offer, a WIRE slot mask 1-15 (decimal or 0x hex)";
+                        return false;
+                    }
+                    if (!NetSyncDiorama.Active)
+                    {
+                        why = "netsync bbench start: needs a live diorama (netsync dioboot <scene>)";
+                        return false;
+                    }
+                    StartFeed(v);
+                    return true;
+                case "stop":
+                    if (!_feedArmed)
+                        Log.Message("[NetSync] harness: bench feed was not running");
+                    StopFeed("harness `bbench stop`");
+                    return true;
+                case "knob":
+                    if (a == "ini")
+                        BenchKnob = -1;
+                    else if (a == "1" || a == "on")
+                        BenchKnob = 1;
+                    else if (a == "0" || a == "off")
+                        BenchKnob = 0;
+                    else
+                    {
+                        why = "netsync bbench knob: 0|1|ini (force GuestStockMenu off/on for this process, or back to the ini's value)";
