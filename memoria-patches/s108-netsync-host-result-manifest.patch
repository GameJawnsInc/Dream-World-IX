+        // Slots(abil, index, max, abil, index, max, ...) -> the occurrence list, in that order.
+        private static List<LearnSlot> Slots(params Int32[] t)
+        {
+            List<LearnSlot> l = new List<LearnSlot>();
+            for (Int32 i = 0; i + 2 < t.Length; i += 3)
+                l.Add(new LearnSlot { AbilId = t[i], Index = t[i + 1], MaxAp = t[i + 2] });
+            return l;
+        }
