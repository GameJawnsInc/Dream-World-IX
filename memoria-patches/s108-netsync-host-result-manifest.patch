+
+    // ==================================================================== [ff9mapkit netsync B5] stage 9 -- the host taps
+    /// <summary>InitialNormal's tail (after InitialInfo's support-ability triggers, before any UpdateExp/AddAp write): build
+    /// and store the host's result manifest. Host-only; never throws.</summary>
+    private void NetHostCaptureManifest()
+    {
+        try
+        {
+            if (!Memoria.Netsync.NetSyncEnd.HostTapWanted)
+            {
+                Memoria.Netsync.NetSyncEnd.HostSkipManifest("no own battle is being streamed (the type-1 lane is down)");
+                return;
+            }
+            Memoria.Netsync.NetSyncEnd.Manifest m = null;
+            String why = null;
+            try
+            {
+                m = this.NetBuildManifest();
+            }
+            catch (Exception ex)
+            {
+                m = null;
+                why = "the build faulted: " + ex.GetType().Name + ": " + ex.Message;
+            }
+            Memoria.Netsync.NetSyncEnd.HostStoreManifest(m, why);
+        }
+        catch (Exception)
+        {
+            // swallow -- the netsync fail-safe law: the host's own result screen runs on untouched
+        }
+    }
+
+    /// <summary>UpdateItem, when an item did not fit: the sticky overflow bit. Host-only; never throws.</summary>
+    private void NetHostNoteOverflow()
+    {
+        try
+        {
+            Memoria.Netsync.NetSyncEnd.HostNoteItemOverflow();
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    /// <summary>ApLearned: the learn as the stock screen fired it -- the row, the ability, the row's cumulative AP (its
+    /// apValue.current, already advanced by AddAp). Host-only; never throws.</summary>
+    private void NetHostNoteLearned(Int32 id, Int32 abilId)
+    {
+        try
+        {
+            if (!Memoria.Netsync.NetSyncEnd.HostTapWanted)
+                return;
+            BattleEndValue v = id >= 0 && id < this.apValue.Length ? this.apValue[id] : null;
+            Memoria.Netsync.NetSyncEnd.HostNoteLearned(id, abilId, v != null ? v.current : 0u);
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    // The manifest, read off the screen's model (InitialNormal has just filled it) and the party. Reads only: pa[] is
+    // CLONED inside LearnSchedule, no PLAYER field is written. A throw lands in NetHostCaptureManifest's catch.
+    private Memoria.Netsync.NetSyncEnd.Manifest NetBuildManifest()
+    {
+        Memoria.Netsync.NetSyncEnd.Manifest m = new Memoria.Netsync.NetSyncEnd.Manifest();
+        PLAYER[] party = FF9StateSystem.Common.FF9.party.member;
+        Func<Int32, UInt32> threshold = lv => ff9level.CharacterLevelUps[lv].ExperienceToLevel;
+        for (Int32 i = 0; i < Memoria.Netsync.NetSyncEnd.ManifestMaxRows && i < party.Length; i++)
+        {
+            PLAYER player = party[i];
+            if (player == null)
+                continue;
+            Memoria.Netsync.NetSyncEnd.ManifestRow r = new Memoria.Netsync.NetSyncEnd.ManifestRow();
+            Int32 cid = (Int32)player.info.slot_no;
+            r.CharId = cid >= 0 && cid < 0xFF ? (Byte)cid : (Byte)0xFF;
+            Boolean needExp = this.isNeedExp[i];
+            Boolean needAp = this.isNeedAp[i];
+            r.RowFlags = (Byte)((needExp ? Memoria.Netsync.NetSyncEnd.RowNeedExp : 0)
+                              | (needAp ? Memoria.Netsync.NetSyncEnd.RowNeedAp : 0)
+                              | (this.IsEnableDraw(player, i) ? Memoria.Netsync.NetSyncEnd.RowDraw : 0));
+            r.LevelBefore = player.level;
+            r.ExpBefore = player.exp;
+            r.ExpGain = needExp && this.expValue[i] != null ? this.expValue[i].value : 0u;
+            r.LevelAfter = Memoria.Netsync.NetSyncEnd.LevelAfter(player.level, player.exp, r.ExpGain, ff9level.LEVEL_COUNT, threshold);
+            UInt32 apGain = needAp && this.apValue[i] != null ? this.apValue[i].value : 0u;
+            r.ApGain = (UInt16)Math.Min(apGain, (UInt32)UInt16.MaxValue);
+            r.Status = (UInt64)player.status;
+            if (apGain > 0u && ff9abil.FF9Abil_HasAp(player))   // AddAp's own early return
+            {
+                Boolean capped;
+                List<Memoria.Netsync.NetSyncEnd.ManifestLearn> learns =
+                    Memoria.Netsync.NetSyncEnd.LearnSchedule(player.pa, NetLearnSlots(player), apGain, out capped);
+                m.Truncated += Memoria.Netsync.NetSyncEnd.CapLearns(learns, r.Learns);
+                m.LearnCapped |= capped;
+            }
+            m.Rows[i] = r;
+        }
+        m.DefaultExp = this.defaultExp;
+        m.DefaultAp = (UInt16)Math.Min(this.defaultAp, (UInt32)UInt16.MaxValue);
+        m.GilGain = this.gilValue.value;
+        m.GilBefore = FF9StateSystem.Common.FF9.party.gil;
+        for (Int32 i = 0; i < this.itemList.Count; i++)
+        {
+            FF9ITEM it = this.itemList[i];
+            if (it == null)
+                continue;
+            if (m.Items.Count >= Memoria.Netsync.NetSyncEnd.ManifestMaxItems)
+            {
+                m.Truncated++;
+                continue;
+            }
+            Memoria.Netsync.NetSyncEnd.ManifestItem mi;
+            mi.Id = (Int32)it.id;
+            mi.Count = it.count;
+            m.Items.Add(mi);
+        }
+        m.Card = (Int32)this.defaultCard;
+        return m;
+    }
+
+    // AddAp's own walk (BattleResultUI.cs AddAp), read-only: every equipped item's every teachable ability, IN THAT LOOP'S
+    // ORDER -- load-bearing: an ability two equipped items teach advances twice per AP step, as stock does.
+    private static List<Memoria.Netsync.NetSyncEnd.LearnSlot> NetLearnSlots(PLAYER player)
+    {
+        List<Memoria.Netsync.NetSyncEnd.LearnSlot> slots = new List<Memoria.Netsync.NetSyncEnd.LearnSlot>();
+        for (Int32 i = 0; i < 5; i++)
+        {
+            if (player.equip[i] == RegularItem.NoItem)
+                continue;
+            FF9ITEM_DATA itemData = ff9item._FF9Item_Data[player.equip[i]];
+            foreach (Int32 abil in itemData.ability)
+            {
+                if (abil == 0)
+                    continue;
+                Int32 abilIndex = ff9abil.FF9Abil_GetIndex(player, abil);
+                if (abilIndex < 0)
+                    continue;
+                Memoria.Netsync.NetSyncEnd.LearnSlot s;
+                s.AbilId = abil;
+                s.Index = abilIndex;
+                s.MaxAp = ff9abil._FF9Abil_PaData[player.PresetId][abilIndex].Ap;
+                slots.Add(s);
+            }
+        }
+        return slots;
+    }
+
+    // ==================================================================== [ff9mapkit netsync B5] stage 9 -- NetDescribe
+    // Harness `battle.result_ui`: what the screen SHOWS (the labels as drawn) and the model behind it, so a bench can hold the
+    // host's manifest against its own live screen. Read-only: no Display*/Update*, nothing written. Each read is guarded.
+    public sealed class NetResultRow
+    {
+        public Int32 Slot;              // RAW party slot
+        public Boolean Shown;           // the row's Content is active
+        public String Name, Level, Exp, Next;   // the labels as drawn (raw NGUI text)
+        public Boolean Dim;             // the row's DimSprite is active (IsEnableDraw false)
+        public Int32 LevelUps;          // totalLevelUp[slot] (level-ups this screen has played)
+        public Int64 ExpValue = -1, ExpCurrent = -1, ApValue = -1, ApCurrent = -1;
+        public Boolean NeedExp, NeedAp;
+    }
+
+    public sealed class NetResultItem
+    {
+        public Int32 Id;                // the model: itemList[i].id
+        public Int32 Count;             // itemList[i].count
+        public Boolean Shown;           // its itemHudList slot is active
+        public String Name, Number;     // that slot's labels as drawn
+    }
+
+    public sealed class NetResultView
+    {
+        public String ExpLabel, ApLabel, GilReceiveLabel, GilCurrentLabel, CardLabel;   // as drawn (null = not readable)
+        public Boolean CardShown;
+        public Int64 DefaultExp = -1, DefaultAp = -1, DefaultGil = -1, GilValue = -1, GilCurrent = -1, PartyGil = -1;
+        public Int32 Card = -1;
+        public readonly List<NetResultRow> Rows = new List<NetResultRow>(4);
+        public readonly List<NetResultItem> Items = new List<NetResultItem>(6);
+    }
+
+    public NetResultView NetDescribe()
+    {
+        NetResultView v = new NetResultView();
+        try { v.ExpLabel = this.expReceiveLabel != null ? this.expReceiveLabel.rawText : null; } catch (Exception) { }
+        try { v.ApLabel = this.apReceiveLabel != null ? this.apReceiveLabel.rawText : null; } catch (Exception) { }
+        try { v.GilReceiveLabel = this.receiveGilLabel != null ? this.receiveGilLabel.rawText : null; } catch (Exception) { }
+        try { v.GilCurrentLabel = this.currentGilLabel != null ? this.currentGilLabel.rawText : null; } catch (Exception) { }
+        try
+        {
+            v.CardShown = this.cardHud != null && this.cardHud.Self != null && this.cardHud.Self.activeSelf;
+            v.CardLabel = v.CardShown && this.cardHud.NameLabel != null ? this.cardHud.NameLabel.rawText : null;
+        }
+        catch (Exception) { }
+        try { v.DefaultExp = this.defaultExp; } catch (Exception) { }
+        try { v.DefaultAp = this.defaultAp; } catch (Exception) { }
+        try { v.DefaultGil = this.defaultGil; } catch (Exception) { }
+        try { v.GilValue = this.gilValue.value; v.GilCurrent = this.gilValue.current; } catch (Exception) { }
+        try { v.PartyGil = FF9StateSystem.Common.FF9.party.gil; } catch (Exception) { }
+        try { v.Card = (Int32)this.defaultCard; } catch (Exception) { }
+        for (Int32 i = 0; i < 4; i++)
+        {
+            try
+            {
+                if (i >= this.characterBRInfoHudList.Count)
+                    break;
+                CharacterBattleResultInfoHUD hud = this.characterBRInfoHudList[i];
+                NetResultRow r = new NetResultRow();
+                r.Slot = i;
+                r.Shown = hud.Content != null && hud.Content.activeSelf;
+                r.Name = hud.NameLabel != null ? hud.NameLabel.rawText : null;
+                r.Level = hud.LevelLabel != null ? hud.LevelLabel.rawText : null;
+                r.Exp = hud.ExpLabel != null ? hud.ExpLabel.rawText : null;
+                r.Next = hud.NextLvLabel != null ? hud.NextLvLabel.rawText : null;
+                r.Dim = hud.DimSprite != null && hud.DimSprite.gameObject.activeSelf;
+                r.LevelUps = this.totalLevelUp != null && i < this.totalLevelUp.Length ? this.totalLevelUp[i] : 0;
+                if (this.expValue[i] != null)
+                {
+                    r.ExpValue = this.expValue[i].value;
+                    r.ExpCurrent = this.expValue[i].current;
+                }
+                if (this.apValue[i] != null)
+                {
+                    r.ApValue = this.apValue[i].value;
+                    r.ApCurrent = this.apValue[i].current;
+                }
+                r.NeedExp = this.isNeedExp[i];
+                r.NeedAp = this.isNeedAp[i];
+                v.Rows.Add(r);
+            }
+            catch (Exception) { }
+        }
+        try
+        {
+            for (Int32 i = 0; i < this.itemList.Count; i++)
+            {
+                FF9ITEM it = this.itemList[i];
+                NetResultItem ri = new NetResultItem();
+                ri.Id = it != null ? (Int32)it.id : -1;
+                ri.Count = it != null ? it.count : 0;
+                if (i < this.itemHudList.Count)
+                {
+                    Assets.Sources.Scripts.UI.Common.ItemListDetailWithIconHUD h = this.itemHudList[i];
+                    ri.Shown = h.Self != null && h.Self.activeSelf;
+                    ri.Name = h.NameLabel != null ? h.NameLabel.rawText : null;
+                    ri.Number = h.NumberLabel != null ? h.NumberLabel.rawText : null;
+                }
+                v.Items.Add(ri);
+            }
+        }
+        catch (Exception) { }
+        return v;
+    }
 }
