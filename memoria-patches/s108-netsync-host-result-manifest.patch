+        private static EndBlock ManifestCase(List<String> fails, ref Int32 n, String what, Byte[] payload, Int32 wantUnits, EndBlock wantBlock,
+                                             Int32 wantLen, Manifest wantM, Boolean wantBad)
+        {
+            n++;
+            Int32 units;
+            Boolean viewOk;
+            UInt16 seq;
+            Byte nonce;
+            EndBlock got = NetSyncBattle.ParseEndThroughView(payload, out units, out viewOk, out seq, out nonce);
+            if (!viewOk || units != wantUnits)
+                fails.Add("manifest " + what + ": the view/units did not stand (" + units + "/" + wantUnits + ")");
+            else if (got == null || !got.SameAs(wantBlock) || got.ManifestLen != wantLen)
+                fails.Add("manifest " + what + ": the END BLOCK did not stand (" + (got != null ? got + " len " + got.ManifestLen : "null") + ")");
+            else if (wantBad && (got.Manifest != null || got.ManifestWhy == null))
+                fails.Add("manifest " + what + ": a malformed manifest was accepted");
+            else if (!wantBad && (got.Manifest == null || !got.Manifest.SameAs(wantM) || got.ManifestWhy != null))
+                fails.Add("manifest " + what + ": " + (got.Manifest != null ? got.Manifest.ToString() : "no manifest (" + got.ManifestWhy + ")") + " != " + wantM);
+            return got;
+        }
