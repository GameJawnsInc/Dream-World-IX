+    private void NetResetReplay()
+    {
+        this._netInert = false;
+        this._netAborted = false;
+        this._netHidden = false;
+        this._netFaulted = false;
+        this._netManifest = null;
+        for (Int32 i = 0; i < 4; i++)
+        {
+            this._netRows[i] = null;
+            this._netLevel[i] = 0;
+            this._netExp[i] = 0u;
+        }
+        this._netGil = 0u;
+        this._netHostOverflow = false;
+        this._netHostState = -1;
+        this._netHostLoading = false;
+        this._netFollow = -1;
+        this._netLastStepState = -1;
+        this._netLastStepTick = Environment.TickCount;
+        this._netSteps = 0;
+        this._netLocalConfirms = 0;
+        this._netLocalSteps = 0;
+        this._netOverflowShown = false;
+        this._netTrail.Clear();
+        this._netLearned.Clear();
+        this._netFpOpen = 0UL;
+        this._netFpLast = 0UL;
+        this._netWrites = 0;
+        this._netAbortEnforced = false;
+    }
+
+    // A fault in the open or the chase: the replay stops stepping (inert from here: nothing written either way), the diorama
+    // stops waiting for its Hide, and the guest leaves with the host. Logged once.
+    private void NetFault(String why)
+    {
+        if (this._netFaulted)
+            return;
+        this._netFaulted = true;
+        this._netAborted = true;
+        try
+        {
+            FF9Sfx.FF9SFX_StopLoop(105);
+            FF9Sfx.FF9SFX_StopLoop(109);
+            this.currentState = BattleResultUI.ResultState.Hide;
+            Memoria.Netsync.NetSyncDiorama.NoteReplayAborted("the replay faulted (" + why + ")");
+            Log.Error("[NetSync] result replay FAULTED -- " + why + "; it holds inert (writes nothing) and the guest leaves with the host");
+        }
+        catch (Exception) { }
+    }
+
+    // Seam b (the Hide's after-hide tail; `wasReplay` read when Hide was CALLED): the stock tail minus prevMode and Replace --
+    // the diorama's own Leave returns the guest. A replay a leave already aborted leaves the song shutdown and the fade lift
+    // to the stage-6 settle (each runs once per return). True = handled (the stock tail must not run).
+    private Boolean NetReplayHidden(Boolean wasReplay)
+    {
+        if (!wasReplay)
+            return false;
+        try
+        {
+            Boolean ownTail = !this._netAborted;
+            Boolean songShut = false;
+            String songWhy = null;
+            if (ownTail)
+            {
+                SceneDirector.FF9Wipe_FadeInEx(256);
+                // [fixer S10-R1] the song half under the settle's rule (the host's end-block b4 first): the stock
+                // ff9ShutdownStateBattleResult alone reads only this diorama's btl_flag and would cut a field song the host keeps
+                songShut = Memoria.Netsync.NetSyncDiorama.ReplayHideTailSong(out songWhy);
+                Memoria.Netsync.NetSyncDiorama.NoteReplayHideTail();   // the stage-6 settle now skips its song shutdown and fade lift
+            }
+            this.ItemListPanel.SetActive(false);
+            if (this.isTimerDisplay && TimerUI.Enable)
+                TimerUI.SetDisplay(true);
+            this._netHidden = true;
+            this.NetCheckWrites("the hide");
+            Log.Message("[NetSync] result replay: CLOSED (" + (ownTail ? "its own hide tail: FadeInEx(256) + " + (songShut ? "the song shutdown" : "the song KEPT -- " + songWhy)
+                                                                         + "; the diorama's Leave returns the guest"
+                                                                      : "after an abort: the stage-6 settle owns the song and the fade")
+                        + ") -- steps " + this._netSteps + ", trail [" + String.Join(" ", this._netTrail.ToArray()) + "], local confirms swallowed "
+                        + this._netLocalConfirms + ", writes " + this._netWrites);
+        }
+        catch (Exception) { }
+        return true;
+    }
+
+    // Seam c: the guest's own Confirm on a replay. True = swallow it (the default: the host steps the screen). The `endbench
+    // replay local` lever lets it through (seam c's red; every writer stays closed). Counted; logged once per replay.
+    private Boolean NetSwallowLocalConfirm()
+    {
+        if (!this._netReplay)
+            return false;
+        try
+        {
+            if (!this._netAborted && Memoria.Netsync.NetSyncEnd.ReplayMode == Memoria.Netsync.NetSyncEnd.ReplayModeLocal)
+            {
+                this._netLocalSteps++;
+                if (this._netLocalSteps == 1)
+                    Log.Message("[NetSync] result replay: CALIBRATION (`endbench replay local`) -- the guest's own Confirm steps the replay");
+                return false;
+            }
+            this._netLocalConfirms++;
+            if (this._netLocalConfirms == 1)
+                Log.Message("[NetSync] result replay: the guest's own Confirm is inert on the host's reward screen (the host steps it; "
+                            + "logged once per replay, local_confirms counts)");
+        }
+        catch (Exception) { }
+        return true;
+    }
+
+    // Seam d (InitialInfo's head): the model from the HOST's manifest -- the valid rows' needExp/needAp, their exp/AP gains
+    // at the stock tick pace (ExpTickStep; AP steps 1), default exp/AP/gil/card and the items -- instead of the guest's
+    // bonus, support abilities and bag. True = handled.
+    private Boolean NetFillReplay()
+    {
+        if (!this._netReplay)
+            return false;
+        Memoria.Netsync.NetSyncEnd.Manifest m = this._netManifest;
+        this.itemList.Clear();
+        this.remainPlayerCounter = 0;
+        if (m == null)
+            return true;
+        for (Int32 i = 0; i < 4; i++)
+        {
+            Memoria.Netsync.NetSyncEnd.ManifestRow r = this._netRows[i];
+            this.isNeedExp[i] = r != null && r.NeedExp;
+            this.isNeedAp[i] = r != null && r.NeedAp;
+            if (this.isNeedExp[i])
+            {
+                this.remainPlayerCounter++;
+                BattleEndValue e = new BattleEndValue();
+                e.value = r.ExpGain;
+                e.step = BattleResultUI.ExpTickStep(e.value);
+                e.current = 0u;
+                this.expValue[i] = e;
+            }
+            if (this.isNeedAp[i])
+            {
+                BattleEndValue a = new BattleEndValue();
+                a.value = r.ApGain;
+                a.step = 1u;
+                a.current = 0u;
+                this.apValue[i] = a;
+            }
+        }
+        this.defaultExp = m.DefaultExp;
+        this.defaultAp = m.DefaultAp;
+        this.defaultGil = (Int32)Math.Min(m.GilGain, (UInt32)Int32.MaxValue);
+        this.defaultCard = (TetraMasterCardId)m.Card;
+        for (Int32 k = 0; k < m.Items.Count && this.itemList.Count < BattleResultUI.ItemMax; k++)
+        {
+            RegularItem id = (RegularItem)m.Items[k].Id;
+            if (m.Items[k].Count == 0)
+                continue;
+            if (!ff9item._FF9Item_Data.ContainsKey(id))   // an id this install's item table lacks would throw in DisplayItem
+            {
+                Log.Message("[NetSync] result replay: the host's item " + m.Items[k].Id + " x" + m.Items[k].Count
+                            + " is not in this install's item table -- not drawn");
+                continue;
+            }
+            this.itemList.Add(new FF9ITEM(id, m.Items[k].Count));
+        }
+        this.gilValue.value = m.GilGain;
+        this.gilValue.step = BattleResultUI.GilTickStep(this.gilValue.value);
+        this.gilValue.current = 0u;
+        return true;
+    }
+
+    // Seam e: the stock row loop on the shadows -- only rows the manifest validated (a seated member whose slot_no is the
+    // row's charId); level / exp / next from the shadow, the statuses from the host's row, the dim from its draw flag.
+    private Boolean NetDisplayCharacterInfo()
+    {
+        if (!this._netReplay)
+            return false;
+        for (Int32 i = 0; i < 4 && i < this.characterBRInfoHudList.Count; i++)
+        {
+            PLAYER player = FF9StateSystem.Common.FF9.party.member[i];
+            Memoria.Netsync.NetSyncEnd.ManifestRow r = this._netRows[i];
+            if (player == null || r == null)
+                continue;
+            Int32 level = this._netLevel[i];
+            UInt64 exp = this._netExp[i];
+            UInt64 nextLvl = level >= ff9level.LEVEL_COUNT ? exp : ff9level.CharacterLevelUps[level].ExperienceToLevel;
+            BattleResultUI.CharacterBattleResultInfoHUD infoHUD = this.characterBRInfoHudList[i];
+            infoHUD.Content.SetActive(true);
+            infoHUD.NameLabel.SetText(player.NameTag);
+            infoHUD.LevelLabel.rawText = level.ToString();
+            infoHUD.ExpLabel.rawText = exp.ToString();
+            infoHUD.NextLvLabel.rawText = (nextLvl > exp ? nextLvl - exp : 0UL).ToString();
+            FF9UIDataTool.DisplayCharacterAvatar(player, new Vector3(0f, 0f, 0f), new Vector3(0f, 0f, 0f), infoHUD.AvatarSprite, false);
+            foreach (UISprite statusSprite in infoHUD.StatusesSpriteList)
+                statusSprite.alpha = 0f;
+            Int32 spriteSlot = 0;
+            foreach (BattleStatusId statusId in ((BattleStatus)r.Status).ToStatusList())
+            {
+                if (spriteSlot >= infoHUD.StatusesSpriteList.Length)
+                    break;
+                if (!BattleHUD.DebuffIconNames.TryGetValue(statusId, out String spriteName))
+                    continue;
+                infoHUD.StatusesSpriteList[spriteSlot].alpha = 1f;
+                infoHUD.StatusesSpriteList[spriteSlot].spriteName = spriteName;
+                spriteSlot++;
+            }
+            if (!this.IsEnableDraw(player, i))
+            {
+                this.isRecieveExpList.Add(false);
+                infoHUD.DimSprite.gameObject.SetActive(true);
+                infoHUD.AvatarSprite.alpha = 0.5f;
+            }
+            else
+            {
+                this.isRecieveExpList.Add(true);
+                infoHUD.DimSprite.gameObject.SetActive(false);
+                infoHUD.AvatarSprite.alpha = 1f;
+            }
+        }
+        return true;
+    }
+
+    // Seam f: the host's draw flag for a valid row (no row = dim).
+    private Boolean NetRowDraw(Int32 id)
+    {
+        return id >= 0 && id < 4 && this._netRows[id] != null && this._netRows[id].Draw;
+    }
+
+    // Seam g: one LEVEL UP on the shadow -- the stock counter and animation, never FF9Play_GrowLevel.
+    private Boolean NetDisplayLevelup(Int32 index)
+    {
+        if (!this._netReplay)
+            return false;
+        if (index < 0 || index >= 4)
+            return true;
+        this._netLevel[index]++;
+        this.totalLevelUp[index]++;
+        this.ShowLevelUpAnimation(index);
+        return true;
+    }
+
+    // Seam h: UpdateExp's tick on the shadow exp (the stock gain, cap and end-of-tick tests), the shadow level following it
+    // through the guest's table but CAPPED at the host's levelAfter (NetSyncEnd.ReplayLevel) and FORCED to it once the row's
+    // exp is all in -- the final level is the host's even when the installs' tables differ.
+    private Boolean NetUpdateExp()
+    {
+        if (!this._netReplay)
+            return false;
+        this.expEndTick = true;
+        Func<Int32, UInt32> threshold = lv => ff9level.CharacterLevelUps[lv].ExperienceToLevel;
+        for (Int32 i = 0; i < 4; i++)
+        {
+            Memoria.Netsync.NetSyncEnd.ManifestRow r = this._netRows[i];
+            BattleEndValue v = this.expValue[i];
+            if (!this.isNeedExp[i] || r == null || v == null)
+                continue;
+            UInt32 tickGain = (v.current + v.step > v.value) ? (v.value - v.current) : v.step;
+            if (v.current < v.value)
+            {
+                this.expEndTick = false;
+                if (tickGain != 0u && Memoria.Netsync.NetSyncEnd.ExpCap > this._netExp[i])
+                {
+                    v.current += tickGain;
+                    UInt64 exp = (UInt64)this._netExp[i] + tickGain;
+                    this._netExp[i] = exp >= Memoria.Netsync.NetSyncEnd.ExpCap ? Memoria.Netsync.NetSyncEnd.ExpCap : (UInt32)exp;
+                    Int32 target = Memoria.Netsync.NetSyncEnd.ReplayLevel(this._netLevel[i], this._netExp[i], r.LevelAfter, ff9level.LEVEL_COUNT, threshold);
+                    while (this._netLevel[i] < target)
+                        this.DisplayLevelup(i);
+                }
+            }
+            if (v.current >= v.value)
+                while (this._netLevel[i] < r.LevelAfter && this._netLevel[i] < Byte.MaxValue)
+                    this.DisplayLevelup(i);
+        }
+        return true;
+    }
+
+    // Seam i: AddAp on a replay -- apValue.current advances; every scheduled learn whose apAt falls in (old, new] fires
+    // through the stock ApLearned (the popup, the sound); pa[] is never touched.
+    private Boolean NetAddAp(Int32 id, UInt32 ap)
+    {
+        if (!this._netReplay)
+            return false;
+        Memoria.Netsync.NetSyncEnd.ManifestRow r = id >= 0 && id < 4 ? this._netRows[id] : null;
+        BattleEndValue v = id >= 0 && id < this.apValue.Length ? this.apValue[id] : null;
+        if (ap == 0u || r == null || v == null)
+            return true;
+        UInt32 old = v.current;
+        v.current += ap;
+        List<Int32> due = this._netDue;          // [fixer S10-REG-2] reused: AddAp runs per row per frame through the AP tick
+        due.Clear();
+        Memoria.Netsync.NetSyncEnd.LearnsDue(r, old, v.current, due);
+        for (Int32 k = 0; k < due.Count; k++)
+            this.ApLearned(id, due[k]);
+        return true;
+    }
+
+    // Seam j: ApLearned on a replay records the learn (`replay.screen.learned`) and skips the ability achievement. True =
+    // a replay (the caller skips BattleAchievement.UpdateAbilitiesAchievement).
+    private Boolean NetReplayLearned(Int32 id, Int32 abilId)
+    {
+        if (!this._netReplay)
+            return false;
+        try
+        {
+            if (this._netLearned.Count < 32)
+            {
+                BattleEndValue v = id >= 0 && id < this.apValue.Length ? this.apValue[id] : null;
+                this._netLearned.Add(new Int32[] { id, abilId, v != null ? (Int32)Math.Min(v.current, (UInt32)Int32.MaxValue) : -1 });
+            }
+        }
+        catch (Exception) { }
+        return true;
+    }
+
+    // Seam k: party.gil as the result screen reads and writes it -- the shadow on a replay.
+    private UInt32 NetPartyGil
+    {
+        get { return this._netReplay ? this._netGil : FF9StateSystem.Common.FF9.party.gil; }
+        set
+        {
+            if (this._netReplay)
+                this._netGil = value;
+            else
+                FF9StateSystem.Common.FF9.party.gil = value;
+        }
+    }
+
+    // Seam l: UpdateItem on a replay -- nothing added to the bag, no card collected. The HOST's overflow (its sticky end-block
+    // b2, or its screen on the ItemFullDialog) answers, with the stock sounds; true = everything fit.
+    private Boolean NetUpdateItem()
+    {
+        Int32 host;
+        Boolean hostLoading;
+        Byte flags;
+        if (Memoria.Netsync.NetSyncDiorama.ReplayHostState(out host, out hostLoading, out flags))
+        {
+            this._netHostState = host;
+            if ((flags & Memoria.Netsync.NetSyncEnd.FlagItemOverflow) != 0)
+                this._netHostOverflow = true;
+        }
+        Boolean overflow = this._netHostOverflow || Memoria.Netsync.NetSyncEnd.ReplayOverflow(flags, this._netHostState);
+        if (overflow)
+        {
+            FF9Sfx.FF9SFX_Play(1046);
+            if (this.itemList.Count != 0 || this.defaultCard != TetraMasterCardId.NONE)
+                FF9Sfx.FF9SFX_Play(108);
+            this._netOverflowShown = true;
+        }
+        Log.Message("[NetSync] result replay: items -- the host " + (overflow ? "OVERFLOWED (the ItemFullDialog opens)" : "fit everything")
+                    + "; nothing added to the guest's bag, no card collected");
+        return !overflow;
+    }
+
+    // Seam m: THE CHASE DRIVER (design 5.6 NetFollow), every Update while the result screen is the UI state. Reads the host's
+    // result state (NetSyncDiorama.ReplayHostState: this diorama's end block, or Hide once the host's exit latched) and asks
+    // NetSyncEnd.FollowVerdict; on Step it calls StepConfirm -- the stock state machine, never OnKeyConfirm, so the guest's
+    // quit prompt is never answered. An aborted replay is held at Hide with its tick loops stopped.
+    private void NetFollow()
+    {
+        if (!this._netReplay)
+            return;
+        try
+        {
+            if (this._netAborted)
+            {
+                if (!this._netAbortEnforced || this.currentState != BattleResultUI.ResultState.Hide)
+                {
+                    this._netAbortEnforced = true;
+                    FF9Sfx.FF9SFX_StopLoop(105);
+                    FF9Sfx.FF9SFX_StopLoop(109);
+                    this.currentState = BattleResultUI.ResultState.Hide;   // a late TweenOut callback must not restart a tick
+                }
+                this._netFollow = Memoria.Netsync.NetSyncEnd.FollowAborted;
+                return;
+            }
+            Int32 host;
+            Boolean hostLoading;
+            Byte flags;
+            Boolean have = Memoria.Netsync.NetSyncDiorama.ReplayHostState(out host, out hostLoading, out flags);
+            if (have)
+            {
+                this._netHostState = host;
+                this._netHostLoading = hostLoading;
+                if ((flags & Memoria.Netsync.NetSyncEnd.FlagItemOverflow) != 0)
+                    this._netHostOverflow = true;
+            }
+            UIManager ui = PersistenSingleton<UIManager>.Instance;
+            Boolean screenUp = ui != null && ui.State == UIManager.UIState.BattleResult;
+            Boolean quitUp = ui == null || ui.QuitScene == null || ui.QuitScene.isShowQuitUI;
+            Int32 local = (Int32)this.currentState;
+            Int32 now = Environment.TickCount;
+            Int32 v = Memoria.Netsync.NetSyncEnd.FollowVerdict(false, screenUp, quitUp, this.Loading, local, have ? host : -1, hostLoading,
+                                                                this._netLastStepState, now - this._netLastStepTick);
+            this._netFollow = v;
+            if (v != Memoria.Netsync.NetSyncEnd.FollowStep)
+                return;
+            this._netLastStepState = local;
+            this._netLastStepTick = now;
+            this._netSteps++;
+            if (this._netTrail.Count < 24)
+                this._netTrail.Add(local + ">" + host + (hostLoading ? "L" : ""));
+            this.StepConfirm();
+            Log.Message("[NetSync] result replay: step " + this._netSteps + " -- local state " + local + " -> " + this.NetStateRaw
+                        + " (the host reads " + host + (hostLoading ? ", Loading" : "") + ")");
+            this.NetCheckWrites("step " + this._netSteps);
+        }
+        catch (Exception ex)
+        {
+            this.NetFault("the chase faulted: " + ex.GetType().Name + ": " + ex.Message);
+        }
+    }
+
+    /// <summary>NetSyncDiorama.AbortReplay (a Leave, the end-leave past its wait, the teardown): stop stepping, stop the tick
+    /// loops (105 EXP/AP, 109 gil), hold the screen at Hide. The song and the fade belong to the stage-6 settle now. Never
+    /// throws.</summary>
+    internal void NetAbortReplay(String why)
+    {
+        if (!this._netReplay || this._netAborted)
+            return;
+        this._netAborted = true;
+        try
+        {
+            FF9Sfx.FF9SFX_StopLoop(105);
+            FF9Sfx.FF9SFX_StopLoop(109);
+            this._netAbortEnforced = true;
+            if (this.currentState != BattleResultUI.ResultState.Hide)
+                this.currentState = BattleResultUI.ResultState.Hide;
+            this.NetCheckWrites("the abort");
+            Log.Message("[NetSync] result replay: ABORTED -- " + why + " (local state held at Hide, tick loops 105/109 stopped; steps "
+                        + this._netSteps + ", writes " + this._netWrites + ")");
+        }
+        catch (Exception) { }
+    }
+
+    // THE WRITE GUARD: re-take the fingerprint and compare it with the last one; a change while the replay runs is a reward
+    // write that escaped a seam -- counted, logged as an ERROR (with the components), never acted on.
+    private void NetCheckWrites(String at)
+    {
+        try
+        {
+            NetFp parts = new NetFp();
+            UInt64 fp = NetFingerprint(parts);
+            if (fp == this._netFpLast)
+                return;
+            this._netWrites++;
+            this._netFpLast = fp;
+            Log.Error("[NetSync] result replay: WRITE DETECTED at " + at + " -- the guest's save/party/bag fingerprint moved 0x"
+                      + this._netFpOpen.ToString("X16") + " -> 0x" + fp.ToString("X16") + " (" + parts + "); writes=" + this._netWrites);
+        }
+        catch (Exception) { }
+    }
+
+    /// <summary>The fingerprint's components (harness `netsync.battle.end.replay.fp`).</summary>
+    public sealed class NetFp
+    {
+        public UInt64 Hash;
+        public Int64 Gil = -1;
+        public Int32 Items, Cards = -1, Abilities = -1, Passive = -1, Players;
+        public Int64 ItemSum, LevelSum, ExpSum, PaSum;
+
+        public override String ToString()
+        {
+            return "gil " + Gil + ", items " + Items + " (sum " + ItemSum + "), players " + Players + " (levels " + LevelSum + ", exp " + ExpSum
+                   + ", pa " + PaSum + "), cards " + Cards + ", abilities " + Abilities + "/" + Passive;
+        }
+    }
+
+    /// <summary>
+    /// THE WRITE GUARD's instrument: FNV-1a 64 (NetSyncEnd.FpMix) over every value the stock result screen can write -- gil;
+    /// the bag (each slot with a count, in order); each seated member's slot, level, exp and pa[]; every character in the
+    /// player dictionary (sorted) the same way; the card collection's size; the ability achievement sets' sizes. Read-only;
+    /// `parts` (optional) receives the components. Never throws (a fault folds a sentinel in).
+    /// </summary>
+    public static UInt64 NetFingerprint(NetFp parts)
+    {
+        UInt64 h = Memoria.Netsync.NetSyncEnd.FpSeed;
+        NetFp p = parts ?? new NetFp();
+        try
+        {
+            FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+            p.Gil = ff9.party.gil;
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, ff9.party.gil);
+            foreach (FF9ITEM it in ff9.item)
+            {
+                if (it == null || it.count == 0)
+                    continue;
+                h = Memoria.Netsync.NetSyncEnd.FpMix(h, ((UInt64)(UInt32)(Int32)it.id << 8) | it.count);
+                p.Items++;
+                p.ItemSum += it.count;
+            }
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)p.Items);
+            for (Int32 i = 0; i < 4 && i < ff9.party.member.Length; i++)
+                h = NetFpPlayer(h, ff9.party.member[i], null);
+            List<CharacterId> ids = new List<CharacterId>(ff9.player.Keys);
+            ids.Sort();
+            foreach (CharacterId id in ids)
+            {
+                h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)(Int64)(Int32)id);
+                h = NetFpPlayer(h, ff9.player[id], p);
+            }
+        }
+        catch (Exception)
+        {
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, 0xDEADUL);
+        }
+        try
+        {
+            p.Cards = QuadMistDatabase.MiniGame_GetAllCardCount();
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)(Int64)p.Cards);
+        }
+        catch (Exception)
+        {
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, 0xC4DUL);
+        }
+        try
+        {
+            p.Abilities = FF9StateSystem.Achievement.abilities.Count;
+            p.Passive = FF9StateSystem.Achievement.passiveAbilities.Count;
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)(Int64)p.Abilities);
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)(Int64)p.Passive);
+        }
+        catch (Exception)
+        {
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, 0xAC4UL);
+        }
+        p.Hash = h;
+        return h;
+    }
+
+    private static UInt64 NetFpPlayer(UInt64 h, PLAYER pl, NetFp p)
+    {
+        if (pl == null)
+            return Memoria.Netsync.NetSyncEnd.FpMix(h, 0xFFFFUL);
+        h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)(Int64)(Int32)pl.info.slot_no);
+        h = Memoria.Netsync.NetSyncEnd.FpMix(h, pl.level);
+        h = Memoria.Netsync.NetSyncEnd.FpMix(h, pl.exp);
+        Int32 n = pl.pa != null ? pl.pa.Length : -1;
+        h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)(Int64)n);
+        Int64 paSum = 0;
+        for (Int32 k = 0; k < n; k++)
+        {
+            h = Memoria.Netsync.NetSyncEnd.FpMix(h, (UInt64)(Int64)pl.pa[k]);
+            paSum += pl.pa[k];
+        }
+        if (p != null)
+        {
+            p.Players++;
+            p.LevelSum += pl.level;
+            p.ExpSum += pl.exp;
+            p.PaSum += paSum;
+        }
+        return h;
+    }
+
+    /// <summary>The screen's replay receipts (harness `netsync.battle.end.replay.screen`). Read-only.</summary>
+    public sealed class NetReplayView
+    {
+        public Boolean Replay, Inert, Aborted, Hidden, Faulted, HostOverflow, OverflowShown, HostLoading;
+        public Int32 State = -1, HostState = -1, Follow = -1, Steps, LocalConfirms, LocalSteps, Writes, OpenMs = -1;
+        public Int64 Gil = -1;
+        public UInt64 FpOpen;
+        public readonly List<String> Trail = new List<String>(16);
+        public readonly List<Int32[]> Learned = new List<Int32[]>(8);
+        public readonly Int32[] Levels = { -1, -1, -1, -1 };
+        public readonly Int64[] Exps = { -1, -1, -1, -1 };
+        public readonly Int32[] Chars = { -1, -1, -1, -1 };      // the valid rows' charIds (-1 = not drawn)
+    }
+
+    public NetReplayView NetReplayDescribe()
+    {
+        NetReplayView v = new NetReplayView();
+        try
+        {
+            v.Replay = this._netReplay;
+            v.Inert = this._netInert;
+            v.Aborted = this._netAborted;
+            v.Hidden = this._netHidden;
+            v.Faulted = this._netFaulted;
+            v.HostOverflow = this._netHostOverflow;
+            v.OverflowShown = this._netOverflowShown;
+            v.HostLoading = this._netHostLoading;
+            v.State = this.NetStateRaw;
+            v.HostState = this._netHostState;
+            v.Follow = this._netFollow;
+            v.Steps = this._netSteps;
+            v.LocalConfirms = this._netLocalConfirms;
+            v.LocalSteps = this._netLocalSteps;
+            v.Writes = this._netWrites;
+            v.OpenMs = this._netReplay && !this._netInert ? Environment.TickCount - this._netOpenTick : -1;
+            v.Gil = this._netReplay ? this._netGil : -1;
+            v.FpOpen = this._netFpOpen;
+            v.Trail.AddRange(this._netTrail);
+            v.Learned.AddRange(this._netLearned);
+            for (Int32 i = 0; i < 4; i++)
+            {
+                if (this._netRows[i] == null)
+                    continue;
+                v.Levels[i] = this._netLevel[i];
+                v.Exps[i] = this._netExp[i];
+                v.Chars[i] = this._netRows[i].CharId;
+            }
+        }
+        catch (Exception) { }
         return v;
     }
 }
