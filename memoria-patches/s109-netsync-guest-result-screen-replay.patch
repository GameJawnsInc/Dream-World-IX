+    // Seam a (Show, after the timer read): inside the live diorama (Active) EVERY result screen is a write-nothing replay. Takes the
+    // arm (NetSyncDiorama.TakeReplayArm) and builds the pages from the host's manifest; no arm = an inert screen. False =
+    // not a diorama (the stock screen, untouched). Never throws into Show.
+    private Boolean NetBeginReplay()
+    {
+        // [fixer S10-R2] keyed on the POSITIVE containment predicate (Active: armed + booted + the live scene is BattleMapDebug),
+        // not Booted alone -- a Booted flag stranded on a live field (a dropped boot Replace) must never turn a REAL battle's
+        // result screen into an inert one the player cannot leave; it fails toward the stock screen
+        Boolean active, booted;
+        try { active = Memoria.Netsync.NetSyncDiorama.Active; booted = Memoria.Netsync.NetSyncDiorama.Booted; }
+        catch (Exception) { active = false; booted = false; }
+        this._netReplay = active;
+        if (!active)
+        {
+            if (booted)
+                Log.Warning("[NetSync] result replay: a result screen opened with the diorama flag set OUTSIDE the live diorama (scene not "
+                            + "BattleMapDebug) -- the STOCK result screen runs");
+            return false;
+        }
+        this.NetResetReplay();
+        Memoria.Netsync.NetSyncEnd.Manifest m = null;
+        Int32 mask = 0;
+        Byte flags = 0;
+        Boolean armed = false;
+        try { armed = Memoria.Netsync.NetSyncDiorama.TakeReplayArm(out m, out mask, out flags); }
+        catch (Exception) { armed = false; }
+        if (!armed || m == null)
+        {
+            this._netInert = true;
+            this._netAborted = true;
+            this.currentState = BattleResultUI.ResultState.Hide;   // no tick, no step: StepConfirm has no Hide case
+            try { this.AllPanel.SetActive(false); } catch (Exception) { }
+            Log.Warning("[NetSync] result replay: a result screen opened inside the battle diorama with NO armed replay -- held INERT "
+                        + "(nothing shown, nothing written); the guest leaves with the host as before");
+            return true;
+        }
+        try
+        {
+            this._netManifest = m;
+            for (Int32 i = 0; i < 4; i++)
+            {
+                Memoria.Netsync.NetSyncEnd.ManifestRow r = (mask & (1 << i)) != 0 ? m.Rows[i] : null;
+                this._netRows[i] = r;
+                this._netLevel[i] = r != null ? r.LevelBefore : 0;
+                this._netExp[i] = r != null ? r.ExpBefore : 0u;
+            }
+            this._netGil = m.GilBefore;
+            this._netHostOverflow = (flags & Memoria.Netsync.NetSyncEnd.FlagItemOverflow) != 0;
+            this._netOpenTick = Environment.TickCount;
+            this._netFpOpen = NetFingerprint(null);
+            this._netFpLast = this._netFpOpen;
+            this.InitialNormal();      // seam d builds the model from the manifest; every other line is the stock show
+            Log.Message("[NetSync] result replay: OPENED the stock result screen write-nothing on the host's manifest (" + m + "; valid rows 0x"
+                        + mask.ToString("X1") + ") at state " + this.NetStateRaw + " -- it steps when the HOST's result state steps; the "
+                        + "guest's own Confirm is inert, its Quit and Pause stay local (fingerprint 0x" + this._netFpOpen.ToString("X16") + ")");
+        }
+        catch (Exception ex)
+        {
+            this.NetFault("the open faulted: " + ex.GetType().Name + ": " + ex.Message);
+        }
+        return true;
+    }
