+        // ============================================================================ the guest-slot hand-back (B4 stage 11)
+        // [ff9mapkit netsync B4] stage 11 -- BTL-1 (studies/battle-coop/B4-B5-DESIGN.md 4.7, owner decision 4). A guest slot is
+        // guest-owned only while the guest's control lane is fresh (IsGuestOwnedSlot -- the fail-safe law), so after a guest
+        // STALL (no control frame for MenuStaleMs) the host's stock ready loop opens that slot's command window LOCALLY. Nothing
+        // ever handed it back: the returning guest's window opened on a slot the host held, and every pick it sent was refused
+        // ("the HUD refused -- the host's local menu owns this slot right now"). HOST-ONLY, two rules:
+        //   G6  the per-unit Ready bit also requires hud.CurrentPlayerIndex != slot (SampleOwnBattle): while the host's own
+        //       window holds a unit, the guest's window for it stays closed instead of buzzing refusals. A change of the held
+        //       guest slot is an EDGE that samples at once (TrackHostHold), so the bit moves inside a frame, not SampleMs late.
+        //   G3  the ROOT-ONLY hand-back (HandBackGuestSlot), right after ParseControl in both pumps: the host's window on a
+        //       slot that is guest-owned AGAIN closes -- stock SetIdle plus SetPartySwapButtonActive(false), the stock pair
+        //       for closing the window from outside (ProcessAutoBattleInput) -- ONLY while it sits at the command root
+        //       (ButtonGroupState.ActiveGroup == CommandGroupButton, no Quit prompt). Mid-submenu, or with the HUD hidden or
+        //       paused, the host finishes its own pick: the hand-back waits, counted DEFERRED and logged once per hold. It is
+        //       level-triggered, so a Cancel back to the root hands back on that tick. The slot stays on ReadyQueue: its Ready
+        //       bit returns, the guest's window opens, and the stock ready loop skips it again (IsGuestOwnedSlot).
+        // Vanilla never reaches either rule (IsGuestOwnedSlot needs Enabled + GuestSlots; G6 needs the host's window on a
+        // unit, which only matters on the wire), nor does a guest's diorama (G2 reads IsGuestOwnedSlot false while Active, and
+        // Pump's host branch needs !Booted). Wire UNCHANGED (v14): the Ready bit's byte is today's, only its meaning tightens
+        // (design 6.2). Never throws into the engine.
+        // SELFTEST CALIBRATION LEVER (harness `netsync bench handback 0`; cleared by every harness release through
+        // HarnessReleaseBench): true = the pre-stage host -- no G6, no hand-back, no hold-edge sample (the hold is still TRACKED
+        // and counted: the instrument stays on, so `captures` rising with `returns` flat is the lever's red). Read only through
+        // HandbackOn, which also needs the selftest role: a lever stranded across an ini edit can never ungate a real host.
+        public static Boolean BenchHandbackOff;
+        internal static Boolean HandbackOn
+        {
+            get { return !(BenchHandbackOff && NetSyncClient.IsSelfTestRole); }
+        }
+        private const Int32 HandbackLogBudget = 8;    // hand-back lines per own battle (the counters keep counting past it)
+        private const Int32 StallMemoryMs = 60000;    // a hold is logged as a STALL only if the control lane was fresh this recently
+        private static Int32 _heldSlot = -1;          // the GuestSlots slot the host's own window holds (TrackHostHold; -1 = none)
+        private static Int32 _heldSinceTick = Environment.TickCount - 60000;   // tick-baseline law: never 0
+        private static Boolean _heldDeferNoted;       // this hold's deferral is already counted + logged (once per hold)
+        private static Boolean _handbackEdge;         // a hand-back released the hold (it clears _heldSlot itself, so `held`/`owed`
+                                                      // agree with `returns` in the same doc): TrackHostHold's next call samples
+        private static Int32 _handbackCaptures;       // holds of a guest slot by the host's window -- monotonic: read DELTAS
+        private static Int32 _handbackReturns;        // hand-backs fired -- monotonic
+        private static Int32 _handbackDeferred;       // holds whose due hand-back waited on a submenu / hidden HUD -- monotonic
+        private static Int32 _handbackFaults;         // hand-back attempts that threw (logged up to 3 per process) -- monotonic
+        private static Int32 _handbackLogs;           // hand-back lines this own battle (HandbackLogBudget)
+        private static Int32 _lastG6Mask = -1;        // Ready bits G6 withheld in the last own-battle sample (-1 = no sample)
+        private static Int32 _lastHandbackSlot = -1;  // the last hand-back or deferral: its slot (-1 = none yet) ...
+        private static Int32 _lastHandbackFrame = -1; // ... Time.frameCount ...
+        private static Int32 _lastHandbackHeldMs = -1;// ... how long the host had held the slot ...
+        private static String _lastHandbackWhy;       // ... and "handed back" | "deferred: <why>"
+        // THE SELFTEST STALL (harness `netsync bench lapse <ms>|hold|end`; design 6.4 / 8.2): SelfTestPump's loopback guest
+        // sends NO control frame for the lapse -- ParseControl(null), exactly the call Pump makes on a stale socket -- so its
+        // slots fall back to the host's local menu after MenuStaleMs, as a stalled guest's do; when it ends the stamp resumes
+        // and the hand-back is due. Selftest only (Pump never reads it); ended by its timer, `end`, the own battle's falling
+        // edge or a harness release.
+        private static Boolean _lapseArmed;
+        private static Boolean _lapseHold;            // `hold`: until `bench lapse end`
+        private static Int32 _lapseStartTick = Environment.TickCount - 60000;
+        private static Int32 _lapseMs;
+        private static Int32 _lapseCount;             // lapses armed this process -- monotonic
+        private static Int32 _lapseEndFrame = -1;     // Time.frameCount when the last lapse ended (the stamp resumes that tick)
+
+        // The GuestSlots slot the host's OWN command window holds right now (-1 = none). Never throws.
+        // PHASE_NORMAL only: stock leaves CurrentPlayerIndex STALE across a battle end -- the MENU_OFF / victory paths call only
+        // FF9BMenu_EnableMenu(false) (DisableAllGroup, never SetIdle), and the persistent HUD resets the index only in the next
+        // battle's InitialBattle (MENU_ON, the same call that flips PHASE_NORMAL) -- so the victory, the result screen and the
+        // next intro would read a dead hold (false captures, deferrals and lines). A pause, the Quit prompt and the in-battle
+        // main menu all keep PHASE_NORMAL, so their deferrals are unchanged. (Residual: the Terra Homing script battle,
+        // SUMMON_RAY_FLAG, defers the menu enable past the flip -- counters only; its ActiveGroup is empty, so no SetIdle.)
+        private static Int32 HostHeldGuestSlot(BattleHUD hud)
+        {
+            try
+            {
+                if (hud == null || GuestSlots == 0)
+                    return -1;
+                FF9StateBattleSystem btlsys = FF9StateSystem.Battle.FF9Battle;
+                if (btlsys == null || btlsys.btl_phase != FF9StateBattleSystem.PHASE_NORMAL)
+                    return -1;
+                Int32 s = hud.CurrentPlayerIndex;
+                return s >= 0 && s < 4 && (GuestSlots & (1 << s)) != 0 ? s : -1;
+            }
+            catch
+            {
+                return -1;
+            }
+        }
+
+        // One read per pump tick (both pumps, beside TrackCommandPhase). A change of the held guest slot returns true -- G6
+        // moved that unit's Ready bit, so the caller samples NOW. Counts the holds and logs them (a STALL only: the lane was
+        // fresh within StallMemoryMs -- a host with GuestSlots set and no guest at all holds every such turn, silently). With
+        // the lever pulled it only tracks. A hand-back releases its hold itself (HandBackGuestSlot clears _heldSlot), so the
+        // tick after one is an edge too: it samples the returned Ready bit at once.
+        private static Boolean TrackHostHold()
+        {
+            Int32 held = HostHeldGuestSlot(UIManager.Battle);
+            if (held == _heldSlot)
+            {
+                if (!_handbackEdge)
+                    return false;
+                _handbackEdge = false;
+                return HandbackOn;
+            }
+            _handbackEdge = false;
+            Int32 was = _heldSlot;
+            Int32 now = Environment.TickCount;
+            Boolean stall = (now - _assistTick) < StallMemoryMs;
+            if (was >= 0 && stall)
+                HandbackLog("[NetSync] hand-back: the host's window on guest slot " + was + " closed after " + (now - _heldSinceTick)
+                            + " ms by itself (the host's own pick, a KO, or the turn or the battle ending) -- nothing to hand back");
+            _heldSlot = held;
+            _heldDeferNoted = false;
+            if (held >= 0)
+            {
+                _heldSinceTick = now;
+                _handbackCaptures++;
+                Int32 silentMs = now - _assistTick;
+                if (stall)
+                    HandbackLog("[NetSync] hand-back: the host's local window holds guest slot " + held + " -- " + (silentMs >= MenuStaleMs
+                                ? "the guest's control lane has been silent " + silentMs + " ms (a stall)"
+                                : "the slot became a guest slot while the host's window held it (a GuestSlots change)") + (HandbackOn
+                                ? "; its Ready bit is withheld while the host holds it (G6), and it is handed back at the command "
+                                  + "root once the guest is live again (G3)"
+                                : " -- hand-back lever OFF (calibration): no G6, no hand-back") + "; captures=" + _handbackCaptures);
+            }
+            return HandbackOn;
+        }
+
+        // G3 -- right after ParseControl in both pumps (the control lane has just refreshed IsGuestOwnedSlot). Level-triggered:
+        // runs whenever the host's window holds a slot the guest owns again. Never throws into the engine.
+        private static void HandBackGuestSlot()
+        {
+            if (!HandbackOn || GuestSlots == 0)
+                return;
+            try
+            {
+                BattleHUD hud = UIManager.Battle;
+                Int32 slot = HostHeldGuestSlot(hud);
+                if (slot < 0 || !IsGuestOwnedSlot(slot))
+                    return;
+                Int32 now = Environment.TickCount;
+                Int32 heldMs = slot == _heldSlot ? now - _heldSinceTick : -1;
+                String group = ButtonGroupState.ActiveGroup;
+                Boolean quitUp = QuitPromptUp();
+                if (quitUp || group != BattleHUD.CommandGroupButton)
+                {
+                    // the host is mid-pick (or its HUD is hidden, paused or under the Quit prompt): it finishes first
+                    if (!_heldDeferNoted)
+                    {
+                        _heldDeferNoted = true;
+                        _handbackDeferred++;
+                        String why = HandbackDeferWhy(group, quitUp);
+                        _lastHandbackSlot = slot;
+                        _lastHandbackFrame = UnityEngine.Time.frameCount;
+                        _lastHandbackHeldMs = heldMs;
+                        _lastHandbackWhy = "deferred: " + why;
+                        HandbackLog("[NetSync] hand-back: guest slot " + slot + " is the guest's again, but the hand-back WAITS -- " + why
+                                    + "; the host finishes its own pick (root-only, owner decision 4; logged once per hold), deferred="
+                                    + _handbackDeferred);
+                    }
+                    return;
+                }
+                hud.SetIdle();
+                hud.SetPartySwapButtonActive(false);
+                if (slot == _heldSlot)
+                {
+                    _heldSlot = -1;                // the hold ends HERE, not on the next tick: `held` / `owed` / `held_ms` agree with
+                    _heldDeferNoted = false;       // `returns` and `turn.slot` in the same harness doc; the next TrackHostHold
+                    _handbackEdge = true;          // still takes the Ready re-sample
+                }
+                _handbackReturns++;
+                _lastHandbackSlot = slot;
+                _lastHandbackFrame = UnityEngine.Time.frameCount;
+                _lastHandbackHeldMs = heldMs;
+                _lastHandbackWhy = "handed back";
+                HandbackLog("[NetSync] hand-back: guest slot " + slot + " handed BACK to the guest -- its control lane is live again "
+                            + "and the host's window sat at the command root (held " + heldMs + " ms); the host's window closed, the "
+                            + "slot's Ready bit returns (BTL-1), returns=" + _handbackReturns);
+            }
+            catch (Exception err)
+            {
+                _handbackFaults++;
+                if (_handbackFaults <= 3)
+                    Log.Error(err, "[NetSync] hand-back failed -- the host keeps its window (logged up to 3 times per process)");
+            }
+        }
+
+        private static String HandbackDeferWhy(String group, Boolean quitUp)
+        {
+            if (quitUp)
+                return "the host's Quit prompt is up";
+            if (group == BattleHUD.AbilityGroupButton || group == BattleHUD.ItemGroupButton || group == BattleHUD.TargetGroupButton)
+                return "the host's window is in a submenu (" + group + ")";
+            if (String.IsNullOrEmpty(group))
+                return "the host's command window is hidden, paused or disabled";
+            return "another UI holds the buttons (" + group + ")";
+        }
+
+        // Every hand-back line goes through here: HandbackLogBudget lines per own battle, then silence (the counters keep
+        // counting; the last line says so).
+        private static void HandbackLog(String line)
+        {
+            if (_handbackLogs >= HandbackLogBudget)
+                return;
+            _handbackLogs++;
+            Log.Message(_handbackLogs < HandbackLogBudget ? line
+                        : line + " (the last hand-back line this battle -- the harness counters keep counting)");
+        }
+
+        // SelfTestPump, once per tick, BEFORE its ParseControl: true while a `bench lapse` holds the loopback guest silent. The
+        // first tick after a timed lapse runs out ends it (the end frame recorded, one line) and the stamp resumes that tick.
+        private static Boolean BenchLapseTick()
+        {
+            if (!_lapseArmed)
+                return false;
+            if (!NetSyncClient.IsSelfTestRole)
+            {
+                EndLapse("the selftest role ended");
+                return false;
+            }
+            if (_lapseHold || (Environment.TickCount - _lapseStartTick) < _lapseMs)
+                return true;
+            EndLapse("its " + _lapseMs + " ms ran out");
+            return false;
+        }
+
+        private static void EndLapse(String why)
+        {
+            if (!_lapseArmed)
+                return;
+            _lapseArmed = false;
+            _lapseHold = false;
+            _lapseEndFrame = UnityEngine.Time.frameCount;
+            Log.Message("[NetSync] harness: bench lapse ENDED (" + why + ") after " + (Environment.TickCount - _lapseStartTick)
+                        + " ms -- the loopback guest's control lane stamps again from the next selftest pump tick");
+        }
