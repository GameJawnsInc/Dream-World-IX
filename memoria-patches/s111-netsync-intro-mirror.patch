+        /// `stock` everywhere except a booted diorama with a host choice, where the HOST's choice wins. One Boolean read on
+        /// vanilla, solo and every real battle (a diorama is never booted there). Never throws.</summary>
+        public static Boolean SkipBattleIntro(Boolean stock)
+        {
+            if (!_booted)
+                return stock;                     // vanilla, solo, every real battle on either machine: stock
