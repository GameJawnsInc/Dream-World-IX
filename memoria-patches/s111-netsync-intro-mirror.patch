+            if (_wireIntro >= 0 && NetSyncBattle.IntroMirrorOn)   // (the selftest lever `bench intro 0` = the pre-stage diorama)
+            {
+                skip = _wireIntro == 1;           // the HOST's choice
+                _introCalls++;
+            }
+            _introOwn = stock ? 1 : 0;
+            _introApplied = skip ? 1 : 0;
+            return skip;
+        }
