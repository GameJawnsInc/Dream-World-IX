+            Num(sb, "count", Memoria.Netsync.NetSyncField.HarnessMenuRefusals); sb.Append(",");
+            Num(sb, "lines", Memoria.Netsync.NetSyncField.HarnessMenuRefusalLines); sb.Append(",");
+            Num(sb, "silent", Memoria.Netsync.NetSyncField.HarnessMenuRefusalsSilent); sb.Append(",");
+            Str(sb, "last_state", Memoria.Netsync.NetSyncField.HarnessMenuRefusalState); sb.Append(",");
+            Num(sb, "last_field", Memoria.Netsync.NetSyncField.HarnessMenuRefusalField); sb.Append(",");
+            Num(sb, "age_ms", Memoria.Netsync.NetSyncField.HarnessMenuRefusalAgeMs); sb.Append(",");
+            Bool(sb, "muted", Memoria.Netsync.NetSyncField.HarnessMenuRefusalMuted);
+            sb.Append("}");
+        }
