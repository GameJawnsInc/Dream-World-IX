+        // [ff9mapkit netsync s131] Pump's lane order over a served-frame script (frame i at tick i * AdoptTestFrameMs; served[i] =
+        // the seq the transport serves then, -1 = none): the adopt (PeerAdoptStep; a new frame restamps), the freshness test,
+        // and the run-out (PeerExpireStep, then the null). `memo` false = the pre-s131 step (the memo forgotten before every
+        // adopt: the old `_peerView == null` disjunct). Returns the refused repeats; `staleAt` = the first live->stale tick,
+        // `reopenAt` = the first stale->live tick after it (-1 = never).
+        private static Int32 AdoptReplay(Int32[] served, Boolean memo, out Int32 staleAt, out Int32 reopenAt)
+        {
+            PeerLaneMemo m = default(PeerLaneMemo);
+            Int32 cur = -1, tick = 0, refused = 0;
+            Boolean wasLive = false;
+            staleAt = -1;
+            reopenAt = -1;
+            for (Int32 i = 0; i < served.Length; i++)
+            {
+                Int32 now = i * AdoptTestFrameMs;
+                if (!memo)
+                    m = default(PeerLaneMemo);
+                Int32 adopt = PeerAdoptStep(ref m, served[i], AdoptTestNonce, cur);
+                if (adopt == AdoptNew)
+                {
+                    cur = served[i];
+                    tick = now;
+                }
+                else if (adopt == AdoptRefused)
+                {
+                    refused++;
+                }
+                Boolean live = cur >= 0 && now - tick < AdoptTestStaleMs;
+                if (!live)
+                {
+                    PeerExpireStep(ref m, cur, AdoptTestNonce);
+                    cur = -1;
+                }
+                if (wasLive && !live && staleAt < 0)
+                    staleAt = now;
+                else if (!wasLive && live && staleAt >= 0 && reopenAt < 0)
+                    reopenAt = now;
+                wasLive = live;
+            }
+            return refused;
+        }
