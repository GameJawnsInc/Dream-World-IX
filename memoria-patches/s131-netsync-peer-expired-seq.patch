+        // the selftest's own constants (the table is pure: a retuned live StaleMs never moves its rows)
+        private const Int32 AdoptTestNonce = 0x41;
+        private const Int32 AdoptTestStaleMs = 2000;  // = StaleMs, and the transport's own re-serve window (NetSyncSocket)
+        private const Int32 AdoptTestFrameMs = 10;    // one guest Update
+        private const Int32 AdoptTestSampleMs = 150;  // the host's seq cadence (SampleMs)
