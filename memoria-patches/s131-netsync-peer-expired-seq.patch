+        // [ff9mapkit netsync s131] A served-frame script over totalMs: the host's seq advances every AdoptTestSampleMs up to its
+        // last pre-cut seq (first served at lastMs, a multiple of the cadence), which the transport serves until that seq's last
+        // receipt (lastMs + tailMs) + AdoptTestStaleMs -- tailMs < 0 = forever: a stalled host whose writer keeps re-sending it --
+        // then nothing; from resumeMs (>= 0) the host's new seqs.
+        private static Int32[] CutScript(Int32 lastMs, Int32 tailMs, Int32 resumeMs, Int32 totalMs)
+        {
+            Int32[] s = new Int32[totalMs / AdoptTestFrameMs + 1];
+            Int32 last = lastMs / AdoptTestSampleMs;
+            for (Int32 i = 0; i < s.Length; i++)
+            {
+                Int32 t = i * AdoptTestFrameMs;
+                if (resumeMs >= 0 && t >= resumeMs)
+                    s[i] = last + 1 + (t - resumeMs) / AdoptTestSampleMs;
+                else if (t < lastMs)
+                    s[i] = t / AdoptTestSampleMs;
+                else if (tailMs < 0 || t <= lastMs + tailMs + AdoptTestStaleMs)
+                    s[i] = last;
+                else
+                    s[i] = -1;
+            }
+            return s;
+        }
