+        // A 46-byte impact in QueueActionFrame's layout, every field a marker (caster, target and flags chosen by the row).
+        private static Byte[] ActTestImpact(Byte nonce, UInt16 seq, Byte caster, Byte target, Byte flags)
+        {
+            Byte[] p = new Byte[ActLegacyLen];
+            using (MemoryStream ms = new MemoryStream(p))
+            using (BinaryWriter bw = new BinaryWriter(ms))
+            {
+                bw.Write(nonce);
+                bw.Write(seq);
+                bw.Write(caster);
+                bw.Write(target);
+                bw.Write((UInt16)0x0011);              // the target fig triple
+                bw.Write(-123);
+                bw.Write(7);
+                bw.Write((UInt16)0x0022);              // the caster fig triple
+                bw.Write(45);
+                bw.Write(-6);
+                bw.Write(900u);                        // the four raws
+                bw.Write(80u);
+                bw.Write(1200u);
+                bw.Write(60u);
+                bw.Write(flags);
+                bw.Write((UInt16)1);                   // Attack
+                bw.Write((UInt16)176);
+            }
+            return p;
+        }
