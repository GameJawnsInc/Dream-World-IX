diff --git a/Assembly-CSharp/Global/btl_vfx.cs b/Assembly-CSharp/Global/btl_vfx.cs
index f0815c1..e12064d 100644
--- a/Assembly-CSharp/Global/btl_vfx.cs
+++ b/Assembly-CSharp/Global/btl_vfx.cs
@@ -181,6 +181,76 @@ public static class btl_vfx
         }
     }
 
+    // [ff9mapkit netsync s133] THE ACTION START's vfx description (studies/battle-coop/R3-DESIGN.md 3.3.2, R3-ACTION-REPLAY-AUDIT.md 2.1
+    // amendment 10): a PURE MIRROR of SelectCommandVfx just above, for this machine's own mode -- which branch it is about to take,
+    // as a kind (NetSyncBattle.VfxKind*) and a number. It never calls Execute, never loads, never rolls, never assigns, and any
+    // exception reads Unknown. (One side effect it shares with SelectCommandVfx: GetPlayerCommandSFX's item branch reaches
+    // ff9item.GetItemEffect, which logs an error for an item with no valid effect data -- such an item logs it twice on a netsync
+    // host, once here and once there; the outcome is the same.) Kind 1 (the ability's .seq) keys on a VfxAction already in hand --
+    // BTL_SCENE eagerly loads the VfxAction of every enemy attack that has a SequenceFile (stock enemies have none and read kind 2)
+    // -- or on the Beatrix fix's predicate, evaluated; never on SequenceFile alone: the lazy SequenceFile load at the
+    // head of the SFXRework branch is NOT mirrored, so a file that failed to load reads as the branch below it, exactly as the real
+    // path falls through, and a CSV SequenceFile not loaded yet (its first use) reads the same -- NetSyncBattle.CheckActionVfx counts
+    // that drift. num: kind 1 the ability's VfxIndex, kind 2 the enemy sequence (sub_no), kind 3 the SpecialEffect
+    // GetPlayerCommandSFX resolves (weapon serial, trance attack, SysTrans, item / Steal / Throw shapes, PatchedVfx, Vfx2 for
+    // ManyAny cursor 0, meteor_miss and the host-rolled short_summon), kind 4 the command (Defend / Change), else 0. Called by
+    // NetSyncBattle.QueueActionStart right BEFORE SelectCommandVfx (btl_cmd.CommandEngine), on a host only.
+    public static Byte DescribeCommandVfx(CMD_DATA cmd, out Int32 num)
+    {
+        num = 0;
+        try
+        {
+            BTL_DATA regist = cmd.regist;
+            if (Configuration.Battle.SFXRework)
+            {
+                if (cmd.cmd_no != BattleCommandId.MagicCounter)
+                {
+                    Boolean beatrixFix = cmd.aa.Info.SequenceFile == null && regist != null && regist.bi.player == 0
+                                         && regist.dms_geo_id == 427 && cmd.aa.Info.VfxIndex == 457;
+                    if (cmd.aa.Info.VfxAction != null || beatrixFix)
+                    {
+                        num = cmd.aa.Info.VfxIndex;
+                        return Memoria.Netsync.NetSyncBattle.VfxKindSeq;
+                    }
+                    if (regist != null && regist.bi.player == 0 && cmd.cmd_no != BattleCommandId.SysTrans)
+                    {
+                        num = cmd.sub_no;
+                        return Memoria.Netsync.NetSyncBattle.VfxKindEnemy;
+                    }
+                }
+            }
+            else
+            {
+                switch (cmd.cmd_no)
+                {
+                    case BattleCommandId.EnemyAtk:
+                    case BattleCommandId.EnemyCounter:
+                    case BattleCommandId.EnemyDying:
+                    case BattleCommandId.EnemyReaction:
+                        num = cmd.sub_no;
+                        return Memoria.Netsync.NetSyncBattle.VfxKindEnemy;
+                }
+            }
+            SpecialEffect sfxNum = GetPlayerCommandSFX(cmd);
+            if (sfxNum != SpecialEffect.Special_No_Effect)
+            {
+                num = (Int32)sfxNum;
+                return Memoria.Netsync.NetSyncBattle.VfxKindSpecial;
+            }
+            if (cmd.cmd_no == BattleCommandId.Change || cmd.cmd_no == BattleCommandId.Defend)
+            {
+                num = (Int32)cmd.cmd_no;
+                return Memoria.Netsync.NetSyncBattle.VfxKindCommon;
+            }
+            return Memoria.Netsync.NetSyncBattle.VfxKindNone;
+        }
+        catch
+        {
+            num = 0;
+            return Memoria.Netsync.NetSyncBattle.VfxKindUnknown;
+        }
+    }
+
