+        // The inert 46-byte head of a START or an END: no caster, no target, no figures, no state; the host _seq NOT consumed.
+        private static void WriteInertHead(BinaryWriter bw, Byte nonce, UInt16 seq, Byte flags, UInt16 cmdNo, UInt16 subNo)
