+                bw.Write(ActExtLenStart);
+                bw.Write(ActExtStart);
+                bw.Write(actId);
+                bw.Write(actorSlot);
+                bw.Write(actorFlags);
+                bw.Write(cmdNo);
+                bw.Write(subNo);
+                bw.Write(tarId);
+                bw.Write(cursor);
+                bw.Write(info);
