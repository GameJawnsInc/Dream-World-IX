+        // ============================================================================================ the busy window
+        private static void ActWindowOpen(FF9StateBattleSystem b)
+        {
+            _actSnap.Clear();
+            _actWindowOpen = true;
+            _actWindowAborted = false;
+            _actWindowRowMask = 0;
+            _actWindowAbortMask = 0;
+            _actWindowCamTarget = false;
+            _actWindowCursorBit = 2;
+            if (b == null)
+                return;
+            _actWindowCursorBit = b.cmd_status & 2;
+            Int32 guard = 0;
+            for (BTL_DATA n = b.btl_list.next; n != null && guard < 16; n = n.next, guard++)
+            {
+                try
+                {
+                    _actSnap.Add(new ActUnitSnap
+                    {
+                        Unit = n, Rot = n.rot, ScaleX = n.geo_scale_x, ScaleY = n.geo_scale_y, ScaleZ = n.geo_scale_z,
+                        Disappear = n.bi.disappear, Shadow = n.bi.shadow, Row = n.bi.row, MeshFlags = n.meshflags,
+                        WeaponMeshFlags = n.weaponMeshFlags, MeshCurrent = n.mesh_current, AnimFlag = n.animFlag, AnimSpeed = n.animSpeed,
+                        BasePos = n.base_pos
+                    });
+                }
+                catch { }
+            }
+        }
+
+        /// <summary>[ff9mapkit netsync s134] The window closes when no replay runs: after an abort the snapshot is restored (ActRestoreScope);
+        /// after only natural ends nothing is.</summary>
+        private static void ActWindowCheck(FF9StateBattleSystem b)
+        {
+            if (!_actWindowOpen || _actRunning.Count > 0)
+                return;
+            _actWindowOpen = false;
+            _actWindowAbortMask = 0;
+            Int32 scope = ActRestoreScope(_actWindowAborted, _endInjected);
+            Boolean camTarget = _actWindowCamTarget;
+            _actWindowAborted = false;
+            _actWindowCamTarget = false;
+            if (scope == ActRestoreNone)
+            {
+                _actSnap.Clear();
+                return;
+            }
+            ActRestore(b, scope == ActRestoreLimited, camTarget);
+            _actSnap.Clear();
+        }
+
+        // THE RESTORE (audit amendment 9): every unit ActRestoreUnit takes (FULL only), the cursor bit (FULL only: InjectEnd cleared
+        // it on purpose -- ActCursorBitAfter), then the shared lanes. LIMITED (after an end injection): the shared lanes only.
+        // CameraNo follows the stock Loop rule (FULL only): back to 0 only when an aborted replay had run a targeted PlayCamera
+        // (camTarget: useCameraTarget -- never set for a replay whose host Speed skipped its PlayCamera) and only in PHASE_NORMAL;
+        // otherwise the battle's own idle camera (HonoluluBattleMain's pick) stays, as on the host.
+        private static void ActRestore(FF9StateBattleSystem b, Boolean limited, Boolean camTarget)
+        {
+            Int32 units = 0;
+            if (!limited)
+            {
+                foreach (ActUnitSnap s in _actSnap)
+                    if (ActRestoreUnit(b, s))
+                        units++;
+            }
+            try
+            {
+                if (b != null)
+                    b.cmd_status = ActCursorBitAfter(b.cmd_status, _actWindowCursorBit, limited);
+            }
