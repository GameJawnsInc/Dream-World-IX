+        /// <summary>[ff9mapkit netsync s134] THE DECISION (pure; ActReplaySelfTest pins every row): the first decline reason in the design's
+        /// order (3.3.3 as amended: knob, lever, rework, end, leave (a Leave in flight), stale, backlog, actor, hidden, dead -- unless
+        /// stock would run it --, kind, transform, target), then NOOP for kind none, then the running cap, else go.</summary>
+        internal static Int32 ActDecide(ref ActDecideIn d)
+        {
+            if (d.KnobOff)
+                return ActWhyKnob;
+            if (d.LeverOff)
+                return ActWhyLever;
+            if (d.NoRework)
+                return ActWhyRework;
+            if (d.EndPresented)
+                return ActWhyEnd;
+            if (d.Leaving)
+                return ActWhyLeave;
+            if (d.Stale)
+                return ActWhyStale;
+            if (d.Backlog)
+                return ActWhyBacklog;
+            if (d.ActorMissing)
+                return ActWhyActor;
+            if (d.ActorHidden)
+                return ActWhyHidden;
