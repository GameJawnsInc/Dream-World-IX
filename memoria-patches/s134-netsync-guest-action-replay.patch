+            catch { }
+        }
+
+        /// <summary>[ff9mapkit netsync s134] TEARDOWN (ForceDisarm, between AbortReplay and Disarm; and `actbench teardown`): every record
+        /// dropped, the replay actions released from the sequencer (pure SFX cleanup -- with no record left, none of them may reach
+        /// ExecVfxCommand again; one the sequencer will not let go stays short-circuited as a zombie) and every song they started
