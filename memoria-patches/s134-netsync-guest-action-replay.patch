index e69de29..cd8a8a0 100644
--- /dev/null
+++ b/Assembly-CSharp/Memoria/Netsync/NetSyncDiorama.Replay.cs
@@ -0,0 +1,2718 @@
+using System;
+using System.Collections.Generic;
+using System.Text;
+using FF9;
+using Memoria.Data;
+using Memoria.Prime;
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // ===========================================================================================================================
+    // [ff9mapkit netsync s134] THE GUEST ACTION REPLAY (studies/battle-coop/R3-DESIGN.md 3.3.3 as amended by
+    // R3-ACTION-REPLAY-AUDIT.md 2.2 and section 3 -- the audit's "s123"; group 2 was renumbered s133-s141). The s133 host ships a
+    // START record before every action and an END after it (NetSyncBattle, "the ACTION START lane"); this guest REPLAYS each START
+    // on its battle diorama: a standalone CMD_DATA, never enqueued, runs through the stock SFXRework sequencer, so the attack or
+    // the cast plays where before only numbers, a flinch and a player-only MP_ATTACK swing showed.
+    //
+    // THE CONTAINMENT LAW holds by construction: a replay is PRESENTATION ONLY.
+    //   * THE SHORT-CIRCUIT -- btl_cmd.ExecVfxCommand's first statement asks ActOnHit, which answers true for every registered
+    //     replay CMD_DATA (matched by reference, even on an internal exception): no CalcMain, no SysTrans model / trance_no /
+    //     achievement, no SysLastPhoenix phase flip. Every replay registers BEFORE its Execute, so a same-frame hit already
+    //     short-circuits. False for null and for every real command (the host, solo and vanilla never register one).
+    //   * THE TRIPWIRE -- SBattleCalculator.CalcMain's 5-argument head and ExecVfxCommand's SysTrans case count every entry while
+    //     a diorama is booted (`act.guest.calc_while_booted`): a fall-through becomes a counted, calibrated red (the selftest lever
+    //     `actbench shortcircuit off` proves it can go red, on the sandboxed selftest save only).
+    //   * The replay never enters cur_cmd_list, SetCommand, EnqueueCommand or the queue: no IncreaseAAUsageCounter, no ItemUse,
+    //     no UpdateCommandAchievement, no FinishCommand ATB / trance writes, no SetCommand caster writes. A sequence's SetVariable
+    //     may not move btl_seq and may change only bit 1 of cmd_status (BattleActionCode.TrySetVariable); its gEventGlobal writes
+    //     were already refused under Active (s40). What a replay DOES write is the diorama's own presentation state: motions,
+    //     pos / base_pos / rot / scale / meshes / disappear of the diorama BTL_DATAs (the busy-window restore puts them back after
+    //     an abort), one Change replay's row switch (btl_para.SwitchPlayerRow on the diorama unit -- SavePlayerData is Active-gated),
+    //     die_seq through the stock EndCommandMotion at a natural end (the death pipeline's own writes stay under the Snapshot
+    //     bracket, as every wire kill's already do), UnityEngine.Random draws for cosmetic picks (LoadSFX's random caster for a
+    //     multi-unit Char, CheckReflec's bounce on the replay CMD_DATA -- process-local, never saved, deciding no outcome) and
+    //     sounds. Nothing here writes HP, MP, a status, the party, gil, items, exp or a flag.
+    //
+    // THE PIPELINE (two-step drain, audit amendment 4): ActionTick (transport) and ActionTickBench (the selftest inbox, the same
+    // quiesce gates) route every frame through ActRouteFrame: a START only REGISTERS (later impacts of the same drain pair with it
+    // as "queued"), an END marks a record not yet launched STALE (its host already finished it), every other frame is applied as
+    // before (ApplyActionFrame) -- a paired impact skips the legacy player MP_ATTACK swing. ActTick, right after the drain on both
+    // branches, decides: decline (knob, lever, rework, end, leave, stale, backlog, actor, hidden, dead, kind, transform, target, busy --
+    // each logged once per boot), NOOP (kind none: no clip), or park the record in its actor's pending slot (one per actor, a
+    // newer one supersedes it) and launch it once the actor's running replay no longer holds its command motion -- or hard-abort
+    // that replay after 1500 ms. THE BACKLOG RULE (amendment 5): a START drained before the boot's LIVE latch, while the battle
+    // lane is stale, or in the Update the lane went stale -> live is declined `backlog` (its impacts take the legacy route).
+    //
+    // ABORTS are a HARD release plus restore (D05), never stock Cancel(): ActTick aborts on the host's END + 6 s, the 90 s wall cap
+    // or a gone actor; ActAbortAll runs at the first R8 hit, at W3 (an injected end + 4 s), on Leave (after its fade check) and
+    // from `actbench clear`. A hard release first DROPS the replay's unplayed SFX (ActDropSfx: cancelled, and a camera load that
+    // already holds SFXData.lockLoading released -- else nothing loads again this battle), then leaves the sequencer; a release
+    // that throws half-way is completed by a plain Remove, and an action that still cannot leave stays short-circuited as a
+    // ZOMBIE (ActOnHit, ActLive) until the sequencer drops it -- a registered replay never reaches CalcMain unregistered.
+    // THE BUSY WINDOW: the first running replay snapshots every linked unit and the cursor bit (cmd_status bit 1); when the count
+    // returns to 0 after an abort the snapshot is restored (pos = base_pos, SetDefaultIdle, weapons, the cursor bit, bbg
+    // intensity, UnshiftWorld, CameraNo 0 by stock's rule: only after a targeted PlayCamera, in PHASE_NORMAL, never in the
+    // LIMITED restore) -- after an end injection ONLY the shared lanes are released, the unit pose belongs to
+    // the stock tails then (audit 3.2); the units of a replay aborted BEFORE the injection are restored right before it
+    // (ActBeforeInject), unless a still-running replay acts with them. Nothing is restored after a natural end. TEARDOWN
+    // (ForceDisarm) runs ActDiscardAll: records dropped, replay actions released, NOTHING applied.
+    //
+    // THE END PRESENTATIONS (audit 3.2, D02): the run-away (PresentFlee) and the annihilation's MENU_OFF settle wait while a replay
+    // still acts, bounded by W3 (then ActAbortAll and inject). The hold remembers the block that started it: when the host's
+    // block moves past MENU_OFF (a flee's CLOSE+ESCAPE comes ~1 s in) or the lane goes stale while it waits, the HELD
+    // presentation injects at once from that block (ActEndHoldBreaks) -- the run-away never degrades to the CLOSE fade, or to
+    // nothing; a stale-lane break still passes the normal path's InjectVerdict first (no injection under the pause screen, a
+    // quit prompt, a tutorial or the `guest off` lever: the hold keeps). The victory tail already waits on SFX.IsRunning().
+    // CLOCKS (audit 3.5, D04): every in-scene timer reads ONE battle-time accumulator that skips paused spans (the EndWatchdogs read:
+    // NOPUTDISPENV or the special tutorial window, counted only between two paused reads); wall time only for the 90 s cap. ActTick
+    // launches nothing while paused (a START parks and launches after the unpause).
+    // BIT 5 (D03): a per-boot latch (BootFromWire's header, then OR'd from any live view of the booted nonce -- the selftest bench
+    // feed included), never cleared on a null view. Only the death-attack grace reads it: the extension is self-describing, and an
+    // old host is told per impact by its missing 0xA6 extension ("host predates action replay", once per boot).
+    // THE DEATH-ATTACK GRACE (D10, amendment 8): a lethal impact from a player caster on an AttackOnDeath enemy (or a reconciler
+    // kill of one) holds that enemy QUEUED_CASTER-busy for 1500 ms of battle time BEFORE the kill, so DeathStatusScript leaves die_seq
+    // at 0 and the EnemyDying START has time to arrive; it self-heals at the next animation-loop end (btlseq).
+    // Vanilla, solo and the host: every hot-path hook reads one static (ActLive / ActBusy) that is false there.
+    // ===========================================================================================================================
+    public static partial class NetSyncDiorama
+    {
+        // ---------------------------------------------------------------------------------------------------- constants
+        internal const Int32 ActMaxRunning = 6;            // design: "six replays already running" declines
