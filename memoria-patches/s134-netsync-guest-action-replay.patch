+                }
+                catch { }
+            }
+            try
+            {
+                if (!UnifiedBattleSequencer.runningActions.Contains(a))
+                    return true;
+                UnifiedBattleSequencer.runningActions.Remove(a);
+                a.cmd = null;
+                return !UnifiedBattleSequencer.runningActions.Contains(a);
+            }
+            catch
+            {
+                return false;
+            }
+        }
+
+        /// <summary>[ff9mapkit netsync s134] Every SFX of an aborted replay that has not PLAYED is dropped (ActSfxDropPlan): cancelled --
+        /// out of SFXData's loaded-not-played set, skipped at its dequeue, dropped by LoadLoop as LoadCur -- and a camera SFX whose
+        /// runtime load already holds SFXData.lockLoading is released the way Runtime.End releases a played one
+        /// (SFXData.DropForReplay). Without this, one abort of a replay still waiting on its load leaves the loader locked: every
+        /// later replay hangs at WaitSFXLoaded until its own abort, which leaks again. A playing SFX is the release's to End.
+        /// Each SFX in its own try: never throws.</summary>
+        private static void ActDropSfx(UnifiedBattleSequencer.BattleAction a)
+        {
+            List<SFXData> list;
+            try { list = a.sfxList; }
+            catch { return; }
+            if (list == null)
+                return;
+            for (Int32 i = 0; i < list.Count; i++)
+            {
+                try
+                {
+                    SFXData s = list[i];
+                    if (s == null)
+                        continue;
+                    Int32 plan = ActSfxDropPlan(s.runningSFX != null ? s.runningSFX.Count : 0, ReferenceEquals(SFXData.LoadCur, s), s.useCamera,
+                                                s.loadHasEnded);
+                    if ((plan & ActSfxCancel) != 0)
+                        s.DropForReplay((plan & ActSfxUnlock) != 0);
+                }
+                catch { }
+            }
+        }
+
+        // A replay the sequencer would not let go: its CMD_DATA stays short-circuited until the sequencer drops the action.
+        private static void ActZombie(ActRec r)
+        {
+            try
+            {
+                _actZombies[r.Cmd] = r.Action;
+                if (_actZombieLogged)
+                    return;
+                _actZombieLogged = true;
+                Log.Warning("[NetSync] action replay: id " + r.Id + " could not leave the sequencer (its release and a plain Remove both "
+                            + "failed) -- its hits stay short-circuited until the sequencer drops it (a zombie; logged once per boot)");
+            }
+            catch { }
+        }
+
+        /// <summary>[ff9mapkit netsync s134] Every running replay hard-released and every parked START dropped (`why`): the first R8 hit,
