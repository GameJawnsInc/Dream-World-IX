+                ActorFlags = a.ActorFlags, CmdNo = a.ActCmdNo, SubNo = a.ActSubNo, TarId = a.ActTarId, Cursor = a.ActCursor, Info = a.ActInfo,
+                MagicCaster = a.ActMagicCaster, VfxKind = a.VfxKind, VfxNum = a.VfxNum, PatchedVfx = a.ActPatchedVfx, HostSpeed = a.HostSpeed,
+                State = ActStRegistered, Backlog = backlog, Bench = bench, ArriveMs = _actNowMs
+            };
+            _actLast = r;
+            if (!_actBook.RegisterStart(r))
+            {
+                ActDecline(r, "duplicate", "a second START with the same id this boot");
+                return;
+            }
+            // the verdicts already known now (knob, lever, rework, end, backlog) decline at once, so this drain's later impacts of it
+            // take the legacy route (the swing) instead of pairing with a record that can never launch
+            ActDecideIn d = new ActDecideIn();
+            d.KnobOff = !ActKnobOn;
+            d.LeverOff = ActLeverOff;
+            d.NoRework = !ActReworkOn;
+            d.EndPresented = EndHudOff;
+            d.Leaving = LeaveRequestedRecently;
+            d.Backlog = backlog;
+            d.ActorLinked = true;
+            d.CmdNo = r.CmdNo;
+            d.Kind = NetSyncBattle.VfxKindSpecial;
