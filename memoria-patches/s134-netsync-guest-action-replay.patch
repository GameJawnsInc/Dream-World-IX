+                return false;
+            Int32 guard = 0;
+            for (BTL_DATA n = b.btl_list.next; n != null && guard < 16; n = n.next, guard++)
+                if (ReferenceEquals(n, d))
+                    return true;
+            return false;
+        }
+
+        private static void ActDecideQueue(FF9StateBattleSystem b, Boolean paused)
+        {
+            if (_actBook.Queue.Count == 0)
+                return;
+            Boolean steady = b != null && Active && b.btl_phase == FF9StateBattleSystem.PHASE_NORMAL
+                             && (b.btl_load_status & (ff9btl.LOAD_INITNPC | ff9btl.LOAD_INITCHR)) == (ff9btl.LOAD_INITNPC | ff9btl.LOAD_INITCHR);
+            ActRec[] q = _actBook.Queue.ToArray();
+            for (Int32 i = 0; i < q.Length; i++)
+            {
+                ActRec r = q[i];
+                if (!r.Pending)
+                {
+                    _actBook.Settle(r);
+                    continue;
+                }
+                try
+                {
+                    BTL_DATA actor;
+                    UInt16 tar, magic;
+                    Int32 verdict = ActDecideNow(b, r, out actor, out tar, out magic);
+                    if (verdict == ActNoop)
+                    {
+                        ActMarkNoop(r);
+                        continue;
+                    }
+                    if (verdict != ActGo)
+                    {
+                        ActDecline(r, ActWhyName(verdict), ActWhyDetail(verdict));
+                        continue;
+                    }
+                    if (r.State == ActStRegistered)
+                    {
+                        ActRec older = _actBook.Park(r, _actNowMs);
+                        if (older != null)
+                        {
+                            _actSuperseded++;
+                            ActDecline(older, "superseded", "a newer START of the same actor (id " + r.Id + ") replaced it in the actor's pending slot");
+                        }
+                    }
+                    if (_actNowMs - r.WaitSinceMs > ActWaitMaxMs)
+                    {
+                        ActDecline(r, "timeout", "it waited " + ActWaitMaxMs + " ms of battle time without a launch");
+                        continue;
+                    }
+                    if (!steady || paused)
+                        continue;                        // parked: launches after the unpause / on the next steady frame
+                    ActRec holder = ActMotionHolder(actor);
+                    if (holder != null)
+                    {
+                        if (!ActPendingAbortDue(r.WaitSinceMs, _actNowMs))
+                            continue;
+                        ActAbort(holder, "pending", true);   // a hard release plus restore (D05), then this one launches
+                        ActWindowCheck(b);
+                    }
+                    ActLaunch(b, r, actor, tar, magic);
+                }
+                catch (Exception ex)
+                {
+                    try
+                    {
+                        if (r.State == ActStRunning)
+                            ActAbort(r, "fault", true);      // registered already: a hard release, never a half-registered record
+                        else if (r.Pending)
+                            ActDecline(r, "fault", "the decision threw " + ex.GetType().Name);
+                    }
+                    catch { }
+                }
+            }
+        }
+
+        // ActDecide over the live state, the actor resolved and the masks mapped.
+        private static Int32 ActDecideNow(FF9StateBattleSystem b, ActRec r, out BTL_DATA actor, out UInt16 tar, out UInt16 magic)
+        {
+            actor = null;
+            tar = 0;
+            magic = 0;
+            ActDecideIn d = new ActDecideIn();
+            d.KnobOff = !ActKnobOn;
+            d.LeverOff = ActLeverOff;
+            d.NoRework = !ActReworkOn;
+            d.EndPresented = EndHudOff;
+            d.Leaving = LeaveRequestedRecently;
+            d.Stale = r.Stale;
+            d.Backlog = r.Backlog;
+            d.CmdNo = r.CmdNo;
+            d.Kind = r.VfxKind;
+            d.MonsterTransform = r.MonsterTransform;
+            d.Running = _actRunning.Count;
+            if (b != null && r.ActorSlot <= 7)
+                actor = ResolveWireUnit(b, r.ActorSlot, r.IsPlayer);
+            d.ActorMissing = actor == null;
+            if (actor != null)
+            {
+                d.ActorHidden = !r.IsPlayer && (_hiddenMask & (1 << r.ActorSlot)) != 0;
+                d.DeadOrDying = (actor.stat.cur & BattleStatus.Death) != 0 || actor.die_seq != 0;
+                d.DieSeq = actor.die_seq;
+                d.ActorLinked = ActLinked(b, actor);
+                d.MonsterTransform |= actor.is_monster_transform;
+                tar = ActMapMask(b, r.TarId);
+                magic = ActMapMask(b, r.MagicCaster);
+            }
+            d.MappedTar = tar;
+            return ActDecide(ref d);
+        }
+
+        // the actor's running replay that still holds its command motion (null = none): a START for it waits
+        private static ActRec ActMotionHolder(BTL_DATA actor)
+        {
+            for (Int32 i = 0; i < _actRunning.Count; i++)
+            {
+                ActRec r = _actRunning[i];
+                if (ReferenceEquals(r.Actor, actor) && r.Cmd != null && r.Cmd.info.cmd_motion)
+                    return r;
+            }
+            return null;
+        }
+
+        private static void ActDecline(ActRec r, String why, String detail)
+        {
+            r.State = ActStDeclined;
+            r.Why = why;
+            r.EndMs = _actNowMs;
+            _actBook.Settle(r);
+            _actDeclined++;
+            _actDeclinedWhy = why;
+            if (why == "stale")
+                _actStale++;
+            else if (why == "backlog")
+                _actBacklog++;
+            if (_actDeclineLogged.Contains(why) || _actDeclineLogged.Count >= 16)
+                return;
+            _actDeclineLogged.Add(why);
+            Log.Message("[NetSync] action replay: declined " + why + " -- id " + r.Id + " slot " + r.ActorSlot + " cmd " + r.CmdNo + " sub "
+                        + r.SubNo + (String.IsNullOrEmpty(detail) ? "" : " (" + detail + ")") + "; its impacts take the legacy route (logged "
+                        + "once per boot per reason; declined=" + _actDeclined + ")");
+        }
+
+        // NOOP (kind none): no clip; its impacts apply at once, the legacy swing skipped. Counted as a decline (`noop`) so every START
+        // is exactly one of started / declined.
+        private static void ActMarkNoop(ActRec r)
+        {
+            r.State = ActStNoop;
+            r.Why = "noop";
+            r.EndMs = _actNowMs;
+            _actBook.Settle(r);
+            _actNoop++;
+            _actDeclined++;
+            _actDeclinedWhy = "noop";
+            if (_actDeclineLogged.Contains("noop"))
+                return;
+            _actDeclineLogged.Add("noop");
+            Log.Message("[NetSync] action replay: noop -- id " + r.Id + " slot " + r.ActorSlot + " cmd " + r.CmdNo + " has no vfx (kind none): "
+                        + "nothing to replay, its impacts apply at once (logged once per boot)");
+        }
+
+        // ============================================================================================ the launch
+        /// <summary>[ff9mapkit netsync s134] ActLaunch (design 3.3.3): a standalone CMD_DATA that never enters SetCommand, EnqueueCommand or
+        /// the queue, built the way SetCommand builds one (btl_cmd.cs:176/:416) from the HOST's body; the host's stance gate; registered
+        /// BEFORE Execute; then the host's own vfx resolution -- kind 3 the host-resolved SpecialEffect, a scripted kind 2 its enemy
+        /// sequence, anything else SelectCommandVfx on this install. No action in runningActions = declined "nosequence".</summary>
+        private static void ActLaunch(FF9StateBattleSystem b, ActRec r, BTL_DATA actor, UInt16 tar, UInt16 magic)
+        {
+            CMD_DATA rc = new CMD_DATA();
+            btl_cmd.ClearCommand(rc);
+            btl_cmd.ClearReflecData(rc);
+            rc.regist = actor;
+            rc.cmd_no = (BattleCommandId)r.CmdNo;
+            rc.sub_no = r.SubNo;
+            rc.SetAAData(btl_util.GetCommandAction(rc));
+            rc.ScriptId = btl_util.GetCommandScriptId(rc);
+            rc.tar_id = tar;
+            rc.magic_caster_id = magic;
+            rc.info.cursor = r.Cursor;
+            rc.info.meteor_miss = (Byte)((r.Info & NetSyncBattle.ActInfoMeteorMiss) != 0 ? 1 : 0);
+            rc.info.short_summon = (Byte)((r.Info & NetSyncBattle.ActInfoShortSummon) != 0 ? 1 : 0);
+            rc.info.cover = (Byte)((r.Info & NetSyncBattle.ActInfoCover) != 0 ? 1 : 0);
+            rc.IsShortRange = btl_util.IsAttackShortRange(rc);
+            rc.PatchedVfx = (SpecialEffect)r.PatchedVfx;
+            rc.info.mode = command_mode_index.CMD_MODE_LOOP;
+            ActWindowCheck(b);                       // a window an earlier abort left open closes (and restores) first
+            if (_actRunning.Count == 0)
+                ActWindowOpen(b);                    // the snapshot BEFORE the stance (animFlag / animSpeed)
+            Boolean stanced = ActStanceGate(actor.bi.player != 0, actor.is_monster_transform, r.CmdNo);
+            if (stanced)
+            {
+                btl_mot.setMotion(actor, BattlePlayerCharacter.PlayerMotionIndex.MP_IDLE_CMD);   // the host's SELECT_VFX waits for CMD stance
+                actor.evt.animFrame = 0;                                                          // (review F7, D08)
+            }
+            r.Cmd = rc;
+            r.Actor = actor;
+            if (_benchShortCircuitOff && NetSyncClient.IsSelfTestRole)
+            {
+                _benchShortCircuitOff = false;       // one-shot: THIS replay's hits fall through
+                r.NoShortCircuit = true;
+                Log.Message("[NetSync] harness: action replay id " + r.Id + " runs WITHOUT the short-circuit -- CALIBRATION: its hits reach "
+                            + "the battle calculator (the tripwire's red; the selftest save only)");
+            }
+            _actByCmd[rc] = r;                       // BEFORE Execute: a same-frame hit already short-circuits
+            ActRecomputeLive();
+            _actRunning.Add(r);
+            r.State = ActStRunning;
+            r.LaunchMs = _actNowMs;
+            r.LaunchWall = Environment.TickCount;
+            _actBook.Settle(r);
+            String fault = null;
+            try
+            {
+                if (r.VfxKind == NetSyncBattle.VfxKindSpecial)
+                    new UnifiedBattleSequencer.BattleAction(UnifiedBattleSequencer.EffectType.SpecialEffect, r.VfxNum).Execute(rc);
+                else if (r.VfxKind == NetSyncBattle.VfxKindEnemy && r.Scripted)
+                    new UnifiedBattleSequencer.BattleAction(UnifiedBattleSequencer.EffectType.EnemySequence, r.VfxNum).Execute(rc);
+                else
+                    btl_vfx.SelectCommandVfx(rc);
+            }
+            catch (Exception ex)
+            {
+                fault = ex.GetType().Name;
+            }
+            r.Action = UnifiedBattleSequencer.runningActions.FindLast(x => ReferenceEquals(x.cmd, rc));
+            if (r.Action == null)
+            {
+                _actRunning.Remove(r);
+                _actByCmd.Remove(rc);
+                ActRecomputeLive();
+                r.Cmd = null;
+                if (stanced)
+                {
+                    try { btl_mot.SetDefaultIdle(actor); }   // the command stance with no command behind it: back to the idle
+                    catch { }
+                }
+                ActDecline(r, "nosequence", "no sequence started on this install" + (fault != null ? " (it threw " + fault + ")" : ""));
+                ActWindowCheck(b);                   // a window this launch opened closes unrestored (nothing ran)
+                return;
+            }
+            _actStarted++;
+            if (_actStartLogged >= ActStartLogMax)
+                return;
+            _actStartLogged++;
+            Log.Message("[NetSync] action replay: started id " + r.Id + " slot " + r.ActorSlot + (r.IsPlayer ? " (player)" : " (enemy)")
+                        + " cmd " + r.CmdNo + " sub " + r.SubNo + " kind " + r.VfxKind + " num " + r.VfxNum + " tar 0x" + tar.ToString("X2")
+                        + " host speed " + r.HostSpeed + (r.Scripted ? " scripted" : "") + " -- " + (_actStartLogged < ActStartLogMax
+                        ? "presentation only (the short-circuit owns every hit)" : "further starts this boot are counted, not logged"));
+        }
+
+        // ============================================================================================ aborts
+        /// <summary>[ff9mapkit netsync s134] A HARD release (D05: never stock Cancel(), whose EffectPoint gate would strand the hit): the
+        /// replay's unplayed SFX are DROPPED (ActDropSfx), the action leaves runningActions now (ActReleaseHard), every Song it started
+        /// stops (ActStopSongs), a targeted camera it ran is noted for the restore (_actWindowCamTarget), the record leaves
+        /// ActOnHit's map -- or, when the sequencer still holds the action, becomes a ZOMBIE that stays short-circuited. The
+        /// restore runs when the busy window closes (ActWindowCheck), or right before an end injection (ActBeforeInject). `release` false = the sequencer already dropped it (a fault). Per-record try: never throws.</summary>
+        private static void ActAbort(ActRec r, String why, Boolean release)
+        {
+            // the stock Loop rule (UnifiedBattleSequencer.Loop): CameraNo returns to 0 only after an action whose targeted PlayCamera
+            // ran (useCameraTarget) -- read BEFORE the release, which resets the action
+            try
+            {
+                if (r.Action != null && r.Action.useCameraTarget)
