+        // One line per boot at its end (teardown): the counters, for a log reader without the harness.
+        private static void ActLogSummary(String why)
+        {
+            if (_actStartsRx == 0 && !_actOldHost && _actCalcWhileBooted == 0)
+                return;
+            Log.Message("[NetSync] action replay: boot summary (" + why + ") -- " + _actStartsRx + " START(s) received, " + _actStarted
+                        + " started, " + _actDeclined + " declined (" + _actStale + " stale, " + _actBacklog + " backlog, " + _actNoop + " noop, "
+                        + _actSuperseded + " superseded), " + _actEnded + " ended, " + _actAborted + " aborted (" + _actFaulted + " faulted), "
+                        + _actHits + " hit(s), " + _actSwingSkipped + " swing(s) skipped; calc_while_booted=" + _actCalcWhileBooted
+                        + (_actOldHost ? "; the host predates action replay" : ""));
