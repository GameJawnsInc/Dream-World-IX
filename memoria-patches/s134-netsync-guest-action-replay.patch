+        private static void ActCheckRunning(FF9StateBattleSystem b)
+        {
+            if (_actRunning.Count == 0)
+                return;
+            ActRec[] run = _actRunning.ToArray();
+            Int32 wall = Environment.TickCount;
+            for (Int32 i = 0; i < run.Length; i++)
+            {
+                ActRec r = run[i];
+                try
+                {
+                    Boolean inLoop = r.Action != null && ReferenceEquals(r.Action.cmd, r.Cmd)
+                                     && UnifiedBattleSequencer.runningActions.Contains(r.Action);
+                    if (!inLoop)
+                    {
+                        if (r.Faulted)
+                            ActAbort(r, "fault", false);
+                        else
+                            ActFinishEnded(r);
+                        continue;
+                    }
+                    String why = ActAbortWhy(!ActLinked(b, r.Actor), r.HostEnded, r.HostEndMs, _actNowMs, wall - r.LaunchWall);
