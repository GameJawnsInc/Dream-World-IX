+        // "hex[,hex...]": each frame 46-4096 bytes of hex digits
+        private static Boolean ActParseHexFrames(String text, out List<Byte[]> frames, out String why)
+        {
+            frames = new List<Byte[]>();
+            why = null;
+            String[] parts = (text ?? "").Split(',');
+            foreach (String raw in parts)
+            {
+                String h = raw.Trim();
+                if (h.Length < NetSyncBattle.ActLegacyLen * 2 || h.Length > 8192 || (h.Length & 1) != 0)
+                {
+                    why = "netsync actbench feed: each frame is an even run of 92-8192 hex digits (46-4096 bytes)";
+                    return false;
+                }
+                Byte[] f = new Byte[h.Length / 2];
+                for (Int32 i = 0; i < f.Length; i++)
+                {
+                    Int32 hi = ActHexDigit(h[2 * i]), lo = ActHexDigit(h[2 * i + 1]);
+                    if (hi < 0 || lo < 0)
+                    {
+                        why = "netsync actbench feed: '" + h[2 * i] + h[2 * i + 1] + "' is not hex";
+                        return false;
+                    }
+                    f[i] = (Byte)(hi << 4 | lo);
+                }
+                frames.Add(f);
+            }
+            return frames.Count > 0;
+        }
+
+        private static Int32 ActHexDigit(Char c)
+        {
+            if (c >= '0' && c <= '9') return c - '0';
+            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+            if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+            return -1;
+        }
