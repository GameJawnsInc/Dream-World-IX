+                return;
+            _actHoldsSeen = holds;
+            if (_actRunning.Count == 0)
+                return;
+            _actHoldThrough++;
+            if (_actHoldCounted)
+                return;
+            _actHoldCounted = true;
+            Log.Message("[NetSync] action replay: " + _actRunning.Count + " replay(s) run on through the diorama hold (the reconciler is "
+                        + "frozen, the sequencer is not; hold_through=" + _actHoldThrough + "; logged once per boot)");
+        }
+
+        private static void ActExpireGraces()
+        {
+            if (_actGraceMask == 0)
+                return;
+            for (Int32 i = 0; i < 8; i++)
+                if ((_actGraceMask & (1 << i)) != 0 && _actNowMs >= _actGraceUntil[i])
+                    _actGraceMask &= ~(1 << i);
