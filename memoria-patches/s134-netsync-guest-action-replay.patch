+                Boolean paused = ActPausedNow(b);
+                Int32 tick = Environment.TickCount;
+                Int32 delta = tick - _actClockLast;
+                _actNowMs += ActBattleDelta(delta, _actClockPaused, paused);
+                if (_actClockPaused && paused && delta > 0)
