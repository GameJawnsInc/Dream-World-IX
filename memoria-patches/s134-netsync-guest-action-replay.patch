+            r.State = ActStAborted;
+            r.Why = why;
+            r.EndMs = _actNowMs;
+            _actRunning.Remove(r);
+            if (r.Cmd != null)
+            {
+                _actByCmd.Remove(r.Cmd);
+                if (!outOfLoop)
+                    ActZombie(r);
+            }
+            ActRecomputeLive();
+            _actAborted++;
+            _actAbortWhy = why;
+            Int32 k = Array.IndexOf(ActAbortReasons, why);
+            if (k >= 0)
+                _actAbortsBy[k]++;
+            if (why == "fault")
+                _actFaulted++;
+            _actWindowAborted = true;
+            if (_actAbortLogged >= ActAbortLogMax)
+                return;
+            _actAbortLogged++;
+            Log.Message("[NetSync] action replay: ABORTED id " + r.Id + " slot " + r.ActorSlot + " cmd " + r.CmdNo + " (" + why + ") after "
+                        + (r.LaunchMs >= 0 ? (_actNowMs - r.LaunchMs) + " ms of battle time" : "no launch") + ", " + r.Hits + " hit(s) -- a hard "
+                        + "release" + (_endInjected ? " (the end presentation owns the units: no per-unit restore)" : " plus the busy-window restore")
+                        + (_actAbortLogged == ActAbortLogMax ? "; further aborts this boot are counted, not logged" : ""));
+        }
+
+        /// <summary>[ff9mapkit netsync s134] The hard release proper: the action's unplayed SFX dropped (ActDropSfx), then -- `release`
+        /// -- ReleaseRunningAction; a release that threw half-way (an SFX End: it Ends meshes BEFORE it nulls cmd and removes the
+        /// action) is completed by a plain Remove (the mesh may leak; the containment law holds). True = the sequencer no longer
+        /// holds the action (or never did); false = it still does: the caller keeps its CMD_DATA short-circuited (ActZombie).
+        /// Never throws.</summary>
+        private static Boolean ActReleaseHard(UnifiedBattleSequencer.BattleAction a, Boolean release)
+        {
+            if (a == null)
+                return true;
+            ActDropSfx(a);
+            if (release)
+            {
+                try
+                {
+                    Int32 at = UnifiedBattleSequencer.runningActions.IndexOf(a);
+                    if (at >= 0)
