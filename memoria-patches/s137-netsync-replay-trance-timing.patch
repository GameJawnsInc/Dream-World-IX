+        private static void ActTranceReset(Boolean counters)
+        {
+            _trPendMask = 0;
+            for (Int32 i = 0; i < 4; i++)
+            {
+                _trRecordMs[i] = -1;
+                _trBusyMs[i] = -1;
+                _trWant[i] = false;
+                _trHitMs[i] = -1;
+                _trDeclineMs[i] = -1;
+                _trEndMs[i] = -1;
+            }
+            _trCatchUpSinceMs = -1;
+            _trApplySinceMs = -1;
