+        internal static Boolean ActTranceDefers(Boolean bit5, Boolean canReplay, Boolean graceOn)
+        {
+            return bit5 && canReplay && graceOn;
+        }
+
+        /// <summary>[ff9mapkit netsync s137] A BURST record (pure): a SysTrans of a PLAYER wire slot 0-3 (an enemy wears no trance model;
