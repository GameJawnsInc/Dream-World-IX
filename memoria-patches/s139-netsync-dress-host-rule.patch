+        private static Boolean SlotsAlike(NetSyncParty.Slot x, NetSyncParty.Slot y)
+        {
+            if (x.Present != y.Present || x.CharId != y.CharId || x.Serial != y.Serial || x.Level != y.Level || x.Row != y.Row
+                || x.CurHp != y.CurHp || x.MaxHp != y.MaxHp || x.CurMp != y.CurMp || x.MaxMp != y.MaxMp || x.Name != y.Name
+                || x.BasisMaxHp != y.BasisMaxHp || x.BasisMaxMp != y.BasisMaxMp || x.Dex != y.Dex || x.Str != y.Str || x.Mgc != y.Mgc
+                || x.Wpr != y.Wpr || x.BasisMaxCapa != y.BasisMaxCapa || x.Status != y.Status || x.Trance != y.Trance)
+                return false;
+            return SeqEqual(x.Equip, y.Equip) && SeqEqual(x.SaIds, y.SaIds);
+        }
+
+        private static Boolean SeqEqual<T>(T[] a, T[] b)
+        {
+            if (a == null || b == null)
+                return a == null && b == null;
+            if (a.Length != b.Length)
+                return false;
+            for (Int32 i = 0; i < a.Length; i++)
+                if (!a[i].Equals(b[i]))
+                    return false;
+            return true;
+        }
+
+        private static Boolean BytesEqual(Byte[] a, Byte[] b)
+        {
+            return a != null && b != null && a.Length == b.Length && BytesEqualRange(a, b, a.Length);
+        }
+
+        private static Boolean BytesEqualRange(Byte[] a, Byte[] b, Int32 count)
+        {
+            if (a == null || b == null || a.Length < count || b.Length < count)
+                return false;
+            for (Int32 i = 0; i < count; i++)
+                if (a[i] != b[i])
+                    return false;
+            return true;
+        }
+
+        private static Boolean BytesAre(Byte[] b, params Byte[] want)
+        {
+            return BytesEqual(b, want);
+        }
