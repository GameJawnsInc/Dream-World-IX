+        // The type-5 frame codec a peer's transport runs (NetSyncWire.BuildFrame / TryParseHeader), as NetSyncState.SelfTest does it.
+        private static Byte[] WireRoundTrip(Byte[] payload)
+        {
+            Byte[] frame = NetSyncWire.BuildFrame(NetSyncWire.TypeState, payload);
+            Byte type;
+            Int32 len;
+            if (!NetSyncWire.TryParseHeader(frame, out type, out len) || type != NetSyncWire.TypeState || len != payload.Length
+                || frame.Length != NetSyncWire.HeaderSize + len)
+                return null;
+            Byte[] received = new Byte[len];
+            Array.Copy(frame, NetSyncWire.HeaderSize, received, 0, len);
+            return received;
+        }
