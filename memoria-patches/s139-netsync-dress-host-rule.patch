+        // ParseSections over two frames, the party it lands compared slot for slot -- and its OTHER half, sections 2-3, through the read an
+        // old guest's event VM makes of them (NetSyncParty.TryItemCount, the B_HAVE_ITEM wrap), asked while each parse is live for every
+        // item in my bag, every key item I hold and one I do not. The mirror's statics are a live guest's, so a live (or bench-armed)
+        // mirror fails closed; each parse is followed by Clear() (a selftest machine never stays MirrorActive).
+        private static Boolean PartyParsesAlike(Byte[] a, Byte[] b)
+        {
+            if (a == null || b == null || NetSyncParty.MirrorActive || NetSyncParty.BenchMirrorArmed)
+                return false;
+            try
+            {
+                Int32[] items = ItemProbeIds();
+                Boolean gotA = NetSyncParty.ParseSections(a);
+                NetSyncParty.Slot[] slotsA = (NetSyncParty.Slot[])NetSyncParty.Slots.Clone();
+                Int32[] countsA = ItemCountsNow(items);
+                NetSyncParty.Clear();
+                Boolean gotB = NetSyncParty.ParseSections(b);
+                NetSyncParty.Slot[] slotsB = (NetSyncParty.Slot[])NetSyncParty.Slots.Clone();
+                Int32[] countsB = ItemCountsNow(items);
+                NetSyncParty.Clear();
+                if (!gotA || !gotB)
+                    return false;
+                for (Int32 i = 0; i < 4; i++)
+                    if (!SlotsAlike(slotsA[i], slotsB[i]))
+                        return false;
+                return SeqEqual(countsA, countsB);
+            }
+            finally
+            {
+                NetSyncParty.Clear();
+            }
+        }
