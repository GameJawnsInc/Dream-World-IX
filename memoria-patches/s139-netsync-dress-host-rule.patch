+        // The item ids the mirror's B_HAVE_ITEM wrap is probed with: every regular item in my live bag, every key item I hold, and one
+        // key item I do not (its 0 must survive too).
+        private static Int32[] ItemProbeIds()
+        {
+            System.Collections.Generic.List<Int32> ids = new System.Collections.Generic.List<Int32>();
+            FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+            if (ff9 != null && ff9.item != null)
+                foreach (FF9ITEM item in ff9.item)
+                    if (item != null && item.count > 0)
+                        ids.Add(ff9item.GetItemIdFromRegularId(item.id));
+            Int32 absent = -1;
+            if (ff9 != null && ff9.rare_item_obtained != null)
+            {
+                foreach (Int32 rare in ff9.rare_item_obtained)
+                    ids.Add(ff9item.GetItemIdFromImportantId(rare));
+                for (Int32 r = 0; r < 256 && absent < 0; r++)
+                    if (!ff9.rare_item_obtained.Contains(r))
+                        absent = r;
+            }
+            ids.Add(ff9item.GetItemIdFromImportantId(absent < 0 ? 0 : absent));
+            return ids.ToArray();
+        }
+
+        // What TryItemCount answers for each id right now (-1 = it declined: no mirror, or a card).
+        private static Int32[] ItemCountsNow(Int32[] ids)
+        {
+            Int32[] counts = new Int32[ids.Length];
+            for (Int32 i = 0; i < ids.Length; i++)
+            {
+                Int32 c;
+                counts[i] = NetSyncParty.TryItemCount(ids[i], out c) ? c : -1;
+            }
+            return counts;
+        }
