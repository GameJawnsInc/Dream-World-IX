+        // ResolveAuto's row table (amendment 6; owner D2's first rule), run against a resolver: null when every row holds, else the
+        // first failing row's name. The production rule must pass it; each mutant must fail it.
+        private static String DressAutoTable(DressAutoRule rule)
+        {
+            if (!AutoIs(rule, 0, true, DressParty4, 220, 8)) return "mask 0 -> the moogle on the host / selftest (owner D2)";
+            if (!AutoIs(rule, 0, false, DressParty4, 0, -1)) return "mask 0 -> undressed on a client";
+            if (!AutoIs(rule, 2, true, DressParty4, 8, 1)) return "slot 1 named -> its member (Vivi, 8)";
+            if (!AutoIs(rule, 1, true, DressParty4, 98, 0)) return "slot 0 named -> Zidane (98)";
+            if (!AutoIs(rule, 6, true, new Int32[] { 0, -1, 2, -1 }, 185, 2)) return "an empty first named slot -> the next named member";
+            if (!AutoIs(rule, 6, true, new Int32[] { 0, -1, -1, -1 }, 220, 8)) return "every named slot empty -> the moogle (host / selftest)";
+            if (!AutoIs(rule, 6, false, new Int32[] { 0, -1, -1, -1 }, 0, -1)) return "every named slot empty -> undressed on a client";
+            if (!AutoIs(rule, 2, true, new Int32[] { 0, 8, -1, -1 }, 0, -1)) return "Cinna (CharacterId 8) -> undressed, never the moogle row";
+            if (!AutoIs(rule, 2, true, new Int32[] { 0, 10, -1, -1 }, 0, -1)) return "Blank (10) -> undressed";
+            if (!AutoIs(rule, 2, true, new Int32[] { 0, 12, -1, -1 }, 0, -1)) return "a custom character (12) -> undressed";
+            if (!AutoIs(rule, 6, true, new Int32[] { 0, 8, 1, -1 }, 0, -1)) return "the first OCCUPIED named slot decides (Cinna before Vivi)";
+            if (!AutoIs(rule, 0x12, true, DressParty4, 8, 1)) return "bits above slot 3 are no party slots";
+            if (!AutoIs(rule, 6, true, new Int32[] { 0, -1, -2, -1 }, 0, -1)) return "an UNREADABLE named slot (-2) -> undressed, never the moogle";
+            if (!AutoIs(rule, 2, true, null, 0, -1)) return "no party read -> unreadable: undressed, never the moogle";
+            return null;
+        }
