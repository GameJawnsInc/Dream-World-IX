+        // TryReadSection of one id on two frames answers the same (found or not; the same body when found).
+        private static Boolean SameRead(Byte[] a, Byte[] b, Byte sectionId)
+        {
+            Byte[] x, y;
+            Boolean gotX = NetSyncState.TryReadSection(a, sectionId, out x);
+            Boolean gotY = NetSyncState.TryReadSection(b, sectionId, out y);
+            return gotX == gotY && (!gotX || BytesEqual(x, y));
+        }
