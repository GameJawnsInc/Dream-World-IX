+                        return false;
+                }
+            return true;
+        }
+
+        private delegate Int32 SkipRuleFn(Boolean selfTestRole, Boolean clientRole, Boolean mirroring);
+
+        private static String SkipTable(SkipRuleFn rule)
+        {
+            if (rule(true, false, false) != SkipSelfTest || rule(true, true, true) != SkipSelfTest)
+                return "the selftest role arms itself (ArmBench)";
+            if (rule(false, true, true) != SkipKeep)
+                return "a client mirroring keeps the last arm (sticky through a blip)";
+            if (rule(false, true, false) != SkipDisarm)
+                return "a client not mirroring disarms (not mirroring, B26)";
+            if (rule(false, false, true) != SkipDisarmQuiet || rule(false, false, false) != SkipDisarmQuiet)
+                return "a host disarms silently, mirroring or not";
+            return null;
+        }
+
+        private static Int32 MutantNeverSticky(Boolean selfTestRole, Boolean clientRole, Boolean mirroring)
+        {
+            return selfTestRole ? SkipSelfTest : clientRole ? SkipDisarm : SkipDisarmQuiet;
+        }
+
+        private static Int32 MutantStickyAnyRole(Boolean selfTestRole, Boolean clientRole, Boolean mirroring)
+        {
+            return selfTestRole ? SkipSelfTest : mirroring ? SkipKeep : clientRole ? SkipDisarm : SkipDisarmQuiet;
+        }
+
+        // A lazy read that records whether the order reached it.
+        private sealed class Probe
+        {
+            private readonly Boolean _value;
+            public Boolean Asked;
+            public Probe(Boolean value) { _value = value; }
+            public Boolean Get() { Asked = true; return _value; }
+        }
+
+        private delegate Int32 DressOrderRule(Boolean armed, UInt16 asked, Boolean clientOrSelfTest, Func<Boolean> excluded, Boolean gateOn,
+                                              Func<Boolean> definesPlayer, Func<Boolean> otherDressedCtl);
+
+        private static String DressOrderTable(DressOrderRule rule)
+        {
+            if (rule(false, 98, true, new Probe(false).Get, true, new Probe(true).Get, new Probe(false).Get) != DressNone)
+                return "unarmed (SelfDress=0 reads unarmed) -> nothing";
+            if (rule(true, 220, true, new Probe(false).Get, true, new Probe(true).Get, new Probe(false).Get) != DressNone)
+                return "a non-98 model -> nothing";
+            if (rule(true, 98, false, new Probe(false).Get, true, new Probe(true).Get, new Probe(false).Get) != DressNone)
+                return "a host never dresses itself";
+            Probe def = new Probe(false), ctl = new Probe(true);
+            if (rule(true, 98, true, new Probe(true).Get, true, def.Get, ctl.Get) != DressExcluded || def.Asked || ctl.Asked)
+                return "the exclusion first: a skip asking neither the gate nor the control";
+            def = new Probe(false);
+            ctl = new Probe(true);
+            if (rule(true, 98, true, new Probe(false).Get, true, def.Get, ctl.Get) != DressSkipNpc || !def.Asked || ctl.Asked)
+                return "the player gate BEFORE the control check: an NPC twin is skip_npc, never skip_second";
+            if (rule(true, 98, true, new Probe(false).Get, true, new Probe(true).Get, new Probe(true).Get) != DressSkipSecond)
+                return "a second player Zidane under a dressed control char -> skip_second";
+            if (rule(true, 98, true, new Probe(false).Get, true, new Probe(true).Get, new Probe(false).Get) != DressYes)
+                return "the player's own entry -> dressed";
+            def = new Probe(false);
+            if (rule(true, 98, true, new Probe(false).Get, false, def.Get, new Probe(false).Get) != DressYes || def.Asked)
+                return "gate 0 dresses the twin without parsing it (N2)";
+            if (rule(true, 98, true, new Probe(false).Get, false, new Probe(false).Get, new Probe(true).Get) != DressSkipSecond)
+                return "gate 0: the control check still holds";
+            return null;
+        }
+
+        private static Int32 MutantCtlFirst(Boolean armed, UInt16 asked, Boolean clientOrSelfTest, Func<Boolean> excluded, Boolean gateOn,
+                                            Func<Boolean> definesPlayer, Func<Boolean> otherDressedCtl)
+        {
+            if (!armed || asked != NetSyncVisitor.PlainZidaneModel || !clientOrSelfTest)
+                return DressNone;
+            if (excluded())
+                return DressExcluded;
+            if (otherDressedCtl())
+                return DressSkipSecond;                     // the control check FIRST (the order review dress F5 refused)
+            if (gateOn && !definesPlayer())
+                return DressSkipNpc;
+            return DressYes;
+        }
+
+        // ---------------------------------------------------------------- the fault log (the first few only; the counter is the record)
+        private const Int32 FaultLogMax = 8;
+        private static Int32 _faultsLogged;
+
+        private static void LogFault(String where, Exception err)
+        {
+            if (_faultsLogged >= FaultLogMax)
+                return;
+            _faultsLogged++;
+            Log.Message("[NetSync] self-dress fault at " + where + " (caught; the stock path continues): " + err.GetType().Name + ": "
+                        + err.Message + (_faultsLogged == FaultLogMax ? " -- further faults are counted, not logged" : ""));
+        }
+    }
+}
