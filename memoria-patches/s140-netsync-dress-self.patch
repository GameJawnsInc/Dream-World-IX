+        // ================================================================ THE ANIMS
+        // ONE call per stock setter / RunAnimation site, after the case's stock code; the caller gates on netSelfDress != 0.
+        // Returns the id to store / play (the raw id when it is unchanged): MapAnim's -- the map SelfTest's body row proves, keyed
+        // on BodyRig -- then attaches the mapped clip. Never throws: a fault counts and returns the SITE's own fallback
+        // (SiteFallback, attached in its own try) on a dressed body, the raw id otherwise (amendment 9).
+        internal static Int32 MapAndAttach(Actor actor, Int32 raw, Int32 site)
+        {
+            Int32 rigIdx = -1;
+            try
+            {
+                rigIdx = BodyRig(actor);
+                Int32 mapped = MapAnim(actor, raw, site);
+                if (mapped != raw)
+                {
+                    Remaps++;
