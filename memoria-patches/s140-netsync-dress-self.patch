+        // THE JUMP SLOT's setter (SetJumpAnimation and SetLogicalAnimationEx kind 6, after the stock code): the RAW id kept in
+        // PosObj.netJumpSrc (the source timeline KeepJumpTimeline restores), the slot stored mapped (the idle alias, amendment
+        // 10). Never throws.
+        internal static Int32 AtJumpSlot(Actor actor, Int32 raw)
+        {
