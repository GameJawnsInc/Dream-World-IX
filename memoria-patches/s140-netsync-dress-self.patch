+                case 3: actor.turnl = (UInt16)MapAndAttach(actor, raw, SiteTurnL); break;
+                case 4: actor.turnr = (UInt16)MapAndAttach(actor, raw, SiteTurnR); break;
+                case 5: actor.sleep = (UInt16)MapAndAttach(actor, raw, SiteSleep); break;
+                case 6: actor.jump = (UInt16)AtJumpSlot(actor, raw); break;
+            }
+        }
