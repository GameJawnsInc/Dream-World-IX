+        // ---------------------------------------------------------------- EntryDefinesPlayer (amendment 8)
+        // True when the entry's script runs DefinePlayerCharacter (0x2C) in any function. Cached per entry in an SByte[] (-1
+        // unknown, 0, 1) OWNED by the current ee.allObjsEBData reference (rebuilt on every StartEvents) -- never keyed on an
+        // obj.ebData or a per-entry array (Obj.copy deep-copies ebData; .NET 3.5 has no ConditionalWeakTable). The entry's slice is
+        // parsed entry-relative (funcPos is relative to the function table); a parse that throws (Memoria's ops 0x112-0x11E are
+        // past the parser's table) answers by the character band sid >= sSourceObjN - 9 and counts parse_fallback.
+        private static Byte[][] _defOwner;
+        private static SByte[] _defCache;
+
+        internal static Boolean EntryDefinesPlayer(EventEngine ee, Int32 sid)
+        {
+            Byte[][] all = ee.allObjsEBData;
+            if (all == null || sid < 0 || sid >= all.Length)
+            {
+                ParseFallback++;
+                return sid >= ee.sSourceObjN - 9;
+            }
+            if (!ReferenceEquals(all, _defOwner) || _defCache == null || _defCache.Length != all.Length)
+            {
+                _defOwner = all;
+                _defCache = new SByte[all.Length];
+                for (Int32 i = 0; i < _defCache.Length; i++)
+                    _defCache[i] = -1;
+            }
+            if (_defCache[sid] >= 0)
+                return _defCache[sid] == 1;
+            Boolean defines;
+            try
+            {
+                defines = ParseDefinesPlayer(all[sid], sid);
+            }
+            catch
+            {
+                ParseFallback++;
+                defines = sid >= ee.sSourceObjN - 9;
+            }
+            _defCache[sid] = (SByte)(defines ? 1 : 0);
+            return defines;
+        }
+
+        // Pure: does this entry slice contain a 0x2C (DefinePlayerCharacter)? Throws on a slice the parser cannot read.
+        internal static Boolean ParseDefinesPlayer(Byte[] raw, Int32 sid)
+        {
+            if (raw == null || raw.Length == 0)
+                return false;
+            UInt32 pos = 0;
+            EventEngineUtils.BinaryScript.Entry entry = new EventEngineUtils.BinaryScript.Entry(raw, ref pos, (Byte)sid, 0, 0, (UInt32)raw.Length);
+            foreach (EventEngineUtils.BinaryScript.Entry.Function f in entry.functions)
+                foreach (EventEngineUtils.BinaryScript.Entry.Function.Code c in f.codes)
+                    if (c.opcode == (UInt16)EBin.event_code_binary.CC)
+                        return true;
+            return false;
+        }
