+        // A caught map / attach fault's answer: the site's own slot-law fallback (SiteFallback, the alias law on -- never the
+        // alias in a stand / walk / run / turn / sleep slot: amendment 4), attached in its own try (null-name safe: AttachId);
+        // the raw id when the rig is unknown. Never throws.
+        private static Int32 FaultFallback(Actor actor, Int32 rigIdx, Int32 raw, Int32 site)
+        {
+            NetSyncVisitor.Rig rig;
+            if (!NetSyncVisitor.TryGetRig(rigIdx, out rig))
+                return raw;
