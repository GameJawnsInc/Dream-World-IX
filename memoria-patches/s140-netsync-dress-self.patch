+        // THE SITE'S FALLBACK (pure; MapRigAnim's gesture fallback and MapAndAttach's fault answer): 0 = none in the sleep slot
+        // (D3: the engine's own p.sleep == 0); the idle ALIAS on RunAnimation and in the jump slot (amendment 4 -- alias law off:
+        // the slot id, its red); the rig's idle in a stand / walk / run / turn slot (a slot plays native, and the idle slot must
+        // never hold the alias a gesture plays).
+        internal static Int32 SiteFallback(NetSyncVisitor.Rig rig, Int32 site, Boolean aliasLaw)
+        {
+            if (site == SiteSleep)
+                return 0;
+            if (site == SitePlay || site == SiteJump)
+                return aliasLaw ? rig.IdleAlias : rig.Idle;
+            return rig.Idle;
+        }
+
+        // THE BODY'S RIG (amendment 5): Rigs[body.netSelfDress - 1], -1 for an undressed body or none -- the ONE place a hook
+        // resolves a rig (MapAnim, MapAndAttach, KeepSourceTimeline, BFrame, AttachDress, the defence branch, the harness `rig`).
+        // Never the arm's WantRig: a re-arm to another rig (a host party change between the field load and a battle) never feeds
+        // rig B's ids to a rig-A body, and a Clear() never collapses its anims. Pure; never throws.
+        internal static Int32 BodyRig(PosObj body)
+        {
+            return body != null && body.netSelfDress != 0 ? body.netSelfDress - 1 : -1;
+        }
+
+        // MapAnim keyed on the BODY (amendment 5: BodyRig) -- the map every stock-site hook stores / plays (MapAndAttach calls
+        // it). Pure (no attach); an undressed body returns the id unchanged.
+        internal static Int32 MapAnim(PosObj body, Int32 id, Int32 site)
+        {
+            Int32 rigIdx = BodyRig(body);
+            if (rigIdx < 0)
+                return id;
+            return MapRigAnim(rigIdx, id, site, LawOn(LawAlias));
+        }
+
+        // True when `id`, played on the rig, runs on a LOCO family's NATIVE timeline (a slot clip, or the rig's own break clip):
+        // the only ids the B_FRAME law remaps. False for the rig's own clips (stock already answers them) and every gesture.
+        internal static Boolean IsLocoFamily(Int32 rigIdx, Int32 id)
+        {
+            NetSyncVisitor.Rig rig;
+            if (!NetSyncVisitor.TryGetRig(rigIdx, out rig))
+                return false;
+            String name;
+            if (!FF9DBAll.AnimationDB.TryGetValue(id, out name) || IsOwnClip(rigIdx, name))
+                return false;
+            Byte c = LocoClassOf(name);
+            if (c >= LocoClassIdle && c <= LocoClassTurnR)
+                return true;
+            return c == LocoClassInactive && rig.Inactive != 0;
+        }
+
+        // ================================================================ CALIBRATION LEVERS (selftest only; O6)
+        internal const Int32 LawBFrame = 1, LawAttach = 2, LawAlias = 4, LawTimeline = 8;
+        private static readonly String[] LawNames = { "bframe", "attach", "alias", "timeline" };
+        private static Int32 _lawOff;                  // the laws switched OFF by `selfdress law <name> off` (bits above)
+        private static Boolean _benchGateOff;          // `selfdress gate 0`: the player gate skipped (N2)
+        private static String _benchSelf;              // `selfdress self ...`: null = never set (no section 8) | "off" | "auto" | a NameToRig name
+        private static Int32 _benchSelfMask = -1;      // `self auto <mask>`; -1 = the live GuestSlots (the selftest pin 0: the moogle)
+
+        // A law is ON unless the selftest role switched it off (a lever never acts on a client).
+        internal static Boolean LawOn(Int32 law)
+        {
+            return LawOnRule(_lawOff, law, NetSyncClient.IsSelfTestRole);
+        }
+
+        internal static Boolean LawOnRule(Int32 lawOff, Int32 law, Boolean selfTestRole)   // pure (SelfTest pins it)
+        {
+            return (lawOff & law) == 0 || !selfTestRole;
+        }
+
+        // The player gate (Gate && !EntryDefinesPlayer -> skip_npc): on unless the selftest role's `gate 0`.
+        internal static Boolean GateOn
+        {
+            get { return !_benchGateOff || !NetSyncClient.IsSelfTestRole; }
+        }
+
+        // THE `self` NAMES -- exactly NetSyncVisitor's NameToRig keys (SelfTest pins it: every one resolves to its row and they cover
+        // the table), in the table's order: the kit's coop.GHOST_NAMES and the harness op list follow this list.
+        internal static readonly String[] SelfNames =
+        {
+            "zidane", "vivi", "garnet", "dagger", "steiner", "freya", "quina", "eiko", "amarant", "salamander", "moogle",
+            "cinna", "marcus", "blank", "beatrix",
+        };
+
+        // The `self` op's usage (the refusal of a malformed `self`): the spec forms and the names.
+        internal static String SelfUsage
+        {
+            get { return "netsync selfdress self: expected `self off|auto [mask 0-15]|<name>|moogle` (names: " + String.Join(" ", SelfNames) + ")"; }
+        }
+
+        // `selfdress self <spec> [mask]` (the caller checks the role): off | auto [mask 0-15] | a NameToRig name (SelfNames: zidane ..
+        // amarant, dagger, salamander, moogle, cinna, marcus, blank, beatrix). False + why on anything else; nothing changes then.
+        internal static Boolean TrySetBenchSelf(String spec, Int32 autoMask, out String why)
+        {
+            why = null;
+            String s = NetSyncVisitor.DressMode(spec);
+            if (s == "off")
+            {
+                if (autoMask >= 0)
+                {
+                    why = "netsync selfdress self off: takes no mask";
+                    return false;
+                }
+            }
+            else if (s == "auto")
+            {
+                if (autoMask > 0x0F)
+                {
+                    why = "netsync selfdress self auto: mask " + autoMask + " is outside 0-15 (party slots 0-3)";
+                    return false;
+                }
+            }
+            else
+            {
+                Int32 rig;
+                if (autoMask >= 0 || s.Length == 0 || NetSyncVisitor.ResolveNamed(s, NetSyncVisitor.RigCount, out rig) == 0)
+                {
+                    why = SelfUsage;
+                    return false;
+                }
+            }
+            _benchSelf = s;
+            _benchSelfMask = s == "auto" ? autoMask : -1;
+            Log.Message("[NetSync] harness: selfdress self " + HarnessBenchSelf + " -- the selftest arm at the next field load (section 8 "
+                        + "through the real encoder and reader)");
+            return true;
+        }
+
+        // `selfdress gate 1|0` (the caller checks the role).
+        internal static void SetBenchGate(Boolean on)
+        {
+            _benchGateOff = !on;
+            Log.Message("[NetSync] harness: selfdress gate " + (on ? "1 -- the player gate (EntryDefinesPlayer) runs"
+                                                                   : "0 -- CALIBRATION: the player gate is skipped (an NPC Zidane dresses too)"));
+        }
+
+        // `selfdress law <bframe|attach|alias|timeline> on|off` (the caller checks the role). False + why on an unknown law.
+        internal static Boolean TrySetLaw(String law, Boolean on, out String why)
+        {
+            why = null;
+            String l = NetSyncVisitor.DressMode(law);
+            for (Int32 i = 0; i < LawNames.Length; i++)
+            {
+                if (LawNames[i] != l)
+                    continue;
+                Int32 bit = 1 << i;
+                if (on)
+                    _lawOff &= ~bit;
+                else
+                    _lawOff |= bit;
+                Log.Message("[NetSync] harness: selfdress law " + l + (on ? " on" : " OFF -- CALIBRATION: that s140 law is switched off "
+                            + "on this selftest role"));
+                return true;
+            }
+            why = LawUsage;
+            return false;
+        }
+
+        internal const String LawUsage = "netsync selfdress law: expected `law bframe|attach|alias|timeline on|off`";
+
+        // Every s140 selfdress lever off (never throws); a bench-made arm is cleared too (never a live body: the teardown law).
+        // Called by NetSyncClient.HarnessReleaseDress, i.e. NetSyncBattle.HarnessReleaseBench -- every HarnessSelfTest(false)
+        // path (disarm, fault, `reset`) -- and `selfdress clear`.
+        internal static void ReleaseBench(String cause)
+        {
+            Boolean any = _benchSelf != null || _benchSelfMask >= 0 || _benchGateOff || _lawOff != 0;
+            _benchSelf = null;
+            _benchSelfMask = -1;
+            _benchGateOff = false;
+            _lawOff = 0;
+            try
+            {
+                if (From == "bench")
+                    Clear(cause);
+                if (any)
+                    Log.Message("[NetSync] harness: selfdress self / gate / law levers released (" + cause + ")");
+            }
+            catch
+            {
+                Faults++;
+            }
+        }
+
+        // Read-backs for `netsync.dress.self` (the harness stage publishes them).
+        internal static String HarnessBenchSelf      // null = never set; "off" | "auto" | "auto <mask>" | a name
+        {
+            get { return _benchSelf == "auto" && _benchSelfMask >= 0 ? "auto " + _benchSelfMask : _benchSelf; }
+        }
+        internal static String HarnessLawsOff        // "" = every law on; else the switched-off laws, comma-joined in a fixed order
+        {
+            get
+            {
+                String s = "";
+                for (Int32 i = 0; i < LawNames.Length; i++)
+                    if ((_lawOff & (1 << i)) != 0)
+                        s += (s.Length > 0 ? "," : "") + LawNames[i];
+                return s;
+            }
+        }
+        internal static Boolean HarnessLawOff(String law)   // `law <name> off` AS SET (the lever's bit; it acts on the selftest role only)
+        {
+            Int32 i = Array.IndexOf(LawNames, NetSyncVisitor.DressMode(law));
+            return i >= 0 && (_lawOff & (1 << i)) != 0;
+        }
+
+        // The controlled body (the dress keys `src`, `rig`, `net_byte` read it -- amendment 5: from the BODY); null = none.
+        internal static PosObj HarnessBody()
+        {
+            try
+            {
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                return ee != null ? ee.GetControlChar() : null;
+            }
+            catch
+            {
+                return null;
+            }
+        }
+        internal static Int32 HarnessBodySrc { get { PosObj p = HarnessBody(); return p != null ? (Int32)p.netDressSrc : -1; } }
+        internal static Int32 HarnessBodyNetByte { get { PosObj p = HarnessBody(); return p != null ? (Int32)p.netSelfDress : -1; } }
+        internal static Int32 HarnessBodyRig { get { return BodyRig(HarnessBody()); } }
+
+        // ================================================================ ARMING
+        // Every field load (NetSyncClient.ApplyStoryBeforeEvents, before the apply): the per-load flags back to "nothing seen".
+        internal static void OnFieldLoad()
+        {
+            _loadHasDress = false;
+            _loggedSkipNpc = _loggedSkipSecond = _loggedCtl = _loggedExcluded = _loggedSticky = false;
+        }
+
+        // The ApplyStory SUCCESS branch (a client): the host's section 8, through the real reader.
+        public static void ArmFromState(Byte[] hostPayload)
+        {
+            try
+            {
+                ArmFromStateCore(hostPayload, "host");
+            }
+            catch (Exception err)
+            {
+                Faults++;
+                Disarm("fault");
+                LogFault("arm", err);
+            }
+        }
+
+        private static void ArmFromStateCore(Byte[] payload, String from)
+        {
+            From = from;
+            Int32 model, charId, rig;
+            String reason = ArmDecision(payload, out model, out charId, out rig);
+            WantModel = model;
+            WantChar = charId;
+            WantRig = rig;
+            if (reason == WhyArmed)
+            {
+                _arm = true;
+                Why = WhyArmed;
+                LogArm();
+            }
+            else
+                Disarm(reason);
+        }
+
+        internal const String WhyArmed = "armed";
+
+        // THE ARM DECISION (pure; SelfTest runs it on real bytes): section 8 of `payload` through the REAL readers (NetSyncState.
+        // TryReadSection + NetSyncVisitor.TryParseDressSection) -> WhyArmed or the disarm reason, in amendment 7's order. model /
+        // charId / rig as read (-1 = no section 8 read: absent, or a body under 3 bytes). It takes no knob and no field: neither is
+        // an arm state (amendment 6) -- the knob gates Armed, the exclusion is a SetModel-time skip.
+        internal static String ArmDecision(Byte[] payload, out Int32 model, out Int32 charId, out Int32 rig)
+        {
+            model = charId = rig = -1;
+            Byte[] body;
+            if (!NetSyncState.TryReadSection(payload, NetSyncVisitor.SectionDress, out body) || body == null)
+                return "section absent";
+            UInt16 m;
+            Byte c;
+            if (!NetSyncVisitor.TryParseDressSection(body, out m, out c))   // refuses fewer than 3 bytes; a longer body reads forward
+                return "section8_len";
+            model = m;
+            charId = c;
+            rig = m != 0 ? NetSyncVisitor.RigForModel(m) : -1;
+            if (m == 0)
+                return "model 0";
+            if (c == 0)
+                return "zidane";
+            if (!NetSyncVisitor.DressCharIdValid(c))
+                return "charid";
+            if (rig < 0)
+                return "no rig";
+            if (rig == 0)
+                return "zidane";                        // model 98 under another charId: a Zidane dress never arms
+            return WhyArmed;
+        }
+
+        private static void Disarm(String reason)
+        {
+            _arm = false;
+            Why = reason;
+            LogArm();
+        }
+
+        // One line per CHANGE of the arm (never per field load). Muted while SelfTest runs the real arm path (its statics restored).
+        private static void LogArm()
+        {
+            if (_quiet)
+                return;
+            String line = _arm
+                ? "[NetSync] self-dress ARMED (" + From + "): section 8 model " + WantModel + " charId " + WantChar + " -> rig " + WantRig
+                  + " (" + (RigGeo(WantRig) ?? "?") + ")" + (Knob ? "" : " -- but [Netsync] SelfDress=0: nothing dresses")
+                : "[NetSync] self-dress not armed (" + (From ?? "-") + "): " + Why
+                  + (WantModel >= 0 ? " (section 8 model " + WantModel + " charId " + WantChar + ")" : "");
+            if (line == _lastArmLine)
+                return;
+            _lastArmLine = line;
+            Log.Message(line);
+        }
+
+        // A field load whose state apply was SKIPPED (transport down, no host snapshot, apply failed; a host or a non-following
+        // client lands here too). `clientRole` = the live role is client; `mirroring` = _storyMirroring. The selftest role arms
+        // itself (ArmBench).
+        internal static void OnApplySkipped(Boolean clientRole, Boolean mirroring)
+        {
+            try
+            {
+                Int32 rule = SkipRule(NetSyncClient.IsSelfTestRole, clientRole, mirroring);
+                if (rule == SkipSelfTest)
+                    return;
+                if (rule == SkipKeep)
+                {
+                    if (_arm && !_loggedSticky)
+                    {
+                        _loggedSticky = true;
+                        Log.Message("[NetSync] self-dress: the state apply was skipped at this field load -- the last arm is kept (sticky "
+                                    + "through a blip while mirroring)");
+                    }
+                    return;
+                }
+                From = null;                                // no section 8 read at this load
+                WantModel = WantChar = WantRig = -1;
+                if (rule == SkipDisarm)
+                    Disarm(SkipWhy(rule));                  // B26: the autoload's own SetModel(98) is never dressed
+                else
+                {
+                    _arm = false;                           // a host (or any other role) never dresses itself: no log line,
+                    Why = SkipWhy(rule);                    // and no "not mirroring" -- that is a CLIENT's witness (B26)
+                }
+            }
+            catch (Exception err)
+            {
+                Faults++;
+                LogFault("skip", err);
+            }
+        }
+
+        // THE SKIP RULE (pure; SelfTest pins it, the never-sticky and sticky-host mutants must fail): what a SKIPPED apply does to
+        // the arm -- the selftest role arms itself (ArmBench); a client while mirroring KEEPS the last arm (sticky through a blip,
+        // amendment 6); a client not mirroring disarms with a line ("not mirroring", B26); any other role (a host) disarms silently.
+        internal const Int32 SkipSelfTest = 0, SkipKeep = 1, SkipDisarm = 2, SkipDisarmQuiet = 3;
+
+        internal static Int32 SkipRule(Boolean selfTestRole, Boolean clientRole, Boolean mirroring)
+        {
+            if (selfTestRole)
+                return SkipSelfTest;
+            if (clientRole && mirroring)
+                return SkipKeep;
+            return clientRole ? SkipDisarm : SkipDisarmQuiet;
+        }
+
+        // The `why` a disarming skip publishes (pure; SelfTest pins it): "not mirroring" for a CLIENT (B26's witness) and null
+        // for any other role -- a host never mirrors, so its `why` never claims a mirror state (null = never decided).
+        internal static String SkipWhy(Int32 rule)
+        {
+            return rule == SkipDisarm ? "not mirroring" : null;
+        }
+
+        // The selftest role, every field load: the bench spec through the real encoder and reader. `auto` = the s139 host rule's
+        // ResolveAuto on the real party (the `selfdress empty` lever applied by the caller's read), moogleWhenEmpty from the live
+        // role; the mask is `self auto <mask>`'s, else the live GuestSlots (the selftest pin 0: a spectator, the moogle).
+        internal static void ArmBench(Int32 guestSlots, Boolean moogleWhenEmpty, Func<Int32[]> readSlotChars)
+        {
+            try
+            {
+                ArmFromStateCore(BenchFrame(_benchSelf, _benchSelfMask, guestSlots, moogleWhenEmpty, readSlotChars), "bench");
+            }
+            catch (Exception err)
+            {
+                Faults++;
+                From = "bench";
+                Disarm("fault");
+                LogFault("bench arm", err);
+            }
+        }
+
+        // The bench spec's section-8 FRAME through the REAL encoders (DressSectionBody + NetSyncState.AppendSection; pure but for
+        // `auto`'s party read): no spec -> null (no section 8, "section absent", as an s137 host); "off" -> 00 00 FF ("model 0");
+        // "auto" -> ResolveAuto(the mask, else `guestSlots`; moogleWhenEmpty; the party); a name -> ResolveNamed over the whole table.
+        internal static Byte[] BenchFrame(String spec, Int32 autoMask, Int32 guestSlots, Boolean moogleWhenEmpty, Func<Int32[]> readSlotChars)
+        {
+            if (spec == null)
+                return null;
+            UInt16 model;
+            Int32 rig = -1;
+            if (spec == "off")
+                model = 0;
+            else if (spec == "auto")
+                model = NetSyncVisitor.ResolveAuto(autoMask >= 0 ? autoMask : guestSlots, moogleWhenEmpty,
+                                                   readSlotChars != null ? readSlotChars() : null, out rig);
+            else
+                model = NetSyncVisitor.ResolveNamed(spec, NetSyncVisitor.RigCount, out rig);
+            Byte[] body = NetSyncVisitor.DressSectionBody(model, NetSyncVisitor.DressCharId(model, rig));   // the real body encoder
+            return NetSyncState.AppendSection(null, NetSyncVisitor.SectionDress, body);                    // the real frame encoder
+        }
+
+        // Disarm for a session boundary (the exit ramp's FIRE, OnDestroy, ApplyConfigChange) -- never a live body.
+        internal static void Clear(String cause)
+        {
+            Boolean was = _arm;
+            _arm = false;
+            WantModel = WantChar = WantRig = -1;
+            From = null;
+            Why = "cleared";
+            _lastArmLine = null;
+            if (was && !_quiet)
+                Log.Message("[NetSync] self-dress arm cleared (" + cause + ") -- a dressed body stays dressed until its next SetModel "
+                            + "(the teardown law)");
+        }
+
+        // ================================================================ THE DRESS (SetModel)
+        // The fields never dressed (review dress F2): New Game's field 70 and the ending 3000-3012, forks of them included.
+        internal static Boolean ExcludedField()
+        {
+            return ExcludedFieldId(Memoria.DataPatchers.EffectiveFieldId(FF9StateSystem.Common.FF9.fldMapNo));
+        }
+
+        internal static Boolean ExcludedFieldId(Int32 eff)   // pure (SelfTest pins it): the EFFECTIVE field id
+        {
+            return eff == 70 || (eff >= 3000 && eff <= 3012);
+        }
+
+        // THE DRESS ORDER at SetModel's fresh branch (pure but for its three lazy reads; review dress F5 -- SelfTest pins the order,
+        // the control-first mutant must fail): nothing unless armed, a 98 (re-)model and a client / selftest role; then THE
+        // EXCLUSION (a skip -- the arm untouched, amendment 6); then THE PLAYER GATE (gate on and the entry defines no player ->
+        // skip_npc) BEFORE the control check (another dressed body holds control -> skip_second); else dress. Each lazy read is
+        // asked only when the order reaches it (the gate's parse, the control lookup).
+        internal const Int32 DressNone = 0, DressExcluded = 1, DressSkipNpc = 2, DressSkipSecond = 3, DressYes = 4;
+
+        internal static Int32 SetModelRule(Boolean armed, UInt16 asked, Boolean clientOrSelfTest, Func<Boolean> excluded, Boolean gateOn,
+                                           Func<Boolean> definesPlayer, Func<Boolean> otherDressedCtl)
+        {
+            if (!armed || asked != NetSyncVisitor.PlainZidaneModel || !clientOrSelfTest)
+                return DressNone;
+            if (excluded())
+                return DressExcluded;
+            if (gateOn && !definesPlayer())
+                return DressSkipNpc;
+            if (otherDressedCtl())
+                return DressSkipSecond;
+            return DressYes;
+        }
+
+        // DoEventCode SetModel, right after po.model / po.eye and BEFORE the GEO lookup (the caller gates: gMode 1 && (Armed ||
+        // po.netSelfDress != 0)). Rewrites po.model / po.eye only. Never throws.
+        internal static void AtSetModel(EventEngine ee, PosObj po)
+        {
+            try
+            {
+                UInt16 asked = po.model;
+                if (po.netSelfDress != 0)
+                {
+                    // THE DEFENCE BRANCH (unreachable in stock -- not coverage): the rig from the BODY.
+                    NetSyncVisitor.Rig body;
+                    if (asked == NetSyncVisitor.PlainZidaneModel && NetSyncVisitor.TryGetRig(BodyRig(po), out body))
+                    {
+                        po.model = body.Model;
+                        po.eye = (Int16)(-4 * body.Eye);
+                        DefenceKept++;
+                        return;
+                    }
+                    po.netSelfDress = 0;
+                    po.netDressSrc = 0;
+                    Actor dropped = po as Actor;
+                    if (dropped != null)
+                    {
+                        // the two slots a re-modelling script is least likely to re-set: never leave the rig's break clip (a
+                        // CheckSleep ExecAnim of a clip the new go lacks: frameN 255, amendment 2's freeze) or its alias stored
+                        dropped.sleep = 0;                      // 0 = no break clip (the engine's own `p.sleep == 0` test)
+                        dropped.jump = po.netJumpSrc;           // the raw SetJumpAnimation id stock would hold (0 = none set)
+                    }
+                    po.netJumpSrc = 0;
+                    String geo;
+                    if (!(FF9BattleDB.GEO.TryGetValue((Int32)asked, out geo) && ModelFactory.garnetShortHairTable.Contains(geo)))
+                    {
+                        po.garnet = false;                      // stock SetModel only ever SETS them
+                        po.shortHair = false;
+                    }
+                    DefenceDropped++;
+                    Log.Message("[NetSync] self-dress: uid " + po.uid + " re-modelled to " + asked + " -> the dress is dropped");
+                    return;
+                }
+                PosObj ctl = null;
+                Int32 outcome = SetModelRule(Armed, asked, NetSyncClient.IsClientOrSelfTestRole, ExcludedField, GateOn,
+                                             delegate { return EntryDefinesPlayer(ee, po.sid); },
+                                             delegate
+                                             {
+                                                 ctl = ee.GetControlChar();
+                                                 return ctl != null && ctl != po && ctl.netSelfDress != 0;
+                                             });
+                if (outcome == DressNone)
+                    return;
+                if (outcome == DressExcluded)
+                {
+                    Why = "excluded";                           // a skip at SetModel time; the arm untouched (amendment 6)
+                    if (!_loggedExcluded)
+                    {
+                        _loggedExcluded = true;
+                        Log.Message("[NetSync] self-dress: field " + FF9StateSystem.Common.FF9.fldMapNo + " is excluded (New Game / the ending) "
+                                    + "-- uid " + po.uid + " stays Zidane; the arm is kept");
+                    }
+                    return;
+                }
+                if (outcome == DressSkipNpc)
+                {
+                    SkipNpc++;                                  // the player gate FIRST (review dress F5)
+                    if (!_loggedSkipNpc)
+                    {
+                        _loggedSkipNpc = true;
+                        Log.Message("[NetSync] self-dress: uid " + po.uid + " (sid " + po.sid + ") is a Zidane NPC (its entry defines no "
+                                    + "player) -- not dressed");
+                    }
+                    return;
+                }
+                if (outcome == DressSkipSecond)
+                {
+                    SkipSecond++;
+                    if (!_loggedSkipSecond)
+                    {
+                        _loggedSkipSecond = true;
+                        Log.Message("[NetSync] self-dress: uid " + po.uid + " is a second player Zidane (uid " + (ctl != null ? ctl.uid : -1)
+                                    + " is dressed and holds control) -- not dressed");
+                    }
+                    return;
+                }
+                NetSyncVisitor.Rig rig;
+                if (!NetSyncVisitor.TryGetRig(WantRig, out rig) || rig.Model != WantModel)
+                {
+                    Faults++;
+                    return;
