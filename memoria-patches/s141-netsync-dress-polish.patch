+        private static String Field250Table(Boolean polish)
+        {
+            if (Field250Oracle.Length != NetSyncVisitor.RigRowCount)
+                return "the oracle covers " + Field250Oracle.Length + " rigs, the table " + NetSyncVisitor.RigRowCount;
+            for (Int32 i = 0; i < NetSyncVisitor.RigRowCount; i++)
+            {
+                NetSyncVisitor.Rig rig;
+                if (!NetSyncVisitor.TryGetRig(i, out rig))
+                    return "rig " + i + ": no row";
+                Int32 dropped;
+                String steps = Replay250(rig, polish, out dropped);
+                String want = polish ? Field250Oracle[i] : Field250Oracle[0];
+                Int32 wantDropped = polish && want == "[]" ? Field250Steps.GetLength(0) : 0;
+                if (steps != want || dropped != wantDropped)
+                    return "rig " + i + ": steps " + steps + " dropped " + dropped + ", want " + want + " dropped " + wantDropped;
+            }
+            return null;
+        }
+
+        // One load of field 250's ops on a body wearing `rig` (the polish as given) into fldchar's table semantics: 16-18 find the
+        // (anim, frame) record or create one, then set sndEffectID[0] / [1] / the pitch flag. Returns `steps` as published
+        // ([anim, frame, sndEffectID[0]] in table order) and the ops dropped.
+        private static String Replay250(NetSyncVisitor.Rig rig, Boolean polish, out Int32 dropped)
+        {
+            List<Int32[]> table = new List<Int32[]>();
+            dropped = 0;
+            for (Int32 i = 0; i < Field250Steps.GetLength(0); i++)
+            {
+                Int32 code = Field250Steps[i, 0], a, f, s;
+                Int32 v = FootstepDecision(rig, code, Field250Steps[i, 1], Field250Steps[i, 2], Field250Steps[i, 3], polish, table.Count,
+                                           out a, out f, out s);
+                if (v == StepDropped || v == StepDroppedEmpty)
+                {
+                    dropped++;
+                    continue;
+                }
+                Int32[] rec = null;
+                for (Int32 r = 0; r < table.Count && rec == null; r++)
+                    if (table[r][0] == a && table[r][1] == f)
+                        rec = table[r];
+                if (rec == null)
+                {
+                    rec = new Int32[] { a, f, 0, 0, 0 };
+                    table.Add(rec);
+                }
+                if (code == 16)
+                    rec[2] = s & 0xFFFF;
+                else if (code == 17)
+                    rec[3] = s & 0xFFFF;
+                else if (code == 18)
+                    rec[4] = s == 0 ? 0 : 1;
+            }
+            System.Text.StringBuilder sb = new System.Text.StringBuilder("[");
+            for (Int32 r = 0; r < table.Count; r++)
+                sb.Append(r > 0 ? "," : "").Append("[").Append(table[r][0]).Append(",").Append(table[r][1]).Append(",").Append(table[r][2]).Append("]");
+            return sb.Append("]").ToString();
+        }
