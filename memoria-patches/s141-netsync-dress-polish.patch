+        private static Int32 MutantAnyFrame(NetSyncVisitor.Rig rig, Int32 code, Int32 anim, Int32 frame, Int32 sound,
+                                            out Int32 animOut, out Int32 frameOut, out Int32 soundOut)
+        {
