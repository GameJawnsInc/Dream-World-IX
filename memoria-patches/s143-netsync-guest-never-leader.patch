+
+        // The lever's rule (pure; the selftest pins it): off only while pulled AND on the selftest role -- a lever stranded across an ini
+        // edit can never unguard a real host.
+        internal static Boolean LeaderGuardOnRule(Boolean benchOff, Boolean selfTestRole)
