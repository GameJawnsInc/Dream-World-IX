+
+        // THE LEADER of a body model (pure; the selftest pins it): the rig's CharacterId (rigs 0-7 -> 0-7, 9-12 -> 8-11), a census
+        // playable-character variant -> its character, anything else (the moogle's rig 8 included) -> LeaderNone.
+        internal static Int32 LeaderCharForModel(Int32 model)
+        {
+            if (model <= 0 || model > 0xFFFF)
+                return LeaderNone;
+            Int32 rig = NetSyncVisitor.RigForModel((UInt16)model);
+            if (rig >= 0)
+            {
+                Byte c = NetSyncVisitor.RigToChar(rig);
+                return c == NetSyncVisitor.CharNone ? LeaderNone : (Int32)c;
+            }
+            for (Int32 i = 0; i < PcVariantModels.Length; i++)
+                if (PcVariantModels[i] == model)
+                    return PcVariantChars[i];
+            return LeaderNone;
+        }
+
+        // THE LATCH STEP (pure; the selftest pins it): the leader once my controlled body is `model` -- the world map's sentinels ->
+        // Zidane / Garnet; a body naming a character -> that character; any other body -> `prevChar` KEPT (LeaderNone stays none).
+        // [review s143 field-1, own-1]
+        internal static Int32 NextLeader(Int32 prevChar, Int32 model)
+        {
+            if (model == WorldLeaderModel)
+                return (Int32)CharacterId.Zidane;
+            if (model == WorldDaggerModel)
+                return (Int32)CharacterId.Garnet;
+            Int32 c = LeaderCharForModel(model);
+            return c >= 0 ? c : prevChar;
+        }
+
+        // The latch's log line (pure but for its names). `changed` = the CHARACTER changed; else my body named no character and the
+        // leader stayed.
+        internal static String LeaderLogText(Int32 leader, Int32 model, Boolean changed)
+        {
+            if (!changed)
+                return "leader guard: my controlled body's model " + model + " names no character -- the leader stays "
+                       + (leader >= 0 ? GuardCharName(leader) + " (CharacterId " + leader + ")" : "none known (the positional rule)");
+            return "leader guard: the host-side leader is now " + (leader >= 0
+                       ? GuardCharName(leader) + " (CharacterId " + leader + (model == WorldLeaderModel
+                           ? ", the world map: Zidane's party walks it)" : model == WorldDaggerModel ? ", the world map: Dagger walks it)"
+                           : ", my controlled body's model " + model + ")")
+                       : "NONE (my controlled body's model " + model + ")")
+                   + " -- a guest bit landing on it moves to the next member (owner, 2026-10-19)";
+        }
+
+        // NetSyncClient.Update, every frame on a live field (every role): my controlled body's GENUINE model -> the leader (NextLeader:
+        // a body naming no character keeps it). One model compare a frame once latched; a model 0 (a body not set up yet) is skipped; a
+        // change of the CHARACTER logs one line, and so does a body that names none (the leader kept). Never throws.
+        public static void NoteFieldLeader(EventEngine ee)
+        {
+            try
+            {
+                Actor me = ee != null ? ee.GetControlChar() as Actor : null;
+                if (me == null)
+                    return;
+                Int32 model = me.netSelfDress != 0 ? me.netDressSrc : me.model;
+                if (model <= 0 || model == _leaderModel)
+                    return;
+                Int32 was = _leaderChar;
+                _leaderModel = model;
+                _leaderChar = NextLeader(was, model);
+                if (_leaderChar != was || LeaderCharForModel(model) < 0)
+                    Log.Message("[NetSync] " + LeaderLogText(_leaderChar, model, _leaderChar != was));
+            }
+            catch { }
+        }
+
+        // The world map's walker as a latch sentinel (pure; the selftest pins it): the moving actor's status (WMUIData.StatusNo) -- 0 =
+        // none up yet (0: latch nothing), 2 = ff9.k_moveCHRStatus_Dagger (Dagger walks it), any other (Zidane on foot, a chocobo, a
+        // ship) = Zidane's party.
+        internal static Int32 WorldWalkerModel(Int32 status)
+        {
+            return status <= 0 ? 0 : status == 2 ? WorldDaggerModel : WorldLeaderModel;
+        }
+
+        // NetSyncClient.Update, every frame on the world map (gMode 3, every role): its walker -> the leader (review s143 own-1: a
+        // world-map save loads straight here, no field seen). One compare a frame once latched. Never throws.
+        public static void NoteWorldLeader(Int32 status)
+        {
+            Int32 model = WorldWalkerModel(status);
+            if (model == 0 || model == _leaderModel)
+                return;
+            Int32 was = _leaderChar;
+            _leaderModel = model;
+            _leaderChar = NextLeader(was, model);
+            if (_leaderChar != was)
+                Log.Message("[NetSync] " + LeaderLogText(_leaderChar, model, true));
+        }
+
+        // NetSyncClient.Update, every frame at the title (every role): every load passes the title, so the latch never crosses a save --
+        // the next field body or the world map latches afresh. Two compares a frame once forgotten. Never throws.
+        public static void ForgetLeader()
+        {
+            if (_leaderModel == -1 && _leaderChar == LeaderNone)
+                return;
+            _leaderModel = -1;
+            _leaderChar = LeaderNone;
+            Log.Message("[NetSync] " + LogLeaderForgotten);
+        }
+
+        internal const String LogLeaderForgotten = "leader guard: the leader is forgotten at the title (a load starts afresh: the next "
+                                                   + "field body or the world map latches it)";
+
+        // THE RULE (pure). `slotChar[i]` = the CharacterId at index i (0-3; negative = no member there: -1 empty, -2 unreadable),
+        // `ownedMask` the guest's bits (0-3 only). Out: the index the leader's bit left (-1 = none) and the index it went to (-1 = none:
+        // with movedFrom >= 0, the bit DROPPED).
+        internal static Int32 LeaderGuard(Int32[] slotChar, Int32 ownedMask, Int32 leaderChar, out Int32 movedFrom, out Int32 movedTo)
+        {
+            return LeaderGuardCore(slotChar, ownedMask, leaderChar, true, true, out movedFrom, out movedTo);
+        }
+
+        // The rule's body; `wrap` / `skipOwned` exist for the selftest's mutants (production passes true, true).
+        internal static Int32 LeaderGuardCore(Int32[] slotChar, Int32 ownedMask, Int32 leaderChar, Boolean wrap, Boolean skipOwned,
+                                              out Int32 movedFrom, out Int32 movedTo)
+        {
+            movedFrom = -1;
+            movedTo = -1;
+            Int32 raw = ownedMask & 0x0F;
+            Int32 eff = raw;
+            if (leaderChar < 0 || slotChar == null)
+                return eff;                              // no leader known: the positions as they are
+            for (Int32 i = 0; i < 4; i++)
+            {
+                if ((raw & (1 << i)) == 0 || GuardCharAt(slotChar, i) != leaderChar)
+                    continue;
+                eff &= ~(1 << i);                        // the leader's bit leaves it ...
+                movedFrom = i;
+                movedTo = -1;
+                for (Int32 k = 1; k < 4; k++)
+                {
+                    Int32 j = i + k;
+                    if (j >= 4)
+                    {
+                        if (!wrap)
+                            break;
+                        j -= 4;
+                    }
+                    Int32 c = GuardCharAt(slotChar, j);
+                    if (c < 0 || c == leaderChar || (skipOwned && (eff & (1 << j)) != 0))
+                        continue;
+                    eff |= 1 << j;                       // ... for the next member who is neither the leader nor already owned
+                    movedTo = j;
+                    break;
+                }
+            }
+            return eff;
+        }
+
+        private static Int32 GuardCharAt(Int32[] slotChar, Int32 i)
+        {
+            return slotChar != null && i >= 0 && i < slotChar.Length ? slotChar[i] : -1;
+        }
+
+        // The log's names for a CharacterId (the open-source CharacterId enum's names): "-" no member, "?" unreadable, "#id" a custom.
+        private static readonly String[] GuardNames = { "Zidane", "Vivi", "Garnet", "Steiner", "Freya", "Quina", "Eiko", "Amarant",
+                                                        "Cinna", "Marcus", "Blank", "Beatrix" };
+
+        internal static String GuardCharName(Int32 charId)
+        {
+            if (charId == -1)
+                return "-";
+            if (charId < 0)
+                return "?";
+            return charId < GuardNames.Length ? GuardNames[charId] : "#" + charId;
+        }
+
+        // --- the battle latch (EffectiveGuestSlots)
+        private static Boolean _guardOwnBattle;          // NoteOwnBattleStart .. NoteOwnBattleEnd (both pumps): the latch is read inside only
+        private static Boolean _guardLatched;            // the latch below is THIS own battle's
+        private static Int32 _guardRaw = -1;             // ...its key: GuestSlots, the leader it took, party.battle_no
+        private static Int32 _guardLeaderUsed = LeaderNone;
+        private static Int32 _guardBattleNo = Int32.MinValue;
+        private static Int32 _guardSig;                  // ...and the units' signature (BattleSlotSig: a party swap re-latches)
+        private static Int32 _guardEff;                  // ...its answer
+        private static Int32 _guardFrom = -1;            // ...what moved (kept after its battle until the next latch: the harness)
+        private static Int32 _guardTo = -1;
+        private static Int32 _guardNonce = -1;           // ...the own battle (nonce) it belongs to (-1 = none yet)
+        private static readonly Int32[] _guardChars = { -1, -1, -1, -1 };   // ...and the units it read (CharacterId per btl index)
+        private static Int32 _guardLogs;                 // latch lines this own battle (GuardLogBudget)
+        private const Int32 GuardLogBudget = 4;
+
+        // THE BATTLE MASK every host ownership read takes. Cheap (a few field reads once latched); never throws.
+        public static Int32 EffectiveGuestSlots
+        {
+            get
+            {
+                Int32 raw = GuestSlots & 0x0F;
+                if (raw == 0 || !_guardOwnBattle)
+                    return raw;
+                try
+                {
+                    FF9StateBattleSystem btlsys = FF9StateSystem.Battle.FF9Battle;
+                    if (btlsys == null || (btlsys.btl_load_status & global::FF9.ff9btl.LOAD_INITCHR) == 0)
+                    {
+                        _guardLatched = false;           // the players are not organized yet: nothing to guard
+                        return raw;
+                    }
+                    Int32 leader = LeaderForGuard;
+                    Int32 battleNo = FF9StateSystem.Common.FF9.party.battle_no;
+                    Int32 sig = BattleSlotSig(btlsys);
+                    if (!_guardLatched || raw != _guardRaw || leader != _guardLeaderUsed || battleNo != _guardBattleNo || sig != _guardSig)
+                        LatchGuard(btlsys, raw, leader, battleNo, sig);
+                    return _guardEff;
+                }
+                catch
+                {
+                    return raw;
+                }
+            }
+        }
+
+        // The own battle's edges (NoteOwnBattleStart / NoteOwnBattleEnd): the latch is per own battle (its published values stay).
+        private static void GuardBattleEdge(Boolean start)
+        {
+            _guardOwnBattle = start;
+            _guardLatched = false;
+            if (start)
+                _guardLogs = 0;
+        }
+
+        // The own battle's player units as the guard reads them: btl_data index 0-3 -> bi.slot_no (the CharacterId) for a live player
+        // record (btl_id == 1 << index -- InitPlayerData zeroes the unused ones), linked or script-hidden alike; -1 = none; -2 = unreadable.
+        internal static Int32[] BattleSlotChars(FF9StateBattleSystem btlsys)
+        {
+            Int32[] chars = { -1, -1, -1, -1 };
+            for (Int32 i = 0; i < 4; i++)
+            {
+                try
+                {
+                    BTL_DATA d = btlsys.btl_data[i];
+                    if (d != null && d.btl_id == (UInt16)(1 << i) && d.bi.player != 0)
+                        chars[i] = d.bi.slot_no;
+                }
+                catch
+                {
+                    chars[i] = NetSyncVisitor.SlotUnreadable;
+                }
+            }
+            return chars;
+        }
+
+        // The units' signature, the latch's last key (review s143 own-2): the four bi.slot_no bytes as BattleSlotChars reads them (0xFF
+        // no member, 0xFE unreadable) -- Memoria's in-battle party swap ([Battle] AccessMenus > 0: SwapPlayerCharacter re-stamps
+        // bi.slot_no at a fixed btl index) re-latches, so a reserve leader swapped into a guest bit moves it. Four reads; never throws.
+        private static Int32 BattleSlotSig(FF9StateBattleSystem btlsys)
+        {
+            Int32 sig = 0;
+            for (Int32 i = 0; i < 4; i++)
+            {
+                Int32 c;
+                try
+                {
+                    BTL_DATA d = btlsys.btl_data[i];
+                    c = d != null && d.btl_id == (UInt16)(1 << i) && d.bi.player != 0 ? d.bi.slot_no : 0xFF;
+                }
+                catch
+                {
+                    c = 0xFE;
+                }
+                sig |= (c & 0xFF) << (8 * i);
+            }
+            return sig;
+        }
+
+        private static void LatchGuard(FF9StateBattleSystem btlsys, Int32 raw, Int32 leader, Int32 battleNo, Int32 sig)
+        {
+            Int32 eff = raw, from = -1, to = -1;
+            Int32[] chars = null;
+            String fault = null;
+            try
+            {
+                chars = BattleSlotChars(btlsys);
+                eff = LeaderGuard(chars, raw, leader, out from, out to);
+            }
+            catch (Exception err)
+            {
+                eff = raw;
+                from = -1;
+                to = -1;
+                fault = err.GetType().Name;
+            }
+            _guardLatched = true;
+            _guardRaw = raw;
+            _guardLeaderUsed = leader;
+            _guardBattleNo = battleNo;
+            _guardSig = sig;
+            _guardEff = eff;
+            _guardFrom = from;
+            _guardTo = to;
+            _guardNonce = _battleNonce;
+            for (Int32 i = 0; i < 4; i++)
+                _guardChars[i] = chars != null && i < chars.Length ? chars[i] : NetSyncVisitor.SlotUnreadable;
+            if (_guardLogs >= GuardLogBudget)
+                return;
+            _guardLogs++;
+            Log.Message("[NetSync] leader guard: " + GuardLatchText(_guardChars, raw, leader, eff, from, to, fault)
+                        + " (own battle nonce " + _battleNonce + ")");
+        }
+
+        // The latch line's body (pure but for the lever's wording).
+        internal static String GuardLatchText(Int32[] chars, Int32 raw, Int32 leader, Int32 eff, Int32 from, Int32 to, String fault)
+        {
+            StringBuilder sb = new StringBuilder(200);
+            sb.Append("GuestSlots 0x").Append(raw.ToString("X")).Append(" over the battle's units [");
+            for (Int32 i = 0; i < 4; i++)
+                sb.Append(i > 0 ? ", " : "").Append(GuardCharName(GuardCharAt(chars, i)));
+            sb.Append("], leader ").Append(leader >= 0 ? GuardCharName(leader)
+                                           : LeaderGuardOn ? "none known" : "OFF (the `bench leaderguard off` lever: the positional rule)");
+            sb.Append(" -> 0x").Append(eff.ToString("X"));
+            if (fault != null)
+                sb.Append(" -- the unit read threw " + fault + ": the positions as they are");
+            else if (from >= 0 && to >= 0)
+                sb.Append(" -- index ").Append(from).Append(" is the leader: the guest commands ").Append(GuardCharName(GuardCharAt(chars, to)))
+                  .Append(" (index ").Append(to).Append(") instead");
+            else if (from >= 0)
+                sb.Append(" -- index ").Append(from).Append(" is the leader and no other member is free: the bit drops (the guest spectates it)");
+            else
+                sb.Append(" -- unmoved");
+            return sb.ToString();
+        }
+
+        // --- THE LINE
+        // The stock command title's priority: below every stock message (3-4), never over one. At EQUAL priority BattleHUD.
+        // SetBattleMessage replaces what shows (its test is `>`), so the line can replace an on-screen command title and a later title
+        // replaces the line; a higher-priority message holds it in the stock queue, where it can expire unseen. [review s143 own-3]
+        private const Byte GuardLinePriority = 1;
+        private static String _guardLine;                // the host's line this (or the last) own battle; null = none yet
+        private static Int32 _guardLineNonce = -1;       // ...the own battle it belongs to: once per own battle
+        private static Boolean _guardLineShown;          // ...it was HANDED to the battle message window (else the log only) -- see
+                                                         //    GuardLinePriority: the bench judges the on-screen `battle.message`
+        private static Int32 _youNonce = -1;             // the guest's line: the host battle (nonce) it belongs to (-1 = none since a Reset or a host relaunch)
+        private static Int32 _youSeq = -1;               // ...the header seq it latched at (GuestLineSameBattle)
+        private static Int32 _youMask = -1;              // ...the header's mask it read
+        private static String _youLine;                  // ...its text (null = none)
+        private static Boolean _youShown;                // ...it was handed to a live diorama's battle message window (on time or late)
+
+        // THE LINE's text (pure; the selftest pins it). `names[i]` = the display name at index i (null = no member). Host: "Partner: " +
+        // the owned members' names, + " (not <the leader>)" when the guard moved or dropped the leader's bit (movedFrom >= 0); "watching"
+        // when the mask names no member. Guest: "You: " + the same list (it never knows what moved).
+        internal static String GuardLineText(Boolean host, String[] names, Int32 mask, Int32 movedFrom)
+        {
+            StringBuilder sb = new StringBuilder(48);
+            sb.Append(host ? "Partner: " : "You: ");
+            Int32 n = 0;
+            for (Int32 i = 0; i < 4; i++)
+            {
+                if ((mask & (1 << i)) == 0 || names == null || i >= names.Length || String.IsNullOrEmpty(names[i]))
+                    continue;
+                if (n++ > 0)
+                    sb.Append(", ");
+                sb.Append(names[i]);
+            }
