+            if (!Memoria.Netsync.NetSyncDiorama.ValidateWireBoot(sceneId, group < 0 ? 0 : group, out reason))
+                return reason;
+        }
+        return null;
+    }
+
+    // [ff9mapkit netsync s144] THE ONE-SHOT, read by WMScriptDirector.HonoUpdate20FPS on every world tick that runs
