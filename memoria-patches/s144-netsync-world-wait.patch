+                      + (_worldBattleRand ? " as a random encounter" : "") + " started from world map "
+                      + FF9StateSystem.Common.FF9.wldMapNo;
+            Memoria.Prime.Log.Message("[NetSync] " + _status);
+            return true;
+        }
+        catch (Exception err)
+        {
+            _status = what + " failed: " + err.Message;
+            return false;
+        }
+    }
