+        }
+    }
+
+    private Boolean FireWorldBattle(Int32 frameResult)
+    {
+        String what = "world battle " + _worldBattleScene;
+        try
+        {
+            String why = null;
+            Int32 age = Environment.TickCount - _worldBattleTick;
+            if (frameResult != 0)
+                why = "the world's own tick result " + frameResult + " came first";
+            else if (age < 0 || age > WorldBattleArmMs || ff9.w_frameCounter < _worldBattleCounter)
+                why = "stale (armed " + age + " ms ago, or on an earlier world load)";
+            else
+                why = WorldBattleRefusal(_worldBattleScene, _worldBattleGroup, false);
+            if (why != null)
+            {
