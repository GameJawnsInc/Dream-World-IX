+            ClearHeld();
+        }
+
+        private static void ClearHeld()
+        {
+            _heldBody = null;
+            _heldNonce = -1;
+            _heldScene = -1;
+            _heldField = -1;
+        }
+
+        // ================================================================ BOOKKEEPING + LINES
+        // Every verdict but lever_off / not_field (GuestPress returns before Note for those): the counter, `last` (seq++), and one line
+        // per (entry, verdict) per field visit -- the counter always moves. Allow speaks through Begin's line.
+        private static void Note(Int32 v, Int32 fldMapNo, Int32 fld, Int32 entry, Int32 row, Int32 hashed, String reason)
+        {
+            Verdicts[v]++;
+            _lastSeq++;
+            LastField = fld;
+            LastEntry = entry;
+            _lastVerdict = v;
+            LastReason = reason;
+            LastHashed = hashed;
+            _lastKind = row >= 0 ? NetSyncGuestLocalTable.Rows[row].Kind : 0;
+            _lastTick = Environment.TickCount;
+            _lastArmed = true;
+            if (v == VAllow)
+                return;
+            if (fldMapNo != _latchField)
+            {
+                _lineLatch.Clear();
+                _latchField = fldMapNo;
+            }
+            Int32 key = entry << 8 | v;
+            if (_lineLatch.ContainsKey(key))
+                return;
+            _lineLatch[key] = true;
+            if (v == VShadow)
+                Log.Message("[NetSync] guest traversal (shadow): field " + fld + " entry " + entry + " (" + KindName(_lastKind) + ") would climb -- "
+                            + hashed + " bytes verified; declined as s155 (the shadow lever)");
+            else
+                Log.Message("[NetSync] guest traversal: field " + fld + " entry " + entry + (row >= 0 ? " (" + KindName(_lastKind) + ")" : "")
+                            + " declined -- " + reason);
+        }
+
+        private static String ReasonOf(Int32 v, Int32 row, String bytesWhy, PosObj ctrl, String busyWhy, String sceneWhy)
+        {
+            switch (v)
+            {
+                case VSpecial: return "a Special press (a card challenge stays the host's)";
+                case VNoRow: return "not on the traversal table (" + NetSyncGuestLocalTable.RowCount + " rows)";
+                case VUnverified: return "unverified bytes: " + bytesWhy;
+                case VWrongBody: return "the controlled body (" + (ctrl == null ? "none" : "uid " + ctrl.uid + ", entry " + ctrl.sid) + ") is not this row's";
+                case VOwnStory: return "own story: not mirroring yet";
+                case VNoControl: return "my control is off";
+                case VInFlight: return "a guest climb is already in flight (field " + _effFld + " entry " + _entry + ")";
+                case VWarp: return busyWhy;
+                case VHostScene: return sceneWhy;
+                default: return null;
+            }
+        }
+
+        private static String KindName(Int32 kind)
+        {
+            return kind > 0 && kind < KindNames.Length ? KindNames[kind] : "kind " + kind;
+        }
+
+        private static String FuncName(GuestLocalFunc f)
+        {
+            return "entry " + f.Entry + " tag " + f.Tag + " (" + (f.Role < RoleNames.Length ? RoleNames[f.Role] : "role " + f.Role) + ")";
+        }
+
+        // ================================================================ HARNESS (HarnessAgent `netsync guestlocal ...`; NetSyncBattle.HarnessReleaseBench)
+        // args[0] == "guestlocal". The role check comes first; every other refusal answers the one grammar line.
+        internal static Boolean HarnessLever(String[] args, out String why)
+        {
+            why = null;
+            if (!NetSyncClient.IsSelfTestRole)
+            {
+                why = "netsync guestlocal: needs the selftest role (netsync selftest 1)";
+                return false;
+            }
+            String op = args != null && args.Length > 1 && args[1] != null ? args[1].ToLowerInvariant() : "";
+            Int32 argc = args != null ? args.Length : 0;
+            switch (op)
+            {
+                case "act":
+                case "shadow":
+                case "off":
+                    if (argc != 2)
+                        break;
+                    _lever = op == "act" ? ModeAct : op == "shadow" ? ModeShadow : ModeOff;
+                    Log.Message("[NetSync] harness: guest traversal " + (op == "off"
+                                ? "OFF -- CALIBRATION: the s155 spectator gate (every quad press declined, nothing hashed, no new line)"
+                                : op == "shadow" ? "SHADOW (verdicts computed and logged, every press declined as s155)" : "ACT")
+                                + " (released with the harness)");
+                    return true;
+                case "mutate":
+                {
+                    Int32 n;
+                    if (argc != 3 || !Int32.TryParse(args[2], NumberStyles.Integer, CultureInfo.InvariantCulture, out n) || n < 0 || n > 65535)
+                        break;
+                    _mutateArmed = true;
+                    _mutateIndex = n;
+                    _mutateSpent = false;
+                    _mutateHit = false;
+                    _mutateHashed = 0;
+                    Log.Message("[NetSync] harness: guest traversal mutate armed -- the next re-hash feeds byte " + n
+                                + " of its input flipped (the live script is never touched)");
+                    return true;
+                }
+                case "clear":
+                    if (argc != 2)
+                        break;
+                    _lever = -1;
+                    ForgetMutate();
+                    _lineLatch.Clear();
+                    Log.Message("[NetSync] harness: guest traversal cleared (act, no mutate, the verdict lines re-armed)");
+                    return true;
+                case "teleport":
+                    if (argc != 2)
+                        break;
+                    TpCalls++;
+                    NetSyncClient.RequestTeleportToHost();           // the F11 / held-L3 path itself (UIKeyTrigger's call)
+                    TpLast = NetSyncClient.HarnessTpOutcome;
+                    return true;
+            }
+            why = "netsync guestlocal: expected act|shadow|off|mutate <0-65535>|clear|teleport";
+            return false;
+        }
+
+        private static void ForgetMutate()
+        {
+            _mutateArmed = false;
+            _mutateSpent = false;
+            _mutateHit = false;
+            _mutateIndex = -1;
+            _mutateHashed = 0;
+        }
+
+        // Every harness release (disarm, fault, `reset`, `netsync selftest 0`): the lever back to act, a mutate disarmed, the line latch
+        // re-armed. Counters never reset. A climb in flight runs on as stock; Step drops its record if the spectator gate falls.
+        public static void HarnessRelease()
+        {
+            try
+            {
+                Boolean wasSet = _lever >= 0 || _mutateArmed;
+                _lever = -1;
+                _mutateArmed = false;
+                _lineLatch.Clear();
+                if (wasSet)
+                    Log.Message("[NetSync] harness: guest traversal back to act, the mutate disarmed (released with the harness)");
+            }
+            catch
+            {
+            }
+        }
+
+        // the netsync.guestlocal read-back (HarnessAgent.AppendGuestLocal)
+        internal static String HarnessModeName { get { return ModeNames[EffectiveMode]; } }
+        internal static String HarnessLeverName { get { return _lever >= 0 && _lever < ModeNames.Length ? ModeNames[_lever] : null; } }
+        internal static Int32 HarnessLastSeq { get { return _lastSeq; } }
+        internal static String HarnessLastVerdictName { get { return _lastVerdict >= 0 && _lastVerdict < VerdictNames.Length ? VerdictNames[_lastVerdict] : null; } }
+        internal static String HarnessLastKindName { get { return _lastKind > 0 && _lastKind < KindNames.Length ? KindNames[_lastKind] : null; } }
+        internal static Int32 HarnessLastAgeMs { get { return _lastArmed ? Environment.TickCount - _lastTick : -1; } }
+        internal static Int32 HarnessFlightField { get { return NetSyncGuestLocalArmed.On ? _effFld : -1; } }
+        internal static Int32 HarnessFlightEntry { get { return NetSyncGuestLocalArmed.On ? _entry : -1; } }
+        internal static String HarnessFlightKindName { get { return NetSyncGuestLocalArmed.On && _kind > 0 && _kind < KindNames.Length ? KindNames[_kind] : null; } }
+        internal static Int32 HarnessFlightRegionUid { get { return NetSyncGuestLocalArmed.On ? _regionUid : -1; } }
+        internal static Int32 HarnessFlightBodyUid { get { return NetSyncGuestLocalArmed.On ? _ctrlUid : -1; } }
+        internal static Int32 HarnessFlightAgeMs { get { return NetSyncGuestLocalArmed.On ? Environment.TickCount - _startTick : -1; } }
+        internal static Boolean HarnessFlightSeenOff { get { return NetSyncGuestLocalArmed.On && _seenOff; } }
+        internal static Boolean HarnessFlightBodyOpen { get { return NetSyncGuestLocalArmed.On && _bodyOpenNow; } }
+        internal static Boolean HarnessFlightBodyRan { get { return NetSyncGuestLocalArmed.On && _bodyRan; } }
+        internal static Boolean HarnessFlightSeqOpen { get { return NetSyncGuestLocalArmed.On && _seqOpenNow; } }
+        internal static Boolean HarnessMutateArmed { get { return _mutateArmed; } }
+        internal static Int32 HarnessMutateIndex { get { return _mutateIndex; } }
+        internal static Boolean HarnessMutateSpent { get { return _mutateSpent; } }
+        internal static Boolean HarnessMutateHit { get { return _mutateHit; } }
+        internal static Int32 HarnessMutateHashed { get { return _mutateHashed; } }
+    }
+}
