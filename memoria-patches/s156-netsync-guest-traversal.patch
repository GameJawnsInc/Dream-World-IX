+                       : h == HoldDropLoad ? "the field changed"
+                       : h == HoldDropScene ? "the host's scene changed or ended"
+                       : "its TTL ran out after my climb ended (" + sinceEnd + " ms)");
+                return laneBody;
+            }
+            catch
+            {
+                return laneBody;
+            }
+        }
+
+        // C4c: the relay's verdict on a start (1 started, -1 declined); only the held nonce's settles the slot.
+        internal static void NoteTalkResult(Int32 nonce, Int32 result)
+        {
+            try
+            {
+                if (_heldNonce < 0 || nonce != _heldNonce || result == 0)
+                    return;
+                if (result < 0)
+                {
+                    DropHeld("declined on my copy (no such object or handler)");
+                    return;
+                }
+                TalkAppliedAfterClimb++;
+                Log.Message("[NetSync] guest traversal: relayed talk start " + nonce + " applied after my climb (held " + (Environment.TickCount - _heldTick) + " ms)");
+                ClearHeld();
+            }
+            catch
+            {
+            }
+        }
+
+        private static void DropHeld(String why)
+        {
+            TalkExpired++;
