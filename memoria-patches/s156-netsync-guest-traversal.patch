+        // ---------------------------------------------------------------- table: the COMPILED arrays against the generator's contract
+        private static void TableRows(GuestLocalRow[] rows, GuestLocalFunc[] funcs, Action<Boolean, String> row)
+        {
+            row(rows.Length == NetSyncGuestLocalTable.RowCount && rows.Length > 0,
+                "table.rows: " + rows.Length + " rows compiled, the generator stated " + NetSyncGuestLocalTable.RowCount);
+            row(funcs.Length == NetSyncGuestLocalTable.FuncCount,
+                "table.funcs: " + funcs.Length + " functions compiled, the generator stated " + NetSyncGuestLocalTable.FuncCount);
+            String sorted = null, fieldReal = null, kind = null, contiguous = null, regionFirst = null, roles = null, lenMin = null;
+            String xor = null, ctrlUid = null, fixedUid = null, zeroUid = null, seqTag = null;
+            Int32 next = 0, prevKey = -1;
+            for (Int32 i = 0; i < rows.Length; i++)
+            {
+                GuestLocalRow r = rows[i];
+                String at = "row " + i + " (field " + r.Field + " entry " + r.Entry + ")";
+                Int32 key = r.Field << 8 | r.Entry;
+                if (key <= prevKey && sorted == null)
+                    sorted = at + " is not strictly after its predecessor";
+                prevKey = key;
+                if ((r.Field < 1 || r.Field > 3100) && fieldReal == null)
+                    fieldReal = at + " is not a real field id (1..3100)";
+                if ((r.Kind < KindLadder || r.Kind > KindCarry) && kind == null)
+                    kind = at + " has kind " + r.Kind + " (want 1..3)";
+                if ((r.FuncStart != next || r.FuncCount < 2 || r.FuncStart + r.FuncCount > funcs.Length) && contiguous == null)
+                    contiguous = at + " has functions " + r.FuncStart + " +" + r.FuncCount + " (want start " + next + ", count >= 2, inside " + funcs.Length + ")";
+                next = r.FuncStart + r.FuncCount;
+                Int32 end = Math.Min(r.FuncStart + r.FuncCount, funcs.Length);
+                Int32 ctrls = 0, fixeds = 0, fuid = -1;
+                for (Int32 k = r.FuncStart; k < end; k++)
+                {
+                    GuestLocalFunc f = funcs[k];
+                    String fat = at + " function " + k + " (role " + f.Role + " entry " + f.Entry + " tag " + f.Tag + " uid " + f.Uid + ")";
+                    if (k == r.FuncStart)
+                    {
+                        if ((f.Role != RoleRegion || f.Entry != r.Entry || f.Tag != 3) && regionFirst == null)
+                            regionFirst = fat + " is not the row's region function (its entry, tag 3)";
+                    }
+                    else
+                    {
+                        if (f.Role == RoleRegion && regionFirst == null)
+                            regionFirst = fat + " is a second region function";
+                        if (k > r.FuncStart + 1 && OrderKey(funcs[k - 1]) >= OrderKey(f) && roles == null)
+                            roles = fat + " is not after its predecessor in (role, entry, tag) order, each once";
+                    }
+                    if (f.Role > RoleSeq && roles == null)
+                        roles = fat + " has an unknown role";
+                    if (f.Length < 8 && lenMin == null)
+                        lenMin = fat + " is " + f.Length + " bytes (want 8 or more)";
+                    if (f.Role == RoleCtrl)
+                    {
+                        ctrls++;
+                        if (f.Uid != 250 && ctrlUid == null)
+                            ctrlUid = fat + ": a ctrl function's dispatch uid is not 250";
+                    }
+                    if (f.Role == RoleFixedCtrl)
+                    {
+                        fixeds++;
+                        if ((f.Uid < 1 || f.Uid > 249 || (fuid >= 0 && fuid != f.Uid)) && fixedUid == null)
+                            fixedUid = fat + ": a fixed uid outside 1..249, or a second fixed uid in the row";
+                        fuid = f.Uid;
+                    }
+                    if ((f.Role == RoleRegion || f.Role == RoleSeq) && f.Uid != 0 && zeroUid == null)
+                        zeroUid = fat + ": a region / seq function with a dispatch uid";
+                    if (f.Role == RoleSeq && f.Tag != 0 && seqTag == null)
+                        seqTag = fat + ": a seq function not at tag 0 (a Seq runs its entry's tag 0)";
+                }
+                if ((ctrls > 0) == (fixeds > 0) && xor == null)
+                    xor = at + " has " + ctrls + " ctrl and " + fixeds + " fixed_ctrl bodies (want one kind, not both, not none)";
+            }
+            row(sorted == null, "table.sorted: " + sorted);
+            row(fieldReal == null, "table.field_real: " + fieldReal);
+            row(kind == null, "table.kind: " + kind);
+            row(contiguous == null, "table.contiguous: " + contiguous);
+            row(regionFirst == null, "table.region_first: " + regionFirst);
+            row(roles == null, "table.roles: " + roles);
+            row(lenMin == null, "table.len_min: " + lenMin);
+            row(xor == null, "table.ctrl_xor_fixed: " + xor);
+            row(ctrlUid == null, "table.ctrl_uid: " + ctrlUid);
+            row(fixedUid == null, "table.fixed_uid: " + fixedUid);
