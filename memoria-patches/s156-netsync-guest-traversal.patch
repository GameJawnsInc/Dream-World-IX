+        // the verdict mutant transient_first: the transient terms ranked above the structural ones
+        private static Int32 TransientFirstVerdict(Int32 mode, Boolean onField, Boolean specialOnly, Boolean rowFound, Boolean bytesMatch, Boolean bodyOk,
+                                                   Boolean storyOk, Boolean userControl, Boolean climbInFlight, Boolean warpBusy, Boolean hostScene)
+        {
+            if (mode == ModeOff) return VLeverOff;
+            if (!onField) return VNotField;
+            if (specialOnly) return VSpecial;
+            if (!userControl) return VNoControl;
+            if (climbInFlight) return VInFlight;
+            if (warpBusy) return VWarp;
+            if (hostScene) return VHostScene;
+            if (!rowFound) return VNoRow;
+            if (!bytesMatch) return VUnverified;
+            if (!bodyOk) return VWrongBody;
+            if (!storyOk) return VOwnStory;
+            return mode == ModeShadow ? VShadow : VAllow;
+        }
