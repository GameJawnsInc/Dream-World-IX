+using System;
+using System.Text;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync s156] "guest traversal selftest: OK (<R> rows, <M> mutants caught, <N> table rows / <Fn> functions, table crc 0x...)"
+    // -- NetSyncClient's selftest proof block, once per process on the selftest role. Pure: touches no live state. Every row compares a
+    // rule's answer with a LITERAL expected value (never the live rule's own output) and names itself "<group>.<case>: <what>" -- the
+    // names the bench and the kit's Python mirror quote. The slice / CRC / match / toy vectors are the SHARED set the kit renders into
+    // NetSyncGuestLocalTable.cs from its committed JSON (kit-authored blobs, no game bytes), so one definition proves both sides. Every
+    // mutant is a REAL wrong rule (a dropped term, a reordered precedence, a neighbouring slice bound) re-run over its group's rows, and
+    // must fail at least one of them (MutantCaught). The table group checks the COMPILED arrays (a hand edit or a partial merge fails).
+    public static partial class NetSyncGuestLocal
+    {
+        private delegate Int32 VerdictFn(Int32 mode, Boolean onField, Boolean specialOnly, Boolean rowFound, Boolean bytesMatch, Boolean bodyOk,
+                                         Boolean storyOk, Boolean userControl, Boolean climbInFlight, Boolean warpBusy, Boolean hostScene);
+        private delegate Boolean SliceFn(Byte[] data, Int32 tag, out Int32 start, out Int32 length);
+        private delegate Boolean MatchFn(Byte[] data, Int32 tag, Int32 wantLen, UInt32 wantCrc, Int32 flipAt);
+        private delegate Int32 BodyFn(GuestLocalFunc[] funcs, Int32 start, Int32 count, Boolean ctrlPresent, Boolean ctrlIsPresser, Int32 ctrlSid,
+                                      Int32 ctrlUid);
+        private delegate String BusyFn(Boolean booted, Boolean followFade, String fieldChangingWhy, Boolean sessionEnding);
+        private delegate String SceneFn(Int32 talkDeferNonce, Int32 talkHeldNonce, Boolean talkOnLaneHere, Boolean keyPendingHere,
+                                        Boolean hostSceneHere, Boolean hostHoldsInput);
+        private delegate Int32 FlightFn(Int32 keyTicks, Boolean seenOff, Boolean bodyRan, Boolean userControl, Boolean bodyOpen, Boolean seqOpen);
+        private delegate Boolean QueuedFn(Boolean armed, Boolean seenOff, Boolean bodyRan, Int32 keyTicks);
+        private delegate Int32 HoldFn(Boolean laneHasHeld, Boolean laneHasNewer, Boolean sameField, Boolean sceneUp, Boolean sameScene,
+                                      Boolean flightArmed, Int32 msSinceEnd, Int32 msSinceHold, Int32 ttlMs);
+        private delegate Int32 OpFn(Int32 a0, Int32 next);
+        private delegate Int32 WhoFn(Boolean isRegion, Boolean isBody, Int32 cid, Int32 uid, Int32 regionUid, Int32 bodyUid);
+        private delegate Byte TripFn(Int32 op, Int32 who, Int32 argFlags, Int32 arg0);
+
+        internal static Boolean SelfTest(out String detail)
+        {
+            Int32 rows = 0, mutants = 0;
+            String fail = null, okDetail = null;
+            Action<Boolean, String> row = (ok, what) => { rows++; if (!ok && fail == null) fail = what; };
+            Action<Boolean, String> mutant = (caught, what) => { mutants++; row(caught, what); };
+            try
+            {
+                // THE SHARED VECTORS (crc / flip / slice / match / toy)
+                CrcRows(row);
+                SliceRows(Slice, row);
+                MatchRows(FuncMatches, row);
+                ToyRows(row);
+                // THE PURE RULES
+                BodyRows(BodyRule, row);
+                VerdictRows(VerdictRule, row);
+                BusyRows(BusyRule, row);
+                SceneRows(HostSceneRule, row);
+                FlightRows(FlightRule, row);
+                QueuedRows(PressQueuedRule, row);
+                HoldRows(TalkHoldRule, row);
+                OpRows(OpCodeOf, row);
+                WhoRows(WhoRule, row);
+                TripRows(TripClassRule, row);
+                // THE COMPILED TABLE (the generator's contract)
+                TableRows(NetSyncGuestLocalTable.Rows, NetSyncGuestLocalTable.Funcs, row);
+
+                // THE MUTANTS -- each a real wrong rule that must fail a row of its own group
+                Action<VerdictFn, String> vm = (m, what) => mutant(MutantCaught(t => VerdictRows(m, t)), what);
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, s, rf, true, bo, st, u, fl, w, h),
+                   "mutant.verdict.crc_blind: a rule that never checks the bytes passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, s, rf, by, true, st, u, fl, w, h),
+                   "mutant.verdict.body_blind: a rule that never checks the controlled body passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, s, rf, by, bo, true, u, fl, w, h),
+                   "mutant.verdict.story_blind: a rule that climbs on the guest's own story passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, s, rf, by, bo, st, true, fl, w, h),
+                   "mutant.verdict.control_blind: a rule that climbs with control off passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, s, rf, by, bo, st, u, false, w, h),
+                   "mutant.verdict.flight_blind: a rule that starts a second climb in flight passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, s, rf, by, bo, st, u, fl, false, h),
+                   "mutant.verdict.warp_blind: a rule that climbs inside a fade or a load passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, s, rf, by, bo, st, u, fl, w, false),
+                   "mutant.verdict.scene_blind: a rule that climbs over the host's scene passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, true, s, rf, by, bo, st, u, fl, w, h),
+                   "mutant.verdict.world_blind: a rule that looks the world map up passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md, f, false, rf, by, bo, st, u, fl, w, h),
+                   "mutant.verdict.card_blind: a rule that climbs on a Special (card) press passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md == ModeShadow ? ModeAct : md, f, s, rf, by, bo, st, u, fl, w, h),
+                   "mutant.verdict.shadow_acts: a shadow lever that acts passes every verdict row");
+                vm((md, f, s, rf, by, bo, st, u, fl, w, h) => VerdictRule(md == ModeOff ? ModeAct : md, f, s, rf, by, bo, st, u, fl, w, h),
+                   "mutant.verdict.off_computes: an off lever that computes passes every verdict row");
+                vm(TransientFirstVerdict, "mutant.verdict.transient_first: the transient terms ranked above the structural ones pass every verdict row");
+
+                Action<SliceFn, String> sm = (m, what) => mutant(MutantCaught(t => SliceRows(m, t)), what);
+                sm(NextListedSlice, "mutant.slice.next_listed: a body bounded by the next LISTED row passes every slice row");
+                sm(TieEarlierSlice, "mutant.slice.tie_earlier: a tie that goes to the earlier-listed row passes every slice row");
+                sm(LastTagSlice, "mutant.slice.last_tag: the LAST row with the tag (not GetIP's first) passes every slice row");
+
+                Action<MatchFn, String> mm = (m, what) => mutant(MutantCaught(t => MatchRows(m, t)), what);
+                mm(PrefixCrcMatch, "mutant.match.prefix_crc: a CRC over the wanted length with no length check passes every match row");
+
+                Action<BodyFn, String> bm = (m, what) => mutant(MutantCaught(t => BodyRows(m, t)), what);
+                bm((fs, st, n, p, pr, sid, uid) => SidOnlyBody(fs, st, n, p, pr, sid),
+                   "mutant.body.sid_only: a fixed_ctrl check without the uid passes every body row");
+                bm((fs, st, n, p, pr, sid, uid) => FirstBody(fs, st, n, p, pr),
+                   "mutant.body.first_body: the row's first body function, whoever is controlled, passes every body row");
+
+                Action<BusyFn, String> km = (m, what) => mutant(MutantCaught(t => BusyRows(m, t)), what);
+                km((bo, fa, fw, se) => BusyRule(bo, false, fw, se), "mutant.busy.fade_blind: a busy rule blind to the follow / kick fade passes every busy row");
+
+                Action<SceneFn, String> hm = (m, what) => mutant(MutantCaught(t => SceneRows(m, t)), what);
+                hm((d, he, l, k, s, hh) => hh ? "the host holds input on this field" : HostSceneRule(d, he, l, k, s, hh),
+                   "mutant.hostscene.keyhold: a term that refuses while the host holds input (its own climb) passes every hostscene row");
+                hm((d, he, l, k, s, hh) => HostSceneRule(d, he, l, k, false, hh),
+                   "mutant.hostscene.scene_blind: a term blind to the host's scene on this field passes every hostscene row");
+
+                Action<HoldFn, String> om = (m, what) => mutant(MutantCaught(t => HoldRows(m, t)), what);
+                om((lh, ln, sf, su, ss, fa, se, sh, ttl) => TalkHoldRule(lh, ln, sf, true, true, fa, se, sh, ttl),
+                   "mutant.hold.scene_blind: a hold that outlives the host's scene passes every hold row");
+                om((lh, ln, sf, su, ss, fa, se, sh, ttl) => TalkHoldRule(lh, ln, sf, su, ss, fa, sh, sh, ttl),
+                   "mutant.hold.ttl_from_hold: a TTL measured from the hold, not the climb's end, passes every hold row");
+
+                Action<QueuedFn, String> qm = (m, what) => mutant(MutantCaught(t => QueuedRows(m, t)), what);
+                qm((a, so, br, tk) => a && !so && !br, "mutant.queued.unbounded: a queued press with no tick bound passes every queued row");
+                qm((a, so, br, tk) => a && !br && tk <= 1, "mutant.queued.seen_blind: a queued press blind to control seen off passes every queued row");
+
+                Action<FlightFn, String> fm = (m, what) => mutant(MutantCaught(t => FlightRows(m, t)), what);
+                fm((tk, so, br, c, bo, sq) => !so && !br ? (tk >= 2 ? FlightBailed : FlightRunning) : (c ? FlightLanded : FlightRunning),
+                   "mutant.flight.control_only: a flight that ends on control alone passes every flight row");
+                fm((tk, so, br, c, bo, sq) => FlightRule(tk, so, br, c, bo, false), "mutant.flight.seq_blind: a flight blind to a Seq tail passes every flight row");
+                fm((tk, so, br, c, bo, sq) => !so && !br ? FlightRunning : FlightRule(tk, so, br, c, bo, sq),
+                   "mutant.flight.no_bail: a flight that never bails passes every flight row");
+
+                Action<OpFn, String> pm = (m, what) => mutant(MutantCaught(t => OpRows(m, t)), what);
+                pm((a0, nx) => a0, "mutant.op.prefix_blind: an opcode decode that ignores the 0xFF prefix passes every op row");
+
+                Action<WhoFn, String> wm = (m, what) => mutant(MutantCaught(t => WhoRows(m, t)), what);
+                wm((ir, ib, c, u, ru, bu) => WhoRule(ir, ib, 1, u, ru, bu), "mutant.who.cid_blind: a seq match without cid 1 passes every who row");
+
+                Action<TripFn, String> tm = (m, what) => mutant(MutantCaught(t => TripRows(m, t)), what);
+                tm((op, w, f, a) => ClassOf(op), "mutant.trip.no_exemption: the bucket table alone (every Seq tail trips 'spawn') passes every trip row");
+                // [ff9mapkit netsync s156] K3d: the rule BEFORE it went self-only (the census's Seq clause) is now a wrong rule; expr_self is
+                // the shipped rule less its flag-bit term, so trip.expr_target alone must catch it
+                tm((op, w, f, a) => op == OpTerminateEntry && (w == WhoRegionSeq || w == WhoBodySeq || (f >= 0 && (f & 1) == 0 && a == 255)) ? (Byte)0 : ClassOf(op),
+                   "mutant.trip.seq_wide: the census's broad Seq exemption (a Seq ending another object) passes every trip row");
+                tm((op, w, f, a) => op == OpTerminateEntry && a == 255 ? (Byte)0 : ClassOf(op),
+                   "mutant.trip.expr_self: an EXPRESSION operand read as a constant 255 passes every trip row");
+
+                okDetail = rows + " rows, " + mutants + " mutants caught, " + NetSyncGuestLocalTable.Rows.Length + " table rows / "
+                         + NetSyncGuestLocalTable.Funcs.Length + " functions, table crc 0x" + NetSyncGuestLocalTable.TableCrc.ToString("x8");
+            }
+            catch (Exception err)
+            {
+                if (fail == null)
+                    fail = "selftest: threw " + err.GetType().Name + ": " + err.Message;
+            }
+            detail = fail ?? okDetail;
+            SelfTestVerdict = fail == null ? "ok" : "fail: " + fail;
+            return fail == null;
+        }
+
+        private static Boolean MutantCaught(Action<Action<Boolean, String>> table)
+        {
+            Boolean caught = false;
+            table((ok, what) => { if (!ok) caught = true; });
+            return caught;
+        }
+
+        private static String BlobName(Int32 b)
+        {
+            String[] names = NetSyncGuestLocalTable.BlobNames;
+            return b >= 0 && b < names.Length ? names[b] : "blob" + b;
+        }
+
+        // the CRC of a slice the rows can read safely (a wrong rule's range may not fit its blob): length 0 = 0
+        private static Boolean SliceCrcOf(Byte[] data, Int32 start, Int32 length, out UInt32 crc)
+        {
+            crc = 0u;
+            if (length == 0)
+                return true;
+            if (data == null || start < 0 || length < 0 || start + length > data.Length)
+                return false;
+            crc = Unity.IO.Compression.Crc32Helper.UpdateCrc32(0u, data, start, length);
+            return true;
+        }
+
+        // ---------------------------------------------------------------- crc: the check texts, the mutate feed, its purity
+        private static void CrcRows(Action<Boolean, String> row)
+        {
+            String[] text = NetSyncGuestLocalTable.CrcText;
+            UInt32[] want = NetSyncGuestLocalTable.CrcWant;
+            for (Int32 i = 0; i < want.Length; i++)
+            {
+                Byte[] b = Encoding.ASCII.GetBytes(text[i]);
+                UInt32 c = Unity.IO.Compression.Crc32Helper.UpdateCrc32(0u, b, 0, b.Length);
+                row(c == want[i], "crc." + i + ": \"" + text[i] + "\" gave 0x" + c.ToString("x8") + ", want 0x" + want[i].ToString("x8")
+                                  + " (Crc32Helper is not zlib's crc32)");
+            }
+            Byte[][] blobs = NetSyncGuestLocalTable.Blobs;
+            Byte[][] before = new Byte[blobs.Length][];
+            for (Int32 i = 0; i < blobs.Length; i++)
+                before[i] = (Byte[])blobs[i].Clone();
+            Int32[] fc = NetSyncGuestLocalTable.FlipCases;
+            UInt32[] fw = NetSyncGuestLocalTable.FlipCrc;
+            for (Int32 i = 0; i < fw.Length; i++)
+            {
+                Int32 b = fc[3 * i], tag = fc[3 * i + 1], at = fc[3 * i + 2];
+                Int32 st, ln;
+                Boolean found = Slice(blobs[b], tag, out st, out ln);
+                UInt32 c = found ? CrcFlip(blobs[b], st, ln, at) : 0u;
+                row(found && c == fw[i], "flip." + BlobName(b) + "." + tag + "." + at + ": "
+                                         + (found ? "crc 0x" + c.ToString("x8") + ", want 0x" + fw[i].ToString("x8") : "the function is absent")
+                                         + " (the mutate feed: one byte XOR 0x01, an out-of-range byte none)");
+            }
+            Boolean pure = true;
+            for (Int32 i = 0; i < blobs.Length; i++)
+            {
+                if (blobs[i].Length != before[i].Length)
+                {
+                    pure = false;
+                    continue;
+                }
+                for (Int32 k = 0; k < blobs[i].Length; k++)
+                    if (blobs[i][k] != before[i][k])
+                        pure = false;
+            }
+            row(pure, "flip.pure: the mutate feed wrote the bytes it hashes (it must perturb only the hasher's input)");
+        }
+
+        // ---------------------------------------------------------------- slice / match / toy (the shared vectors)
+        private static void SliceRows(SliceFn s, Action<Boolean, String> row)
+        {
+            Byte[][] blobs = NetSyncGuestLocalTable.Blobs;
+            Int32[] sc = NetSyncGuestLocalTable.SliceCases;
+            UInt32[] sw = NetSyncGuestLocalTable.SliceCrc;
+            for (Int32 i = 0; i < sw.Length; i++)
+            {
+                Int32 b = sc[4 * i], tag = sc[4 * i + 1], wantStart = sc[4 * i + 2], wantLen = sc[4 * i + 3];
+                String name = "slice." + BlobName(b) + "." + tag;
+                Int32 st, ln;
+                Boolean found = s(blobs[b], tag, out st, out ln);
+                if (wantStart < 0 && wantLen < 0)
+                {
+                    row(!found, name + ": found (" + st + ", " + ln + "), want absent (a short blob, a table past it, or no such tag)");
+                    continue;
+                }
+                UInt32 c;
+                Boolean crcOk = found && SliceCrcOf(blobs[b], st, ln, out c) && c == sw[i];
+                row(found && st == wantStart && ln == wantLen && crcOk, name + ": " + (found ? "(" + st + ", " + ln + ")" : "absent") + ", want ("
+                                                                        + wantStart + ", " + wantLen + ", crc 0x" + sw[i].ToString("x8") + ")");
+            }
+        }
+
+        private static void MatchRows(MatchFn m, Action<Boolean, String> row)
+        {
+            Byte[][] blobs = NetSyncGuestLocalTable.Blobs;
+            Int32[] mc = NetSyncGuestLocalTable.MatchCases;
+            UInt32[] mw = NetSyncGuestLocalTable.MatchCrc;
+            for (Int32 i = 0; i < mw.Length; i++)
+            {
+                Int32 b = mc[4 * i], tag = mc[4 * i + 1], wantLen = mc[4 * i + 2];
+                Boolean want = mc[4 * i + 3] != 0;
+                Boolean got = m(blobs[b], tag, wantLen, mw[i], -1);
+                row(got == want, "match." + i + ": " + BlobName(b) + " tag " + tag + " against (" + wantLen + ", 0x" + mw[i].ToString("x8") + ") read "
+                                 + (got ? "a match" : "no match") + ", want " + (want ? "a match" : "no match (the length is compared before the crc)"));
+            }
+            // the LENGTH comes first (D3): a slice one byte longer than the table's, whose whole-slice CRC IS the table's CRC, must not
+            // match -- a rule that hashes whatever length it found would (the shared cases cannot tell the two apart: their CRCs differ too)
+            Int32 ai = Array.IndexOf(NetSyncGuestLocalTable.BlobNames, "A+"), st = -1, ln = -1;
+            UInt32 whole = 0u;
+            Boolean have = ai >= 0 && Slice(blobs[ai], 3, out st, out ln) && ln >= 2 && SliceCrcOf(blobs[ai], st, ln, out whole);
+            row(have && !m(blobs[ai], 3, ln - 1, whole, -1),
+                "match.length_first: " + (have ? "A+ tag 3 (" + ln + " bytes) matched a table length of " + (ln - 1) + " (the crc was checked before the length)"
+                                              : "the shared vectors carry no A+ tag 3 of two bytes or more"));
+        }
+
+        private static void ToyRows(Action<Boolean, String> row)
+        {
+            UInt32[] want = NetSyncGuestLocalTable.ToyTableCrc;
