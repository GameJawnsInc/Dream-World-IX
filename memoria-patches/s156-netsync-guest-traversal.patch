+            row(r(A, false, false, true, true, true, true, true, false, false, false) == VNotField, "verdict.not_field: the world map (gMode 3) was looked up");
+            row(r(A, true, true, true, true, true, true, true, false, false, false) == VSpecial, "verdict.special: a Special press (a card challenge) passed");
+            row(r(A, true, false, false, true, true, true, true, false, false, false) == VNoRow, "verdict.no_row: a field / entry off the table passed");
+            row(r(A, true, false, true, false, true, true, true, false, false, false) == VUnverified, "verdict.unverified: mismatched bytes passed");
+            row(r(A, true, false, true, true, false, true, true, false, false, false) == VWrongBody, "verdict.wrong_body: the wrong body passed");
+            row(r(A, true, false, true, true, true, false, true, false, false, false) == VOwnStory, "verdict.own_story: a climb on the guest's own story passed (D5)");
+            row(r(A, true, false, true, true, true, true, false, false, false, false) == VNoControl, "verdict.no_control: a press with control off passed");
+            row(r(A, true, false, true, true, true, true, true, true, false, false) == VInFlight, "verdict.in_flight: a second climb started while one is in flight");
+            row(r(A, true, false, true, true, true, true, true, false, true, false) == VWarp, "verdict.warp: a climb started inside a fade, a load or an ending session");
+            row(r(A, true, false, true, true, true, true, true, false, false, true) == VHostScene, "verdict.host_scene: a climb started over the host's scene");
+            row(r(S, true, false, true, false, true, true, true, false, false, false) == VUnverified, "verdict.shadow_keeps_unverified: shadow hid an unverified row");
+            row(r(S, true, false, true, true, true, true, true, false, false, true) == VHostScene, "verdict.shadow_keeps_host_scene: shadow hid a transient decline");
+            // precedence: STRUCTURAL before TRANSIENT (the shadow bench reads the table's answer first)
+            row(r(A, true, false, false, false, false, false, false, true, true, true) == VNoRow, "verdict.prec.no_row_first: another term outranked 'no row'");
+            row(r(A, true, false, true, false, false, true, true, false, false, true) == VUnverified, "verdict.prec.unverified_over_scene: the host scene or the body outranked unverified bytes");
+            row(r(A, true, false, true, true, false, true, false, true, false, false) == VWrongBody, "verdict.prec.wrong_body_over_transient: a transient term outranked the wrong body");
+            row(r(A, true, false, true, true, true, false, false, false, true, true) == VOwnStory, "verdict.prec.own_story_over_transient: a transient term outranked the guest's own story");
+            row(r(A, false, true, false, false, false, false, false, true, true, true) == VNotField, "verdict.prec.not_field_first: on the world map another term spoke first");
+            // THE CONTRACT over all 3 x 1024 inputs
+            Int32 allow = 0, shadow = 0, off = 0;
+            for (Int32 mode = 0; mode < 3; mode++)
+            {
+                for (Int32 m = 0; m < 1024; m++)
+                {
+                    Int32 v = r(mode, (m & 1) != 0, (m & 2) != 0, (m & 4) != 0, (m & 8) != 0, (m & 16) != 0, (m & 32) != 0, (m & 64) != 0,
+                                (m & 128) != 0, (m & 256) != 0, (m & 512) != 0);
+                    if (v == VAllow)
+                        allow++;
+                    if (v == VShadow)
+                        shadow++;
+                    if (mode == O && v == VLeverOff)
+                        off++;
+                }
+            }
+            row(allow == 1, "verdict.contract.allow_once: Allow is reachable from " + allow + " inputs (the only one is every term passing in act)");
+            row(shadow == 1, "verdict.contract.shadow_once: Shadow is reachable from " + shadow + " inputs");
+            row(off == 1024, "verdict.contract.off_all: the off lever answers lever_off on " + off + " of 1024 inputs");
+        }
