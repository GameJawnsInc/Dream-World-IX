+        // The row lookup (pure): a binary search on Field << 8 | Entry (the table is strictly ascending: SelfTest's table.sorted).
+        internal static Int32 FindRow(GuestLocalRow[] rows, Int32 field, Int32 entry)
+        {
+            Int32 key = field << 8 | entry, lo = 0, hi = rows.Length - 1;
+            while (lo <= hi)
+            {
+                Int32 mid = (lo + hi) >> 1;
+                Int32 k = rows[mid].Field << 8 | rows[mid].Entry;
+                if (k == key)
+                    return mid;
+                if (k < key)
+                    lo = mid + 1;
+                else
+                    hi = mid - 1;
+            }
+            return -1;
+        }
+
+        // THE TABLE DIGEST (pure; the kit's guest_traversal.table_crc): per row struct.pack('<HBBB', field, entry, kind, funcCount), then
+        // per function of the row ('<BBHBHI', role, entry, tag, uid, length, crc), little-endian, no padding, in table order; CRC-32 of it.
+        internal static UInt32 TableCrcOf(GuestLocalRow[] rows, GuestLocalFunc[] funcs)
+        {
+            List<Byte> b = new List<Byte>(rows.Length * 5 + funcs.Length * 11);
+            foreach (GuestLocalRow r in rows)
