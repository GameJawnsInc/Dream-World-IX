+        // to the LATER-listed row, so a zero-length alias ends at its twin), else the blob's end. A start past the blob is found, length 0.
+        internal static Boolean Slice(Byte[] data, Int32 tag, out Int32 start, out Int32 length)
+        {
+            start = -1;
