+
+        // THE QUEUED PRESS (pure; D8a / composition G3): accepted, its handler has neither taken control nor moved the body, and at most one
+        // key tick old -- the one window where a relayed host start would race my own handler's `ifnot(usercontrol)` prologue.
+        internal static Boolean PressQueuedRule(Boolean armed, Boolean seenOff, Boolean bodyRan, Int32 keyTicksSinceAccept)
+        {
+            return armed && !seenOff && !bodyRan && keyTicksSinceAccept <= 1;
+        }
+
+        // THE TALK HOLD (pure; D8b): what the one held relayed start does on this tick. The lane still carries it: Keep (the lane's own
+        // copy). Another nonce on the lane: DropNewer (the newest wins). Another field: DropLoad. The host's scene down or another one:
+        // DropScene. The TTL runs from the climb's END, never from the hold (a long hang must not expire it). Else Keep (the held copy).
+        internal static Int32 TalkHoldRule(Boolean laneHasHeld, Boolean laneHasNewer, Boolean sameField, Boolean sceneUp, Boolean sameScene,
+                                           Boolean flightArmed, Int32 msSinceEnd, Int32 msSinceHold, Int32 ttlMs)
+        {
+            if (laneHasHeld) return HoldKeep;
+            if (laneHasNewer) return HoldDropNewer;
+            if (!sameField) return HoldDropLoad;
+            if (!sceneUp || !sameScene) return HoldDropScene;
+            if (!flightArmed && msSinceEnd >= ttlMs) return HoldDropTtl;
+            return HoldKeep;
+        }
+
+        // The opcode at an EBin.next latch (pure; DoEventCode's own decode): 0xFF prefixes the extended page.
+        internal static Int32 OpCodeOf(Int32 a0, Int32 next)
+        {
+            return a0 == 0xFF ? 0x100 + next : a0;
+        }
+
+        // The trip class of an opcode (the GENERATED table: pressclosure's non-NEUTRAL buckets; 0 = none).
+        internal static Byte ClassOf(Int32 op)
+        {
+            Byte[] t = NetSyncGuestLocalTable.OpClass;
+            return op >= 0 && op < t.Length ? t[op] : (Byte)0;
+        }
+
+        internal const Int32 OpTerminateEntry = 0x1C;
+
+        // [ff9mapkit netsync s156] THE TRIP CLASS (pure): ClassOf, less the ONE TerminateEntry form the kit SHIPS -- a CONSTANT 255 (flag
+        // bit 0 clear, operand 255: the object ending itself) is flow, never a scene change. K3d, SELF-ONLY: the classifier's census
+        // exemption (eb/pressclosure.py, the Closure walk) is wider -- any TerminateEntry a Seq runs -- but the kit's ship filter R12
+        // (guest_traversal._derive_one) refuses a closure holding any other 0x1C (every shipped one is 1c 00 ff), and the trip wire
+        // speaks the SHIPPED rule: a Seq ending ANOTHER object (EBin case 28 disposes it -- the region, or the climbing body) trips
+        // 'spawn' like any other runner. The bucket table alone cannot carry even this, so without it every Seq tail tripped 'spawn'
+        // (the s156 bench's first in-game run: 207's body Seq ends itself, 1c 00 ff, twice a climb). argFlags / arg0: the op's flag byte
+        // and first operand (-1 unread). `who` stays for the hook's call (WhoRule still attributes the op); it no longer widens anything.
+        internal static Byte TripClassRule(Int32 op, Int32 who, Int32 argFlags, Int32 arg0)
+        {
+            if (op == OpTerminateEntry && argFlags >= 0 && (argFlags & 1) == 0 && arg0 == 255)
+                return 0;
+            return ClassOf(op);
+        }
+
+        // Who is executing (pure): the pressed region, the controlled body, or a Seq of either (cid 1 at the owner's uid + cSeqOfs, the
+        // STARTSEQ object) -- else nobody of the climb's.
+        internal static Int32 WhoRule(Boolean isRegion, Boolean isBody, Int32 cid, Int32 uid, Int32 regionUid, Int32 bodyUid)
+        {
+            if (isRegion) return WhoRegion;
+            if (isBody) return WhoBody;
+            if (cid == 1 && uid == (Byte)(regionUid + EventEngine.cSeqOfs)) return WhoRegionSeq;
+            if (cid == 1 && uid == (Byte)(bodyUid + EventEngine.cSeqOfs)) return WhoBodySeq;
+            return WhoNone;
+        }
+
+        // ================================================================ THE FLIGHT
+        private static void Begin(EventEngine ee, Obj quad, PosObj ctrl, Int32 regionSx0, Int32 fldMapNo, Int32 fld, Int32 entry, Int32 row, Int32 hashed)
+        {
+            _region = quad;
+            _regionUid = quad.uid;
+            _regionSx0 = regionSx0;
+            _ctrl = ctrl;
+            _ctrlUid = ctrl.uid;
+            _ctrlSx0 = ctrl.sx;
+            _regionSeq0 = SeqOf(ee, _regionUid);
+            _ctrlSeq0 = SeqOf(ee, _ctrlUid);
+            _fld = fldMapNo;
+            _effFld = fld;
+            _entry = entry;
+            _row = row;
+            _kind = NetSyncGuestLocalTable.Rows[row].Kind;
+            _acceptKeyTick = NetSyncField.KeyTick;
+            _startTick = Environment.TickCount;
+            _seenOff = false;
+            _bodyRan = false;
+            _bodyOpenNow = false;
+            _seqOpenNow = false;
+            _longLogged = false;
+            _tpLogged = false;
+            _bootLogged = false;
+            _queuedCounted = false;
+            _endArmed = false;
+            _opObj = null;
+            _tripLatched = 0;
+            _tripCls = -1;
+            Climbs++;
+            NetSyncGuestLocalArmed.On = true;
+            Log.Message("[NetSync] guest traversal: climb started -- field " + fld + " entry " + entry + " (" + KindName(_kind) + ") on my own copy ("
+                        + hashed + " bytes verified, body uid " + _ctrlUid + ")");
+        }
+
+        // EventEngine.ProcessEvents, the top of every pass while Armed (before any script of the pass): the op latch cleared (so a C#
+        // store between passes is never a climber's), then the flight step.
+        public static void Tick(EventEngine ee)
+        {
+            _opObj = null;
+            Step(ee);
+        }
+
+        // NetSyncClient.Update, right before each ServiceTalkFollow (D8a): the control sample before the talk relay reads the flight.
+        public static void Sample()
+        {
+            if (!NetSyncGuestLocalArmed.On)
+                return;
+            try
+            {
+                Step(PersistenSingleton<EventEngine>.Instance);
+            }
+            catch
+            {
+            }
+        }
+
+        // The rare readers (GuestPress, TalkDeferWhy, RefuseTeleport): the same step Tick runs (T10: a press in the pass the dismount
+        // closes is not refused for a flight that is over), then the flag.
+        internal static Boolean InFlightNow(EventEngine ee)
+        {
+            Step(ee);
+            return NetSyncGuestLocalArmed.On;
+        }
+
+        // The one step (Tick, Sample, InFlightNow): abort on a stale record, latch what the climb has shown, end on FlightRule.
+        private static void Step(EventEngine ee)
+        {
+            if (!NetSyncGuestLocalArmed.On)
+                return;
+            try
+            {
+                String stale = StaleWhy(ee);
+                if (stale != null)
+                {
+                    Abort(stale);
+                    return;
+                }
+                Boolean control = ee.GetUserControl();
+                if (!control)
+                    _seenOff = true;
+                Boolean bodyOpen = _ctrl.sx > _ctrlSx0;
+                if (bodyOpen)
+                    _bodyRan = true;
+                Boolean seqOpen = SeqOpen(ee, _regionUid, _regionSeq0) || SeqOpen(ee, _ctrlUid, _ctrlSeq0);
+                _bodyOpenNow = bodyOpen;
+                _seqOpenNow = seqOpen;
+                Int32 r = FlightRule(NetSyncField.KeyTick - _acceptKeyTick, _seenOff, _bodyRan, control, bodyOpen, seqOpen);
+                if (r != FlightRunning)
+                {
+                    End(r);
+                    return;
+                }
+                if (!_longLogged && Environment.TickCount - _startTick >= LongClimbMs)
+                {
+                    _longLogged = true;
+                    LongClimbs++;
+                    Log.Message("[NetSync] guest traversal: climb at field " + _effFld + " entry " + _entry + " still in flight after " + (LongClimbMs / 1000)
+                                + " s (control " + (control ? "on" : "off") + ", body frame " + (bodyOpen ? "open" : "done") + (seqOpen ? ", a seq running" : "")
+                                + ") -- no watchdog: the ~ menu's Reload is the escape");
+                }
+            }
+            catch (Exception err)
+            {
+                if (!_stepFaultLogged)
+                {
+                    _stepFaultLogged = true;
+                    Log.Error(err, "[NetSync] guest traversal: the flight step faulted -- the record is dropped (the climb runs on as stock)");
+                }
+                Abort("the flight step faulted (" + err.GetType().Name + ")");
+            }
+        }
+
+        // Why the record no longer describes a climb on this copy (null = it still does). The spectator gate is read HERE only, never per
+        // opcode (IsLiveFollowedSession touches the socket).
+        private static String StaleWhy(EventEngine ee)
+        {
+            if (ee == null || ee.gMode != 1)
+                return "the screen changed (a battle, the world map or the title)";
+            if (FF9StateSystem.Common.FF9.fldMapNo != _fld)
+                return "another field loaded (a follow warp, a reload or the exit ramp)";
+            if (!NetSyncField.SpectatorField)
+                return "the spectator gate fell (co-op ended or the bench lever went off)";
+            if (!ReferenceEquals(ee.FindObjByUID(_regionUid), _region))
+                return "the field was reloaded (the region object is gone)";
+            if (!ReferenceEquals(ee.GetControlChar(), _ctrl))
+                return "control moved to another body";
+            return null;
+        }
+
+        private static Obj SeqOf(EventEngine ee, Int32 ownerUid)
+        {
+            Obj s = ee.FindObjByUID((Byte)(ownerUid + EventEngine.cSeqOfs));
+            return s != null && s.cid == 1 ? s : null;
+        }
+
+        private static Boolean SeqOpen(EventEngine ee, Int32 ownerUid, Obj atPress)
+        {
+            Obj s = SeqOf(ee, ownerUid);
+            return s != null && !ReferenceEquals(s, atPress);
+        }
+
+        private static void End(Int32 outcome)
+        {
+            Ended++;
+            if (outcome == FlightBailed)
+                Bailed++;
+            Log.Message("[NetSync] guest traversal: climb ended -- field " + _effFld + " entry " + _entry + " (" + KindName(_kind) + "), "
+                        + (Environment.TickCount - _startTick) + " ms"
+                        + (outcome == FlightBailed ? ", bailed: the handler never took control or moved the body"
+                           : !_bodyRan ? ", the handler returned without moving the body" : ""));
+            _endTick = Environment.TickCount;
+            _endArmed = true;
+            ClearFlight();
+        }
+
+        private static void Abort(String why)
+        {
+            Aborted++;
+            AbortWhy = why;
+            Log.Message("[NetSync] guest traversal: climb no longer tracked -- " + why + " (field " + _effFld + " entry " + _entry + ", "
+                        + (Environment.TickCount - _startTick) + " ms)");
+            ClearFlight();
+            if (_heldNonce >= 0)
+                DropHeld("my climb was dropped (" + why + ")");
+        }
+
+        private static void ClearFlight()
+        {
+            NetSyncGuestLocalArmed.On = false;
+            _region = null;
+            _ctrl = null;
+            _regionSeq0 = null;
+            _ctrlSeq0 = null;
+            _opObj = null;
+        }
+
+        // ApplyTalkStart (NetSyncClient C3, only while Armed and after s155's usercontrol defer): null = no climb holds the relay back.
+        internal static String TalkDeferWhy(EventEngine ee)
+        {
+            if (!InFlightNow(ee))
+                return null;
+            if (PressQueuedRule(true, _seenOff, _bodyRan, NetSyncField.KeyTick - _acceptKeyTick))
+            {
+                if (!_queuedCounted)
+                {
+                    _queuedCounted = true;
+                    TalkQueued++;
+                }
+                return TalkQueuedWhy;
+            }
+            return TalkTailWhy;
+        }
+
+        // NetSyncDiorama.PrimeWarmReturn (only while Armed): a host battle booted mid-climb. Owner default 6: accept it and say so; the
+        // boot itself is not held (its in-game proof is R3's duo row). The line names the climb (its effective field, entry and kind).
+        internal static void NoteBoot(Int32 field, String bootMode)
+        {
+            if (!NetSyncGuestLocalArmed.On)
+                return;
+            BootsMidClimb++;
+            if (_bootLogged)
+                return;
+            _bootLogged = true;
+            Log.Message("[NetSync] guest traversal: a host battle booted mid-climb on field " + _effFld + " entry " + _entry + " (" + KindName(_kind)
+                        + ") -- its return is " + (bootMode == "warm" ? "WARM" : "COLD") + " (accepted, not held: owner default 6; unproven in game until R3)");
+        }
+
+        // ================================================================ THE TRIP WIRES (telemetry only: never alters an op)
+        // EBin.next, at every opcode start while Armed: attribution AT THE OPCODE to the climbing objects only (an ambient line or a
+        // chaser's battle elsewhere in the room never trips). The latch (_opObj) is what OnStore attributes a GLOB store to.
+        public static void OnOp(Obj s1, Int32 a0)
+        {
+            try
+            {
+                if (s1 == null)
+                {
+                    _opObj = null;
+                    return;
+                }
+                Int32 who = WhoRule(ReferenceEquals(s1, _region), ReferenceEquals(s1, _ctrl), s1.cid, s1.uid, _regionUid, _ctrlUid);
+                if (who == WhoNone)
+                {
+                    _opObj = null;
+                    return;
+                }
+                _opObj = s1;
+                _opWho = who;
+                _opIp = s1.ip;
+                Int32 op = OpCodeOf(a0, a0 == 0xFF ? s1.getByteIP(1) : 0);
+                Int32 argFlags = -1, arg0 = -1;
+                if (op == OpTerminateEntry)                      // [ff9mapkit netsync s156] the exemption's operands (a blob end reads as unread)
+                {
+                    try
+                    {
+                        argFlags = s1.getByteIP(1);
+                        arg0 = s1.getByteIP(2);
+                    }
+                    catch
+                    {
+                        argFlags = arg0 = -1;
+                    }
+                }
+                Byte cls = TripClassRule(op, who, argFlags, arg0);
+                if (cls != 0)
+                    Trip(cls, s1.uid, "op 0x" + op.ToString("X2"), cls < NetSyncGuestLocalTable.OpClassNames.Length ? NetSyncGuestLocalTable.OpClassNames[cls] : "class " + cls);
+            }
+            catch
+            {
+                _opObj = null;
+            }
+        }
+
+        // EBin.SetVariableValueInternal while Armed: a gEventGlobal store made BY a climbing object's opcode -- the latched object must
+        // still be the executing one (T12) -- outside the netsync cells 2032..2041 (co-op's own every-frame writes).
+        public static void OnStore(Byte[] buffer, Int32 ofs, EBin.VariableType type, Int32 bufferOffset)
+        {
+            try
+            {
+                Obj o = _opObj;
+                if (o == null)
+                    return;
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                if (ee == null || !ReferenceEquals(ee.gExec, o))
+                    return;
+                Byte[] g = FF9StateSystem.EventState.gEventGlobal;
+                if (g == null || !ReferenceEquals(buffer, g))
+                    return;
+                Int32 b = (type == EBin.VariableType.Bit || type == EBin.VariableType.SBit ? ofs >> 3 : ofs) + bufferOffset;
+                if (b >= 2032 && b <= 2041)
+                    return;
+                Trip(-1, o.uid, "byte " + b, "glob");
+            }
+            catch
+            {
+            }
+        }
+
+        // cls -1 = the glob wire. A stayed / re-executed op at the same (class, uid, ip) counts once; the line latches per class per climb.
+        private static void Trip(Int32 cls, Int32 uid, String what, String clsName)
+        {
+            if (_tripCls == cls && _tripUid == uid && _tripIp == _opIp)
+                return;
+            _tripCls = cls;
+            _tripUid = uid;
+            _tripIp = _opIp;
+            TripsTotal++;
+            if (cls < 0)
+                TripsGlob++;
+            else
+                TripsOp++;
+            LastTrip = "trip " + clsName + " " + what + " by " + WhoNames[_opWho] + " uid " + uid + " at ip " + _opIp + " on field " + _effFld + " entry " + _entry;
+            Int32 bit = cls < 0 ? GlobTripLatchBit : 1 << Math.Min(cls, 29);
+            if ((_tripLatched & bit) != 0)
+                return;
+            _tripLatched |= bit;
+            Log.Message("[NetSync] guest traversal: " + LastTrip + " -- telemetry only, the op runs as stock");
+        }
+
+        // ================================================================ THE TELEPORT REFUSAL (NetSyncClient.TeleportToHostImpl, C6)
+        // True = refuse: a guest climb is in flight (validated first, so a flight that just landed never refuses). The named line goes
+        // once per climb; the client's TpDecline line follows by its own latch.
+        internal static Boolean RefuseTeleport(String path)
+        {
+            try
+            {
+                if (!InFlightNow(PersistenSingleton<EventEngine>.Instance))
+                    return false;
+                TpRefusals++;
+                if (!_tpLogged)
+                {
+                    _tpLogged = true;
+                    Log.Message("[NetSync] guest traversal: " + path + " refused -- a guest climb is in flight (field " + _effFld + " entry " + _entry
+                                + "); it ends on its own, the ~ menu's Reload is the escape");
+                }
+                return true;
+            }
+            catch
+            {
+                return false;
+            }
+        }
+
+        // ================================================================ THE TALK HOLD (NetSyncClient.ServiceTalkFollow, C4; D8b)
+        internal static Int32 TalkHeldNonce
+        {
+            get { return _heldNonce; }
+        }
+
+        // C4b: a relayed host start my copy deferred while a climb is in flight is kept (one slot; a newer nonce replaces it).
+        internal static void HoldTalk(Byte[] body, Int32 sceneNonce)
+        {
+            try
+            {
+                if (!NetSyncGuestLocalArmed.On || body == null || body.Length < 5 || body[4] == _heldNonce)
+                    return;
+                if (_heldNonce >= 0)
+                    DropHeld("a newer relayed start replaced it");
+                _heldBody = (Byte[])body.Clone();
+                _heldNonce = body[4];
+                _heldScene = sceneNonce;
+                _heldField = FF9StateSystem.Common.FF9.fldMapNo;
+                _heldTick = Environment.TickCount;
+                TalkHeld++;
+                Log.Message("[NetSync] guest traversal: relayed talk start " + _heldNonce + " (obj " + (body[2] | body[3] << 8)
+                            + ") held while my own climb is in flight");
+            }
+            catch
+            {
+            }
+        }
+
+        // C4a: the talk body ServiceTalkFollow serves this tick. Nothing held: the lane's. Held: TalkHoldRule keeps it (the lane's own copy
+        // while it still rides, else the held copy, so s155's expiry never fires while my climb holds control) or drops it with one line.
+        internal static Byte[] TalkLane(Byte[] laneBody, Boolean sceneUp, Int32 sceneNonce, Int32 ttlMs)
+        {
+            try
+            {
+                if (_heldNonce < 0)
+                    return laneBody;
+                Boolean onLane = laneBody != null && laneBody.Length >= 5;
+                Boolean laneHasHeld = onLane && laneBody[4] == _heldNonce;
+                Boolean laneHasNewer = onLane && laneBody[4] != _heldNonce;
+                Boolean sameField = FF9StateSystem.Common.FF9.fldMapNo == _heldField;
+                Boolean sameScene = _heldScene >= 0 && sceneNonce == _heldScene;
+                Boolean armed = NetSyncGuestLocalArmed.On;
+                Int32 now = Environment.TickCount;
+                Int32 sinceEnd = armed ? -1 : _endArmed ? now - _endTick : ttlMs;   // no end recorded off a flight: expired
+                Int32 h = TalkHoldRule(laneHasHeld, laneHasNewer, sameField, sceneUp, sameScene, armed, sinceEnd, now - _heldTick, ttlMs);
+                if (h == HoldKeep)
+                    return laneHasHeld ? laneBody : _heldBody;
