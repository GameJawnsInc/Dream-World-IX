+        internal static void NoteFault(String site, Exception err)
+        {
+            Faults++;
+            LastFault = site + ": " + (err != null ? err.Message : "?");
+            if (_faultSites.Count < 32 && _faultSites.Add(site))
+                Log.Error(err, "[NetSync] step-out: " + site + " fault (logged once per site; the body stays as stock draws it)");
+        }
