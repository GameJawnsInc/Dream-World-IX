+        // ================================================================ the stand-in
+
+        private static void SpawnStandIn(Actor body)
+        {
+            try
+            {
+                DespawnStandIn();
+                String geo;
+                if (!FF9BattleDB.GEO.TryGetValue((Int32)body.netDressSrc, out geo) || String.IsNullOrEmpty(geo))
+                    geo = SourceGeoFallback;
+                GameObject g = ModelFactory.CreateModel(geo, false, true, Configuration.Graphics.ElementsSmoothTexture);
+                if (g == null && geo != SourceGeoFallback)
+                {
+                    geo = SourceGeoFallback;
+                    g = ModelFactory.CreateModel(geo, false, true, Configuration.Graphics.ElementsSmoothTexture);
+                }
+                if (g == null)
+                {
+                    NoteFault("stand-in", new InvalidOperationException("CreateModel returned null for " + geo));
+                    return;
+                }
+                _standin = g;                           // owned from here: a fault below is torn down by the catch's DespawnStandIn
+                _standinGeo = geo;
+                GeoTexAnim.addTexAnim(g, geo);          // texture anims (blinking etc.) -- engine parity, as the ghost
+                AnimationFactory.AddAnimToGameObject(g, geo);
+                g.name = "NetSyncStandIn";
+                g.SetActive(true);
+                Transform bt = body.go.transform;
+                g.transform.parent = bt.parent;         // the body's own frame (the field map)
+                g.transform.localPosition = bt.localPosition;
+                g.transform.localRotation = bt.localRotation;
+                g.transform.localScale = bt.localScale;
+                SetLayerRecursive(g, body.go.layer);
+                Renderer[] rends = g.GetComponentsInChildren<Renderer>();
+                Boolean[] rest = new Boolean[rends.Length];
+                Material[][] mats = new Material[rends.Length][];
+                for (Int32 i = 0; i < rends.Length; i++)
+                {
+                    Renderer renderer = rends[i];
+                    if (renderer == null)
+                        continue;
+                    rest[i] = renderer.enabled;         // CreateModel's own field-mode hides stay hidden
+                    SkinnedMeshRenderer smr = renderer as SkinnedMeshRenderer;
+                    if (smr != null)
+                    {
+                        smr.updateWhenOffscreen = false;   // placed by the PSX projection IN THE SHADER: never frustum-cull it
+                        smr.localBounds = new Bounds(Vector3.zero, new Vector3(100000f, 100000f, 100000f));
+                    }
+                    mats[i] = renderer.materials;
+                    foreach (Material material in mats[i])
+                    {
+                        material.shader = ShadersLoader.Find(Configuration.Shaders.FieldCharacterShader);
+                        ModelFactory.SetMatFilter(material, Configuration.Graphics.ElementsSmoothTexture);
+                    }
+                }
+                NormalSolver.SmoothCharacterMesh(rends);
+                _standinAnim = g.GetComponent<Animation>();
+                _standinRends = rends;
+                _standinMats = mats;
+                _standinRest = rest;
+                _standinClip = null;
+                _standinSrc = -1;
+                _standinShown = true;
+                StandinSpawns++;
+                ShowStandIn(_stockVisible);
+                g.AddComponent<NetSyncStandIn>();
+                Follow(g);
+            }
+            catch (Exception err)
+            {
+                NoteFault("stand-in", err);
+                DespawnStandIn();
+            }
+        }
+
+        private static void ShowStandIn(Boolean visible)
+        {
+            if (_standin == null || _standinRends == null || _standinShown == visible)
+                return;
+            for (Int32 i = 0; i < _standinRends.Length; i++)
+                if (_standinRends[i] != null)
+                    _standinRends[i].enabled = visible && _standinRest[i];
+            _standinShown = visible;
+        }
+
+        // THE DESPAWN, the ghost's sanctioned way (NetSyncClient.DespawnGhost): GeoTexAnim is a HonoBehavior, so the SYSTEM unregisters
+        // and destroys it (a raw Destroy mid-field races its sweep). A stand-in the field teardown already destroyed reads null here.
+        private static void DespawnStandIn()
+        {
+            GameObject g = _standin;
+            _standin = null;
+            _standinAnim = null;
+            _standinRends = null;
+            _standinMats = null;
+            _standinRest = null;
+            _standinGeo = null;
+            _standinClip = null;
+            _standinSrc = -1;
+            _bodyNorm = -1f;
+            if (g == null)
+                return;
+            try
+            {
+                Boolean systemOwnsDestroy = false;
+                HonoBehavior[] hbs = g.GetComponentsInChildren<HonoBehavior>(true);
+                if (hbs != null && hbs.Length > 0 && hbs[0] != null)
+                {
+                    hbs[0].UnregisterHonoBehavior(dispose: true);
+                    systemOwnsDestroy = true;
+                }
+                if (!systemOwnsDestroy)
+                    UnityEngine.Object.Destroy(g);
+            }
+            catch (Exception err)
+            {
+                NoteFault("despawn", err);
+            }
+        }
+
+        // NetSyncStandIn.LateUpdate (and once at the spawn): the body's local TRS, its source clip at its own normalized time, its material
+        // state.
+        internal static void Follow(GameObject g)
+        {
+            try
+            {
+                if (!_active || _body == null || g == null || !ReferenceEquals(g, _standin))
+                    return;
+                GameObject bgo = _body.go;
+                if (bgo == null)
+                    return;
+                Transform bt = bgo.transform;
+                Transform st = g.transform;
+                if (st.parent != bt.parent)
+                    st.parent = bt.parent;
+                st.localPosition = bt.localPosition;
+                st.localRotation = bt.localRotation;
+                st.localScale = bt.localScale;
+                StandinFrames++;
+                CopyMaterialState();
+                if (_standinAnim == null)
+                    return;
+                Int32 src = SourceAnim(_body);
+                String clip;
+                if (!FF9DBAll.AnimationDB.TryGetValue(src, out clip) || String.IsNullOrEmpty(clip))
+                    return;
+                if (clip != _standinClip)
+                {
+                    if (_standinAnim.GetClip(clip) == null)
+                        AnimationFactory.AddAnimWithAnimatioName(g, clip);
+                    if (_standinAnim.GetClip(clip) == null)
+                    {
+                        StandinMissingClip++;
+                        return;                         // keep the clip already playing
+                    }
+                    _standinAnim.Play(clip);
+                    _standinClip = clip;
+                }
+                _standinSrc = src;
+                Single norm = BodyNorm(_body, bgo);
+                _bodyNorm = norm;
+                AnimationState ss = _standinAnim[clip];
+                if (ss != null)
+                {
+                    ss.speed = 0f;
+                    ss.time = norm * ss.length;
+                    _standinAnim.Sample();
+                }
+            }
+            catch (Exception err)
+            {
+                NoteFault("follow", err);
+            }
+        }
+
+        // The body's normalized clip time: its playing clip's state (smoothed per render frame), else the logical animFrame / frameN
+        // (PlayAnimationViaEventScript's own sample).
+        private static Single BodyNorm(Actor body, GameObject bgo)
+        {
+            Animation ba = bgo.GetComponent<Animation>();
+            String bc;
+            if (ba != null && FF9DBAll.AnimationDB.TryGetValue((Int32)body.anim, out bc) && bc != null)
+            {
+                AnimationState bs = ba[bc];
+                if (bs != null && bs.length > 0f)
+                {
+                    Single n = bs.time / bs.length;
+                    if (n > 1f || n < 0f)
+                        n -= Mathf.Floor(n);
+                    return n;
+                }
+            }
+            return body.frameN > 0 ? (Single)body.animFrame / (Single)body.frameN : 0f;
+        }
+
+        // The body's material state onto the stand-in, every frame: fldchar writes the room tint (_Color rgb), the blend shader
+        // (RunModelCode 0: PSX/Actor_Abr_N and back) and the slice (RunModelCode 4: _Slice) ONLY onto the registered body, hidden or not.
+        private static void CopyMaterialState()
+        {
+            if (_standinMats == null || _bodyRend == null)
+                return;
+            Material src = _bodyRend.sharedMaterial;   // the body's own instance (fldchar's renderer.material made it): no new copy
+            if (src == null)
+                return;
+            Color32 c0 = src.GetColor("_Color");
+            Boolean slice = src.HasProperty("_Slice");
+            Single sliceV = slice ? src.GetFloat("_Slice") : 0f;
+            for (Int32 i = 0; i < _standinMats.Length; i++)
+            {
+                Material[] ms = _standinMats[i];
+                if (ms == null)
+                    continue;
+                for (Int32 j = 0; j < ms.Length; j++)
+                {
+                    Material m = ms[j];
+                    if (m == null)
+                        continue;
+                    if (m.shader != src.shader)
+                        m.shader = src.shader;
+                    if (m.renderQueue != src.renderQueue)
+                        m.renderQueue = src.renderQueue;
+                    if (slice && m.HasProperty("_Slice"))
+                        m.SetFloat("_Slice", sliceV);
+                    Color32 c = m.GetColor("_Color");
+                    if (c.r != c0.r || c.g != c0.g || c.b != c0.b)
+                    {
+                        c.r = c0.r;
+                        c.g = c0.g;
+                        c.b = c0.b;
+                        m.SetColor("_Color", c);
+                    }
+                }
+            }
+        }
+
+        private static void SetLayerRecursive(GameObject go, Int32 layer)
+        {
+            go.layer = layer;
+            foreach (Transform child in go.transform)
+                SetLayerRecursive(child.gameObject, layer);
+        }
