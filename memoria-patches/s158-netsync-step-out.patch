+        internal static Int32 SourceAnim(Actor a)
+        {
+            String name;
+            if (!FF9DBAll.AnimationDB.TryGetValue((Int32)a.anim, out name))
+                name = null;
+            NetSyncVisitor.Rig src;
+            Int32 srcIdle = NetSyncVisitor.TryGetRig(0, out src) ? src.Idle : a.anim;
+            return SourceAnimRule(a.anim, a.netSelfDress != 0, a.netRawAnims, a.idle, a.walk, a.run, a.turnl, a.turnr, a.sleep, a.jump,
+                                  a.netJumpSrc, name, srcIdle);
+        }
