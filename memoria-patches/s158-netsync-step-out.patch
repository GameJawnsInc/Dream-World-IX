+        // ================================================================ the episode (NetSyncClient.ServiceStepOut gathers the inputs)
+
+        // A relayed talk start was applied on my copy (ServiceTalkFollow's accept): it owns the control-off episode it starts ON THIS FIELD.
+        internal static void NoteRelayAccept(Int32 field)
+        {
+            _talkArmed = true;
+            _talkTick = Environment.TickCount;          // tick-baseline law: armed bool + delta
+            _talkField = field;
+            TalkAccepts++;
+        }
+
+        internal static void Tick(EventEngine ee, Boolean eligible, Boolean onField, Int32 fld, Actor local, Boolean hostHere,
+                                  Boolean hostCtlOff, Boolean hostScene, Boolean talkLane)
+        {
+            try
+            {
+                Int32 now = Environment.TickCount;
+                Boolean myCtl = ee == null || ee.GetUserControl();
+                if (_talkArmed && (!onField || fld != _talkField || (myCtl && now - _talkTick >= TalkOwnMs)))
+                    _talkArmed = false;                 // the talk's episode is over, its handler never took control, or the field changed
+                Boolean climb = NetSyncGuestLocalArmed.On && NetSyncGuestLocal.InFlightNow(ee);
+                Boolean talk = _talkArmed || talkLane;
+                if (eligible && onField)
+                {
+                    if (fld != _snapField)
+                    {
+                        _baseWindows.Clear();           // a new field: no window of the last one is old here
+                        _snapField = fld;
+                    }
+                    if (myCtl)
+                        _baseWindows.Take();            // frozen from the frame my control falls: a strip open with control on is old
+                }
+                InEligible = eligible;
+                InHostHere = hostHere;
+                InHostCtlOff = hostCtlOff;
+                InMyCtlOff = !myCtl;
+                InClimb = climb;
+                InTalk = talk;
+                InHostScene = hostScene;
+                if (_active)
+                {
+                    InLine = false;
+                    if (myCtl)
+                    {
+                        if (!_backArmed)
+                        {
+                            _backArmed = true;
+                            _backSince = now;
+                        }
+                    }
+                    else
+                        _backArmed = false;
+                    Boolean sameField = onField && fld == _field;
+                    Boolean sameBody = local != null && ReferenceEquals(local, _body) && local.go != null;
+                    Int32 end = EndRule(eligible, LeverOff, sameField, sameBody, myCtl, _backArmed ? now - _backSince : -1, _talkArmed, climb);
+                    BaseWhyNotNow = null;
+                    if (end != InNone)
+                        StepIn(end);
+                    return;
+                }
+                String whyNot = BaseWhyNot(eligible && onField && local != null && local.go != null, LeverOff, hostHere, hostCtlOff,
+                                           !myCtl, climb, talk);
+                BaseWhyNotNow = whyNot;
+                if (whyNot != null)
+                {
+                    InLine = false;
+                    _baseArmed = false;
+                    return;
+                }
+                if (!_baseArmed)
+                {
+                    _baseArmed = true;
+                    _baseSince = now;                   // the dwell's clock; the fresh-line snapshot is my control's (above)
+                }
+                Boolean line = _baseWindows.AnyFresh();
+                InLine = line;
+                Int32 start = StartRule(line, now - _baseSince);
+                if (start != OutNone)
+                    StepOut(local, fld, start);
+            }
+            catch (Exception err)
+            {
+                NoteFault("tick", err);
+                if (_active)
+                    StepIn(InSession);                  // FAIL OPEN: a broken tick must never leave the body dark
+            }
+        }
+
+        private static void StepOut(Actor local, Int32 fld, Int32 why)
+        {
+            _active = true;
+            NetSyncStepOutArmed.On = true;
+            _body = local;
+            _uid = local.uid;
+            _field = fld;
+            _dressed = local.netSelfDress != 0;
+            _outTick = Environment.TickCount;
+            _outWhy = why;
+            _backArmed = false;
+            _baseArmed = false;
+            _stockVisible = ((Int32)local.flags & 1) == 1 && local.frontCamera;
+            Outs++;
+            OutBy[why]++;
+            if (_dressed)
+            {
+                SpawnStandIn(local);
+                if (_standin == null)
+                    _dressed = false;                   // no stand-in: the body stays lit (the guest is never left without its part)
+            }
+            if (_dressed)
+                DarkenNow(local);
+            local.tempFlag = -1;                        // SetRenderer re-evaluates the body at its next pass (the term keeps it dark)
+            Log.Message("[NetSync] step-out: OUT on field " + fld + " (uid " + _uid + ", " + (_dressed
+                        ? "dressed: the body hides, a " + _standinGeo + " stand-in plays its part"
+                        : "undressed: the body stays") + "; the host's ghost hides, my wire mask is 0) -- " + OutNames[why]);
+        }
+
+        // THE EDGE, synchronous: the dressed body's renderers off NOW (stock's own else-branch does the same at the next SetRenderer pass,
+        // which runs only inside a logic tick), the actors under it recorded for StepIn, and the source's eye height swapped in.
+        private static void DarkenNow(Actor body)
+        {
+            try
+            {
+                _children.Clear();
+                foreach (FieldMapActor fma in body.go.GetComponentsInChildren<FieldMapActor>(true))
+                    if (fma != null && fma.actor != null && !ReferenceEquals(fma.actor, body))
+                        _children.Add(fma.actor);
+                Renderer[] rends = body.go.GetComponentsInChildren<Renderer>();
+                _bodyRend = rends.Length > 0 ? rends[0] : null;
+                _bodyRends = rends;
+                _bodyWasOn = new Boolean[rends.Length];
+                for (Int32 k = 0; k < rends.Length; k++)
+                {
+                    if (rends[k] == null)
+                        continue;
+                    _bodyWasOn[k] = rends[k].enabled;
+                    rends[k].enabled = false;
+                }
+                NetSyncVisitor.Rig src;
+                if (NetSyncVisitor.TryGetRig(0, out src) && src.Eye != 0)
+                {
+                    _eyeKept = body.eye;
+                    _eyeSet = (Int16)(-4 * src.Eye);    // AtSetModel's own formula, on the source rig (98 -> 93 in every stock init)
+                    body.eye = _eyeSet;
+                    _eyeSwapped = true;
+                }
+            }
+            catch (Exception err)
+            {
+                NoteFault("darken", err);
+            }
+        }
+
+        private static void StepIn(Int32 why)
+        {
+            Boolean wasDressed = _dressed;
+            Int32 field = _field;
+            Int32 ms = Environment.TickCount - _outTick;
+            _active = false;
+            NetSyncStepOutArmed.On = false;
+            try
+            {
+                if (_body != null && _eyeSwapped && _body.eye == _eyeSet)
+                    _body.eye = _eyeKept;               // a PosObj field: restored even when the field (and the go) is gone
+                ShowStandIn(false);                     // the stand-in leaves THIS frame (its GameObject is disposed by the system later)
+                if (_body != null && _body.go != null)
+                {
+                    if (wasDressed && _stockVisible && _bodyRends != null && _bodyWasOn != null)
+                        for (Int32 k = 0; k < _bodyRends.Length && k < _bodyWasOn.Length; k++)
+                            if (_bodyRends[k] != null && _bodyWasOn[k])
+                                _bodyRends[k].enabled = true;   // THE EDGE, synchronous: what the darken turned off (stock's pass refines it)
+                    _body.tempFlag = -1;                // the body's stock visibility is re-applied at the next SetRenderer pass
+                }
+                for (Int32 k = 0; k < _children.Count; k++)
+                    if (_children[k] != null)
+                        _children[k].tempFlag = -1;     // a prop detached mid-episode re-evaluates too (it is no longer under the body)
+            }
+            catch (Exception err)
+            {
+                NoteFault("step in", err);
+            }
+            _children.Clear();
+            _eyeSwapped = false;
+            _bodyRend = null;
+            _bodyRends = null;
+            _bodyWasOn = null;
+            DespawnStandIn();
+            _body = null;
+            _uid = -1;
+            _field = -1;
+            _dressed = false;
+            _baseArmed = false;
+            _backArmed = false;
+            Ins++;
+            InBy[why]++;
+            Log.Message("[NetSync] step-out: IN on field " + field + " after " + ms + " ms (" + (wasDressed ? "the body is back" : "undressed")
+                        + ") -- " + InNames[why]);
+        }
+
+        // The session boundary (NetSyncClient.ResetIntentAndL1State: OnDestroy, a redial, a reconfigure).
+        internal static void Reset()
+        {
+            try
+            {
+                if (_active)
+                    StepIn(InSession);
+            }
+            catch (Exception err)
+            {
+                NoteFault("reset", err);
+            }
+            _talkArmed = false;
+            _baseArmed = false;
+            _baseWindows.Clear();
+            _snapField = -1;
+        }
+
+        // ================================================================ the hooks
+
+        // ProcessEvents.SetRenderer, behind NetSyncStepOutArmed.On: the stepped-out DRESSED body's flag4 is false (its meshes and what it
+        // carries go dark through stock's own else-branch); the caller keeps the STOCK flag4 for the blob shadow. Records the body's stock
+        // visibility for the stand-in. Every other object, and an undressed body, keep their flag4.
+        internal static Boolean Renderer(PosObj po, Boolean flag4, Boolean flag5)
+        {
+            try
+            {
+                if (!_active || !ReferenceEquals(po, _body))
+                    return flag4;
+                _stockVisible = flag4 && flag5;
+                ShowStandIn(_stockVisible);
+                return _dressed ? false : flag4;
+            }
+            catch (Exception err)
+            {
+                NoteFault("renderer", err);
+                return flag4;
+            }
+        }
+
+        // NetSyncClient's paired ghost block (live and the selftest mirror), after its own mask rule: true = hide the ghost.
+        internal static Boolean GhostHide(UInt16 wireMask, Boolean hostPlainScene, Boolean myStepOut)
+        {
+            Int32 h = GhostHideRule(wireMask, hostPlainScene, myStepOut);
+            Int32 frame = Time.frameCount;
+            Boolean fresh = frame - _hideFrame <= 2;    // the ghost was driven last frame: an episode of hiding continues
+            if (h != GhostHideNow || !fresh)
+            {
+                if (h != HideNone && (h != GhostHideNow || !fresh))
+                {
+                    GhostHideEdges++;
+                    HideBy[h]++;
+                }
+                GhostHideNow = h;
+            }
+            _hideFrame = frame;
+            return h != HideNone;
+        }
+
+        internal static UInt16 WireMask(UInt16 mask)
+        {
+            UInt16 m = WireMaskRule(_active, mask);
+            WireMaskNow = m;
+            return m;
+        }
