+        internal static Int32 EndRule(Boolean eligible, Boolean leverOff, Boolean sameField, Boolean sameBody, Boolean myCtl, Int32 ctlBackMs,
+                                      Boolean talkStarted, Boolean climb)
+        {
+            if (!eligible)
+                return InSession;
+            if (leverOff)
+                return InLever;
+            if (!sameField)
+                return InField;
+            if (!sameBody)
+                return InBody;
+            if (talkStarted)
+                return InTalkStart;
+            if (climb)
+                return InClimbStart;
+            if (myCtl && ctlBackMs >= StepInMs)
+                return InControl;
+            return InNone;
+        }
+
+        // THE WIRE: stepped out, the host is told nothing of me is visible.
+        internal static UInt16 WireMaskRule(Boolean active, UInt16 mask)
+        {
+            return active ? (UInt16)0 : mask;
+        }
+
+        // THE GHOST (both screens): my own step-out hides the peer's ghost; a zero wire mask hides it in every dress branch; a host's own
+        // plain scene (not a relayed talk) hides its guest's ghost.
+        internal static Int32 GhostHideRule(UInt16 wireMask, Boolean hostPlainScene, Boolean myStepOut)
+        {
+            if (myStepOut)
+                return HideStepOut;
+            if (wireMask == 0)
+                return HideMask;
+            if (hostPlainScene)
+                return HideHostScene;
+            return HideNone;
+        }
+
+        // THE SOURCE CLIP of a body: undressed plays its own; dressed -- the last play when that is what plays, the matching slot's raw,
+        // the jump slot's source, a ZDN clip as itself, else the source rig's idle.
+        internal static Int32 SourceAnimRule(Int32 cur, Boolean dressed, UInt16[] raws, UInt16 idle, UInt16 walk, UInt16 run, UInt16 turnl,
+                                             UInt16 turnr, UInt16 sleep, UInt16 jump, UInt16 jumpSrc, String curName, Int32 srcIdle)
+        {
+            if (!dressed)
+                return cur;
+            if (raws != null && raws.Length >= RawN)
+            {
+                if (raws[RawPlayMapped] == cur && raws[RawPlay] != 0)
+                    return raws[RawPlay];
+                if (cur == idle && raws[RawIdle] != 0)
+                    return raws[RawIdle];
+                if (cur == walk && raws[RawWalk] != 0)
+                    return raws[RawWalk];
+                if (cur == run && raws[RawRun] != 0)
+                    return raws[RawRun];
+                if (cur == turnl && raws[RawTurnL] != 0)
+                    return raws[RawTurnL];
+                if (cur == turnr && raws[RawTurnR] != 0)
+                    return raws[RawTurnR];
+                if (cur == sleep && raws[RawSleep] != 0)
+                    return raws[RawSleep];
+            }
+            if (cur == jump && jumpSrc != 0)
+                return jumpSrc;
+            if (curName != null && curName.IndexOf("_ZDN_", StringComparison.Ordinal) >= 0)
+                return cur;
+            return srcIdle;
+        }
+
+        // ================================================================ the raw records (NetSyncSelfDress calls these; dressed bodies only)
+
+        // MapAndAttach, after the map: the raw id this site asked for (a PLAY records its mapped id too; s157's twin miss re-records
+        // the fallback it plays -- NetSyncSelfDress.TwinMissed -- so RawPlayMapped is always what the body plays).
+        internal static void NoteRaw(Actor actor, Int32 site, Int32 raw, Int32 mapped)
+        {
+            try
+            {
+                UInt16[] r = actor.netRawAnims;
+                if (r == null)
+                    actor.netRawAnims = r = new UInt16[RawN];
+                switch (site)
+                {
+                    case NetSyncSelfDress.SitePlay: r[RawPlay] = (UInt16)raw; r[RawPlayMapped] = (UInt16)mapped; break;
+                    case NetSyncSelfDress.SiteIdle: r[RawIdle] = (UInt16)raw; break;
+                    case NetSyncSelfDress.SiteWalk: r[RawWalk] = (UInt16)raw; break;
+                    case NetSyncSelfDress.SiteRun: r[RawRun] = (UInt16)raw; break;
+                    case NetSyncSelfDress.SiteTurnL: r[RawTurnL] = (UInt16)raw; break;
+                    case NetSyncSelfDress.SiteTurnR: r[RawTurnR] = (UInt16)raw; break;
+                    case NetSyncSelfDress.SiteSleep: r[RawSleep] = (UInt16)raw; break;
+                }
+            }
+            catch (Exception err)
+            {
+                NoteFault("raw", err);
+            }
+        }
+
+        // AttachDress's COLD store, before it maps the slots: the raw ids the script set before the dress (an unset slot = the source
+        // rig's own, as a stock Zidane body would play). A record that exists (a warm return carried it) is kept.
+        internal static void NoteDressSlots(Actor actor)
+        {
+            try
+            {
+                if (actor.netRawAnims != null)
+                    return;
+                NetSyncVisitor.Rig src;
+                Boolean haveSrc = NetSyncVisitor.TryGetRig(0, out src);
+                UInt16[] r = new UInt16[RawN];
+                r[RawIdle] = actor.idle != 0 ? actor.idle : haveSrc ? src.Idle : (UInt16)0;
+                r[RawWalk] = actor.walk != 0 ? actor.walk : haveSrc ? src.Walk : (UInt16)0;
+                r[RawRun] = actor.run != 0 ? actor.run : haveSrc ? src.Run : (UInt16)0;
+                r[RawTurnL] = actor.turnl != 0 ? actor.turnl : haveSrc ? src.TurnL : (UInt16)0;
+                r[RawTurnR] = actor.turnr != 0 ? actor.turnr : haveSrc ? src.TurnR : (UInt16)0;
+                r[RawSleep] = actor.sleep;
+                actor.netRawAnims = r;
+            }
+            catch (Exception err)
+            {
+                NoteFault("dress slots", err);
+            }
+        }
+
+        // KeepJumpTimeline: the jump slot plays now -- the last play is its source clip.
+        internal static void NoteJumpPlay(Actor actor)
+        {
+            try
+            {
+                if (actor.netJumpSrc == 0)
+                    return;
+                UInt16[] r = actor.netRawAnims;
+                if (r == null)
+                    actor.netRawAnims = r = new UInt16[RawN];
+                r[RawPlay] = actor.netJumpSrc;
+                r[RawPlayMapped] = actor.jump;
+            }
+            catch (Exception err)
+            {
+                NoteFault("jump play", err);
+            }
+        }
