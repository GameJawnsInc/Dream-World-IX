+        // ================================================================ the harness (HarnessAgent.AppendStepOut, the `stepout` sub-verb)
+
+        internal static String HarnessLeverName { get { return _lever == 1 ? "off" : null; } }
+        internal static Int32 HarnessField { get { return _active ? _field : -1; } }
+        internal static Int32 HarnessUid { get { return _active ? _uid : -1; } }
+        internal static Boolean HarnessDressed { get { return _active && _dressed; } }
+        internal static String HarnessWhy { get { return _active ? OutNames[_outWhy] : null; } }
+        internal static Int32 HarnessAgeMs { get { return _active ? Environment.TickCount - _outTick : -1; } }
+        internal static Int32 HarnessBaseAgeMs { get { return !_active && _baseArmed ? Environment.TickCount - _baseSince : -1; } }
+        internal static Boolean HarnessStockVisible { get { return _active && _stockVisible; } }
+        internal static Boolean HarnessStandinOn { get { return _standin != null; } }
+        internal static Boolean HarnessStandinShown { get { return _standin != null && _standinShown; } }
+        internal static String HarnessStandinGeo { get { return _standin != null ? _standinGeo : null; } }
+        internal static String HarnessStandinClip { get { return _standin != null ? _standinClip : null; } }
+        internal static Int32 HarnessStandinSrc { get { return _standin != null ? _standinSrc : -1; } }
+        internal static Single HarnessBodyNorm { get { return _standin != null && _body != null && _body.go != null ? BodyNorm(_body, _body.go) : -1f; } }
+        internal static Boolean HarnessTalkArmed { get { return _talkArmed; } }
+        internal static String HarnessGhostHideName { get { return Time.frameCount - _hideFrame <= 2 ? HideNames[GhostHideNow] : null; } }
+
+        // The stand-in's OWN clip time, read off its AnimationState at the publish (not the value Follow wrote): -1 = none.
+        internal static Single HarnessStandinNorm
+        {
+            get
+            {
+                if (_standin == null || _standinAnim == null || _standinClip == null)
+                    return -1f;
+                AnimationState ss = _standinAnim[_standinClip];
+                return ss != null && ss.length > 0f ? ss.time / ss.length : -1f;
+            }
+        }
+
+        // The distance from the stand-in to the body (-1 = no stand-in): a follow that lags or never ran reads > 0.
+        internal static Single HarnessStandinDpos
+        {
+            get
+            {
+                if (_standin == null || _body == null || _body.go == null)
+                    return -1f;
+                return Vector3.Distance(_standin.transform.localPosition, _body.go.transform.localPosition);
+            }
+        }
+
+        // The stand-in's enabled renderers (-1 = none).
+        internal static Int32 HarnessStandinRendsOn
+        {
+            get
+            {
+                if (_standin == null || _standinRends == null)
+                    return -1;
+                Int32 n = 0;
+                for (Int32 i = 0; i < _standinRends.Length; i++)
+                    if (_standinRends[i] != null && _standinRends[i].enabled)
+                        n++;
+                return n;
+            }
+        }
+
+        // The CONTROLLED body's enabled renderers (-1 = no body): 0 while a dressed body is stepped out.
+        internal static Int32 HarnessBodyRendsOn
+        {
+            get
+            {
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                Actor a = ee != null ? ee.GetControlChar() as Actor : null;
+                if (a == null || a.go == null)
+                    return -1;
+                Int32 n = 0;
+                foreach (Renderer r in a.go.GetComponentsInChildren<Renderer>())
+                    if (r != null && r.enabled)
+                        n++;
+                return n;
+            }
+        }
+
+        // The controlled body's blob shadow: 1 drawn, 0 not, -1 no shadow (the step-out keeps it on the STOCK flag4).
+        internal static Int32 HarnessShadowOn
+        {
+            get
+            {
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                Actor a = ee != null ? ee.GetControlChar() as Actor : null;
+                if (a == null || a.fieldMapActor == null || a.fieldMapActor.shadowMeshRenderer == null)
+                    return -1;
+                return a.fieldMapActor.shadowMeshRenderer.enabled ? 1 : 0;
+            }
+        }
+
+        // Stock's own shadow switch on the controlled body (DisableShadow / EnableShadow: FF9Char attr bit 16): 1 off, 0 on, -1 none. The
+        // bench judges `shadow` against it -- a stock climb turns the shadow off itself.
+        internal static Int32 HarnessShadowOff
+        {
+            get
+            {
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                Actor a = ee != null ? ee.GetControlChar() as Actor : null;
+                if (a == null)
+                    return -1;
+                FF9Char ch = FF9StateSystem.Common.FF9.FF9GetCharPtr((Int32)a.uid);
+                return ch == null ? -1 : (ch.attr & 16u) != 0 ? 1 : 0;
+            }
+        }
+
+        // `netsync stepout act|off|clear` (selftest role only, the role refused first). off = CALIBRATION: the base fails on the lever and
+        // a live step-out steps in; act / clear = the shipping rule. Counters are never reset (read DELTAS).
+        internal static Boolean HarnessLever(String[] args, out String why)
+        {
+            why = null;
+            if (!NetSyncClient.IsSelfTestRole)
+            {
+                why = "netsync stepout: needs the selftest role (netsync selftest 1)";
+                return false;
+            }
+            String op = args != null && args.Length > 1 && args[1] != null ? args[1].ToLowerInvariant() : "";
+            if (args == null || args.Length != 2 || (op != "act" && op != "off" && op != "clear"))
+            {
+                why = "netsync stepout: expected act|off|clear";
+                return false;
+            }
+            _lever = op == "off" ? 1 : 0;
+            Log.Message("[NetSync] harness: step-out " + (op == "off" ? "OFF -- CALIBRATION: never step out (released with the harness)" : "ACT"));
+            return true;
+        }
+
+        // NetSyncBattle.HarnessReleaseBench: the lever back to act.
+        internal static void HarnessRelease()
+        {
+            if (_lever != 0)
+                Log.Message("[NetSync] harness: step-out lever released (act)");
+            _lever = 0;
+        }
+
+        // ================================================================ THE PROOF (the selftest proof block: "step-out selftest: OK (N rows, M mutants caught)")
+
+        private delegate String BaseFn(Boolean eligible, Boolean leverOff, Boolean hostHere, Boolean hostCtlOff, Boolean myCtlOff, Boolean climb, Boolean talk);
+        private delegate Int32 StartFn(Boolean line, Int32 ageMs);
+        private delegate Int32 EndFn(Boolean eligible, Boolean leverOff, Boolean sameField, Boolean sameBody, Boolean myCtl, Int32 backMs,
+                                     Boolean talkStarted, Boolean climb);
+        private delegate UInt16 WireFn(Boolean active, UInt16 mask);
+        private delegate Int32 HideFn(UInt16 mask, Boolean plain, Boolean stepOut);
+        private delegate Int32 SrcFn(Int32 cur, Boolean dressed, UInt16[] raws, UInt16 idle, UInt16 walk, UInt16 run, UInt16 turnl,
+                                     UInt16 turnr, UInt16 sleep, UInt16 jump, UInt16 jumpSrc, String name, Int32 srcIdle);
+
+        private sealed class Rules
+        {
+            public BaseFn Base = BaseWhyNot;
+            public StartFn Start = StartRule;
+            public EndFn End = EndRule;
+            public WireFn Wire = WireMaskRule;
+            public HideFn Hide = GhostHideRule;
+            public SrcFn Src = SourceAnimRule;
+        }
+
+        // Every row, against one rule set; the failing rows' names go to `fails`.
+        private static Int32 Rows(Rules r, List<String> fails)
+        {
+            Int32 n = 0;
+            Action<Boolean, String> row = (ok, name) => { n++; if (!ok) fails.Add(name); };
+            // the base: all terms hold, then each one failing alone names itself (and the order: eligibility first)
+            row(r.Base(true, false, true, true, true, false, false) == null, "base.all");
+            row(r.Base(false, true, false, false, false, true, true) == "not a following, mirroring guest on a field", "base.order");
+            row(r.Base(true, true, true, true, true, false, false) != null, "base.lever");
+            row(r.Base(true, false, false, true, true, false, false) != null, "base.host_away");
+            row(r.Base(true, false, true, false, true, false, false) != null, "base.host_control");
+            row(r.Base(true, false, true, true, false, false, false) != null, "base.my_control");
+            row(r.Base(true, false, true, true, true, true, false) != null, "base.climb");
+            row(r.Base(true, false, true, true, true, false, true) != null, "base.talk");
+            // the start: a fresh line at once; THE ARRIVAL LAW: none, under the dwell, never
+            row(r.Start(true, 0) == OutLine, "start.line_now");
+            row(r.Start(false, 0) == OutNone, "start.arrival_0");
+            row(r.Start(false, DwellMs - 1) == OutNone, "start.arrival_dwell_minus_1");
+            row(r.Start(false, DwellMs) == OutDwell, "start.dwell");
+            row(r.Start(true, DwellMs) == OutLine, "start.line_first");
+            // the end: debounced control, never while control is off, the field / body / session / lever at once, a talk or a climb
+            // started inside the episode at once -- even inside the debounce
+            row(r.End(true, false, true, true, true, StepInMs - 1, false, false) == InNone, "end.debounce");
+            row(r.End(true, false, true, true, true, StepInMs, false, false) == InControl, "end.control");
+            row(r.End(true, false, true, true, false, -1, false, false) == InNone, "end.still_off");
+            row(r.End(true, false, false, true, false, -1, false, false) == InField, "end.field");
+            row(r.End(true, false, true, false, false, -1, false, false) == InBody, "end.body");
+            row(r.End(false, false, true, true, false, -1, false, false) == InSession, "end.session");
+            row(r.End(true, true, true, true, false, -1, false, false) == InLever, "end.lever");
+            row(r.End(true, false, true, true, true, 40, true, false) == InTalkStart, "end.talk_in_debounce");
+            row(r.End(true, false, true, true, true, 40, false, true) == InClimbStart, "end.climb_in_debounce");
+            // the wire: stepped out = 0, else the mask as it is
+            row(r.Wire(true, 0x1F) == 0, "wire.out");
+            row(r.Wire(false, 0x1F) == 0x1F, "wire.in");
+            // the ghost: my step-out, a zero mask, a host's plain scene; nothing else
+            row(r.Hide(0x1F, false, true) == HideStepOut, "hide.step_out");
+            row(r.Hide(0, false, false) == HideMask, "hide.mask0");
+            row(r.Hide(0x1F, true, false) == HideHostScene, "hide.host_scene");
+            row(r.Hide(0x1F, false, false) == HideNone, "hide.none");
+            // the source clip (synthetic ids: 10 = rig idle slot, 11 = rig walk, 90 = the idle alias, 200 = source idle,
+            // 25 = source walk, 500 = a source gesture, 600 = a source jump clip)
+            UInt16[] raws = new UInt16[RawN];
+            raws[RawIdle] = 200; raws[RawWalk] = 25; raws[RawPlay] = 500; raws[RawPlayMapped] = 90;
+            row(r.Src(25, false, raws, 10, 11, 0, 0, 0, 0, 90, 600, null, 200) == 25, "src.undressed");
+            row(r.Src(90, true, raws, 10, 11, 0, 0, 0, 0, 90, 600, null, 200) == 500, "src.last_play");
+            row(r.Src(10, true, raws, 10, 11, 0, 0, 0, 0, 90, 600, null, 200) == 200, "src.idle_slot");
+            row(r.Src(11, true, raws, 10, 11, 0, 0, 0, 0, 90, 600, null, 200) == 25, "src.walk_slot");
+            UInt16[] jumped = (UInt16[])raws.Clone();
+            jumped[RawPlayMapped] = 0;
+            row(r.Src(90, true, jumped, 10, 11, 0, 0, 0, 0, 90, 600, null, 200) == 600, "src.jump_slot");
+            row(r.Src(77, true, raws, 10, 11, 0, 0, 0, 0, 90, 600, "ANH_MAIN_F0_ZDN_X", 200) == 77, "src.zdn_name");
+            row(r.Src(77, true, raws, 10, 11, 0, 0, 0, 0, 90, 600, "ANH_MAIN_F0_STN_X", 200) == 200, "src.fallback");
+            row(r.Src(10, true, null, 10, 11, 0, 0, 0, 0, 90, 0, null, 200) == 200, "src.no_record");
+            return n;
+        }
+
+        // The mutants, each a plausible wrong rule the rows must catch.
+        private static Rules Mutant(String name)
+        {
+            Rules m = new Rules();
+            switch (name)
+            {
+                case "no_dwell": m.Start = (line, age) => line ? OutLine : OutDwell; break;
+                case "no_debounce": m.End = (e, l, f, b, c, ms, t, cl) => EndRule(e, l, f, b, c, c ? StepInMs : ms, t, cl); break;
+                case "end_talk_blind": m.End = (e, l, f, b, c, ms, t, cl) => EndRule(e, l, f, b, c, ms, false, cl); break;
+                case "end_climb_blind": m.End = (e, l, f, b, c, ms, t, cl) => EndRule(e, l, f, b, c, ms, t, false); break;
+                case "climb_blind": m.Base = (e, l, h, hc, mc, climb, t) => BaseWhyNot(e, l, h, hc, mc, false, t); break;
+                case "talk_blind": m.Base = (e, l, h, hc, mc, c, talk) => BaseWhyNot(e, l, h, hc, mc, c, false); break;
+                case "host_control_blind": m.Base = (e, l, h, hc, mc, c, t) => BaseWhyNot(e, l, h, true, mc, c, t); break;
+                case "wire_leak": m.Wire = (a, mask) => mask; break;
+                case "mask_blind": m.Hide = (mask, plain, so) => so ? HideStepOut : plain ? HideHostScene : HideNone; break;
+                case "scene_blind": m.Hide = (mask, plain, so) => so ? HideStepOut : mask == 0 ? HideMask : HideNone; break;
+                case "play_blind": m.Src = (cur, d, raws, i, w, ru, tl, tr, sl, j, js, nm, si) => SourceAnimRule(cur, d, null, i, w, ru, tl, tr, sl, j, js, nm, si); break;
+                case "dress_blind": m.Src = (cur, d, raws, i, w, ru, tl, tr, sl, j, js, nm, si) => SourceAnimRule(cur, true, raws, i, w, ru, tl, tr, sl, j, js, nm, si); break;
+            }
+            return m;
+        }
+
+        private static readonly String[] MutantNames = { "no_dwell", "no_debounce", "end_talk_blind", "end_climb_blind", "climb_blind",
+                                                         "talk_blind", "host_control_blind", "wire_leak", "mask_blind", "scene_blind",
+                                                         "play_blind", "dress_blind" };
+
+        internal static Boolean SelfTest(out String detail)
+        {
+            try
+            {
+                List<String> fails = new List<String>();
+                Int32 rows = Rows(new Rules(), fails);
+                if (fails.Count > 0)
+                {
+                    detail = "row " + fails[0] + " failed (" + fails.Count + " of " + rows + ")";
+                    SelfTestVerdict = "fail: " + fails[0];
+                    return false;
+                }
+                // the live tables the rules lean on
+                NetSyncVisitor.Rig src;
+                if (!NetSyncVisitor.TryGetRig(0, out src) || src.Idle == 0 || src.Eye == 0)
+                {
+                    detail = "row live.source_rig failed (rig 0 has no idle or no eye)";
+                    SelfTestVerdict = "fail: live.source_rig";
+                    return false;
+                }
+                rows++;
+                Int32 caught = 0;
+                for (Int32 k = 0; k < MutantNames.Length; k++)
+                {
+                    List<String> mf = new List<String>();
+                    Rows(Mutant(MutantNames[k]), mf);
+                    if (mf.Count == 0)
+                    {
+                        detail = "mutant " + MutantNames[k] + " was not caught";
+                        SelfTestVerdict = "fail: mutant " + MutantNames[k];
+                        return false;
+                    }
+                    caught++;
+                }
+                detail = rows + " rows, " + caught + " mutants caught, dwell " + DwellMs + " ms, step-in " + StepInMs + " ms";
+                SelfTestVerdict = "ok";
+                return true;
+            }
+            catch (Exception err)
+            {
+                detail = "threw: " + err.Message;
+                SelfTestVerdict = "fail: threw";
+                return false;
+            }
+        }
+    }
+}
