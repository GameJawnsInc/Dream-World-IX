+            Bool(sb, "active", Try(() => Memoria.Netsync.NetSyncClient.HarnessChestActive, false)); sb.Append(",");
+            Num(sb, "uid", Try(() => (Int64)Memoria.Netsync.NetSyncClient.HarnessChestUid, -1L)); sb.Append(",");
+            Num(sb, "script_bits", Try(() => Memoria.Netsync.NetSyncClient.HarnessChestScriptBits, -1L)); sb.Append(",");
+            Num(sb, "age_ms", Try(() => (Int64)Memoria.Netsync.NetSyncClient.HarnessChestAgeMs, -1L)); sb.Append(",");
+            Num(sb, "accepted", Try(() => (Int64)Memoria.Netsync.NetSyncClient.HarnessChestAccepted, 0L)); sb.Append(",");
+            Num(sb, "served", Try(() => (Int64)Memoria.Netsync.NetSyncClient.HarnessChestServed, 0L)); sb.Append(",");
