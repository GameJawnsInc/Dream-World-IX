+
+        private static readonly String[] MutantNames = { "relay_raw_read", "relay_any_reader", "relay_no_window", "serve_any_reader",
+                                                         "serve_all_bits", "serve_world", "retire_any_window", "retire_title",
+                                                         "keep_my_field_only", "keep_always", "keep_blip_drops", "holds_event_any_seq",
+                                                         "round_trip_never", "press_drop_every_landing", "expiry_from_ingest",
+                                                         "by_host_any_close", "lapse_never", "fallback_always_cancel",
+                                                         "choice_fixed_cancel_row", "choice_any_cancel_row", "choice_cancel_holds",
+                                                         "own_blind_pick", "dest_intent_only", "dest_gateway", "dest_reloads_the_ate_field",
+                                                         "dest_press_blind", "usable_any_field", "usable_ending", "entrance_round3",
+                                                         "exit_arm_never", "exit_arm_same_field", "exit_arm_entrance_blind",
+                                                         "exit_arm_unknown_skips", "exit_keep_never", "accept_no_exemption",
+                                                         "accept_whole_field", "exit_end_uncapped", "exit_end_on_load",
+                                                         "chain_never", "chain_blind_pick", "land_chain_ignored",
+                                                         "ep_host_left_unseen", "host_latch_never", "tail_first_tick_cap",
+                                                         "hold_uncapped", "hold_ctl_blind",
+                                                         "hold_prepick_blind", "hold_pending_none_only", "hold_prepick_shared_clock",
+                                                         "restamp_never", "restamp_uncapped", "land_by_id", "ctl_no_debounce",
+                                                         "stale_no_wrap", "step_any_caption", "step_blind", "line_any_caption",
+                                                         "line_blind" };
+
+        internal static Boolean SelfTest(out String detail)
+        {
+            try
+            {
+                List<String> fails = new List<String>();
+                Int32 rows = Rows(new Rules(), fails);
+                if (fails.Count > 0)
+                {
+                    detail = "row " + fails[0] + " failed (" + fails.Count + " of " + rows + ")";
+                    SelfTestVerdict = "fail: " + fails[0];
+                    return false;
+                }
+                Int32 caught = 0;
+                for (Int32 k = 0; k < MutantNames.Length; k++)
+                {
+                    List<String> mf = new List<String>();
+                    Rows(Mutant(MutantNames[k]), mf);
+                    if (mf.Count == 0)
+                    {
+                        detail = "mutant " + MutantNames[k] + " was not caught";
+                        SelfTestVerdict = "fail: mutant " + MutantNames[k];
+                        return false;
+                    }
+                    caught++;
+                }
+                detail = rows + " rows, " + caught + " mutants caught, arm " + ArmTicks + " key ticks, press " + PressTtlMs + "/" + PressCapMs
+                         + " ms, pending " + PreHoldMs + " ms, prepick " + PrepickHoldMs + " ms, hub " + HubHoldMs + "/" + HubCaptionCapMs
+                         + " ms, tail " + TailHoldMs + "/" + TailCapMs + " ms, exit " + ExitHoldMs + " ms";
+                SelfTestVerdict = "ok";
+                return true;
+            }
+            catch (Exception err)
+            {
+                detail = "threw: " + err.Message;
+                SelfTestVerdict = "fail: threw";
+                return false;
+            }
+        }
+    }
+}
