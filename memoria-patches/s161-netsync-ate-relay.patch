+        // read that asks for Select, the lever on.
+        internal static UInt32 ServeRule(Boolean pending, Boolean leverOff, Int32 gMode, Int32 pUid, Int32 pField, Int32 readerUid,
+                                         Int32 field, UInt32 readMask)
