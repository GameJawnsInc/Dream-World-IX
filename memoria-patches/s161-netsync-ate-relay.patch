+        // HOST: does this window open relay the armed press? An ATE caption, run by the reader that hit Select, on its field, 0..ArmTicks
+        // key ticks after the hit.
+        internal static Boolean HostRelays(Boolean ateCaption, Boolean armed, Int32 armUid, Int32 armField, Int32 armTick,
+                                           Int32 openerUid, Int32 field, Int32 tick)
+        {
+            Int32 d = tick - armTick;
