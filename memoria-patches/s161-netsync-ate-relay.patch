+                case "keep_blip_drops": m.Keep = (pf, mf, wf, hf) => pf == mf || pf == wf || pf == hf; break;             // round 2's rejected fix
+                case "holds_event_any_seq": m.HoldsEvent = (p, pf, ps, f, s) => p && f == pf; break;
+                case "round_trip_never": m.RoundTrip = (hl, hf, pf) => false; break;
+                case "press_drop_every_landing": m.PressLand = (pf, ld) => false; break;
+                case "expiry_from_ingest": m.Expiry = (si, lv) => si >= PressCapMs ? ExpCap : si >= PressTtlMs ? ExpTtl : ExpNone; break;
+                case "by_host_any_close": m.ByHost = (ex) => true; break;                                                 // round 1's first cut
+                case "lapse_never": m.Lapse = (c, o) => false; break;
+                case "fallback_always_cancel": m.Fallback = (cc) => true; break;
+                case "choice_fixed_cancel_row": m.Choice = (q, c, cr) => q && c != AteCancelRow; break;                   // round 1's constant
+                case "choice_any_cancel_row": m.Choice = (q, c, cr) => q && c != cr; break;                               // round 2's rule
+                case "choice_cancel_holds": m.Choice = (q, c, cr) => q; break;
+                case "own_blind_pick": m.Own = (l, ph, bh, sp, ef, mf) => OwnJumpRule(l, ph, true, sp < 0 ? 0 : sp, ef, mf); break;
+                case "dest_intent_only": m.Dest = (mc, d, i, hf, ef, hl, pd) => mc || i <= 0 ? -1 : i; break;              // round 1's DEST pass
+                case "dest_gateway": m.Dest = (mc, d, i, hf, ef, hl, pd) => DestJump(false, d, i, hf, ef, hl, pd); break;
+                case "usable_any_field": m.Usable = (f, rg) => f > 0; break;                                               // round 3's fall to the bounce
+                case "usable_ending": m.Usable = (f, rg) => f > 0 && f != 65535 && rg; break;
+                case "entrance_round3": m.Entrance = (rd, d, hf) => !rd && hf != d; break;                                // round 3's rule
+                case "exit_arm_never": m.ExitArm = (rd, d, ef, hl, he, ee) => false; break;                               // round 3: no exit hold
+                case "exit_arm_same_field": m.ExitArm = (rd, d, ef, hl, he, ee) => !rd && !hl && (he < 0 || ee < 0 || he == ee); break;
+                case "exit_arm_entrance_blind": m.ExitArm = (rd, d, ef, hl, he, ee) => !rd && d != ef && !hl; break;      // round 4's rule
+                case "exit_arm_unknown_skips": m.ExitArm = (rd, d, ef, hl, he, ee) => !rd && d != ef && !hl && he == ee; break;
