+                    if (byHost && sincePickMs >= 0 && sincePickMs < HubHoldMs)
+                        return HoldHub;
+                    if (!byHost && choiceQueued && prepickMs < PrepickHoldMs)
+                        return HoldPrepick;
+                }
+                else if (phase == PhaseDest && tailFirstMs < TailCapMs && tailProgressMs >= 0 && tailProgressMs < TailHoldMs)
+                    return HoldTail;
+            }
+            return pendingHere && pressQueued && preMs < PreHoldMs ? HoldPending : HoldNone;
+        }
+
+        // GUEST: does an open title card restart the pick's clock? HUB, the pick standing, an ATE caption open, within HubCaptionCapMs of
+        // the first pick (an ADV lost to a ring gap must not hold the follow forever).
+        internal static Boolean CaptionRestamps(Int32 phase, Boolean byHost, Boolean captionOpen, Int32 sinceFirstPickMs)
+        {
+            return phase == PhaseHub && byHost && captionOpen && sinceFirstPickMs >= 0 && sinceFirstPickMs < HubCaptionCapMs;
+        }
+
+        // GUEST: the phase after a field load. The HUB's own jump landing where it passed for = DEST (a same-field ATE lands on the same id:
+        // the landing, not the id, decides); a DEST landing on the chained ATE's field = DEST again (its tail keeps the hold and the
+        // never-reload rule); anything else ends the episode.
+        internal static Int32 LandingStep(Int32 phase, Int32 ownJump, Int32 landed, Int32 chainField)
+        {
+            if (phase == PhaseDest && chainField > 0 && chainField == landed)
+                return PhaseDest;
+            return phase == PhaseHub && ownJump >= 0 && ownJump == landed ? PhaseDest : PhaseNone;
+        }
+
+        // GUEST: my control back this long ends the episode (backMs -1 = control is off).
+        internal static Boolean CtlEnds(Int32 phase, Int32 backMs)
+        {
+            return phase != PhaseNone && backMs >= CtlBackMs;
+        }
+
+        // GUEST: is a queued choice event for my menu's key STALE when that menu opens from press `pressSeq`? Older than the press: it
+        // answered a host menu this copy never opened (kind 3 #k < CHO #k < kind 3 #k+1 in the ring's one seq space).
+        internal static Boolean StaleChoice(Int32 eventSeq, Int32 pressSeq)
+        {
+            return NetSyncDialog.SeqAfter((UInt16)pressSeq, (UInt16)eventSeq);
+        }
+
+        // The step-out's extra base term: null = it holds, else the words (BaseWhyNot's style). Only the relay's own captions (relayOwned).
+        internal static String StepOutWhyNot(Boolean ateOpen, Boolean exemptOff, Boolean relayOwned)
+        {
+            return ateOpen && relayOwned && !exemptOff ? StepOutTerm : null;
+        }
+
+        // Is this window a fresh line for the step-out's rules (NetSyncWindowSnapshot.AnyFresh, both screens)? The relay's own ATE caption
+        // never is; any other window is, a kit compulsory-ATE line included.
+        internal static Boolean CaptionCountsAsLine(Boolean ateCaption, Boolean exemptOff, Boolean relayOwned)
+        {
+            return !(ateCaption && relayOwned) || exemptOff;
+        }
+
+        // ================================================================ HOST
+
+        // TapScriptKeyIfHost's control-on branch: a Select hit by `uid` (host role, or the tap-record bench playing the host). `Arms` counts
+        // every hit, the lever's too (the bench's proof that the raw read ran); the lever refuses the arm itself.
+        internal static void ArmHostPress(Int32 uid, Int32 field, Int32 tick)
+        {
+            Arms++;
+            if (LeverOff)
+                return;
+            _hostArmed = true;
+            _hostUid = uid;
+            _hostField = field;
+            _hostTick = tick;
+            Rearm();
+        }
+
+        // ================================================================ the window hook (ETb.NewMesWin, behind NetSyncAteArmed.On)
+
+        public static void OnWindowOpened(Dialog d)
+        {
+            try
+            {
+                if (d == null)
+                    return;
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                if (ee == null || ee.gMode != 1)
+                    return;
+                Obj exec = ee.gExec;
+                Int32 opener = exec != null ? exec.uid : -1;
+                Int32 fld = FF9StateSystem.Common.FF9.fldMapNo;
+                Boolean ate = d.CapType == Dialog.CaptionType.ActiveTimeEvent;
+                if (_hostArmed)
+                {
+                    if (HostRelays(ate, true, _hostUid, _hostField, _hostTick, opener, fld, NetSyncField.KeyTick))
+                    {
+                        _hostArmed = false;
+                        _hostExemptField = fld;        // the relayed menu and its title are the relay's own captions here, until the next load
+                        Relayed++;
+                        NetSyncClient.EmitAtePress(opener, d.Id, d.TextId, d.CancelChoice);
+                    }
+                    else if (NetSyncField.KeyTick - _hostTick > ArmTicks || fld != _hostField)
+                        _hostArmed = false;            // past the window: that Select opened no ATE window (the read runs every frame)
+                }
+                if (_pending && OpenRetires(true, ate, d.HasChoices, _pUid, _pField, opener, fld))
+                {
+                    Boolean same = d.Id == _pWin && d.TextId == _pText;
+                    if (!same)
+                        Mismatched++;
+                    Log.Message("[NetSync] ATE relay: host seq " + _pSeq + " opened my copy's ATE menu (win " + d.Id + " text " + d.TextId
+                                + ", uid " + opener + ", " + _pServes + " key tick(s) served)"
+                                + (same ? "" : " -- the host's was win " + _pWin + " text " + _pText + ": its choice event will not match"));
+                    Opened++;
+                    NetSyncClient.AteDropStaleChoices(fld, d.Id, d.TextId, _pSeq);   // an older press's choices: a host menu this copy never opened
+                    StartEpisode(fld, d.Id, d.TextId, _pSeq, d.CancelChoice);
+                    ClearPending();
+                    if (!ExemptOff)
+                        NetSyncStepOut.NoteAteMenu();  // an active step-out steps in: the menu is the relay's caption, not a party scene
+                }
+                else if (_phase == PhaseDest && fld == _epField)
+                    _tailProgress = Environment.TickCount;   // my copy reached another line of the ATE: progress for the TAIL hold
+            }
+            catch (Exception err)
+            {
+                NoteFault("window", err);
+            }
+            finally
+            {
+                Rearm();
+            }
+        }
+
+        // ================================================================ GUEST
+
+        // NetSyncDialog.IngestRing: a kind-3 event (r.A uid, r.B text, r.C win, r.X the host menu's cancel row). A newer press replaces an
+        // older one (the older one's choice events are dropped when the menu opens: NetSyncDialog.DropStaleChoices).
+        internal static void Ingest(Int32 seq, Int32 field, Int32 uid, Int32 text, Int32 win, Int32 cancel, Int32 now)
+        {
+            Ingested++;
+            if (LeverOff)
+            {
+                Log.Message("[NetSync] ATE relay: host seq " + seq + " (field " + field + " uid " + uid + ") ignored -- the ate lever is off");
+                return;
+            }
+            if (_pending)
+                Drop("superseded by host seq " + seq);
+            _pending = true;
+            _pSeq = seq;
+            _pField = field;
+            _pUid = uid;
+            _pWin = win;
+            _pText = text;
+            _pCancel = cancel;
+            _pSince = now;                             // tick-baseline law: read only while _pending
+            _pServes = 0;
+            _pLiveArmed = false;
+            _pHostLeft = false;
+            Log.Message("[NetSync] ATE relay: host seq " + seq + " queued (field " + field + " uid " + uid + " opened its ATE menu, win "
+                        + win + " text " + text + ") -- served to that reader's control-on Select reads until my copy's menu opens");
+            Rearm();
+        }
+
+        // NetSyncField.FilterScriptButtons' control-on branch (a following guest's poll): the pending press for THIS reader, or 0.
+        // Every key tick until the retire -- the count is telemetry only, never the proof.
+        internal static UInt32 TakeServe(Obj reader, UInt32 readMask, Int32 gMode)
+        {
+            try
+            {
+                if (!_pending || reader == null)
+                    return 0u;
+                UInt32 bits = ServeRule(true, LeverOff, gMode, _pUid, _pField, reader.uid, FF9StateSystem.Common.FF9.fldMapNo, readMask);
+                if (bits != 0u)
+                {
+                    if (_pServes == 0)
+                        Log.Message("[NetSync] ATE relay: host seq " + _pSeq + " served to uid " + reader.uid + "'s Select read (key tick "
+                                    + NetSyncField.KeyTick + ")");
+                    _pServes++;
+                    Served++;
+                }
+                return bits;
+            }
+            catch (Exception err)
+            {
+                NoteFault("serve", err);
+                return 0u;
+            }
+        }
+
+        // NetSyncDialog.ApplyEvents: a host CHOICE event closed a locked window on my copy. `exact` = the host's own row landed (not the
+        // window's fallback).
+        internal static void NoteHostChoice(Dialog d, Int32 field, Int32 picked, Boolean exact)
+        {
+            try
+            {
+                if (_phase != PhaseHub || d == null || d.CapType != Dialog.CaptionType.ActiveTimeEvent || field != _epField
+                    || d.Id != _epWin || d.TextId != _epText)
+                    return;
+                _pick = picked;
+                if (!ByHostRule(exact))
+                {
+                    Inexact++;
+                    Log.Message("[NetSync] ATE relay: the host's row is masked on my copy's ATE menu (win " + d.Id + " text " + d.TextId
+                                + ") -- it closed with " + picked + "; no own jump passes and the follow is not held");
+                    return;
+                }
+                _byHost = true;
+                _pickTick = _pickFirstTick = Environment.TickCount;
+                Picks++;
+                Log.Message("[NetSync] ATE relay: the host's choice " + picked + " closed my copy's ATE menu (win " + d.Id + " text "
+                            + d.TextId + ") -- while my control stays off, my copy runs the host's branch: its own Field() passes and the "
+                            + "follow waits for it");
+            }
+            catch (Exception err)
+            {
+                NoteFault("choice", err);
+            }
+        }
+
+        // NetSyncClient.RedirectGuestFieldJump (a following guest's field-mode MAPJUMP), BEFORE its own passes. TRUE = my copy's own jump
+        // goes to `dest` -- `redirected`: rewritten to the host's field (the caller seeds the host's entrance and commits the move);
+        // `keepOwnEntrance`: any pass not rewritten (OwnEntranceRule: the caller stashes my copy's own entrance through the landing's
+        // mirror). `intentField` and `hostEntrance` are read only here (NetSyncClient.HostIntentFieldNow), never per frame, and
+        // `intentUsable` / `hostUsable` say whether this install can load those fields; `walkOut` = a gateway walk (DestJump);
+        // `pressForDest` = a press waits on dest with its pick queued.
+        internal static Boolean OwnJumpPasses(Int32 myField, ref Int32 dest, Int32 intentField, Boolean intentUsable, Int32 hostField,
+                                              Boolean hostUsable, Int32 hostEntrance, Boolean walkOut, Boolean pressForDest,
+                                              out Boolean redirected, out Boolean keepOwnEntrance)
+        {
+            redirected = false;
+            keepOwnEntrance = false;
+            try
+            {
+                if (_phase == PhaseNone || LeverOff)
+                    return false;
+                if (_phase == PhaseHub)
+                {
+                    if (!OwnJumpRule(false, _phase, _byHost, _byHost ? Environment.TickCount - _pickTick : -1, _epField, myField))
+                        return false;
+                    OwnJumps++;
+                    _ownJump = dest;
+                    keepOwnEntrance = OwnEntranceRule(false, dest, hostField);   // a late copy lands with ITS 16, not the host's later entrance
+                    Log.Message("[NetSync] ATE relay: my copy's own Field(" + dest + ") passes -- the host's pick (choice " + _pick + ") on field "
+                                + myField + (dest == myField ? " (a same-field ATE: one reload)" : "") + " (my copy's own entrance)");
+                    return true;
+                }
+                if (_phase != PhaseDest || _epField != myField)
+                    return false;
+                Boolean hostLeft = _epHost == EpHostLeft;
+                Int32 to = DestJump(walkOut, dest, intentUsable ? intentField : -1, hostUsable ? hostField : -1, _epField, hostLeft, pressForDest);
+                if (!JumpUsable(to, to > 0 && EventEngineUtils.eventIDToFBGID.ContainsKey(to)))
+                    return false;              // a gateway walk (-1), or my own destination is the ending / not on this install: the passes below
+                OwnJumps++;
+                if (to != dest)
+                {
+                    Log.Message("[NetSync] ATE relay: my copy's own Field(" + dest + ") goes to the host's field " + to
+                                + " instead (the host left the ATE on field " + myField + " for it)");
+                    dest = to;
+                    redirected = true;
+                }
+                keepOwnEntrance = OwnEntranceRule(redirected, dest, hostField);
+                if (!redirected)
+                {
+                    Boolean hold = ExitHoldArms(false, dest, _epField, hostLeft, hostEntrance, _epEntrance);
+                    if (hold)
+                    {
+                        _exitHoldField = _epField;
+                        _exitHoldDest = dest;
+                        _exitHoldSince = Environment.TickCount;
+                        _exitHoldLogged = false;
+                    }
+                    Log.Message("[NetSync] ATE relay: my copy's own Field(" + dest + ") passes -- "
+                                + (pressForDest ? "the host's next ATE menu waits there" : hostField == dest ? "the host's field" : "the ATE's own exit")
+                                + " (my copy's own entrance)"
+                                + (hold ? "; the host is still on field " + _epField + ": the follow back into it waits until it leaves (up to "
+                                          + (ExitHoldMs / 1000) + " s)" : ""));
+                }
+                return true;
+            }
+            catch (Exception err)
+            {
+                NoteFault("jump", err);
+                return false;
+            }
+        }
+
+        // NetSyncClient.AteHoldsFollow: the window keys whose queued host choice decides the PENDING hold (the pending press's) and the
+        // PREPICK hold (my open menu's), with each menu's cancel row. False = no such hold can apply.
+        internal static Boolean PressKey(out Int32 fld, out Int32 win, out Int32 text, out Int32 afterSeq, out Int32 cancel)
+        {
+            fld = _pField; win = _pWin; text = _pText; afterSeq = _pSeq; cancel = _pCancel;
+            return _pending;
+        }
+
+        internal static Boolean MenuKey(out Int32 fld, out Int32 win, out Int32 text, out Int32 afterSeq, out Int32 cancel)
+        {
+            fld = _epField; win = _epWin; text = _epText; afterSeq = _epSeq; cancel = _epCancel;
+            return _phase == PhaseHub && !_byHost;
+        }
+
+        // NetSyncClient's follow paths (ServiceIntentFollow, FollowHostTick), right beside the s144 hold: TRUE = the follow to `dest` waits.
+        // `pressQueued` / `choiceQueued` = the host's pick for the pending press's / my open menu's window is already queued here and is not
+        // that menu's cancel row (ChoiceHolds).
+        internal static Boolean HoldsFollow(Int32 dest, Boolean myCtl, Int32 myField, Boolean pressQueued, Boolean choiceQueued)
+        {
+            try
+            {
+                if (_exitHoldField > 0 && dest == _exitHoldField && !LeverOff)
+                {
+                    if (!_exitHoldLogged)
+                    {
+                        _exitHoldLogged = true;
+                        Holds++;
+                        Log.Message("[NetSync] ATE relay: the follow to field " + dest + " waits -- the host is still in the ATE there and my copy "
+                                    + "already took its own exit (until the host leaves it, up to " + (ExitHoldMs / 1000) + " s)");
+                    }
+                    return true;
+                }
+                if (_phase == PhaseNone && !_pending)
+                    return false;
+                Int32 now = Environment.TickCount;
+                Boolean pendingHere = _pending && _pField == myField;
+                Int32 preMs = _preArmed ? now - _preSince : 0;
+                Int32 tailMs = _tailArmed ? now - _tailSince : 0;
+                Int32 progressMs = _phase == PhaseDest ? now - _tailProgress : -1;
+                Int32 prepickMs = _phase == PhaseHub ? now - _openTick : 0;
+                Int32 hold = FollowHoldRule(LeverOff, _phase, _byHost, myCtl, _byHost ? now - _pickTick : -1, prepickMs, tailMs, progressMs,
+                                            pendingHere, pressQueued, preMs, choiceQueued);
+                if (hold == HoldNone)
+                {
+                    Int32 capped = (_preArmed && preMs >= PreHoldMs) ? HoldPending
+                                 : (_phase == PhaseHub && !_byHost && choiceQueued && prepickMs >= PrepickHoldMs) ? HoldPrepick
+                                 : (_tailArmed && (tailMs >= TailCapMs || progressMs >= TailHoldMs)) ? HoldTail : HoldNone;
+                    if (capped != HoldNone && capped != _capLoggedHold)
+                    {
+                        _capLoggedHold = capped;
+                        HoldCaps++;
+                        Log.Message("[NetSync] ATE relay: the follow to field " + dest + " stops waiting -- my copy's ATE on field "
+                                    + (_phase != PhaseNone ? _epField : _pField) + " ran past the " + HoldNames[capped] + " hold's cap");
+                    }
+                    return false;
+                }
+                if (hold == HoldPending && !_preArmed)
+                {
+                    _preArmed = true;
+                    _preSince = now;
+                }
+                if (hold == HoldTail && !_tailArmed)
+                {
+                    _tailArmed = true;
+                    _tailSince = now;
+                }
+                if (hold != _holdLoggedHold || dest != _holdLoggedDest)
+                {
+                    _holdLoggedHold = hold;
+                    _holdLoggedDest = dest;
+                    Holds++;
+                    Log.Message(hold == HoldHub
+                        ? "[NetSync] ATE relay: the follow to field " + dest + " waits -- my copy plays the ATE's title and takes its own Field() (up to "
+                          + (HubHoldMs / 1000) + " s after the title)"
+                        : hold == HoldTail
+                        ? "[NetSync] ATE relay: the follow to field " + dest + " waits -- my copy still plays the ATE on field " + _epField
+                          + " and takes its own Field() (while it makes progress, up to " + (TailCapMs / 1000) + " s)"
+                        : "[NetSync] ATE relay: the follow to field " + dest + " waits -- the host's pick is queued for my copy's ATE menu ("
+                          + HoldNames[hold] + ", up to " + ((hold == HoldPrepick ? PrepickHoldMs : PreHoldMs) / 1000) + " s)");
+                }
+                return true;
+            }
+            catch (Exception err)
+            {
+                NoteFault("hold", err);
+                return false;
+            }
+        }
+
+        // NetSyncDialog.Purge's field rule: does the pending press keep this event (its field, newer than the press)?
+        internal static Boolean KeepsEvent(Int32 fld, Int32 seq)
+        {
+            return PressHoldsEvent(_pending && !LeverOff, _pField, _pSeq, fld, seq);
+        }
+
+        // NetSyncDialog.PurgeAtRelayAccept: does the pending press keep this event (its menu's key, newer than the press)?
+        internal static Boolean KeepsAtAccept(Int32 fld, Int32 win, Int32 text, Int32 seq)
+        {
+            return PressKeepsAtAccept(_pending && !LeverOff, _pField, _pWin, _pText, _pSeq, fld, win, text, seq);
+        }
+
+        // NetSyncClient.RedirectGuestFieldJump, a jump the episode does not own: does it keep my own entrance (ExitHoldKeepsOwn)? One line.
+        internal static Boolean ExitHoldKeepsOwnJump(Int32 dest)
+        {
+            if (!ExitHoldKeepsOwn(_exitHoldField, LeverOff))
+                return false;
+            Log.Message("[NetSync] ATE relay: my Field(" + dest + ") keeps my own entrance -- the host is still in the ATE on field "
+                        + _exitHoldField + " (its snapshot's entrance is that ATE's)");
+            return true;
+        }
+
+        // The field load, after the landing's story mirror (and its own-entrance restore): the entrance my copy's ATE field runs with.
+        internal static void NoteLandingEntrance()
+        {
+            try
+            {
+                if (_phase != PhaseDest || FF9StateSystem.Common.FF9.fldMapNo != _epField)
+                    return;
+                Byte[] g = FF9StateSystem.EventState.gEventGlobal;
+                _epEntrance = g != null && g.Length >= 4 ? g[2] | (g[3] << 8) : -1;
+            }
+            catch (Exception err)
+            {
+                NoteFault("entrance", err);
+                _epEntrance = -1;
+            }
+        }
+
+        // NetSyncClient.NoteFieldLanding (every field load, every role): a pending press survives only a landing on its own field (its live
+        // clock restarts there); the episode moves to its destination or ends; the host's caption latch ends.
+        internal static void OnLanding(Int32 landed)
+        {
+            try
+            {
+                _hostExemptField = -1;
+                _preArmed = false;
+                if (_exitHoldField > 0 && landed != _exitHoldDest)
+                    ClearExitHold("field " + landed + " loaded");
+                if (_pending)
+                {
+                    if (PressLanding(_pField, landed))
+                        _pLiveArmed = false;
+                    else
+                        Drop("field " + landed + " loaded instead of its field " + _pField);
+                }
+                if (_phase == PhaseNone)
+                    return;
+                Int32 next = LandingStep(_phase, _ownJump, landed, _chainField);
+                Boolean chained = next == PhaseDest && _phase == PhaseDest;
+                _chainField = -1;
+                if (next == PhaseDest)
+                {
+                    _ownReloadLanded = !chained && landed == _epField;
+                    if (chained)
+                    {
+                        Episodes++;
+                        Log.Message("[NetSync] ATE relay: my copy's exit landed in the host's next ATE on field " + landed + " (the host picked it "
+                                    + "while my copy was still in the last one: no menu or title here) -- the ATE plays here; the follow waits "
+                                    + "while my copy's control is off");
+                    }
+                    else
+                        Log.Message("[NetSync] ATE relay: my copy's own Field(" + landed + ") landed -- the ATE plays here"
+                                    + (_ownReloadLanded ? " (the same field, reloaded once)" : "") + "; the follow waits while my copy's control is off");
+                    _phase = PhaseDest;
+                    _epField = landed;
+                    _epEntrance = -1;                          // NoteLandingEntrance reads it after this load's story mirror
+                    _tailArmed = false;
+                    _tailProgress = Environment.TickCount;   // the landing is the tail's first progress
+                    _epHost = EpHostNone;                     // where the host is, from this landing on (EpHostStep)
+                    _capLoggedHold = HoldNone;
+                    _holdLoggedHold = HoldNone;
+                    _holdLoggedDest = -1;
+                    _backArmed = false;
+                }
+                else
+                    EndEpisode("field " + landed + " loaded");
+            }
+            catch (Exception err)
+            {
+                NoteFault("landing", err);
+                EndEpisode("fault");
+            }
+            finally
+            {
+                Rearm();
+            }
+        }
+
+        // Every guest / bench Update (after the dialogue authority, so a press merged this frame is seen): the press's life, the pick's
+        // lapse and title clock, the episode's control-back end and the exit hold's end. `warpField` = my follow-warp in its fade (-1
+        // none), `hostField` = LastHostField (-1 / 0 = unknown), `pressPicked` = the host's pick for the pending press is queued here
+        // (ChoiceHolds).
+        internal static void Tick(Boolean myCtl, Boolean onField, Int32 fld, Int32 warpField, Int32 hostField, Boolean pressPicked)
+        {
+            try
+            {
+                Int32 now = Environment.TickCount;
+                if (_exitHoldField > 0 && (LeverOff || ExitHoldEnds(_exitHoldField, hostField, now - _exitHoldSince)))
+                    ClearExitHold(LeverOff ? "the ate lever is off" : ExitHoldEnds(_exitHoldField, hostField, 0)
+                                  ? "the host left it for field " + hostField : "it ran " + (ExitHoldMs / 1000) + " s");
+                if (_pending)
+                {
+                    if (hostField > 0 && hostField != 65535 && hostField != _pField)
+                        _pHostLeft = true;
+                    if (!PressKeep(_pField, fld, warpField, hostField))
+                    {
+                        if (ChainRecords(_phase, pressPicked, hostField))
+                        {
+                            _chainField = hostField;
+                            Log.Message("[NetSync] ATE relay: the host picked its next ATE on field " + _pField + " and stands on field "
+                                        + hostField + " -- my copy's exit goes there and the ATE plays on (no menu)");
+                        }
+                        Drop("the host left field " + _pField + " (on " + hostField + ") and I am on " + fld);
+                    }
+                    else if (PressRoundTripOver(_pHostLeft, hostField, _pField))
+                        Drop("the host's ATE is over: it left field " + _pField + " and came back");
+                    else
+                    {
+                        if (onField && fld == _pField && myCtl && !_pLiveArmed)
+                        {
+                            _pLiveArmed = true;
+                            _pLiveSince = now;
+                        }
+                        Int32 exp = PressExpiry(now - _pSince, _pLiveArmed ? now - _pLiveSince : -1);
+                        if (exp != ExpNone)
+                        {
+                            Expired++;
+                            Log.Message("[NetSync] ATE relay: host seq " + _pSeq + " (field " + _pField + " uid " + _pUid + ", win " + _pWin + " text "
+                                        + _pText + ") expired -- my copy's ATE menu never opened (" + _pServes + " key tick(s) served"
+                                        + (exp == ExpCap ? ": it waited " + (PressCapMs / 1000) + " s for my copy to stand on its field with control"
+                                           : _pServes == 0 ? ": that reader never read Select with my control on" : ": its gate never passed") + ")");
+                            ClearPending();
+                        }
+                    }
+                }
+                if (_phase != PhaseNone)
+                {
+                    if (_phase == PhaseDest)
+                    {
+                        _epHost = EpHostStep(_epHost, hostField, _epField);
