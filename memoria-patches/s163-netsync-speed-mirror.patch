+using System;
+using System.Collections.Generic;
+using Assets.Scripts.Common;   // SceneDirector
+using Memoria.Prime;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync s163] THE HOST'S SPEED ON A FOLLOWING GUEST (studies/field-coop/SPEED-MIRROR.md, revision 2; the owner's call after
+    // the third two-PC session: "match host speed"). THE DEFECT (GUEST-TRAVERSAL-TWO-PC.md Finding 10, and the rate half of Finding 4): a host
+    // on the F1 booster plays a scene or an ATE at 3x while its following guest's copy plays the same script at 1x, so the host's scripted
+    // Field() beats the guest's last lines by whole seconds -- "Dagger Tries" (351 -> 450) was cut at line 162 of 175. The booster is
+    // SettingsState.FastForwardFactor: FPSManager.AdvanceUpdateCounter runs that many main-loop updates a frame, so every walk, wait and
+    // timer scales with it; SetFastForward drives HonoBehaviorSystem's FAST MODE (typing, dialog waits, bubbles) and re-pitches the SFX.
+    //
+    // HOST   every state frame carries section 10 = [setting u8][fieldTps u8] (HostSectionBody, from BuildStateFrame, BEFORE section 7: the
+    //        order is [0,1,2,3,(4),5,(6|9),10,7,8] -- DressSelfTest and the kit's coop_peer `dress` tape want 8 right after 7 and last): its
+    //        booster SETTING (HostSettingRule: IsFastForward ? SpeedFactor : 1, clamped 1-255 -- never the live factor, which reads 1 at every
+    //        load, in battle and on the world map, exactly when a 3x host has just left the guest's field) and its [Graphics] FieldTPS
+    //        (clamped 1-255). One log line per booster edge (HostTick, which also has the frame pushed at once).
+    // GUEST  ObserveHostDialog's new-frame branch caches section 10 (NoteHostFrame through CacheRule): a FRESH frame replaces the cache -- a
+    //        missing id or a malformed body forgets the host (setting 1) -- while a NULL state (no frame for ~2 s: GetRemoteState's staleness)
+    //        is NO NEWS: the cache stands, marked stale (a dead link is never the host's booster). Tick (every Update, right after
+    //        ServiceStepOut) runs the mirror, a LATCH (s158's law: my copy trails the host, and its tail is still the scene -- it never ends on
+    //        the host's control, position or link):
+    //   START  StartRule, every term: a following, mirroring guest (the step-out's `eligible`), the lever not off, a live field (gMode 1 and
+    //          the field scene), my control off, the host's lane fresh, the host's setting > 1, no guest climb in flight, no movie playing
+    //          (stock's own booster lock: MoviePlaying), my copy plays the host's scene (PlaysHostScene: (a) the host on my field with its
+    //          control off -- section 7's view cached for THIS field, the step-out's hostCtlOff; (b) the s161 ATE episode in flight here; (c)
+    //          a relayed talk or chest accept owns my control-off episode here -- the step-out's talk latch), and the factor fits.
+    //   END    EndRule, any: the lever; eligibility lost; a landing; a field change; the field scene left (a battle's swirl, the world map);
+    //          a guest climb starting; a movie starting; the host's setting dropping to 1 (or its rate no longer covering mine); my
+    //          control back for the step-out's StepInMs. The host's control and its lane's staleness are NO input.
+    //   HOLD   the factor APPLIES only while my control is off (HoldRule): free roam stays at my own speed, so the StepInMs debounce after my
+    //          control returns runs at my own factor while the latch waits to end. Each apply / withhold flip re-runs SetFastForward.
+    //   FACTOR FactorRule: my OWN [Cheats] SpeedFactor G, clamped 1-255 as the host clamps its own (AllSoundDispatchPlayer keeps one pitch
+    //          bool per sound against exactly that value, so any other factor strands pitches), only when it does not overshoot the host:
+    //          G * myTps <= setting * hostTps. Otherwise the mirror refuses (its own words: my SpeedFactor 1, a TPS unknown, an overshoot),
+    //          and an eligible guest that would otherwise start logs the mismatch once.
+    // THE SEAMS (Global/SettingsState.cs), never the raw flag: the getter keeps stock's body as StockFastForwardFactor and returns GetterRule
+    //        (max(stock, Factor) while the factor applies, on the field scene, on its own field: a verdict from another field reads nothing);
+    //        SetFastForward(on) writes the raw flag with the player's own value and turns FAST MODE on for ModeRule (on || the same three
+    //        tests), so stock's re-runs at every scene load (UIManager) and HUD clear (EventHUD) keep the mirror's mode, and the Auction /
+    //        Pandemonium branch still refuses it there. Each edge calls SetFastForward(the raw flag): the mode and the SFX re-pitch.
+    //        StockFastForwardFactor is the only "own factor" read here: the mirror never decides on its own output.
+    //        Accepted (SPEED-MIRROR.md "Risks"): stock readers of the RAW flag keep 1x behaviour under the mirror (SceneDirector's fade
+    //        frames, the Prima Vista 3x fixes, TimerUI's SpeedTimer, UIScene / MainMenuUI / HUDMessage, the booster HUD icon).
+    //
+    // Vanilla and solo play pay one bool read in the getter (NetSyncSpeedArmed.Applied, written only by this file). The wire stays v14 (every
+    // engine and kit walker skips an unknown id by its length; an old host never sends 10); the harness protocol stays 5. Main thread only.
+
+    // The holder the stock seams read (SettingsState.FastForwardFactor, SetFastForward) -- plain static fields, NO initializer, so FPSManager's
+    // per-frame read never type-initializes NetSync code. Written only by NetSyncSpeed.Publish. Standing = the latch (NoteFieldLanding reads
+    // it); Applied = the latch with my control off (HoldRule: the only bool the seams gate on).
+    internal static class NetSyncSpeedArmed
+    {
+        internal static Boolean Standing;
+        internal static Boolean Applied;
+        internal static Int32 Factor;
+        internal static Int32 Field;
+    }
+
+    public static class NetSyncSpeed
+    {
+        // ---------------------------------------------------------------- the section-10 codec
+        internal const Int32 BodyLen = 2;              // [setting u8][fieldTps u8]; a longer body is read forward, a shorter one refused
+
+        // ---------------------------------------------------------------- names
+        internal const Int32 EndNone = 0, EndLever = 1, EndSession = 2, EndLanding = 3, EndField = 4, EndScene = 5, EndClimb = 6, EndMovie = 7,
+                             EndHost = 8, EndRate = 9, EndControl = 10, EndReset = 11;
+        internal static readonly String[] EndNames = { null, "lever", "session", "landing", "field", "scene", "climb", "movie", "host", "rate",
+                                                       "control", "reset" };
+        internal const Int32 SrcNone = 0, SrcWire = 1, SrcBench = 2;
+        internal static readonly String[] SrcNames = { "none", "wire", "bench" };
+        // FactorRule's refusals (a factor > 1 is the mirror's)
+        internal const Int32 RefuseOvershoot = 0, RefuseHostOff = -1, RefuseOwnOne = -2, RefuseNoTps = -3;
+
+        // StartRule's words (the harness `why_not`), one per term, in its order
+        internal const String WhyEligible = "not a following, mirroring guest";
+        internal const String WhyLever = "the speed lever is off";
+        internal const String WhyField = "not on a live field";
+        internal const String WhyControl = "I have control";
+        internal const String WhyStale = "the host's lane is stale";
+        internal const String WhyHost = "the host's booster is off";
+        internal const String WhyClimb = "my guest climb is in flight";
+        internal const String WhyMovie = "a movie is playing";
+        internal const String WhyScene = "my copy does not play the host's scene";
+        internal const String WhyRate = "my rate would overshoot the host's (SpeedFactor x FieldTPS)";
+        internal const String WhyOwnOne = "my [Cheats] SpeedFactor is 1 (nothing to mirror)";
+        internal const String WhyNoTps = "a FieldTPS is unknown (mine or the host's)";
+
+        // ---------------------------------------------------------------- the lever (ANY role; released with the harness)
+        private static Int32 _lever;                   // 0 act, 1 off (CALIBRATION: s162's rule, never mirror)
+        internal static Boolean LeverOff { get { return _lever == 1; } }
+
+        // ---------------------------------------------------------------- GUEST: the host's section 10 (setting 1 / tps 0 = absent)
+        private static Int32 _hostSetting = 1, _hostTps;
+        private static Int32 _src;                     // SrcNone / SrcWire / SrcBench (`netsync speed host <n>`, the selftest role)
+        private static Boolean _stale;                 // the last observed state was NULL: no news since the cached frame
+
+        // ---------------------------------------------------------------- GUEST: the mirror
+        private static Boolean _standing;              // the latch
+        private static Boolean _applied;               // HoldRule: the latch with my control off (the seams' gate)
+        private static Int32 _field = -1, _factor, _since;   // _since read only while _standing (tick-baseline law)
+        private static Boolean _backArmed;
+        private static Int32 _backSince;
+        private static Boolean _landed;
+        private static Boolean _inEligible, _inClimb, _inMovie, _inScene;   // the last Tick's inputs (OnLanding's evaluation)
+        private static Int64 _mismatchKey = -1;        // the (G, myTps, setting, hostTps) a mismatch line last named: one line per tuple
+
+        // ---------------------------------------------------------------- HOST
+        private static Int32 _hostLastSetting = 1;     // the setting the last booster edge line named
+
+        // ---------------------------------------------------------------- counters (cumulative per process; read DELTAS)
+        internal static Int32 EdgesOn, EdgesOff, Faults;
+        internal static readonly Int32[] EndBy = new Int32[12];   // by EndRule reason (EndNames), plus `reset`
+        internal static String LastFault, LastEnd, SelfTestVerdict;
+        internal static String WhyNotNow = "not ticked";
+
+        // ================================================================ the pure rules (SelfTest tables every one)
+
+        // HOST: section 10's setting -- the booster as SET (the raw flag), never the live factor. Clamped to a byte, never 0.
+        internal static Int32 HostSettingRule(Boolean raw, Int32 speedFactor)
+        {
+            return raw ? Clamp(speedFactor) : 1;
+        }
+
+        // A FieldTPS byte (1-255): the host's into section 10, and the guest's own before FactorRule (the same clamp both sides).
+        internal static Int32 TpsRule(Int32 tps)
+        {
+            return Clamp(tps);
+        }
+
+        // GUEST: the section-10 cache step per observed state. A FRESH frame replaces it (its section parsed: the host's values; else
+        // absent: setting 1, tps 0, src none) and clears the stale mark; a NULL state (no frame for ~2 s) is no news -- the cache stands,
+        // marked stale (the host's link, never its booster).
+        internal static void CacheRule(Boolean haveFrame, Boolean parsed, Int32 newSetting, Int32 newTps, ref Int32 setting, ref Int32 tps,
+                                       ref Int32 src, out Boolean stale)
+        {
+            stale = !haveFrame;
+            if (!haveFrame)
+                return;
+            if (parsed)
+            {
+                setting = newSetting;
+                tps = newTps;
+                src = SrcWire;
+            }
+            else
+            {
+                setting = 1;
+                tps = 0;
+                src = SrcNone;
+            }
+        }
+
+        // GUEST: is a movie playing? Stock's own booster lock (UIKeyTrigger.HandleBoosterButton): an MBG exists on every field (created
+        // lazily), so only one that has played and is not skipped counts -- an idle MBG never vetoes.
+        internal static Boolean MoviePlaying(Boolean mbgExists, Boolean finishedForBooster)
+        {
+            return mbgExists && !finishedForBooster;
+        }
+
+        // GUEST: does my copy play the host's scene on field `fld`? (a) the host's control-off view cached for THIS field, (b) the ATE
+        // episode's field, (c) the relayed talk's field (-1 = none for each).
+        internal static Boolean PlaysHostScene(Int32 fld, Int32 viewField, Boolean hostHolds, Int32 ateField, Int32 talkField)
+        {
+            return fld > 0 && ((viewField == fld && hostHolds) || ateField == fld || talkField == fld);
+        }
+
+        // GUEST: the mirror's factor -- my OWN SpeedFactor G (the SFX pitch law), only while it does not overshoot the host's rate. A factor
+        // > 1 is the mirror's; else the refusal, in this order: RefuseHostOff (the host's booster off), RefuseOwnOne (my own SpeedFactor 1),
+        // RefuseNoTps (a FieldTPS unknown), RefuseOvershoot (G * myTps > setting * hostTps).
+        internal static Int32 FactorRule(Int32 g, Int32 myTps, Int32 hostSetting, Int32 hostTps)
+        {
+            if (hostSetting <= 1)
+                return RefuseHostOff;
+            if (g <= 1)
+                return RefuseOwnOne;
+            if (myTps <= 0 || hostTps <= 0)
+                return RefuseNoTps;
+            return (Int64)g * myTps <= (Int64)hostSetting * hostTps ? g : RefuseOvershoot;
+        }
+
+        // GUEST: THE START -- null when every term holds, else the FIRST failing term's words, in this order.
+        internal static String StartRule(Boolean eligible, Boolean leverOff, Boolean liveField, Boolean myCtlOff, Boolean stale, Int32 hostSetting,
+                                         Boolean climb, Boolean movie, Int32 fld, Int32 viewField, Boolean hostHolds, Int32 ateField, Int32 talkField,
+                                         Int32 factor)
+        {
+            if (!eligible)
+                return WhyEligible;
+            if (leverOff)
+                return WhyLever;
+            if (!liveField)
+                return WhyField;
+            if (!myCtlOff)
+                return WhyControl;
+            if (stale)
+                return WhyStale;
+            if (hostSetting <= 1)
+                return WhyHost;
+            if (climb)
+                return WhyClimb;
+            if (movie)
+                return WhyMovie;
+            if (!PlaysHostScene(fld, viewField, hostHolds, ateField, talkField))
+                return WhyScene;
+            if (factor <= 1)
+                return factor == RefuseOwnOne ? WhyOwnOne : factor == RefuseNoTps ? WhyNoTps : WhyRate;
+            return null;
+        }
+
+        // GUEST: THE END -- a LATCH: never on the host's control, position or link (`hostScene` is read by NO term: my copy may trail the
+        // host's scene, and its tail is still the scene; the lane's staleness is not even an input). ctlBackMs = how long my control has been
+        // back (-1 = it is off).
+        internal static Int32 EndRule(Boolean leverOff, Boolean eligible, Boolean liveField, Boolean sameField, Boolean landed, Boolean climb,
+                                      Boolean movie, Int32 hostSetting, Int32 factor, Boolean hostScene, Boolean myCtl, Int32 ctlBackMs)
+        {
+            if (leverOff)
+                return EndLever;
+            if (!eligible)
+                return EndSession;
+            if (landed)
+                return EndLanding;
+            if (!sameField)
+                return EndField;
+            if (!liveField)
+                return EndScene;
+            if (climb)
+                return EndClimb;
+            if (movie)
+                return EndMovie;
+            if (hostSetting <= 1)
+                return EndHost;
+            if (factor <= 1)
+                return EndRate;
+            if (myCtl && ctlBackMs >= NetSyncStepOut.StepInMs)
+                return EndControl;
+            return EndNone;
+        }
+
+        // GUEST: THE HOLD -- the factor applies only while the latch stands AND my control is off (free roam stays at my own speed; the
+        // StepInMs debounce after my control returns runs at my own factor while the latch waits to end).
+        internal static Boolean HoldRule(Boolean standing, Boolean myCtlOff)
+        {
+            return standing && myCtlOff;
+        }
+
+        // THE GETTER SEAM (SettingsState.FastForwardFactor): the mirror's factor over stock's, only while it applies, on the field scene, on
+        // its own field (a verdict from another field reads nothing). In battle, on the world map, in a movie: stock. Never below stock.
+        internal static Int32 GetterRule(Int32 stock, Boolean applied, Boolean fieldScene, Int32 armedField, Int32 fld, Int32 factor)
+        {
+            return applied && fieldScene && armedField > 0 && armedField == fld && factor > stock ? factor : stock;
+        }
+
+        // THE MODE SEAM (SettingsState.SetFastForward): FAST MODE for my own booster, or the mirror applying here (the getter's three tests).
+        // The raw flag is never this: it keeps the player's own value.
+        internal static Boolean ModeRule(Boolean on, Boolean applied, Boolean fieldScene, Int32 armedField, Int32 fld)
+        {
+            return on || (applied && fieldScene && armedField > 0 && armedField == fld);
+        }
+
+        // The section-10 body (the ONE encoder: BuildStateFrame and the bench lever).
+        internal static Byte[] SectionBody(Int32 setting, Int32 tps)
+        {
+            return new Byte[] { (Byte)Clamp(setting), (Byte)Clamp(tps) };
+        }
+
+        // The section-10 reader: at least BodyLen bytes, neither byte 0 (the encoder never writes one) -- else malformed (refused: absent).
+        internal static Boolean ParseBody(Byte[] body, out Int32 setting, out Int32 tps)
+        {
+            setting = 1;
+            tps = 0;
+            if (body == null || body.Length < BodyLen || body[0] == 0 || body[1] == 0)
+                return false;
+            setting = body[0];
+            tps = body[1];
+            return true;
+        }
+
+        // A state payload's section 10 through the real section walk (NetSyncState.TryReadSection: a truncated frame refuses whole). False =
+        // absent: setting 1, tps 0.
+        internal static Boolean ReadHostSpeed(Byte[] state, out Int32 setting, out Int32 tps)
+        {
+            Byte[] body;
+            if (state == null || !NetSyncState.TryReadSection(state, NetSyncState.SectionSpeed, out body))
+            {
+                setting = 1;
+                tps = 0;
+                return false;
+            }
+            return ParseBody(body, out setting, out tps);
+        }
+
+        private static Int32 Clamp(Int32 v)
+        {
+            return v < 1 ? 1 : v > 255 ? 255 : v;
+        }
+
+        // ================================================================ HOST
+
+        // BuildStateFrame (every host frame, the 7 Hz publish and every out-of-band push): section 10's body, read LIVE. Null on a fault (the
+        // section then does not ride; the frame never fails for it).
+        internal static Byte[] HostSectionBody()
+        {
+            try
+            {
+                SettingsState s = FF9StateSystem.Settings;
+                return SectionBody(HostSettingRule(s != null && s.IsFastForward, SettingsState.FastForwardGameSpeed),
+                                   TpsRule(Configuration.Graphics.FieldTPS));
+            }
+            catch (Exception err)
+            {
+                NoteFault("host section", err);
+                return null;
+            }
+        }
+
+        // The host's Update (before UpdateHostScene): one line per booster edge. TRUE = the setting changed (the caller pushes the frame now).
+        internal static Boolean HostTick()
+        {
+            try
+            {
+                SettingsState s = FF9StateSystem.Settings;
+                Int32 setting = HostSettingRule(s != null && s.IsFastForward, SettingsState.FastForwardGameSpeed);
+                if (setting == _hostLastSetting)
+                    return false;
+                _hostLastSetting = setting;
+                Log.Message(setting > 1
+                    ? "[NetSync] speed mirror (host): my booster is ON (setting " + setting + ", FieldTPS " + TpsRule(Configuration.Graphics.FieldTPS)
+                      + ") -- section 10 tells a following guest to play my scenes at it"
+                    : "[NetSync] speed mirror (host): my booster is OFF -- section 10 reads setting 1 (a following guest's mirror ends)");
+                return true;
+            }
+            catch (Exception err)
+            {
+                NoteFault("host tick", err);
+                return false;
+            }
+        }
+
+        // ================================================================ GUEST
+
+        // NetSyncClient.ObserveHostDialog's new-frame branch (a live guest's every new state payload, and every null one; the bench's too):
+        // the host's section 10 through CacheRule. The bench host (`netsync speed host <n>`) owns the cache on the selftest role until
+        // `clear` or the release (never stale).
+        internal static void NoteHostFrame(Byte[] state)
+        {
+            try
+            {
+                if (_src == SrcBench && NetSyncClient.IsSelfTestRole)
+                {
+                    _stale = false;
+                    return;
+                }
+                Int32 setting, tps;
+                Boolean parsed = ReadHostSpeed(state, out setting, out tps);
+                CacheRule(state != null, parsed, setting, tps, ref _hostSetting, ref _hostTps, ref _src, out _stale);
+            }
+            catch (Exception err)
+            {
+                NoteFault("frame", err);
+                ForgetHost();
+            }
+        }
+
+        // NetSyncClient.ServiceSpeed, every Update right after ServiceStepOut (every role; a host and a solo bench refuse at the first term):
+        // `eligible` = the step-out's, `viewField` / `hostHolds` = the section-7 control-off view it read (bench: `hostscene 1` on my field).
+        internal static void Tick(EventEngine ee, Boolean eligible, Boolean onField, Int32 fld, Int32 viewField, Boolean hostHolds)
+        {
+            try
+            {
+                if (_src == SrcBench && !NetSyncClient.IsSelfTestRole)
+                    ForgetHost();                       // a bench host never outlives the selftest role
+                SettingsState s = FF9StateSystem.Settings;
+                Int32 now = Environment.TickCount;
+                Boolean myCtl = ee == null || ee.GetUserControl();
+                Boolean liveField = onField && SceneDirector.IsFieldScene();
+                Boolean climb = NetSyncGuestLocalArmed.On && NetSyncGuestLocal.InFlightNow(ee);
+                Boolean mbg = !MBG.IsNull;
+                Boolean movie = MoviePlaying(mbg, !mbg || MBG.Instance.IsFinishedForDisableBooster());
+                Int32 g = Clamp(SettingsState.FastForwardGameSpeed);   // the same clamp the host's section 10 takes
+                Int32 myTps = TpsRule(Configuration.Graphics.FieldTPS);
+                Int32 factor = FactorRule(g, myTps, _hostSetting, _hostTps);
+                Int32 ateField = NetSyncAte.EpisodeFieldNow;
+                Int32 talkField = NetSyncStepOut.TalkFieldNow;
+                Boolean scene = PlaysHostScene(fld, viewField, hostHolds, ateField, talkField);
+                _inEligible = eligible;
+                _inClimb = climb;
+                _inMovie = movie;
+                _inScene = scene;
+                if (!_standing)
+                {
+                    String whyNot = StartRule(eligible, LeverOff, liveField, !myCtl, _stale, _hostSetting, climb, movie, fld, viewField, hostHolds,
+                                              ateField, talkField, factor);
+                    WhyNotNow = whyNot;
+                    if (whyNot == WhyRate || whyNot == WhyOwnOne || whyNot == WhyNoTps)
+                        NoteMismatch(g, myTps, factor);  // every other term held: an eligible guest that would otherwise start
+                    else if (whyNot == null)
+                        Start(s, fld, factor, g, myTps, viewField == fld && hostHolds ? "the host plays its scene here (its control is off)"
+                                                       : ateField == fld ? "my copy plays the ATE episode here"
+                                                       : "a relayed talk owns my copy here");
+                    return;
+                }
+                if (myCtl)
+                {
+                    if (!_backArmed)
+                    {
+                        _backArmed = true;
+                        _backSince = now;               // tick-baseline law: armed bool + delta
+                    }
+                }
+                else
+                    _backArmed = false;
+                Int32 end = EndRule(LeverOff, eligible, liveField, fld == _field, _landed, climb, movie, _hostSetting, factor, scene, myCtl,
+                                    _backArmed ? now - _backSince : -1);
+                WhyNotNow = null;
+                if (end != EndNone)
+                {
+                    Stop(s, end, EndWords(end, fld));
+                    return;
+                }
+                Boolean applied = HoldRule(true, !myCtl);
+                if (applied != _applied)
+                {
+                    _applied = applied;                 // my control came back (withheld) or fell again (applied): free roam is my own speed
+                    Publish();
+                    try
+                    {
+                        s.SetFastForward(s.IsFastForward);   // FAST MODE and the SFX pitch follow the flip; the raw flag keeps my own
+                    }
+                    catch (Exception err)
+                    {
+                        NoteFault("hold edge", err);
+                    }
+                }
+            }
+            catch (Exception err)
+            {
+                NoteFault("tick", err);
+                if (_standing)
+                    Stop(null, EndReset, "a tick fault (fail open: the getter reads stock)");
+            }
+        }
+
+        // NetSyncClient.NoteFieldLanding (every field load, every role): a standing mirror ends AT the load -- before the new copy's Main_Init
+        // runs a frame at the old verdict (a same-field reload keeps the id). The landing term with the last Tick's other inputs.
+        internal static void OnLanding(Int32 landed)
+        {
+            try
+            {
+                if (!_standing)
+                    return;
+                _landed = true;
+                Int32 end = EndRule(LeverOff, _inEligible, true, true, true, _inClimb, _inMovie, _hostSetting, _factor, _inScene, false, -1);
+                Stop(null, end, EndWords(end, landed));
+            }
+            catch (Exception err)
+            {
+                NoteFault("landing", err);
+                if (_standing)
+                    Stop(null, EndReset, "a landing fault (fail open: the getter reads stock)");
+            }
+        }
+
+        // The session boundary (NetSyncClient.ResetIntentAndL1State: OnDestroy, a redial, a reconfigure, the harness release): a standing
+        // mirror ends, the host's cache is forgotten (the bench host is the lever's: HarnessRelease), the host's edge line re-arms.
+        internal static void Reset(String why)
+        {
+            try
+            {
+                if (_standing)
+                    Stop(null, EndReset, why);
+            }
+            catch (Exception err)
+            {
+                NoteFault("reset", err);
+            }
+            if (_src != SrcBench || !NetSyncClient.IsSelfTestRole)
+                ForgetHost();
+            _hostLastSetting = 1;
+            _mismatchKey = -1;
+            WhyNotNow = "not ticked";
+        }
+
+        // START fails OPEN: an edge that throws stops the mirror it just raised (the holder back to stock, the edge re-run in Stop's own try).
+        private static void Start(SettingsState s, Int32 fld, Int32 factor, Int32 g, Int32 myTps, String why)
+        {
