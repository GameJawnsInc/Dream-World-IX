+
+        // OwnFieldPass's cache input: does the cache stand for my field and the lane now? `cacheField` = the cached field (-1 = none).
+        internal static Boolean CacheStandsFor(Int32 myField, Int32 hostLane, out Int32 cacheField)
+        {
