+                e.LandSeen = true;
+                e.LandSeenTick = now - a.AgeMs;
+            }
+            _pinBenchArmed = true;
+            _pinBenchLatest = frameB;
+            _pinBenchFlag = a.Flag;
+            _pinBenchLanded = a.Landed;
+            _pinBenchSlot = source != null ? a.Slot : -1;
+            _pinBenchChar = source != null ? a.CharId : -1;
+            _pinBenchChosen = null;
+            String party = "";
+            if (source != null)
+            {
+                NetSyncParty.Slot[] pa = new NetSyncParty.Slot[4], pb = new NetSyncParty.Slot[4];
+                Boolean okA = NetSyncParty.TryParsePartyInto(frameA, pa), okB = NetSyncParty.TryParsePartyInto(frameB, pb);
+                party = "; party slot " + a.Slot + ": pin " + (okA && pa[a.Slot].Present ? (Int32)pa[a.Slot].CharId : -1) + ", latest "
+                        + (okB && pb[a.Slot].Present ? (Int32)pb[a.Slot].CharId : -1);
+            }
+            line = "[NetSync] harness: swap pinbench -- intent " + nc + "'s frame for field " + field + " through the real codec (flag " + a.Flag + ": pin "
+                   + NetSyncState.StoryFlag(frameA, a.Flag) + ", latest " + NetSyncState.StoryFlag(frameB, a.Flag) + party
+                   + (a.Landed ? "; built after the host's landing" : "") + (a.AgeMs >= 0 ? "; landing seen " + a.AgeMs + " ms ago" : "") + ")";
