+        // B's scenarios, stepped per 100 ms tick from HoldT0 (Int32 deltas across the wrap): the REAL SettleClock (the host co-located, no
+        // relayed start), then one plain line -- opened at `openDt`, its single page complete at once -- through HoldTick. `script(dt)` is
+        // InHolds | InScene | InEvent. The run stops at the auto-confirm (a single-page line closes).
+        private static List<HoldStep> HoldRun(Rules r, Func<Int32, Int32> script, Int32 until, Int32 openDt, Boolean leverOld)
+        {
+            NetSyncDialog.SettleClock clock = new NetSyncDialog.SettleClock();
+            List<HoldStep> steps = new List<HoldStep>();
+            HoldWin w = null;
+            for (Int32 dt = 0; dt <= until; dt += 100)
