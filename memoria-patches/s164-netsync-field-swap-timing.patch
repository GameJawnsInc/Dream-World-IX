+            return _icField > 0 ? Environment.TickCount - _icTick : -1;
+        }
+
+        // NetSyncClient.OwnFieldPass, a decision that matched a term -- a pass (term > 0), or a refusal (term < 0) the old rule then decides:
+        // the counters, `own.last`, and the in-flight term NoteOwnJump prints by (the pass line, or the refusal line with the old rule's
+        // outcome). `matched` = the term a refusal matched.
+        internal static void NoteOwnDecision(Int32 term, Int32 matched, Int32 dest, Int32 myField, Int32 lane, Boolean keepOwn, Boolean converted)
+        {
+            if (term > TermNone)
+            {
+                _ownPasses++;
+                if (term <= _ownBy.Length)
+                    _ownBy[term - 1]++;
+                if (converted)
+                    _ownConverted++;
+            }
+            else if (term == TermRefusedWorld)
+                _ownRefusedWorld++;
+            else if (term == TermRefusedAte)
+                _ownRefusedAte++;
+            _ownLastDest = dest;
+            _ownLastFrom = myField;
+            _ownLastLane = lane;
+            _ownLastWhy = OwnWhyOf(term);
+            _ownLastKept = keepOwn;
+            _ownLastTerm = term;
+            _ownLastMatched = matched;
+            _ownLastAgeMs = term == TermCache ? CacheAgeMs() : -1;
+            _ownLastKeepOwn = keepOwn;
+        }
+
+        // `swap cache <field>` (the selftest role): section 4 through the real codec into the cache only (src my field, host_from -1, bench).
+        private static Boolean BenchCache(Int32 dest, out String why)
+        {
+            why = null;
+            Int32 my = FF9StateSystem.Common.FF9.fldMapNo;
+            Byte nonce = (Byte)(_icNonce + 1);         // never the cache's own (spent) nonce: IntentCacheStep would keep it
+            Byte[] frame = NetSyncState.AppendSection(null, NetSyncState.SectionIntent, new Byte[] { (Byte)(dest & 0xFF), (Byte)((dest >> 8) & 0xFF), nonce });
+            Byte[] body;
+            if (!NetSyncState.TryReadSection(frame, NetSyncState.SectionIntent, out body) || body == null || body.Length < 3)
+            {
+                why = "netsync swap cache: the section-4 codec round trip failed";
+                return false;
+            }
+            Int32 field = body[0] | (body[1] << 8), nc = body[2];
+            if (IntentCacheStep(_icField, _icNonce, field, nc, my) != CacheWrite)
+            {
+                why = "netsync swap cache: field " + field + " cannot be cached on field " + my + " (my own field, the ending, or not on a field)";
+                return false;
+            }
+            WriteCache(field, nc, my, -1, -1, true);
+            Log.Message("[NetSync] harness: swap cache -- section 4 = field " + field + " nonce " + nc + " through the real codec, cached on field " + my);
+            return true;
+        }
+
+        // ---------------------------------------------------------------- GUEST, PIN: the story pin ([ff9mapkit netsync s164])
+
+        // NoteHostFrame's part (a client, every new host frame; secNonce -1 = no section 4): for each held entry of this nonce, the landed bit
+        // marks the host's landing as I first saw it, and a frame with the bit clear is compared with a Pre pin (the halted-VM premise:
+        // `pre_frames`, `max_pre_diff`); a different nonce ends the spent one (T1); then the capture. A null state is no news (the stale lane).
+        // A fault reads as the lever for the rest of the process. Never throws.
+        private static void PinHostFrame(Byte[] state, Int32 secField, Int32 secNonce, Boolean landed, Int32 myField)
+        {
+            if (state == null || !NetSyncClient.HarnessEnabled || NetSyncClient.HarnessRole != "client")
+                return;
+            try
+            {
+                _pinFrameNonce = secNonce;
+                if (secNonce < 0)
+                    return;
+                Int32 now = Environment.TickCount;
+                for (Int32 k = 0; k < _pins.Length; k++)
+                {
+                    PinEntry e = _pins[k];
+                    if (e == null || e.Nonce != secNonce)
+                        continue;
+                    if (landed && !e.LandSeen)
+                    {
+                        e.LandSeen = true;
+                        e.LandSeenTick = now;
+                    }
+                    else if (!landed && e.Quality == PinPre)
+                        PinCompare(e, state);
+                }
+                if (secNonce != _pinSpentNonce)
+                    _pinSpentNonce = -1;
+                PinCapture(state, secField, secNonce, landed, myField, false, now);
+            }
+            catch (Exception err)
+            {
+                _pinFaulted = true;
+                NoteFault(ItemPin, "capture", err, "every landing stages the latest frame (s163's rule) from here");
+            }
+        }
+
+        // A later pre-landing frame of a held Pre pin's nonce against the pin (the story bytes outside the mask; DP-HALT judges it stays 0).
+        // The line prints when the difference is above 0 and above this entry's largest so far (one line per new maximum, never per frame).
+        private static void PinCompare(PinEntry e, Byte[] state)
+        {
+            Int32 first;
+            Int32 diff = NetSyncState.StoryDiff(e.Frame, state, out first);
+            if (diff < 0)
+                return;
+            _pinPreFrames++;
+            if (diff > _pinMaxPreDiff)
+                _pinMaxPreDiff = diff;
+            if (diff <= e.MaxPreDiff)
+                return;
+            e.MaxPreDiff = diff;
+            Log.Message("[NetSync] story pin: intent " + e.Nonce + "'s later frame from before the host's landing differs from the pin at " + diff
+                        + " story bytes (the halted-VM premise)" + Stamp());
+        }
+
+        // The capture (a guest's frame and `swap pinbench`'s frame A both): PinCaptureRule against the entry held for this nonce. Here is
+        // counted and its nonce spent. A NEW nonce first runs PinDropOnNew over the held entries (a dropped pin logs and its nonce is spent),
+        // then takes the free slot. Returns the rule's verdict.
+        private static Int32 PinCapture(Byte[] frame, Int32 field, Int32 nonce, Boolean landed, Int32 myField, Boolean bench, Int32 now)
+        {
+            PinEntry held = PinHeld(nonce);
+            Int32 v = PinCaptureRule(nonce >= 0 && nonce == _pinSpentNonce, myField > 0 && field == myField, held != null ? held.Quality : PinNone,
+                                     nonce, landed);
+            if (v == PinHere)
+            {
+                _pinHere++;
+                _pinSpentNonce = nonce;
+                Log.Message("[NetSync] story pin: intent " + nonce + " names field " + field + ", where I already stand -- not kept" + Stamp());
+                return v;
+            }
+            if (v != PinPre && v != PinLate)
+                return v;
+            Int32 pending, committed, warpedTo;
+            NetSyncClient.SwapFollowTargets(out pending, out committed, out warpedTo);
+            Int32 free = -1;
+            for (Int32 k = 0; k < _pins.Length; k++)
+            {
+                PinEntry e = _pins[k];
+                if (e != null && PinDropOnNew(e.Field, PinTargeted(e.Field, pending, committed, warpedTo), field))
+                    DropPin(k, nonce);
+                if (_pins[k] == null && free < 0)
+                    free = k;
+            }
+            if (free < 0)
+            {
+                free = _pins[0].CaptureTick - _pins[1].CaptureTick <= 0 ? 0 : 1;   // both targeted (one follow at a time: never): the older goes
+                DropPin(free, nonce);
+            }
+            _pins[free] = new PinEntry { Frame = frame, Field = field, Nonce = nonce, Quality = v, CaptureTick = now, LandSeen = v == PinLate,
+                                         LandSeenTick = now, Bench = bench };
+            _pinCaptures++;
+            if (v == PinLate)
+                _pinLate++;
+            Log.Message(v == PinPre
+                ? "[NetSync] story pin: intent " + nonce + "'s frame kept for field " + field + " (built before the host's landing)" + Stamp()
+                : "[NetSync] story pin: intent " + nonce + "'s first frame I saw was built after the host's landing -- kept as late (a landing on field "
+                  + field + " stages the latest frame)" + Stamp());
+            return v;
+        }
+
+        private static void DropPin(Int32 k, Int32 byNonce)
+        {
+            PinEntry e = _pins[k];
+            _pins[k] = null;
+            _pinDropped++;
+            _pinSpentNonce = e.Nonce;
+            Log.Message("[NetSync] story pin: intent " + e.Nonce + "'s frame for field " + e.Field + " dropped unused (intent " + byNonce + " arrived)"
+                        + Stamp());
+        }
+
+        private static PinEntry PinHeld(Int32 nonce)
+        {
+            for (Int32 k = 0; k < _pins.Length; k++)
+                if (_pins[k] != null && _pins[k].Nonce == nonce)
+                    return _pins[k];
+            return null;
+        }
+
+        // The landing's entry: the one held for this field, else any held one (so `other` is counted), else null.
+        private static PinEntry PinFor(Int32 fld)
+        {
+            PinEntry any = null;
+            for (Int32 k = 0; k < _pins.Length; k++)
+            {
+                PinEntry e = _pins[k];
+                if (e == null)
+                    continue;
+                if (e.Field == fld)
+                    return e;
+                if (any == null)
+                    any = e;
+            }
+            return any;
+        }
+
+        // fromWorld (R3): the landing comes off the world map -- gMode 3 at the landing hook, the read LandingFollowCandidate takes.
+        private static Boolean LandingFromWorld()
+        {
+            EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+            return ee != null && ee.gMode == 3;
+        }
+
+        // The landing's decision (a guest's ApplyStoryImpl and the bench's): PinUseRule under the lever or a sticky fault, then LandingFrames;
+        // `pin.last_*` (the capture's quality whatever the verdict, P3), the verdict's counter, the record's `story`, and -- only when a pin
+        // for THIS field was held -- the story difference against the latest frame and the verdict's line (a pin for another field is
+        // counted, not logged).
+        private static void PinDecide(Int32 fld, Boolean fromWorld, Byte[] latest, out Byte[] story, out Byte[] party)
+        {
+            Int32 now = Environment.TickCount;
+            PinEntry e = PinFor(fld);
+            Int32 quality = e != null ? e.Quality : PinNone;
+            Int32 ageMs = e != null ? PinAgeRule(e.LandSeen, now - e.LandSeenTick, now - e.CaptureTick) : -1;
+            Int32 why;
+            Int32 verdict = PinUseRule(PinLeverOld || _pinFaulted, fromWorld, quality, e != null ? e.Field : -1, ageMs, fld, out why);
+            Byte[] dress;                               // always the latest frame: ApplyStoryImpl's ArmFromState(host) reads it as s163 does
+            LandingFrames(verdict, e != null ? e.Frame : null, latest, out story, out party, out dress);
+            _pinLastUse = why;
+            _pinLastQuality = quality;
+            _pinLastField = fld;
+            _pinLastAgeMs = ageMs;
+            _pinLastNonce = e != null ? e.Nonce : -1;
+            _pinLastParty = true;
+            switch (why)
+            {
+                case PinUsePin: _pinUsed++; break;
+                case PinUseAged: _pinAged++; break;
+                case PinUseOther: _pinOther++; break;
+                case PinUseWorld: _pinWorld++; break;
+                case PinUseLever: _pinLeverLatest++; break;
+            }
+            NoteRecordStory(verdict == PinVerdictPin ? "pin" : "latest");
+            if (e == null || e.Field != fld)
+                return;
+            Int32 first;
+            _pinLastDiff = NetSyncState.StoryDiff(e.Frame, latest, out first);
+            _pinLastDiffFirst = first;
+            Log.Message(verdict == PinVerdictPin
+                ? "[NetSync] story pin: field " + fld + " stages intent " + e.Nonce + "'s frame for its story, the latest frame for its party and dress (age "
+                  + ageMs + " ms; the latest differs at " + _pinLastDiff + " story bytes)" + Stamp()
+                : "[NetSync] story pin: field " + fld + " stages the latest frame -- " + PinLatestWords(why, ageMs, e.Nonce) + Stamp());
+        }
+
+        private static String PinLatestWords(Int32 why, Int32 ageMs, Int32 nonce)
+        {
+            switch (why)
+            {
+                case PinUseAged: return "the pin is " + ageMs + " ms old (over " + PinMaxAgeMs + ")";
+                case PinUseLate: return "intent " + nonce + "'s first frame came after the host's landing";
+                case PinUseWorld: return "a world-map landing (round 1 stages the latest there)";
+                case PinUseLever: return "the lever (s163's rule)";
+                default: return NameOf(PinUseNames, why) ?? "?";
+            }
+        }
+
+        // NetSyncClient.ApplyStoryImpl, after its `host == null` return (`latest` = the host's latest frame): the story to stage (the pin's
+        // frame or the latest) and the party (always the latest, R1). Never throws: a fault stages the latest frame and turns the lever on
+        // for the rest of the process.
+        internal static void PinLanding(Byte[] latest, out Byte[] story, out Byte[] party)
+        {
+            story = latest;
+            party = latest;
+            try
+            {
+                PinDecide(FF9StateSystem.Common.FF9.fldMapNo, LandingFromWorld(), latest, out story, out party);
+            }
+            catch (Exception err)
+            {
+                story = latest;
+                party = latest;
+                _pinFaulted = true;
+                NoteFault(ItemPin, "landing", err, "the latest frame stages this field (s163's rule) from here");
+            }
+        }
+
+        // ApplyStoryImpl (and the bench's landing): the pin's split did not apply, so the latest frame stages the field. Never throws.
+        internal static void PinStoryFailed()
+        {
+            try
+            {
+                NoteRecordStory("latest");
+                Log.Message("[NetSync] story pin: intent " + _pinLastNonce + "'s frame did not apply -- the latest frame stages field " + _pinLastField
+                            + Stamp());
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemPin, "not applied", err, "no line; the latest frame stages the field");
+            }
+        }
+
+        // ApplyStoryBeforeEvents, right after ApplyStoryImpl (every load, whether or not the apply ran): each entry this landing consumes goes
+        // and its nonce is spent; a bounce's reload of the source field keeps the pin for the follow's landing. Never throws.
+        internal static void ConsumePinAt(Int32 fld)
+        {
+            try
+            {
+                for (Int32 k = 0; k < _pins.Length; k++)
+                {
+                    PinEntry e = _pins[k];
+                    if (e != null && PinConsumed(e.Quality, e.Field, fld))
+                    {
+                        _pins[k] = null;
+                        _pinSpentNonce = e.Nonce;
+                    }
+                }
+            }
+            catch (Exception err)
+            {
+                _pinFaulted = true;
+                NoteFault(ItemPin, "consume", err, "every landing stages the latest frame (s163's rule) from here");
+            }
+        }
+
+        // The co-op session reset and the host epoch (Reset, ForgetHostNonce) and the exit ramp (NetSyncClient, before ExitMirrorToOwnSave):
+        // every held pin goes, silently, and the nonce on the latest host frame I read is spent, so a section 4 still live across the boundary
+        // is never re-captured (row c15).
+        internal static void ClearPins()
+        {
+            for (Int32 k = 0; k < _pins.Length; k++)
+                _pins[k] = null;
+            _pinSpentNonce = _pinFrameNonce;
+        }
+
+        // `swap pinbench <field> <flag> [age <ms>] [landed] [party <slot> <char>] [to <field>]` (the selftest role, the field-gate bench):
+        // NetSyncClient.DebugPinBench checks the follow's start gate FIRST (a refused follow leaves no bench pin behind), runs ArmPinBench,
+        // then the intent bench's own follow to the field (or `to`); the harness line prints after the follow's. The landing runs
+        // BenchPinLanding.
+        private static Boolean BenchPin(PinBenchArgs a, out String why)
+        {
+            String line = null;
+            if (!NetSyncClient.DebugPinBench(a.To > 0 ? a.To : a.Field, () => ArmPinBench(a, out line), out why))
+                return false;
+            Log.Message(line);
+            return true;
+        }
+
+        // Frame A = SnapshotAll() plus section 4 (IntentSectionBody: the landed bit clear, set under `landed`) through the real AppendSection
+        // and back through TryReadSection, into the REAL capture (PinCapture: its rule, its drops, its line); `age` marks the host's landing
+        // seen that long ago. Frame B, the latest frame's stand-in, is SnapshotAll() through the real encoder with <flag> set in its section
+        // 0 -- under `party`, taken with NetSyncParty.SlotSource pointing slot <slot> at ff9.player[<char>] (the SelfTestMirror idiom,
+        // restored in a finally), so that slot carries a self-consistent CharacterId, name and v9 block from the real codec (I4). Null =
+        // armed (`line` = the harness line), else the refusal; every refusal comes before the capture.
+        private static String ArmPinBench(PinBenchArgs a, out String line)
+        {
+            line = null;
+            FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+            Int32 my = ff9.fldMapNo;
+            if (!NetSyncState.StoryCarries(a.Flag >> 3))
+                return "netsync swap pinbench: flag " + a.Flag + " lies in the masked coop cells -- the story apply never carries it";
+            if (a.Field == my)
+                return "netsync swap pinbench: field " + a.Field + " is my own field -- a pin for the field I stand on is never kept (R4)";
+            PLAYER source = null;
+            if (a.Slot >= 0 && (ff9.player == null || !ff9.player.TryGetValue((Memoria.Data.CharacterId)a.CharId, out source) || source == null
+                                || source.info == null))
+                return "netsync swap pinbench: character " + a.CharId + " is not in ff9.player";
+            Byte[] snap = NetSyncState.SnapshotAll();
+            if (snap == null)
+                return "netsync swap pinbench: no story state to snapshot";
+            Byte nonce = PinBenchNonce();
+            Byte[] frameA = NetSyncState.AppendSection(snap, NetSyncState.SectionIntent, IntentSectionBody(a.Field, nonce, a.Landed));
+            Func<Int32, PLAYER> real = NetSyncParty.SlotSource;
+            Byte[] frameB;
+            try
+            {
+                if (source != null)
+                {
+                    Int32 slot = a.Slot;
+                    PLAYER seat = source;
+                    NetSyncParty.SlotSource = i => i == slot ? seat : real(i);
+                }
+                frameB = NetSyncState.SnapshotAll();     // the REAL encoder
+            }
+            finally
+            {
+                NetSyncParty.SlotSource = real;
+            }
+            Byte[] body;
+            if (frameB == null || !NetSyncState.SetStoryFlag(frameB, a.Flag, true)
+                || !NetSyncState.TryReadSection(frameA, NetSyncState.SectionIntent, out body) || body == null || body.Length < 3)
+                return "netsync swap pinbench: the codec round trip failed";
+            Int32 field = body[0] | (body[1] << 8), nc = body[2];
+            Int32 now = Environment.TickCount;
+            Int32 v = PinCapture(frameA, field, nc, IntentLandedOf(body), my, true, now);
+            if (v != PinPre && v != PinLate)
+                return "netsync swap pinbench: intent " + nc + "'s frame for field " + field + " was not kept";
