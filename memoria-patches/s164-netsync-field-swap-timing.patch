+        // ================================================================ A: the record's edges (main thread)
+
+        private static Int32 Join(Int32 edge, Int32 edgeField, Int32 myField, Boolean kick, Int64 now)
+        {
+            Record r = _rec;
+            return r == null ? JoinRule(edge, edgeField, myField, kick, RecNone, -1, -1, -1, now)
+                             : JoinRule(edge, edgeField, myField, kick, r.State, r.Dest, r.From, r.OpenT, now);
+        }
+
+        // A new record: the previous one closes first (OpenClosesRule), naming this one.
+        private static Record Open(Int32 edge, Int32 from, Int32 dest, Boolean host, Int64 now)
+        {
+            if (_rec != null)
+            {
+                Int32 c = OpenClosesRule(_rec.State);
+                if (c != CloseNone)
+                    Close(c, _recIds + 1, now);
+            }
+            Record r = new Record();
+            r.Id = ++_recIds;
+            r.Host = host;
+            r.From = from;
+            r.Dest = dest;
+            r.State = RecOpen;
+            r.OpenBy = edge;
+            r.OpenT = now;
+            _rec = r;
+            _open = true;
+            Transitions++;
+            return r;
+        }
+
+        private static void Close(Int32 why, Int32 byId, Int64 now)
+        {
+            Close(why, byId, now, false);   // [ff9mapkit netsync s164] review fix F07: every close but the session reset's reads the gate live
+        }
+
+        // [ff9mapkit netsync s164] review fix F07: `forceLog` = the caller already decided the session was live (ResetSession's
+        // `logClose`): L-CLOSE prints on it OR on SwapSessionRole's live read. The session reset runs after its caller nulled the
+        // transport, so the live read alone is false on a host or client there and "closed by the session reset" never printed.
+        private static void Close(Int32 why, Int32 byId, Int64 now, Boolean forceLog)
+        {
+            Record r = _rec;
+            if (r == null || !_open)
+                return;
+            r.State = RecDone;
+            r.CloseT = now;
+            r.CloseWhy = why;
+            _open = false;
+            if (why > 0 && why < ClosedBy.Length)
+                ClosedBy[why]++;
+            if (r.Host)
+                CopyIntentFigures(r);
+            String line = ClosedLine(!_stampsOff, r, why, byId, now);
+            if (line != null && (forceLog || NetSyncClient.SwapSessionRole))   // [ff9mapkit netsync s164] review fix F07
+                Log.Message(line);
+        }
