+            r.IntentFrames = _ipFrames;
+            r.IntentSends = _ipSends;
+            r.IntentSpanMs = _ipFirstSentT >= 0 && _ipLastSentT >= 0 ? _ipLastSentT - _ipFirstSentT : -1;
+            r.Oob = _ipOob;
+        }
