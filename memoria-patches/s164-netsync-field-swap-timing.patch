+        // ---------------------------------------------------------------- GUEST
+
+        // ObserveHostDialog's new-frame branch (right after NetSyncSpeed.NoteHostFrame): THE one guest reader of section 4 (conflict 6).
+        // A's part: a new nonce (SeenRule) records the seen edge -- seen_t, the nonce, arrived_t (the transport's arrival stamp when the
+        // probe still holds this very payload, else -1) -- and applies JoinRule(Seen); each further copy of the same nonce counts.
+        // C's part (CacheHostFrame, [ff9mapkit netsync s164]): the intent cache, on every frame (onWorld / following clear it).
+        // PIN's part (PinHostFrame, [ff9mapkit netsync s164]): the story pin's capture, on a client, for every new frame.
+        // `following`, `onWorld` and `offField` are the other items' inputs.
+        internal static void NoteHostFrame(Byte[] state, Int32 now, Int32 myField, Boolean onWorld, Boolean following, Int32 lastHostField,
+                                           Boolean offField)
+        {
+            try
+            {
+                Byte[] body;
+                if (state == null || !NetSyncState.TryReadSection(state, NetSyncState.SectionIntent, out body) || body == null || body.Length < 3)
+                {
+                    CacheHostFrame(-1, -1, myField, onWorld, following, lastHostField);   // [ff9mapkit netsync s164] C: no section 4 (the world / not-following clears still run)
+                    PinHostFrame(state, -1, -1, true, myField);   // [ff9mapkit netsync s164] PIN: a frame without section 4 (its own try)
+                    return;
+                }
+                Int32 field = body[0] | (body[1] << 8);
+                Int32 nonce = body[2];
+                CacheHostFrame(field, nonce, myField, onWorld, following, lastHostField);   // [ff9mapkit netsync s164] C: the intent cache (its own try)
+                PinHostFrame(state, field, nonce, IntentLandedOf(body), myField);   // [ff9mapkit netsync s164] PIN: the capture (its own try)
+                ArriveHostFrame(state, body, field, nonce, now);   // [ff9mapkit netsync s164] THE ARRIVAL GUARD: R, the host's landing as I first saw it (its own try)
+                Int64 t = NowMs();
+                if (SeenRule(true, nonce, _seenNonce))
+                {
+                    Int64 arrived = -1;
+                    INetTransport tr = NetSyncClient.SwapTransport;
+                    if (tr != null)
+                    {
+                        StateProbe p = tr.ReadStateProbe();
+                        if (ReferenceEquals(p.InState, state))
+                            arrived = TicksToMs(p.InStateTs);
+                    }
+                    SeenEdge(field, nonce, myField, lastHostField, t, arrived);
+                }
+                else
+                {
+                    _seenCopies++;
+                    _seenLastT = t;
+                    if (_seenRec != null && ReferenceEquals(_seenRec, _rec))
+                        _seenRec.SeenCopies++;
+                }
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemA, "host frame", err, "the seen edge goes unrecorded");
+            }
+        }
