+        // `elsewhere`). A behaviour line: printed under either lever, stamped while stamps are on. Never throws.
+        internal static void NoteIntentLanded(Int32 nonce, Int32 dest, Int32 loaded, Int32 landing, Int32 landedMs)
+        {
+            try
+            {
+                Int64 t = NowMs();
+                if (landing == LandingOnIntent)
+                    Log.Message("[NetSync] transition intent " + nonce + ": I landed on field " + dest + " after " + landedMs + " ms -- section 4 stays "
+                                + "until my body stands there, 2 s since the emit and 1 s since this landing" + Stamp(t));
