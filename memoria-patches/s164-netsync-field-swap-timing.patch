+        // NetSyncClient.NoteFieldLanding (every field load): the backstop -- a cache still standing for a field I left clears. GuestTick has
+        // already cleared one for any field the copy left; a bounce reload lands on src and keeps it, on purpose.
+        internal static void CacheLandingBackstop(Int32 fld)
