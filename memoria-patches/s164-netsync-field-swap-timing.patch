+            row(QuietEqualsLoud(r), "quiet_equals_loud");
+        }
+
+        // ---------------------------------------------------------------- LIFE's rows ([ff9mapkit netsync s164], the host's intent lifetime)
+
+        // LIFE's rows (ids and inputs as the design's table and the kit's twins; the intent field 352, another 353): IntentLifeRule (r1-r12,
+        // the T13 slow loads, the S1 swirl, the T2 order pair), BodyThereRule (b1-b4, F14), IntentLandingStep (l1-l5); then PIN's host half,
+        // which the host emits: IntentSectionBody / IntentLandedOf (S3). live.frame_carries_4 is in LiveRows.
+        private static void RowsLife(Rules r, Action<Boolean, String> row)
+        {
+            const Boolean T = true, F = false;
+            const Int32 P = LandingPending, On = LandingOnIntent, E = LandingElsewhere, X = -1;   // X: "-" (not read)
+            // IntentLifeRule (old rule, since the emit, since the landing, landing, on the intent field, body there)
+            row(r.Life(T, 0, X, P, T, F) == IntentEndOld, "r1");
+            row(r.Life(T, 0, X, P, F, F) == IntentEndNone, "r2");
+            row(r.Life(F, 16, X, P, T, T) == IntentEndNone, "r3");                 // R1: the shutdown frame
+            row(r.Life(F, 9999, X, P, F, F) == IntentEndNone, "r4");
+            row(r.Life(F, 10000, X, P, F, F) == IntentEndCap, "r5");
+            row(r.Life(F, 0, X, E, F, F) == IntentEndElsewhere, "r6");
+            row(r.Life(F, 1999, 1500, On, T, T) == IntentEndNone, "r7");
+            row(r.Life(F, 2000, 1000, On, T, T) == IntentEndStands, "r8");
+            row(r.Life(F, 5000, 4000, On, T, F) == IntentEndNone, "r9");
+            row(r.Life(F, 30000, 29000, On, T, F) == IntentEndNone, "r9b");
+            row(r.Life(F, 500, 100, On, F, F) == IntentEndLeft, "r10");
+            row(r.Life(F, 30000, 29000, On, T, T) == IntentEndStands, "r11");
+            row(r.Life(F, 100, 50, On, F, T) == IntentEndLeft, "r12");
+            row(r.Life(F, 2300, 0, On, T, T) == IntentEndNone, "r-slowload");      // T13
+            row(r.Life(F, 3300, 1000, On, T, T) == IntentEndStands, "r-slowload2"); // T13
+            row(r.Life(F, 1200, 800, On, F, F) == IntentEndLeft, "r-swirl");       // S1: the swirl's first frame (the FieldMap gone, gMode still 1)
+            row(r.Life(F, 0, X, P, T, T) == IntentEndNone, "r-order");             // T2: the emit frame, already reading the intent field
+            row(r.Life(T, 0, X, P, T, T) == IntentEndOld, "r-order-old");          // T2: s163's rule there -- the R1 hole
+            // BodyThereRule (in scope, an Actor, its fieldMapActor)
+            row(r.Body(T, T, T), "b1");
+            row(!r.Body(T, T, F), "b2");                                           // the player actor before its fieldMapActor binds
+            row(!r.Body(F, T, T), "b3");
+            row(!r.Body(T, F, F), "b4");
+            // IntentLandingStep (landing, active, intent field, loaded field)
+            row(r.Landing(P, T, 352, 352) == On, "l1");
+            row(r.Landing(P, T, 352, 353) == E, "l2");
+            row(r.Landing(On, T, 352, 353) == On, "l3");
+            row(r.Landing(P, F, 352, 352) == P, "l4");
+            row(r.Landing(E, T, 352, 352) == E, "l5");
+            // PIN's host half (S3): section 4's body and its landed bit
+            Byte[] b = r.SectionBody(352, 7, false);
+            row(b != null && b.Length == 4 && b[0] == 96 && b[1] == 1 && b[2] == 7 && b[3] == 0 && !r.LandedOf(b), "body.round_trip");
+            row(r.LandedOf(new Byte[] { 96, 1, 7, 1 }), "landed.flag_set");
+            row(r.LandedOf(new Byte[] { 96, 1, 7 }), "landed.s163_body");          // an s163 host's 3-byte section reads as landed
+            row(!r.LandedOf(new Byte[] { 96, 1, 7, 2 }), "landed.other_bits");     // only bit 0 counts
+        }
+
+        // ---------------------------------------------------------------- PIN's rows ([ff9mapkit netsync s164], the guest's story pin)
+
+        // PIN's rows (ids and inputs as the design's table and the kit's twins; n = the frame's nonce 7, n2 = 8; the pin's field 352, another
+        // 353): PinCaptureRule (c1-c7, the T1 spent rows c13-c15, the R4 here rows c16-c17), PinUseRule (u1-u10), PinConsumed (k1-k4),
+        // PinDropOnNew (d1-d4) and PinTargeted (t1-t5) (T5), PinAgeRule (a1-a4, T6), LandingFrames (f1-f2, R1: three outputs) and the
+        // sequence row. Section 4's body and its landed bit are RowsLife's (the host emits them); live.pin_applies_verbatim and
+        // live.pin_split_applies are in LiveRows.
+        private static void RowsPin(Rules r, Action<Boolean, String> row)
+        {
+            const Boolean T = true, F = false;
+            const Int32 KE = PinKeep, HE = PinHere, NO = PinNone, PR = PinPre, LA = PinLate, n = 7, n2 = 8, D = 352, E = 353;
+            // PinCaptureRule (spent, here, the held entry's quality, the frame's nonce, its landed bit)
+            row(r.Capture(F, F, NO, -1, F) == KE, "c1");                           // no section 4
+            row(r.Capture(F, F, NO, n, F) == PR, "c2");
+            row(r.Capture(F, F, NO, n, T) == LA, "c3");                            // S3: the first frame I saw was built after the host's landing
+            row(r.Capture(F, F, PR, n, F) == KE, "c4");                            // a later pre-landing frame: compared, never replaces
+            row(r.Capture(F, F, PR, n, T) == KE, "c5");                            // a post-landing frame never replaces the pin
+            row(r.Capture(F, F, LA, n, F) == KE, "c6");
+            row(r.Capture(F, F, NO, n2, F) == PR, "c7");                           // a new nonce while n is held
+            row(r.Capture(T, F, NO, n, F) == KE, "c13");                           // T1: after its consumption
+            row(r.Capture(T, F, NO, n, T) == KE, "c14");                           // T1: spent beats everything
+            row(r.Capture(T, F, NO, n, F) == KE, "c15");                           // T1: after an epoch reset, section 4 still live
+            row(r.Capture(F, T, NO, n, F) == HE, "c16");                           // R4: I already stand on the announced field
+            row(r.Capture(F, T, NO, n, T) == HE, "c17");                           // R4: here is judged before the landed bit
+            // PinUseRule (the lever, from the world map, quality, the pin's field, its age, the landed field) -> verdict / why
+            row(UseIs(r, T, F, PR, D, 500, D, PinVerdictLatest, PinUseLever), "u1");
+            row(UseIs(r, F, F, NO, -1, -1, D, PinVerdictLatest, PinUseNone), "u2");
+            row(UseIs(r, F, F, PR, D, 1200, D, PinVerdictPin, PinUsePin), "u3");
+            row(UseIs(r, F, F, PR, D, 2500, D, PinVerdictPin, PinUsePin), "u4");
+            row(UseIs(r, F, F, PR, D, 2501, D, PinVerdictLatest, PinUseAged), "u5");
+            row(UseIs(r, F, F, PR, D, 500, E, PinVerdictLatest, PinUseOther), "u6");
+            row(UseIs(r, F, F, LA, D, 500, D, PinVerdictLatest, PinUseLate), "u7");
+            row(UseIs(r, F, F, PR, D, -1, D, PinVerdictLatest, PinUseAged), "u8");
+            row(UseIs(r, F, T, PR, D, 500, D, PinVerdictLatest, PinUseWorld), "u9");   // R3
+            row(UseIs(r, T, T, PR, D, 500, D, PinVerdictLatest, PinUseLever), "u10");  // the lever first
+            // PinConsumed (quality, the pin's field, the landed field)
+            row(r.Consumed(PR, D, D), "k1");
+            row(!r.Consumed(PR, D, E), "k2");                                      // the bounce's reload keeps the pin
+            row(r.Consumed(LA, D, D), "k3");
+            row(!r.Consumed(NO, -1, D), "k4");
+            // PinDropOnNew (the held entry's field, a follow targets it, the new nonce's field) (T5)
+            row(!r.Drop(D, T, E), "d1");                                           // the chain: a follow to D pending when E's nonce arrives
+            row(r.Drop(D, F, E), "d2");
+            row(r.Drop(D, T, D), "d3");                                            // superseded by a newer nonce for the same field
+            row(r.Drop(D, F, D), "d4");
+            // PinTargeted (the pin's field, pending, committed, warped-to) (T5)
+            row(r.Targeted(D, D, -1, -1), "t1");
+            row(r.Targeted(D, -1, D, -1), "t2");
+            row(r.Targeted(D, -1, -1, D), "t3");
+            row(!r.Targeted(D, E, E, E), "t4");
+            row(!r.Targeted(-1, -1, -1, -1), "t5");
+            // PinAgeRule (landing seen, since it, since the capture) (T6)
+            row(r.Age(T, 1200, 3000) == 1200, "a1");
+            row(r.Age(F, -1, 2000) == 0, "a2");
+            row(r.Age(F, -1, 10000) == 10000, "a3");
+            row(r.Age(T, 2600, 2650) == 2600, "a4");
+            // LandingFrames (R1): the story, the party, the dress
+            Byte[] pin = { 1 }, latest = { 2 }, story, party, dress;
+            r.Frames(PinVerdictPin, pin, latest, out story, out party, out dress);
+            row(ReferenceEquals(story, pin) && ReferenceEquals(party, latest) && ReferenceEquals(dress, latest), "f1");
+            r.Frames(PinVerdictLatest, pin, latest, out story, out party, out dress);
+            row(ReferenceEquals(story, latest) && ReferenceEquals(party, latest) && ReferenceEquals(dress, latest), "f2");
+            row(PinSeq(r), "seq.landing_ages_the_pin");
+        }
+
+        private static Boolean UseIs(Rules r, Boolean leverOld, Boolean fromWorld, Int32 quality, Int32 pinField, Int32 ageMs, Int32 fld, Int32 verdict,
+                                     Int32 why)
+        {
+            Int32 w;
+            return r.Use(leverOld, fromWorld, quality, pinField, ageMs, fld, out w) == verdict && w == why;
+        }
+
+        // seq.landing_ages_the_pin: a Pre capture at t0; a later pre-landing frame at t0+200 (Keep: compared); the first landed frame at
+        // t0+400 (Keep; the host's landing seen there); the guest's landing at t0+1600 -> age 1200 -> Pin; at t0+3000 -> age 2600 -> aged.
+        private static Boolean PinSeq(Rules r)
+        {
+            Int32 held = r.Capture(false, false, PinNone, 7, false);
+            if (held != PinPre || r.Capture(false, false, held, 7, false) != PinKeep || r.Capture(false, false, held, 7, true) != PinKeep)
+                return false;
+            const Int32 landT = 400;
+            Int32 a1 = r.Age(true, 1600 - landT, 1600), a2 = r.Age(true, 3000 - landT, 3000);
+            return a1 == 1200 && UseIs(r, false, false, held, 352, a1, 352, PinVerdictPin, PinUsePin)
+                   && a2 == 2600 && UseIs(r, false, false, held, 352, a2, 352, PinVerdictLatest, PinUseAged);
+        }
+
+        // The core's decision for one same-tick row: my field 351, following, usable, no kick, no live intent, no cache.
+        private static Int32 SameTick(Rules r, Int32 lever, Int32 pending, Int32 committed, Int32 lane, Int32 dest, out Int32 why)
+        {
+            return JumpVerdictBy(r.Pass, r.JumpOf, lever, true, 351, dest, lane, true, pending, false, committed, -1, -1, false, out why);
+        }
+
+        private static void BookOf(Rules r, Int32 term, Int32 dest, Int32 pending, Int32 committed, out Int32 p, out Int32 c, out Boolean bend)
+        {
+            p = pending;
+            c = committed;
+            r.Book(term, dest, ref p, ref c, out bend);
+        }
+
+        // quiet_equals_loud: (1) HoldVerdict over the full input grid against s161's rule order restated (HoldTwin), every clock one short of
+        // and at its bound; (2) each grid point written into NetSyncAte's statics (SetHoldState), the quiet query compared with the LOUD
+        // HoldsFollow, the saved statics restored in a finally. HoldsFollow's log latches are pre-set to the verdict the point must give,
+        // so the loud path prints nothing, and its arming and counters are undone with the rest. Each half must reach every outcome it can
+        // (a sweep that cannot fail proves nothing).
+        // [ff9mapkit netsync s164] F09: inside one SelfTest call the sweep is cached (SweepCache). VerdictGrid reads no rule set, so it runs
+        // once per call; LiveHoldGrid reads only r.Quiet, so it runs once for the real query and again for every rule set whose Quiet is
+        // another delegate (today quiet_no_exit_hold), the real result never reused for one. Every rule set still counts the row once (N and
+        // M unchanged).
+        // Outside a SelfTest call (an offline runner's Rows or QuietEqualsLoud) the whole sweep runs, as before.
+        private static Boolean QuietEqualsLoud(Rules r)
+        {
+            if (!_sweepCaching)
+                return VerdictGrid() && LiveHoldGrid(r);
+            _sweepRuleSets++;
+            if (_sweepVerdict < 0)
+            {
+                _sweepVerdictRuns++;
+                _sweepVerdict = VerdictGrid() ? 1 : 0;
+            }
+            if (_sweepVerdict == 0)
+                return false;
+            if (r.Quiet != (QuietFn)NetSyncAte.HoldsFollowQuiet)   // Delegate equality: the same method and target (.NET 3.5)
+            {
+                _sweepLiveRuns++;
+                return LiveHoldGrid(r);
+            }
+            if (_sweepLiveReal < 0)
+            {
+                _sweepLiveRuns++;
+                _sweepLiveReal = LiveHoldGrid(r) ? 1 : 0;
+            }
+            return _sweepLiveReal == 1;
+        }
+
+        // [ff9mapkit netsync s164] F09: the sweep's cache lives only inside one SelfTest call -- SweepCache(true) on entry, SweepCache(false)
+        // in its finally -- so nothing carries across calls or sessions. The counters (rule sets judged, sweeps run) feed the cost line.
+        private static Boolean _sweepCaching;
+        private static Int32 _sweepVerdict = -1, _sweepLiveReal = -1;   // -1 = not swept in this call, 0 = false, 1 = true
+        private static Int32 _sweepRuleSets, _sweepVerdictRuns, _sweepLiveRuns;
+
+        private static void SweepCache(Boolean on)
+        {
+            _sweepCaching = on;
+            _sweepVerdict = -1;
+            _sweepLiveReal = -1;
+            if (on)
+                _sweepRuleSets = _sweepVerdictRuns = _sweepLiveRuns = 0;
+        }
+
+        private static readonly Int32[] GridExit = { -1, 352, 350 };   // the exit hold unset, on the follow's destination (352), elsewhere
+        private static readonly Int32[] GridNone = { -1 }, GridZero = { 0 };
+        private static readonly Int32[] PickBounds = { NetSyncAte.HubHoldMs - 1, NetSyncAte.HubHoldMs };
+        private static readonly Int32[] PrepickBounds = { NetSyncAte.PrepickHoldMs - 1, NetSyncAte.PrepickHoldMs };
+        private static readonly Int32[] TailBounds = { 0, NetSyncAte.TailCapMs - 1, NetSyncAte.TailCapMs };
+        private static readonly Int32[] ProgressBounds = { NetSyncAte.TailHoldMs - 1, NetSyncAte.TailHoldMs };
+        private static readonly Int32[] PreBounds = { 0, NetSyncAte.PreHoldMs - 1, NetSyncAte.PreHoldMs };
+        // the live half's clocks, 1 s short of or past each bound (TickCount moves between the reads); -1 = the clock unarmed
+        private static readonly Int32[] LivePick = { NetSyncAte.HubHoldMs - 1000, NetSyncAte.HubHoldMs + 1000 };
+        private static readonly Int32[] LivePrepick = { NetSyncAte.PrepickHoldMs - 1000, NetSyncAte.PrepickHoldMs + 1000 };
+        private static readonly Int32[] LivePrepickShort = { NetSyncAte.PrepickHoldMs - 1000 };
+        private static readonly Int32[] LiveTail = { -1, NetSyncAte.TailCapMs - 1000, NetSyncAte.TailCapMs + 1000 };
+        private static readonly Int32[] LiveProgress = { NetSyncAte.TailHoldMs - 1000, NetSyncAte.TailHoldMs + 1000 };
+        private static readonly Int32[] LivePre = { -1, NetSyncAte.PreHoldMs - 1000, NetSyncAte.PreHoldMs + 1000 };
+
+        // s161's order, restated: the exit hold; nothing pending or playing, or the lever; then with my control off HUB, PREPICK and TAIL;
+        // then PENDING.
+        private static Int32 HoldTwin(NetSyncAte.HoldInputs h)
+        {
+            if (h.ExitHoldField > 0 && h.Dest == h.ExitHoldField && !h.LeverOff)
+                return NetSyncAte.HoldExit;
+            if ((h.Phase == NetSyncAte.PhaseNone && !h.Pending) || h.LeverOff)
+                return NetSyncAte.HoldNone;
+            if (!h.MyCtl && h.Phase == NetSyncAte.PhaseHub && h.ByHost && h.SincePickMs >= 0 && h.SincePickMs < NetSyncAte.HubHoldMs)
+                return NetSyncAte.HoldHub;
+            if (!h.MyCtl && h.Phase == NetSyncAte.PhaseHub && !h.ByHost && h.ChoiceQueued && h.PrepickMs < NetSyncAte.PrepickHoldMs)
+                return NetSyncAte.HoldPrepick;
+            if (!h.MyCtl && h.Phase == NetSyncAte.PhaseDest && h.TailMs < NetSyncAte.TailCapMs && h.ProgressMs >= 0
+                && h.ProgressMs < NetSyncAte.TailHoldMs)
+                return NetSyncAte.HoldTail;
+            return h.PendingHere && h.PressQueued && h.PreMs < NetSyncAte.PreHoldMs ? NetSyncAte.HoldPending : NetSyncAte.HoldNone;
+        }
+
+        // HoldsFollow's cap latch for a point that holds nothing, so its "stops waiting" line stays quiet in the sweep.
+        private static Int32 CapTwin(NetSyncAte.HoldInputs h, Boolean preArmed, Boolean tailArmed)
+        {
+            return preArmed && h.PreMs >= NetSyncAte.PreHoldMs ? NetSyncAte.HoldPending
+                 : h.Phase == NetSyncAte.PhaseHub && !h.ByHost && h.ChoiceQueued && h.PrepickMs >= NetSyncAte.PrepickHoldMs ? NetSyncAte.HoldPrepick
+                 : tailArmed && (h.TailMs >= NetSyncAte.TailCapMs || h.ProgressMs >= NetSyncAte.TailHoldMs) ? NetSyncAte.HoldTail
+                 : NetSyncAte.HoldNone;
+        }
+
+        // The pure half: the exit hold (unset, on dest, elsewhere) x the lever x the phase (none, HUB before the pick, HUB after it, DEST) x
+        // the press (none, on my field, elsewhere) x my control x each pick queued x every clock the point reads.
+        private static Boolean VerdictGrid()
+        {
+            Boolean[] reached = new Boolean[NetSyncAte.HoldExit + 1];
+            NetSyncAte.HoldInputs h = new NetSyncAte.HoldInputs();
+            h.Dest = 352;
+            for (Int32 e = 0; e < GridExit.Length; e++)
+                for (Int32 lv = 0; lv < 2; lv++)
+                    for (Int32 ph = 0; ph < 4; ph++)
+                        for (Int32 pd = 0; pd < 3; pd++)
+                            for (Int32 b = 0; b < 8; b++)
+                            {
+                                h.ExitHoldField = GridExit[e];
+                                h.LeverOff = lv == 1;
+                                h.Phase = ph == 0 ? NetSyncAte.PhaseNone : ph == 3 ? NetSyncAte.PhaseDest : NetSyncAte.PhaseHub;
+                                h.ByHost = ph == 2;
+                                h.Pending = pd != 0;
+                                h.PendingHere = pd == 1;
+                                h.MyCtl = (b & 1) != 0;
+                                h.PressQueued = (b & 2) != 0;
+                                h.ChoiceQueued = (b & 4) != 0;
+                                foreach (Int32 pick in h.ByHost ? PickBounds : GridNone)
+                                    foreach (Int32 open in h.Phase == NetSyncAte.PhaseHub ? PrepickBounds : GridZero)
+                                        foreach (Int32 tail in h.Phase == NetSyncAte.PhaseDest ? TailBounds : GridZero)
+                                            foreach (Int32 prog in h.Phase == NetSyncAte.PhaseDest ? ProgressBounds : GridNone)
+                                                foreach (Int32 pre in h.PendingHere ? PreBounds : GridZero)
+                                                {
+                                                    h.SincePickMs = pick;
+                                                    h.PrepickMs = open;
+                                                    h.TailMs = tail;
+                                                    h.ProgressMs = prog;
+                                                    h.PreMs = pre;
+                                                    Int32 v = NetSyncAte.HoldVerdict(h);
+                                                    if (v != HoldTwin(h) || v < 0 || v >= reached.Length)
+                                                        return false;
+                                                    reached[v] = true;
+                                                }
+                            }
+            for (Int32 k = 0; k < reached.Length; k++)
+                if (!reached[k])
+                    return false;
+            return true;
+        }
+
+        // The live half: every grid point of NetSyncAte's statics (the same axes; the clocks as LivePick .. LivePre), quiet against loud.
+        private static Boolean LiveHoldGrid(Rules r)
+        {
+            NetSyncAte.HoldState saved = NetSyncAte.GetHoldState();
+            Int32 held = 0, free = 0;
+            try
+            {
+                for (Int32 e = 0; e < GridExit.Length; e++)
+                    for (Int32 lv = 0; lv < 2; lv++)
+                        for (Int32 ph = 0; ph < 4; ph++)
+                            for (Int32 pd = 0; pd < 3; pd++)
+                                for (Int32 b = 0; b < 8; b++)
+                                    foreach (Int32 pick in ph == 2 ? LivePick : GridZero)
+                                        foreach (Int32 open in ph == 1 ? LivePrepick : LivePrepickShort)
+                                            foreach (Int32 tail in ph == 3 ? LiveTail : GridNone)
+                                                foreach (Int32 prog in ph == 3 ? LiveProgress : GridZero)
+                                                    foreach (Int32 pre in pd == 1 ? LivePre : GridNone)
+                                                    {
+                                                        Boolean myCtl = (b & 1) != 0, pressQueued = (b & 2) != 0, choiceQueued = (b & 4) != 0;
+                                                        Int32 now = Environment.TickCount;
+                                                        NetSyncAte.HoldState s = saved;
+                                                        s.Lever = lv;               // 1 = off (LeverOff reads it on the selftest role only)
+                                                        s.ExitHoldField = GridExit[e];
+                                                        s.ExitHoldLogged = true;
+                                                        s.Phase = ph == 0 ? NetSyncAte.PhaseNone : ph == 3 ? NetSyncAte.PhaseDest : NetSyncAte.PhaseHub;
+                                                        s.ByHost = ph == 2;
+                                                        s.Pending = pd != 0;
+                                                        s.PField = pd == 2 ? 353 : 351;
+                                                        s.PickTick = now - pick;
+                                                        s.OpenTick = now - open;
+                                                        s.TailArmed = tail >= 0;
+                                                        s.TailSince = now - Math.Max(tail, 0);
+                                                        s.TailProgress = now - prog;
+                                                        s.PreArmed = pre >= 0;
+                                                        s.PreSince = now - Math.Max(pre, 0);
+                                                        NetSyncAte.SetHoldState(s);
+                                                        NetSyncAte.HoldInputs h = NetSyncAte.HoldInputsNow(352, myCtl, 351, pressQueued, choiceQueued);
