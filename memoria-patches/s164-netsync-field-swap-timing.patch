+        // never_past_the_timer: every path, view, black count, grace, backlog, primed and lever with the timer out -- never Wait, never Prime.
+        private static Boolean NeverPastTheTimer(Rules r)
+        {
+            Int32[] bts = { -1, 0, 2, 3, 5 }, graces = { 0, 3 };
+            for (Int32 p = PathFast; p <= PathKick; p++)
+                for (Int32 v = ViewUnknown; v <= ViewBlack; v++)
+                    foreach (Int32 bt in bts)
+                        foreach (Int32 g in graces)
+                            for (Int32 bk = BkNone; bk <= BkUnknown; bk++)
+                                for (Int32 pr = 0; pr < 2; pr++)
