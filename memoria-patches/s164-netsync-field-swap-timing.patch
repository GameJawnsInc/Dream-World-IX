+        // the proof block's frameWithIntent delegate builds the real host frame with THIS intent live (LIFE's live.frame_carries_4 reads it)
+        internal const Int32 ProbeIntentField = 352;
+        internal const Byte ProbeIntentNonce = 0xA5;
+        // [ff9mapkit netsync s164] LIFE: the stages frameWithIntent builds that frame at -- the landing Pending, landed (OnIntent), and after
+        // the REAL life step's decision ended the intent
+        internal const Int32 ProbeStagePending = 0, ProbeStageLanded = 1, ProbeStageEnded = 2;
+
+        // ================================================================ names (code = state and log name)
+        internal const Int32 EdgeEmit = 1, EdgeSeen = 2, EdgeFollow = 3, EdgeOwn = 4, EdgeCommit = 5, EdgeDrop = 6, EdgeLand = 7, EdgeLine = 8;
+        internal static readonly String[] EdgeNames = { null, "emit", "seen", "follow", "own", "commit", "drop", "land", "line" };
+        internal const Int32 RecNone = 0, RecOpen = 1, RecLanded = 2, RecDone = 3;
+        internal static readonly String[] RecNames = { null, "open", "landed", "done" };
+        internal const Int32 JoinIgnore = 0, JoinOpen = 1, JoinJoin = 2, JoinReload = 3;
+        // the writers: the last write of the next field before a load (a writer's via is its own code: LandViaRule returns it)
+        internal const Int32 WriteNone = 0, WriteFollow = 1, WriteKick = 2, WriteOwn = 3, WriteBounce = 4, WriteHost = 5;
+        internal const Int32 ViaNone = 0, ViaFollow = 1, ViaKick = 2, ViaOwn = 3, ViaBounce = 4, ViaHost = 5, ViaSame = 6, ViaOther = 7;
+        internal static readonly String[] ViaNames = { null, "follow", "kick", "own", "bounce", "host", "same", "other" };
+        internal static readonly String[] ViaWords = { null, "via the follow", "via the same-field kick", "via my own Field()", "via a bounce reload",
+                                                       "via my own transition", "a reload of the same field", "another load" };
+        internal const Int32 CloseNone = 0, CloseLine = 1, CloseWindow = 2, CloseStale = 3, CloseSuperseded = 4, CloseNext = 5, CloseReset = 6;
+        internal static readonly String[] CloseNames = { null, "line", "window", "stale", "superseded", "next", "reset" };
