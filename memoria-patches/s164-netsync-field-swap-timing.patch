+        // NetSyncSwap.SelfTest, beside its live rows: every D+E row (`rows` += their count; a failure is added to `fails` by its id), then
+        // the two live rows, counted once -- slot_reads (the fade slot reads through SceneDirector.NetSyncReadFade) and today_constants
+        // (the Old path's frames and timer are NetSyncClient's own: the Old path is byte-identical to today's follow fade).
+        internal static void SelfTestRows(ref Int32 rows, List<String> fails)
+        {
+            rows += Rows(new Rules(), fails);
+            Boolean reads;
+            try
+            {
+                Int32 m, c, t, l;
+                reads = SceneDirector.NetSyncReadFade(out m, out c, out t, out l);
+            }
+            catch
+            {
+                reads = false;
+            }
+            rows++;
+            if (!reads)
+                fails.Add("live.slot_reads");
+            rows++;
+            if (!(OldFrames == NetSyncClient.SwapFollowFadeFrames && OldWaitS == NetSyncClient.SwapFollowFadeWait))
+                fails.Add("live.today_constants");
+        }
+
+        // NetSyncSwap.SelfTest, after its own mutants: every D+E mutant must fail at least one row. Returns the mutants caught; `survived`
+        // = the first that failed none (null = every one caught).
+        internal static Int32 SelfTestMutants(out String survived)
+        {
+            survived = null;
+            Int32 caught = 0;
+            for (Int32 k = 0; k < MutantNames.Length; k++)
+            {
+                List<String> mf = new List<String>();
+                Rows(Mutant(MutantNames[k]), mf);
+                if (mf.Count == 0)
+                {
+                    survived = MutantNames[k];
+                    return caught;
+                }
+                caught++;
+            }
+            return caught;
+        }
+    }
+}
