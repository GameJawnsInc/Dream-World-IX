+        // Counted (Faults, FaultsBy, LastFault "<item>@<site>: <msg>") and logged ONCE per site with the fallback it took (today's behaviour).
+        // Main thread.
+        internal static void NoteFault(Int32 item, String site, Exception err, String fallback)
+        {
+            String name = item >= 0 && item < ItemNames.Length ? ItemNames[item] : "?";
+            String msg = err != null ? err.Message : "?";
+            Faults++;
+            if (item >= 0 && item < FaultsBy.Length)
+                FaultsBy[item]++;
+            LastFault = name + "@" + site + ": " + msg;
+            if (err != null && _faultSites.Count < 64 && _faultSites.Add(name + "@" + site))
+                Log.Error(err, "[NetSync] field swap fault (" + name + " at " + site + "): " + msg + " -- " + fallback + " (logged once per site)");
+        }
