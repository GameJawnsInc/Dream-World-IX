+        // DebugInjectIntentImpl, right after its codec round trip (`swap intent` and the ~ intent bench): the bench host's section 4 as a
+        // seen edge (no transport: arrived_t -1, host_from -1).
+        internal static void NoteBenchSeen(Int32 field, Int32 nonce, Int32 myField)
+        {
+            try
+            {
+                _benchSeens++;
+                SeenEdge(field, nonce, myField, -1, NowMs(), -1);
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemA, "bench seen", err, "the seen edge goes unrecorded");
+            }
+            BenchCacheStep(field, nonce, myField);   // [ff9mapkit netsync s164] C: `swap intent` reaches the bench cache too (src my field, host_from -1)
+        }
+
+        private static void SeenEdge(Int32 field, Int32 nonce, Int32 myField, Int32 lastHostField, Int64 t, Int64 arrived)
+        {
+            _seenNonce = nonce;
+            _seenField = field;
+            _seenSrc = myField;
+            _seenHostFrom = lastHostField > 0 && lastHostField != 65535 && lastHostField != field ? lastHostField : -1;
+            _seenFirstT = t;
+            _seenLastT = t;
+            _seenArrivedT = arrived;
+            _seenCopies = 1;
+            _seenRec = null;
+            Int32 v = Join(EdgeSeen, field, myField, false, t);
+            if (v == JoinIgnore)
+                return;
+            Record r = v == JoinOpen ? Open(EdgeSeen, myField, field, false, t) : _rec;
+            if (r.SeenT < 0)
+            {
+                r.SeenT = t;
+                r.ArrivedT = arrived;
+            }
+            r.Nonce = nonce;
+            r.SeenCopies++;
+            _seenRec = r;
+        }
