+        // ResetGuestDedupForEpoch: a relaunched host's nonces restart, so the next frame's nonce reads new.
+        internal static void ForgetHostNonce()
+        {
+            _seenNonce = -1;
+            _seenRec = null;
+            ClearIntentCache("the host epoch changed", true);   // [ff9mapkit netsync s164] C: ...and the cache's spent nonce (its next one reads new)
+            ClearPins();                                        // [ff9mapkit netsync s164] PIN: "the host epoch changed" -- every held pin goes (row c15)
+            ForgetArrive("session");                            // [ff9mapkit netsync s164] THE ARRIVAL GUARD: a live guard is spent (session), R is forgotten
+        }
+
+        // ---------------------------------------------------------------- GUEST, C: the intent cache and the own pass ([ff9mapkit netsync s164])
+
+        // NoteHostFrame's part (every new host frame): on the world map or when not following the cache clears; else IntentCacheStep -- a Write
+        // caches the announced field on my field (host_from = the lane when it reads a real field other than the announced one), a Skip
+        // records the nonce and supersedes a standing cache. secNonce -1 = no section 4. Never throws.
+        private static void CacheHostFrame(Int32 secField, Int32 secNonce, Int32 myField, Boolean onWorld, Boolean following, Int32 lastHostField)
+        {
+            try
+            {
+                if (onWorld || !following)
+                {
+                    ClearIntentCache(onWorld ? "the world map" : "not following", false);
+                    return;
+                }
+                Int32 step = IntentCacheStep(_icField, _icNonce, secField, secNonce, myField);
+                if (step == CacheKeep)
+                    return;
+                if (step == CacheSkip)
+                {
+                    ClearIntentCache(SupersededWords(secNonce, secField), false);
+                    _icNonce = secNonce;
+                    return;
+                }
+                Int32 hostFrom = lastHostField > 0 && lastHostField != 65535 && lastHostField != secField ? lastHostField : -1;
+                WriteCache(secField, secNonce, myField, hostFrom, lastHostField, false);
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemC, "intent cache", err, "the cache is left as it was (today's rule decides an own Field() it would have passed)");
+            }
+        }
