+        // OrphanKept = OrphanSince; the falling edge decides HoldEndWhy and KeepRead, kept only for a hold that began as a relock) BEFORE the
+        // re-orphan reads KeepRead; then the action.
+        private static HoldStep HoldTick(Rules r, HoldWin w, Boolean settledLong, Boolean holds, Boolean claimed, Int32 now, Boolean leverOld)
+        {
