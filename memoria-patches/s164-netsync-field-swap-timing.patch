+using System.Runtime.InteropServices;
+using Assets.Scripts.Common;   // SceneDirector, FadeMode (the blackout bench)
+using Memoria.Prime;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync s164] FIELD-SWAP TIMING, ROUND 1 (studies/field-coop/SWAP-TIMING-S164.md, revision 3; the owner's call: round 1 of
+    // FIELD-SWAP-TIMING.md section 4, with the 12-tick follow fade for a guest that is not already faded). THE DEFECT: a parallel follow lands
+    // the guest about 1.04 s behind its host (the follow's 0.9 s timer is ~90% of it), its fade starts after the host's own fade has ended,
+    // at 3x the black screen outlives the fade by ~630 ms, 2 of 5 scripted Dali exits bounced through a reload, and Memoria.log's whole-second
+    // stamps can see none of it. This file is the round's home: item A's INSTRUMENT (the swap clock, the stamps, the swap record and its
+    // edges, the host's section-4 probe), the pure rules items C, PIN and LIFE add beside it, the round's ONE lever scheme
+    // (`netsync swap <op> [arg]`), the `netsync.swap` state readers and the ONE proof line ("field swap selftest: OK (...)").
+    //
+    // THE CLOCK  NowMs() = TicksToMs(QueryPerformanceCounter, QueryPerformanceFrequency) through a kernel32 P/Invoke: one system-wide counter
+    //            from boot, so both duo games stamp on ONE clock and the kit reads the same counter through ctypes (K-CLOCK). Off Windows, or
+    //            when the P/Invoke throws on its first call, System.Diagnostics.Stopwatch (clock.src "stopwatch": the kit voids every
+    //            cross-game row; deltas inside one game stay valid). Chosen ONCE per process; safe on the writer, reader and voice threads.
+    //            TicksToMs's split form never overflows a raw counter after months of uptime. Rule clocks stay TickCount (B, C, PIN, LIFE).
+    // THE STAMP  every behaviour and instrument line ends with " (t T ms)" while stamps are on, after any closing ")" (the kit's literals
+    //            keep matching). An edge reads the clock ONCE: its line and its state key carry the same t. `swap stamps off` =
+    //            CALIBRATION: no stamps, no waited/shown tails, no `[NetSync] swap` line -- behaviour lines still print, unstamped.
+    // THE RECORD one swap per transition, per copy: opened by its first edge (JoinRule: emit, seen, follow, own, commit, drop -- a load never
+    //            opens one), joined by later edges for the same field inside RecordSpanMs, landed by the load on its destination, closed by
+    //            its first line, the LineWindowMs window, staleness, the next record or the session reset (one L-CLOSE line). A landing's
+    //            via is the LAST WRITER of the next field (LandViaRule: s154's recorded-at-the-source law, never the destination).
+    // THE PROBE  the host's out-of-band intent frame is watched in the transport's state slot (INetTransport.SetStateWatched: the set and the
+    //            arm under ONE frames lock), so state shows whether it left the machine or was overwritten unsent, and how long and how
+    //            often section 4 rode the wire (the slot is re-sent every 33 ms write tick).
+    //
+    // Fail open everywhere: a throw is counted (Faults, LastFault "<item>@<site>: <msg>"), logged once per site ("[NetSync] field swap fault
+    // (<item> at <site>): ...", naming the fallback) and the stock path runs. Instrument lines are gated on NetSyncClient.SwapSessionRole.
+    // The wire stays v14 (round 1 adds no section); the harness protocol stays 5. Main thread unless a member says otherwise.
+    public static class NetSyncSwap
+    {
+        // ================================================================ the swap clock
+        [DllImport("kernel32")]
+        private static extern Boolean QueryPerformanceCounter(out Int64 count);
+        [DllImport("kernel32")]
+        private static extern Boolean QueryPerformanceFrequency(out Int64 frequency);
+
+        internal const Int32 ClockQpc = 1, ClockStopwatch = 2;
+        internal static readonly String[] ClockNames = { null, "qpc", "stopwatch" };
+
+        // The source, chosen ONCE per process by the first read on any thread (type initialization is thread-safe: the transport's writer
+        // and reader threads read the counter too). `hires` = a counter of 1 MHz or better (qpc) / Stopwatch.IsHighResolution (stopwatch).
+        private static class Clock
+        {
+            internal static readonly Int32 Src;
+            internal static readonly Int64 Hz;
+            internal static readonly Boolean HiRes;
+
+            static Clock()
+            {
+                Int32 src = ClockStopwatch;
+                Int64 hz = 0;
+                try
+                {
+                    Int64 count;
+                    if (Environment.OSVersion.Platform == PlatformID.Win32NT && QueryPerformanceFrequency(out hz) && hz > 0
+                        && QueryPerformanceCounter(out count) && count >= 0)
+                        src = ClockQpc;
+                }
+                catch (Exception)
+                {
+                    src = ClockStopwatch;               // the P/Invoke threw on its first call: the flagged fallback
+                }
+                if (src == ClockQpc)
+                {
+                    Hz = hz;
+                    HiRes = hz >= 1000000;
+                }
+                else
