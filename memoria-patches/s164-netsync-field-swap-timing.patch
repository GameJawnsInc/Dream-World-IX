+        // The watch's live figures while it still watches this intent on the transport it rode; else the last ones kept.
+        private static Boolean LiveWatch(out StateProbe p)
+        {
+            p = new StateProbe();
+            INetTransport tr = _ipSocket;
+            if (tr == null || _ipOobSeq < 0 || !ReferenceEquals(tr, NetSyncClient.SwapTransport))
+                return false;
+            p = tr.ReadStateProbe();
+            return p.WatchFrom == _ipOobSeq;
+        }
+
+        private static void RefreshWatch()
+        {
+            StateProbe p;
+            if (LiveWatch(out p))
+                KeepWatchFigures(p);   // [ff9mapkit netsync s164] review fix F07: the one place the watch's figures are kept
+        }
+
+        // [ff9mapkit netsync s164] review fix F07: NoteIntentEnd's refresh reads the transport the intent rode when its caller passed that
+        // one -- the session reset passes the transport its caller just stopped (SwapTransport is already null there, so LiveWatch read
+        // nothing and the reset end kept stale figures; the stopped transport's frames slot still holds the final ones). Any other socket
+        // (null: the bench; a stale one) falls back to the live read, exactly as before; the `next` and LIFE ends pass the live one.
+        private static void RefreshWatchOn(INetTransport rode)
+        {
+            if (rode == null || !ReferenceEquals(rode, _ipSocket) || _ipOobSeq < 0)
+            {
+                RefreshWatch();
+                return;
+            }
+            StateProbe p = rode.ReadStateProbe();
+            if (p.WatchFrom == _ipOobSeq)
+                KeepWatchFigures(p);
+        }
+
+        private static void KeepWatchFigures(StateProbe p)   // [ff9mapkit netsync s164] review fix F07: RefreshWatch's body, shared
+        {
+            _ipSends = p.WatchSends;
+            _ipFirstSentT = TicksToMs(p.WatchFirstTs);
+            _ipLastSentT = TicksToMs(p.WatchLastTs);
