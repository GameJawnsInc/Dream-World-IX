+        // THE one end of a host intent (I8: A's and LIFE's; the `next` end before a new emit, the `reset` end at the session reset, LIFE's
+        // step for the others): counts the end, closes the watch at SetSeq + 1 (the first frame built without section 4), keeps the
+        // watch's figures and logs LIFE's end line. The socket is the transport the intent rode (a stale one reads nothing).
+        internal static void NoteIntentEnd(Int32 why, INetTransport socket)
+        {
+            Int64 t = NowMs();
+            try
+            {
+                if (!_ipActive)
+                    return;
+                _ipActive = false;
+                Int64 life = Environment.TickCount - _ipEmitTick;   // tick-baseline law: read while armed
+                _ipEndT = t;
+                _ipLastEnd = why;
+                _ipLastSite = _ipSite;
+                _ipLastLifeMs = life;
+                if (why > 0 && why < IntentEnds.Length)
+                    IntentEnds[why]++;
+                if (why == IntentEndNext)
+                    IntentReplaced++;
+                if (socket != null && ReferenceEquals(socket, _ipSocket) && _ipOobSeq >= 0)
+                {
+                    StateProbe p = socket.ReadStateProbe();
