+        // NoteBenchSeen's part (`swap intent` and the ~ intent bench, the selftest role): the bench host's section 4 into the cache, src my
+        // field, host_from -1, bench. Never throws.
+        private static void BenchCacheStep(Int32 field, Int32 nonce, Int32 myField)
+        {
+            try
+            {
+                Int32 step = IntentCacheStep(_icField, _icNonce, field, nonce, myField);
+                if (step == CacheWrite)
+                    WriteCache(field, nonce, myField, -1, -1, true);
+                else if (step == CacheSkip)
+                {
+                    ClearIntentCache(SupersededWords(nonce, field), false);
+                    _icNonce = nonce;
+                }
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemC, "bench cache", err, "the bench intent is not cached");
+            }
+        }
+
+        private static String SupersededWords(Int32 nonce, Int32 field)
+        {
+            return "superseded (the host's intent nonce " + nonce + ": field " + field + ")";
+        }
+
+        // One write (a standing cache for another intent is superseded first: one clear line per cache that ends).
+        private static void WriteCache(Int32 field, Int32 nonce, Int32 myField, Int32 hostFrom, Int32 lane, Boolean bench)
+        {
+            ClearIntentCache(SupersededWords(nonce, field), false);
+            _icField = field;
+            _icNonce = nonce;
+            _icSrc = myField;
+            _icHostFrom = hostFrom;
+            _icTick = Environment.TickCount;
+            _icBench = bench;
+            _icWrites++;
+            Log.Message("[NetSync] intent cache: field " + field + " (nonce " + nonce + ") cached on field " + myField + " (host lane " + lane + ")"
+                        + Stamp());
+        }
+
+        // A standing cache ends with one line (`why` = the reason words); `forgetNonce` also forgets its spent nonce (the session reset, the
+        // host epoch, the title, a bench cache's release). Never throws.
+        internal static void ClearIntentCache(String why, Boolean forgetNonce)
+        {
+            try
+            {
+                if (forgetNonce)
+                    _icNonce = -1;
+                Int32 field = _icField;
+                if (field <= 0)
+                    return;
+                _icField = -1;
+                _icSrc = -1;
+                _icHostFrom = -1;
+                _icBench = false;
+                _icClears++;
+                _icLastClear = why;
+                Log.Message("[NetSync] intent cache: field " + field + " cleared -- " + why + Stamp());
+            }
+            catch (Exception err)
+            {
+                _icField = -1;
+                NoteFault(ItemC, "cache clear", err, "the cache is dropped silently");
+            }
