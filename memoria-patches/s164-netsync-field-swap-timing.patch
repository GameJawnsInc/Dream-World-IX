+        // The count_* mutants: CountBacklog with one rejected rule restored.
+        private const Int32 MAnyField = 1, MInh = 2, MLocal = 4, MNoCap = 8, MOrphan = 16, MLockBlind = 32;
+
+        private static Int32 CountMut(IList<EvtFact> ev, IList<WinFact> wins, Int32 myField, Int32 now, Boolean engaged, Boolean keyHere,
+                                      out Int32 onOpen, out Int32 ahead, out Boolean lineOpen, Int32 m)
+        {
+            onOpen = 0;
+            ahead = 0;
+            lineOpen = false;
+            for (Int32 k = 0; k < ev.Count; k++)
+            {
+                EvtFact e = ev[k];
+                if (e.Field != myField && (m & MAnyField) == 0)
+                    continue;
+                Boolean matched = false, open = false;
+                for (Int32 j = 0; j < wins.Count; j++)
+                {
+                    WinFact w = wins[j];
+                    if (w.Field != e.Field || w.Win != e.Win || w.Text != e.Text)
+                        continue;
+                    matched = true;
+                    if ((w.Cls != NetSyncDialog.ClsLocal || (m & MLocal) != 0) && (!w.Inh || (m & MInh) != 0))
+                        open = true;
+                }
+                if (!matched)
+                {
+                    if ((m & MNoCap) != 0 || unchecked(now - e.Seen) < AheadMaxMs)
+                        ahead++;
+                }
+                else if (open)
+                {
+                    onOpen++;
+                }
+            }
+            if (engaged || (m & MLockBlind) != 0)
+                for (Int32 j = 0; j < wins.Count; j++)
+                {
+                    WinFact w = wins[j];
+                    if (w.Field == myField && !w.Inh && (w.Cls == NetSyncDialog.ClsLocked || w.Cls == ClsUntracked
+                                                         || ((m & MOrphan) != 0 && w.Cls == NetSyncDialog.ClsOrphaned)))
+                        lineOpen = true;
+                }
+            return BacklogRule(true, onOpen, ahead, keyHere, lineOpen);
+        }
+
+        // The due_* mutants: DueRule with one rejected rule restored.
+        private const Int32 MWallOnly = 1, MBacklogBlack = 2, MNoRecheck = 4, MNoGrace = 8, MNoFallback = 16, MRecheckPast = 32, MUnknownFree = 64,
+                            MNoPrime = 128, MPrimeAtTimer = 256;
+
+        private static Int32 DueMut(Int32 path, Boolean timerOut, Int32 view, Int32 blackTicks, Int32 grace, Int32 backlogNow, Boolean primed, Int32 lever,
+                                    Int32 m)
+        {
+            if ((m & MWallOnly) != 0)
+                return timerOut ? DueTimer : DueWait;  // D not taken: today's wall timer everywhere
+            if (path != PathFast)
+            {
+                if ((m & MBacklogBlack) != 0 && path == PathBacklog && view == ViewBlack)
+                    return DueBlack;                    // the refuted early commit with a backlog
+                return timerOut ? DueTimer : DueWait;
+            }
+            Boolean held = backlogNow != BkNone && !((m & MUnknownFree) != 0 && backlogNow == BkUnknown) && lever != NetSyncSwap.FadeLeverNoGate
+                           && lever != NetSyncSwap.FadeLeverNoRecheck && (m & MNoRecheck) == 0;
+            if (held)
+                return (m & MRecheckPast) != 0 || !timerOut ? DueWait : DueRecheck;
+            Boolean ready = view == ViewBlack && (blackTicks >= grace || ((m & MNoGrace) != 0 && blackTicks >= 0));
+            if (ready && (primed || (m & MNoPrime) != 0 || (timerOut && (m & MPrimeAtTimer) == 0)))
+                return DueBlack;
+            if (ready)
+                return DuePrime;
+            return (m & MNoFallback) != 0 || !timerOut ? DueWait : DueFallback;
+        }
+
+        private static CountFn CountM(Int32 m)
+        {
+            return (IList<EvtFact> ev, IList<WinFact> w, Int32 my, Int32 now, Boolean eng, Boolean key, out Int32 on, out Int32 ah, out Boolean lo)
+                => CountMut(ev, w, my, now, eng, key, out on, out ah, out lo, m);
+        }
+
+        private static DueFn DueM(Int32 m)
+        {
+            return (p, to, v, bt, g, bk, pr, lv) => DueMut(p, to, v, bt, g, bk, pr, lv, m);
+        }
+
+        // The mutants, each a rejected rule the rows must catch (the design's D+E table, every one).
+        private static Rules Mutant(String name)
+        {
+            Rules m = new Rules();
+            switch (name)
+            {
+                case "view_add_white_black": m.View = (ok, mode, cur, tgt, left) => ViewRule(ok, ok ? ModeSub : mode, cur, tgt, left); break;
+                case "view_exact_255": m.View = (ok, mode, cur, tgt, left) => ViewRule(ok, mode, cur >= 255 ? cur : Math.Min(cur, BlackFloor - 1), tgt, left); break;
+                case "view_target_blind": m.View = (ok, mode, cur, tgt, left) => ViewRule(ok, mode, cur, ok && mode == ModeSub && cur < BlackFloor ? 255 : tgt, left); break;
+                case "view_idle_heading": m.View = (ok, mode, cur, tgt, left) => ViewRule(ok, mode, cur, tgt, Math.Max(left, 1)); break;
+                case "view_fade_in_not_black": m.View = (ok, mode, cur, tgt, left) =>
+                    ViewRule(ok, mode, cur, tgt, left) == ViewBlack && left > 0 && tgt < BlackFloor ? ViewHeading : ViewRule(ok, mode, cur, tgt, left); break;
+                case "view_unknown_visible": m.View = (ok, mode, cur, tgt, left) => ok ? ViewRule(ok, mode, cur, tgt, left) : ViewVisible; break;
+                case "backlog_line_only": m.Backlog = (ok, on, ah, key, lo) => BacklogRule(ok, on, 0, false, false); break;   // the task's literal first term
+                case "backlog_no_ahead": m.Backlog = (ok, on, ah, key, lo) => BacklogRule(ok, on, 0, key, lo); break;
+                case "backlog_no_key": m.Backlog = (ok, on, ah, key, lo) => BacklogRule(ok, on, ah, false, lo); break;
+                case "backlog_no_open": m.Backlog = (ok, on, ah, key, lo) => BacklogRule(ok, on, ah, key, false); break;
+                case "backlog_unknown_none": m.Backlog = (ok, on, ah, key, lo) => ok ? BacklogRule(ok, on, ah, key, lo) : BkNone; break;
+                case "backlog_order_swapped": m.Backlog = (ok, on, ah, key, lo) => ok && ah > 0 ? BkAhead : BacklogRule(ok, on, ah, key, lo); break;
+                case "count_any_field": m.Count = CountM(MAnyField); break;
+                case "count_inh": m.Count = CountM(MInh); break;
+                case "count_local": m.Count = CountM(MLocal); break;
+                case "count_no_age_cap": m.Count = CountM(MNoCap); break;
+                case "count_orphan": m.Count = CountM(MOrphan); break;
+                case "count_lock_blind": m.Count = CountM(MLockBlind); break;
+                case "path_no_gate": m.Path = (k, lv, ow, v, bk) => PathRule(k, lv, ow, v, bk != BkUnknown ? BkNone : bk); break;   // the refuted D
+                case "path_kick_fast": m.Path = (k, lv, ow, v, bk) => PathRule(false, lv, ow, v, bk); break;
+                case "path_fault_fast": m.Path = (k, lv, ow, v, bk) => PathRule(k, lv, ow, v == ViewUnknown ? ViewVisible : v, bk == BkUnknown ? BkNone : bk); break;
+                case "path_own_warp_blind": m.Path = (k, lv, ow, v, bk) => PathRule(k, lv, false, v, bk); break;
+                case "path_lever_blind": m.Path = (k, lv, ow, v, bk) => PathRule(k, lv == NetSyncSwap.FadeLeverOld ? NetSyncSwap.FadeLeverAct : lv, ow, v, bk); break;
