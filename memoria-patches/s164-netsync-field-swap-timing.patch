+        // NetSyncClient.Update, every Update right after the enabled gate: the line window and the stale span (one bool test when nothing
+        // is open).
+        internal static void Tick()
+        {
+            if (!_open)
+                return;
+            try
+            {
+                Record r = _rec;
+                Int64 now = NowMs();
+                if (now < 0)
+                    return;
+                Int32 c = CloseRule(r.State, false, r.OpenT, r.LandT, now);
+                if (c != CloseNone)
+                    Close(c, 0, now);
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemA, "tick", err, "the record stays open");
+            }
+        }
+
+        // The session boundary (NetSyncClient.ResetIntentAndL1State): the record closes as `reset`, the seen nonce is forgotten.
+        // [ff9mapkit netsync s164] review fix F07: the offline runners' form (Flow, CacheC: one name, one String) -- the close reads the
+        // gate live. NetSyncClient calls ResetSession with the liveness it captured before its teardown.
+        internal static void Reset(String why)
+        {
+            ResetSession(why, false);
+        }
+
+        // [ff9mapkit netsync s164] review fix F07: `logClose` = the session had a transport when the caller tore it down (decided BEFORE
+        // `_socket = null`): the reset's L-CLOSE line prints on it, whatever SwapSessionRole reads now. A selftest session has no
+        // transport (no wire) and passes false: its close reads the gate live, exactly as before.
+        internal static void ResetSession(String why, Boolean logClose)
+        {
+            try
+            {
+                if (_open)
+                    Close(CloseReset, 0, NowMs(), logClose);
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemA, "reset", err, "the record is dropped");
+            }
+            _seenNonce = -1;
+            _seenRec = null;
+            _dueT = -1;
+            ClearIntentCache("the session reset", true);   // [ff9mapkit netsync s164] C: the cache and its spent nonce go with the session
+            ClearPins();                                   // [ff9mapkit netsync s164] PIN: "the co-op session reset" -- every held pin goes, a live section 4 spent
+            ForgetArrive("session");                       // [ff9mapkit netsync s164] THE ARRIVAL GUARD: a live guard is spent (session), R is forgotten
+        }
+
+        // PIN's landing (`last.story`) and D+E's follow fade (`last.fade_path`, `last.fade_ticks`) on the live record.
+        internal static void NoteRecordStory(String story)
+        {
+            if (_open && _rec != null)
