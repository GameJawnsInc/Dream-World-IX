+        }
+
+        // A bench nonce no held entry has and the spent one is not (at most three values to step past).
+        private static Byte PinBenchNonce()
+        {
+            Byte n = (Byte)(_pinBenchNonce + 1);
+            while (n == _pinSpentNonce || PinHeld(n) != null)
+                n++;
+            _pinBenchNonce = n;
+            return n;
+        }
+
+        // NetSyncClient.ApplyStoryImpl's FIRST statement on the selftest role (V1, G2) -- nothing unless `swap pinbench` armed it, then once.
+        // The same decision as a guest's landing (PinDecide) with frame B as the latest frame; _pinBenchMirror is set BEFORE the split (its
+        // party parse can arm the mirror and then fail: the DIO-6 placement); the SHIPPED split, ApplyStorySplitTo, into a scratch copy of
+        // gEventGlobal, so the party half runs the real ParseSections exactly as the live hunk's does; then ONLY the marker flag's byte is
+        // copied into the live array. The release and `swap clear` clear the mirror the parse left. Never throws.
+        internal static void BenchPinLanding()
+        {
+            if (!_pinBenchArmed)
+                return;
+            _pinBenchArmed = false;
+            try
+            {
+                Byte[] latest = _pinBenchLatest;
+                Byte[] story, party;
+                PinDecide(FF9StateSystem.Common.FF9.fldMapNo, LandingFromWorld(), latest, out story, out party);
+                Byte[] live = FF9StateSystem.EventState.gEventGlobal;
+                Byte[] scratch = (Byte[])live.Clone();
+                _pinBenchMirror = true;
+                Boolean ok = NetSyncState.ApplyStorySplitTo(story, party, scratch);
+                if (!ok && !ReferenceEquals(story, latest))
+                {
+                    PinStoryFailed();
+                    story = latest;
+                    ok = NetSyncState.ApplyStorySplitTo(latest, party, scratch);
+                }
+                if (!ok)
+                    return;
+                Int32 at = _pinBenchFlag >> 3;
+                live[at] = scratch[at];
+                _pinBenchChosen = ReferenceEquals(story, latest) ? "latest" : "pin";
+            }
+            catch (Exception err)
+            {
+                NoteFault(ItemPin, "bench landing", err, "the bench landing stages nothing");
+            }
+        }
+
+        // The pin bench's state is set (the release logs only then).
+        private static Boolean PinBenchSet
+        {
+            get
+            {
+                Boolean any = _pinBenchArmed || _pinBenchFlag >= 0;
+                for (Int32 k = 0; k < _pins.Length; k++)
+                    any |= _pins[k] != null && _pins[k].Bench;
+                return any;
+            }
+        }
+
+        // ReleaseLevers (`swap clear` and the release): the pin bench forgotten -- disarmed, frame B dropped, its state at its sentinels and
+        // every pin it captured dropped (never a live guest's own). The party mirror it armed is ReleaseLevers' own (_pinBenchMirror).
+        private static void ForgetPinBench()
+        {
+            for (Int32 k = 0; k < _pins.Length; k++)
+                if (_pins[k] != null && _pins[k].Bench)
+                    _pins[k] = null;
+            _pinBenchArmed = false;
+            _pinBenchLatest = null;
+            _pinBenchFlag = -1;
+            _pinBenchLanded = false;
+            _pinBenchSlot = -1;
+            _pinBenchChar = -1;
+            _pinBenchChosen = null;
+        }
+
+        // ---------------------------------------------------------------- GUEST, THE ARRIVAL GUARD ([ff9mapkit netsync s164], ARRIVAL-GUARD-S164.md)
+        // Every entry point has its own try with item ARRIVE: a throw sets the sticky fault (s158's dwell from the base start for the rest of
+        // the process, as PIN's _pinFaulted), is logged once per site and never reaches its caller. A host or a solo game never arms the
+        // guard (ArriveArmRule's role) and never reaches ArriveDwellAge (its base fails on `eligible` first).
+
+        // OnFieldLoad's FIRST statement, at EVERY landing (a follow, an own pass, a kick, a bounce, a rejoin, a battle return, an ATE DEST,
+        // the world map): before LandViaRule, Join, the unjoined ViaSame / ViaOther return and A's try, so no landing is skipped and a throw
+        // in A cannot leave the previous guard standing. The landing is numbered; an episode still on from the last field is classified (its
+        // base cannot survive a load); `swap arrivebench`'s lead >= 0 writes R now, before the anchor reads it (seen in the last landing's
+        // interval); then the new guard -- ArriveArmRule (the role, the lever, a world rejoin: read HERE, so a lever flip mid-episode waits
+        // for the next landing), ArriveAnchorRule against R, the lead G - Hs (LeadNone unanchored), every per-landing latch reset (a
+        // control-back carried over from the last field never spends the fresh guard), `world` and `arms` counted, and the anchor line (an
+        // armed guard anchored with a lead under K). Never throws.
+        private static void ArriveLanding(Int32 fld)
+        {
+            if (_arriveFaulted)
+                return;
+            try
+            {
+                Int32 now = Environment.TickCount;
