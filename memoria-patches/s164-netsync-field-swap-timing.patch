+            row(code == NetSyncClient.LandNone && keep == 352, "seq.pending_pass_lands_clean");     // no s154 "cancelled" line
+            BookOf(r, TermCommitted, 352, -1, 352, out p, out c, out bend);
+            code = NetSyncClient.FollowLandingStep(352, p, c, 352, false, out keep, out rearm);
+            row(p < 0 && code == NetSyncClient.LandNone, "seq.commit_idle");                        // no stray commit during the load
+            BookOf(r, TermPending, 352, 352, -1, out p, out c, out bend);
+            code = NetSyncClient.FollowLandingStep(351, p, c, 352, false, out keep, out rearm);
+            row(code == NetSyncClient.LandLatchVoid && keep == -1 && rearm == 352 && NetSyncClient.LandingRearm(code, rearm, false) == 352,
+                "seq.overwrite_still_rearms");
+            BookOf(r, TermIntent, 352, -1, -1, out p, out c, out bend);
+            code = NetSyncClient.FollowLandingStep(352, p, c, -1, false, out keep, out rearm);
+            row(code == NetSyncClient.LandNone && keep == -1 && rearm == -1, "seq.intent_pass_landing");
+            code = NetSyncClient.FollowLandingStep(352, 351, -1, -1, false, out keep, out rearm);
+            row(code == NetSyncClient.LandSuperseded && NetSyncClient.LandingRearm(code, rearm, true) == -1
+                && NetSyncClient.LandingRearm(code, rearm, false) == 351, "seq.kick_never_rearms_follow");
