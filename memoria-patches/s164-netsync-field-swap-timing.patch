+
+        // Digits only (an optional leading '-' when signed), 1-18 of them, in [from, to).
+        private static Boolean ParseDigits(String s, Int32 from, Int32 to, Boolean signed, out Int64 v)
+        {
+            v = -1;
+            Boolean neg = signed && from < to && s[from] == '-';
+            Int32 i = neg ? from + 1 : from;
+            if (to - i < 1 || to - i > 18)
+                return false;
+            Int64 n = 0;
+            for (; i < to; i++)
+            {
+                Char c = s[i];
+                if (c < '0' || c > '9')
+                    return false;
+                n = n * 10 + (c - '0');
+            }
+            v = neg ? -n : n;
+            return true;
+        }
