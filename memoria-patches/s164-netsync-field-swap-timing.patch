+                // bit clear (Pending, not faulted), so _ipLandedFrames stays 0. The bench emit (oobSet false) builds no frame: 0.
+                _ipFrames = oobSet ? 1 : 0;
+                _ipLandedFrames = 0;
+                _ipUpdates = 0;
+                _ipOobSeq = oobSet ? oobSeq : -1;
+                _ipOobSet = oobSet;
+                _ipSocket = NetSyncClient.SwapTransport;
