+        private static String IntentEndWords(Int32 why)
+        {
+            switch (why)
+            {
+                case IntentEndStands: return "I stand on it (my body there, 2 s on the wire, 1 s since my landing)";
+                case IntentEndLeft: return "I left it";
+                case IntentEndElsewhere: return "I landed elsewhere";
+                case IntentEndCap: return "no landing in 10 s";
+                case IntentEndOld: return "s163's rule (lever)";
+                case IntentEndReset: return "the session reset";
+                default: return "?";
+            }
+        }
