+                case "veg_not_zeroed": m.Fix = (t, p, s) => { Byte v = t[OffVeg]; Int32 r = LandingFixTo(t, p, s); t[OffVeg] = v; return r & ~FixVeg; }; break;
+                case "r3_lever_blind": m.Waits = (w, old) => EventWorldWaitsOnPlayer(w); break;
+                case "dot_band_blind": m.Dot = (f, h) => { h.Story = f.OwnSc; return DotRule(f, h); }; break;
+                case "dot_world_blind": m.Dot = (f, h) => { h.Idx = f.OwnIdx; return DotRule(f, h); }; break;
+                // the band with > for >= (5990 read as the Mist window's band)
+                case "dot_band_strict": m.Dot = (f, h) => { if (h.Story == MapBandSc) h.Story = MapBandSc - 1; if (f.OwnSc == MapBandSc) f.OwnSc = MapBandSc - 1; return DotRule(f, h); }; break;
+                case "seam_raw_only": m.TryWrap = (mapno, x) => false; break;
+                case "seam_always_wrap": m.Map = (Boolean tr, Single rx, Single ry, Single wx, Single wy, out Single sx, out Single sy) => MapPointRule(false, tr ? wx : rx, tr ? wy : ry, 0f, 0f, out sx, out sy); break;
+                case "seam_no_clamp":
+                    m.Map = (Boolean tr, Single rx, Single ry, Single wx, Single wy, out Single sx, out Single sy) =>
+                    {
+                        Boolean e = MapPointRule(tr, rx, ry, wx, wy, out sx, out sy);
+                        Boolean keep = tr && SeamKeepWrap(rx, wx);
+                        sx = keep ? wx : rx;
+                        sy = keep ? wy : ry;
+                        return e;
+                    };
+                    break;
+            }
+            return m;
+        }
+
+        private static readonly String[] MutantNames = { "world_from_fld", "is_event_world_map", "latest_unmatched", "no_substitution",
+                                                         "entrance_zero_kept", "wall_clock", "veg_not_refused", "pose_agreement",
+                                                         "save_no_s", "r3_all_event_worlds", "dot_socket_state",
+                                                         "entrance_sentinel_kept", "debounce_no_102_restart", "debounce_no_b6_restart",
+                                                         "start_unlanded_blind", "start_mirror_blind", "start_riding_blind", "start_b1_blind",
+                                                         "veg_not_zeroed", "r3_lever_blind", "dot_band_blind", "dot_world_blind", "dot_band_strict",
+                                                         "seam_raw_only", "seam_always_wrap", "seam_no_clamp" };
+
+        /// <summary>[ff9mapkit netsync s165] THE PROOF: the codec rows, every rule row against the real rules, then every mutant against
+        /// the same rows (each must fail one). `detail` = "N rows, M mutants" on success, else the first failing row or the mutant that
+        /// passed. Touches no live state (it reads the live story and the engine's tables, writes only scratch arrays).</summary>
+        internal static Boolean SelfTest(out String detail)
+        {
+            try
+            {
+                List<String> fails = new List<String>();
+                Int32 rows = CodecRows(fails);
+                rows += Rows(new Rules(), fails);
+                if (fails.Count > 0)
+                {
+                    detail = "row " + fails[0] + " failed (" + fails.Count + " of " + rows + ")";
+                    SelfTestVerdict = "fail: " + fails[0];
+                    return false;
+                }
+                Int32 caught = 0;
+                for (Int32 k = 0; k < MutantNames.Length; k++)
+                {
+                    List<String> mf = new List<String>();
+                    Rows(Mutant(MutantNames[k]), mf);
+                    if (mf.Count == 0)
+                    {
+                        detail = "mutant " + MutantNames[k] + " was not caught";
+                        SelfTestVerdict = "fail: mutant " + MutantNames[k];
+                        return false;
+                    }
+                    caught++;
+                }
+                detail = rows + " rows, " + caught + " mutants";
+                SelfTestVerdict = "ok";
+                return true;
+            }
+            catch (Exception err)
+            {
+                detail = "threw: " + err.GetType().Name + ": " + err.Message;
+                SelfTestVerdict = "fail: threw";
+                return false;
+            }
+        }
+    }
+}
