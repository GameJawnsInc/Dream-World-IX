+                if (!_go.activeSelf)
+                {
+                    _go.SetActive(true);
+                    _shows++;
+                }
+                _frames++;
+            }
+            catch (Exception err)
+            {
+                _placed = false;
+                Fault("the minimap hook", err);
+                try
+                {
+                    if (_go != null)
+                        Hide();
+                }
+                catch { }
+            }
+        }
+
+        // The hide edge (counted once per edge).
+        private static void Hide()
+        {
+            if (_go.activeSelf)
+            {
+                _go.SetActive(false);
+                _hides++;
+            }
+        }
+
+        /// <summary>[ff9mapkit netsync s165] THE BACKSTOPS (every field load, every world load, the harness release on every role): the dot
+        /// hidden and its placement forgotten, so a re-shown minimap panel never flashes the last world's dot before the first hook. One
+        /// null compare while nothing was ever minted (vanilla). Never throws.</summary>
+        internal static void HideNow()
+        {
+            try
+            {
+                _placed = false;
+                if (_go != null)
+                    Hide();
+            }
+            catch (Exception err)
+            {
+                Fault("the hide", err);
+            }
+        }
+
+        // THE MINT (once): the donor's census first (a failure later still names what it cloned), then the clone -- committed to the static the
+        // moment it exists, so a throw below still reaches it (hidden, destroyed, the mint latched).
+        private static Boolean Mint(GameObject panel, UISprite pointer, UISprite cone, UIWidget image)
+        {
+            if (_mintFailed)
+                return false;
+            try
+            {
+                Int32 donorDepth = pointer.depth;
+                Int32 coneDepth = cone != null ? cone.depth : NoDepth;
+                Int32 imageDepth = image != null ? image.depth : NoDepth;
+                _cSprite = pointer.spriteName;
+                _cAtlas = pointer.atlas != null ? pointer.atlas.name : null;
+                _cDepth = donorDepth;
+                _cConeDepth = coneDepth;
+                _cImageDepth = imageDepth;
+                _cColor = ColorHex(pointer.color);
+                _cW = pointer.width;
+                _cH = pointer.height;
+                _cScale = pointer.transform.localScale.x;
+                _cColliders = pointer.GetComponentsInChildren<Collider>(true).Length + pointer.GetComponentsInChildren<Collider2D>(true).Length;   // the donor's WHOLE tree (AddChild clones its children too)
+                _cPanelClip = pointer.panel != null ? pointer.panel.clipping.ToString() : null;
+                _cDotDepth = NoDepth;
+                _cStripped = 0;
+                _census = true;
+                GameObject go = NGUITools.AddChild(panel, pointer.gameObject);
+                _go = go;
+                go.name = DotObjectName;
+                Int32 stripped = 0;
+                // the clone's WHOLE tree, never its root alone: Instantiate copies the donor's children too, and a collider on any of them
+                // would still take the minimap's clicks (review: the root-only strip left a child's collider live)
+                foreach (Collider c in go.GetComponentsInChildren<Collider>(true))
+                {
+                    c.enabled = false;                                   // off at once (Destroy lands at the frame's end): the minimap's onClick is stock's
+                    UnityEngine.Object.Destroy(c);
+                }
+                foreach (Collider2D c in go.GetComponentsInChildren<Collider2D>(true))
+                {
+                    c.enabled = false;
+                    UnityEngine.Object.Destroy(c);
+                }
+                foreach (UITweener tw in go.GetComponentsInChildren<UITweener>(true))
+                {
+                    tw.enabled = false;                                  // a tween would fight the per-frame pose
+                    UnityEngine.Object.Destroy(tw);
+                    stripped++;
+                }
+                foreach (Animation anim in go.GetComponentsInChildren<Animation>(true))
+                {
+                    anim.Stop();
+                    UnityEngine.Object.Destroy(anim);
+                    stripped++;
+                }
+                foreach (Animator animator in go.GetComponentsInChildren<Animator>(true))
+                {
+                    animator.enabled = false;
+                    UnityEngine.Object.Destroy(animator);
+                    stripped++;
+                }
+                UISprite s = go.GetComponent<UISprite>();
+                foreach (UIRect r in go.GetComponentsInChildren<UIRect>(true))
+                    r.SetAnchor((Transform)null);                        // the clone keeps no anchor, its root (the sprite) or any child: anchors
+                                                                         // re-assert every frame (the NGUI law), and its pose is set every frame
+                Boolean over;
+                s.depth = DepthSlotRule(donorDepth, coneDepth, imageDepth, out over);
+                s.color = new Color(Tint.r, Tint.g, Tint.b, AlphaRule(false, over));
+                go.transform.localScale = ScaleOf(pointer.transform.localScale);
+                go.SetActive(false);                                     // the caller's first frame shows it (one counted edge)
+                _sprite = s;
+                _overDonor = over;
+                _cDotDepth = s.depth;
+                _cStripped = stripped;
+                Log.Message("[NetSync] world dot: minted '" + DotObjectName + "' from the minimap's player pointer (sprite " + (_cSprite ?? "-")
+                            + ", atlas " + (_cAtlas ?? "-") + ", depth " + donorDepth + ", cone " + DepthWords(coneDepth) + ", image "
+                            + DepthWords(imageDepth) + ", colour " + _cColor + ", " + _cW + " x " + _cH + ", scale "
+                            + _cScale.ToString("0.###", CultureInfo.InvariantCulture) + ", colliders " + _cColliders + ", tweens / animations "
+                            + stripped + ", panel clip " + (_cPanelClip ?? "-") + ") -- the dot at depth " + _cDotDepth
+                            + (over ? " ABOVE the arrow at alpha " + NoSlotAlpha.ToString("0.##", CultureInfo.InvariantCulture)
+                                      + " (no free depth slot under it)" : " under the arrow"));
+                return true;
+            }
+            catch (Exception err)
+            {
+                _mintFailed = true;
+                try
+                {
+                    if (_go != null)
+                    {
+                        _go.SetActive(false);
+                        UnityEngine.Object.Destroy(_go);
+                    }
+                }
+                catch { }
+                _go = null;
+                _sprite = null;
+                Fault("the mint (latched: no dot this process)", err);
+                return false;
+            }
+        }
+
+        private static String DepthWords(Int32 depth)
+        {
+            return depth == NoDepth ? "-" : depth.ToString(CultureInfo.InvariantCulture);
+        }
+
+        private static void Fault(String what, Exception err)
+        {
+            _faults++;
+            _lastFault = what + ": " + err.GetType().Name + ": " + err.Message;
+            if (_faultLogged)
+                return;
+            _faultLogged = true;
+            Log.Error(err, "[NetSync] world dot: " + what + " failed (logged once per process; the dot hides)");
+        }
+
+        // ================================================================ THE HINT (s144's world chain reads it)
+
+        /// <summary>[ff9mapkit netsync s165] the minimap-off line's verdict over the live state (NetSyncClient.SetWorldGuestOverlay: a following
+        /// client on the world map, s144's chain on its b6 line). Never throws (false).</summary>
+        internal static Boolean MinimapHintNow
+        {
+            get
+            {
+                try
+                {
+                    if (!NetSyncClient.WorldDotWho)
+                        return false;
+                    WorldHUD hud = UIManager.World;
+                    if (hud == null || hud.CurrentState != WorldHUD.State.HUDNoMiniMap)
+                        return false;                // the minimap up (or no HUD): no hint -- and no DotRule read, which the world chain
+                                                     // would otherwise pay every frame (review: HintRule(false, x) is false whatever x is)
+                    NetSyncWorldFollow.HostWorldPose host;
+                    return HintRule(true, VerdictNow(out host));
+                }
+                catch
+                {
+                    return false;
+                }
+            }
+        }
+
+        // ================================================================ the harness (`netsync.world.dot`, HarnessAgent.AppendWorldDot)
+
+        private static Boolean LiveNow
+        {
+            get { return NetSyncClient.IsOnWorldNow(PersistenSingleton<EventEngine>.Instance); }
+        }
+
+        internal static String HarnessLever { get { return LeverOff ? "off" : "on"; } }
+
+        // the live verdict (DotRule over the live facts, read now: never the hook's last frame)
+        internal static Int32 HarnessWhy
+        {
+            get { NetSyncWorldFollow.HostWorldPose host; return VerdictNow(out host); }
+        }
+
+        internal static Boolean HarnessShown { get { return _go != null && _go.activeInHierarchy; } }
+
+        internal static Boolean HarnessMinimap
+        {
+            get
+            {
+                if (!LiveNow)
+                    return false;
+                WorldHUD hud = UIManager.World;
+                return hud != null && hud.MiniMapPanel != null && hud.MiniMapPanel.activeInHierarchy;
+            }
+        }
+
+        internal static String HarnessHud
+        {
+            get
+            {
+                if (!LiveNow)
+                    return null;
+                WorldHUD hud = UIManager.World;
+                return hud != null ? hud.CurrentState.ToString() : null;
+            }
+        }
+
+        internal static Int32 HarnessNaviMode { get { return LiveNow ? ff9.w_naviMode : -1; } }
+        internal static Int32 HarnessMapno { get { return LiveNow ? (Int32)ff9.w_naviMapno : -1; } }
+        internal static Int32 HarnessOwnIdx { get { return LiveNow ? (Int32)FF9StateSystem.EventState.gEventGlobal[NetSyncWorldFollow.OffWorldIdx] : -1; } }
+        internal static Int32 HarnessOwnWorld { get { return LiveNow ? (Int32)FF9StateSystem.Common.FF9.wldMapNo : -1; } }
+
+        // the last placement, the harness's only while the hook ran this frame or the last (a stopped hook is no placement)
+        internal static Boolean HarnessPlaced { get { return _placed && Time.frameCount - _placeFrame <= PlaceFreshFrames; } }
+        internal static Single HarnessSx { get { return _rawSx; } }
+        internal static Single HarnessSy { get { return _rawSy; } }
+        internal static Boolean HarnessEdge { get { return _edge; } }
+        internal static Single HarnessPx { get { return _px; } }
+        internal static Single HarnessPy { get { return _py; } }
+        internal static Single HarnessRot { get { return _rot; } }
+        internal static Single HarnessOwnPx { get { return _ownPx; } }
+        internal static Single HarnessOwnPy { get { return _ownPy; } }
+        internal static Single HarnessScreenX { get { return _screenX; } }
+        internal static Single HarnessScreenY { get { return _screenY; } }
+
+        internal static Int32 HarnessFrames { get { return _frames; } }
+        internal static Int32 HarnessShows { get { return _shows; } }
+        internal static Int32 HarnessHides { get { return _hides; } }
+        internal static Int32 HarnessFaults { get { return _faults; } }
+        internal static String HarnessLastFault { get { return _lastFault; } }
+
+        // the census (HarnessCensus false = null): the contract's eleven keys, then the dot's own depth, the no-slot fallback and the tweens /
+        // animations stripped
+        internal static Boolean HarnessCensus { get { return _census; } }
+        internal static String HarnessCensusSprite { get { return _cSprite; } }
+        internal static String HarnessCensusAtlas { get { return _cAtlas; } }
+        internal static Int32 HarnessCensusDepth { get { return _cDepth; } }
+        internal static Int32 HarnessCensusConeDepth { get { return _cConeDepth == NoDepth ? -1 : _cConeDepth; } }
+        internal static Int32 HarnessCensusImageDepth { get { return _cImageDepth == NoDepth ? -1 : _cImageDepth; } }
+        internal static String HarnessCensusColor { get { return _cColor; } }
+        internal static Int32 HarnessCensusW { get { return _cW; } }
+        internal static Int32 HarnessCensusH { get { return _cH; } }
+        internal static Single HarnessCensusScale { get { return _cScale; } }
+        internal static Int32 HarnessCensusColliders { get { return _cColliders; } }
+        internal static String HarnessCensusPanelClip { get { return _cPanelClip; } }
+        internal static Int32 HarnessCensusDotDepth { get { return _cDotDepth == NoDepth ? -1 : _cDotDepth; } }
+        internal static Boolean HarnessCensusOverDonor { get { return _overDonor; } }
+        internal static Int32 HarnessCensusStripped { get { return _cStripped; } }
+
+        // ================================================================ THE PROOF ("world dot selftest: OK (N rows, M mutants)", the selftest
+        // proof block's line after "world follow selftest"). This file's call-site rules as a table through a rule set; each mutant a plausible
+        // wrong rule the rows must catch. Touches no live state.
+
+        private delegate Boolean WhoFn(Boolean live, String role, Boolean followHost, Boolean benchGates);
+        private delegate Int32 DepthFn(Int32 donor, Int32 cone, Int32 image, out Boolean overDonor);
+        private delegate Single AlphaFn(Boolean edge, Boolean overDonor);
+        private delegate Vector3 ScaleFn(Vector3 donor);
+        private delegate Boolean HintFn(Boolean hudNoMiniMap, Int32 why);
+
+        private sealed class Rules
+        {
+            public WhoFn Who = WhoRule;
+            public DepthFn Depth = DepthSlotRule;
+            public AlphaFn Alpha = AlphaRule;
+            public ScaleFn Scale = ScaleOf;
+            public HintFn Hint = HintRule;
+        }
+
+        internal static String SelfTestVerdict;            // the last proof (null = not run): "ok" or "fail: <row>"
+
+        private static Boolean Near(Single a, Single b)
+        {
+            return Math.Abs(a - b) <= 0.0001f;
+        }
+
+        private static Int32 Rows(Rules r, List<String> fails)
+        {
+            Int32 n = 0;
+            Action<Boolean, String> row = (ok, name) => { n++; if (!ok) fails.Add(name); };
+            Boolean over;
+            Int32 d;
+            Vector3 v;
+
+            // ---- WHO: a following client or the bench -- never a host, a free roamer, a plain selftest, or co-op off
+            row(r.Who(true, "client", true, false), "who.following_guest");
+            row(!r.Who(true, "client", false, true), "who.free_roamer");
+            row(!r.Who(true, "host", true, true), "who.host_never");
+            row(r.Who(true, "selftest", false, true), "who.bench");
+            row(!r.Who(true, "selftest", true, false), "who.selftest_without_the_bench");
+            row(!r.Who(false, "client", true, true), "who.coop_off");
+
+            // ---- THE DEPTH SLOT: under the arrow, above the image and the cone; no free slot -> above all three
+            d = r.Depth(12, 10, 8, out over);
+            row(d == 11 && !over, "depth.under_the_arrow");
+            d = r.Depth(12, 11, 8, out over);
+            row(d == 13 && over, "depth.cone_adjacent_no_slot");
+            d = r.Depth(12, 5, 11, out over);
+            row(d == 13 && over, "depth.image_adjacent_no_slot");
+            d = r.Depth(12, 13, 8, out over);
+            row(d == 14 && over, "depth.cone_above_the_arrow");
+            d = r.Depth(12, NoDepth, NoDepth, out over);
+            row(d == 11 && !over, "depth.no_cone_no_image");
+
+            // ---- THE ALPHA: opaque; dimmed at the edge; see-through above the arrow
+            row(r.Alpha(false, false) == 1f, "alpha.opaque");
+            row(Near(r.Alpha(true, false), EdgeAlpha), "alpha.edge");
+            row(Near(r.Alpha(false, true), NoSlotAlpha), "alpha.above_the_arrow");
+            row(Near(r.Alpha(true, true), EdgeAlpha * NoSlotAlpha), "alpha.both");
+
+            // ---- THE SCALE: the donor's OWN scale times DotScale (AddChild's reset one is never the base)
+            v = r.Scale(new Vector3(2f, 2f, 1f));
+            row(Near(v.x, 2.5f) && Near(v.y, 2.5f) && Near(v.z, 1.25f), "scale.donor_prefab_scale");
+            v = r.Scale(Vector3.one);
+            row(Near(v.x, DotScale) && Near(v.y, DotScale), "scale.unit_donor");
+
+            // ---- THE HINT: a dot that would be drawn, with the minimap off -- and only then (R2's lever silences it with the dot)
+            row(r.Hint(true, NetSyncWorldFollow.DotShow), "hint.minimap_off");
+            row(!r.Hint(true, NetSyncWorldFollow.DotLever), "hint.lever_silences_it");
+            row(!r.Hint(false, NetSyncWorldFollow.DotShow), "hint.minimap_on_says_nothing");
+            row(!r.Hint(true, NetSyncWorldFollow.DotStale), "hint.stale_host_says_nothing");
+            row(!r.Hint(true, NetSyncWorldFollow.DotRole), "hint.not_following_says_nothing");
+            row(!r.Hint(true, NetSyncWorldFollow.DotOtherWorld), "hint.other_world_says_nothing");
+
+            // ---- THE CENSUS COLOUR (the stand-in's spelling)
+            row(ColorHex(Color.white) == "ffffffff" && ColorHex(Tint) == "ff9e2eff" && ColorHex(new Color(0f, 0f, 0f, 0f)) == "00000000",
+                "census.colour");
+            return n;
+        }
+
+        private static Rules Mutant(String name)
+        {
+            Rules m = new Rules();
+            switch (name)
+            {
+                // a host draws its own guest's dot; the bench term without the field-gate bench
+                case "who_host_draws": m.Who = (live, role, follow, bench) => live && (role == "selftest" ? bench : follow); break;
+                case "who_bench_blind": m.Who = (live, role, follow, bench) => live && (role == "client" ? follow : role == "selftest"); break;
+                // donor - 1 always (lands ON the cone's depth); the fallback blind to a cone above the arrow
+                case "depth_unclamped": m.Depth = (Int32 dn, Int32 cn, Int32 im, out Boolean o) => { o = false; return dn - 1; }; break;
+                case "depth_over_blind": m.Depth = (Int32 dn, Int32 cn, Int32 im, out Boolean o) => { Int32 k = DepthSlotRule(dn, cn, im, out o); return o ? dn + 1 : k; }; break;
+                // the fallback drawn opaque (the arrow hidden under it); the edge never dimmed
+                case "alpha_fallback_opaque": m.Alpha = (e, o) => AlphaRule(e, false); break;
+                case "alpha_edge_bright": m.Alpha = (e, o) => AlphaRule(false, o); break;
+                // the scale from the clone (AddChild's Vector3.one)
+                case "scale_from_clone": m.Scale = dn => ScaleOf(Vector3.one); break;
+                // the hint whatever the HUD; the hint on a WANTED dot (DotWanted: the lever's calibration would no longer give s164's line back)
+                case "hint_minimap_blind": m.Hint = (off, w) => HintRule(true, w); break;
+                case "hint_lever_blind": m.Hint = (off, w) => off && NetSyncWorldFollow.DotWanted(w); break;
+            }
+            return m;
+        }
+
+        private static readonly String[] MutantNames = { "who_host_draws", "who_bench_blind", "depth_unclamped", "depth_over_blind",
+                                                         "alpha_fallback_opaque", "alpha_edge_bright", "scale_from_clone", "hint_minimap_blind",
+                                                         "hint_lever_blind" };
+
+        /// <summary>[ff9mapkit netsync s165] THE PROOF: every row against the real rules, then every mutant against the same rows (each must fail
+        /// one). `detail` = "N rows, M mutants" on success, else the first failing row or the mutant that passed.</summary>
+        internal static Boolean SelfTest(out String detail)
+        {
+            try
+            {
+                List<String> fails = new List<String>();
+                Int32 rows = Rows(new Rules(), fails);
+                if (fails.Count > 0)
+                {
+                    detail = "row " + fails[0] + " failed (" + fails.Count + " of " + rows + ")";
+                    SelfTestVerdict = "fail: " + fails[0];
+                    return false;
+                }
+                Int32 caught = 0;
+                for (Int32 k = 0; k < MutantNames.Length; k++)
+                {
+                    List<String> mf = new List<String>();
+                    Rows(Mutant(MutantNames[k]), mf);
+                    if (mf.Count == 0)
+                    {
+                        detail = "mutant " + MutantNames[k] + " was not caught";
+                        SelfTestVerdict = "fail: mutant " + MutantNames[k];
+                        return false;
+                    }
+                    caught++;
+                }
+                detail = rows + " rows, " + caught + " mutants";
+                SelfTestVerdict = "ok";
+                return true;
+            }
+            catch (Exception err)
+            {
+                detail = "threw: " + err.GetType().Name + ": " + err.Message;
+                SelfTestVerdict = "fail: threw";
+                return false;
+            }
+        }
+    }
+}
