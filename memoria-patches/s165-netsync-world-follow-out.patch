+using System;
+using System.Collections.Generic;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync s165] E1: THE WORLD-MAP GUEST FOLLOW'S PURE CORE (studies/world-coop/S165-DESIGN.md decisions 1-18, piece E1;
+    // rung 1 of GUEST-FOLLOW.md's two-body order). Today (s164) a following guest left on a field when the host walks out onto the world
+    // map stays where it is (s144 decision 5) until the host's next stop. Rung 1: R1 the guest follows the host OUT, lands at the host's
+    // live spot and stays frozen there (s144's freeze) until s144's rejoin; R2 a dot on the guest's minimap shows where the host is, from
+    // section 0; R3 the 9012 strand; R4 the save guard at its call site. The wire stays v14 (rung 1 takes no v15 dependency), the harness
+    // protocol 5. The host's side changes only by log lines.
+    //
+    // This file holds ONLY the rules -- pure, call-site free, every one in the proof table -- plus the two small impure probes they take
+    // as inputs (WorldRegisteredNow, EventWorldSet). It is INERT: nothing here runs until E2-E6 call it.
+    //
+    //   THE READ      HostWorldPoseOf: one host payload -> b6 / b1 / the heartbeat (section 7, through NetSyncDialog's own parser, the one
+    //                 every guest reader trusts), the world record (section 0, read IN PLACE through NetSyncState.StoryBodyOffset: no 2 KB
+    //                 copy per payload) and section 4's landed bit (NetSyncSwap.IntentLandedOf). b6 and section 0 MUST come from the same
+    //                 byte[]: on the host one BuildStateFrame call snapshots section 0 first and evaluates the flags byte later in the
+    //                 same call, so a b6 frame's section 0 was taken on the live world map; the read thread swaps the slot under its own
+    //                 lock, so a second GetRemoteState() can pair two payloads (lane H F6).
+    //   THE WORLD     WorldIdRule: 9000 + section0[102] (the dispatcher's own index, written by its Main_Init's first op) from the b6
+    //                 frame. Never fldMapNo (my field, or on the world map the field I LEFT), never my own wldMapNo (my last world
+    //                 visit), never the lane's Field (0 on the world map). 102 in 0..12; not an event world by the STATIC
+    //                 ff9.eventWorldMaps (ff9.IsEventWorldMap tests MY OWN last world); registered in EventDB AND eventIDToMESID (the
+    //                 field shutdown indexes the second unguarded: an unregistered world throws in the field loop).
+    //   THE START     WorldOutStep: decision 3's twelve terms, cheapest first, one reason each (the Why codes). Every refusal sits HERE:
+    //                 once the guest has faded with control off, nothing may decline without writing a scene change (s42: the only
+    //                 recovery from a fade is a load).
+    //   THE DEBOUNCE  LiveDebounceStep: THE LIVE DEBOUNCE (decision 4) -- FollowOutStableMs of host-ALIVE time, counted only while the
+    //                 heartbeat moved within LiveHeartbeatMs, restarted by any b6 fall or any change of 102. b6 rises BEFORE the host's
+    //                 synchronous all-block load (~4.4 s on the bench PC), which freezes its heartbeat while its writer thread keeps
+    //                 re-sending the last frame: a wall-clock debounce would start the guest inside that load.
+    //   THE LANDING   WorldOutFrameRule (the latest frame while it carries b6 and the same 102, else the start pin, else the commit's
+    //                 seed; the on-foot substitution), EntranceRule (0 or 9995-9999 -> 35), SeedPoseTo (the commit's seed) and
+    //                 LandingFixTo (the seam's fix-ups after the story apply).
+    //   R3            EventWorldWaitsOnPlayer / EventWorldWaitsAt / RejoinEventWorldTerm: 9012 is an event world that waits on the
+    //                 player (its Main_Init masks only the d-pad and keeps control on), so the rejoin may arm from it.
+    //   R4            ManualSaveRefused(L, M, B, D, S) and SaveGuardStep (the dry `saveguard old`).
+    //   THE DOT       DotRule (decision 12's order), PoseInTorus, SameBandRule, SeamTryWrap + MapPointRule (the seam-aware clamp: it
+    //                 works on ff9.w_naviGetPos's OUTPUTS, never re-derives the drawn position), DotRotationDeg.
+    //   THE PROOF     SelfTest: "world follow selftest: OK (N rows, M mutants)" -- ONE line for every table here, the dot's included.
+    //
+    // Main thread only (HostWorldPoseOf parses into one shared scratch view). Nothing here throws on any input it is given: the parse
+    // catches its own faults and reports them as its `why`.
+    internal static class NetSyncWorldFollow
+    {
+        // ================================================================ constants
+        internal const Int32 FollowOutStableMs = 1200;  // THE LIVE DEBOUNCE's length: a SEED, not a law (the field follow's own
+                                                        // FollowStableMs). The cost is lag the owner sees: never tune it without a playtest
+        internal const Int32 LiveHeartbeatMs = 400;     // host-ALIVE = section 7's heartbeat MOVED within this. The host bumps it once per
+                                                        // Update and publishes every 150 ms (so 2-3 publishes), while a hung host's writer
+                                                        // re-sends the last slot every 33 ms: a new payload reference is never life
+        internal const Int32 DotFreshMs = 1000;         // the dot's freshness (decision 12): ~6 publishes. The keepalive re-sends make a hung
+                                                        // host look fresh to the socket, so only the heartbeat counts; the ~2.3 s link
+                                                        // stall shows as a short blink
+        internal const Int32 WorldBase = 9000;          // world id = 9000 + gEventGlobal[102] (keventScriptNo: the dispatcher's own index)
+        internal const Int32 WorldIdxMax = 12;          // the 13 stock dispatchers 9000-9012. KNOWN LIMIT (decision 2): Path D's 9013 is a
+                                                        // byte-exact WORLD11 clone and writes 11, so a host there reads as 9011
+        internal const Int32 WorldTreasureDive = 9012;  // WORLD12, the chocobo's treasure dive: the one event world that WAITS ON THE PLAYER
+        internal const Int32 PositionPresetKey = 35;    // the kit's POSITION_PRESET_KEY (ff9mapkit content/worldexit.py:76). Across the 13
+                                                        // dispatchers Int16[2] is only tested == 0 (the anchor default, the parked Choco and
+                                                        // vehicle resets) or == 59/60/61 behind the one-shot bits 841-843; nothing compares it
+                                                        // with 35, so 35 keeps the live pose and the parked records and triggers nothing
+        internal const Int32 EntranceSentinelLo = 9995; // the dispatchers' own Int16[2] writes inside a location's entry sequence, just
+        internal const Int32 EntranceSentinelHi = 9999; // before its Field() (WORLD11: 9999 after a FadeFilter, 9995-9998): never an arrival
+        internal const Single WorldWidth = 1536f;       // the torus (WMWorld.cs Width / Height): 64-72 is absolute, wrap-normalized
+        internal const Single WorldHeight = 1280f;
+        internal const Int32 MapBandSc = 5990;          // ff9.cs w_frameSystemConstructor: w_naviMapno = w_frameScenePtr >= 5990 ? 1 : 0 (the
+                                                        // whole-map image from here on; below it the disc-1 Mist window, map image 0)
+        internal const Single MistLeftX = 645.12f;      // w_naviGetPos's map image 0 starts at this x (and runs to 1536): only a host WEST
+                                                        // of it can sit nearer the window across the x seam. A gate, never the drawn position
+        internal const Int32 StoryLen = 2048;           // section 0 = gEventGlobal, byte for byte (the coop cells 2032-2041 zeroed)
+
+        // section 0's bytes the world follow reads (gEventGlobal offsets; multi-byte fields little-endian, as EBin reads them)
+        internal const Int32 OffStory = 0;              // u16 the story counter (the band, the minimap image)
+        internal const Int32 OffEntrance = 2;           // Int16 FieldEntrance (the arrival key the dispatcher's anchor Init reads)
+        internal const Int32 OffPoseX = 64;             // s24 x * 256 -- THE ON-FOOT ANCHOR RECORD (the controlled object's getvobj
+        internal const Int32 OffPoseY = 67;             // s16 -Y * 256    fields, rewritten every world logic tick on foot while no
+        internal const Int32 OffPoseZ = 69;             // s24 z * 256     request sequence runs)
+        internal const Int32 OffYaw = 72;               // u8 the facing, 256 steps per turn
+        internal const Int32 PoseLen = 9;               // 64-72
+        internal const Int32 OffNavi = 100;             // keventNaviModeNo: the minimap mode the world constructor seeds from
+        internal const Int32 OffWhite = 101;            // bit 0 = the white transition (the world constructor whites in, then clears it)
+        internal const Int32 OffWorldIdx = 102;         // keventScriptNo: the dispatcher's own index (the host's world, decision 2)
+        internal const Int32 OffVeg = 181;              // FF9FITEM_EVENT_VEGETABLE: the Choco call (Gysahl Greens); applied on a guest, its own
+                                                        // Choco runs in (every Choco dispatcher's anchor loop raises request 1 on it)
+        internal const Int32 OffTravel = 190;           // the travel mode (0 = on foot; 1-6 Choco, 7 the boat, 8-9 the airships)
+
+        // ================================================================ THE START GATE's reasons (WorldOutStep; harness `why`, the log's
+        // "world follow-out waits: <why>"). One per refusal, in decision 3's order. WhyNone = start.
+        internal const Int32 WhyNone = 0;
+        internal const Int32 WhyLever = 1;              // 1  `worldfollow off`
+        internal const Int32 WhyNotFollowing = 2;       // 2  not a following client in a live followed session (nor the bench)
+        internal const Int32 WhyRamp = 3;               //    the session's exit ramp is pending
+        internal const Int32 WhyNotMirroring = 4;       // 3  not mirroring yet (THE PAIRING-WINDOW LAW: s144 decision 5 stands)
+        internal const Int32 WhyMoveInFlight = 5;       // 4  a field follow, the kick, a world-out or the world rejoin in flight
+        internal const Int32 WhyNotOnField = 6;         // 5  not on a field
+        internal const Int32 WhyNotFieldHud = 7;        //    the field HUD is not up
+        internal const Int32 WhyFieldChanging = 8;      //    a field transition is requested (FieldTransitionNow)
+        internal const Int32 WhyDiscChange = 9;         //    the disc-change bit (ff9fieldDiscCondition would force nextMode 1 over the commit)
+        internal const Int32 WhyNoControl = 10;         // 6  my control is off
+        internal const Int32 WhyLine = 11;              //    an ETb line is open here (the 0.9 s timer would cut it)
+        internal const Int32 WhyBacklog = 12;           //    a host line is still being played here (BacklogNow)
+        internal const Int32 WhyAtePress = 13;          // 7  an ATE press is waiting
+        internal const Int32 WhyClimb = 14;             //    a guest climb is in flight
+        internal const Int32 WhyDiorama = 15;           //    a diorama is booted
+        internal const Int32 WhyNoFrame = 16;           // 8  no host frame
+        internal const Int32 WhyNoDialog = 17;          //    no readable section 7 in it
+        internal const Int32 WhyHostNotWorld = 18;      //    b6 clear: the host is not on the world map
+        internal const Int32 WhyHostNoControl = 19;     //    b1 clear: the host's control is off (a menu, a request sequence, a transition)
+        internal const Int32 WhyIntentUnlanded = 20;    //    a section 4 whose landed bit is clear: that intent belongs to the rejoin
+        internal const Int32 WhyNoStory = 21;           // 9  no whole section 0 (2048 B)
+        internal const Int32 WhyIdxRange = 22;          //    WorldIdRule: 102 outside 0..12
+        internal const Int32 WhyEventWorld = 23;        //    WorldIdRule: an event world (9001 / 9004 / 9006 / 9012), decision 6
+        internal const Int32 WhyNotInstalled = 24;      //    WorldIdRule: not registered in EventDB and eventIDToMESID here
+        internal const Int32 WhyRiding = 25;            // 10 [190] != 0: on foot only (decision 5)
+        internal const Int32 WhyChocoCall = 26;         //    [181] != 0: the host is calling Choco
+        internal const Int32 WhyHold = 27;              // 11 `worldfollow hold` (it holds the START only)
+        internal const Int32 WhyDebounce = 28;          // 12 THE LIVE DEBOUNCE has not run its FollowOutStableMs yet
+        internal const Int32 WhyMax = 28;
+
+        // the stable token per reason (benches key on these), then the words (the log's "waits: <why>" line)
+        private static readonly String[] WhyNames = { null, "lever", "not_following", "ramp", "not_mirroring", "in_flight", "not_on_field",
+            "not_field_hud", "field_changing", "disc_change", "no_control", "line", "backlog", "ate", "climb", "diorama", "no_frame",
+            "no_dialog", "host_not_world", "host_no_control", "intent_unlanded", "no_story", "idx_range", "event_world", "not_installed",
+            "riding", "choco_call", "hold", "debounce" };
+        private static readonly String[] WhyWords = { null,
+            "CALIBRATION: worldfollow off",
+            "not a following guest in a live co-op session",
+            "the session's exit ramp is pending",
+            "not mirroring the host's story yet (the pairing window: the s144 wait stands)",
+            "a follow, the kick, a world follow-out or the world rejoin is already in flight",
+            "not on a field",
+            "the field HUD is not up",
+            "a field change is already requested",
+            "the disc change is pending",
+            "my control is off",
+            "a line is open here",
+            "a host line is still being played here",
+            "an ATE press is waiting",
+            "a climb is in flight",
+            "a diorama is booted",
+            "no host frame",
+            "no readable host section 7",
+            "the host is not on the world map",
+            "the host's control is off",
+            "the host is entering a field (the rejoin takes it)",
+            "no whole host story section",
+            "the host's world index is out of range",
+            "the host is in a world-map scene (an event world)",
+            "the host's world map is not on this install",
+            "the host is riding",
+            "the host is calling Choco",
+            "CALIBRATION: worldfollow hold",
+            "the host has not been live on the world map for " + FollowOutStableMs + " ms yet" };
+
+        internal static String WhyName(Int32 why)
+        {
+            return why >= 0 && why <= WhyMax ? WhyNames[why] : "unknown";
+        }
+
+        internal static String WhyText(Int32 why)
+        {
+            return why >= 0 && why <= WhyMax ? WhyWords[why] : "unknown (" + why + ")";
+        }
+
+        // THE OWNER-VISIBLE WORDS (S165-DESIGN.md "The owner-visible words": proposed, the owner may change them; one place each). No emoji.
+        internal const String LineLeaving = "Following your partner out onto the world map...";
+        internal const String LineRiding = "Your partner is riding. You'll rejoin them at their next stop.";
+        internal const String LineEventWorld = "Your partner is in a world-map scene. You'll rejoin them at their next stop.";
+        internal const String LineNotInstalled = "Your partner's world map isn't on this install.";
+        internal const String LineMinimapOff = "Your partner is on the world map: press Select for the minimap.";
+
+        // The field overlay's line for a refusal the owner should read (null = s144's own waiting line stands).
+        internal static String OwnerLine(Int32 why)
+        {
+            switch (why)
+            {
+                case WhyRiding: return LineRiding;
+                case WhyEventWorld: return LineEventWorld;
+                case WhyIdxRange:
+                case WhyNotInstalled: return LineNotInstalled;
+                default: return null;
+            }
+        }
+
+        // ================================================================ the world-out's vocabulary (E3's harness spellings, one place)
+        internal const Int32 FrameLatest = 0, FramePin = 1, FrameSeed = 2;      // WorldOutFrameRule
+        private static readonly String[] FrameNames = { "latest", "pin", "seed" };
+        internal static String FrameName(Int32 frame)
+        {
+            return frame >= FrameLatest && frame <= FrameSeed ? FrameNames[frame] : null;
+        }
+
+        internal const Int32 StateIdle = 0, StateWaiting = 1, StateFading = 2, StateCommitted = 3, StateLanded = 4;   // `netsync.world.out.state`
+        private static readonly String[] StateNames = { "idle", "waiting", "fading", "committed", "landed" };
+        internal static String StateName(Int32 state)
+        {
+            return state >= StateIdle && state <= StateLanded ? StateNames[state] : null;
+        }
+
+        // LandingFixTo's facts (the counters `substituted`, `entrance_fix`, `veg_zeroed`)
+        internal const Int32 FixSubstituted = 0x01, FixEntrance = 0x02, FixVeg = 0x04;
+
+        // ================================================================ THE READ: one host payload's world facts
+
+        // What one host payload says about the host's world (HostWorldPoseOf). A struct, filled by value: no allocation per parse. The
+        // "absent" values are -1 / NaN (NoPose); a default(HostWorldPose) has HasFrame false, which every rule refuses first.
+        internal struct HostWorldPose
+        {
+            public Boolean Valid;          // a clean section 7 with b6 AND a whole section 0: a world pose (Why is null exactly then)
+            public String Why;             // the first missing piece (the harness `netsync.world.host.why`)
+            public Byte[] Payload;         // the frame this was read from (never mutated: the reader allocates per message), for the seam
+            public Boolean HasFrame;       // a payload at all
+            public Boolean HasDialog;      // section 7 present and parsed clean (NetSyncDialog.TryParseHostSection)
+            public Int32 Heartbeat;        // section 7 body[3..4], bumped once per host Update (-1 = no section 7)
+            public Int32 Flags;            // section 7 body[5] (-1 = no section 7)
+            public Boolean B6, B1;         // HfWorld (the host strictly on the world map) / HfControl (its control on)
+            public Boolean HasIntent;      // section 4 present
+            public Boolean IntentLanded;   // ...and built after the host's landing hook (a 3-byte s163 body reads as landed)
+            public Boolean HasStory;       // a whole section 0 (2048 B)
+            public Int32 Story, Entrance;  // [0..1] u16, [2..3] Int16 (-1 = no story)
+            public Int32 RawX, RawY, RawZ; // the record as stored: s24 [64] = x*256, s16 [67] = -Y*256, s24 [69] = z*256
+            public Single X, Y, Z;         // world units (NaN = no story)
+            public Int32 YawByte;          // [72] (-1 = no story)
+            public Single Yaw;             // degrees, YawByte * 360 / 256 (NaN = no story)
+            public Int32 NaviMode, White, Idx, Veg, Mode;   // [100], [101], [102], [181], [190] (-1 = no story)
+
+            public Boolean IntentUnlanded { get { return HasIntent && !IntentLanded; } }
+        }
+
+        // The pose of nothing: every reading absent.
+        internal static HostWorldPose NoPose()
+        {
+            HostWorldPose p = new HostWorldPose();
+            p.Heartbeat = -1;
+            p.Flags = -1;
+            p.Story = -1;
+            p.Entrance = -1;
+            p.X = Single.NaN;
+            p.Y = Single.NaN;
+            p.Z = Single.NaN;
+            p.YawByte = -1;
+            p.Yaw = Single.NaN;
+            p.NaviMode = -1;
+            p.White = -1;
+            p.Idx = -1;
+            p.Veg = -1;
+            p.Mode = -1;
+            return p;
+        }
+
+        private static readonly NetSyncDialog.HostView ParseScratch = new NetSyncDialog.HostView();   // main thread only
+
+        /// <summary>[ff9mapkit netsync s165] (pure over its input; main thread) ONE host payload's world facts, every section read from THIS
+        /// byte[]: section 7 through NetSyncDialog.TryParseHostSection (b6 = body[5] &amp; 0x40, b1 = &amp; 0x02, the heartbeat body[3..4]),
+        /// section 4 through NetSyncSwap.IntentLandedOf, section 0 IN PLACE (0-3, 64-72, 100-102, 181, 190) through
+        /// NetSyncState.StoryBodyOffset -- ApplyStoryTo's own walk, so the follow reads exactly the bytes a landing applies. Never
+        /// throws: a fault reads as no pose, with its why.</summary>
+        internal static HostWorldPose HostWorldPoseOf(Byte[] payload)
+        {
+            HostWorldPose p = NoPose();
+            try
+            {
+                if (payload == null)
+                {
+                    p.Why = "no host frame";
+                    return p;
+                }
+                p.HasFrame = true;
+                p.Payload = payload;
+                String dialogWhy = null;
+                Byte[] s7;
+                if (!NetSyncState.TryReadSection(payload, NetSyncState.SectionDialog, out s7) || s7 == null)
+                {
+                    dialogWhy = "no section 7";
+                }
+                else
+                {
+                    String why7;
+                    if (!NetSyncDialog.TryParseHostSection(s7, ParseScratch, out why7))
+                    {
+                        dialogWhy = "section 7 refused (" + why7 + ")";
+                    }
+                    else
+                    {
+                        p.HasDialog = true;
+                        p.Heartbeat = ParseScratch.Heartbeat;
+                        p.Flags = ParseScratch.Flags;
+                        p.B6 = (ParseScratch.Flags & NetSyncDialog.HfWorld) != 0;
+                        p.B1 = (ParseScratch.Flags & NetSyncDialog.HfControl) != 0;
+                    }
+                }
+                Byte[] s4;
+                if (NetSyncState.TryReadSection(payload, NetSyncState.SectionIntent, out s4) && s4 != null)
+                {
+                    p.HasIntent = true;
+                    p.IntentLanded = NetSyncSwap.IntentLandedOf(s4);
+                }
+                Int32 o;
+                if (NetSyncState.StoryBodyOffset(payload, out o))
+                {
+                    p.HasStory = true;
+                    p.Story = U16(payload, o + OffStory);
+                    p.Entrance = S16(payload, o + OffEntrance);
+                    p.RawX = S24(payload, o + OffPoseX);
+                    p.RawY = S16(payload, o + OffPoseY);
+                    p.RawZ = S24(payload, o + OffPoseZ);
+                    p.X = p.RawX / 256f;
+                    p.Y = -p.RawY / 256f;
+                    p.Z = p.RawZ / 256f;
+                    p.YawByte = payload[o + OffYaw];
+                    p.Yaw = p.YawByte * 360f / 256f;
+                    p.NaviMode = payload[o + OffNavi];
+                    p.White = payload[o + OffWhite];
+                    p.Idx = payload[o + OffWorldIdx];
+                    p.Veg = payload[o + OffVeg];
+                    p.Mode = payload[o + OffTravel];
+                }
+                p.Valid = p.HasDialog && p.B6 && p.HasStory;
+                if (!p.Valid)
+                    p.Why = dialogWhy != null ? dialogWhy : !p.B6 ? "the host is not on the world map (b6 clear)" : "no whole story section";
+            }
+            catch (Exception err)
+            {
+                p = NoPose();
+                p.HasFrame = payload != null;
+                p.Why = "unreadable (" + err.GetType().Name + ")";
+            }
+            return p;
+        }
+
+        private static Int32 U16(Byte[] b, Int32 o)
+        {
+            return b[o] | (b[o + 1] << 8);
+        }
+
+        private static Int32 S16(Byte[] b, Int32 o)
+        {
+            return unchecked((Int16)(b[o] | (b[o + 1] << 8)));
+        }
+
+        private static Int32 S24(Byte[] b, Int32 o)
+        {
+            Int32 v = b[o] | (b[o + 1] << 8) | (b[o + 2] << 16);
+            return (v & 0x800000) != 0 ? v - 0x1000000 : v;     // sign-extend: z is always negative on the torus
