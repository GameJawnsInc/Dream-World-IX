+                    _screenY = sp.y;
+                }
+                _placed = true;
+                _placeFrame = Time.frameCount;
+                if (why != NetSyncWorldFollow.DotShow)                  // `worldfollow dot off`: wanted, not drawn
+                {
+                    if (_go != null)
+                        Hide();
+                    return;
+                }
