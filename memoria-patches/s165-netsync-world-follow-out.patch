+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using Memoria.Prime;
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync s165] E4 THE PARTNER DOT (R2; studies/world-coop/S165-DESIGN.md decision 12 -- the MINIMAP only in rung 1: the full map
+    // stays refused for a frozen guest, s144, and its dot comes with free walk). A following guest on the world map sees where its host is NOW: a
+    // clone of the stock player pointer, placed from the host's section 0 (the on-foot anchor 64-72: no wire change) as THE ONE READER cached it
+    // (NetSyncClient.WorldHost*, E2) -- never a socket read here.
+    //   THE HOOK      PlaceMinimap is the FIRST statement of WorldHUD.DisplayMinimap (State.HUD only, every frame). Stock dereferences the
+    //                 walker unguarded right below it (WMUIData.MainCharacterPosition), so a hook after it would freeze the dot on that throw
+    //                 (G18); the dot computes everything itself (ff9.w_naviGetPos over the host's pose, the image's own size) and, as
+    //                 MiniMapPanel's child, rides the corner re-seat stock runs after it.
+    //   THE RULE      NetSyncWorldFollow.DotRule over my own facts and the cache (decision 12's order; its rows ride "world follow selftest").
+    //                 A refusal hides the dot; `worldfollow dot off` (CALIBRATION) hides a WANTED one and keeps its position rows.
+    //   THE MINT      lazily, once, the first frame the dot shows: NGUITools.AddChild(MiniMapPanel, the pointer) -- the panel's LAST child
+    //                 (Awake wired its four by index long before), so it hides with the minimap and moves with its corner. Colliders go (it
+    //                 must never steal the minimap's onClick), tweens and animations go, SetAnchor(null), the co-op tint, a depth UNDER the
+    //                 guest's own arrow (DepthSlotRule), DotScale times the donor's OWN scale (AddChild resets the clone's to one). The donor's
+    //                 census is kept for the harness. A failed mint latches: one line, never a retry per frame.
+    //   THE PLACE     localPosition = (W * sx, H * sy, 0) the way stock places its own pointer, (sx, sy) from NetSyncWorldFollow.MapPointRule
+    //                 (the seam-aware clamp on w_naviGetPos's OUTPUTS: on the disc-1 Mist window a host outside it pins to the edge on the
+    //                 side where it really is, dimmed), localRotation = Euler(0, 0, -(b72 * 360 / 256) - 90).
+    //   THE BACKSTOPS HideNow at every field load (NetSyncClient.ApplyStoryBeforeEvents), at every world load (WMScriptDirector.HonoAwake:
+    //                 WorldHUD is a persistent UI scene, so a minted dot outlives every world, battle and session, and its panel can come up
+    //                 before the first DisplayMinimap) and at the harness release (every role).
+    //   THE HINT      MinimapHintNow: a dot that would be drawn while the minimap is off (a New Game lands with the host's mirrored [100] =
+    //                 0) puts "Your partner is on the world map: press Select for the minimap." on s144's world chain -- the minimap is never
+    //                 forced on (that fights the s69 voyage bracket on [100]). R2's lever silences it too: `worldfollow dot off` gives s164's
+    //                 world line back byte for byte (the s144 regression legs judge it on a New Game, minimap off).
+    //   THE PROOF     SelfTest: "world dot selftest: OK (N rows, M mutants)" -- this file's own call-site rules (who, the depth slot, the alpha,
+    //                 the scale, the hint, the census colour). DotRule and the clamp are E1's, proven in "world follow selftest".
+    // Main thread only. Nothing here throws into the frame: every entry catches, counts the fault and logs ONE line per process.
+    internal static class NetSyncWorldDot
+    {
+        // ================================================================ constants (THE LOOK: the owner's open item -- tint, size, edge policy)
+        internal const String DotObjectName = "ff9mk coop host dot";   // the clone's name: a scene dump names it, nothing looks it up
+        internal const Single DotScale = 1.25f;         // the donor pointer's OWN localScale times this: just larger than the guest's own arrow,
+                                                        // so after the follow-out (the dot exactly ON that arrow, F14) a tinted rim still shows
+        internal const Single EdgeAlpha = 0.6f;         // a host outside the map image, pinned to its edge: dimmed, never mistaken for a pose
+        internal const Single NoSlotAlpha = 0.8f;       // no free depth between the cone / the image and the arrow (the census found them
+                                                        // consecutive): the dot draws ABOVE the arrow instead, see-through so the arrow stays read
+        internal const Int32 NoDepth = Int32.MinValue;  // a widget the census could not read (the cone or the image absent)
+        internal static readonly Color Tint = new Color(1f, 0.62f, 0.18f, 1f);   // a warm co-op orange, a MULTIPLY tint over the donor's own
+                                                                                  // texels (the census records the donor's widget colour beside it)
+        private const Int32 PlaceFreshFrames = 2;       // the last placement is the harness's only while the hook ran this frame or the last
+                                                        // (WorldHUD.Update and the harness publish run in either order; off State.HUD it stops)
+
+        // ================================================================ the levers and the live object
+        internal static Boolean LeverOff;               // `worldfollow dot off`: CALIBRATION -- a WANTED dot hidden (its position rows stay)
+        private static GameObject _go;                  // the minted dot (Unity's null: never minted, or destroyed under us -- then re-minted)
+        private static UISprite _sprite;                // ...its sprite
+        private static Boolean _overDonor;              // ...drawn ABOVE the arrow: DepthSlotRule found no free slot under it
+        private static Boolean _mintFailed;             // a failed mint latches: never a retry per frame
+
+        // the counters (monotonic per process: read DELTAS) and the one fault line
+        private static Int32 _frames, _shows, _hides, _faults;
+        private static String _lastFault;
+        private static Boolean _faultLogged;
+
+        // the last placement (the hook's, while the dot is WANTED) -- the harness's `sx` .. `screen_y`
+        private static Boolean _placed;
+        private static Int32 _placeFrame;
+        private static Single _rawSx, _rawSy, _px, _py, _rot, _ownPx, _ownPy, _screenX, _screenY;
+        private static Boolean _edge;
+
+        // the donor's census (the mint's; `census` null until then)
+        private static Boolean _census;
+        private static String _cSprite, _cAtlas, _cColor, _cPanelClip;
+        private static Int32 _cDepth, _cConeDepth, _cImageDepth, _cW, _cH, _cColliders, _cDotDepth, _cStripped;
+        private static Single _cScale;
+
+        // ================================================================ the pure call-site rules (SelfTest's rows)
+
+        /// <summary>[ff9mapkit netsync s165] (pure) WHO draws a dot (DotRule's first term, read live by NetSyncClient.WorldDotWho): a FOLLOWING
+        /// client (the waiting line's shape), or the selftest role with the field-gate bench on. Never a host; never a free roamer; nothing
+        /// while co-op is off (`live` = an instance and [Netsync] enabled).</summary>
+        internal static Boolean WhoRule(Boolean live, String role, Boolean followHost, Boolean benchGates)
+        {
+            if (!live)
+                return false;
+            if (role == "client")
+                return followHost;
+            if (role == "selftest")
+                return benchGates;
+            return false;
+        }
+
+        /// <summary>[ff9mapkit netsync s165] (pure) THE DEPTH SLOT: the dot draws UNDER the guest's own arrow (`donor`) and ABOVE the map image
+        /// and the vision cone -- donor - 1 when that lies strictly above both. Else there is no free slot (CALIBRATE-THE-MARGIN: a clamp onto
+        /// the cone's own depth is an unstable draw order): `overDonor`, one above the highest of the three, drawn at NoSlotAlpha.</summary>
+        internal static Int32 DepthSlotRule(Int32 donor, Int32 cone, Int32 image, out Boolean overDonor)
+        {
+            Int32 under = donor - 1;
+            if (under > cone && under > image)
+            {
+                overDonor = false;
+                return under;
+            }
+            overDonor = true;
+            return Math.Max(donor, Math.Max(cone, image)) + 1;
+        }
+
+        /// <summary>[ff9mapkit netsync s165] (pure) the dot's alpha: opaque, dimmed to EdgeAlpha when pinned to the image's edge, NoSlotAlpha
+        /// when it draws above the arrow (both: both).</summary>
+        internal static Single AlphaRule(Boolean edge, Boolean overDonor)
+        {
+            Single a = overDonor ? NoSlotAlpha : 1f;
+            return edge ? a * EdgeAlpha : a;
+        }
+
+        /// <summary>[ff9mapkit netsync s165] (pure) the dot's localScale from the DONOR's own (lane M's missed item: NGUITools.AddChild resets
+        /// the clone's to Vector3.one, so a scale taken from the clone loses any prefab scale).</summary>
+        internal static Vector3 ScaleOf(Vector3 donor)
+        {
+            return donor * DotScale;
+        }
+
+        /// <summary>[ff9mapkit netsync s165] (pure) THE MINIMAP-OFF HINT (decision 12): the dot WOULD be drawn (DotRule says DotShow) while
+        /// WorldHUD sits in HUDNoMiniMap -- the one state where the hook never runs and the guest would see no dot at all. The dot's lever
+        /// (DotLever: wanted, not drawn) silences it with the dot, so R2's calibration restores s164's world line exactly.</summary>
+        internal static Boolean HintRule(Boolean hudNoMiniMap, Int32 why)
+        {
+            return hudNoMiniMap && why == NetSyncWorldFollow.DotShow;
+        }
+
+        // The census's colour: "rrggbbaa", each channel rounded from [0, 1] (the stand-in's spelling, FAKE_DOT_CENSUS).
+        internal static String ColorHex(Color c)
+        {
+            return Hex2(c.r) + Hex2(c.g) + Hex2(c.b) + Hex2(c.a);
+        }
+
+        private static String Hex2(Single v)
+        {
+            Single k = v < 0f ? 0f : v > 1f ? 1f : v;
+            return ((Int32)Math.Round(k * 255f)).ToString("x2", CultureInfo.InvariantCulture);
+        }
+
+        // ================================================================ the live facts
+
+        // DotRule over my own facts and THE CACHE (NetSyncClient.WorldHostLatest: the one reader's parse of the latest payload). The facts past
+        // Who are read only for a guest that draws one (the rule is ordered); every read is a static field or a cheap engine flag.
+        private static Int32 VerdictNow(out NetSyncWorldFollow.HostWorldPose host)
+        {
+            host = NetSyncClient.WorldHostLatest;
+            NetSyncWorldFollow.DotFacts f = new NetSyncWorldFollow.DotFacts();
+            f.Who = NetSyncClient.WorldDotWho;
+            if (f.Who)
+            {
+                f.LiveScene = NetSyncClient.IsOnWorldNow(PersistenSingleton<EventEngine>.Instance) && ff9.w_framePhase == 2;
+                f.BlockReady = ff9.w_blockReady;
+                f.EventWorld = ff9.IsEventWorldMap;                  // MY OWN world: the right read here, I stand on it
+                f.Bee = FF9StateSystem.World.IsBeeScene;
+                f.Diorama = NetSyncDiorama.Booted;
+                f.Transition = NetSyncClient.WorldDotTransitionNow;
+                f.Walker = ff9.w_moveActorPtr != null;
+                f.AgeMs = NetSyncClient.WorldHostAgeMs;
+                f.HbAgeMs = NetSyncClient.WorldHostHbAgeMs;
+                Byte[] g = FF9StateSystem.EventState.gEventGlobal;
+                f.OwnIdx = g[NetSyncWorldFollow.OffWorldIdx];
+                f.OwnSc = g[NetSyncWorldFollow.OffStory] | (g[NetSyncWorldFollow.OffStory + 1] << 8);
+                f.LeverOff = LeverOff;
+            }
+            return NetSyncWorldFollow.DotRule(f, host);
+        }
+
+        // ================================================================ THE HOOK
+
+        /// <summary>[ff9mapkit netsync s165] THE HOOK: WorldHUD.DisplayMinimap's FIRST statement (State.HUD, every frame). Not a guest that draws
+        /// one (vanilla, a host, a free roamer): one static read, the dot hidden if it was ever minted. Else DotRule; a WANTED dot is placed
+        /// (the lever's calibration keeps the placement, hides the drawing), a shown one minted on its first frame. Never throws.</summary>
+        internal static void PlaceMinimap(GameObject panel, UISprite pointer, UISprite cone, UIWidget image)
+        {
+            try
+            {
+                if (!NetSyncClient.WorldDotWho)
+                {
+                    _placed = false;
+                    if (_go != null)
+                        Hide();
+                    return;
+                }
+                NetSyncWorldFollow.HostWorldPose host;
+                Int32 why = VerdictNow(out host);
+                if (!NetSyncWorldFollow.DotWanted(why) || panel == null || pointer == null || image == null)
+                {
+                    _placed = false;
+                    if (_go != null)
+                        Hide();
+                    return;
+                }
+                // the placement, on the guest's OWN map image (ff9.w_naviGetPos branches on my w_naviMapno; its mode argument is unread)
+                Single rx, ry, wx = 0f, wy = 0f;
+                ff9.w_naviGetPos(host.X, host.Z, out rx, out ry, 1);
+                Boolean tried = NetSyncWorldFollow.SeamTryWrap(ff9.w_naviMapno, host.X);
+                if (tried)
+                    ff9.w_naviGetPos(host.X + NetSyncWorldFollow.WorldWidth, host.Z, out wx, out wy, 1);
+                Single sx, sy;
+                Boolean edge = NetSyncWorldFollow.MapPointRule(tried, rx, ry, wx, wy, out sx, out sy);
+                Vector3 local = new Vector3((Single)image.width * sx, (Single)image.height * sy, 0f);
+                Single rot = NetSyncWorldFollow.DotRotationDeg(host.YawByte);
+                Vector3 own = pointer.transform.localPosition;      // the stock arrow as last laid out (the previous frame's: this hook runs first)
+                _rawSx = rx;
+                _rawSy = ry;
+                _edge = edge;
+                _px = local.x;
+                _py = local.y;
+                _rot = rot;
+                _ownPx = own.x;
+                _ownPy = own.y;
+                _screenX = Single.NaN;
+                _screenY = Single.NaN;
+                Camera cam = NGUITools.FindCameraForLayer(panel.layer);   // the UI camera (SetMiniMapAndChocoPosition's own idiom)
+                if (cam != null)
+                {
+                    Vector3 sp = cam.WorldToScreenPoint(panel.transform.TransformPoint(local));
