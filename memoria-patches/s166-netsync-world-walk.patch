+            t.Seq = Get16(payload, off + TfSeq);
+            t.Ms = Get32(payload, off + TfMs);
+            t.Place = payload[off + TfPlace];
+            t.State = payload[off + TfState];
+            t.Why = payload[off + TfWhy];
+            t.World = Get16(payload, off + TfWorld);
+            t.X = GetF(payload, off + TfX);
+            t.Y = GetF(payload, off + TfY);
+            t.Z = GetF(payload, off + TfZ);
