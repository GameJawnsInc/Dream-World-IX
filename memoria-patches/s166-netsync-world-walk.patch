+            b[at] = (Byte)(v & 0xFFu);
+            b[at + 1] = (Byte)((v >> 8) & 0xFFu);
+            b[at + 2] = (Byte)((v >> 16) & 0xFFu);
+            b[at + 3] = (Byte)((v >> 24) & 0xFFu);
+        }
