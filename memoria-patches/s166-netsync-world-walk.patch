+        // a fixture block map: every block moved (sx, sz) render slots by the wraps (CurrentX = (cx + sx) mod 24, CurrentY = (cz + sz) mod 20)
+        private static BlockSlotFn ShiftSlots(Int32 sx, Int32 sz)
+        {
+            return (Int32 cx, Int32 cz, out Int32 curX, out Int32 curY) =>
+            {
+                curX = (cx + sx) % BlocksX;
+                curY = (cz + sz) % BlocksZ;
+                return true;
+            };
+        }
