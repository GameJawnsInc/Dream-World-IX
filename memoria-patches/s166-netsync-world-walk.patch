+        // ...and its inverse, WMWorld.GetAbsolutePositionOf's own walk (the render slot -> its block's InitialX / InitialY, plus the % 64 offset)
+        private static void ShiftInverse(Single rx, Single rz, Int32 sx, Int32 sz, out Single x, out Single z)
+        {
+            Int32 bx = (Int32)(rx / BlockSize), bz = (Int32)(Math.Abs(rz) / BlockSize);
+            if (bx > BlocksX - 1)
+                bx = BlocksX - 1;
+            if (bz > BlocksZ - 1)
+                bz = BlocksZ - 1;
+            Int32 ix = ((bx - sx) % BlocksX + BlocksX) % BlocksX, iz = ((bz - sz) % BlocksZ + BlocksZ) % BlocksZ;
+            x = ix * BlockSize + rx % BlockSize;
+            z = -iz * BlockSize + rz % BlockSize;
+        }
