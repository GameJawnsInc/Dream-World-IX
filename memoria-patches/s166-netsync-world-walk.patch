+        private static void Put16(Byte[] b, Int32 at, Int32 v)
+        {
+            b[at] = (Byte)(v & 0xFF);
+            b[at + 1] = (Byte)((v >> 8) & 0xFF);
+        }
+
+        private static void Put32(Byte[] b, Int32 at, UInt32 v)
