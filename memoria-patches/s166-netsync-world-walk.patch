+            if (w == null)
+                return false;
+            WMBlock[,] b = w.InitialBlocks;
+            if (b == null || cx < 0 || cz < 0 || cx >= b.GetLength(0) || cz >= b.GetLength(1))
+                return false;
+            WMBlock k = b[cx, cz];
+            if (k == null)
+                return false;
+            curX = k.CurrentX;
+            curY = k.CurrentY;
+            return true;
+        }
+
+        // ONE ground probe at a sample (its canonical x / z mapped to the render frame through the current slots): stock's non-controlled flags
+        // set (UseInfiniteRaycast, CastRayFromSky = a walker's flg_fly 0, IgnoreExceptions) and RESTORED to what they were, the sky retry on a
+        // miss, the remap ids keeping the body's own height (GroundOf), water by the walker's slice for the hit's id, and the mismatch check
+        private static void Probe(NetSyncWorldWalk.WorldTrailer s)
+        {
+            _wireY = s.Y;
+            Single rx, rz;
+            if (!NetSyncWorldWalk.RenderOf(s.X, s.Z, Slots, out rx, out rz))
+            {
+                _groundY = Single.NaN;
+                _remapped = false;
+                _water = false;
+                _mismatch = false;
+                return;
+            }
+            Boolean inf = WMPhysics.UseInfiniteRaycast, sky = WMPhysics.CastRayFromSky, ign = WMPhysics.IgnoreExceptions;
+            Int32 id = 0, pno = NetSyncWorldWalk.GroundMissPno;
+            Single h = 0f;
+            try
+            {
+                WMPhysics.UseInfiniteRaycast = true;
+                WMPhysics.CastRayFromSky = false;
+                WMPhysics.IgnoreExceptions = true;
+                Vector3 p = new Vector3(rx, s.Y, rz);
+                h = ff9.w_nwpHit(ref p, out id, out pno, null);
+                if (pno == NetSyncWorldWalk.GroundMissPno)
+                {
+                    WMPhysics.CastRayFromSky = true;     // stock's retry from the sky on a miss
+                    p = new Vector3(rx, s.Y, rz);
+                    h = ff9.w_nwpHit(ref p, out id, out pno, null);
+                }
+            }
+            finally
+            {
+                WMPhysics.UseInfiniteRaycast = inf;
+                WMPhysics.CastRayFromSky = sky;
+                WMPhysics.IgnoreExceptions = ign;
+            }
+            _probes++;
+            Boolean remapped;
+            Single g = NetSyncWorldWalk.GroundOf(pno, id, h, s.Y, out remapped);
+            Boolean water = false;
+            if (pno != NetSyncWorldWalk.GroundMissPno && !remapped)
+            {
+                Boolean imd = false;
+                water = NetSyncWorldWalk.WaterRule(ff9.w_movementGetSliceHeight(ff9.w_moveCHRStatus[1].slice_type, id, ref imd));
+            }
+            Boolean mm = NetSyncWorldWalk.GroundMismatchRule(s.Y, g, water, remapped);
+            _groundY = g;
+            _remapped = remapped;
+            _water = water;
+            _mismatch = mm;
+            if (!mm)
+                return;
+            _mismatches++;
+            if (_mismatchSaid)
+                return;
+            _mismatchSaid = true;
+            Log.Message("[NetSync] world ghost: ground mismatch -- the partner stands at y " + Units(s.Y) + " where my ground is " + Units(g) + " ("
+                        + Units(s.Y - g) + " u, beyond " + Units(NetSyncWorldWalk.GroundTolU) + ") at (" + Units(s.X) + ", " + Units(s.Z) + ") on map "
+                        + s.World + ", walkmesh id 0x" + id.ToString("X") + " -- the two worlds' content may differ; the body keeps the wire's y (said once per world visit)"
+                        + NetSyncSwap.Stamp());
+        }
+
+        private static String Units(Single v)
+        {
+            return v.ToString("0.###", CultureInfo.InvariantCulture);
+        }
+
+        // the stall's clip and the sender's frame (WorldAnimRule), through s157's core: follow (speed 0, sampled), free-run the sender's clip
+        // (an unusable frame count), the body's _STAND (a stall), or keep what plays (a clip not on the body: never a fallback)
+        private static void Animate(NetSyncWorldWalk.WorldTrailer s, Int32 stall, Single a)
+        {
+            if (_anim == null)
+            {
+                _animMode = -1;
+                return;
+            }
+            String sender = null;
+            Boolean clipOn = false;
+            if (stall == NetSyncWorldWalk.StallMove && FF9DBAll.AnimationDB.TryGetValue(s.Anim, out sender) && !String.IsNullOrEmpty(sender))
+                clipOn = ClipOn(sender, s.Anim);
+            Byte frameN = (Byte)(s.FrameN & 0xFF);
+            Int32 mode = NetSyncWorldWalk.WorldAnimRule(stall, clipOn, frameN, _standOn);
+            _animMode = mode;
+            switch (mode)
+            {
+                case NetSyncWorldWalk.AnimFollow:
+                {
+                    Boolean started = Play(sender);
+                    NetSyncClient.GhostFrameFollowCore(_anim, sender, started, (Byte)(s.AnimFrame & 0xFF), frameN, a, ref _gfOn, ref _gfWhy, ref _gfClip,
+                                                       ref _gfN, ref _gfLastWire, ref _gfTarget, ref _gfShown, ref _gfSnaps, ref _gfSteps, ref _gfWraps);
+                    break;
+                }
+                case NetSyncWorldWalk.AnimFree:
+                    Play(sender);
+                    NetSyncClient.GhostFrameFreeCore(_anim, sender, NetSyncVisitor.GfWhyFrameN, ref _gfOn, ref _gfWhy, ref _gfRestores);
+                    break;
+                case NetSyncWorldWalk.AnimStand:
+                    Play(_standClip);
+                    NetSyncClient.GhostFrameFreeCore(_anim, _standClip, NetSyncVisitor.GfWhyNoFrame, ref _gfOn, ref _gfWhy, ref _gfRestores);
+                    break;
+                default:
+                    NetSyncClient.GhostFrameFreeCore(_anim, _clip, NetSyncVisitor.GfWhyClip, ref _gfOn, ref _gfWhy, ref _gfRestores);
+                    break;
+            }
+        }
+
+        // a clip on the body: the CreateModel attach (every clip of its own W0 GEO); else one AddAnimWithAnimatioName probe per clip per body
+        // (a dressed body's foreign clip), remembered when it misses -- never a probe per frame, never a fallback
+        private static Boolean ClipOn(String clip, Int32 animId)
+        {
+            if (_anim.GetClip(clip) != null)
+                return true;
+            if (_missClips.Contains(clip))
+                return false;
+            try
+            {
+                AnimationFactory.AddAnimWithAnimatioName(_body, clip);
+            }
+            catch { }
+            if (_anim.GetClip(clip) != null)
+                return true;
+            _missClips.Add(clip);                    // [ff9mapkit netsync s166] review: remembered past the cap too (the cap bounds the LINES: never a probe per frame)
+            if (_missClips.Count <= MissClipCap)
+            {
+                Log.Message("[NetSync] world ghost: the partner plays " + clip + " (anim " + animId + "), which is not on " + (_bodyGeo ?? "the body")
+                            + " -- keeping the clip already playing");
+            }
+            return false;
+        }
+
+        // (re)start a clip only on a change (Loop: a world clip runs one cycle then freezes otherwise); true = started (frame-follow snaps)
+        private static Boolean Play(String clip)
+        {
+            if (String.IsNullOrEmpty(clip) || (clip == _clip && _anim.IsPlaying(clip)))   // [ff9mapkit netsync s166] review: a re-shown body (SetActive) re-plays its clip
+                return false;
+            if (_anim.GetClip(clip) == null)
+                return false;
+            if (!_anim.IsPlaying(clip))
+            {
+                AnimationState st = _anim[clip];
+                if (st != null)
+                    st.wrapMode = WrapMode.Loop;
+                _anim.Play(clip);
+            }
+            _clip = clip;
+            return true;
+        }
+
+        // the shadow under the body: stock's walker row and the live fogAMP (ShadowRule), at the probe's ground + 0.1 under the eased render x / z
+        // (the body's eased y offset carried, so it settles with the body); hidden in water, with no ground, or with the body hidden
+        private static void Shadow(Boolean show)
+        {
+            if (_shadow == null)
+                return;
+            if (!show || Single.IsNaN(_groundY) || Single.IsNaN(_wireY) || _water)
+            {
+                if (_shadow.activeSelf)
+                    _shadow.SetActive(false);
+                _shadowShown = false;
+                return;
+            }
+            Single sc, am;
+            NetSyncWorldWalk.ShadowRule(_groundY, _wireY, ff9.w_weatherColor.Color[16].fogAMP, out sc, out am);
+            Transform t = _shadow.transform;
+            t.localScale = new Vector3(sc, sc, sc);
+            if (_shadowMat != null)
+                _shadowMat.SetFloat("_Amp", am);
+            t.position = new Vector3(_m.RX, _groundY + (_m.RY - _wireY) + NetSyncWorldWalk.ShadowLiftU, _m.RZ);
+            if (!_shadow.activeSelf)
+                _shadow.SetActive(true);
+            _shadowShown = true;
+            _shadowScale = sc;
+            _shadowAmp = am;
+        }
+
+        // ================================================================ A3's seam: the bench host's ground (NetSyncClient.WorldBenchGroundY)
+
+        /// <summary>[ff9mapkit netsync s166] A4 the bench host's y at canonical (x, z): behind THE STRICT GATE (off it 0, A3's own off-world value),
+        /// the point mapped through the current slots and probed FROM THE SKY with stock's flags (set and restored); a miss is my walker's y. Called
+        /// from the selftest Update in any scene. Never throws (a fault: 0).</summary>
+        internal static Single BenchGroundY(Single x, Single z)
+        {
+            try
+            {
+                if (!NetSyncWorldWalk.GhostSceneGate(NetSyncClient.IsOnWorldNow(PersistenSingleton<EventEngine>.Instance), ff9.w_blockReady))
+                    return 0f;
+                WMActor me = ff9.w_moveActorPtr;
+                Single own = me != null && me != ff9.w_moveDummyCharacter ? me.RealPosition.y : 0f;
+                _slotsWorld = Singleton<WMWorld>.Instance;
+                Single rx, rz;
+                Boolean mapped = NetSyncWorldWalk.RenderOf(x, z, Slots, out rx, out rz);
+                _slotsWorld = null;
+                if (!mapped)
+                    return own;
+                Boolean inf = WMPhysics.UseInfiniteRaycast, sky = WMPhysics.CastRayFromSky, ign = WMPhysics.IgnoreExceptions;
+                Int32 id, pno;
+                Single h;
+                try
+                {
+                    WMPhysics.UseInfiniteRaycast = true;
+                    WMPhysics.CastRayFromSky = true;
+                    WMPhysics.IgnoreExceptions = true;
+                    Vector3 p = new Vector3(rx, 0f, rz);
+                    h = ff9.w_nwpHit(ref p, out id, out pno, null);
+                }
+                finally
+                {
+                    WMPhysics.UseInfiniteRaycast = inf;
+                    WMPhysics.CastRayFromSky = sky;
+                    WMPhysics.IgnoreExceptions = ign;
+                }
+                return pno == NetSyncWorldWalk.GroundMissPno ? own : h;
+            }
+            catch (Exception err)
+            {
+                _slotsWorld = null;
+                Fault("the bench host's ground", err);
+                return 0f;
+            }
+        }
+
+        private static void Fault(String what, Exception err)
+        {
+            _faults++;
+            _lastFault = what + ": " + err.GetType().Name + ": " + err.Message;
+            if (_faultLogged)
+                return;
+            _faultLogged = true;
+            Log.Error(err, "[NetSync] world ghost: " + what + " failed (logged once per process; the ghost hides)");
+        }
