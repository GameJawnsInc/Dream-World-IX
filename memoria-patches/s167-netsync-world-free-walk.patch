+        // the call site's loop over two reads of ONE press in one key tick (the order as given): exactly one buzz, and its class
+        private static Boolean OneBuzz(Rules r, EntryRead e0, Int32 sidA, Int32 placeA, Int32 sidB, Int32 placeB, Int32 first)
+        {
+            Int32 last = -1, buzzes = 0, cls = EntryNone;
+            for (Int32 k = 0; k < 2; k++)
+            {
+                EntryRead e = e0;
+                e.Sid = k == 0 ? sidA : sidB;
