+        private static UInt32 R32(Byte[] b, Int32 at)
+        {
+            return (UInt32)b[at] | ((UInt32)b[at + 1] << 8) | ((UInt32)b[at + 2] << 16) | ((UInt32)b[at + 3] << 24);
