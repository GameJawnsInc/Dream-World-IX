+        private static void W32(List<Byte> b, UInt32 v)
+        {
+            b.Add((Byte)(v & 0xFFu));
+            b.Add((Byte)((v >> 8) & 0xFFu));
+            b.Add((Byte)((v >> 16) & 0xFFu));
+            b.Add((Byte)((v >> 24) & 0xFFu));
+        }
