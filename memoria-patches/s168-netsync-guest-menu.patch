+        private static void ProbeSlot(List<Byte> b, Byte charId, String name, Int32[] equip, Int32[] sa)
+        {
+            b.Add(1);
+            b.Add(charId);
+            b.Add(charId);
+            b.Add(30);
+            b.Add(0);
+            W32(b, 500u);
+            W32(b, 600u);
+            W32(b, 40u);
+            W32(b, 50u);
+            for (Int32 j = 0; j < 5; j++)
+                W16(b, equip[j]);
