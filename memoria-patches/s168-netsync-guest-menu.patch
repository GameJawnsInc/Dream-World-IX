+        // section 12's consumed length (fmt 1's exact end), for the strict-end mutant
+        private static Boolean MutReadExactEnd(Byte[] body, out GmBlock block)
+        {
+            if (!TryReadMenuBlock(body, out block))
+                return false;
+            Int32 len = MenuFixedLen + 2 * block.Used.Length;
+            for (Int32 k = 0; k < block.Members.Length; k++)
+                len += MemberFixedLen + 2 * block.Members[k].Pa.Length;
+            if (len == body.Length)
+                return true;
+            block = null;
+            return false;
+        }
