+        /// payloadLen x 1000 / elapsed ms, and the window restarts at this read. Tick deltas by subtraction only (TickCount wraps).</summary>
+        internal static Int32 TxBpsStep(ref Int64 baseSends, ref Int32 baseTick, Int64 sends, Int32 now, Int32 payloadLen, Int32 last)
+        {
+            if (baseSends < 0 || sends < baseSends)
+            {
+                baseSends = sends;
+                baseTick = now;
+                return -1;
+            }
+            Int32 elapsed = now - baseTick;
+            if (elapsed < TxWindowMs)
+                return last;
+            Int64 bps = (sends - baseSends) * (Int64)Math.Max(payloadLen, 0) * 1000L / elapsed;
+            baseSends = sends;
+            baseTick = now;
+            return bps > Int32.MaxValue ? Int32.MaxValue : (Int32)bps;
+        }
