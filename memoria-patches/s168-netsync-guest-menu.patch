+        /// touches no live state. Never throws.</summary>
+        internal static Boolean SelfTest(out String detail)
+        {
+            try
+            {
+                List<String> fails = new List<String>();
+                Int32 rows = Rows(new Rules(), fails);
+                if (fails.Count > 0)
+                {
+                    detail = "row " + fails[0] + " failed (" + fails.Count + " of " + rows + ")";
+                    return false;
+                }
+                if (MutantNames.Length != MutantRows.Length)
+                {
+                    detail = "the mutant table is ragged (" + MutantNames.Length + " names, " + MutantRows.Length + " rows)";
