+                    for (Int32 p = 255; p >= 0 && id < 0; p--)
+                        if (!inst.PresetKnown(p))
+                            id = p;
+                    if (id < 0)
+                        return "every preset id 0-255 is installed";
+                    b0.info.menu_type = (global::Memoria.Data.CharacterPresetId)id;
+                    return null;
+                case NetSyncGuestMenu.CompPa:
+                    Int32[] pa = new Int32[(b0.pa != null ? b0.pa.Length : 0) + 1];   // one more than the preset's: the pa length differs
