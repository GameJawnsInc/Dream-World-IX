+        // the guest's own state: Zidane (0), Vivi (1) and Steiner (3) in the party (slot 2 empty), Freya (4) on the bench; a bag with an empty
+        // row (never folded); key items 3 (read) and 9
+        private static FpState FpGuest()
+        {
+            FpState s = new FpState();
+            Int32[] ids = { 0, 1, 3, 4 };
+            for (Int32 k = 0; k < ids.Length; k++)
+                s.Players[(CharacterId)ids[k]] = FpProbePlayer(ids[k], 10 + ids[k]);
+            s.Member[0] = s.Players[(CharacterId)0];
+            s.Member[1] = s.Players[(CharacterId)1];
+            s.Member[3] = s.Players[(CharacterId)3];
+            s.Bag.Add(new FF9ITEM((RegularItem)1, 5));
+            s.Bag.Add(new FF9ITEM((RegularItem)2, 0));
+            s.Bag.Add(new FF9ITEM((RegularItem)40, 2));
+            s.Obtained.Add(3);
+            s.Obtained.Add(9);
+            s.Used.Add(3);
+            s.Gil = 1234u;
+            return s;
+        }
+
+        // the host's state: the guest's party members (Zidane, Vivi, Steiner; slot 2 empty) with the HOST's values, so a scratch carries the same
+        // slot ids as the original it replaces (only the identity bit tells them apart); the marker bag row (7 x 99); key items 9 and 12
+        private static FpState FpHost()
+        {
+            FpState s = new FpState();
+            for (Int32 i = 0; i < 4; i++)
+            {
+                if (i == 2)
+                    continue;
+                PLAYER p = FpProbePlayer(i, 60 + i);
+                s.Players[p.info.slot_no] = p;
+                s.Member[i] = p;
+            }
+            s.Bag.Add(new FF9ITEM((RegularItem)40, 2));
+            s.Bag.Add(new FF9ITEM((RegularItem)7, 99));
+            s.Obtained.Add(9);
+            s.Obtained.Add(12);
+            s.Used.Add(12);
+            s.Gil = 777777u;
+            return s;
+        }
