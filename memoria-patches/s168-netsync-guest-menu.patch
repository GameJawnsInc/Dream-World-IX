+        // a reader that clamps memberN to the cap instead of refusing
+        private static Boolean MutReadClampMembers(Byte[] body, out GmBlock block)
+        {
+            if (body != null && body.Length >= MenuFixedLen)
+            {
+                Int32 at = 9 + 2 * R16(body, 7);
+                if (at < body.Length && body[at] > MemberCap)
+                {
+                    Byte[] c = (Byte[])body.Clone();
+                    c[at] = (Byte)MemberCap;
+                    return TryReadMenuBlock(c, out block);
+                }
+            }
+            return TryReadMenuBlock(body, out block);
+        }
