+        private static UInt64 FpPartyOf(UInt64 h, Dictionary<CharacterId, PLAYER> players, PLAYER[] member, Int32 mut)
+        {
+            if (member == null)
+                return MixU(h, FpNull);
+            for (Int32 i = 0; i < 4; i++)
+            {
+                PLAYER m = i < member.Length ? member[i] : null;
+                if (m == null || m.info == null)
+                {
+                    h = Mix(h, m == null ? 255 : -2);   // the writer's empty slot is 255
