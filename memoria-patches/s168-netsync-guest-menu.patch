+            b.Add((Byte)nm.Length);
+            b.AddRange(nm);
+            W32(b, 550u);
+            W32(b, 45u);
+            b.Add(20);
+            b.Add(21);
+            b.Add(22);
+            b.Add(23);
+            W32(b, 30u);
+            W32(b, 0u);
+            W32(b, 0u);
+            b.Add(0);
