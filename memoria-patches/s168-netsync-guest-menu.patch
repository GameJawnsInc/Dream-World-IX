+                b.equip[j] = src.equip[j];
+            b.cur.hp = src.cur.hp;
+            b.max.hp = src.max.hp;
+            b.cur.mp = src.cur.mp;
+            b.max.mp = src.max.mp;
+            b.basis.max_hp = src.basis.max_hp;
+            b.basis.max_mp = src.basis.max_mp;
+            b.basis.dex = src.basis.dex;
+            b.basis.str = src.basis.str;
+            b.basis.mgc = src.basis.mgc;
+            b.basis.wpr = src.basis.wpr;
