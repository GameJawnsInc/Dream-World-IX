+using System;
+using System.Collections.Generic;
+using Memoria.Data;
+using Memoria.Prime;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync s168] W1a THE SEAT BRACKET (studies/field-coop/S168-DESIGN.md decision 11). The diorama's party bracket -- the
+    // ORIGINAL object references a seat displaces (the four party.member slots, every ff9.player entry it overwrites) -- moved out of
+    // NetSyncDiorama's statics into an instance, so that a second seat owner (the guest menu's seat, s168 W1f) holds a record of its own.
+    // WHY: the s167 bracket was static with ONE owner -- Disarm restored it unconditionally, a refused or failed Boot cleared it -- so a
+    // menu seat sharing it would be restored or erased by any diorama teardown, and a menu close would restore or erase the diorama's.
+    // Two instances never cross-restore, and each clear clears only its own (the proof below: GM0-BRACKET-CLEAR's rows).
+    // BEHAVIOUR-NEUTRAL for the diorama: Snapshot / RememberOriginalPlayer / Restore are s167's SnapshotParty / RememberOriginalPlayer /
+    // RestoreParty bodies verbatim, Clear is the three-statement drop of Boot's two failure paths, and `Who` ("diorama") puts the s167
+    // words back into every line they log. WHY a reference bracket at all: NetSyncDiorama's THE PARTY BRACKET comment. Game thread only.
+    internal sealed class NetSyncSeatBracket
+    {
+        /// <summary>The owner's name in this bracket's log lines (the diorama's is "diorama": the s167 words exactly).</summary>
+        internal readonly String Who;
+
+        private PLAYER[] _realMember;
+        private readonly Dictionary<CharacterId, PLAYER> _realPlayer = new Dictionary<CharacterId, PLAYER>();
+        private Boolean _havePartySnapshot;
+
+        internal NetSyncSeatBracket(String who)
+        {
+            Who = who;
+        }
+
+        /// <summary>A record is held: Snapshot succeeded and no Restore or Clear has run since. The diorama's MirrorHostParty gates on it.</summary>
+        internal Boolean HaveSnapshot => _havePartySnapshot;
+
+        /// <summary>Record the four party.member slot REFERENCES (not the objects) and open the record for RememberOriginalPlayer.
+        /// A failure logs and leaves no record (s167's SnapshotParty).</summary>
+        internal void Snapshot()
+        {
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                _realMember = (PLAYER[])ff9.party.member.Clone();   // the 4 slot REFERENCES, not the objects
+                _realPlayer.Clear();
+                _havePartySnapshot = true;
+            }
+            catch (Exception ex)
+            {
+                _havePartySnapshot = false;
+                Log.Warning("[NetSync] " + Who + " party snapshot failed: " + ex);
+            }
+        }
+
+        /// <summary>
+        /// Record a dict slot's ORIGINAL PLAYER before the apply overwrites it. The apply calls this
+        /// immediately before `ff9.player[id] = scratch`. First write wins, so a re-entrant apply can
+        /// never bury the real object behind a scratch.
+        /// </summary>
+        internal void RememberOriginalPlayer(CharacterId id)
+        {
+            if (!_havePartySnapshot || _realPlayer.ContainsKey(id))
+                return;
+            try
+            {
+                PLAYER original;
+                if (FF9StateSystem.Common.FF9.player.TryGetValue(id, out original))
+                    _realPlayer[id] = original;
+            }
+            catch (Exception ex)
+            {
+                Log.Warning("[NetSync] " + Who + " could not remember player " + id + ": " + ex);
+            }
+        }
+
+        /// <summary>
+        /// Put the owner's party back, by reference. Safe to call when the apply never ran (the maps
+        /// are simply empty). Idempotent: the record is dropped whatever happens.
+        /// </summary>
+        internal void Restore()
+        {
+            if (!_havePartySnapshot)
+                return;
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                foreach (KeyValuePair<CharacterId, PLAYER> kv in _realPlayer)
+                    ff9.player[kv.Key] = kv.Value;                  // the ORIGINAL object, untouched
+                if (_realMember != null)
+                    Array.Copy(_realMember, ff9.party.member, 4);   // element-wise: BattleHUD writes into this array
+            }
+            catch (Exception ex)
+            {
+                Log.Warning("[NetSync] " + Who + " party restore failed: " + ex);
+            }
+            finally
+            {
+                _realPlayer.Clear();
+                _realMember = null;
+                _havePartySnapshot = false;
+            }
+        }
+
+        /// <summary>Drop the record WITHOUT writing anything back: the diorama's failure paths, where the party was never touched (a boot
+        /// refused after a failed state snapshot; a boot that threw). Clears THIS instance only.</summary>
+        internal void Clear()
+        {
+            _havePartySnapshot = false;
+            _realPlayer.Clear();
+            _realMember = null;
+        }
+
+        // ---- [ff9mapkit netsync s168] W1f THE GUEST MENU'S RECORD (S168-DESIGN.md decisions 12 and 16): the same record over an EXPLICIT state.
+        // The menu's seat writes its whole record BEFORE the build (all or nothing: these throw, never half-record silently) and restores
+        // ELEMENT-WISE against the state it seated, one family at a time, KEEPING the record (a retry writes the same references again; the owner
+        // drops it with Clear only once every family is back). Over a GIVEN state so the guest menu's proof drives them on a probe FF9StateGlobal,
+        // never the live one. None of them logs: the owner names a failed family in its own line. The diorama never calls them.
+        /// <summary>[ff9mapkit netsync s168] W1f Snapshot() over `ff9`: the four member REFERENCES; throws instead of logging (the seat refuses).</summary>
+        internal void SnapshotOf(FF9StateGlobal ff9)
+        {
+            PLAYER[] member = (PLAYER[])ff9.party.member.Clone();   // the 4 slot REFERENCES, not the objects
+            _realPlayer.Clear();
+            _realMember = member;
+            _havePartySnapshot = true;
+        }
+
+        /// <summary>[ff9mapkit netsync s168] W1f RememberOriginalPlayer over `ff9`: first write wins (the builder's own Remember after it is then a
+        /// no-op, so a scratch is never recorded as an original).</summary>
+        internal void RememberOriginalPlayerOf(FF9StateGlobal ff9, CharacterId id)
+        {
+            if (!_havePartySnapshot || _realPlayer.ContainsKey(id))
+                return;
+            PLAYER original;
+            if (ff9.player.TryGetValue(id, out original))
+                _realPlayer[id] = original;
+        }
+
+        /// <summary>[ff9mapkit netsync s168] W1f the dictionary family back into `ff9` by reference; the record is KEPT. False = it faulted.</summary>
+        internal Boolean RestorePlayersInto(FF9StateGlobal ff9)
+        {
+            if (!_havePartySnapshot)
+                return true;
+            try
+            {
+                foreach (KeyValuePair<CharacterId, PLAYER> kv in _realPlayer)
+                    ff9.player[kv.Key] = kv.Value;                  // the ORIGINAL object, untouched
+                return true;
+            }
+            catch (Exception)
+            {
+                return false;
+            }
+        }
+
+        /// <summary>[ff9mapkit netsync s168] W1f the four member references back into `ff9`'s live member array (Array.Copy: the array object stays
+        /// the same); the record is KEPT. False = it faulted.</summary>
+        internal Boolean RestoreMembersInto(FF9StateGlobal ff9)
+        {
+            if (!_havePartySnapshot || _realMember == null)
+                return true;
+            try
+            {
+                Array.Copy(_realMember, ff9.party.member, 4);
+                return true;
+            }
+            catch (Exception)
+            {
+                return false;
+            }
+        }
+
+        /// <summary>[ff9mapkit netsync s168] W1f the recorded ORIGINAL member reference of slot `slot` (null: none, or no record) -- the ghost
+        /// dress's LiveSlotChars reads the guest's own party here while the guest menu is seated (decision 14).</summary>
+        internal PLAYER RecordedMember(Int32 slot)
+        {
+            return _havePartySnapshot && _realMember != null && slot >= 0 && slot < _realMember.Length ? _realMember[slot] : null;
+        }
+
+        // ---- [ff9mapkit netsync s168] W1a THE PROOF: "seat bracket selftest: OK (N rows, M mutants caught)" (NetSyncClient's selftest proof
+        // block, after the world walk line). The rows drive the REAL methods over the live ff9 state (as the diorama's containment selftest
+        // does): one probe PLAYER -- the first ff9.player entry -- and the live member array, impostor scratches installed by reference and the
+        // probe's entry, the array object and its four references put back after every pass (Reset, in a finally). Each mutant is one plausible
+        // wrong bracket, one line, caught by its own row (MutantRows). GM0-BRACKET-CLEAR's rows are the `clear.*` group; GM0-BRACKET's
+        // cross-restore rows are the `cross.*` group; the rest pin the s167 bracket's own laws, now that it moved.
+        private delegate NetSyncSeatBracket MenuFn(NetSyncSeatBracket diorama);
+        private delegate void DioRestoreFn(NetSyncSeatBracket diorama, NetSyncSeatBracket menu);
+
+        private sealed class Rig
+        {
+            public Func<NetSyncSeatBracket> NewDiorama = () => new NetSyncSeatBracket("diorama");
+            public MenuFn NewMenu = d => new NetSyncSeatBracket("guest menu");   // the diorama's is passed only so a mutant CAN share it
+            public Action<NetSyncSeatBracket> Snapshot = b => b.Snapshot();
+            public Action<NetSyncSeatBracket, CharacterId> Remember = (b, id) => b.RememberOriginalPlayer(id);
+            public Action<NetSyncSeatBracket> Restore = b => b.Restore();
+            public DioRestoreFn DioRestore = (d, m) => d.Restore();              // Disarm's restore; the menu's is passed only so a mutant CAN
+            public Action<NetSyncSeatBracket> Clear = b => b.Clear();
+        }
+
+        // the live state a pass borrows: the probe's dict entry, the member array object and its four references
+        private sealed class Live
+        {
+            public FF9StateGlobal Ff9;
+            public CharacterId P;
+            public PLAYER OrigP;
+            public PLAYER[] Arr;
+            public PLAYER[] Before;
+        }
+
+        private static Live Probe()
+        {
+            FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+            foreach (KeyValuePair<CharacterId, PLAYER> kv in ff9.player)
+            {
+                if (kv.Value == null)
+                    continue;
+                Live l = new Live();
+                l.Ff9 = ff9;
+                l.P = kv.Key;
+                l.OrigP = kv.Value;
+                l.Arr = ff9.party.member;
+                l.Before = (PLAYER[])l.Arr.Clone();
+                return l;
+            }
+            return null;
+        }
+
+        private static void Reset(Live l)
+        {
+            l.Ff9.player[l.P] = l.OrigP;
+            l.Ff9.party.member = l.Arr;
+            Array.Copy(l.Before, l.Arr, l.Before.Length);
+        }
+
+        // a seat's install, MirrorHostParty's shape: the scratch into the dict slot AND the party pointer
+        private static void Install(Live l, PLAYER scratch)
+        {
+            l.Ff9.player[l.P] = scratch;
+            l.Ff9.party.member[0] = scratch;
+        }
+
+        private static Boolean SeatIs(Live l, PLAYER scratch)
+        {
+            return ReferenceEquals(l.Ff9.player[l.P], scratch) && ReferenceEquals(l.Ff9.party.member[0], scratch);
+        }
+
+        // what the engine reads holds the guest's own objects again: the probe's entry and all four slots
+        private static Boolean MemberRefsBack(Live l)
+        {
+            PLAYER[] now = l.Ff9.party.member;
+            if (now == null || now.Length != l.Before.Length)
+                return false;
+            for (Int32 i = 0; i < now.Length; i++)
+                if (!ReferenceEquals(now[i], l.Before[i]))
+                    return false;
+            return true;
+        }
+
+        private static Boolean Originals(Live l)
+        {
+            return ReferenceEquals(l.Ff9.player[l.P], l.OrigP) && ReferenceEquals(l.Ff9.party.member, l.Arr) && MemberRefsBack(l);
+        }
+
+        private static Boolean Empty(NetSyncSeatBracket b)
+        {
+            return !b._havePartySnapshot && b._realPlayer.Count == 0 && b._realMember == null;
+        }
+
+        // the record of a seat taken over the guest's own party: the probe's original and the four original slot references, nothing else
+        private static Boolean HoldsOriginals(NetSyncSeatBracket b, Live l)
+        {
+            PLAYER rec;
+            if (!b._havePartySnapshot || b._realPlayer.Count != 1 || !b._realPlayer.TryGetValue(l.P, out rec) || !ReferenceEquals(rec, l.OrigP))
+                return false;
+            if (b._realMember == null || b._realMember.Length != l.Before.Length)
+                return false;
+            for (Int32 i = 0; i < l.Before.Length; i++)
+                if (!ReferenceEquals(b._realMember[i], l.Before[i]))
+                    return false;
+            return true;
+        }
+
+        private static Int32 Rows(Rig r, Live l, List<String> fails)
+        {
+            Int32 n = 0;
+            Action<Boolean, String> row = (ok, name) => { n++; if (!ok) fails.Add(name); };
+
+            // ---- the bracket alone: the diorama's own cycle (Arm's snapshot, MirrorHostParty's install, Disarm's restore), then again
+            Reset(l);
+            NetSyncSeatBracket b = r.NewDiorama();
+            r.Snapshot(b);
+            r.Remember(b, l.P);
+            Install(l, new PLAYER());
+            r.Restore(b);
+            row(ReferenceEquals(l.Ff9.player[l.P], l.OrigP), "restore.dict_ref_back");
+            row(MemberRefsBack(l), "restore.member_refs_back");
+            row(ReferenceEquals(l.Ff9.party.member, l.Arr), "restore.member_array_kept");   // element-wise: BattleHUD holds this array
+            row(Empty(b), "restore.record_dropped");
+            PLAYER again = new PLAYER();
+            Install(l, again);
+            r.Restore(b);
+            row(SeatIs(l, again), "restore.second_is_noop");                                // idempotent: a dropped record writes nothing
+
+            // ---- first write wins: a re-entrant apply never buries the real object behind a scratch
+            Reset(l);
+            b = r.NewDiorama();
+            r.Snapshot(b);
+            r.Remember(b, l.P);
+            Install(l, new PLAYER());
+            r.Remember(b, l.P);                                                              // the dict holds the scratch now
+            Install(l, new PLAYER());
+            r.Restore(b);
+            row(ReferenceEquals(l.Ff9.player[l.P], l.OrigP), "remember.first_write_wins");
+
+            // ---- an unarmed bracket (no snapshot) records nothing and restores nothing
+            Reset(l);
+            b = r.NewDiorama();
+            r.Remember(b, l.P);
+            PLAYER loose = new PLAYER();
+            Install(l, loose);
+            r.Restore(b);
+            row(SeatIs(l, loose) && Empty(b), "restore.unarmed_writes_nothing");
+
+            // ---- the clear drops the record and WRITES NOTHING (Boot's failure paths: the party was never touched)
+            Reset(l);
+            b = r.NewDiorama();
+            r.Snapshot(b);
+            PLAYER later = new PLAYER();
+            Install(l, later);
+            r.Clear(b);
+            row(SeatIs(l, later), "clear.writes_nothing");
+            row(Empty(b), "clear.record_dropped");
+
+            // ---- GM0-BRACKET-CLEAR: the menu's instance holds a seat's record; the diorama instance's two failure clears run
+            Reset(l);
+            NetSyncSeatBracket dio = r.NewDiorama();
+            NetSyncSeatBracket menu = r.NewMenu(dio);
+            r.Snapshot(menu);
+            r.Remember(menu, l.P);
+            PLAYER seat = new PLAYER();
+            Install(l, seat);
+            r.Snapshot(dio);                     // the snapshot-failure clear (Boot: Arm, then `!_haveSnapshot`)
+            r.Clear(dio);
+            row(Empty(dio), "clear.snapfail.diorama_empty");
+            row(HoldsOriginals(menu, l), "clear.snapfail.menu_record_kept");
+            r.Snapshot(dio);                     // the failed-boot clear (Boot's catch: Restore(), then the clear)
+            r.Clear(dio);
+            row(Empty(dio), "clear.failboot.diorama_empty");
+            row(HoldsOriginals(menu, l), "clear.failboot.menu_record_kept");
+            row(SeatIs(l, seat), "clear.menu_seat_untouched");
+            r.Restore(menu);
+            row(Originals(l) && Empty(menu), "clear.menu_restores_originals");             // party.member ReferenceEquals the originals
+
+            // ---- GM0-BRACKET: no cross-restore. The diorama seated: the menu's restore (nothing held) writes nothing...
+            Reset(l);
+            dio = r.NewDiorama();
+            menu = r.NewMenu(dio);
+            r.Snapshot(dio);
+            r.Remember(dio, l.P);
+            PLAYER dioSeat = new PLAYER();
+            Install(l, dioSeat);
+            r.Restore(menu);
+            row(SeatIs(l, dioSeat) && HoldsOriginals(dio, l), "cross.menu_restore_leaves_diorama_seat");
+            r.DioRestore(dio, menu);
+            row(Originals(l) && Empty(dio), "cross.diorama_restores_its_own");
+            // ...and the menu seated: the diorama's teardown restore (Disarm's, nothing held) writes nothing
+            Reset(l);
+            dio = r.NewDiorama();
+            menu = r.NewMenu(dio);
+            r.Snapshot(menu);
+            r.Remember(menu, l.P);
+            PLAYER menuSeat = new PLAYER();
+            Install(l, menuSeat);
+            r.DioRestore(dio, menu);
+            row(SeatIs(l, menuSeat) && HoldsOriginals(menu, l), "cross.diorama_restore_leaves_menu_seat");
+            r.Restore(menu);
+            row(Originals(l) && Empty(menu), "cross.menu_restores_its_own");
+            return n;
+        }
+
+        // The mutants: each a plausible wrong bracket, one line, and the row that must catch it (MutantRows, in the same order).
+        private static Rig Mutant(String name)
+        {
+            Rig m = new Rig();
+            switch (name)
+            {
+                // the s167 statics' shape: one record for both owners (GM0-BRACKET-CLEAR: the diorama's failure clear erases the menu's record)
+                case "shared_instance": m.NewMenu = d => d; break;
+                // a teardown that restores every bracket "to be safe" (GM0-BRACKET: the diorama's Disarm restores the menu's seat)
+                case "disarm_restores_any": m.DioRestore = (d, mb) => { d.Restore(); mb.Restore(); }; break;
+                // a failure clear that restores (the party was never touched: a restore writes a stale snapshot over it)
+                case "clear_restores": m.Clear = b => b.Restore(); break;
+                // last write wins: a re-entrant apply buries the real object behind its own scratch
+                case "remember_last_wins": m.Remember = (b, id) => { PLAYER o; if (b._havePartySnapshot && FF9StateSystem.Common.FF9.player.TryGetValue(id, out o)) b._realPlayer[id] = o; }; break;
+                // a restore that keeps its record: the next restore writes the old originals over a later seat
+                case "restore_keeps_record": m.Restore = b => { if (!b._havePartySnapshot) return; foreach (KeyValuePair<CharacterId, PLAYER> kv in b._realPlayer) FF9StateSystem.Common.FF9.player[kv.Key] = kv.Value; if (b._realMember != null) Array.Copy(b._realMember, FF9StateSystem.Common.FF9.party.member, 4); }; break;
+                // a restore that swaps the array object (BattleHUD and every holder of the live array keep the scratches)
+                case "restore_replaces_array": m.Restore = b => { if (!b._havePartySnapshot) return; foreach (KeyValuePair<CharacterId, PLAYER> kv in b._realPlayer) FF9StateSystem.Common.FF9.player[kv.Key] = kv.Value; FF9StateSystem.Common.FF9.party.member = b._realMember; b._realPlayer.Clear(); b._realMember = null; b._havePartySnapshot = false; }; break;
+                // a snapshot of the live array itself, not its four references: the install writes through the record
+                case "snapshot_aliases_array": m.Snapshot = b => { b._realMember = FF9StateSystem.Common.FF9.party.member; b._realPlayer.Clear(); b._havePartySnapshot = true; }; break;
+            }
+            return m;
+        }
+
+        private static readonly String[] MutantNames = { "shared_instance", "disarm_restores_any", "clear_restores", "remember_last_wins",
+                                                         "restore_keeps_record", "restore_replaces_array", "snapshot_aliases_array" };
+        private static readonly String[] MutantRows = { "clear.snapfail.menu_record_kept", "cross.diorama_restore_leaves_menu_seat",
+                                                        "clear.writes_nothing", "remember.first_write_wins", "restore.second_is_noop",
+                                                        "restore.member_array_kept", "restore.member_refs_back" };
+
+        /// <summary>[ff9mapkit netsync s168] W1a THE PROOF: every row against the real bracket, then every mutant against the same rows (each must
+        /// fail its own row). `detail` = "N rows, M mutants caught" on success, else the first failing row or the mutant its row missed. The live
+        /// probe entry, the member array object and its references are put back after every pass. Never throws.</summary>
+        internal static Boolean SelfTest(out String detail)
+        {
+            try
+            {
+                Live l = Probe();
+                if (l == null)
+                {
+                    detail = "no PLAYER in ff9.player to probe";
+                    return false;
+                }
+                List<String> fails = new List<String>();
+                Int32 rows;
+                try { rows = Rows(new Rig(), l, fails); }
+                finally { Reset(l); }
+                if (fails.Count > 0)
+                {
+                    detail = "row " + fails[0] + " failed (" + fails.Count + " of " + rows + ")";
+                    return false;
+                }
+                if (MutantNames.Length != MutantRows.Length)
+                {
+                    detail = "the mutant table is ragged (" + MutantNames.Length + " names, " + MutantRows.Length + " rows)";
+                    return false;
+                }
+                Int32 caught = 0;
+                for (Int32 k = 0; k < MutantNames.Length; k++)
+                {
+                    List<String> mf = new List<String>();
+                    try { Rows(Mutant(MutantNames[k]), l, mf); }
+                    finally { Reset(l); }
+                    if (!mf.Contains(MutantRows[k]))
+                    {
+                        detail = "mutant " + MutantNames[k] + " was not caught by its row " + MutantRows[k]
+                                 + (mf.Count == 0 ? " (no row failed)" : " (it failed " + mf[0] + " instead)");
+                        return false;
+                    }
+                    caught++;
+                }
+                detail = rows + " rows, " + caught + " mutants caught";
+                return true;
+            }
+            catch (Exception err)
+            {
+                detail = "threw: " + err.GetType().Name + ": " + err.Message;
+                return false;
+            }
+        }
+    }
+}
