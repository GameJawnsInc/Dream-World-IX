+        //   bag       ff9.item IN ORDER, (id, count), an empty row (count 0) skipped as section 3 and NetFingerprint skip it
+        //   gil       party.gil
+        //   keyitems  rare_item_obtained, then rare_item_used, each in its own enumeration order (the writer's union with its two flags; the Key
+        //             Items screen draws that order)
+        // The names are `restore skip <component>`'s words: each restore family is one component, so a skipped family goes red and NAMES itself
+        // (decision 33's mutants). players is not wire-carried as a whole (the benched characters, bonus and permanent_status are never seated),
+        // so GM0-SEAT compares party, bag, gil and keyitems between seat_fp and host_fp.
+        internal const Int32 FpComps = 5;
+        internal const Int32 FpPlayers = 0, FpParty = 1, FpBag = 2, FpGil = 3, FpKeyItems = 4;
+        private static readonly String[] FpNames = { "players", "party", "bag", "gil", "keyitems" };
+
+        /// <summary>A component's name (the key's, the restore-skip lever's); null outside 0..FpComps-1.</summary>
+        internal static String FpCompName(Int32 comp)
+        {
