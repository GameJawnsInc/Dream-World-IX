+        private static GmFp FpOf(Rules r, FpState s)
+        {
+            GmFp f = new GmFp();
+            FingerprintOver(s.Players, s.Member, s.Bag, s.Obtained, s.Used, s.Gil, f.Comp, r.FpMut);
+            f.Value = r.FpValue(f.Comp);
+            f.Set = true;
+            return f;
+        }
+
+        // decision 12's seat of the host's party over the guest's state (a scratch PLAYER built for each host member, installed by reference into
+        // the dictionary AND the member array; a fresh bag, fresh key-item sets, gil by value; `bonus` not seated, so the scratch's stays zero),
+        // then decision 16's element-wise restore with ONE family skipped (`skip` = a component; -1 = none): the restore families ARE the
+        // components. Returns the component the verdict names after the restore (-1 = equal).
+        private static Int32 FpSeatRestore(Rules r, Int32 skip, out GmFp before, out GmFp seat)
+        {
+            FpState s = FpGuest();
+            FpState host = FpHost();
+            before = FpOf(r, s);
+            Dictionary<CharacterId, PLAYER> dictRecord = new Dictionary<CharacterId, PLAYER>(s.Players);   // the record: every original first
+            PLAYER[] memberRecord = (PLAYER[])s.Member.Clone();
+            List<FF9ITEM> bagRecord = s.Bag;
+            HashSet<Int32> obtainedRecord = s.Obtained, usedRecord = s.Used;
+            UInt32 gilRecord = s.Gil;
+            for (Int32 i = 0; i < 4; i++)
+            {
+                if (host.Member[i] == null)
+                    continue;
+                PLAYER scratch = FpProbePlayer((Int32)host.Member[i].info.slot_no, 60 + i);
+                scratch.bonus = new FF9LEVEL_BONUS();
+                s.Players[scratch.info.slot_no] = scratch;
+                s.Member[i] = scratch;
+            }
+            s.Bag = new List<FF9ITEM>(host.Bag);
+            s.Obtained = new HashSet<Int32>(host.Obtained);
+            s.Used = new HashSet<Int32>(host.Used);
+            s.Gil = host.Gil;
+            seat = FpOf(r, s);
+            if (skip != FpPlayers)
+            {
+                foreach (KeyValuePair<CharacterId, PLAYER> kv in dictRecord)
