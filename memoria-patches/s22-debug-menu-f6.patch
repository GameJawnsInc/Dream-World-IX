+    private static Color Col(Int32 r, Int32 g, Int32 b) { return new Color(r / 255f, g / 255f, b / 255f, 1f); }
+    private static Color Col(Int32 r, Int32 g, Int32 b, Single a) { return new Color(r / 255f, g / 255f, b / 255f, a); }
+
+    // A flat 1px-bordered (or solid) texture for panels/buttons/fields. Generated once, owned by _tex with
+    // HideAndDontSave so Unity never serializes or GCs them mid-frame. bordered = a 4x4 with a 1px edge, stretched
+    // 9-slice via the style's border RectOffset so the 1px frame stays crisp at any size.
+    private Texture2D MkTex(Color fill, Color border, Boolean bordered)
+    {
+        Int32 n = bordered ? 4 : 1;
+        Texture2D t = new Texture2D(n, n, TextureFormat.ARGB32, false);
+        t.hideFlags = HideFlags.HideAndDontSave;
+        t.filterMode = FilterMode.Point;
+        t.wrapMode = TextureWrapMode.Clamp;
+        for (Int32 y = 0; y < n; y++)
+            for (Int32 x = 0; x < n; x++)
+            {
+                Boolean edge = bordered && (x == 0 || y == 0 || x == n - 1 || y == n - 1);
+                t.SetPixel(x, y, edge ? border : fill);
+            }
+        t.Apply();
+        _tex.Add(t);
+        return t;
+    }
+
+    // Flat button style: fill + hover backgrounds, a 1px border, text color. stretchWidth so a lone button fills the
+    // row (like the stock skin button) while width-constrained buttons in a horizontal stay fixed.
+    private GUIStyle MkButton(Color fill, Color hover, Color border, Color text, Boolean bold)
+    {
+        Texture2D fillT = MkTex(fill, border, true);
+        Texture2D hoverT = MkTex(hover, border, true);
+        GUIStyle s = new GUIStyle(GUI.skin.button);           // inherit the skin's proper vertical text centering
+        s.fontSize = 14;
+        s.fontStyle = bold ? FontStyle.Bold : FontStyle.Normal;
+        s.alignment = TextAnchor.MiddleCenter;
+        s.border = new RectOffset(1, 1, 1, 1);
+        s.padding = new RectOffset(10, 10, 4, 4);
+        s.margin = new RectOffset(2, 2, 2, 2);
+        s.fixedHeight = 30f;                                  // uniform row height -> text (and sibling fields) line up
+        s.stretchWidth = true;
+        s.wordWrap = false;
+        s.normal.background = fillT;    s.normal.textColor = text;
+        s.hover.background = hoverT;    s.hover.textColor = text;
+        s.active.background = hoverT;   s.active.textColor = text;
+        s.focused.background = fillT;   s.focused.textColor = text;
+        s.onNormal.background = fillT;  s.onNormal.textColor = text;
+        return s;
+    }
+
+    private void EnsureStyles()
+    {
+        if (_box != null)
+            return;
+
+        Color window   = Col(0x14, 0x16, 0x1B, 0.97f);   // window bg
+        Color panel    = Col(0x1B, 0x1E, 0x26);          // button / readout bg
+        Color input    = Col(0x23, 0x27, 0x33);          // text-field bg
+        Color inputHi  = Col(0x2B, 0x30, 0x40);          // button hover
+        Color border   = Col(0x33, 0x3A, 0x4B);          // hairline / control border
+        Color headerBg = Col(0x1E, 0x32, 0x53);          // title-bar bg (accent-tinted)
+        Color text     = Col(0xE7, 0xE9, 0xEF);          // primary text
+        Color muted    = Col(0x7E, 0x86, 0x9B);          // secondary text / hints
+        Color accent   = Col(0x9C, 0xC4, 0xFF);          // the one accent
+        Color accentBg = Col(0x23, 0x2C, 0x40);          // accent button/tab bg
+        Color accentHi = Col(0x2A, 0x36, 0x50);          // accent hover
+        Color accentBd = Col(0x40, 0x56, 0x7F);          // accent border
+        Color danger   = Col(0xFF, 0x9B, 0x9B);          // destructive text
+        Color dangerBg = Col(0x2A, 0x20, 0x22);
+        Color dangerHi = Col(0x36, 0x28, 0x2A);
+        Color dangerBd = Col(0x5A, 0x3A, 0x3A);
+
+        _hairlineTex = MkTex(border, border, false);
+
+        _box = new GUIStyle();
+        _box.normal.background = MkTex(window, border, true);
+        _box.border = new RectOffset(1, 1, 1, 1);
+        _box.padding = new RectOffset(9, 9, 8, 9);
+
+        _headerBar = new GUIStyle();
+        _headerBar.normal.background = MkTex(headerBg, headerBg, false);
+        _headerBar.padding = new RectOffset(9, 8, 7, 7);
+        _headerBar.margin = new RectOffset(0, 0, 0, 2);
+
+        _title = new GUIStyle(GUI.skin.label);
+        _title.fontSize = 17;
+        _title.fontStyle = FontStyle.Bold;
+        _title.normal.textColor = accent;
+
+        _subtitle = new GUIStyle(GUI.skin.label);
+        _subtitle.fontSize = 12;
+        _subtitle.normal.textColor = muted;
+
+        _header = new GUIStyle(GUI.skin.label);
+        _header.fontSize = 13;
+        _header.normal.textColor = muted;
+        _header.margin = new RectOffset(0, 0, 2, 1);
+
+        _label = new GUIStyle(GUI.skin.label);
+        _label.fontSize = 14;
+        _label.normal.textColor = text;
+        _label.wordWrap = true;
+
+        _hint = new GUIStyle(GUI.skin.label);
+        _hint.fontSize = 12;
+        _hint.normal.textColor = muted;
+        _hint.wordWrap = true;
+
+        _mono = new GUIStyle(GUI.skin.label);          // boxed readout (world pos / story state)
+        _mono.fontSize = 13;
+        _mono.normal.textColor = muted;
+        _mono.wordWrap = true;
+        _mono.border = new RectOffset(1, 1, 1, 1);
+        _mono.padding = new RectOffset(8, 8, 6, 6);
+        _mono.normal.background = MkTex(panel, border, true);
+
+        _statusStyle = new GUIStyle(GUI.skin.label);
+        _statusStyle.fontSize = 12;
+        _statusStyle.normal.textColor = accent;
+        _statusStyle.wordWrap = true;
+        _statusStyle.margin = new RectOffset(2, 2, 4, 2);
+
+        _field = new GUIStyle(GUI.skin.textField);
+        _field.fontSize = 14;
+        _field.border = new RectOffset(1, 1, 1, 1);
+        _field.padding = new RectOffset(8, 8, 4, 4);
+        _field.margin = new RectOffset(2, 2, 2, 2);
+        _field.alignment = TextAnchor.MiddleLeft;            // vertically center the input text
+        _field.fixedHeight = 30f;                            // match the buttons so a row's field + buttons line up
+        _field.normal.background = MkTex(input, border, true);
+        _field.normal.textColor = text;
+        _field.hover.background = MkTex(input, border, true);          // theme hover/active too (else they inherit the stock skin art)
+        _field.hover.textColor = text;
+        _field.focused.background = MkTex(input, accentBd, true);
+        _field.focused.textColor = text;
+        _field.active.background = MkTex(input, accentBd, true);
+        _field.active.textColor = text;
+
+        _button  = MkButton(panel, inputHi, border, text, false);
+        _primary = MkButton(accentBg, accentHi, accentBd, accent, true);
+        _danger  = MkButton(dangerBg, dangerHi, dangerBd, danger, false);
+        _tabOn   = MkButton(accentBg, accentHi, accentBd, accent, true);
+        _tabOff  = MkButton(panel, inputHi, panel, muted, false);
+
+        _iconBtn = MkButton(headerBg, accentHi, headerBg, muted, false);
+        _iconBtn.fontSize = 18;
+        _iconBtn.stretchWidth = false;
+        _iconBtn.padding = new RectOffset(4, 4, 0, 2);
+
+        _toggleBtn = MkButton(window, panel, window, text, false);   // borderless-looking (border == window bg)
+        _toggleBtn.alignment = TextAnchor.MiddleLeft;
+
+        // Use the live FFIX UI font (TBUDGoStd via EncryptFontManager — the same Font UILabel renders with) so the menu
+        // matches the game. It loads lazily; if null here, OnGUI retries and applies it once available. Falls back to the
+        // default IMGUI font if the font system is disabled/unavailable.
+        _ff9Font = FontForChoice(_fontChoice);
+        if (_ff9Font != null)
+            ApplyFont(_ff9Font);
+    }
+
+    // Load FF9's Alexandria font from the encrypted font bundle. The game only ever instantiates TBUDGoStd (via
+    // EncryptFontManager), so we replicate its decrypt + bundle-load to get Alexandria. Done once — a fresh
+    // AssetBundle.LoadAsset keeps the Font alive after Unload(false). Alexandria is a dynamic TTF -> scales to any size.
+    private void EnsureBundledFonts()
+    {
+        if (_fontCache.Count > 0 || _bundledFontsTried)
+            return;
+        _bundledFontsTried = true;                            // attempt EXACTLY once -> never re-decrypt 3.7MB per frame on failure
+        try
+        {
+            String path = "EmbeddedAsset/FA/" + AssetManagerUtil.GetPlatformPrefix(Application.platform) + "_fa.mpc";
+            Byte[] enc = AssetManager.LoadBytes(path, true);
+            if (enc == null)
+                return;
+            AssetBundle bundle = AssetBundle.CreateFromMemoryImmediate(ByteEncryption.Decryption(enc));
+            if (bundle == null)
+                return;
+            _fontCache[0] = bundle.LoadAsset<Font>("Alexandria");
+            bundle.Unload(false);                            // keep the loaded Font object; free the bundle data
+            UnityEngine.Object.DestroyImmediate(bundle);     // destroy the wrapper too (matches EncryptFontManager; Font survives)
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    // The Font for a picker index (0 = Alexandria; anything else = the built-in IMGUI font -> null).
+    private Font FontForChoice(Int32 i)
+    {
+        if (i != 0)
+            return null;
+        EnsureBundledFonts();
+        Font f;
+        return _fontCache.TryGetValue(0, out f) ? f : null;
+    }
+
+    // Switch + persist the menu font and re-skin every built style live (no reopen needed).
+    private void SetFontChoice(Int32 i)
+    {
+        _fontChoice = i;
+        try { PlayerPrefs.SetInt(PrefFont, i); PlayerPrefs.Save(); } catch (Exception) { }
+        if (i == 0 && _fontCache.Count == 0)                 // a prior auto-load failed -> let an explicit pick retry it
+            _bundledFontsTried = false;
+        _ff9Font = FontForChoice(i);
+        ApplyFont(_ff9Font);                                 // null -> styles fall back to the built-in default font
+    }
+
+    // Assign a font to every built style (called once when the FFIX font first becomes available).
+    private void ApplyFont(Font f)
+    {
+        GUIStyle[] all = { _box, _headerBar, _title, _subtitle, _header, _label, _hint, _mono, _statusStyle,
+                           _button, _primary, _danger, _field, _tabOn, _tabOff, _iconBtn, _toggleBtn };
+        foreach (GUIStyle s in all)
+            if (s != null)
+                s.font = f;
+    }
+}
