+using System;
+using System.Collections.Generic;
+using Assets.Scripts.Common;        // SceneDirector (FF9Wipe_FadeOutEx -- the warp fade-to-black)
+using Memoria.Data;
+using UnityEngine;
+
+// [ff9mapkit dev] One in-game debug menu (toggled by F6 from UIKeyTrigger, in FIELD or BATTLE) -- dev actions on ONE key +
+// a tabbed popup instead of one-hotkey-per-function. IMGUI/OnGUI overlay (the proven in-engine pattern,
+// cf. OnScreenLog / the FieldCreator editor), self-bootstrapping persistent MonoBehaviour so it is
+// always alive to receive OnGUI. Dev engine only; never part of the shipped mod.
+//
+// Tabs:
+//   Warp   -- reload the current field; warp to any REGISTERED custom field (eventIDToFBGID id>=4000)
+//             or a typed id -> hop between per-branch slots (4003/5000/5001) live. PIN any id (star button)
+//             into a persisted Favorites list surfaced at the top for one-click warps (PlayerPrefs, survives relaunch).
+//   Move   -- read the player pos / teleport to a typed (x,z); RIGHT-CLICK the field to copy the floor
+//             (x,z) under the cursor to the clipboard (reuses FF9's own click-to-move math).
+//   Cheats -- boosters (the F1-F4 toggles) + full-heal party + give item/gil.
+//   Flags  -- get/set/clear a gEventGlobal story flag (matches the kit's set_flag: VariableType.Bit ->
+//             gEventGlobal[N>>3] bit N&7); snapshot/restore the whole flag state; reset-all.
+//   Time   -- a time-scale control (slow-mo / fast) for inspecting cutscenes & movement.
+//   World  -- OVERWORLD only: WARP overworld->field via the game's own transition (also the reliable escape if an
+//             entrance leaves you stuck); RESTORE control (unfreeze) if a script left you frozen; swap the
+//             movement/vehicle mode (gEventGlobal[190] + w_movementChange) so you can walk/fly/sail onto any
+//             terrain to reach an entrance under test (swaps the PROFILE onto the current character -- Zidane keeps
+//             his model; GATED per world state: only modes the loaded EVT_WORLD_WORLDxx dispatcher handles are
+//             offered, forcing an unhandled one crashes the event script); teleport within the map; disc switch.
+// The "Disable control" checkbox (freeze the character while the menu is open) and the Warp Favorites persist across
+// launches via PlayerPrefs (keys "ff9mk_debug_*"); the checkbox now defaults OFF.
+// Header shows the current field id + name + the player's (x,z), live (or the disc + vehicle mode on the overworld).
+// Adding an action = one button.
+public class Ff9mkDebugMenu : MonoBehaviour
+{
+    private static Ff9mkDebugMenu _instance;
+    private Boolean _open;
+    private Boolean _priorControl;          // user-control state to restore when the hold is released
+    private Boolean _disableControl;        // "Disable control" checkbox: pause player input while the menu is open.
+                                            // Defaults OFF (persisted; see LoadPrefs) -- the character keeps moving behind
+                                            // the popup unless you tick it. (Was on-by-default; flipped per user request.)
+    private Boolean _controlHeld;           // whether user control is CURRENTLY held off by us (so we restore exactly once)
+
+    // [ff9mapkit] Persisted debug prefs (PlayerPrefs, Memoria's own settings store -- survives relaunch, per-machine).
+    // Favorites: ONE combined list of pinned destinations -- a field WARP (id) OR an overworld SPOT teleport (world x,z)
+    // -- surfaced as one-click buttons at the top of BOTH the Warp and World tabs (context decides what a click does).
+    private struct Pin
+    {
+        public Boolean World;   // false = field warp (A = field id); true = overworld teleport (A = world X, B = world Z)
+        public Int32 A;
+        public Int32 B;
+        public Pin(Boolean world, Int32 a, Int32 b) { this.World = world; this.A = a; this.B = b; }
+        public String Encode() { return this.World ? ("w:" + this.A + ":" + this.B) : ("f:" + this.A); }
+        public Boolean Same(Pin o) { return this.World == o.World && this.A == o.A && (!this.World || this.B == o.B); }
+    }
+    private readonly List<Pin> _pins = new List<Pin>();
+    private Boolean _prefsLoaded;                                   // LoadPrefs is idempotent (load once, lazily)
+    private const String PrefFavorites = "ff9mk_debug_favorites";   // CSV of tokens: "f:<id>" warp / "w:<x>:<z>" spot (legacy bare int = warp)
+    private const String PrefDisableControl = "ff9mk_debug_disable_control"; // 0/1
+    private const String PrefFont = "ff9mk_debug_font";          // menu font index (into FontChoices)
+    // Alexandria is FF9's own UI font, bundled (encrypted) by Memoria in EmbeddedAsset/FA; the game never instantiates
+    // it (it loads TBUDGoStd), so we load it straight from the bundle. "System" = the built-in IMGUI font.
+    private static readonly String[] FontChoices = { "Alexandria", "System" };
+
+    private Rect _win = new Rect(24f, 24f, 580f, 640f);
+    private Vector2 _scroll;
+    private Int32 _tab;
+    private String _warpText = "5000";
+    private String _entranceText = "";       // [ff9mapkit] optional arrival entrance for the warp (blank = leave FieldEntrance as-is)
+    private String _scenarioText = "";       // [ff9mapkit] optional ScenarioCounter to set before the warp (blank = leave as-is) -- seed a story beat to reach a story-gated fork
+    private String _fieldFilter = "";        // [ff9mapkit] Go tab: substring filter for the registered-fields list (a verbatim fork can register ~500)
+    private String _txText = "0";
+    private String _tzText = "0";
+    private String _wxText = "0";       // [ff9mapkit] overworld teleport target X (world units), World tab
+    private String _wzText = "0";       // [ff9mapkit] overworld teleport target Z (world units, NEGATIVE going down the grid)
+    private Boolean _worldBoxesInit;    // auto-fill the teleport boxes with the live pos on the first World-tab draw (avoids the 0,0 ocean-corner default)
+    private String _flagText = "8000";
+    private String _itemText = "236";       // a Potion, by default
+    private String _itemCountText = "1";
+    private String _gilText = "10000";
+    private Byte[] _snapshot;                // saved gEventGlobal (flag snapshot/restore)
+    private String _status = "";
+
+    // Deferred FADED warp: a bare F6 Field() warp transitions with the source field still drawn, so the
+    // destination loads in the clear and you SEE its smooth-camera ease onto the spawn (the "warp-in drift"
+    // that made debug warps look broken next to the clean shipping entry). Real gateways + the New-Game
+    // field-70 entry fade to BLACK first, so the destination loads black and its reveal + [camera]
+    // entry_settle hide the settle. So the F6 warp now does the same: fade out, wait for it, THEN change map.
+    private const Int32 WarpFadeFrames = 24;     // FF9Wipe fade-out duration (matches the gateway FadeFilter)
+    private const Single WarpFadeWait = 0.9f;    // seconds to let the fade finish before the map change
+    private Int32 _pendingWarpMap = -1;          // >= 0 while a faded warp is in flight
+    private Int32 _pendingWarpEntrance = -1;     // [ff9mapkit] >= 0 -> set FieldEntrance before the map change (faithful gateway arrival)
+    private Int32 _pendingWarpScenario = -1;     // [ff9mapkit] >= 0 -> set ScenarioCounter before the map change (seed a story beat)
+    private Single _pendingWarpTimer;
+    private Boolean _pendingWarpReset;
+
+    private const Int32 WinId = 0x4F9DEB;
+    // One context-adaptive "Go" tab (warp / teleport / — on the overworld — vehicle / disc / restore control) replaces the
+    // old Warp + Move + World trio (two of which were always a dead "field only / overworld only" note). Cheats/Flags/Time stay.
+    private static readonly String[] Tabs = { "Go", "Cheats", "Flags", "Time" };
+    private static readonly Single[] Speeds = { 0.25f, 0.5f, 1f, 2f, 4f };
+
+    // lazily-built styling (flat dark theme, one blue accent — built once in EnsureStyles from generated textures)
+    private GUIStyle _box, _headerBar, _title, _subtitle, _header, _label, _hint, _mono, _statusStyle,
+                     _button, _primary, _danger, _field, _tabOn, _tabOff, _iconBtn, _toggleBtn;
+    private Texture2D _hairlineTex;
+    private Font _ff9Font;                               // the active menu font, applied to every style (null = built-in default)
+    private Int32 _fontChoice;                           // index into FontChoices: 0 = Alexandria (bundled), 1 = System (built-in)
+    private readonly Dictionary<Int32, Font> _fontCache = new Dictionary<Int32, Font>();   // Alexandria, loaded once from the bundle
+    private Boolean _bundledFontsTried;                  // guard: attempt the (one-time) bundle decrypt+load exactly once
+    private Boolean _showWarpOpts;                       // Go tab: hide the advanced warp fields (entrance/scenario) behind "more options"
+    private readonly List<Texture2D> _tex = new List<Texture2D>();   // own the generated textures (never serialized)
+
+    public static void Toggle()
+    {
+        Ensure();
+        _instance.LoadPrefs();                       // idempotent; ensures the persisted "Disable control" default is applied
+        _instance.SetOpen(!_instance._open);
+    }
+
+    // [ff9mapkit] Load the persisted debug prefs once (favorites + the "Disable control" default). PlayerPrefs is
+    // Memoria's own settings store (cf. UISavedOption / UIInput) -- on Windows it lives in the registry, so it
+    // survives a relaunch. Robust to a missing/garbage value (defaults: control OFF, no favorites).
+    private void LoadPrefs()
+    {
+        if (_prefsLoaded)
+            return;
+        _prefsLoaded = true;
+        try
+        {
+            _disableControl = PlayerPrefs.GetInt(PrefDisableControl, 0) != 0;   // default 0 = OFF
+            _fontChoice = PlayerPrefs.GetInt(PrefFont, 0);                      // default 0 = Alexandria (FF9's menu font)
+            if (_fontChoice < 0 || _fontChoice > 1)
+                _fontChoice = 0;
+            _pins.Clear();
+            foreach (String tok in PlayerPrefs.GetString(PrefFavorites, "").Split(','))
+            {
+                Pin pin;
+                if (TryDecodePin(tok.Trim(), out pin) && !PinsContains(pin))
+                    _pins.Add(pin);
+            }
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    private void SaveFavorites()
+    {
+        try
+        {
+            String[] parts = new String[_pins.Count];
+            for (Int32 i = 0; i < _pins.Count; i++)
+                parts[i] = _pins[i].Encode();
+            PlayerPrefs.SetString(PrefFavorites, String.Join(",", parts));
+            PlayerPrefs.Save();
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    // Decode one stored token: "f:<id>" (field warp), "w:<x>:<z>" (overworld spot), or a legacy bare "<id>" (field warp).
+    private static Boolean TryDecodePin(String tok, out Pin pin)
+    {
+        pin = new Pin(false, 0, 0);
+        if (String.IsNullOrEmpty(tok))
+            return false;
+        String[] p = tok.Split(':');
+        if (p.Length == 1 && Int32.TryParse(p[0], out Int32 legacy))              // legacy bare id -> field warp
+        {
+            pin = new Pin(false, legacy, 0);
+            return true;
+        }
+        if (p.Length == 2 && p[0] == "f" && Int32.TryParse(p[1], out Int32 fid))  // field warp
+        {
+            pin = new Pin(false, fid, 0);
+            return true;
+        }
+        if (p.Length == 3 && p[0] == "w" && Int32.TryParse(p[1], out Int32 wx) && Int32.TryParse(p[2], out Int32 wz)) // overworld spot
+        {
+            pin = new Pin(true, wx, wz);
+            return true;
+        }
+        return false;
+    }
+
+    private Boolean PinsContains(Pin pin)
+    {
+        foreach (Pin p in _pins)
+            if (p.Same(pin))
+                return true;
+        return false;
+    }
+
+    private Boolean HasFieldPin(Int32 id) { return PinsContains(new Pin(false, id, 0)); }
+    private Boolean HasWorldPin(Int32 x, Int32 z) { return PinsContains(new Pin(true, x, z)); }
+
+    private void SaveDisableControlPref()
+    {
+        try
+        {
+            PlayerPrefs.SetInt(PrefDisableControl, _disableControl ? 1 : 0);
+            PlayerPrefs.Save();
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    // Pin/unpin a destination in the combined favorites (toggle): remove an equal pin if present, else append it.
+    private void TogglePin(Pin pin)
+    {
+        for (Int32 i = 0; i < _pins.Count; i++)
+            if (_pins[i].Same(pin))
+            {
+                _pins.RemoveAt(i);
+                SaveFavorites();
+                return;
+            }
+        _pins.Add(pin);
+        SaveFavorites();
+    }
+
+    private void RemovePin(Pin pin)
+    {
+        for (Int32 i = 0; i < _pins.Count; i++)
+            if (_pins[i].Same(pin))
+            {
+                _pins.RemoveAt(i);
+                SaveFavorites();
+                return;
+            }
+    }
+
+    private void ToggleFavorite(Int32 id)                    // field-warp pin (a registered-field row)
+    {
+        TogglePin(new Pin(false, id, 0));
+    }
+
+    private void ToggleFavoriteFromText(String text)         // field-warp pin from a typed field id
+    {
+        if (Int32.TryParse(text, out Int32 id))
+            TogglePin(new Pin(false, id, 0));
+        else
+            _status = "pin: enter a numeric field id first";
+    }
+
+    private void ToggleWorldPinFromText(String xText, String zText)   // overworld-spot pin from the world X,Z boxes
+    {
+        // Parse as Single to match the teleport's Go (WorldTeleport uses Single.TryParse); pins are integer-encoded in
+        // the "w:<x>:<z>" token, so round to the stored int (the ~1/256-unit loss is immaterial on a 1536-unit grid).
+        if (Single.TryParse(xText, out Single x) && Single.TryParse(zText, out Single z))
+            TogglePin(new Pin(true, (Int32)Math.Round(x), (Int32)Math.Round(z)));
+        else
+            _status = "pin: enter numeric world X, Z first";
+    }
+
+    private static String FieldName(Int32 id)
+    {
+        String name;
+        return EventEngineUtils.eventIDToFBGID.TryGetValue(id, out name) ? name : "?";
+    }
+
+    // Draw the ONE combined favorites list (field warps + overworld spots) as one-click buttons (+ unpin). `world` is the
+    // current context (World tab vs a field tab): a field-warp pin warps via the right path for the context; an
+    // overworld-spot pin teleports on the world map and is GREYED on a field tab (you can't world-teleport off the
+    // overworld). Iterates a COPY so unpin-mid-draw is safe.
+    private void DrawFavorites(Boolean world)
+    {
+        if (_pins.Count == 0)
+            return;
+        Section("* Favorites (click to go)");
+        List<Pin> pins = new List<Pin>(_pins);
+        foreach (Pin pin in pins)
+        {
+            GUILayout.BeginHorizontal();
+            if (pin.World)
+            {
+                Boolean prev = GUI.enabled;
+                GUI.enabled = world;                                       // overworld teleport is only usable on the world map
+                if (GUILayout.Button("world (" + pin.A + ", " + pin.B + ")", _button))
+                    WorldTeleportTo(pin.A, pin.B);
+                GUI.enabled = prev;
+            }
+            else if (GUILayout.Button(pin.A + "   " + FieldName(pin.A), _button))
+            {
+                if (world)
+                    WorldWarp(pin.A);
+                else
+                    Warp(pin.A, false);
+            }
+            if (GUILayout.Button("unpin", _button, GUILayout.Width(56f)))
+                RemovePin(pin);
+            GUILayout.EndHorizontal();
+        }
+    }
+
+    public static Boolean IsOpen
+    {
+        get { return _instance != null && _instance._open; }
+    }
+
+    // The menu is allowed in field AND battle (UIKeyTrigger's F6 gate). In battle the field-only tabs
+    // (Warp/Move) no-op, so they show a note; Cheats/Flags/Time operate on the shared party/flag/time state.
+    private static Boolean InBattle
+    {
+        get { return PersistenSingleton<UIManager>.Instance.State == UIManager.UIState.BattleHUD; }
+    }
+
+    // The OVERWORLD (world map) state. The World tab operates here; the field-only tabs (Warp/Move) no-op with a
+    // note, and vehicle-mode swap is refused off the world map.
+    private static Boolean InWorld
+    {
+        get { return PersistenSingleton<UIManager>.Instance.State == UIManager.UIState.WorldHUD; }
+    }
+
+    private static void Ensure()
+    {
+        if (_instance != null)
+            return;
+        GameObject go = new GameObject("Ff9mkDebugMenu");
+        UnityEngine.Object.DontDestroyOnLoad(go);
+        _instance = go.AddComponent<Ff9mkDebugMenu>();
+    }
+
+    // Open/close the menu, PAUSING field input while open (save the current user-control state, disable
+    // it, restore on a plain close) so the d-pad + the Use(!)/action button don't drive the field behind
+    // the popup. A warp/reload action instead closes the menu directly -- the field transition itself
+    // re-establishes control -- so it does not restore here.
+    private void SetOpen(Boolean open)
+    {
+        if (open == _open)
+            return;
+        // Control hold is governed by the "Disable control" checkbox (drawn at the top of the window). On open apply
+        // it; on close ALWAYS release so the player is never left frozen. NOTE: the OVERWORLD teleport wants control
+        // LIVE to stick -- uncheck "Disable control" before teleporting on the world map.
+        ApplyControlHold(open && _disableControl);
+        _open = open;
+    }
+
+    // Pause/resume EventEngine user control (so the d-pad / action button don't drive the character behind the popup).
+    // Idempotent via _controlHeld: we capture the prior state once when first holding, and restore it once when releasing.
+    private void ApplyControlHold(Boolean wantHold)
+    {
+        try
+        {
+            EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+            if (wantHold && !_controlHeld)
+            {
+                _priorControl = ee.GetUserControl();
+                ee.SetUserControl(false);
+                _controlHeld = true;
+            }
+            else if (!wantHold && _controlHeld)
+            {
+                ee.SetUserControl(_priorControl);
+                _controlHeld = false;
+            }
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    private void Update()
+    {
+        ServicePendingWarp();                    // drive the deferred faded warp (fade out -> map change)
+        // While the menu is open, RIGHT-CLICK the field to copy the world (x, z) under the cursor (to
+        // the clipboard + the Go tab teleport boxes) -- handy for placing NPCs/zones/spawns in a field.toml.
+        if (_open && Input.GetMouseButtonDown(1))
+            PickPoint();
+    }
+
+    private void OnGUI()
+    {
+        if (!_open)
+            return;
+        EnsureStyles();
+        // The FFIX font (EncryptFontManager) loads lazily; if it wasn't ready when styles were first built, pick it up now.
+        if (_ff9Font == null && _fontChoice == 0)               // bundle may not have been ready when styles were first built
+        {
+            Font f = FontForChoice(_fontChoice);
+            if (f != null) { _ff9Font = f; ApplyFont(f); }
+        }
+        Single scale = Mathf.Max(1f, Screen.height / 800f);     // legible at 1080p / 1440p / 4K
+        Matrix4x4 prev = GUI.matrix;
+        GUI.matrix = Matrix4x4.Scale(new Vector3(scale, scale, 1f));
+        _win.height = Mathf.Min(760f, Screen.height / scale - 40f);
+        _win = GUI.Window(WinId, _win, DrawWindow, GUIContent.none, _box);
+        GUI.matrix = prev;
+    }
+
+    private void DrawWindow(Int32 id)
+    {
+        // Header bar: title + live context (field id/name/pos, or battle, or overworld disc/mode) + a × close.
+        GUILayout.BeginHorizontal(_headerBar);
+        GUILayout.BeginVertical();
+        GUILayout.Label("FF9 debug", _title);
+        GUILayout.Label(CurrentInfo(), _subtitle);
+        GUILayout.EndVertical();
+        GUILayout.FlexibleSpace();
+        if (GUILayout.Button("×", _iconBtn, GUILayout.Width(34f)))
+            SetOpen(false);
+        GUILayout.EndHorizontal();
+
+        // "Disable control": freeze player input while the menu is up. [x]/[ ] rather than a skin checkbox so it renders
+        // identically across fonts; defaults OFF (persisted). The overworld teleport wants control LIVE, so leave it off there.
+        GUILayout.Space(4f);
+        if (GUILayout.Button((_disableControl ? "[x]  " : "[  ]  ") + "Disable control", _toggleBtn))
+        {
+            _disableControl = !_disableControl;
+            SaveDisableControlPref();
+            ApplyControlHold(_disableControl);
+        }
+
+        GUILayout.BeginHorizontal();                            // font picker (Alexandria/Garnet = FF9's own bundled UI fonts)
+        GUILayout.Label("Font", _hint, GUILayout.Width(40f));
+        for (Int32 fi = 0; fi < FontChoices.Length; fi++)
+            if (GUILayout.Button(FontChoices[fi], fi == _fontChoice ? _tabOn : _tabOff))
+                SetFontChoice(fi);
+        GUILayout.EndHorizontal();
+
+        GUILayout.Space(6f);
+        GUILayout.BeginHorizontal();                            // tab pills
+        for (Int32 i = 0; i < Tabs.Length; i++)
+            if (GUILayout.Button(Tabs[i], i == _tab ? _tabOn : _tabOff))
+                _tab = i;
+        GUILayout.EndHorizontal();
+        GUILayout.Space(2f);
+
+        _scroll = GUILayout.BeginScrollView(_scroll);
+        switch (_tab)
+        {
+            case 0: DrawGo(); break;                            // context-adaptive: field warp/teleport, or overworld nav
+            case 1: DrawCheats(); break;
+            case 2: DrawFlags(); break;
+            default: DrawTime(); break;
+        }
+        GUILayout.EndScrollView();
+
+        if (_status.Length > 0)
+            GUILayout.Label(_status, _statusStyle);
+        GUI.DragWindow(new Rect(0f, 0f, 10000f, 34f));          // drag by the header
+    }
+
+    // ------------------------------------------------------------------- tabs
+    // The context-adaptive navigation tab (replaces the old Warp + Move + World trio). Field: warp + teleport + reload +
+    // registered list. Overworld: warp + world-teleport + vehicle + disc + restore control. Battle: a short note.
+    private void DrawGo()
+    {
+        if (InBattle)
+        {
+            GUILayout.Label("Cheats, Flags and Time work in battle. Warp and teleport need a field or the overworld.", _hint);
+            return;
+        }
+        if (InWorld)
+        {
+            DrawGoWorld();
+            return;
+        }
+        DrawGoField();
+    }
+
+    private void DrawGoField()
+    {
+        DrawFavorites(false);                                   // combined pins (world spots greyed off the overworld)
+
+        Section("Warp to field");
+        GUILayout.BeginHorizontal();
+        _warpText = GUILayout.TextField(_warpText, 6, _field, GUILayout.Width(88f));
+        if (GUILayout.Button("Go", _primary, GUILayout.Width(46f)))
+            WarpTo(_warpText);
+        Boolean favTyped = Int32.TryParse(_warpText, out Int32 typedId) && HasFieldPin(typedId);
+        if (GUILayout.Button(favTyped ? "*" : "+", favTyped ? _tabOn : _button, GUILayout.Width(30f)))
+            ToggleFavoriteFromText(_warpText);
+        GUILayout.FlexibleSpace();
+        if (GUILayout.Button(_showWarpOpts ? "hide options" : "more options", _button, GUILayout.Width(96f)))
+            _showWarpOpts = !_showWarpOpts;
+        GUILayout.EndHorizontal();
+        if (_showWarpOpts)                                      // advanced: arrival entrance + story-beat seed (rarely needed)
+        {
+            GUILayout.BeginHorizontal();
+            GUILayout.Label("arrive via entrance", _label, GUILayout.Width(128f));
+            _entranceText = GUILayout.TextField(_entranceText, 4, _field, GUILayout.Width(52f));
+            GUILayout.EndHorizontal();
+            GUILayout.BeginHorizontal();
+            GUILayout.Label("set scenario", _label, GUILayout.Width(128f));
