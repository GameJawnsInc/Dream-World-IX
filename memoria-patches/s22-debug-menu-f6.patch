+            _wxText = ((Int32)wp.x).ToString();
+            _wzText = ((Int32)wp.z).ToString();
+            GUIUtility.systemCopyBuffer = (Int32)wp.x + ", " + (Int32)wp.z;
+            _status = "copied world (" + (Int32)wp.x + ", " + (Int32)wp.z + ") -> boxes + clipboard";
