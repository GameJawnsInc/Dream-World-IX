+    // Live overworld state read-out (read-only). RealPosition = ABSOLUTE (un-wrapped) world pos, the value the
+    // minimap + w_frameGetParameter use; cells are 32u (z divides by -32); block = InitialX/Y content identity vs
+    // CurrentX/Y wrapped screen slot; IDALL/topograph under the player via m_moveActorID. w_moveActorPtr overrides
+    // Unity ==, so guard with the (UnityEngine.Object)null form (and originalActor separately — m_moveActorID
+    // doesn't guard it).
+    private static String WorldReadout()
+    {
+        try
+        {
+            WMActor a = ff9.w_moveActorPtr;
+            if (a == (UnityEngine.Object)null || a.originalActor == null)
+                return "(no controlled actor yet)";
+            Vector3 wp = a.RealPosition;
+            Int32 cellX = (Int32)(wp.x / 32f);
+            Int32 cellZ = (Int32)(wp.z / -32f);
+            Int32 idall = ff9.m_moveActorID;
+            Int32 ev = ff9.m_GetIDEvent(idall), area = ff9.m_GetIDArea(idall), topo = ff9.m_GetIDTopograph(idall);
+            String blk = "blk (--)";
+            WMWorld w = ff9.world;
+            if (w != null)
+            {
+                WMBlock b = w.GetAbsoluteBlock(a.transform);
+                if (b != null)
+                    blk = String.Format("blk init({0},{1}) cur({2},{3})", b.InitialX, b.InitialY, b.CurrentX, b.CurrentY);
+            }
+            return String.Format(
+                "pos ({0:F0}, {1:F0}, {2:F0})   cell ({3}, {4})\n{5}\nIDALL 0x{6:X4}   ev {7}  area {8}  topo {9}",
+                wp.x, wp.y, wp.z, cellX, cellZ, blk, idall, ev, area, topo);
+        }
+        catch (Exception e)
+        {
+            return "readout unavailable: " + e.Message;
+        }
+    }
