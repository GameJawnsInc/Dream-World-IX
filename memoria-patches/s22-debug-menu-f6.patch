+    // [ff9mapkit] Per-world-state vehicle allow-list. Each overworld state runs a DIFFERENT EVT_WORLD_WORLDxx
+    // event-script dispatcher (wldMapNo 9000+N -> WORLD00..12). BOARDING a vehicle sets gEventGlobal[190] AND
+    // the per-vehicle NAV state (Map.Byte[24/25/26]) together; the F6 swap pokes ONLY the byte. So on any state
+    // whose per-frame vehicle switch has real nav arms (chocobo / air / boat), forcing a mode -- even one the
+    // game legitimately uses there -- drives that arm on uninitialised nav state -> a CalcStack expression
+    // underflow ("[CalcStack.pop] topOfStackID == 0", spammed per-frame) -> crash. In-game proven: on WORLD00,
+    // BOTH chocobo (1-5) and airship (7-9) crash; only foot (0) is safe. The ONLY states where a swap is safe
+    // are the BENIGN ones whose vehicle switch sends every non-foot mode to an idle Wait->loop default (no nav
+    // arm): WORLD02/10/11 -- there the swap is a safe no-op and the C# movement profile still changes, so all
+    // modes work (WORLD11 in-game proven). Everywhere else -> foot only. (To reach a test entrance on a gated
+    // state, use the World-tab Teleport, which is vehicle-independent.)
+    // Bitmask: bit m set => mode m allowed. Modes: 0 foot, 1-5 chocobo, 6 gold-flight, 7 boat, 8/9 airship.
+    private const Int32 AllVehicleModes = 0x3FF;   // 0..9
+    private const Int32 FootOnly = 0x001;          // 0
+    private static readonly Dictionary<Int32, Int32> VehicleAllowByWorld = new Dictionary<Int32, Int32>
+    {
+        { 9002, AllVehicleModes },// WORLD02  benign foot-only switch (idle default) -> all modes are safe no-ops
+        { 9010, AllVehicleModes },// WORLD10  benign foot-only switch
+        { 9011, AllVehicleModes },// WORLD11  benign foot-only switch (the proven-safe test state)
+        // Every other world state (00/03/05/07/08/09 have real vehicle nav arms; 01/04/06/12 are cutscenes)
+        // falls to the FootOnly default below -- forcing a non-foot mode there crashes the event script.
+    };
+
+    // The loaded overworld dispatcher id (wldMapNo, 9000-9012), or -1 if unavailable.
+    private static Int32 WorldMapNo()
+    {
+        try { return FF9StateSystem.Common.FF9.wldMapNo; }
+        catch (Exception) { return -1; }
+    }
+
+    // The allowed-vehicle bitmask for the current world state. An unlisted state -> FootOnly, the crash-safe
+    // default (every dispatcher handles case 0 = on foot; only the benign no-nav states allow more).
+    private static Int32 VehicleAllowMask()
+    {
+        return VehicleAllowByWorld.TryGetValue(WorldMapNo(), out Int32 mask) ? mask : FootOnly;
+    }
+
+    private static Boolean VehicleAllowed(Int32 mode)
+    {
+        return mode >= 0 && mode <= 9 && (VehicleAllowMask() & (1 << mode)) != 0;
+    }
+
+    private void VehicleButton(String label, Int32 mode, Int32 allowMask)
+    {
+        Boolean on = CurrentControlNo() == mode;
+        if ((allowMask & (1 << mode)) == 0)
+        {
+            // Greyed + non-clickable: this world state's dispatcher doesn't handle this vehicle (forcing it
+            // would crash the event script). GUI.enabled=false is the IMGUI disable idiom.
+            Boolean prev = GUI.enabled;
+            GUI.enabled = false;
+            GUILayout.Button("- " + label + "   — n/a in this world state", _button);
+            GUI.enabled = prev;
+            return;
+        }
+        if (GUILayout.Button((on ? "* " : "- ") + label, on ? _tabOn : _button))
+            SetVehicle(mode);
+    }
+
+    private void SetVehicle(Int32 mode)
+    {
+        try
+        {
+            if (PersistenSingleton<UIManager>.Instance.State != UIManager.UIState.WorldHUD)
+            {
+                _status = "vehicle swap: overworld only";
+                return;
+            }
+            // [ff9mapkit] Refuse a mode the loaded WORLDxx dispatcher can't handle -- forcing it crashes the world
+            // event script (CalcStack underflow). The buttons already grey these out; this is the belt-and-braces guard.
+            if (!VehicleAllowed(mode))
+            {
+                _status = "mode " + mode + " " + VehicleName(mode) + " isn't handled by world state "
+                          + WorldMapNo() + " — would crash. Use gold-chocobo flight (6) where offered.";
+                return;
+            }
+            Byte[] g = FF9StateSystem.EventState.gEventGlobal;
+            if (g == null || g.Length <= 190)
+            {
+                _status = "vehicle swap: no gEventGlobal";
+                return;
+            }
+            g[190] = (Byte)mode;
+            ff9.w_movementChange();       // re-reads gEventGlobal[190] (non-Bee scene) -> applies the profile
+            _status = "movement mode -> " + mode + "  " + VehicleName(mode) + "   (close the menu and move)";
+        }
+        catch (Exception err)
+        {
+            _status = "vehicle swap failed: " + err.Message;
+        }
+    }
+
+    private static Int32 CurrentControlNo()
+    {
+        try { return FF9StateSystem.EventState.gEventGlobal[190]; }
+        catch (Exception) { return -1; }
+    }
+
+    private static String VehicleName(Int32 n)
+    {
+        switch (n)
+        {
+            case 0: return "(on foot)";
+            case 1: return "(chocobo - plains)";
+            case 2:
+            case 3:
+            case 4: return "(chocobo - mountain)";
+            case 5: return "(chocobo - all terrain)";
+            case 6: return "(gold chocobo - flying)";
+            case 7: return "(Blue Narciss - boat)";
+            case 8: return "(Hilda Garde III - airship)";
+            case 9: return "(Invincible - airship)";
+            default: return "(?)";
+        }
+    }
+
+    // Live overworld state read-out (read-only). RealPosition = ABSOLUTE (un-wrapped) world pos, the value the
+    // minimap + w_frameGetParameter use; cells are 32u (z divides by -32); block = InitialX/Y content identity vs
+    // CurrentX/Y wrapped screen slot; IDALL/topograph under the player via m_moveActorID. w_moveActorPtr overrides
+    // Unity ==, so guard with the (UnityEngine.Object)null form (and originalActor separately — m_moveActorID
+    // doesn't guard it).
+    private static String WorldReadout()
+    {
+        try
+        {
+            WMActor a = ff9.w_moveActorPtr;
+            if (a == (UnityEngine.Object)null || a.originalActor == null)
+                return "(no controlled actor yet)";
+            Vector3 wp = a.RealPosition;
+            Int32 cellX = (Int32)(wp.x / 32f);
+            Int32 cellZ = (Int32)(wp.z / -32f);
+            Int32 idall = ff9.m_moveActorID;
+            Int32 ev = ff9.m_GetIDEvent(idall), area = ff9.m_GetIDArea(idall), topo = ff9.m_GetIDTopograph(idall);
+            String blk = "blk (--)";
+            WMWorld w = ff9.world;
+            if (w != null)
+            {
+                WMBlock b = w.GetAbsoluteBlock(a.transform);
+                if (b != null)
+                    blk = String.Format("blk init({0},{1}) cur({2},{3})", b.InitialX, b.InitialY, b.CurrentX, b.CurrentY);
+            }
+            return String.Format(
+                "pos ({0:F0}, {1:F0}, {2:F0})   cell ({3}, {4})\n{5}\nIDALL 0x{6:X4}   ev {7}  area {8}  topo {9}",
+                wp.x, wp.y, wp.z, cellX, cellZ, blk, idall, ev, area, topo);
+        }
+        catch (Exception e)
+        {
+            return "readout unavailable: " + e.Message;
+        }
+    }
+
+    private void CopyWorldPos()
+    {
+        try
+        {
+            WMActor a = ff9.w_moveActorPtr;
+            if (a == (UnityEngine.Object)null)
+                return;
+            Vector3 wp = a.RealPosition;
+            _wxText = ((Int32)wp.x).ToString();
+            _wzText = ((Int32)wp.z).ToString();
+            GUIUtility.systemCopyBuffer = (Int32)wp.x + ", " + (Int32)wp.z;
+            _status = "copied world (" + (Int32)wp.x + ", " + (Int32)wp.z + ") -> boxes + clipboard";
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    // OVERWORLD teleport. TWO things must happen or the player snaps back: (1) reposition via the engine's OWN
+    // EventEngine.SetActorPosition (writes po.pos[] + po.lastx/y/z THEN the wmActor transform, DoEventCode.cs:3439),
+    // and (2) tell Memoria's 60fps world smoother to skip a couple ticks (SmoothFrameUpdater_World.Skip) -- else its
+    // ResetState() re-asserts the pre-teleport position every tick (full trace at the Skip call below). Guards
+    // (adversarially reviewed): only on the wrapping, non-Bee overworld; non-dummy actor + valid PosObj; CLAMP into the
+    // 24x20 grid first (out-of-grid coords can throw). Y carries the current height; InitSlice re-grounds it.
+    private void WorldTeleport()
+    {
+        Single wx, wz;
+        if (!Single.TryParse(_wxText, out wx) || !Single.TryParse(_wzText, out wz))
+        {
+            _status = "teleport: enter numeric X, Z";
+            return;
+        }
+        WorldTeleportTo(wx, wz);
+    }
+
+    // The overworld teleport core (parameterized), shared by the World-tab X,Z box and a pinned overworld SPOT favorite.
+    private void WorldTeleportTo(Single wx, Single wz)
+    {
+        try
+        {
+            WMWorld w = ff9.world;
+            if (w == null || !w.Settings.WrapWorld || FF9StateSystem.World.IsBeeScene)
+            {
+                _status = "teleport: only on the wrapping overworld";
+                return;
+            }
+            WMActor a = ff9.w_moveActorPtr;
+            if (a == (UnityEngine.Object)null || a == ff9.w_moveDummyCharacter)
+            {
+                _status = "teleport: no controlled actor";
+                return;
+            }
+            EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+            PosObj po = ee.GetControlChar();
+            if (po == null || po.pos == null || po.pos.Length < 3)
+            {
+                _status = "teleport: no controlled PosObj";
+                return;
+            }
+            Single cy = a.RealPosition.y;                        // keep current height; movement/InitSlice re-grounds Y
+            Int32 px = (Int32)(wx * 256f), py = (Int32)(cy * 256f), pz = (Int32)(wz * 256f);
+            Int32 bx = px / 16384, bz = Math.Abs(pz) / 16384;    // 1 block = 16384 fixed-point (64u)
+            if (bx < 0 || bx >= 24 || bz < 0 || bz >= 20)
+            {
+                _status = "teleport: (" + (Int32)wx + ", " + (Int32)wz + ") is outside the 24x20 grid (x 0..1535, z 0..-1279)";
+                return;
+            }
+            // Engine's own overworld reposition: writes the PosObj record (pos + lastx/y/z) AND the wmActor transform.
+            ee.SetActorPosition(po, (Single)px, (Single)py, (Single)pz);
+            // DWIX Path D: force the DESTINATION block to load + become IsReady BEFORE grounding. w_nwpHit early-returns
+            // defaultHeight=0 on a !IsReady block (ff9.cs:7150), so warping into a not-yet-streamed cell -- especially a
+            // reclaimed COAST with a tall hill -- stranded the player at Y=0 under the terrain (had to fly in on a vehicle
+            // + switch to foot). w_movementChrInitSlice sky-casts (infinite from +400u), so once the block is ready it
+            // grounds correctly. GetAbsoluteBlock resolves the target cell by world position regardless of player distance.
+            w.ForceLoadBlockReadyAt(new Vector3(wx, cy, wz));
+            ff9.w_movementChrInitSlice();                        // re-ground Y (matches WMBeeMenu.cs:205)
+            ff9.w_movementAutoPilotOFF();                        // cancel any active auto-walk target (idempotent if none)
+            // THE REVERTER (root cause, found 2026-07-01): Memoria's 60fps world smoother, Memoria.SmoothFrameUpdater_World.
+            // Each logical tick it caches the actor's position; ResetState() at the START of the NEXT tick
+            // (HonoBehaviorSystem.cs:111, runs BEFORE movement) UNCONDITIONALLY snaps transform.position back to that
+            // cached value (SmoothFrameUpdater_World.cs:191) -- writing the transform DIRECTLY, not via the WMActor.pos
+            // property, which is why the prior setter-probes "never saw" the write and we mis-blamed a native driver.
+            // The old teleport held ~2 render frames (Apply()'s Lerp is skipped for big moves, sqrMag >= 100f) then
+            // snapped on the first tick's ResetState. Fix = the game's OWN pattern for repositioning the world control
+            // actor: skip smoothing a couple ticks (DoEventCode.cs:1009 CC/DefinePlayerCharacter + SceneDirector.cs:124
+            // both do exactly this). Skip clears every actor's _smoothUpdateRegistered so ResetState/Apply pass it over;
+            // the next RegisterState re-seeds prev+actual from the NEW pos. (Game uses 1; 2 gives margin for the fact
+            // that our write comes from OnGUI at an arbitrary phase vs the tick.)
+            Memoria.SmoothFrameUpdater_World.Skip = 2;
+            _status = "teleported to world (" + (Int32)wx + ", " + (Int32)wz + ")";
+        }
+        catch (Exception err)
+        {
+            _status = "teleport failed: " + err.Message;
+        }
+    }
+
+    private void WorldWarpTo(String text)
+    {
+        if (Int32.TryParse(text, out Int32 id))
+            WorldWarp(id);
+        else
+            _status = "world warp: enter a numeric field id";
+    }
+
+    // OVERWORLD -> FIELD warp using the GAME'S OWN transition path -- the exact levers WMScriptDirector.HonoUpdate20FPS
+    // case 4 sets when a world .eb runs the Field(N) opcode:
+    //   SetNextMap(id)  -> because ff9Sys.mode==3 (WORLD) this writes FF9StateSystem.World.FF9World.map.nextMapNo
+    //   map.nextMode=1  -> "enter a field" (vs 2 = battle)
+    //   ff9Sys.attr |= 0x1000 (4096) -> arms the shutdown branch
+    // On the NEXT 20fps world tick the engine itself calls ff9ShutdownStateWorldMap() (mode->1, prevMode->3, applying
+    // the s28 ForkSiblingField redirect so a DONOR id lands on its fork) then SceneDirector.Replace("FieldMap", ...,
+    // needFade:TRUE) -- so the fade-out/in is free and we don't touch SceneDirector ourselves. Crucially the shutdown
+    // check (WMScriptDirector.cs:191, attr & 0x3001) runs OUTSIDE the usercontrol / attr&256 gate, so this fires even
+    // when the player is FROZEN -- which is why this doubles as the escape from a stuck overworld. FieldEntrance /
+    // ScenarioCounter are seeded exactly like the field Warp tab. (Mirror of the field warp, which uses the field
+    // buffer + attr|=8u; the world loop tests attr & 0x3001 and the field loop tests attr & 15, hence the different bit.)
+    private void WorldWarp(Int32 mapNo)
+    {
+        try
+        {
+            if (PersistenSingleton<UIManager>.Instance.State != UIManager.UIState.WorldHUD)
+            {
+                _status = "world warp: overworld only";
+                return;
+            }
+            FF9StateSystem sys = PersistenSingleton<FF9StateSystem>.Instance;
+            if (sys.mode != 3)                                   // SetNextMap routes by mode; must be WORLD (3)
+            {
+                _status = "world warp: not in world mode (" + sys.mode + ")";
+                return;
+            }
+            if (Int32.TryParse(_entranceText, out Int32 entr) && entr >= 0)
+                FF9StateSystem.EventState.FieldEntrance = entr;  // arrive as if through a chosen door (blank = leave as-is)
+            if (Int32.TryParse(_scenarioText, out Int32 scn) && scn >= 0)
+                FF9StateSystem.EventState.ScenarioCounter = scn; // seed a story beat for a story-gated fork
+            PersistenSingleton<EventEngine>.Instance.SetNextMap(mapNo);
+            FF9StateSystem.World.FF9World.map.nextMode = 1;
+            sys.attr |= 4096u;                                   // 0x1000 -> shutdown+Replace on the next world tick (with fade)
+            _status = "warping to field " + mapNo + " ...";
+            // The destination field loads a FRESH EventContext and re-enables control via its own .eb, so drop our
+            // control-hold bookkeeping here (do NOT stamp the stale overworld _priorControl onto it -- same idiom as
+            // RestoreControl). Skipping this stranded _controlHeld=true, which silently no-op'd the "Disable control"
+            // freeze the first time the menu was reopened in the destination.
+            _controlHeld = false;
+            _open = false;                                       // the transition takes over; the field .eb re-enables control
+        }
+        catch (Exception err)
+        {
+            _status = "world warp failed: " + err.Message;
+        }
+    }
+
+    // Force-restore user control on the overworld (belt-and-braces "unfreeze"): a warp/entrance script that ran
+    // DisableMove (usercontrol=0) but never re-enabled it leaves the player frozen with no escape. SetUserControl(true)
+    // flips usercontrol back on (same lever the "Disable control" checkbox uses, which is proven to freeze/unfreeze the
+    // overworld character), and w_movementAutoPilotOFF cancels any half-set auto-walk target. If control still won't
+    // stick, use "Warp to field" above -- that leaves the overworld entirely and the destination .eb re-establishes control.
+    private void RestoreControl()
+    {
+        try
+        {
+            PersistenSingleton<EventEngine>.Instance.SetUserControl(true);
+            _controlHeld = false;                                // we no longer hold it off -> a plain close won't re-freeze
+            try { ff9.w_movementAutoPilotOFF(); } catch (Exception) { }
+            _status = "control restored";
+        }
+        catch (Exception err)
+        {
+            _status = "restore control failed: " + err.Message;
+        }
+    }
