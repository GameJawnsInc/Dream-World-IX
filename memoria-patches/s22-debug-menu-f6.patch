+    // Disc 1<->4 toggle via the stock debug path (w_frameSetParameter 501 up / 502 down, WMBeeMenu.cs:127-139).
+    // 501 also runs ResetBlockForms + w_worldChangeBlockSet + sets w_frameScenePtr; SetDisc issues the fade+reload.
+    private void ToggleDisc()
+    {
+        try
+        {
+            if (ff9.w_frameDisc == 1)
+                ff9.w_frameSetParameter(501, 11090);   // disc1 -> disc4 (>= 11090 threshold)
+            else if (ff9.w_frameDisc == 4)
+                ff9.w_frameSetParameter(502, 0);        // disc4 -> disc1 (reset)
+            else
+            {
+                _status = "disc switch: unexpected disc " + ff9.w_frameDisc;
+                return;
+            }
+            _status = "disc switch requested — world reloads (fade)";
