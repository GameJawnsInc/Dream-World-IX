+    private Boolean Warp(Int32 mapNo, Boolean resetFlags)
+    {
+        try
+        {
+            if (PersistenSingleton<UIManager>.Instance.State != UIManager.UIState.FieldHUD)
+                return false;
+            // Lock control + start the fade-to-black NOW; the actual map change fires from Update once the
+            // fade has finished (so the destination loads black, like a gateway). The flag reset (if any)
+            // also defers to the trigger so it lands with the reload, not a frame early.
+            PersistenSingleton<EventEngine>.Instance.SetUserControl(false);
+            SceneDirector.FF9Wipe_FadeOutEx(WarpFadeFrames);
+            _pendingWarpMap = mapNo;
+            // [ff9mapkit] stash the chosen arrival entrance (blank/invalid -> -1 = leave FieldEntrance as-is)
+            _pendingWarpEntrance = Int32.TryParse(_entranceText, out Int32 entr) && entr >= 0 ? entr : -1;
+            // [ff9mapkit] stash the chosen ScenarioCounter (blank/invalid -> -1 = leave it as-is)
+            _pendingWarpScenario = Int32.TryParse(_scenarioText, out Int32 scn) && scn >= 0 ? scn : -1;
+            _pendingWarpReset = resetFlags;
+            _pendingWarpTimer = WarpFadeWait;
+            _controlHeld = false;   // the destination re-establishes control on a fresh context; don't strand the hold (see WorldWarp)
+            _open = false;
+            return true;
+        }
+        catch (Exception err)
+        {
+            _status = "warp failed: " + err.Message;
+            return false;
+        }
+    }
+
+    // Fire the deferred map change after the fade-out has run. ServiceFade (ticked by HonoluluFieldMain
+    // while the field is still active) drives the wipe to black during this wait; SetNextMap then transitions
+    // with the screen already black -- identical to the eb Field-op path a gateway uses.
+    private void ServicePendingWarp()
+    {
+        if (_pendingWarpMap < 0)
+            return;
+        _pendingWarpTimer -= Time.deltaTime;
+        if (_pendingWarpTimer > 0f)
+            return;
+        Int32 mapNo = _pendingWarpMap;
+        _pendingWarpMap = -1;
+        try
+        {
+            if (_pendingWarpReset)
+                ClearFlagState();
+            EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+            ee.SetUserControl(false);
+            // [ff9mapkit] arrive as if through a chosen door: set FieldEntrance the way a gateway does, just
+            // before the map change, so the destination .eb branches to that entrance (placement + scroll init).
+            if (_pendingWarpEntrance >= 0)
+                FF9StateSystem.EventState.FieldEntrance = _pendingWarpEntrance;
+            // [ff9mapkit] seed the story beat before the map loads, so a story-gated fork's Main_Init reads the
+            // right ScenarioCounter (a cold fork otherwise boots at 0). Set BEFORE SetNextMap so the new field's
+            // entry logic sees it. (A fork that bakes its own [startup] scenario would re-overwrite this on entry.)
+            if (_pendingWarpScenario >= 0)
+                FF9StateSystem.EventState.ScenarioCounter = _pendingWarpScenario;
+            ee.SetNextMap(mapNo);
+            FF9StateSystem.Field.FF9Field.loc.map.nextMode = 1;
+            PersistenSingleton<FF9StateSystem>.Instance.attr |= 8u;
+        }
+        catch (Exception err)
+        {
+            _status = "warp failed: " + err.Message;
+        }
+    }
+
+    // [ff9mapkit] Set the ScenarioCounter on the CURRENT field without warping (then F6 -> Reload field to let
+    // the field's Main_Init re-derive its state from the new beat). Handy to nudge a story-gated fork in place.
+    private void SetScenarioNow()
+    {
+        if (!Int32.TryParse(_scenarioText, out Int32 scn) || scn < 0)
+        {
+            _status = "scenario: enter a non-negative number";
+            return;
+        }
+        try
+        {
+            FF9StateSystem.EventState.ScenarioCounter = scn;
+            _status = "ScenarioCounter = " + scn + "  (F6 -> Reload field to apply)";
+        }
+        catch (Exception err)
+        {
+            _status = "set scenario failed: " + err.Message;
+        }
+    }
