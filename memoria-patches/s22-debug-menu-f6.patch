+using System;
+using System.Collections.Generic;
+using Assets.Scripts.Common;        // SceneDirector (FF9Wipe_FadeOutEx -- the warp fade-to-black)
+using Memoria.Data;
+using UnityEngine;
+
+// [ff9mapkit dev] One in-game debug menu (toggled by F6 from UIKeyTrigger, in FIELD or BATTLE) -- dev actions on ONE key +
+// a tabbed popup instead of one-hotkey-per-function. IMGUI/OnGUI overlay (the proven in-engine pattern,
+// cf. OnScreenLog / the FieldCreator editor), self-bootstrapping persistent MonoBehaviour so it is
+// always alive to receive OnGUI. Dev engine only; never part of the shipped mod.
+//
+// Tabs:
+//   Warp   -- reload the current field; warp to any REGISTERED custom field (eventIDToFBGID id>=4000)
+//             or a typed id -> hop between per-branch slots (4003/5000/5001) live.
+//   Move   -- read the player pos / teleport to a typed (x,z); RIGHT-CLICK the field to copy the floor
+//             (x,z) under the cursor to the clipboard (reuses FF9's own click-to-move math).
+//   Cheats -- boosters (the F1-F4 toggles) + full-heal party + give item/gil.
+//   Flags  -- get/set/clear a gEventGlobal story flag (matches the kit's set_flag: VariableType.Bit ->
+//             gEventGlobal[N>>3] bit N&7); snapshot/restore the whole flag state; reset-all.
+//   Time   -- a time-scale control (slow-mo / fast) for inspecting cutscenes & movement.
+//   World  -- OVERWORLD only: swap the movement/vehicle mode (gEventGlobal[190] + w_movementChange) so you can
+//             walk/fly/sail onto any terrain to reach an entrance under test. Swaps the movement PROFILE onto the
+//             current character (Zidane keeps his model). GATED per world state: only modes the loaded
+//             EVT_WORLD_WORLDxx dispatcher handles are offered -- forcing an unhandled one crashes the event script.
+// Header shows the current field id + name + the player's (x,z), live (or the disc + vehicle mode on the overworld).
+// Adding an action = one button.
+public class Ff9mkDebugMenu : MonoBehaviour
+{
+    private static Ff9mkDebugMenu _instance;
+    private Boolean _open;
+    private Boolean _priorControl;          // user-control state to restore when the hold is released
+    private Boolean _disableControl = true; // "Disable control" checkbox: pause player input while the menu is open (default on)
+    private Boolean _controlHeld;           // whether user control is CURRENTLY held off by us (so we restore exactly once)
+
+    private Rect _win = new Rect(24f, 24f, 380f, 520f);
+    private Vector2 _scroll;
+    private Int32 _tab;
+    private String _warpText = "5000";
+    private String _entranceText = "";       // [ff9mapkit] optional arrival entrance for the warp (blank = leave FieldEntrance as-is)
+    private String _scenarioText = "";       // [ff9mapkit] optional ScenarioCounter to set before the warp (blank = leave as-is) -- seed a story beat to reach a story-gated fork
+    private String _txText = "0";
+    private String _tzText = "0";
+    private String _wxText = "0";       // [ff9mapkit] overworld teleport target X (world units), World tab
+    private String _wzText = "0";       // [ff9mapkit] overworld teleport target Z (world units, NEGATIVE going down the grid)
+    private Boolean _worldBoxesInit;    // auto-fill the teleport boxes with the live pos on the first World-tab draw (avoids the 0,0 ocean-corner default)
+    private String _flagText = "8000";
+    private String _itemText = "236";       // a Potion, by default
+    private String _itemCountText = "1";
+    private String _gilText = "10000";
+    private Byte[] _snapshot;                // saved gEventGlobal (flag snapshot/restore)
+    private String _status = "";
+
+    // Deferred FADED warp: a bare F6 Field() warp transitions with the source field still drawn, so the
+    // destination loads in the clear and you SEE its smooth-camera ease onto the spawn (the "warp-in drift"
+    // that made debug warps look broken next to the clean shipping entry). Real gateways + the New-Game
+    // field-70 entry fade to BLACK first, so the destination loads black and its reveal + [camera]
+    // entry_settle hide the settle. So the F6 warp now does the same: fade out, wait for it, THEN change map.
+    private const Int32 WarpFadeFrames = 24;     // FF9Wipe fade-out duration (matches the gateway FadeFilter)
+    private const Single WarpFadeWait = 0.9f;    // seconds to let the fade finish before the map change
+    private Int32 _pendingWarpMap = -1;          // >= 0 while a faded warp is in flight
+    private Int32 _pendingWarpEntrance = -1;     // [ff9mapkit] >= 0 -> set FieldEntrance before the map change (faithful gateway arrival)
+    private Int32 _pendingWarpScenario = -1;     // [ff9mapkit] >= 0 -> set ScenarioCounter before the map change (seed a story beat)
+    private Single _pendingWarpTimer;
+    private Boolean _pendingWarpReset;
+
+    private const Int32 WinId = 0x4F9DEB;
+    private static readonly String[] Tabs = { "Warp", "Move", "Cheats", "Flags", "Time", "World" };
+    private static readonly Single[] Speeds = { 0.25f, 0.5f, 1f, 2f, 4f };
+
+    // lazily-built styling
+    private GUIStyle _box, _title, _header, _label, _button, _field, _tabOn;
+    private Texture2D _bgTex;
+
+    public static void Toggle()
+    {
+        Ensure();
+        _instance.SetOpen(!_instance._open);
+    }
+
+    public static Boolean IsOpen
+    {
+        get { return _instance != null && _instance._open; }
+    }
+
+    // The menu is allowed in field AND battle (UIKeyTrigger's F6 gate). In battle the field-only tabs
+    // (Warp/Move) no-op, so they show a note; Cheats/Flags/Time operate on the shared party/flag/time state.
+    private static Boolean InBattle
+    {
+        get { return PersistenSingleton<UIManager>.Instance.State == UIManager.UIState.BattleHUD; }
+    }
+
+    // The OVERWORLD (world map) state. The World tab operates here; the field-only tabs (Warp/Move) no-op with a
+    // note, and vehicle-mode swap is refused off the world map.
+    private static Boolean InWorld
+    {
+        get { return PersistenSingleton<UIManager>.Instance.State == UIManager.UIState.WorldHUD; }
+    }
+
+    private static void Ensure()
+    {
+        if (_instance != null)
+            return;
+        GameObject go = new GameObject("Ff9mkDebugMenu");
+        UnityEngine.Object.DontDestroyOnLoad(go);
+        _instance = go.AddComponent<Ff9mkDebugMenu>();
+    }
+
+    // Open/close the menu, PAUSING field input while open (save the current user-control state, disable
+    // it, restore on a plain close) so the d-pad + the Use(!)/action button don't drive the field behind
+    // the popup. A warp/reload action instead closes the menu directly -- the field transition itself
+    // re-establishes control -- so it does not restore here.
+    private void SetOpen(Boolean open)
+    {
+        if (open == _open)
+            return;
+        // Control hold is governed by the "Disable control" checkbox (drawn at the top of the window). On open apply
+        // it; on close ALWAYS release so the player is never left frozen. NOTE: the OVERWORLD teleport wants control
+        // LIVE to stick -- uncheck "Disable control" before teleporting on the world map.
+        ApplyControlHold(open && _disableControl);
+        _open = open;
+    }
+
+    // Pause/resume EventEngine user control (so the d-pad / action button don't drive the character behind the popup).
+    // Idempotent via _controlHeld: we capture the prior state once when first holding, and restore it once when releasing.
+    private void ApplyControlHold(Boolean wantHold)
+    {
+        try
+        {
+            EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+            if (wantHold && !_controlHeld)
+            {
+                _priorControl = ee.GetUserControl();
+                ee.SetUserControl(false);
+                _controlHeld = true;
+            }
+            else if (!wantHold && _controlHeld)
+            {
+                ee.SetUserControl(_priorControl);
+                _controlHeld = false;
+            }
+        }
+        catch (Exception)
+        {
+        }
+    }
+
+    private void Update()
+    {
+        ServicePendingWarp();                    // drive the deferred faded warp (fade out -> map change)
+        // While the menu is open, RIGHT-CLICK the field to copy the world (x, z) under the cursor (to
+        // the clipboard + the Move tab boxes) -- handy for placing NPCs/zones/spawns in a field.toml.
+        if (_open && Input.GetMouseButtonDown(1))
+            PickPoint();
+    }
+
+    private void OnGUI()
+    {
+        if (!_open)
+            return;
+        EnsureStyles();
+        Single scale = Mathf.Max(1f, Screen.height / 800f);     // legible at 1080p / 1440p / 4K
+        Matrix4x4 prev = GUI.matrix;
+        GUI.matrix = Matrix4x4.Scale(new Vector3(scale, scale, 1f));
+        _win.height = Mathf.Min(520f, Screen.height / scale - 32f);
+        _win = GUI.Window(WinId, _win, DrawWindow, GUIContent.none, _box);
+        GUI.matrix = prev;
+    }
+
+    private void DrawWindow(Int32 id)
+    {
+        GUILayout.Label("ff9mapkit debug   (F6 closes)", _title);
+        GUILayout.Label(CurrentInfo(), _label);
+
+        // "Disable control" toggle: hold player input off while the menu is up (stops the character walking behind the
+        // popup). Uncheck it to move -- and note the overworld teleport needs it OFF to stick.
+        Boolean wantHold = GUILayout.Toggle(_disableControl, " Disable control (freeze the character while the menu is open)");
+        if (wantHold != _disableControl)
+        {
+            _disableControl = wantHold;
+            ApplyControlHold(wantHold);
+        }
+
+        GUILayout.BeginHorizontal();                            // tab bar
+        for (Int32 i = 0; i < Tabs.Length; i++)
+            if (GUILayout.Button(Tabs[i], i == _tab ? _tabOn : _button))
+                _tab = i;
+        GUILayout.EndHorizontal();
+        GUILayout.Space(4f);
+
+        _scroll = GUILayout.BeginScrollView(_scroll);
+        switch (_tab)
+        {
+            case 0: DrawWarp(); break;
+            case 1: DrawMove(); break;
+            case 2: DrawCheats(); break;
+            case 3: DrawFlags(); break;
+            case 4: DrawTime(); break;
+            default: DrawWorld(); break;
+        }
+        GUILayout.EndScrollView();
+
+        if (_status.Length > 0)
+            GUILayout.Label(_status, _label);
+        if (GUILayout.Button("Close", _button))
+            SetOpen(false);
+        GUI.DragWindow(new Rect(0f, 0f, 10000f, 22f));          // drag by the title strip
+    }
+
+    // ------------------------------------------------------------------- tabs
+    private void DrawWarp()
+    {
+        if (InBattle)
+        {
+            GUILayout.Label("Field only — warp/reload run from a field, not in battle.", _label);
+            return;
+        }
+        if (InWorld)
+        {
+            GUILayout.Label("Field only — warp/reload run from a field, not the overworld. Use the World tab to change vehicle.", _label);
+            return;
+        }
+        if (GUILayout.Button("Reload field", _button))
+            Reload(false);
+        Section("Warp to field");
+        GUILayout.BeginHorizontal();
+        _warpText = GUILayout.TextField(_warpText, 6, _field, GUILayout.Width(120f));
+        if (GUILayout.Button("Go", _button, GUILayout.Width(64f)))
+            WarpTo(_warpText);
+        GUILayout.EndHorizontal();
+        // [ff9mapkit] Arrival entrance: a real gateway sets FieldEntrance just before Field(target), so the
+        // destination .eb places the player at that door + inits the scroll/camera there. A bare F6 warp left
+        // it stale -> you always landed at entry 0 (the "wrong end" + scrolling-field drift). Set it to arrive
+        // as if through a specific door (blank = leave the current value). Try 0,1,2... to find the right door;
+        // the Flags tab readout shows the live FieldEntrance so you can confirm which one took.
+        GUILayout.BeginHorizontal();
+        GUILayout.Label("arrive via entrance", _label, GUILayout.Width(140f));
+        _entranceText = GUILayout.TextField(_entranceText, 4, _field, GUILayout.Width(56f));
+        GUILayout.EndHorizontal();
+        // [ff9mapkit] Set ScenarioCounter before the warp: seed a STORY BEAT so a story-gated fork loads in the
+        // right state (a cold fork boots at scenario 0). Blank = leave it. "Set now" applies it to the CURRENT
+        // field without warping. The Flags tab readout shows the live ScenarioCounter + its beat name.
+        GUILayout.BeginHorizontal();
+        GUILayout.Label("set scenario", _label, GUILayout.Width(140f));
+        _scenarioText = GUILayout.TextField(_scenarioText, 6, _field, GUILayout.Width(56f));
+        if (GUILayout.Button("Set now", _button, GUILayout.Width(64f)))
+            SetScenarioNow();
+        GUILayout.EndHorizontal();
+        foreach (KeyValuePair<Int32, String> kv in RegisteredFields())
+            if (GUILayout.Button(kv.Key + "   " + kv.Value, _button))
+                Warp(kv.Key, false);
+    }
+
+    private void DrawMove()
+    {
+        if (InBattle)
+        {
+            GUILayout.Label("Field only — teleport / point-pick run from a field, not in battle.", _label);
+            return;
+        }
+        if (InWorld)
+        {
+            GUILayout.Label("Field only — teleport / point-pick run from a field, not the overworld. Use the World tab.", _label);
+            return;
+        }
+        Section("Teleport (x, z) on this field");
+        GUILayout.BeginHorizontal();
+        _txText = GUILayout.TextField(_txText, 7, _field, GUILayout.Width(78f));
+        _tzText = GUILayout.TextField(_tzText, 7, _field, GUILayout.Width(78f));
+        if (GUILayout.Button("Go", _button, GUILayout.Width(48f)))
+            Teleport();
+        if (GUILayout.Button("Copy", _button, GUILayout.Width(56f)))
+            UseCurrent();
+        GUILayout.EndHorizontal();
+        GUILayout.Label("right-click the field -> copy that point's (x, z) to clipboard", _label);
+    }
+
+    private void DrawCheats()
+    {
+        Section("Boosters (also the F1-F4 keys)");
+        BoosterToggle("Speed", 1);
+        BoosterToggle("ATB full", 0);
+        BoosterToggle("Attack 9999", 3);
+        BoosterToggle("No encounters", 4);
+
+        Section("Party");
+        if (GUILayout.Button("Full heal party", _button))
+            HealParty();
+        GUILayout.BeginHorizontal();
+        GUILayout.Label("item", _label, GUILayout.Width(36f));
+        _itemText = GUILayout.TextField(_itemText, 4, _field, GUILayout.Width(56f));
+        GUILayout.Label("x", _label, GUILayout.Width(12f));
+        _itemCountText = GUILayout.TextField(_itemCountText, 3, _field, GUILayout.Width(40f));
+        if (GUILayout.Button("Give", _button, GUILayout.Width(56f)))
+            GiveItem();
+        GUILayout.EndHorizontal();
+        GUILayout.BeginHorizontal();
+        GUILayout.Label("gil +", _label, GUILayout.Width(36f));
+        _gilText = GUILayout.TextField(_gilText, 8, _field, GUILayout.Width(96f));
+        if (GUILayout.Button("Add", _button, GUILayout.Width(56f)))
+            GiveGil();
+        GUILayout.EndHorizontal();
+        GUILayout.Label("(item ids: ff9mapkit items)", _label);
+    }
+
+    private void DrawFlags()
+    {
+        Section("Story state");
+        GUILayout.Label(StorySummary(), _label);
+
+        Section("Story flag (gEventGlobal)");
+        GUILayout.BeginHorizontal();
+        GUILayout.Label("idx", _label, GUILayout.Width(28f));
+        _flagText = GUILayout.TextField(_flagText, 6, _field, GUILayout.Width(78f));
+        if (GUILayout.Button("Get", _button, GUILayout.Width(48f)))
+            FlagGet();
+        if (GUILayout.Button("Set 1", _button, GUILayout.Width(56f)))
+            FlagWrite(true);
+        if (GUILayout.Button("Set 0", _button, GUILayout.Width(56f)))
+            FlagWrite(false);
+        GUILayout.EndHorizontal();
+
+        Section("Snapshot the whole flag state");
+        GUILayout.BeginHorizontal();
+        if (GUILayout.Button("Save", _button, GUILayout.Width(90f)))
+            Snapshot();
+        if (GUILayout.Button(_snapshot == null ? "Restore (none)" : "Restore", _button, GUILayout.Width(120f)))
+            RestoreSnapshot();
+        GUILayout.EndHorizontal();
+
+        Section("Reset");
+        if (GUILayout.Button("Reset all flags", _button))
+            ResetFlags();
+        if (GUILayout.Button("Reset all flags + reload", _button))
+            Reload(true);
+    }
+
+    private void DrawTime()
+    {
+        Section("Time scale");
+        GUILayout.Label("current: " + Time.timeScale.ToString("0.00") + "x", _label);
+        GUILayout.BeginHorizontal();
+        foreach (Single s in Speeds)
+            if (GUILayout.Button(s + "x", s == Time.timeScale ? _tabOn : _button))
+                Time.timeScale = s;
+        GUILayout.EndHorizontal();
+        GUILayout.Label("slows/speeds animation + movement (close the menu to watch a cutscene). "
+                        + "Some logic runs on a fixed tick.", _label);
+    }
+
+    // OVERWORLD vehicle/movement swap. w_movementChange() re-reads gEventGlobal[190] as the control mode in the
+    // normal (non-Bee) world scene, so setting the byte + calling it repoints the movement PROFILE (terrain limit,
+    // flight, speed, camera) onto the currently-controlled character. The C# call is null-safe -- BUT it is NOT
+    // safe in any state: each overworld state runs a different EVT_WORLD_WORLDxx event-script dispatcher, and
+    // forcing a mode that state's per-frame vehicle switch never handles drives its air/boat nav arm on
+    // uninitialised state -> a CalcStack expression underflow ("[CalcStack.pop] topOfStackID == 0") -> crash
+    // (repro: airship on WORLD00). So the buttons are GATED to VehicleAllowByWorld (the modes each dispatcher
+    // actually handles, derived byte-exact from the .eb). This does not swap the controlled ACTOR, so Zidane
+    // keeps his model (a faithful model+position swap would repoint EventEngine's controlUID -- a later increment).
+    private void DrawWorld()
+    {
+        if (!InWorld)
+        {
+            GUILayout.Label("Overworld only — open this on the world map (F6 now works there too).", _label);
+            return;
+        }
+
+        if (!_worldBoxesInit)                                   // seed the teleport boxes with the live pos, not 0,0
+        {
+            WMActor a0 = ff9.w_moveActorPtr;
+            if (a0 != (UnityEngine.Object)null)
+            {
+                Vector3 wp0 = a0.RealPosition;
+                _wxText = ((Int32)wp0.x).ToString();
+                _wzText = ((Int32)wp0.z).ToString();
+                _worldBoxesInit = true;
+            }
+        }
+
+        Section("Position (live)");
+        GUILayout.Label(WorldReadout(), _label);
+
+        Section("Teleport (world X, Z)");
+        GUILayout.BeginHorizontal();
+        _wxText = GUILayout.TextField(_wxText, 8, _field, GUILayout.Width(84f));
+        _wzText = GUILayout.TextField(_wzText, 8, _field, GUILayout.Width(84f));
+        if (GUILayout.Button("Go", _button, GUILayout.Width(44f)))
+            WorldTeleport();
+        if (GUILayout.Button("Copy", _button, GUILayout.Width(56f)))
+            CopyWorldPos();
+        GUILayout.EndHorizontal();
+        GUILayout.Label("Absolute world units (x 0..1535, z 0..−1279 — z is NEGATIVE). Uses the stock reposition "
+                        + "(SetPosition + re-ground); target LAND on foot, or swap vehicle first for water/air.", _label);
+
+        Section("Vehicle / movement mode");
+        Int32 cur = CurrentControlNo();
+        Int32 allowMask = VehicleAllowMask();
+        GUILayout.Label("current: " + cur + "  " + VehicleName(cur) + "     world state " + WorldMapNo(), _label);
+        VehicleButton("On foot", 0, allowMask);
+        VehicleButton("Chocobo — plains", 1, allowMask);
+        VehicleButton("Chocobo — mountains", 4, allowMask);
+        VehicleButton("Chocobo — all terrain", 5, allowMask);
+        VehicleButton("Chocobo — FLYING", 6, allowMask);
+        VehicleButton("Blue Narciss — boat (water)", 7, allowMask);
+        VehicleButton("Hilda Garde III — airship", 8, allowMask);
+        VehicleButton("Invincible — airship", 9, allowMask);
+        GUILayout.Label("Swaps the MOVEMENT profile (terrain access / flight / speed / camera) onto the current "
+                        + "character — Zidane keeps his model. Only modes the CURRENT world state (WORLDxx) handles "
+                        + "are enabled — forcing an unhandled vehicle drives that state's event script onto "
+                        + "uninitialised nav state and crashes it. Gold-chocobo FLYING (6) is offered in the "
+                        + "open-world states and crosses water/mountains to reach a test entrance.", _label);
+
+        Section("Disc");
+        Byte disc = 0;
+        try { disc = ff9.w_frameDisc; } catch (Exception) { }
+        if (GUILayout.Button("Disc " + disc + "  →  switch to " + (disc == 1 ? "4" : "1"), _button))
+            ToggleDisc();
+        GUILayout.Label("Reloads the world map (fade to black). COARSE switch — it does not advance the "
+                        + "ScenarioCounter/party, so a mismatched save may show wrong geometry. Same path the stock "
+                        + "debug menu uses (disc 1↔4 only).", _label);
+    }
+
+    // [ff9mapkit] Per-world-state vehicle allow-list. Each overworld state runs a DIFFERENT EVT_WORLD_WORLDxx
+    // event-script dispatcher (wldMapNo 9000+N -> WORLD00..12). Forcing gEventGlobal[190] to a mode the LOADED
+    // dispatcher's per-frame vehicle switch was never written to handle drives its air/boat NAV arm on
+    // uninitialised state -> a CalcStack expression underflow ("[CalcStack.pop] topOfStackID == 0" spam) -> crash.
+    // So we offer only the modes each dispatcher handles, derived byte-exact from the .eb (setter + switch census):
+    //   * vehicle-discriminating states (per-frame switch with cases beyond foot) -> the modes their boarding
+    //     menus initialise (the game's own safe set), e.g. WORLD00 = on-foot..gold-chocobo-flight (0-6);
+    //   * benign free-roam states (foot-only switch whose default is an idle Wait->loop) -> ALL modes are safe
+    //     no-ops (the C# movement profile still swaps), so allow everything (WORLD02/10/11);
+    //   * cutscene states (no vehicle switch) -> foot only, so a swap can't disturb their scripted autopilot.
+    // Bitmask: bit m set => mode m allowed. Modes: 0 foot, 1-5 chocobo, 6 gold-flight, 7 boat, 8/9 airship.
+    private const Int32 AllVehicleModes = 0x3FF;   // 0..9
+    private static readonly Dictionary<Int32, Int32> VehicleAllowByWorld = new Dictionary<Int32, Int32>
+    {
+        { 9000, 0x07F },          // WORLD00  0-6      disc-1 open world; flight = gold chocobo (6)
+        { 9001, 0x001 },          // WORLD01  0        Cargo Ship (cutscene, no vehicle switch)
+        { 9002, AllVehicleModes },// WORLD02  0-9      benign foot-only switch (idle default)
+        { 9003, 0x0FF },          // WORLD03  0-7      + Blue Narciss (boat)
+        { 9004, 0x001 },          // WORLD04  0        Hilda Garde 1 (cutscene)
+        { 9005, 0x07F },          // WORLD05  0-6
+        { 9006, 0x001 },          // WORLD06  0        Track Kuja (cutscene)
+        { 9007, 0x17F },          // WORLD07  0-6,8    + Hilda Garde III
+        { 9008, 0x27F },          // WORLD08  0-6,9    + Invincible
+        { 9009, 0x2FF },          // WORLD09  0-7,9
+        { 9010, AllVehicleModes },// WORLD10  0-9      benign foot-only switch
+        { 9011, AllVehicleModes },// WORLD11  0-9      benign foot-only switch (the proven-safe test state)
+        { 9012, 0x001 },          // WORLD12  0        Chocobo Treasure (cutscene)
+    };
+
+    // The loaded overworld dispatcher id (wldMapNo, 9000-9012), or -1 if unavailable.
+    private static Int32 WorldMapNo()
+    {
+        try { return FF9StateSystem.Common.FF9.wldMapNo; }
+        catch (Exception) { return -1; }
+    }
+
+    // The allowed-vehicle bitmask for the current world state. An unlisted state -> foot only (0x001), the
+    // crash-safe default (every dispatcher handles case 0 = on foot).
+    private static Int32 VehicleAllowMask()
+    {
+        return VehicleAllowByWorld.TryGetValue(WorldMapNo(), out Int32 mask) ? mask : 0x001;
+    }
