+    // DWIX Path C (s34): RENDER a loose "Object" .ff9mesh override on a BARE block (no stock ObjectForm1). Copies the
+    // block's TerrainForm1 as a render host (a working MeshFilter/MeshRenderer at localPosition 0), swaps in the
+    // override mesh, and names it "Object" so WMBlock.SetupPreloadedMaterials (keyed by GameObject name via
+    // MaterialDatabase) assigns the world OBJECT-atlas material -- same as a stock building. No-op unless the override
+    // exists. RENDER-ONLY: the mesh is NOT fed to the Form1 walkmesh -- a whole 3D building mesh as a collider makes
+    // its back-face-culled walls + below-ground base into INVISIBLE collision. Collision instead comes from the
+    // world-entrance TERRAIN footprint (topograph 59 under the building's hull), which is flat + conforms to the
+    // ground, so the player stops at the visible edge with nothing invisible to bump.
+    private void RegisterBareObjectOverride(WMBlock block, Transform template)
+    {
+        Mesh ff9Override = Memoria.World.WorldMeshOverride.TryLoad(String.Format(
+            "WorldMap/Disc{0}/0_1/r{1}/Block[{2}][{3}] Object", this.currentDisc, block.InitialY, block.InitialX,
+            block.InitialY));
+        if (ff9Override == (UnityEngine.Object)null)
+            return;
+        Transform copy = UnityEngine.Object.Instantiate<Transform>(template);
+        copy.name = "Object";
+        copy.parent = block.transform;
+        copy.localPosition = Vector3.zero;
+        copy.localScale = new Vector3(1f, 1f, 1f);
+        MeshFilter mf = copy.GetComponent<MeshFilter>();
+        if (mf != (UnityEngine.Object)null)
+            mf.sharedMesh = ff9Override;
+        block.AddForm1Transform(copy);   // render + visibility only (Form1); NO AddWalkMeshForm1 -- see note above
+    }
