+        // [ff9mapkit] A custom (loose-FBX) overworld model has junk bind-pose SkinnedMeshRenderer bounds, and the
+        // overworld -- unlike the field (FieldMapActor.ForcedNonCullingMesh) -- has no anti-cull, so it frustum-
+        // CULLS (invisible when the compact standing pose falls outside the stale bounds; visible when running).
+        // Force non-culling bounds on the model's SMRs, exactly as the field does, so a reskinned world actor
+        // renders in every pose. Harmless for bundled models (just disables per-actor frustum culling).
+        foreach (SkinnedMeshRenderer smr in go.GetComponentsInChildren<SkinnedMeshRenderer>(true))
+            smr.localBounds = new Bounds(Vector3.zero, Vector3.one * Single.MaxValue * 0.01f);
