diff --git a/Assembly-CSharp/Memoria/Netsync/NetSyncClient.cs b/Assembly-CSharp/Memoria/Netsync/NetSyncClient.cs
new file mode 100644
index 00000000..0c1e9f2a
--- /dev/null
+++ b/Assembly-CSharp/Memoria/Netsync/NetSyncClient.cs
@@ -0,0 +1,363 @@
+using System;
+using Memoria.Prime;
+using Memoria.Scripts;   // ShadersLoader
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // Persistent co-op "ghost sync" client. Config comes from Memoria.ini [Netsync]:
+    //   Enabled     = 0 | 1                 master switch; OFF by default (zero footprint on a normal game)
+    //   Role        = selftest | host | client
+    //   PeerAddress = <host LAN IP>         (client only; the machine running Role=host)
+    //   Port        = 49200
+    //   TargetField = 30003                 the co-op hangout field; the client is inert everywhere else
+    //
+    //   selftest      spawn a ghost beside the local player, mirroring it -- proves the pipeline solo.
+    //   host/client   NetSyncSocket carries {field,pos,rot,anim} both ways; each side renders the peer as
+    //                 a ghost while both are in TargetField. All Unity access is on the main thread here;
+    //                 the socket only swaps lock-guarded byte slots.
+    //
+    // Bootstrapped from HonoluluFieldMain.HonoAwake() via Ensure() (idempotent; only creates the object
+    // when Enabled). Render setup mirrors FieldMap.AddPlayer() (CreateModel + AddAnim + field-character
+    // shader) but WITHOUT a FieldMapActorController (it would re-snap the ghost to the walkmesh) or a real
+    // Actor -- we drive transform.localPosition ourselves, force huge skinned-mesh bounds so the PSX-shader-
+    // projected model isn't frustum-culled, and mirror the local player's per-submesh visibility.
+    public sealed class NetSyncClient : MonoBehaviour
+    {
+        private static NetSyncClient _instance;
+
+        private static Boolean _configLoaded;
+        private static Boolean _enabled;
+        private static String _role = "selftest";       // selftest | host | client
+        private static String _peer = "127.0.0.1";
+        private static Int32 _port = 49200;
+        private static Int32 _targetField = 30003;
+        private static String _relayUrl = "";            // set -> use the WS relay instead of direct TCP
+        private static String _sessionCode = "";
+        private static Boolean _insecureTls;
+
+        private const String GhostModel = "GEO_MAIN_F0_ZDN";
+        private const String GhostModelPath = "Models/main/GEO_MAIN_F0_ZDN/GEO_MAIN_F0_ZDN";
+
+        private INetTransport _socket;
+        private GameObject _ghost;
+        private Animation _ghostAnim;
+        private String _ghostClip;
+        private Boolean _ghostPlaced;                    // snap on the first frame, then interpolate
+        private const Single LerpRate = 12f;             // ghost smoothing rate (higher = snappier)
+
+        // Idempotent bootstrap -- mirrors Ff9mkDebugMenu.Ensure(). Called from HonoAwake on each field
+        // load; creates the DontDestroyOnLoad object ONCE, and only when [Netsync] Enabled=1.
+        public static void Ensure()
+        {
+            if (_instance != null)
+                return;
+            LoadConfig();
+            if (!_enabled)
+                return;   // off by default -> nothing created, no per-frame cost on a normal game
+            GameObject go = new GameObject("NetSyncClient");
+            UnityEngine.Object.DontDestroyOnLoad(go);
+            _instance = go.AddComponent<NetSyncClient>();
+        }
+
+        private static void LoadConfig()
+        {
+            if (_configLoaded)
+                return;
+            _configLoaded = true;
+            try
+            {
+                IniFile ini = new IniFile(IniFile.MemoriaIniPath);   // Memoria.IniFile: reads ./Memoria.ini
+                _enabled = ini.GetSetting("Netsync", "Enabled", "0").Trim() == "1";
+                _role = ini.GetSetting("Netsync", "Role", "selftest").Trim().ToLowerInvariant();
+                _peer = ini.GetSetting("Netsync", "PeerAddress", "127.0.0.1").Trim();
+                Int32 p;
+                if (Int32.TryParse(ini.GetSetting("Netsync", "Port", "49200"), out p) && p > 0)
+                    _port = p;
+                Int32 f;
+                if (Int32.TryParse(ini.GetSetting("Netsync", "TargetField", "30003"), out f))
+                    _targetField = f;
+                _relayUrl = ini.GetSetting("Netsync", "RelayUrl", "").Trim();
+                _sessionCode = ini.GetSetting("Netsync", "SessionCode", "").Trim();
+                _insecureTls = ini.GetSetting("Netsync", "InsecureTls", "0").Trim() == "1";
+                if (_relayUrl.Length > 0 && _sessionCode.Length == 0)
+                {
+                    if (_role == "host")
+                    {
+                        // The session code is the real access gate on the shared relay (it pairs by opaque
+                        // code): random so a stranger can't guess it, "ff9-" namespaced so it can never
+                        // cross-wire with another game's live session. Generated once, persisted into
+                        // Memoria.ini so it survives relaunches and the host can read it out to the guest.
+                        _sessionCode = GenerateSessionCode();
+                        PersistSessionCode(_sessionCode);
+                        Log.Message("[NetSync] generated session code " + _sessionCode +
+                                    " (saved to Memoria.ini; the guest must set the SAME SessionCode)");
+                    }
+                    else
+                    {
+                        // An empty code would pair with ANY other empty-code stranger on the relay --
+                        // refuse to connect instead (Update skips transport creation while the code is empty).
+                        Log.Message("[NetSync] SessionCode is empty -- set it to the host's code " +
+                                    "(shown in the host's Memoria.ini after their first launch)");
+                    }
+                }
+                Log.Message("[NetSync] config enabled=" + _enabled + " role=" + _role + " field=" + _targetField +
+                            (_relayUrl.Length > 0 ? " relay=" + _relayUrl + " code=" + _sessionCode
+                                                  : " peer=" + _peer + ":" + _port));
+            }
+            catch (Exception err) { Log.Error(err, "[NetSync] config load failed"); }
+        }
+
+        // "ff9-" + 8 random chars from [A-Z0-9]. The relay uppercases codes (pairing is case-insensitive);
+        // ~41 bits of entropy -- plenty for an unguessable rendezvous string.
+        private static String GenerateSessionCode()
+        {
+            const String alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+            Byte[] rnd = Guid.NewGuid().ToByteArray();
+            Char[] code = new Char[8];
+            for (Int32 i = 0; i < code.Length; i++)
+                code[i] = alphabet[rnd[i] % alphabet.Length];
+            return "ff9-" + new String(code);
+        }
+
+        // Write the generated code back into Memoria.ini [Netsync] with a targeted line edit (IniFile has
+        // no disk writer). Replaces an existing SessionCode line in the section, else inserts one right
+        // after the [Netsync] header. Best-effort: any failure just logs (the code still works this launch).
+        private static void PersistSessionCode(String code)
+        {
+            try
+            {
+                String[] lines = System.IO.File.ReadAllLines(IniFile.MemoriaIniPath);
+                System.Collections.Generic.List<String> outLines = new System.Collections.Generic.List<String>(lines.Length + 1);
+                Boolean inSection = false, written = false;
+                foreach (String line in lines)
+                {
+                    String trimmed = line.Trim();
+                    if (trimmed.StartsWith("[", StringComparison.Ordinal))
+                    {
+                        if (inSection && !written)
+                        {
+                            outLines.Add("SessionCode = " + code);   // section ended without the key -> insert
+                            written = true;
+                        }
+                        inSection = trimmed.StartsWith("[Netsync]", StringComparison.OrdinalIgnoreCase);
+                    }
+                    else if (inSection && !written)
+                    {
+                        Int32 eq = line.IndexOf('=');
+                        if (eq > 0 && line.Substring(0, eq).Trim().Equals("SessionCode", StringComparison.OrdinalIgnoreCase))
+                        {
+                            outLines.Add("SessionCode = " + code);
+                            written = true;
+                            continue;
+                        }
+                    }
+                    outLines.Add(line);
+                }
+                if (!written)
+                {
+                    if (!inSection)   // no [Netsync] section at all (shouldn't happen when Enabled=1)
+                        outLines.Add("[Netsync]");
+                    outLines.Add("SessionCode = " + code);
+                }
+                System.IO.File.WriteAllLines(IniFile.MemoriaIniPath, outLines.ToArray());
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] could not save the session code to Memoria.ini (still active this launch)");
+            }
+        }
+
+        private void Update()
+        {
+            // Cheap, log-silent gate: only do anything on the co-op field. Any failure reading the
+            // global state (e.g. a scene without it) is treated as "not here" without spamming the log.
+            Int32 fld;
+            try { fld = FF9StateSystem.Common.FF9.fldMapNo; }
+            catch { fld = -1; }
+
+            if (fld != _targetField)
+            {
+                DespawnGhost();
+                return;
+            }
+
+            try
+            {
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                if (ee == null || ee.fieldmap == null)
+                    return;
+
+                Actor local = ee.GetControlChar() as Actor;
+                if (local == null || local.fieldMapActor == null)
+                    return;   // player not fully spawned yet this frame
+
+                Transform pt = local.fieldMapActor.transform;
+
+                if (_role == "host" || _role == "client")
+                {
+                    if (_socket == null)
+                    {
+                        if (_relayUrl.Length > 0)
+                        {
+                            if (_sessionCode.Length == 0)
+                                return;   // guest without the host's code (see LoadConfig) -- never dial empty
+                            _socket = new NetSyncRelay(_relayUrl, _sessionCode, _role == "host" ? "host" : "guest", _insecureTls);
+                        }
+                        else
+                            _socket = new NetSyncSocket(_role == "host", _peer, _port);
+                        _socket.Start();
+                    }
+                    _socket.SetLocal(fld, local.anim, pt.localPosition, pt.localRotation);   // broadcast me
+                    RemoteState rs = _socket.GetRemote();                                     // apply the peer
+                    if (rs.Valid && rs.Field == fld)
+                    {
+                        EnsureGhost(ee);
+                        if (_ghost != null)
+                            DriveGhost(rs.Pos, rs.Rot, rs.Anim);
+                    }
+                    else
+                    {
+                        DespawnGhost();   // peer absent / in another field / stale
+                    }
+                }
+                else   // "selftest": mirror the local player, offset beside it (solo sanity check)
+                {
+                    EnsureGhost(ee);
+                    if (_ghost != null)
+                        DriveGhost(pt.localPosition + new Vector3(250f, 0f, 0f), pt.localRotation, local.anim);
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] update failed");
+            }
+        }
+
+        private void OnDestroy()
+        {
+            if (_socket != null)
+            {
+                _socket.Stop();
+                _socket = null;
+            }
+        }
+
+        // Spawn the ghost model once, using AddPlayer's proven model setup (CreateModel + AddAnim +
+        // the field-character shader), but without the controller/FieldMapActor (see class comment).
+        private void EnsureGhost(EventEngine ee)
+        {
+            if (_ghost != null)
+                return;
+            try
+            {
+                GameObject g = ModelFactory.CreateModel(GhostModelPath, false, true,
+                                                        Configuration.Graphics.ElementsSmoothTexture);
+                if (g == null)
+                {
+                    Log.Message("[NetSync] CreateModel returned null for " + GhostModelPath);
+                    return;
+                }
+                AnimationFactory.AddAnimToGameObject(g, GhostModel);
+                g.name = "NetSyncGhost";
+                g.SetActive(true);                                    // defensive: ensure the model is active
+                g.transform.parent = ee.fieldmap.transform;           // share the field's local frame
+                g.transform.localScale = new Vector3(-1f, -1f, 1f);   // AddPlayer's final scale
+                // Match the controlled player's field-render layer (the field camera's culling mask) and
+                // grab its renderers so the ghost can mirror which submeshes are shown.
+                Actor lp = ee.GetControlChar() as Actor;
+                Renderer[] playerRends = null;
+                if (lp != null && lp.fieldMapActor != null)
+                {
+                    SetLayerRecursive(g, lp.fieldMapActor.gameObject.layer);
+                    playerRends = lp.fieldMapActor.GetComponentsInChildren<Renderer>();
+                }
+
+                Renderer[] renderers = g.GetComponentsInChildren<Renderer>();
+                for (Int32 i = 0; i < renderers.Length; i++)
+                {
+                    Renderer renderer = renderers[i];
+                    // CreateModel enables ALL submeshes (incl. Zidane's dagger); the field player keeps the
+                    // sheathed weapon OFF. Mirror the player's per-submesh visibility so the ghost matches.
+                    renderer.enabled = (playerRends != null && i < playerRends.Length) ? playerRends[i].enabled : true;
+                    SkinnedMeshRenderer smr = renderer as SkinnedMeshRenderer;
+                    if (smr != null)
+                    {
+                        // FF9 characters live in far field-world space but are placed on screen by the PSX
+                        // projection IN THE SHADER, so normal frustum culling on the world bounds wrongly
+                        // hides them. Force huge local bounds so the renderer is never culled.
+                        smr.updateWhenOffscreen = false;
+                        smr.localBounds = new Bounds(Vector3.zero, new Vector3(100000f, 100000f, 100000f));
+                    }
+                    foreach (Material material in renderer.materials)
+                    {
+                        material.shader = ShadersLoader.Find(Configuration.Shaders.FieldCharacterShader);
+                        ModelFactory.SetMatFilter(material, Configuration.Graphics.ElementsSmoothTexture);
+                    }
+                }
+                NormalSolver.SmoothCharacterMesh(renderers);
+                _ghost = g;
+                _ghostAnim = g.GetComponent<Animation>();
+                if (_ghostAnim != null)
+                    _ghostAnim.wrapMode = WrapMode.Loop;   // default clips to looping
+                _ghostClip = null;
+                _ghostPlaced = false;                      // first DriveGhost snaps, then interpolates
+                Log.Message("[NetSync] ghost spawned on field " + _targetField);
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] ghost spawn failed");
+                _ghost = null;
+            }
+        }
+
+        // Position + rotate the ghost and mirror one animation clip (resolved from the FF9 anim id).
+        private void DriveGhost(Vector3 targetPos, Quaternion targetRot, UInt16 animId)
+        {
+            Transform t = _ghost.transform;
+            if (!_ghostPlaced)
+            {
+                t.localPosition = targetPos;      // snap on the first frame (correct initial placement)
+                t.localRotation = targetRot;
+                _ghostPlaced = true;
+            }
+            else
+            {
+                // exponential smoothing toward the latest known state -> hides network jitter/latency
+                Single a = 1f - Mathf.Exp(-LerpRate * Time.deltaTime);
+                t.localPosition = Vector3.Lerp(t.localPosition, targetPos, a);
+                t.localRotation = Quaternion.Slerp(t.localRotation, targetRot, a);
+            }
+            if (_ghostAnim == null)
+                return;
+            String clip = FF9DBAll.AnimationDB.GetValue((Int32)animId);
+            if (String.IsNullOrEmpty(clip) || clip == _ghostClip)
+                return;   // same clip already playing -- don't restart it every frame
+            if (!_ghostAnim.IsPlaying(clip))
+            {
+                AnimationFactory.AddAnimWithAnimatioName(_ghost, clip);
+                AnimationState st = _ghostAnim[clip];
+                if (st != null)
+                    st.wrapMode = WrapMode.Loop;   // locomotion clips loop; Play() alone runs one cycle then freezes
+                _ghostAnim.Play(clip);
+            }
+            _ghostClip = clip;
+        }
+
+        private void DespawnGhost()
+        {
+            if (_ghost != null)
+                UnityEngine.Object.Destroy(_ghost);
+            _ghost = null;
+            _ghostAnim = null;
+            _ghostClip = null;
+        }
+
+        private static void SetLayerRecursive(GameObject go, Int32 layer)
+        {
+            go.layer = layer;
+            foreach (Transform child in go.transform)
+                SetLayerRecursive(child.gameObject, layer);
+        }
+    }
+}
diff --git a/Assembly-CSharp/Memoria/Netsync/NetSyncRelay.cs b/Assembly-CSharp/Memoria/Netsync/NetSyncRelay.cs
new file mode 100644
index 00000000..2b89bff0
--- /dev/null
+++ b/Assembly-CSharp/Memoria/Netsync/NetSyncRelay.cs
@@ -0,0 +1,310 @@
+using System;
+using System.IO;
+using System.Net.Security;
+using System.Net.Sockets;
+using System.Security.Cryptography;
+using System.Text;
+using System.Threading;
+using Memoria.Prime;
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // Relay transport: a minimal RFC-6455 WebSocket CLIENT that connects to the shared byte-pump relay
+    // (jawn-relay: pairs a "host" + "guest" by session code and forwards binary frames verbatim). This
+    // solves NAT — both players dial OUT to the public relay, no port-forwarding/VPN. Same 34-byte payload
+    // as NetSyncSocket (reuses NetSyncSocket.Serialize/Deserialize), just wrapped in WS frames.
+    //
+    // URL: <RelayUrl>/sess/<CODE>?role=host|guest   e.g. ws://127.0.0.1:7777  or  wss://relay.example.com
+    // ⚠ ws:// = plaintext (needs a reachable plaintext endpoint or a local ws->wss bridge). wss:// uses
+    //   SslStream, which this old Unity Mono likely CANNOT negotiate (no TLS 1.2) — it will log + retry;
+    //   the supported path from FF9 is ws:// (to a bridge or a LAN/plaintext relay).
+    // ⚠ SessionCode must be UNIQUE to co-op (the relay cross-wires anyone sharing a code) — use "FF9-...".
+    //
+    // All socket I/O on background threads; the game thread only swaps lock-guarded slots (like NetSyncSocket).
+    public sealed class NetSyncRelay : INetTransport
+    {
+        private const String WsGuid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
+        private const Int32 StaleMs = 2000;
+
+        private readonly Boolean _secure;
+        private readonly String _host;
+        private readonly Int32 _port;
+        private readonly String _path;      // /sess/<CODE>?role=<role>
+        private readonly Boolean _insecureTls;
+
+        private volatile Boolean _running;
+        private Stream _stream;
+        private Thread _thread;
+
+        private readonly System.Object _lock = new System.Object();
+        private readonly System.Object _writeLock = new System.Object();   // serialize ALL frame writes (writer + pong)
+        private RemoteState _remote;
+        private Int32 _lastRecvTick;
+        private Byte[] _localPacket;
+        private UInt32 _maskCtr;
+
+        // relayUrl = scheme://host[:port] ; role = "host" | "guest" ; insecureTls accepts any wss cert.
+        public NetSyncRelay(String relayUrl, String sessionCode, String role, Boolean insecureTls)
+        {
+            _insecureTls = insecureTls;
+            String url = (relayUrl ?? "").Trim();
+            String scheme = "ws";
+            Int32 sep = url.IndexOf("://", StringComparison.Ordinal);
+            if (sep >= 0) { scheme = url.Substring(0, sep).ToLowerInvariant(); url = url.Substring(sep + 3); }
+            _secure = (scheme == "wss");
+            // strip any trailing path the user included; we own the /sess route
+            Int32 slash = url.IndexOf('/');
+            if (slash >= 0) url = url.Substring(0, slash);
+            Int32 colon = url.IndexOf(':');
+            if (colon >= 0)
+            {
+                _host = url.Substring(0, colon);
+                Int32 p; _port = Int32.TryParse(url.Substring(colon + 1), out p) ? p : (_secure ? 443 : 80);
+            }
+            else
+            {
+                _host = url;
+                _port = _secure ? 443 : 80;
+            }
+            String code = Uri.EscapeDataString((sessionCode ?? "").Trim());
+            _path = "/sess/" + code + "?role=" + role;
+            // keepalive sentinel so the peer always receives traffic (field 65535 -> filtered as "not here"),
+            // which keeps the ReceiveTimeout dead-peer detection honest even before we first enter the field.
+            _localPacket = NetSyncSocket.Serialize(65535, 0, Vector3.zero, Quaternion.identity);
+        }
+
+        public void Start()
+        {
+            _running = true;
+            _thread = new Thread(ConnectLoop) { IsBackground = true, Name = "NetSync-relay" };
+            _thread.Start();
+        }
+
+        public void Stop()
+        {
+            _running = false;
+            try { if (_stream != null) _stream.Close(); } catch { }
+        }
+
+        public void SetLocal(Int32 field, UInt16 anim, Vector3 pos, Quaternion rot)
+        {
+            Byte[] pkt = NetSyncSocket.Serialize(field, anim, pos, rot);
+            lock (_lock) { _localPacket = pkt; }
+        }
+
+        public RemoteState GetRemote()
+        {
+            lock (_lock)
+            {
+                if (_remote.Valid && (Environment.TickCount - _lastRecvTick) > StaleMs)
+                    return new RemoteState { Valid = false };
+                return _remote;
+            }
+        }
+
+        private void ConnectLoop()
+        {
+            while (_running)
+            {
+                Socket sock = null;
+                try
+                {
+                    sock = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
+                    sock.Connect(_host, _port);
+                    sock.NoDelay = true;
+                    // ⚠ MUST out-wait the relay's 60s pairing window: the relay forwards NOTHING until the
+                    // peer joins (and doesn't even read our socket while waiting), so a short timeout here
+                    // makes an unpaired host churn reconnects -- and each reconnect hits "slot taken" because
+                    // the relay hasn't noticed the old conn die. Dead-PAIRED-peer detection stays fast via
+                    // the 30 Hz keepalive + StaleMs; this long timeout only covers silent half-open sockets.
+                    sock.ReceiveTimeout = 75000;
+                    Stream stream = new NetworkStream(sock, true);
+                    if (_secure)
+                    {
+                        SslStream ssl = new SslStream(stream, false, ValidateCert);
+                        ssl.AuthenticateAsClient(_host);   // ⚠ likely fails on old Mono (no TLS 1.2)
+                        stream = ssl;
+                    }
+                    Handshake(stream);
+                    _stream = stream;
+                    Log.Message("[NetSync] relay connected " + (_secure ? "wss" : "ws") + "://" + _host + ":" + _port + _path);
+                    RunConnection(stream);
+                    Log.Message("[NetSync] relay disconnected; retrying");
+                }
+                catch (Exception err)
+                {
+                    Log.Message("[NetSync] relay connect to " + _host + ":" + _port + " failed (" + err.Message + ")");
+                }
+                finally
+                {
+                    try { if (sock != null) sock.Close(); } catch { }
+                    lock (_lock) { _remote = new RemoteState { Valid = false }; }
+                }
+                if (_running) Thread.Sleep(2000);
+            }
+        }
+
+        private Boolean ValidateCert(System.Object s, System.Security.Cryptography.X509Certificates.X509Certificate c,
+                                     System.Security.Cryptography.X509Certificates.X509Chain ch, SslPolicyErrors e)
+        {
+            return _insecureTls || e == SslPolicyErrors.None;
+        }
+
+        // --- RFC 6455 opening handshake (client) ---
+        private void Handshake(Stream stream)
+        {
+            Byte[] keyBytes = Guid.NewGuid().ToByteArray();            // 16 bytes, unique per connection
+            String key = Convert.ToBase64String(keyBytes);
+            StringBuilder req = new StringBuilder();
+            req.Append("GET ").Append(_path).Append(" HTTP/1.1\r\n");
+            req.Append("Host: ").Append(_host).Append(_secure ? "" : (":" + _port)).Append("\r\n");
+            req.Append("Upgrade: websocket\r\n");
+            req.Append("Connection: Upgrade\r\n");
+            req.Append("Sec-WebSocket-Key: ").Append(key).Append("\r\n");
+            req.Append("Sec-WebSocket-Version: 13\r\n\r\n");
+            Byte[] reqBytes = Encoding.ASCII.GetBytes(req.ToString());
+            stream.Write(reqBytes, 0, reqBytes.Length);
+            stream.Flush();
+
+            String resp = ReadHttpHeaders(stream);
+            if (resp.IndexOf(" 101", StringComparison.Ordinal) < 0)
+                throw new Exception("relay refused upgrade: " + resp.Split('\r')[0]);
+            String expect;
+            using (SHA1 sha = SHA1.Create())
+                expect = Convert.ToBase64String(sha.ComputeHash(Encoding.ASCII.GetBytes(key + WsGuid)));
+            if (resp.IndexOf(expect, StringComparison.Ordinal) < 0)
+                throw new Exception("relay bad Sec-WebSocket-Accept");
+        }
+
+        private static String ReadHttpHeaders(Stream stream)
+        {
+            // read byte-by-byte until CRLFCRLF (headers are small; avoids over-reading into frame data)
+            StringBuilder sb = new StringBuilder();
+            Int32 state = 0;   // matches \r \n \r \n
+            Byte[] one = new Byte[1];
+            while (state < 4)
+            {
+                Int32 n = stream.Read(one, 0, 1);
+                if (n <= 0) throw new Exception("relay closed during handshake");
+                Char c = (Char)one[0];
+                sb.Append(c);
+                if ((state % 2 == 0 && c == '\r') || (state % 2 == 1 && c == '\n')) state++;
+                else state = (c == '\r') ? 1 : 0;
+                if (sb.Length > 8192) throw new Exception("relay handshake headers too large");
+            }
+            return sb.ToString();
+        }
+
+        private void RunConnection(Stream stream)
+        {
+            Thread writer = new Thread(() => WriteLoop(stream)) { IsBackground = true, Name = "NetSync-relay-write" };
+            writer.Start();
+            try { ReadLoop(stream); }
+            finally { try { stream.Close(); } catch { } }
+        }
+
+        // --- send: client frames MUST be masked (RFC 6455 §5.3) ---
+        private void WriteLoop(Stream stream)
+        {
+            try
+            {
+                while (_running)
+                {
+                    Byte[] pkt;
+                    lock (_lock) { pkt = _localPacket; }
+                    if (pkt != null)
+                        WriteBinaryFrame(stream, pkt);
+                    Thread.Sleep(33);   // ~30 Hz
+                }
+            }
+            catch { /* disconnect -> ReadLoop finally cleans up */ }
+        }
+
+        private void WriteBinaryFrame(Stream stream, Byte[] payload)
+        {
+            Int32 len = payload.Length;                 // always 34 here (< 126)
+            Byte[] mask = new Byte[4];
+            UInt32 m;
+            lock (_lock) { m = unchecked(_maskCtr++ * 2654435761u) ^ (UInt32)Environment.TickCount; }
+            mask[0] = (Byte)(m); mask[1] = (Byte)(m >> 8); mask[2] = (Byte)(m >> 16); mask[3] = (Byte)(m >> 24);
+            Byte[] frame = new Byte[2 + 4 + len];
+            frame[0] = 0x82;                            // FIN + opcode 0x2 (binary)
+            frame[1] = (Byte)(0x80 | len);              // MASK bit + 7-bit length
+            frame[2] = mask[0]; frame[3] = mask[1]; frame[4] = mask[2]; frame[5] = mask[3];
+            for (Int32 i = 0; i < len; i++)
+                frame[6 + i] = (Byte)(payload[i] ^ mask[i & 3]);
+            lock (_writeLock) { stream.Write(frame, 0, frame.Length); stream.Flush(); }
+        }
+
+        // --- receive: server frames are NOT masked; handle binary + ping/close ---
+        private void ReadLoop(Stream stream)
+        {
+            Byte[] hdr = new Byte[2];
+            while (_running)
+            {
+                if (!ReadFull(stream, hdr, 2)) break;
+                Boolean fin = (hdr[0] & 0x80) != 0;
+                Int32 opcode = hdr[0] & 0x0F;
+                Boolean masked = (hdr[1] & 0x80) != 0;
+                Int64 len = hdr[1] & 0x7F;
+                if (len == 126)
+                {
+                    Byte[] ext = new Byte[2]; if (!ReadFull(stream, ext, 2)) break;
+                    len = (ext[0] << 8) | ext[1];
+                }
+                else if (len == 127)
+                {
+                    Byte[] ext = new Byte[8]; if (!ReadFull(stream, ext, 8)) break;
+                    len = 0; for (Int32 i = 0; i < 8; i++) len = (len << 8) | ext[i];
+                }
+                Byte[] mask = null;
+                if (masked) { mask = new Byte[4]; if (!ReadFull(stream, mask, 4)) break; }
+                if (len < 0 || len > 1 << 20) break;    // sanity cap (our payloads are tiny)
+                Byte[] payload = new Byte[(Int32)len];
+                if (len > 0 && !ReadFull(stream, payload, (Int32)len)) break;
+                if (masked && mask != null)
+                    for (Int32 i = 0; i < payload.Length; i++) payload[i] ^= mask[i & 3];
+
+                if (opcode == 0x8) break;               // close
+                if (opcode == 0x9) { WritePong(stream, payload); continue; }   // ping -> pong
+                if (opcode == 0xA) continue;            // pong
+                if ((opcode == 0x2 || opcode == 0x1) && fin && payload.Length == NetSyncSocket.PacketSize)
+                {
+                    RemoteState rs;
+                    if (NetSyncSocket.Deserialize(payload, out rs))
+                        lock (_lock) { _remote = rs; _lastRecvTick = Environment.TickCount; }
+                }
+                // (fragmented / oversized frames ignored -- our own sends are always single 34-byte frames)
+            }
+        }
+
+        private void WritePong(Stream stream, Byte[] appData)
+        {
+            Int32 len = appData != null ? Math.Min(appData.Length, 125) : 0;   // control frames <= 125
+            Byte[] mask = new Byte[4];
+            UInt32 m; lock (_lock) { m = unchecked(_maskCtr++ * 2654435761u); }
+            mask[0] = (Byte)m; mask[1] = (Byte)(m >> 8); mask[2] = (Byte)(m >> 16); mask[3] = (Byte)(m >> 24);
+            Byte[] frame = new Byte[2 + 4 + len];
+            frame[0] = 0x8A;                            // FIN + opcode 0xA (pong)
+            frame[1] = (Byte)(0x80 | len);
+            frame[2] = mask[0]; frame[3] = mask[1]; frame[4] = mask[2]; frame[5] = mask[3];
+            for (Int32 i = 0; i < len; i++) frame[6 + i] = (Byte)(appData[i] ^ mask[i & 3]);
+            try { lock (_writeLock) { stream.Write(frame, 0, frame.Length); stream.Flush(); } } catch { }
+        }
+
+        private static Boolean ReadFull(Stream stream, Byte[] buf, Int32 count)
+        {
+            Int32 off = 0;
+            while (off < count)
+            {
+                Int32 n;
+                try { n = stream.Read(buf, off, count - off); }
+                catch { return false; }
+                if (n <= 0) return false;
+                off += n;
+            }
+            return true;
+        }
+    }
+}
diff --git a/Assembly-CSharp/Memoria/Netsync/NetSyncSocket.cs b/Assembly-CSharp/Memoria/Netsync/NetSyncSocket.cs
new file mode 100644
index 00000000..816fd9af
--- /dev/null
+++ b/Assembly-CSharp/Memoria/Netsync/NetSyncSocket.cs
@@ -0,0 +1,244 @@
+using System;
+using System.IO;
+using System.Net;
+using System.Net.Sockets;
+using System.Threading;
+using Memoria.Prime;
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // One peer's latest state (plain data; produced on the socket thread, consumed on the game thread).
+    public struct RemoteState
+    {
+        public Boolean Valid;
+        public Int32 Field;   // the peer's current fldMapNo
+        public UInt16 Anim;   // FF9 animation id (resolved to a clip name by the receiver)
+        public Vector3 Pos;   // the peer player's transform.localPosition (same field frame -> 1:1)
+        public Quaternion Rot;
+    }
+
+    // Common surface for both transports (direct TCP + relay WebSocket) so NetSyncClient stays
+    // transport-agnostic. Start/Stop may be called from any thread; SetLocal/GetRemote from the game thread.
+    public interface INetTransport
+    {
+        void Start();
+        void Stop();
+        void SetLocal(Int32 field, UInt16 anim, Vector3 pos, Quaternion rot);
+        RemoteState GetRemote();
+    }
+
+    // TCP transport for co-op ghost sync. One side is HOST (listens), the other CLIENT (connects to the
+    // host's LAN IP). Once connected, BOTH sides symmetrically send their own state every tick and receive
+    // the peer's. ALL socket I/O runs on background threads; the game thread only swaps lock-guarded slots
+    // (Unity objects are touched only by NetSyncClient on the main thread). Auto-reconnects on drop, so
+    // relaunching one instance re-pairs. Modeled on Memoria.Test.GameObjectService (proven TCP in-engine).
+    public sealed class NetSyncSocket : INetTransport
+    {
+        private readonly Boolean _isHost;
+        private readonly String _peerAddress;
+        private readonly Int32 _port;
+
+        private volatile Boolean _running;
+        private Socket _conn;
+        private Thread _acceptThread;
+
+        private readonly System.Object _lock = new System.Object();
+        private RemoteState _remote;      // latest peer state (guarded)
+        private Int32 _lastRecvTick;      // Environment.TickCount of the last received packet (guarded)
+        private Byte[] _localPacket;      // latest local packet to send (guarded)
+
+        private const Int32 StaleMs = 2000;   // no packet for this long -> treat the peer as gone
+
+        public NetSyncSocket(Boolean isHost, String peerAddress, Int32 port)
+        {
+            _isHost = isHost;
+            _peerAddress = peerAddress;
+            _port = port;
+        }
+
+        public void Start()
+        {
+            _running = true;
+            _acceptThread = new Thread(_isHost ? (ThreadStart)HostLoop : ClientLoop)
+            {
+                IsBackground = true,
+                Name = "NetSync-" + (_isHost ? "host" : "client"),
+            };
+            _acceptThread.Start();
+        }
+
+        public void Stop()
+        {
+            _running = false;
+            try { if (_conn != null) _conn.Close(); } catch { }
+        }
+
+        // Game thread: publish my current state (serialized immediately so the caller's Vector3 is copied).
+        public void SetLocal(Int32 field, UInt16 anim, Vector3 pos, Quaternion rot)
+        {
+            Byte[] pkt = Serialize(field, anim, pos, rot);
+            lock (_lock) { _localPacket = pkt; }
+        }
+
+        // Game thread: the peer's latest state, or Valid=false if none / stale (peer left field or dropped).
+        public RemoteState GetRemote()
+        {
+            lock (_lock)
+            {
+                if (_remote.Valid && (Environment.TickCount - _lastRecvTick) > StaleMs)
+                    return new RemoteState { Valid = false };
+                return _remote;
+            }
+        }
+
+        private void HostLoop()
+        {
+            TcpListener listener = null;
+            try
+            {
+                listener = new TcpListener(IPAddress.Any, _port);
+                listener.Start();
+                Log.Message("[NetSync] host listening on port " + _port);
+                while (_running)
+                {
+                    Socket s = listener.AcceptSocket();   // blocks until a client connects
+                    Log.Message("[NetSync] peer connected: " + s.RemoteEndPoint);
+                    HandleConnection(s);
+                    Log.Message("[NetSync] peer disconnected; awaiting reconnect");
+                }
+            }
+            catch (Exception err) { Log.Error(err, "[NetSync] host loop failed"); }
+            finally { try { if (listener != null) listener.Stop(); } catch { } }
+        }
+
+        private void ClientLoop()
+        {
+            while (_running)
+            {
+                try
+                {
+                    Socket s = new Socket(AddressFamily.InterNetwork, SocketType.Stream, ProtocolType.Tcp);
+                    s.Connect(_peerAddress, _port);
+                    Log.Message("[NetSync] connected to host " + _peerAddress + ":" + _port);
+                    HandleConnection(s);
+                    Log.Message("[NetSync] lost host; retrying");
+                }
+                catch (Exception err)
+                {
+                    Log.Message("[NetSync] connect to " + _peerAddress + ":" + _port + " failed (" + err.Message + ")");
+                }
+                if (_running) Thread.Sleep(2000);   // retry backoff
+            }
+        }
+
+        // Both roles: run a write thread + a read loop on the connected socket until it drops.
+        private void HandleConnection(Socket s)
+        {
+            s.NoDelay = true;
+            _conn = s;
+            Thread writer = new Thread(() => WriteLoop(s)) { IsBackground = true, Name = "NetSync-write" };
+            writer.Start();
+            try
+            {
+                ReadLoop(s);   // blocks until disconnect/error
+            }
+            finally
+            {
+                try { s.Close(); } catch { }
+                lock (_lock) { _remote = new RemoteState { Valid = false }; }   // clear the peer on drop
+            }
+        }
+
+        private void ReadLoop(Socket s)
+        {
+            Byte[] buf = new Byte[PacketSize];
+            using (NetworkStream stream = new NetworkStream(s, FileAccess.Read, false))
+            {
+                while (_running && s.Connected)
+                {
+                    if (!ReadFull(stream, buf, PacketSize))
+                        break;   // disconnected / error
+                    RemoteState rs;
+                    if (Deserialize(buf, out rs))
+                        lock (_lock) { _remote = rs; _lastRecvTick = Environment.TickCount; }
+                }
+            }
+        }
+
+        private void WriteLoop(Socket s)
+        {
+            try
+            {
+                using (NetworkStream stream = new NetworkStream(s, FileAccess.Write, false))
+                {
+                    while (_running && s.Connected)
+                    {
+                        Byte[] pkt;
+                        lock (_lock) { pkt = _localPacket; }
+                        if (pkt != null)
+                            stream.Write(pkt, 0, pkt.Length);
+                        Thread.Sleep(33);   // ~30 Hz
+                    }
+                }
+            }
+            catch { /* disconnect -> ReadLoop's finally cleans up */ }
+        }
+
+        private static Boolean ReadFull(Stream stream, Byte[] buf, Int32 count)
+        {
+            Int32 off = 0;
+            while (off < count)
+            {
+                Int32 n;
+                try { n = stream.Read(buf, off, count - off); }
+                catch { return false; }
+                if (n <= 0) return false;   // graceful close
+                off += n;
+            }
+            return true;
+        }
+
+        // --- wire format: magic + version + field(u16) + anim(u16) + pos(3f) + rot(4f) = 34 bytes ---
+        internal const Int32 PacketSize = 34;
+        private const Byte Magic = 0xF9;
+        private const Byte Version = 1;
+
+        internal static Byte[] Serialize(Int32 field, UInt16 anim, Vector3 pos, Quaternion rot)
+        {
+            Byte[] b = new Byte[PacketSize];
+            using (MemoryStream ms = new MemoryStream(b))
+            using (BinaryWriter bw = new BinaryWriter(ms))
+            {
+                bw.Write(Magic);
+                bw.Write(Version);
+                bw.Write((UInt16)field);
+                bw.Write(anim);
+                bw.Write(pos.x); bw.Write(pos.y); bw.Write(pos.z);
+                bw.Write(rot.x); bw.Write(rot.y); bw.Write(rot.z); bw.Write(rot.w);
+            }
+            return b;
+        }
+
+        internal static Boolean Deserialize(Byte[] buf, out RemoteState rs)
+        {
+            rs = new RemoteState();
+            if (buf.Length < PacketSize || buf[0] != Magic)
+                return false;
+            using (MemoryStream ms = new MemoryStream(buf))
+            using (BinaryReader br = new BinaryReader(ms))
+            {
+                br.ReadByte();                         // magic
+                br.ReadByte();                         // version
+                rs.Field = br.ReadUInt16();
+                rs.Anim = br.ReadUInt16();
+                Single px = br.ReadSingle(), py = br.ReadSingle(), pz = br.ReadSingle();
+                Single rx = br.ReadSingle(), ry = br.ReadSingle(), rz = br.ReadSingle(), rw = br.ReadSingle();
+                rs.Pos = new Vector3(px, py, pz);
+                rs.Rot = new Quaternion(rx, ry, rz, rw);
+                rs.Valid = true;
+                return true;
+            }
+        }
+    }
+}
