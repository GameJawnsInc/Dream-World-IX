+    // [ff9mapkit s37] Collect one guest-owned slot's LIVE command menus for the co-op roster frame --
+    // mirrors DisplayAbility / GetAbilityState / DisplayItem with the SAME helpers, just without a UI
+    // (and per-slot: nothing here reads CurrentPlayerIndex). Flat Int32 lists keep the call dumb:
+    //   commands  += (menu, commandId, commandType, targetInfo) per Attack/Ability1/Ability2 menu
+    //   abilities += (menu, activeAbilityId, mpCost, enabled, targetType, forDead) per shown ability
+    //   items     += (itemId, count, targetType, forDead) per battle-usable inventory item
+    // where targetInfo/targetType = (Int32)TargetType and forDead/enabled are 0/1. Unlearned
+    // (AbilityStatus.None) abilities are omitted; Disable'd ones ship with enabled=0 (grayed remotely,
+    // and re-validated live at injection anyway). Trance is handled by GetCommandFromCommandIndex.
+    public void CollectNetMenus(Int32 playerIndex, List<Int32> commands, List<Int32> abilities, List<Int32> items)
+    {
+        BattleUnit unit = FF9StateSystem.Battle.FF9Battle.GetUnit(playerIndex);
+        SetAbilityAp(_abilityDetailDict[playerIndex]);
+        BattleCommandMenu[] menus = { BattleCommandMenu.Attack, BattleCommandMenu.Ability1, BattleCommandMenu.Ability2 };
+        foreach (BattleCommandMenu menu in menus)
+        {
+            BattleCommandId cmdId = GetCommandFromCommandIndex(menu, playerIndex);
+            if (cmdId == BattleCommandId.None || !CharacterCommands.Commands.ContainsKey(cmdId))
+                continue;
+            CharacterCommand ff9Command = CharacterCommands.Commands[cmdId];
+            if (CommandIsMonsterTransformCommand(playerIndex, cmdId, out _))
+                continue;   // monster-transform menus are out of the co-op v1 scope
+            Int32 targetInfo = 0;
+            if (ff9Command.Type == CharacterCommandType.Normal || ff9Command.Type == CharacterCommandType.Instant)
+            {
+                // single-ability commands (Attack, Focus, ...): their target semantics come from the AA
+                foreach (BattleAbilityId active in ff9Command.EnumerateAbilities())
+                {
+                    BattleAbilityId patched = BattleAbilityHelper.Patch(active, unit.Player);
+                    AA_DATA aa = FF9StateSystem.Battle.FF9Battle.aa_data[patched];
+                    targetInfo = (Int32)aa.Info.Target | (aa.Info.ForDead ? 0x80 : 0);
+                    break;
+                }
+            }
+            commands.Add((Int32)menu);
+            commands.Add((Int32)cmdId);
+            commands.Add((Int32)ff9Command.Type);
+            commands.Add(targetInfo);
+            if (ff9Command.Type == CharacterCommandType.Ability)
+            {
+                foreach (BattleAbilityId active in ff9Command.EnumerateAbilities())
+                {
+                    Int32 abilId = ff9abil.GetAbilityIdFromActiveAbility(active);
+                    AbilityStatus state = GetAbilityState(abilId, playerIndex);
+                    if (state == AbilityStatus.None)
+                        continue;   // not learned/equipped -> not in the menu at all
+                    BattleAbilityId patched = BattleAbilityHelper.Patch(active, unit.Player);
+                    AA_DATA aa = FF9StateSystem.Battle.FF9Battle.aa_data[patched];
+                    abilities.Add((Int32)menu);
+                    abilities.Add((Int32)active);
+                    abilities.Add(GetActionMpCost(aa, unit, patched, false));
+                    abilities.Add(state == AbilityStatus.Enable ? 1 : 0);
+                    abilities.Add((Int32)aa.Info.Target);
+                    abilities.Add(aa.Info.ForDead ? 1 : 0);
+                }
+            }
+        }
+        // The Item menu (shared inventory; the same filter DisplayItem applies for the plain Item command)
+        BattleCommandId itemCmdId = GetCommandFromCommandIndex(BattleCommandMenu.Item, playerIndex);
+        if (itemCmdId != BattleCommandId.None && CharacterCommands.Commands.ContainsKey(itemCmdId))
+        {
+            CharacterCommand itemCommand = CharacterCommands.Commands[itemCmdId];
+            foreach (FF9ITEM ff9Item in FF9StateSystem.Common.FF9.item)
+            {
+                if (ff9Item.count <= 0)
+                    continue;
+                FF9ITEM_DATA itemData = ff9item._FF9Item_Data[ff9Item.id];
+                Boolean canBeUsed = ff9item.HasItemEffect(ff9Item.id) && (itemData.type & ItemType.Item) != 0;
+                if (canBeUsed && !String.IsNullOrEmpty(itemData.use_condition))
+                {
+                    if (itemCommand.OnlySpecificItem && !itemData.use_condition.Contains("CommandId"))
+                    {
+                        canBeUsed = false;
+                    }
+                    else
+                    {
+                        NCalc.Expression c = new NCalc.Expression(itemData.use_condition);
+                        NCalc.NCalcUtility.InitializeExpressionUnit(ref c, unit);
+                        c.Parameters["CommandId"] = (Int32)itemCmdId;
+                        c.Parameters["CommandMenu"] = (Int32)BattleCommandMenu.Item;
+                        c.EvaluateFunction += NCalc.NCalcUtility.commonNCalcFunctions;
+                        c.EvaluateParameter += NCalc.NCalcUtility.commonNCalcParameters;
+                        canBeUsed = NCalc.NCalcUtility.EvaluateNCalcCondition(c.Evaluate());
+                    }
+                }
+                else if (canBeUsed && itemCommand.OnlySpecificItem)
+                {
+                    canBeUsed = false;
+                }
+                if (!canBeUsed || !ff9item.HasItemEffect(ff9Item.id))
+                    continue;
+                ITEM_DATA effect = ff9item.GetItemEffect(ff9Item.id);
+                items.Add((Int32)ff9Item.id);
+                items.Add(ff9Item.count);
+                items.Add((Int32)effect.info.Target);
+                items.Add(effect.info.ForDead ? 1 : 0);
+            }
+        }
+    }
