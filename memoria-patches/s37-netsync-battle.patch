diff --git a/Assembly-CSharp/Memoria/Netsync/NetSyncState.cs b/Assembly-CSharp/Memoria/Netsync/NetSyncState.cs
new file mode 100644
index 00000000..ac3e1607
--- /dev/null
+++ b/Assembly-CSharp/Memoria/Netsync/NetSyncState.cs
@@ -0,0 +1,191 @@
+using System;
+using Assets.Scripts.Common;    // SceneDirector / FadeMode / SceneTransition (the load transition)
+using Assets.SiliconSocial;     // AchievementManager
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // THE STATE-MIRROR PAYLOAD (wire TypeState) -- the authoritative-host "play the standard game together"
+    // substrate. A field's Main_Init decides what to render (NPCs / doors / branches / cutscene beats) by
+    // reading gEventGlobal (every EBin GLOB read routes to FF9StateSystem.EventState.gEventGlobal), so if
+    // the guest's gEventGlobal MATCHES the host's at field-load, the field stages identically. This is the
+    // F6 Snapshot/RestoreSnapshot primitive (a whole-array Array.Copy) put on the wire, HOST->GUEST only.
+    //
+    // The payload is SECTION-TAGGED so the one lane extends without another wire break:
+    //     payload := section+   where section := [sectionId u8][len u16 LE][bytes[len]]
+    //     section 0 = gEventGlobal snapshot (2048 B)            -- RUNG 1 (this file)
+    //     sections 1-3 = party / key items / bag (NetSyncParty) -- RUNG 2 (the party mirror; the
+    //                    party section doubles as the diorama's actor-spawn input)
+    //
+    // Bytes 2032-2041 are MASKED out of both the snapshot and the apply: those are the netsync coop cells
+    // (2032-2039, NetSyncClient.WriteCoopCells) + reserved + the choice-mask scratch (2040). Copying the
+    // host's coop-cell view onto the guest would poison the guest's own [[coop]] gates.
+    //
+    // gEventGlobal is the AUTHORITATIVE save-backed story heap. The session's save-safety is a PAIR of
+    // guards: while mirroring, the guest can neither manual-save (SaveLoadUI gates on IsMirroringStory) nor
+    // autosave (EventEngine's noSave ladder), so the DISK stays pristine; when the session ends, the guest
+    // exits through ExitMirrorToOwnSave (below) -- their own AUTOSAVE is reloaded, never an in-place flag
+    // restore, so the base game can never be left in a state it cannot itself produce (own flags at the
+    // host's location = sequence breaks). Read the array FRESH every call: EventEngine.InitEvents replaces
+    // the reference.
+    internal static class NetSyncState
+    {
+        public const Byte SectionStory = 0;     // gEventGlobal
+        private const Int32 StoryLen = 2048;    // FF9StateSystem.EventState.gEventGlobal is Byte[2048]
+        private const Int32 MaskLo = 2032;      // coop cells 2032-2039 + reserved 2033/2038-2039 + scratch 2040
+        private const Int32 MaskHi = 2041;      // ... never carried; the guest keeps its own
+
+        // HOST (game thread): serialize my live gEventGlobal into a TypeState payload (coop cells zeroed).
+        // Returns null if no event state is loaded yet.
+        public static Byte[] SnapshotStory()
+        {
+            Byte[] g;
+            try { g = FF9StateSystem.EventState.gEventGlobal; }
+            catch { return null; }
+            if (g == null || g.Length < StoryLen)
+                return null;
+            Byte[] frame = new Byte[3 + StoryLen];
+            frame[0] = SectionStory;
+            frame[1] = (Byte)(StoryLen & 0xFF);
+            frame[2] = (Byte)((StoryLen >> 8) & 0xFF);
+            Array.Copy(g, 0, frame, 3, StoryLen);
+            for (Int32 i = MaskLo; i <= MaskHi; i++)
+                frame[3 + i] = 0;               // do not ship the host's coop-cell view
+            return frame;
+        }
+
+        // HOST (game thread): the full published snapshot -- the story section plus the party-mirror
+        // sections (1-3, NetSyncParty), one frame = one consistent snapshot. Party absent (title
+        // screen etc.) -> the story section ships alone, exactly like rung 1.
+        public static Byte[] SnapshotAll()
+        {
+            Byte[] story = SnapshotStory();
+            if (story == null)
+                return null;
+            Byte[] party = NetSyncParty.SerializeSections();
+            if (party == null || party.Length == 0)
+                return story;
+            Byte[] both = new Byte[story.Length + party.Length];
+            Array.Copy(story, 0, both, 0, story.Length);
+            Array.Copy(party, 0, both, story.Length, party.Length);
+            return both;
+        }
+
+        // GUEST (game thread): apply a received TypeState payload onto my live gEventGlobal -- section 0
+        // only, skipping the masked window so my own coop cells survive -- and consume the party-mirror
+        // sections into NetSyncParty's read-wrap statics (same field-load boundary = one consistency
+        // domain: the field stages from one snapshot). Returns true if a story section was applied.
+        // Must run BEFORE the field's Main_Init reads a GLOB var.
+        public static Boolean ApplyStory(Byte[] payload)
+        {
+            Byte[] g;
+            try { g = FF9StateSystem.EventState.gEventGlobal; }
+            catch { return false; }
+            Boolean applied = ApplyStoryTo(payload, g);
+            if (applied)
+                NetSyncParty.ParseSections(payload);
+            return applied;
+        }
+
+        // The real section-walking apply, targetable so SelfTest can prove THIS exact loop against a
+        // scratch buffer without touching the live array. ApplyStory above is a thin live-array wrapper.
+        internal static Boolean ApplyStoryTo(Byte[] payload, Byte[] target)
+        {
+            if (payload == null || target == null || target.Length < StoryLen)
+                return false;
+            Int32 off = 0;
+            Boolean applied = false;
+            while (off + 3 <= payload.Length)
+            {
+                Byte sectionId = payload[off];
+                Int32 len = payload[off + 1] | (payload[off + 2] << 8);
+                Int32 body = off + 3;
+                if (body + len > payload.Length)
+                    break;                       // truncated -- ignore the rest
+                if (sectionId == SectionStory && len == StoryLen)
+                {
+                    for (Int32 i = 0; i < StoryLen; i++)
+                        if (i < MaskLo || i > MaskHi)
+                            target[i] = payload[body + i];
+                    applied = true;
+                }
+                off = body + len;
+            }
+            return applied;
+        }
+
+        // SESSION EXIT RAMP (game thread): un-mirroring by restoring flags IN PLACE would leave the
+        // guest's OWN story standing at the HOST's location -- a frankenstate the base game can never
+        // produce (sequence breaks, softlocks behind staging the guest's story never built). Instead the
+        // guest leaves a session the way the game itself resumes one: by loading the AUTOSAVE. The
+        // EventEngine autosave guard keeps the Continue slot pristine for the whole session, so it IS the
+        // coherent pre-session (story, position, party) tuple; "leaving co-op = Continue" is stock
+        // semantics. The load transition below is the moogle-menu mid-game load, verbatim
+        // (SaveLoadUI.OnFinishedLoadFile_delay); a file with no autosave yet (brand-new game) falls back
+        // to the title screen, same as a game over. Caller (NetSyncClient.Update) defers the call until
+        // the guest is free-standing on a field / the world map.
+        public static void ExitMirrorToOwnSave()
+        {
+            FF9StateSystem.Serializer.Autoload(null, delegate (DataSerializerErrorCode errNo, Boolean success)
+            {
+                if (success && errNo == DataSerializerErrorCode.Success)
+                {
+                    Memoria.Prime.Log.Message("[NetSync] session ended -> reloading own autosave (Continue)");
+                    SoundLib.StopMovieMusic("FMV000", true);
+                    FF9StateSystem.Settings.SetSound();
+                    FF9StateSystem.Settings.SetSoundEffect();
+                    PersistenSingleton<EventEngine>.Instance.ReplaceLoadMap();
+                    PersistenSingleton<UIManager>.Instance.TitleScene.SplashScreenEnabled = true;
+                    AchievementManager.ResyncNormalAchievements();
+                    FF9StateSystem.Settings.UpdateSetting();
+                    ff9.w_frameNewSession();
+                    SceneDirector.FadeEventSetColor(FadeMode.Sub, Color.white);
+                }
+                else
+                {
+                    Memoria.Prime.Log.Message("[NetSync] session ended, no autosave to resume -> title screen");
+                    SceneDirector.Replace("Title", SceneTransition.FadeOutToBlack_FadeIn, true);
+                }
+            });
+        }
+
+        // SOLO CODEC PROOF (selftest): snapshot -> the REAL wire encode/decode (BuildFrame/TryParseHeader)
+        // -> the REAL ApplyStoryTo section walk, into a scratch buffer -> compare vs the live array (minus
+        // the mask, on both sides), WITHOUT mutating anything. This certifies the exact code path a
+        // two-machine apply runs, solo -- not just the header math.
+        public static Boolean SelfTest()
+        {
+            Byte[] g;
+            try { g = FF9StateSystem.EventState.gEventGlobal; }
+            catch { return false; }
+            if (g == null || g.Length < StoryLen)
+                return false;
+            Byte[] payload = SnapshotStory();
+            if (payload == null)
+                return false;
+            // round-trip the real frame codec, exactly as a peer would receive it
+            Byte[] frame = NetSyncWire.BuildFrame(NetSyncWire.TypeState, payload);
+            Byte type;
+            Int32 len;
+            if (!NetSyncWire.TryParseHeader(frame, out type, out len))
+                return false;
+            if (type != NetSyncWire.TypeState || len != payload.Length
+                || frame.Length != NetSyncWire.HeaderSize + len)
+                return false;
+            Byte[] received = new Byte[len];
+            Array.Copy(frame, NetSyncWire.HeaderSize, received, 0, len);
+            // the real apply loop, aimed at a scratch target (never the live array)
+            Byte[] scratch = new Byte[StoryLen];
+            if (!ApplyStoryTo(received, scratch))
+                return false;
+            for (Int32 i = 0; i < StoryLen; i++)
+            {
+                if (i >= MaskLo && i <= MaskHi)
+                    continue;                    // masked -> intentionally not carried
+                if (scratch[i] != g[i])
+                    return false;
+            }
+            return true;
+        }
+    }
+}
