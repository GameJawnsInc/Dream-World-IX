+    public BattleCommandId NetCommandForMenu(Int32 playerIndex, Int32 menu)
+    {
+        try
+        {
+            BattleCommandId cmdId = GetCommandFromCommandIndex((BattleCommandMenu)menu, playerIndex);
+            return CharacterCommands.Commands.ContainsKey(cmdId) ? cmdId : BattleCommandId.None;
+        }
+        catch { return BattleCommandId.None; }
+    }
+
