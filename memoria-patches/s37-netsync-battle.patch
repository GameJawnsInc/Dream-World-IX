+    //   B1  "networked controller 2": [Netsync] GuestSlots = <bitmask of party slots 0-3> hands those
+    //       slots to the PEER. The local battle HUD skips them (BattleHUD hooks call IsGuestOwnedSlot);
+    //       the peer walks a digit-menu (commands -> abilities/items -> target) fed by a type-4 ROSTER
+    //       frame (menu CONTENT: ability/item ids -- display names resolve from the guest's own install,
+    //       both machines run the same game data), and the arriving type-2 command frame is validated
+    //       live then queued through BattleHUD.SendNetCommand -- the engine's own auto-battle pattern.
+    //
+    // The battle always runs on ONE machine (whoever is fighting); the other side only renders state
+    // and sends commands. There is deliberately NO battle-sim mirroring (see the study: lockstep is a
+    // dead end in this engine).
+    //
+    // FAIL-SAFE LAWS (same as the ghost lane): everything is gated on Enabled + GuestSlots; the peer
+    // stale/disconnected -> RemoteMenuOpen decays in ~2.5s and the ready-loop skip stops (slots revert
+    // to local control); any exception is swallowed into a log line and the vanilla battle continues.
+    public static class NetSyncBattle
+    {
+        // --- config mirror (written by NetSyncClient on every config [re]load; main thread) ---
+        public static Boolean Enabled;      // [Netsync] Enabled
+        public static Int32 GuestSlots;     // [Netsync] GuestSlots -- bitmask of MY party slots the PEER commands
+        public static Boolean SelfTest;     // role=selftest -> loopback my own battle through the full codec
+
+        // "the peer's battle panel is live" -- read by NetSyncClient to quiet the idle overlay
+        public static Boolean PeerBattleLive { get; private set; }
+
+        // "the assist panel is awaiting MY command right now" -- read by the UIKeyTrigger hook so the
+        // digit keys are swallowed before any bound game key fires (Alpha1 = the default help/Select
+        // binding; a playtest press opened the help menu AND attacked).
+        public static Boolean AssistInputActive { get; private set; }
+
+        private const Int32 SampleMs = 150;        // battle-state sampling cadence (write loop re-sends at 30 Hz)
+        private const Int32 RosterMs = 1000;       // roster recompute cadence (sent only when its bytes change)
+        private const Int32 StaleMs = 2000;        // parsed peer view older than this -> hide the panel
+        private const Int32 MenuStaleMs = 2500;    // control-frame freshness window for RemoteMenuOpen + slot reverts
+        private const Int32 InputCooldownMs = 700; // swallow assist keys briefly after sending a command
+        private const Int32 PageSize = 6;          // ability/item list entries per panel page
+
+        // command-frame actions (u8 on the wire)
+        private const Int32 ActAttack = 0, ActDefend = 1, ActAbility = 2, ActItem = 3, ActInstant = 4;
+
+        // ================================================================== outgoing (my own battle)
+        private static UInt16 _seq;
+        private static Int32 _lastSampleTick;
+        private static Int32 _lastRosterTick;
+        private static Byte[] _lastRosterBytes;
+        private static Boolean _wasInBattle;
+
+        // ================================================================== incoming (the peer's battle)
+        private sealed class UnitView
+        {
+            public Int32 Index;
+            public Boolean IsPlayer;
+            public Boolean Alive;
+            public Boolean Ready;
+            public Boolean InTrance;
+            public UInt32 HpCur, HpMax, MpCur, MpMax;
+            public UInt16 AtbCur, AtbMax;
+            public String Name;
+        }
+
+        private sealed class BattleView
+        {
+            public UInt16 Seq;
+            public UInt16 MapNo;
+            public Int32 GuestSlots;       // the slots the BATTLE OWNER is offering to me
+            public readonly List<UnitView> Units = new List<UnitView>();
+        }
+
+        private sealed class CmdView
+        {
+            public Int32 Menu;             // BattleCommandMenu raw value (Attack / Ability1 / Ability2)
+            public Int32 CmdId;
+            public Int32 Type;             // CharacterCommandType raw value
+            public Int32 TargetType;       // for Normal/Instant commands (packed forDead in bit 7)
+            public Boolean ForDead { get { return (TargetType & 0x80) != 0; } }
+            public Int32 Target { get { return TargetType & 0x7F; } }
+            public readonly List<AbilView> Abilities = new List<AbilView>();
+        }
+
+        private sealed class AbilView
+        {
+            public Int32 Id;               // BattleAbilityId (active space -- what SetCommand's sub_no wants)
+            public Int32 Mp;
+            public Boolean Enabled;
+            public Int32 TargetType;
+            public Boolean ForDead;
+        }
+
+        private sealed class ItemView
+        {
+            public Int32 Id;               // RegularItem
+            public Int32 Count;
+            public Int32 TargetType;
+            public Boolean ForDead;
+        }
+
+        private sealed class RosterView
+        {
+            public readonly Dictionary<Int32, List<CmdView>> Slots = new Dictionary<Int32, List<CmdView>>();
+            public readonly List<ItemView> Items = new List<ItemView>();
+        }
+
+        private static BattleView _peerView;
+        private static Int32 _peerViewTick;
+        private static RosterView _peerRoster;
+        private static Int32 _lastSendTick;        // assist-key cooldown
+        private static Int32 _pendingSlot = -1;    // slot we just commanded (panel shows "sent")
+
+        // guest menu state machine (digits): Root -> Ability/Item list -> Target pick
+        private const Int32 UiRoot = 0, UiAbility = 1, UiItem = 2, UiTarget = 3;
+        private static Int32 _uiMode = UiRoot;
+        private static Int32 _uiSlot = -1;         // the slot the UI is currently serving (reset on change)
+        private static CmdView _uiCmd;             // the command whose ability list is open
+        private static Int32 _uiPage;
+        private static Int32 _pendAction;          // command under construction, awaiting a target
+        private static Int32 _pendMenu;
+        private static Int32 _pendId;
+        private static Int32 _pendTargetType;
+        private static Boolean _pendForDead;
+        private static Int32 _uiReturnMode;        // where [0] from the target pick goes back to
+
+        // host side of the control lane: the peer said their assist menu is open
+        private static Boolean _remoteMenuFlag;
+        private static Int32 _remoteMenuTick;
+        // ...and the peer is ACTIVELY ASSISTING at all (fresh control frames only flow while they
+        // spectate my battle). Guest gone / disconnected / busy in their OWN battle -> this decays
+        // and the slots REVERT TO LOCAL CONTROL (the fail-safe law).
+        private static Int32 _assistTick = Int32.MinValue;
+
+        // selftest loopback state (stands in for the socket)
+        private static Byte[] _loopBattle;
+        private static Byte[] _loopRoster;
+        private static readonly Queue<Byte[]> _loopCommands = new Queue<Byte[]>();
+        private static Boolean _loopMenuOpen;
+
+        // GUI
+        private static Texture2D _panelBg;
+        private static GUIStyle _panelStyle;
+
+        // ============================================================================ BattleHUD hooks
+        // Both hooks are read from engine code paths every frame -- they must be CHEAP and can never
+        // throw. When the feature is off they are a couple of integer compares (zero footprint).
+
+        // The local HUD must not open a menu for a slot the peer owns (BattleHUD ready loop / switch
+        // paths call this). Only meaningful while I am the one in battle. A slot counts as
+        // guest-owned only while the guest is LIVE (fresh control frames) -- otherwise it instantly
+        // reverts to local control, so a dropped/busy peer can never orphan a party member.
+        // (Known benign race: the guest's first control frame takes ~RTT to arrive, so a slot whose
+        // ATB is full at battle start may open locally for its first turn.)
+        public static Boolean IsGuestOwnedSlot(Int32 slot)
+        {
+            if (!Enabled || GuestSlots == 0 || slot < 0 || slot >= 4 || (GuestSlots & (1 << slot)) == 0)
+                return false;
+            return (Environment.TickCount - _assistTick) < MenuStaleMs;
+        }
+
+        // The peer's assist menu is open -> WAIT/Turn-Based ATB gates treat it like a local menu
+        // (BattleHUD.IsNativeEnableAtb / FF9BMenu_IsEnableAtb). Decays on staleness so a hung or
+        // disconnected guest can never freeze the host's battle.
+        public static Boolean RemoteMenuOpen
+        {
+            get
+            {
+                return Enabled && GuestSlots != 0 && _remoteMenuFlag &&
+                       (Environment.TickCount - _remoteMenuTick) < MenuStaleMs;
+            }
+        }
+
+        // UIKeyTrigger hook (F6-pattern early intercept): true when an assist key is down WHILE the
+        // assist panel is taking a command -- the caller then returns before the game's own key
+        // handlers run, so a digit bound to a game control can't double-fire. Cheap + never throws.
+        public static Boolean SwallowAssistKey()
+        {
+            if (!AssistInputActive)
+                return false;
+            try
+            {
+                return ReadDigit() >= 0;
+            }
+            catch { }
+            return false;
+        }
+
+        // Config changed / transport dropped: forget everything volatile.
+        public static void Reset()
+        {
+            _peerView = null;
+            _peerRoster = null;
+            PeerBattleLive = false;
+            AssistInputActive = false;
+            _remoteMenuFlag = false;
+            _assistTick = Int32.MinValue;
+            _pendingSlot = -1;
+            _wasInBattle = false;
+            _lastRosterBytes = null;
+            _loopBattle = null;
+            _loopRoster = null;
+            _loopCommands.Clear();
+            _loopMenuOpen = false;
+            ResetUi();
+        }
+
+        private static void ResetUi()
+        {
+            _uiMode = UiRoot;
+            _uiSlot = -1;
+            _uiCmd = null;
+            _uiPage = 0;
+        }
+
+        // ============================================================================ the pumps
+        // Real co-op, both directions. Called every frame from NetSyncClient.Update (main thread).
+        public static void Pump(INetTransport socket, EventEngine ee)
+        {
+            if (!Enabled || socket == null)
+                return;
+            try
+            {
+                // --- my battle -> the wire ---
+                Boolean inBattle = InOwnBattle(ee);
+                if (inBattle)
+                {
+                    Int32 now = Environment.TickCount;
+                    if (now - _lastSampleTick > SampleMs)
+                    {
+                        _lastSampleTick = now;
+                        socket.SetLocalBattle(SampleOwnBattle());
+                    }
+                    if (GuestSlots != 0 && now - _lastRosterTick > RosterMs)
+                    {
+                        _lastRosterTick = now;
+                        Byte[] roster = BuildRoster();
+                        if (roster != null && !BytesEqual(roster, _lastRosterBytes))
+                        {
+                            _lastRosterBytes = roster;
+                            socket.SetLocalRoster(roster);
+                        }
+                    }
+                }
+                else if (_wasInBattle)
+                {
+                    socket.SetLocalBattle(null);           // left battle -> stop the lanes (peer panel decays)
+                    socket.SetLocalRoster(null);
+                    _lastRosterBytes = null;
+                }
+                _wasInBattle = inBattle;
+
+                // --- the peer's commands -> my battle ---
+                if (inBattle)
+                {
+                    Byte[] cmd;
+                    while ((cmd = socket.NextRemoteCommand()) != null)
+                        HandleCommandPayload(cmd);
+                    ParseControl(socket.GetRemoteControl());
+                }
+                else
+                {
+                    _remoteMenuFlag = false;
+                }
+
+                // --- the peer's battle -> my panel + my keys -> the wire ---
+                Byte[] peerBattle = socket.GetRemoteBattle();
+                if (peerBattle != null)
+                {
+                    BattleView view = ParseView(peerBattle);
+                    if (view != null)
+                    {
+                        _peerView = view;
+                        _peerViewTick = Environment.TickCount;
+                    }
+                }
+                Byte[] peerRoster = socket.GetRemoteRoster();
+                if (peerRoster != null)
+                    _peerRoster = ParseRoster(peerRoster);   // cheap enough at 30 Hz; latest-slot lane
+
+                Boolean live = _peerView != null && (Environment.TickCount - _peerViewTick) < StaleMs;
+                PeerBattleLive = live;
+                if (live && !inBattle)                     // both in battle at once -> spectate only, no assist
+                {
+                    Int32 mySlot = FirstReadyGuestSlot(_peerView);
+                    AssistInputActive = mySlot >= 0;
+                    socket.SetLocalControl(BuildControl(mySlot >= 0));
+                    Byte[] command = RunAssistUi(_peerView, _peerRoster, mySlot);
+                    if (command != null)
+                        socket.SendCommand(command);
+                }
+                else
+                {
+                    AssistInputActive = false;
+                    socket.SetLocalControl(null);
+                    if (!live)
+                    {
+                        _peerView = null;
+                        _peerRoster = null;
+                        ResetUi();
+                    }
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] battle pump failed");
+            }
+        }
+
+        // Solo proof mode: my own battle loops back through the FULL codec (sample -> serialize ->
+        // parse -> panel -> keys -> command frame -> inject). Plays exactly like being the guest of
+        // my own fight: GuestSlots menus never open locally; I command them with the assist keys.
+        public static void SelfTestPump(EventEngine ee)
+        {
+            if (!Enabled || !SelfTest)
+                return;
+            try
+            {
+                Boolean inBattle = InOwnBattle(ee);
+                if (!inBattle)
+                {
+                    if (_wasInBattle)
+                        Reset();
+                    _wasInBattle = false;
+                    PeerBattleLive = false;
+                    AssistInputActive = false;
+                    return;
+                }
+                _wasInBattle = true;
+
+                Int32 now = Environment.TickCount;
+                if (now - _lastSampleTick > SampleMs)
+                {
+                    _lastSampleTick = now;
+                    _loopBattle = SampleOwnBattle();       // the "wire": a byte[] round trip, no socket
+                }
+                if (GuestSlots != 0 && now - _lastRosterTick > RosterMs)
+                {
+                    _lastRosterTick = now;
+                    _loopRoster = BuildRoster();
+                }
+                if (_loopBattle != null)
+                {
+                    BattleView view = ParseView(_loopBattle);
+                    if (view != null)
+                    {
+                        _peerView = view;
+                        _peerViewTick = Environment.TickCount;
+                    }
+                }
+                if (_loopRoster != null)
+                    _peerRoster = ParseRoster(_loopRoster);
+                Boolean live = _peerView != null;
+                PeerBattleLive = live;
+                if (live)
+                {
+                    Int32 mySlot = FirstReadyGuestSlot(_peerView);
+                    _loopMenuOpen = mySlot >= 0;
+                    AssistInputActive = _loopMenuOpen;
+                    ParseControl(BuildControl(_loopMenuOpen));   // RemoteMenuOpen through the codec too
+                    Byte[] command = RunAssistUi(_peerView, _peerRoster, mySlot);
+                    if (command != null)
+                        _loopCommands.Enqueue(command);
+                    while (_loopCommands.Count > 0)
+                        HandleCommandPayload(_loopCommands.Dequeue());
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] battle selftest pump failed");
+            }
+        }
+
+        private static Boolean BytesEqual(Byte[] a, Byte[] b)
+        {
+            if (a == null || b == null || a.Length != b.Length)
+                return false;
+            for (Int32 i = 0; i < a.Length; i++)
+                if (a[i] != b[i])
+                    return false;
+            return true;
+        }
+
+        // ============================================================================ sampling (B0 out)
+        private static Boolean InOwnBattle(EventEngine ee)
+        {
+            try
+            {
+                if (ee == null || (ee.gMode != 2 && ee.gMode != 4))
+                    return false;
+                FF9StateBattleSystem btlsys = FF9StateSystem.Battle.FF9Battle;
+                return btlsys != null && btlsys.btl_list != null && btlsys.btl_list.next != null;
+            }
+            catch { return false; }
+        }
+
+        private static Byte[] SampleOwnBattle()
+        {
+            FF9StateBattleSystem btlsys = FF9StateSystem.Battle.FF9Battle;
+            BattleHUD hud = UIManager.Battle;
+            using (MemoryStream ms = new MemoryStream(420))
+            using (BinaryWriter bw = new BinaryWriter(ms))
+            {
+                bw.Write(_seq++);
+                UInt16 mapNo = 0;
+                try { mapNo = (UInt16)FF9StateSystem.Common.FF9.btlMapNo; } catch { }
+                bw.Write(mapNo);
+                bw.Write((Byte)(GuestSlots & 0x0F));
+                Int64 countPos = ms.Position;
+                bw.Write((Byte)0);                         // unitCount backpatched below
+                Int32 count = 0;
+                foreach (BattleUnit unit in btlsys.EnumerateBattleUnits())
+                {
+                    if (count >= 8)
+                        break;
+                    Int32 index = unit.GetIndex();
+                    Boolean isPlayer = unit.IsPlayer;
+                    Boolean alive = unit.CurrentHp > 0;
+                    Boolean ready = false;
+                    if (isPlayer && hud != null)
+                    {
+                        try
+                        {
+                            ready = hud.ReadyQueue.Contains(index) && !hud.InputFinishList.Contains(index) &&
+                                    !btl_cmd.CheckUsingCommand(unit.Data.cmd[0]);
+                        }
+                        catch { }
+                    }
+                    Byte info = 0;
+                    if (isPlayer) info |= 1;
+                    if (alive) info |= 2;
+                    if (ready) info |= 4;
+                    if (unit.InTrance) info |= 8;
+                    bw.Write((Byte)index);
+                    bw.Write(info);
+                    bw.Write(unit.CurrentHp);
+                    bw.Write(unit.MaximumHp);
+                    bw.Write(unit.CurrentMp);
+                    bw.Write(unit.MaximumMp);
+                    bw.Write((UInt16)Math.Max((Int16)0, unit.CurrentAtb));
+                    bw.Write((UInt16)Math.Max((Int16)1, unit.MaximumAtb));
+                    WriteName(bw, unit);
+                    count++;
+                }
+                Int64 endPos = ms.Position;
+                ms.Position = countPos;
+                bw.Write((Byte)count);
+                ms.Position = endPos;
+                return ms.ToArray();
+            }
+        }
+
+        private static void WriteName(BinaryWriter bw, BattleUnit unit)
+        {
+            String name;
+            try { name = StripMarkup(unit.Name); }
+            catch { name = "?"; }
+            if (String.IsNullOrEmpty(name))
+                name = "?";
+            Byte[] utf8 = Encoding.UTF8.GetBytes(name);
+            Int32 len = Math.Min(utf8.Length, 15);
+            bw.Write((Byte)len);
+            bw.Write(utf8, 0, len);
+        }
+
+        // Enemy names arrive as raw FF9 text markup ("[STRT=27,1]Fang[ENDN]") -- keep only the visible text.
+        private static String StripMarkup(String raw)
+        {
+            if (raw == null)
+                return null;
+            if (raw.IndexOf('[') < 0)
+                return raw;
+            StringBuilder sb = new StringBuilder(raw.Length);
+            Boolean inTag = false;
+            for (Int32 i = 0; i < raw.Length; i++)
+            {
+                Char c = raw[i];
+                if (c == '[') { inTag = true; continue; }
+                if (c == ']') { inTag = false; continue; }
+                if (!inTag)
+                    sb.Append(c);
+            }
+            return sb.ToString();
+        }
+
+        // ============================================================================ the roster (type 4)
+        // Layout: u8 ver(1), u8 slotCount, per slot { u8 slot, u8 cmdCount, per cmd { u8 menu,
+        // u16 cmdId, u8 type, u8 targetInfo, u8 abilCount, per abil { u16 id, u8 mp, u8 flags(bit0
+        // enabled, bit1 forDead), u8 target } } }, u16 itemCount, per item { u16 id, u8 count,
+        // u8 target, u8 forDead }. Ids only -- the guest resolves display names from its OWN install
+        // (both machines run the same game data; a name the guest can't resolve renders as "#id").
+        private static Byte[] BuildRoster()
+        {
+            BattleHUD hud = UIManager.Battle;
+            if (hud == null)
+                return null;
+            try
+            {
+                using (MemoryStream ms = new MemoryStream(1024))
+                using (BinaryWriter bw = new BinaryWriter(ms))
+                {
+                    bw.Write((Byte)1);
+                    Int64 slotCountPos = ms.Position;
+                    bw.Write((Byte)0);
+                    Int32 slotCount = 0;
+                    List<Int32> commands = new List<Int32>(16);
+                    List<Int32> abilities = new List<Int32>(192);
+                    List<Int32> items = new List<Int32>(128);
+                    for (Int32 slot = 0; slot < 4; slot++)
+                    {
+                        if ((GuestSlots & (1 << slot)) == 0)
+                            continue;
+                        BattleUnit unit = null;
+                        foreach (BattleUnit u in FF9StateSystem.Battle.FF9Battle.EnumerateBattleUnits())
+                            if (u.IsPlayer && u.GetIndex() == slot)
+                                unit = u;
+                        if (unit == null)
+                            continue;
+                        commands.Clear();
+                        abilities.Clear();
+                        if (slotCount == 0)
+                            items.Clear();                 // the item list is shared -- collect it once
+                        hud.CollectNetMenus(slot, commands, abilities, slotCount == 0 ? items : new List<Int32>());
+                        bw.Write((Byte)slot);
+                        bw.Write((Byte)(commands.Count / 4));
+                        for (Int32 c = 0; c + 3 < commands.Count; c += 4)
+                        {
+                            Int32 menu = commands[c], cmdId = commands[c + 1], type = commands[c + 2], tinfo = commands[c + 3];
+                            bw.Write((Byte)menu);
+                            bw.Write((UInt16)cmdId);
+                            bw.Write((Byte)type);
+                            bw.Write((Byte)tinfo);
+                            Int32 abilCount = 0;
+                            for (Int32 a = 0; a + 5 < abilities.Count; a += 6)
+                                if (abilities[a] == menu)
+                                    abilCount++;
+                            bw.Write((Byte)Math.Min(abilCount, 255));
+                            for (Int32 a = 0; a + 5 < abilities.Count; a += 6)
+                            {
+                                if (abilities[a] != menu)
+                                    continue;
+                                bw.Write((UInt16)abilities[a + 1]);
+                                bw.Write((Byte)Math.Min(abilities[a + 2], 255));
+                                bw.Write((Byte)((abilities[a + 3] != 0 ? 1 : 0) | (abilities[a + 5] != 0 ? 2 : 0)));
+                                bw.Write((Byte)abilities[a + 4]);
+                            }
+                        }
+                        slotCount++;
+                    }
+                    bw.Write((UInt16)(items.Count / 4));
+                    for (Int32 i = 0; i + 3 < items.Count; i += 4)
+                    {
+                        bw.Write((UInt16)items[i]);
+                        bw.Write((Byte)Math.Min(items[i + 1], 255));
+                        bw.Write((Byte)items[i + 2]);
+                        bw.Write((Byte)(items[i + 3] != 0 ? 1 : 0));
+                    }
+                    Int64 endPos = ms.Position;
+                    ms.Position = slotCountPos;
+                    bw.Write((Byte)slotCount);
+                    ms.Position = endPos;
+                    return ms.ToArray();
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] roster build failed");
+                return null;
+            }
+        }
+
+        private static RosterView ParseRoster(Byte[] payload)
+        {
+            try
+            {
+                using (MemoryStream ms = new MemoryStream(payload))
+                using (BinaryReader br = new BinaryReader(ms))
+                {
+                    if (br.ReadByte() != 1)
+                        return null;
+                    RosterView roster = new RosterView();
+                    Int32 slotCount = br.ReadByte();
+                    for (Int32 s = 0; s < slotCount; s++)
+                    {
+                        Int32 slot = br.ReadByte();
+                        Int32 cmdCount = br.ReadByte();
+                        List<CmdView> cmds = new List<CmdView>(cmdCount);
+                        for (Int32 c = 0; c < cmdCount; c++)
+                        {
+                            CmdView cmd = new CmdView();
+                            cmd.Menu = br.ReadByte();
+                            cmd.CmdId = br.ReadUInt16();
+                            cmd.Type = br.ReadByte();
+                            cmd.TargetType = br.ReadByte();
+                            Int32 abilCount = br.ReadByte();
+                            for (Int32 a = 0; a < abilCount; a++)
+                            {
+                                AbilView abil = new AbilView();
+                                abil.Id = br.ReadUInt16();
+                                abil.Mp = br.ReadByte();
+                                Int32 flags = br.ReadByte();
+                                abil.Enabled = (flags & 1) != 0;
+                                abil.ForDead = (flags & 2) != 0;
+                                abil.TargetType = br.ReadByte();
+                                cmd.Abilities.Add(abil);
+                            }
+                            cmds.Add(cmd);
+                        }
+                        roster.Slots[slot] = cmds;
+                    }
+                    Int32 itemCount = br.ReadUInt16();
+                    for (Int32 i = 0; i < itemCount; i++)
+                    {
+                        ItemView item = new ItemView();
+                        item.Id = br.ReadUInt16();
+                        item.Count = br.ReadByte();
+                        item.TargetType = br.ReadByte();
+                        item.ForDead = br.ReadByte() != 0;
+                        roster.Items.Add(item);
+                    }
+                    return roster;
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] bad roster frame");
+                return null;
+            }
+        }
+
+        // ============================================================================ the view (B0 in)
+        private static BattleView ParseView(Byte[] payload)
+        {
+            try
+            {
+                using (MemoryStream ms = new MemoryStream(payload))
+                using (BinaryReader br = new BinaryReader(ms))
+                {
+                    BattleView view = new BattleView();
+                    view.Seq = br.ReadUInt16();
+                    view.MapNo = br.ReadUInt16();
+                    view.GuestSlots = br.ReadByte();
+                    Int32 count = br.ReadByte();
+                    for (Int32 i = 0; i < count && i < 8; i++)
+                    {
+                        UnitView u = new UnitView();
+                        u.Index = br.ReadByte();
+                        Byte info = br.ReadByte();
+                        u.IsPlayer = (info & 1) != 0;
+                        u.Alive = (info & 2) != 0;
+                        u.Ready = (info & 4) != 0;
+                        u.InTrance = (info & 8) != 0;
+                        u.HpCur = br.ReadUInt32();
+                        u.HpMax = br.ReadUInt32();
+                        u.MpCur = br.ReadUInt32();
+                        u.MpMax = br.ReadUInt32();
+                        u.AtbCur = br.ReadUInt16();
+                        u.AtbMax = br.ReadUInt16();
+                        Int32 nameLen = br.ReadByte();
+                        Byte[] nameBytes = br.ReadBytes(nameLen);
+                        u.Name = Encoding.UTF8.GetString(nameBytes);
+                        view.Units.Add(u);
+                    }
+                    return view;
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] bad battle-state frame");
+                return null;
+            }
+        }
+
+        // The first of MY assigned slots (per the battle owner's offer) that awaits a command.
+        private static Int32 FirstReadyGuestSlot(BattleView view)
+        {
+            if (view == null || view.GuestSlots == 0)
+                return -1;
+            for (Int32 i = 0; i < view.Units.Count; i++)
+            {
+                UnitView u = view.Units[i];
+                if (u.IsPlayer && u.Ready && u.Alive && (view.GuestSlots & (1 << u.Index)) != 0)
+                    return u.Index;
+            }
+            return -1;
+        }
+
+        // ============================================================================ assist input (B1 out)
+        // The digit-menu state machine. All keys are digits (unbound in the field walk layout and
+        // swallowed from the game while the panel is active):
+        //   Root:          [1] Attack  [2] Defend  [3] <cmd1>  [4] <cmd2>  [5] Item
+        //   Ability/Item:  [1-6] pick on this page   [8] prev page  [9] next page  [0] back
+        //   Target:        [1-8] pick   [0] back
+        // All*/Self/Random targets resolve automatically (no pick step), mirroring the real HUD.
+        private static Byte[] RunAssistUi(BattleView view, RosterView roster, Int32 mySlot)
+        {
+            if (mySlot < 0)
+            {
+                _pendingSlot = -1;
+                if (_uiSlot >= 0)
+                    ResetUi();
+                return null;
+            }
+            if (_uiSlot != mySlot)
+            {
+                ResetUi();
+                _uiSlot = mySlot;
+            }
+            if (Environment.TickCount - _lastSendTick < InputCooldownMs)
+                return null;
+            Int32 d = ReadDigit();
+            if (d < 0)
+                return null;
+
+            List<CmdView> cmds = SlotCommands(roster, mySlot);
+            switch (_uiMode)
+            {
+                case UiRoot:
+                    if (d == 1)   // Attack (works with or without a roster; targeting from its AA when known)
+                    {
+                        CmdView atk = FindMenu(cmds, 0 /* BattleCommandMenu.Attack */);
+                        BeginTarget(ActAttack, atk != null ? atk.Menu : 0, 0,
+                                    atk != null ? atk.Target : 0 /* SingleAny */, atk != null && atk.ForDead, UiRoot);
+                    }
+                    else if (d == 2)
+                    {
+                        return BuildCommand(mySlot, ActDefend, 0, 0, (UInt16)(1 << mySlot), 0);
+                    }
+                    else if ((d == 3 || d == 4) && cmds != null)
+                    {
+                        CmdView cmd = FindMenu(cmds, d == 3 ? 2 : 3 /* Ability1 / Ability2 */);
+                        if (cmd == null)
+                            break;
+                        if (cmd.Type == 4 /* CharacterCommandType.Instant */ || cmd.Abilities.Count == 0)
+                        {
+                            // single-shot command (Focus etc.): resolve its target automatically
+                            UInt16 mask; Int32 cursor;
+                            if (ResolveAutoTarget(cmd.Target, mySlot, out mask, out cursor))
+                                return BuildCommand(mySlot, ActInstant, cmd.Menu, 0, mask, cursor);
+                            BeginTarget(ActInstant, cmd.Menu, 0, cmd.Target, cmd.ForDead, UiRoot);
+                        }
+                        else
+                        {
+                            _uiCmd = cmd;
+                            _uiMode = UiAbility;
+                            _uiPage = 0;
+                        }
+                    }
+                    else if (d == 5 && roster != null && roster.Items.Count > 0)
+                    {
+                        _uiMode = UiItem;
+                        _uiPage = 0;
+                    }
+                    break;
+
+                case UiAbility:
+                    if (d == 0) { _uiMode = UiRoot; break; }
+                    if (d == 8) { if (_uiPage > 0) _uiPage--; break; }
+                    if (d == 9) { if ((_uiPage + 1) * PageSize < _uiCmd.Abilities.Count) _uiPage++; break; }
+                    if (d >= 1 && d <= PageSize)
+                    {
+                        Int32 idx = _uiPage * PageSize + (d - 1);
+                        if (_uiCmd == null || idx >= _uiCmd.Abilities.Count)
+                            break;
+                        AbilView abil = _uiCmd.Abilities[idx];
+                        if (!abil.Enabled)
+                            break;   // grayed (silence / MP); repick
+                        UInt16 mask; Int32 cursor;
+                        if (ResolveAutoTarget(abil.TargetType, mySlot, out mask, out cursor))
+                            return BuildCommand(mySlot, ActAbility, _uiCmd.Menu, abil.Id, mask, cursor);
+                        BeginTarget(ActAbility, _uiCmd.Menu, abil.Id, abil.TargetType, abil.ForDead, UiAbility);
+                    }
+                    break;
+
+                case UiItem:
+                    if (d == 0) { _uiMode = UiRoot; break; }
+                    if (d == 8) { if (_uiPage > 0) _uiPage--; break; }
+                    if (d == 9) { if (roster != null && (_uiPage + 1) * PageSize < roster.Items.Count) _uiPage++; break; }
+                    if (d >= 1 && d <= PageSize && roster != null)
+                    {
+                        Int32 idx = _uiPage * PageSize + (d - 1);
+                        if (idx >= roster.Items.Count)
+                            break;
+                        ItemView item = roster.Items[idx];
+                        if (item.Count <= 0)
+                            break;
+                        UInt16 mask; Int32 cursor;
+                        if (ResolveAutoTarget(item.TargetType, mySlot, out mask, out cursor))
+                            return BuildCommand(mySlot, ActItem, 0, item.Id, mask, cursor);
+                        BeginTarget(ActItem, 0, item.Id, item.TargetType, item.ForDead, UiItem);
+                    }
+                    break;
+
+                case UiTarget:
+                    if (d == 0) { _uiMode = _uiReturnMode; break; }
+                    if (d >= 1 && d <= 8)
+                    {
+                        List<UnitView> targets = TargetCandidates(view, _pendTargetType, _pendForDead);
+                        Int32 idx = d - 1;
+                        if (idx >= targets.Count)
+                            break;
+                        return BuildCommand(mySlot, _pendAction, _pendMenu, _pendId,
+                                            (UInt16)(1 << targets[idx].Index), 0);
+                    }
+                    break;
+            }
+            return null;
+        }
+
+        private static Int32 ReadDigit()
+        {
+            for (Int32 d = 0; d <= 9; d++)
+                if (Input.GetKeyDown(KeyCode.Alpha0 + d) || Input.GetKeyDown(KeyCode.Keypad0 + d))
+                    return d;
+            return -1;
+        }
+
+        private static List<CmdView> SlotCommands(RosterView roster, Int32 slot)
+        {
+            if (roster == null)
+                return null;
+            List<CmdView> cmds;
+            return roster.Slots.TryGetValue(slot, out cmds) ? cmds : null;
+        }
+
+        private static CmdView FindMenu(List<CmdView> cmds, Int32 menu)
+        {
+            if (cmds == null)
+                return null;
+            for (Int32 i = 0; i < cmds.Count; i++)
+                if (cmds[i].Menu == menu)
+                    return cmds[i];
+            return null;
+        }
+
+        private static void BeginTarget(Int32 action, Int32 menu, Int32 id, Int32 targetType, Boolean forDead, Int32 backTo)
+        {
+            _pendAction = action;
+            _pendMenu = menu;
+            _pendId = id;
+            _pendTargetType = targetType;
+            _pendForDead = forDead;
+            _uiReturnMode = backTo;
+            _uiMode = UiTarget;
+        }
+
+        // All/Self/Random target types need no pick step -- mirror the real HUD's automatic masks.
+        // TargetType (Memoria.Data): 0 SingleAny, 1 SingleAlly, 2 SingleEnemy, 3-5 Many*, 6 All,
+        // 7 AllAlly, 8 AllEnemy, 9-11 Random*, 12 Everyone, 13 Self, 14 Automatic, 15 Special.
+        private static Boolean ResolveAutoTarget(Int32 targetType, Int32 mySlot, out UInt16 mask, out Int32 cursor)
+        {
+            switch (targetType)
+            {
+                case 6: case 12: mask = 0xFF; cursor = 1; return true;      // All / Everyone
+                case 7: mask = 0x0F; cursor = 1; return true;               // AllAlly
+                case 8: mask = 0xF0; cursor = 1; return true;               // AllEnemy
+                case 9: mask = 0xFF; cursor = 2; return true;               // Random
+                case 10: mask = 0x0F; cursor = 2; return true;              // RandomAlly
+                case 11: mask = 0xF0; cursor = 2; return true;              // RandomEnemy
+                case 13: mask = (UInt16)(1 << mySlot); cursor = 0; return true;   // Self
+                default: mask = 0; cursor = 0; return false;                // single/many -> pick a target
+            }
+        }
+
+        // Side + dead/alive filter for the target pick, in panel display order (enemies then party).
+        private static List<UnitView> TargetCandidates(BattleView view, Int32 targetType, Boolean forDead)
+        {
+            Boolean allowEnemies = targetType == 0 || targetType == 2 || targetType == 3 || targetType == 5;
+            Boolean allowAllies = targetType == 0 || targetType == 1 || targetType == 3 || targetType == 4;
+            if (!allowEnemies && !allowAllies)
+                allowEnemies = allowAllies = true;   // unknown type -> free pick, host re-validates
+            List<UnitView> result = new List<UnitView>(8);
+            for (Int32 pass = 0; pass < 2; pass++)
+            {
+                Boolean wantPlayer = pass == 1;
+                for (Int32 i = 0; i < view.Units.Count; i++)
+                {
+                    UnitView u = view.Units[i];
+                    if (u.IsPlayer != wantPlayer)
+                        continue;
+                    if (u.IsPlayer && !allowAllies)
+                        continue;
+                    if (!u.IsPlayer && !allowEnemies)
+                        continue;
+                    // revival abilities (Life / Phoenix Down) list the DEAD; everything else the living
+                    if (forDead ? u.Alive : !u.Alive)
+                        continue;
+                    result.Add(u);
+                }
+            }
+            return result;
+        }
+
+        // command frame: u8 ver(1), u8 slot, u8 action, u8 menu, u16 id, u16 targetMask, u8 cursor
+        private static Byte[] BuildCommand(Int32 slot, Int32 action, Int32 menu, Int32 id, UInt16 mask, Int32 cursor)
+        {
+            _lastSendTick = Environment.TickCount;
+            _pendingSlot = slot;
+            ResetUi();
+            _uiSlot = slot;   // keep serving this slot (panel shows "sent...")
+            Byte[] p = new Byte[9];
+            p[0] = 1;
+            p[1] = (Byte)slot;
+            p[2] = (Byte)action;
+            p[3] = (Byte)menu;
+            p[4] = (Byte)(id & 0xFF);
+            p[5] = (Byte)((id >> 8) & 0xFF);
+            p[6] = (Byte)(mask & 0xFF);
+            p[7] = (Byte)((mask >> 8) & 0xFF);
+            p[8] = (Byte)cursor;
+            return p;
+        }
+
+        private static Byte[] BuildControl(Boolean menuOpen)
+        {
+            return new Byte[] { 0, menuOpen ? (Byte)1 : (Byte)0 };
+        }
+
+        private static void ParseControl(Byte[] payload)
+        {
+            if (payload == null || payload.Length < 2 || payload[0] != 0)
+            {
+                _remoteMenuFlag = false;
+                return;
+            }
+            _assistTick = Environment.TickCount;   // any valid control frame = the guest is live + watching
+            _remoteMenuFlag = payload[1] != 0;
+            if (_remoteMenuFlag)
+                _remoteMenuTick = Environment.TickCount;
+        }
+
+        // ============================================================================ injection (B1 in)
+        // A command frame from the peer (or the selftest loopback): validate hard, then queue it through
+        // BattleHUD.SendNetCommand -- the engine's own inspection re-validates (a stale/illegal command
+        // is silently dropped there, btl_cmd.cs CheckCommandCondition), so the worst case is a no-op.
+        private static void HandleCommandPayload(Byte[] p)
+        {
+            if (p == null || p.Length < 9 || p[0] != 1)
+                return;
+            Int32 slot = p[1], action = p[2], menu = p[3];
+            Int32 id = p[4] | (p[5] << 8);
+            UInt16 mask = (UInt16)(p[6] | (p[7] << 8));
+            UInt32 cursor = p[8];
+            if (!IsGuestOwnedSlot(slot))
+            {
+                Log.Message("[NetSync] peer command for slot " + slot + " refused (not a guest slot)");
+                return;
+            }
+            if (mask == 0)
+                return;
+            BattleHUD hud = UIManager.Battle;
+            FF9StateBattleSystem btlsys = FF9StateSystem.Battle.FF9Battle;
+            if (hud == null || btlsys == null)
+                return;
+
+            BattleUnit unit = null, firstAliveEnemy = null;
+            Boolean maskHasLiving = false;
+            foreach (BattleUnit u in btlsys.EnumerateBattleUnits())
+            {
+                Int32 idx = u.GetIndex();
+                if (u.IsPlayer && idx == slot)
+                    unit = u;
+                if (!u.IsPlayer && u.CurrentHp > 0 && firstAliveEnemy == null)
+                    firstAliveEnemy = u;
+                if ((mask & (1 << idx)) != 0 && (u.CurrentHp > 0 || u.IsPlayer))
+                    maskHasLiving = true;   // dead PLAYERS stay targetable (revival items/abilities)
+            }
+            if (unit == null || unit.CurrentHp == 0)
+            {
+                Log.Message("[NetSync] peer command dropped (slot " + slot + " absent or KO)");
+                return;
+            }
+            if (!hud.ReadyQueue.Contains(slot) || hud.InputFinishList.Contains(slot) ||
+                btl_cmd.CheckUsingCommand(unit.Data.cmd[0]))
+            {
+                Log.Message("[NetSync] peer command dropped (slot " + slot + " not awaiting input)");
+                return;
+            }
+
+            switch (action)
+            {
+                case ActAttack:
+                case ActInstant:
+                {
+                    BattleCommandId cmdId = hud.NetCommandForMenu(slot, action == ActAttack ? 0 : menu);
+                    if (cmdId == BattleCommandId.None)
+                        return;
+                    Int32 subNo = hud.NetFirstAbilitySub(slot, cmdId);
+                    if (action == ActAttack && !maskHasLiving)
+                        mask = firstAliveEnemy != null ? firstAliveEnemy.Id : (UInt16)0;   // their pick died in flight
+                    if (mask == 0)
+                        return;
+                    if (hud.SendNetCommand(slot, cmdId, subNo, mask, cursor))
+                        Log.Message("[NetSync] peer command: slot " + slot + " " + cmdId + " -> mask 0x" + mask.ToString("X2"));
+                    break;
+                }
+                case ActDefend:
+                {
+                    if (hud.SendNetCommand(slot, BattleCommandId.Defend, (Int32)BattleAbilityId.Defend, (UInt16)(1 << slot), 0U))
+                        Log.Message("[NetSync] peer command: slot " + slot + " Defend");
+                    break;
+                }
+                case ActAbility:
+                {
+                    BattleCommandId cmdId = hud.NetCommandForMenu(slot, menu);
+                    if (cmdId == BattleCommandId.None)
+                        return;
+                    Int32 subNo;
+                    if (!hud.NetAbilityUsable(slot, cmdId, id, out subNo))
+                    {
+                        Log.Message("[NetSync] peer ability " + id + " dropped (not usable by slot " + slot + ")");
+                        return;
+                    }
+                    if (hud.SendNetCommand(slot, cmdId, subNo, mask, cursor))
+                        Log.Message("[NetSync] peer command: slot " + slot + " " + cmdId + " ability " + id + " -> mask 0x" + mask.ToString("X2"));
+                    break;
+                }
+                case ActItem:
+                {
+                    BattleCommandId cmdId = hud.NetCommandForMenu(slot, 4 /* BattleCommandMenu.Item */);
+                    if (cmdId == BattleCommandId.None)
+                        return;
+                    if (ff9item.FF9Item_GetCount((RegularItem)id) <= 0)
+                    {
+                        Log.Message("[NetSync] peer item " + id + " dropped (none left)");
+                        return;
+                    }
+                    if (hud.SendNetCommand(slot, cmdId, id, mask, cursor))
+                        Log.Message("[NetSync] peer command: slot " + slot + " Item " + id + " -> mask 0x" + mask.ToString("X2"));
+                    break;
+                }
+            }
+        }
+
+        // ============================================================================ the assist panel
+        public static void DrawGUI()
+        {
+            try
+            {
+                if (!PeerBattleLive || _peerView == null)
+                    return;
+                BattleView view = _peerView;
+                if (_panelStyle == null)
+                {
+                    _panelBg = new Texture2D(1, 1, TextureFormat.ARGB32, false);
+                    _panelBg.SetPixel(0, 0, new Color(0.04f, 0.05f, 0.09f, 0.85f));
+                    _panelBg.Apply();
+                    _panelStyle = new GUIStyle(GUI.skin.label);
+                    _panelStyle.fontSize = Mathf.Max(12, Screen.height / 64);
+                    _panelStyle.richText = false;
+                    _panelStyle.normal.textColor = new Color(0.92f, 0.94f, 0.98f, 1f);
+                }
+
+                StringBuilder sb = new StringBuilder(768);
+                sb.Append(SelfTest ? "CO-OP BATTLE (selftest loopback)" : "CO-OP: your friend's battle");
+                sb.Append('\n');
+                Int32 enemyNo = 0;
+                for (Int32 i = 0; i < view.Units.Count; i++)
+                {
+                    UnitView u = view.Units[i];
+                    if (u.IsPlayer)
+                        continue;
+                    enemyNo++;
+                    sb.Append("  ").Append(enemyNo).Append(". ").Append(Pad(u.Name, 12));
+                    if (u.Alive)
+                        sb.Append("HP ").Append(u.HpCur).Append('/').Append(u.HpMax);
+                    else
+                        sb.Append("KO");
+                    sb.Append('\n');
+                }
+                Int32 mySlot = FirstReadyGuestSlot(view);
+                for (Int32 i = 0; i < view.Units.Count; i++)
+                {
+                    UnitView u = view.Units[i];
+                    if (!u.IsPlayer)
+                        continue;
+                    Boolean mine = (view.GuestSlots & (1 << u.Index)) != 0;
+                    sb.Append(u.Index == mySlot ? "> " : "  ").Append(Pad(u.Name, 10));
+                    sb.Append("HP ").Append(u.HpCur).Append('/').Append(u.HpMax);
+                    sb.Append("  MP ").Append(u.MpCur).Append('/').Append(u.MpMax);
+                    Int32 pct = u.AtbMax > 0 ? (Int32)(u.AtbCur * 100 / u.AtbMax) : 0;
+                    sb.Append("  ATB ").Append(Math.Min(pct, 100)).Append('%');
+                    if (!u.Alive)
+                        sb.Append("  KO");
+                    else if (u.Ready)
+                        sb.Append(mine ? "  << YOUR TURN" : "  (ready)");
+                    if (u.InTrance)
+                        sb.Append("  TRANCE");
+                    sb.Append('\n');
+                }
+                AppendMenu(sb, view, mySlot);
+
+                GUIContent content = new GUIContent(sb.ToString());
+                Vector2 size = _panelStyle.CalcSize(content);
+                const Single pad = 10f;
+                Rect box = new Rect(16f, Screen.height * 0.22f, size.x + pad * 2f, size.y + pad * 1.4f);
+                GUI.DrawTexture(box, _panelBg);
+                GUI.Label(new Rect(box.x + pad, box.y + pad * 0.7f, size.x, size.y), content, _panelStyle);
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] battle panel draw failed");
+            }
+        }
+
+        // The interactive lower half of the panel: the current menu level for MY ready slot.
+        private static void AppendMenu(StringBuilder sb, BattleView view, Int32 mySlot)
+        {
+            if (mySlot < 0)
+            {
+                if (view.GuestSlots != 0)
+                    sb.Append("(waiting for your character's ATB)");
+                return;
+            }
+            if (Environment.TickCount - _lastSendTick < InputCooldownMs && _pendingSlot == mySlot)
+            {
+                sb.Append("command sent...");
+                return;
+            }
+            List<CmdView> cmds = SlotCommands(_peerRoster, mySlot);
+            switch (_uiMode)
+            {
+                case UiRoot:
+                {
+                    sb.Append("[1] Attack   [2] Defend");
+                    CmdView c1 = FindMenu(cmds, 2), c2 = FindMenu(cmds, 3);
+                    if (c1 != null)
+                        sb.Append("   [3] ").Append(CommandLabel(c1));
+                    if (c2 != null)
+                        sb.Append("   [4] ").Append(CommandLabel(c2));
+                    if (_peerRoster != null && _peerRoster.Items.Count > 0)
+                        sb.Append("   [5] Item");
+                    if (cmds == null)
+                        sb.Append("   (menus loading...)");
+                    break;
+                }
+                case UiAbility:
+                {
+                    sb.Append(CommandLabel(_uiCmd)).Append("  (page ").Append(_uiPage + 1).Append('/')
+                      .Append(1 + (_uiCmd.Abilities.Count - 1) / PageSize).Append(")\n");
+                    for (Int32 i = 0; i < PageSize; i++)
+                    {
+                        Int32 idx = _uiPage * PageSize + i;
+                        if (idx >= _uiCmd.Abilities.Count)
+                            break;
+                        AbilView a = _uiCmd.Abilities[idx];
+                        sb.Append("  [").Append(i + 1).Append("] ").Append(a.Enabled ? "" : "x ")
+                          .Append(Pad(AbilityLabel(a.Id), 14)).Append("MP ").Append(a.Mp).Append('\n');
+                    }
+                    sb.Append("  [8] prev  [9] next  [0] back");
+                    break;
+                }
+                case UiItem:
+                {
+                    Int32 total = _peerRoster != null ? _peerRoster.Items.Count : 0;
+                    sb.Append("Item  (page ").Append(_uiPage + 1).Append('/')
+                      .Append(Math.Max(1, 1 + (total - 1) / PageSize)).Append(")\n");
+                    for (Int32 i = 0; i < PageSize; i++)
+                    {
+                        Int32 idx = _uiPage * PageSize + i;
+                        if (_peerRoster == null || idx >= _peerRoster.Items.Count)
+                            break;
+                        ItemView item = _peerRoster.Items[idx];
+                        sb.Append("  [").Append(i + 1).Append("] ").Append(Pad(ItemLabel(item.Id), 14))
+                          .Append('x').Append(item.Count).Append('\n');
+                    }
+                    sb.Append("  [8] prev  [9] next  [0] back");
+                    break;
+                }
+                case UiTarget:
+                {
+                    sb.Append("Target:\n");
+                    List<UnitView> targets = TargetCandidates(view, _pendTargetType, _pendForDead);
+                    for (Int32 i = 0; i < targets.Count && i < 8; i++)
+                        sb.Append("  [").Append(i + 1).Append("] ").Append(StripMarkup(targets[i].Name))
+                          .Append(targets[i].Alive ? "" : " (KO)").Append('\n');
+                    if (targets.Count == 0)
+                        sb.Append("  (no valid target)\n");
+                    sb.Append("  [0] back");
+                    break;
+                }
+            }
+        }
+
+        // Display names resolve from THIS install's text tables (ids travel on the wire).
+        private static String CommandLabel(CmdView cmd)
+        {
+            try
+            {
+                String name = StripMarkup(FF9TextTool.CommandName((BattleCommandId)cmd.CmdId));
+                if (!String.IsNullOrEmpty(name))
+                    return name;
+            }
+            catch { }
+            return "cmd#" + cmd.CmdId;
+        }
+
+        private static String AbilityLabel(Int32 activeId)
+        {
+            try
+            {
+                String name = StripMarkup(FF9TextTool.ActionAbilityName((BattleAbilityId)activeId));
+                if (!String.IsNullOrEmpty(name))
+                    return name;
+            }
+            catch { }
+            return "#" + activeId;
+        }
+
+        private static String ItemLabel(Int32 itemId)
+        {
+            try
+            {
+                String name = StripMarkup(FF9TextTool.ItemName((RegularItem)itemId));
+                if (!String.IsNullOrEmpty(name))
+                    return name;
+            }
+            catch { }
+            return "#" + itemId;
+        }
+
+        private static String Pad(String s, Int32 width)
+        {
+            if (s == null)
+                s = "?";
+            if (s.Length >= width)
+                return s.Substring(0, width) + " ";
+            return s + new String(' ', width - s.Length + 1);
+        }
+    }
