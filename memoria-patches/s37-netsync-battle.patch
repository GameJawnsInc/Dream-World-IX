-    // TCP transport for co-op ghost sync. One side is HOST (listens), the other CLIENT (connects to the
-    // host's LAN IP). Once connected, BOTH sides symmetrically send their own state every tick and receive
-    // the peer's. ALL socket I/O runs on background threads; the game thread only swaps lock-guarded slots
-    // (Unity objects are touched only by NetSyncClient on the main thread). Auto-reconnects on drop, so
-    // relaunching one instance re-pairs. Modeled on Memoria.Test.GameObjectService (proven TCP in-engine).
+    // --- wire format v3: every message is one FRAME  [magic 0xF9][version 3][type u8][len u16 LE][payload]
+    //     type 0 = position state (36 B payload: field u16, anim u16, model u16, meshVis u16, pos 3f, rot 4f)
+    //     type 1 = battle state   (variable; see NetSyncBattle -- latest-slot semantics)
+    //     type 2 = battle command (variable; FIFO -- the underlying streams are reliable+ordered, so a
+    //                              queued frame is delivered exactly once as long as the link holds)
+    //     type 3 = control        (guest assist status, e.g. RemoteMenuOpen -- latest-slot semantics)
+    //     v2 (raw 38-byte packets) and v1 peers are REJECTED by the version byte -> mixed engine versions
+    //     silently don't sync (fail-safe; update both machines together when the wire changes). ---
+    public static class NetSyncWire
+    {
+        public const Byte Magic = 0xF9;
+        public const Byte Version = 3;
+        public const Int32 HeaderSize = 5;
+        public const Int32 MaxPayload = 4096;   // sanity cap; our largest frame (battle state) is ~400 B
+
+        public const Byte TypePos = 0;
+        public const Byte TypeBattle = 1;
+        public const Byte TypeCommand = 2;
+        public const Byte TypeControl = 3;
+
+        public static Byte[] BuildFrame(Byte type, Byte[] payload)
+        {
+            Int32 len = payload != null ? payload.Length : 0;
+            Byte[] frame = new Byte[HeaderSize + len];
+            frame[0] = Magic;
+            frame[1] = Version;
+            frame[2] = type;
+            frame[3] = (Byte)(len & 0xFF);
+            frame[4] = (Byte)((len >> 8) & 0xFF);
+            if (len > 0)
+                Array.Copy(payload, 0, frame, HeaderSize, len);
+            return frame;
+        }
+
+        // Validates a header (first HeaderSize bytes of buf). Returns false on a foreign/old-version peer.
+        public static Boolean TryParseHeader(Byte[] buf, out Byte type, out Int32 len)
