+using System;
+using System.Collections.Generic;
+using System.Text;
+using Memoria.Data;
+
+namespace Memoria.Netsync
+{
+    // THE PARTY MIRROR (state-frame sections 1-3) -- rung 2 of the authoritative-host ladder.
+    //
+    // WHAT RIDES THE WIRE (host->guest, inside the same TypeState frame as the story section --
+    // one frame = one consistent snapshot; latest-slot semantics preserved):
+    //     section 1 = the 4 party slots: identity + looks + label stats per member
+    //                 [present u8][charId u8][serial u8][level u8][row u8]
+    //                 [curHp u32 LE][maxHp u32][curMp u32][maxMp u32][equip u16 x5]
+    //                 [nameLen u8][name utf8]
+    //                 This is EXACTLY the battle diorama's future actor-spawn input (B3 builds
+    //                 BTL_DATA from it); battle MECHANICS stay host-side (never re-simulate) --
+    //                 live HP rides the existing B0 battle stream, not this.
+    //     section 2 = key items ("rare/important"):  [n u16 LE][importantId u16 x n]
+    //     section 3 = the regular item bag:          [n u16 LE][(id u16, count u16) x n]
+    //
+    // WHAT THE GUEST DOES WITH IT (rung 2 scope -- the read-COMPARE wrap, no state mutation):
+    // while mirroring, the event engine's pure membership/possession READS answer from the HOST's
+    // party instead of the guest's own -- EventEngine.partychk (B_PARTYCHK, the field's "is Vivi
+    // with you?" gate), EBin's PARTY_MEMBER varfunc (party slot -> character), and the event
+    // item-count read (B_HAVE_ITEM -> FF9Item_GetCount_Generic: regular bag counts + key-item
+    // existence; CARD counts deliberately fall through to the guest's own). So party/item-gated
+    // NPCs, doors, and branches stage the way the host's field does. DELIBERATELY NOT WRAPPED:
+    // ETb.GetPartyMember -- it feeds the party-ACTOR SPAWN loop (EventEngine.InitEvents), and
+    // re-dressing the guest's own walking body is the diorama era's identity problem, not rung 2's.
+    // Menus and the guest's real FF9.party/item state are NEVER touched; item WRITES a mirrored
+    // script performs land on the guest's real bag but are session-scoped by design (saving is
+    // blocked while mirroring and the exit ramp reloads the guest's own autosave).
+    internal static class NetSyncParty
+    {
+        public const Byte SectionParty = 1;
+        public const Byte SectionKeyItems = 2;
+        public const Byte SectionBag = 3;
+        private const Int32 NameCap = 48;          // utf8 bytes; custom names carry, absurd ones clip
+
+        // One mirrored party slot (see the section-1 layout above).
+        public struct Slot
+        {
+            public Boolean Present;
+            public Byte CharId;
+            public Byte Serial;
+            public Byte Level;
+            public Byte Row;
+            public UInt32 CurHp, MaxHp, CurMp, MaxMp;
+            public UInt16[] Equip;
+            public String Name;
+        }
+
+        // GUEST: the latest parsed mirror (game thread only). MirrorActive gates every read wrap;
+        // it flips true on the first parsed party section and dies with the session (Clear).
+        public static Boolean MirrorActive;
+        public static readonly Slot[] Slots = new Slot[4];
+        private static readonly HashSet<Int32> _keyItems = new HashSet<Int32>();
+        private static readonly Dictionary<Int32, Int32> _bag = new Dictionary<Int32, Int32>();
+
+        public static void Clear()
+        {
+            MirrorActive = false;
+            for (Int32 i = 0; i < 4; i++)
+                Slots[i] = default(Slot);
+            _keyItems.Clear();
+            _bag.Clear();
+        }
+
+        // ---------------------------------------------------------------- HOST: serialize
+        // Sections 1-3 from my live party/bag, appended after the story section by SnapshotAll.
+        // Null when the state isn't loaded yet (title screen) -> the story section ships alone.
+        public static Byte[] SerializeSections()
+        {
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                if (ff9 == null || ff9.party == null)
+                    return null;
+                List<Byte> w = new List<Byte>(256);
+
+                // section 1: party ------------------------------------------------------------
+                List<Byte> body = new List<Byte>(192);
+                for (Int32 i = 0; i < 4; i++)
+                {
+                    PLAYER p = ff9.party.member[i];
+                    if (p == null)
+                    {
+                        body.Add(0);
+                        continue;
+                    }
+                    body.Add(1);
+                    body.Add((Byte)p.info.slot_no);
+                    body.Add((Byte)p.info.serial_no);
+                    body.Add(p.level);
+                    body.Add(p.info.row);
+                    W32(body, (UInt32)p.cur.hp);
+                    W32(body, (UInt32)p.max.hp);
+                    W32(body, (UInt32)p.cur.mp);
+                    W32(body, (UInt32)p.max.mp);
+                    for (Int32 j = 0; j < 5; j++)
+                        W16(body, (UInt16)p.equip[j]);
+                    Byte[] name = Encoding.UTF8.GetBytes(p.Name ?? String.Empty);
+                    Int32 nameLen = Math.Min(name.Length, NameCap);
+                    body.Add((Byte)nameLen);
+                    for (Int32 j = 0; j < nameLen; j++)
+                        body.Add(name[j]);
+                }
+                Section(w, SectionParty, body);
+
+                // section 2: key items --------------------------------------------------------
+                body = new List<Byte>(128);
+                Int32 n = 0;
+                List<Byte> ids = new List<Byte>(128);
+                foreach (Int32 rare in ff9.rare_item_obtained)
+                {
+                    W16(ids, (UInt16)rare);
+                    n++;
+                }
+                W16(body, (UInt16)n);
+                body.AddRange(ids);
+                Section(w, SectionKeyItems, body);
+
+                // section 3: the regular bag --------------------------------------------------
+                body = new List<Byte>(512);
+                n = 0;
+                ids = new List<Byte>(512);
+                foreach (FF9ITEM item in ff9.item)
+                {
+                    if (item == null || item.count <= 0)
+                        continue;
+                    W16(ids, (UInt16)item.id);
+                    W16(ids, item.count);
+                    n++;
+                }
+                W16(body, (UInt16)n);
+                body.AddRange(ids);
+                Section(w, SectionBag, body);
+
+                return w.ToArray();
+            }
+            catch
+            {
+                return null;
+            }
+        }
+
+        private static void Section(List<Byte> w, Byte id, List<Byte> body)
+        {
+            w.Add(id);
+            w.Add((Byte)(body.Count & 0xFF));
+            w.Add((Byte)((body.Count >> 8) & 0xFF));
+            w.AddRange(body);
+        }
+
+        private static void W16(List<Byte> w, UInt16 v) { w.Add((Byte)(v & 0xFF)); w.Add((Byte)(v >> 8)); }
+        private static void W32(List<Byte> w, UInt32 v)
+        { w.Add((Byte)(v & 0xFF)); w.Add((Byte)((v >> 8) & 0xFF)); w.Add((Byte)((v >> 16) & 0xFF)); w.Add((Byte)((v >> 24) & 0xFF)); }
+
+        // ---------------------------------------------------------------- GUEST: parse
+        // Walks the SAME section framing as ApplyStoryTo, consuming sections 1-3 into the statics.
+        // Unknown sections skip by length (the framing's whole point). Returns true when a party
+        // section landed; MirrorActive flips with it.
+        public static Boolean ParseSections(Byte[] payload)
+        {
+            if (payload == null)
+                return false;
+            Boolean gotParty = false;
+            Int32 off = 0;
+            while (off + 3 <= payload.Length)
+            {
+                Byte sectionId = payload[off];
+                Int32 len = payload[off + 1] | (payload[off + 2] << 8);
+                Int32 body = off + 3;
+                if (body + len > payload.Length)
+                    break;
+                try
+                {
+                    if (sectionId == SectionParty)
+                        gotParty = ParseParty(payload, body, len);
+                    else if (sectionId == SectionKeyItems)
+                        ParseKeyItems(payload, body, len);
+                    else if (sectionId == SectionBag)
+                        ParseBag(payload, body, len);
+                }
+                catch
+                {
+                    return false;   // malformed body: keep whatever parsed cleanly before it
+                }
+                off = body + len;
+            }
+            if (gotParty)
+                MirrorActive = true;
+            return gotParty;
+        }
+
+        private static Boolean ParseParty(Byte[] b, Int32 off, Int32 len)
+        {
+            Int32 end = off + len;
+            Slot[] parsed = new Slot[4];
+            for (Int32 i = 0; i < 4; i++)
+            {
+                if (off >= end) return false;
+                Boolean present = b[off++] != 0;
+                if (!present)
+                {
+                    parsed[i] = default(Slot);
+                    continue;
+                }
+                if (off + 4 + 16 + 10 + 1 > end) return false;
+                parsed[i].Present = true;
+                parsed[i].CharId = b[off++];
+                parsed[i].Serial = b[off++];
+                parsed[i].Level = b[off++];
+                parsed[i].Row = b[off++];
+                parsed[i].CurHp = R32(b, ref off);
+                parsed[i].MaxHp = R32(b, ref off);
+                parsed[i].CurMp = R32(b, ref off);
+                parsed[i].MaxMp = R32(b, ref off);
+                parsed[i].Equip = new UInt16[5];
+                for (Int32 j = 0; j < 5; j++)
+                    parsed[i].Equip[j] = R16(b, ref off);
+                Int32 nameLen = b[off++];
+                if (off + nameLen > end) return false;
+                parsed[i].Name = Encoding.UTF8.GetString(b, off, nameLen);
+                off += nameLen;
+            }
+            for (Int32 i = 0; i < 4; i++)
+                Slots[i] = parsed[i];
+            return true;
+        }
+
+        private static void ParseKeyItems(Byte[] b, Int32 off, Int32 len)
+        {
+            Int32 end = off + len;
+            Int32 n = R16(b, ref off);
+            HashSet<Int32> items = new HashSet<Int32>();
+            for (Int32 i = 0; i < n && off + 2 <= end; i++)
+                items.Add(R16(b, ref off));
+            _keyItems.Clear();
+            _keyItems.UnionWith(items);
+        }
+
+        private static void ParseBag(Byte[] b, Int32 off, Int32 len)
+        {
+            Int32 end = off + len;
+            Int32 n = R16(b, ref off);
+            Dictionary<Int32, Int32> bag = new Dictionary<Int32, Int32>();
+            for (Int32 i = 0; i < n && off + 4 <= end; i++)
+            {
+                Int32 id = R16(b, ref off);
+                Int32 count = R16(b, ref off);
+                bag[id] = count;
+            }
+            _bag.Clear();
+            foreach (KeyValuePair<Int32, Int32> kv in bag)
+                _bag[kv.Key] = kv.Value;
+        }
+
+        private static UInt16 R16(Byte[] b, ref Int32 off)
+        { UInt16 v = (UInt16)(b[off] | (b[off + 1] << 8)); off += 2; return v; }
+        private static UInt32 R32(Byte[] b, ref Int32 off)
+        { UInt32 v = (UInt32)(b[off] | (b[off + 1] << 8) | (b[off + 2] << 16) | ((UInt32)b[off + 3] << 24)); off += 4; return v; }
+
+        // ---------------------------------------------------------------- the read wraps
+        // Each returns FALSE when not mirroring -> the caller runs its stock read untouched.
+
+        // EventEngine.partychk (B_PARTYCHK): membership from the HOST's party.
+        public static Boolean TryPartyChk(CharacterId charId, out Boolean present)
+        {
+            present = false;
+            if (!MirrorActive)
+                return false;
+            for (Int32 i = 0; i < 4; i++)
+                if (Slots[i].Present && Slots[i].CharId == (Byte)charId)
+                { present = true; break; }
+            return true;
+        }
+
+        // EBin PARTY_MEMBER varfunc: party slot -> the HOST's character in that slot.
