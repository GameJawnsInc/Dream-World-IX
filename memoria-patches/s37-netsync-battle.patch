+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using Memoria.Data;
+using Memoria.Prime;
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // Battle co-op (EXPERIMENTAL) -- rungs B0 + B1 of the battle-coop study:
+    //   B0  the peer sees my battle LIVE (roster + HP/MP/ATB streamed as wire-v3 type-1 frames, drawn
+    //       in an OnGUI panel on their side). Read-only; cannot desync anything.
+    //   B1  "networked controller 2": [Netsync] GuestSlots = <bitmask of party slots 0-3> hands those
+    //       slots to the PEER. The local battle HUD skips them (BattleHUD hooks call IsGuestOwnedSlot);
+    //       the peer's keypresses arrive as type-2 command frames and are injected through
+    //       BattleHUD.SendNetCommand -- the exact SendAutoAttackCommand pattern, so the engine treats
+    //       them like any locally-entered command. Skeleton scope: Attack + Defend only.
+    //
+    // The battle always runs on ONE machine (whoever is fighting); the other side only renders state
+    // and sends commands. There is deliberately NO battle-sim mirroring (see the study: lockstep is a
+    // dead end in this engine).
+    //
+    // FAIL-SAFE LAWS (same as the ghost lane): everything is gated on Enabled + GuestSlots; the peer
+    // stale/disconnected -> RemoteMenuOpen decays in ~2.5s and the ready-loop skip stops (slots revert
+    // to local control); any exception is swallowed into a log line and the vanilla battle continues.
+    public static class NetSyncBattle
+    {
+        // --- config mirror (written by NetSyncClient on every config [re]load; main thread) ---
+        public static Boolean Enabled;      // [Netsync] Enabled
+        public static Int32 GuestSlots;     // [Netsync] GuestSlots -- bitmask of MY party slots the PEER commands
+        public static Boolean SelfTest;     // role=selftest -> loopback my own battle through the full codec
+
+        // "the peer's battle panel is live" -- read by NetSyncClient to quiet the idle overlay
+        public static Boolean PeerBattleLive { get; private set; }
+
+        private const Int32 SampleMs = 150;        // battle-state sampling cadence (write loop re-sends at 30 Hz)
+        private const Int32 StaleMs = 2000;        // parsed peer view older than this -> hide the panel
+        private const Int32 MenuStaleMs = 2500;    // control-frame freshness window for RemoteMenuOpen
+        private const Int32 InputCooldownMs = 700; // swallow assist keys briefly after sending a command
+
+        // ================================================================== outgoing (my own battle)
+        private static UInt16 _seq;
+        private static Int32 _lastSampleTick;
+        private static Boolean _wasInBattle;
+
+        // ================================================================== incoming (the peer's battle)
+        private sealed class UnitView
+        {
+            public Int32 Index;
+            public Boolean IsPlayer;
+            public Boolean Alive;
+            public Boolean Ready;
+            public Boolean InTrance;
+            public UInt32 HpCur, HpMax, MpCur, MpMax;
+            public UInt16 AtbCur, AtbMax;
+            public String Name;
+        }
+
+        private sealed class BattleView
+        {
+            public UInt16 Seq;
+            public UInt16 MapNo;
+            public Int32 GuestSlots;       // the slots the BATTLE OWNER is offering to me
+            public readonly List<UnitView> Units = new List<UnitView>();
+        }
+
+        private static BattleView _peerView;
+        private static Int32 _peerViewTick;
+        private static Int32 _lastSendTick;        // assist-key cooldown
+        private static Int32 _pendingSlot = -1;    // slot we just commanded (panel shows "sent")
+
+        // host side of the control lane: the peer said their assist menu is open
+        private static Boolean _remoteMenuFlag;
+        private static Int32 _remoteMenuTick;
+        // ...and the peer is ACTIVELY ASSISTING at all (fresh control frames only flow while they
+        // spectate my battle). Guest gone / disconnected / busy in their OWN battle -> this decays
+        // and the slots REVERT TO LOCAL CONTROL (the fail-safe law).
+        private static Int32 _assistTick = Int32.MinValue;
+
+        // selftest loopback state (stands in for the socket)
+        private static Byte[] _loopBattle;
+        private static readonly Queue<Byte[]> _loopCommands = new Queue<Byte[]>();
+        private static Boolean _loopMenuOpen;
+
+        // GUI
+        private static Texture2D _panelBg;
+        private static GUIStyle _panelStyle;
+
+        // ============================================================================ BattleHUD hooks
+        // Both hooks are read from engine code paths every frame -- they must be CHEAP and can never
+        // throw. When the feature is off they are a couple of integer compares (zero footprint).
+
+        // The local HUD must not open a menu for a slot the peer owns (BattleHUD ready loop / switch
+        // paths call this). Only meaningful while I am the one in battle. A slot counts as
+        // guest-owned only while the guest is LIVE (fresh control frames) -- otherwise it instantly
+        // reverts to local control, so a dropped/busy peer can never orphan a party member.
+        // (Known benign race: the guest's first control frame takes ~RTT to arrive, so a slot whose
+        // ATB is full at battle start may open locally for its first turn.)
+        public static Boolean IsGuestOwnedSlot(Int32 slot)
+        {
+            if (!Enabled || GuestSlots == 0 || slot < 0 || slot >= 4 || (GuestSlots & (1 << slot)) == 0)
+                return false;
+            return (Environment.TickCount - _assistTick) < MenuStaleMs;
+        }
+
+        // The peer's assist menu is open -> WAIT/Turn-Based ATB gates treat it like a local menu
+        // (BattleHUD.IsNativeEnableAtb / FF9BMenu_IsEnableAtb). Decays on staleness so a hung or
+        // disconnected guest can never freeze the host's battle.
+        public static Boolean RemoteMenuOpen
+        {
+            get
+            {
+                return Enabled && GuestSlots != 0 && _remoteMenuFlag &&
+                       (Environment.TickCount - _remoteMenuTick) < MenuStaleMs;
+            }
+        }
+
+        // Config changed / transport dropped: forget everything volatile.
+        public static void Reset()
+        {
+            _peerView = null;
+            PeerBattleLive = false;
+            _remoteMenuFlag = false;
+            _assistTick = Int32.MinValue;
+            _pendingSlot = -1;
+            _wasInBattle = false;
+            _loopBattle = null;
+            _loopCommands.Clear();
+            _loopMenuOpen = false;
+        }
+
+        // ============================================================================ the pumps
+        // Real co-op, both directions. Called every frame from NetSyncClient.Update (main thread).
+        public static void Pump(INetTransport socket, EventEngine ee)
+        {
+            if (!Enabled || socket == null)
