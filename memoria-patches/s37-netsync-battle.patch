+        try
+        {
+            BattleUnit unit = FF9StateSystem.Battle.FF9Battle.GetUnit(playerIndex);
+            foreach (BattleAbilityId active in CharacterCommands.Commands[cmdId].EnumerateAbilities())
+                return (Int32)BattleAbilityHelper.Patch(active, unit.Player);
+        }
+        catch { }
+        return 0;
+    }
+
+    public Boolean NetMenuIsAbilityType(BattleCommandId cmdId)
