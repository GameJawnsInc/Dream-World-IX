+    // Deliberately does NOT touch CurrentPlayerIndex (a local menu may be open for a DIFFERENT slot).
+    public Boolean SendNetCommand(Int32 playerIndex, BattleCommandId commandId, Int32 subNo, UInt16 tarId, UInt32 cursor)
+    {
+        if (playerIndex == CurrentPlayerIndex)
+            return false;   // the local menu owns this slot right now (config raced) -- refuse
+        BattleUnit player = FF9StateSystem.Battle.FF9Battle.GetUnit(playerIndex);
+        CMD_DATA cmd = player.Data.cmd[0];
+        if (cmd == null || btl_cmd.CheckUsingCommand(cmd))
+            return false;
+        player.Data.sel_mode = 1;
+        btl_cmd.SetCommand(cmd, commandId, subNo, tarId, cursor);
+        if (!InputFinishList.Contains(playerIndex))
+            InputFinishList.Add(playerIndex);
+        _partyDetail.SetBlink(playerIndex, false);
+        return true;
+    }
