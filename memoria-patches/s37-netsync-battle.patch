+    // Live revalidation for a guest-cast ability: in this command's list, learned, and currently
+    // Enable'd (MP / silence / magic-sword supporter all re-checked NOW, not at roster time).
+    public Boolean NetAbilityUsable(Int32 playerIndex, BattleCommandId cmdId, Int32 activeAbilityId, out Int32 subNo)
+    {
+        subNo = 0;
+        try
+        {
+            BattleUnit unit = FF9StateSystem.Battle.FF9Battle.GetUnit(playerIndex);
+            Boolean inCommand = false;
+            foreach (BattleAbilityId active in CharacterCommands.Commands[cmdId].EnumerateAbilities())
+                if ((Int32)active == activeAbilityId) { inCommand = true; break; }
+            if (!inCommand)
+                return false;
+            SetAbilityAp(_abilityDetailDict[playerIndex]);
+            Int32 abilId = ff9abil.GetAbilityIdFromActiveAbility((BattleAbilityId)activeAbilityId);
+            if (GetAbilityState(abilId, playerIndex) != AbilityStatus.Enable)
+                return false;
+            subNo = (Int32)BattleAbilityHelper.Patch((BattleAbilityId)activeAbilityId, unit.Player);
+            return true;
+        }
+        catch { return false; }
