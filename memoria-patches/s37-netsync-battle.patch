--- /dev/null
+++ b/Assembly-CSharp/Memoria/Netsync/NetSyncVisitor.cs
@@ -0,0 +1,152 @@
+using System;
+using System.Collections.Generic;
+
+namespace Memoria.Netsync
+{
+    // VISITOR MODE (co-op V1, see studies/battle-coop): the guest is a presence inside the HOST's
+    // game -- a cosmetic extra party member on the map, commanding GuestSlots members in battle.
+    // This class holds the pieces that are pure data/derivation:
+    //   - the rig table (field model + movement clip ids per playable -- transcribed from the kit's
+    //     in-game-proven playerswap.CHARACTERS, itself extracted from each character's home field)
+    //   - locomotion classification (my anim id -> a rig-neutral enum, sent on the wire) and its
+    //     inverse (enum -> the DRESSED rig's clip id) -- anim ids are rig-partitioned, so a ghost
+    //     wearing a different model than the peer walks needs the translation, not the raw id
+    //   - GhostAs resolution ("dress the peer's ghost as X"): "auto" = the party member of my first
+    //     GuestSlots bit; or an explicit playable name; "" = off (the ghost wears the peer's model)
+    //   - SuppressEncounters, read by the SettingsState.IsNoEncounter hook: while FOLLOWING the
+    //     host, the guest's own random encounters pause (only the host's battles exist; the guest
+    //     assists through the battle lanes)
+    public static class NetSyncVisitor
+    {
+        // --- config mirrors (written by NetSyncClient on every config [re]load; main thread) ---
+        public static Boolean Enabled;
+        public static String GhostAs = "";     // [Netsync] GhostAs = "" | auto | zidane..amarant (+aliases)
+        public static Boolean FollowHost;      // [Netsync] FollowHost = 0/1 (guest side)
+
+        // Read by the SettingsState.IsNoEncounter engine hook -- must be cheap, never throws.
+        public static Boolean SuppressEncounters;
+
+        public const Byte LocoOther = 0, LocoIdle = 1, LocoWalk = 2, LocoRun = 3, LocoTurnL = 4, LocoTurnR = 5;
+
+        // Field player rigs for the 8 mains, index == CharacterId (0 Zidane .. 7 Amarant). The data is
+        // the kit's proven home-field extraction (model id + the 5 movement clips); characters beyond
+        // the 8 (Cinna/Marcus/Blank/Beatrix/customs) have no row -> dressing/classification fall back.
+        private struct Rig
+        {
+            public UInt16 Model, Idle, Walk, Run, TurnL, TurnR;
+            public Rig(UInt16 model, UInt16 idle, UInt16 walk, UInt16 run, UInt16 turnL, UInt16 turnR)
+            {
+                Model = model; Idle = idle; Walk = walk; Run = run; TurnL = turnL; TurnR = turnR;
+            }
+        }
+
+        private static readonly Rig[] Rigs =
+        {
+            new Rig(98,   200,  25,   38,   40,   41),    // 0 Zidane
+            new Rig(8,    148,  571,  419,  917,  918),   // 1 Vivi
+            new Rig(185,  2089, 2086, 2091, 2088, 2084),  // 2 Garnet
+            new Rig(5489, 2001, 1996, 2005, 1986, 2010),  // 3 Steiner
+            new Rig(192,  2556, 2553, 2558, 2555, 2551),  // 4 Freya
+            new Rig(273,  3228, 3237, 3230, 3235, 3227),  // 5 Quina
+            new Rig(443,  7503, 7518, 7506, 7516, 7514),  // 6 Eiko
+            new Rig(509,  8307, 8316, 8312, 8310, 8314),  // 7 Amarant
+        };
+
+        private static readonly Dictionary<String, Int32> NameToRig = new Dictionary<String, Int32>
+        {
+            { "zidane", 0 }, { "vivi", 1 }, { "garnet", 2 }, { "dagger", 2 }, { "steiner", 3 },
+            { "freya", 4 }, { "quina", 5 }, { "eiko", 6 }, { "amarant", 7 }, { "salamander", 7 },
+        };
+
+        private static Dictionary<Int32, Int32> _modelToRig;   // built lazily from Rigs
+
+        private static Int32 RigForModel(UInt16 model)
+        {
+            if (_modelToRig == null)
+            {
+                Dictionary<Int32, Int32> map = new Dictionary<Int32, Int32>(Rigs.Length);
+                for (Int32 i = 0; i < Rigs.Length; i++)
+                    map[Rigs[i].Model] = i;
+                _modelToRig = map;
+            }
+            Int32 idx;
+            return _modelToRig.TryGetValue(model, out idx) ? idx : -1;
+        }
+
+        // SENDER side: which rig-neutral locomotion is my current anim? Unknown model or a
+        // non-movement clip (a gesture) -> Other; the receiver plays the dressed rig's idle for it.
+        public static Byte ClassifyLoco(UInt16 model, UInt16 anim)
+        {
+            Int32 idx = RigForModel(model);
+            if (idx < 0)
+                return LocoOther;
+            Rig rig = Rigs[idx];
+            if (anim == rig.Idle) return LocoIdle;
+            if (anim == rig.Walk) return LocoWalk;
+            if (anim == rig.Run) return LocoRun;
+            if (anim == rig.TurnL) return LocoTurnL;
+            if (anim == rig.TurnR) return LocoTurnR;
+            return LocoOther;
+        }
+
+        // RECEIVER side: the dressed rig's clip for a wire locomotion value (Other -> idle).
+        public static UInt16 LocoAnim(Int32 rigIdx, Byte loco)
+        {
+            if (rigIdx < 0 || rigIdx >= Rigs.Length)
+                return 0;
+            Rig rig = Rigs[rigIdx];
+            switch (loco)
+            {
+                case LocoWalk: return rig.Walk;
+                case LocoRun: return rig.Run;
+                case LocoTurnL: return rig.TurnL;
+                case LocoTurnR: return rig.TurnR;
+                default: return rig.Idle;
+            }
+        }
+
+        // The model the PEER's ghost should wear on MY screen, per GhostAs. 0 = no dressing (wire
+        // model). "auto" = the party member of my first GuestSlots bit -- the character the guest
+        // commands in battle is the character they appear as on the field.
+        public static UInt16 ResolveDress(Int32 guestSlots, out Int32 rigIdx)
+        {
+            rigIdx = -1;
+            if (!Enabled)
+                return 0;
+            String mode = (GhostAs ?? "").Trim().ToLowerInvariant();
+            if (mode.Length == 0 || mode == "off" || mode == "0")
+                return 0;
+            try
+            {
+                Int32 charId = -1;
+                if (mode == "auto")
+                {
+                    if (guestSlots == 0)
+                        return 0;
+                    Int32 slot = 0;
+                    while (slot < 4 && (guestSlots & (1 << slot)) == 0)
+                        slot++;
+                    if (slot >= 4)
+                        return 0;
+                    PLAYER member = FF9StateSystem.Common.FF9.party.member[slot];
+                    if (member == null)
+                        return 0;
+                    charId = (Int32)member.Index;
+                }
+                else if (!NameToRig.TryGetValue(mode, out charId))
+                {
+                    return 0;   // unknown name -> no dressing (logged once at config time by the client)
+                }
+                if (charId < 0 || charId >= Rigs.Length)
+                    return 0;   // Cinna/Marcus/Blank/Beatrix/customs: no proven rig row -> wire model
+                rigIdx = charId;
+                return Rigs[charId].Model;
+            }
+            catch
+            {
+                rigIdx = -1;
+                return 0;
+            }
+        }
+    }
+}
