+            return CharacterCommands.Commands.ContainsKey(cmdId) &&
+                   CharacterCommands.Commands[cmdId].Type == CharacterCommandType.Ability;
+        }
+        catch { return false; }
+    }
+
+    // The first USABLE ability of a command (what a real menu's first visible entry would be) --
+    // the validated form of NetFirstAbilitySub, for single-shot casts through Ability-type commands.
+    public Boolean NetFirstAbilityUsable(Int32 playerIndex, BattleCommandId cmdId, out Int32 subNo)
+    {
+        subNo = 0;
+        try
+        {
+            foreach (BattleAbilityId active in CharacterCommands.Commands[cmdId].EnumerateAbilities())
+                if (NetAbilityUsable(playerIndex, cmdId, (Int32)active, out subNo))
+                    return true;
+        }
+        catch { }
