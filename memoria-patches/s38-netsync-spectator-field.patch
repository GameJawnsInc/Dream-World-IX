diff --git a/Assembly-CSharp/Assets/SiliconSocial/AchievementManager.cs b/Assembly-CSharp/Assets/SiliconSocial/AchievementManager.cs
index 9dfff49..d408424 100644
--- a/Assembly-CSharp/Assets/SiliconSocial/AchievementManager.cs
+++ b/Assembly-CSharp/Assets/SiliconSocial/AchievementManager.cs
@@ -101,6 +101,14 @@ namespace Assets.SiliconSocial
 
         public static void ProcessAchievementReport(AcheivementKey key, Int32 progress, Int32 percentProgress, Int32 retryCount)
         {
+            // CO-OP SPECTATOR-FIELD: a FOLLOWING guest is living in the HOST's mirrored story with its own
+            // save frozen -- everything it does this session is discarded by the autoload exit ramp. A Steam
+            // achievement report is the ONE write that escapes that guarantee: it leaves the machine and no
+            // ramp can take it back. This is the single funnel every channel crosses (item pickup, battle,
+            // ability, minigame) before the native call, so gating here closes the whole class.
+            // [ff9mapkit netsync spectator-field]
+            if (Memoria.Netsync.NetSyncClient.IsMirroringStory)
+                return;
             if (!Social.IsSocialPlatformAuthenticated())
                 return;
             AchievementManager.AchievementRetryCount[(Int32)key] = retryCount;
diff --git a/Assembly-CSharp/Global/Event/Engine/EventEngine.DoEventCode.cs b/Assembly-CSharp/Global/Event/Engine/EventEngine.DoEventCode.cs
index 8d73e0e..e96f3d5 100644
--- a/Assembly-CSharp/Global/Event/Engine/EventEngine.DoEventCode.cs
+++ b/Assembly-CSharp/Global/Event/Engine/EventEngine.DoEventCode.cs
@@ -959,6 +959,17 @@ public partial class EventEngine
                 this.getv1(); // arg1: rush type (unknown)
                 this._ff9.btlSubMapNo = -1;
                 Int32 btlId = this.getv2(); // arg2: gathered battle and Steiner's state (highest bit) informations
+                // CO-OP SPECTATOR-FIELD: a FOLLOWING guest runs its own copy of the HOST's mirrored script, so a
+                // scripted battle would boot a LOCAL fight the host is not in -- and its result screen writes the
+                // guest's real gil + item drops. The guest spectates the host's battle over the wire instead
+                // (B0/B1), so the opcode is skipped. Returning 0 continues the script inline; returning 3 would
+                // hand the frame to the battle scene. NOTE THE ARG TRAP: every getv MUST run before this gate --
+                // commandDefault2 branches on gArgUsed and REWINDS the IP by one byte if no arg was consumed,
+                // which re-executes this opcode forever. SuppressEncounters does NOT cover this path (it only
+                // reaches ff9.IsNoEncounter = the random-step and worldmap rolls).
+                // [ff9mapkit netsync spectator-field]
+                if (Memoria.Netsync.NetSyncClient.IsMirroringStory)
+                    return 0;
                 this._ff9.steiner_state = (Byte)(btlId >> 15 & 1);
                 this.SetBattleScene(btlId & Int16.MaxValue);
                 FF9StateSystem.Battle.isRandomEncounter = false;
@@ -968,8 +979,10 @@ public partial class EventEngine
             case EBin.event_code_binary.ENCOUNT2: // 0x8C, "BattleEx", "Start a battle and choose its battle group"
             {
                 this.getv1(); // arg1: rush type (unknown)
-                this._ff9.btlSubMapNo = (SByte)this.getv1(); // arg2: group
+                this._ff9.btlSubMapNo = (SByte)this.getv1(); // arg2: group -- the read is fused to the write; it must run (gArgUsed)
                 Int32 btlId = this.getv2(); // arg3: gathered battle and Steiner's state (highest bit) informations
+                if (Memoria.Netsync.NetSyncClient.IsMirroringStory)
+                    return 0; // see ENCOUNT above [ff9mapkit netsync spectator-field]
                 this._ff9.steiner_state = (Byte)(btlId >> 15 & 1);
                 this.SetBattleScene(btlId & Int16.MaxValue);
                 FF9StateSystem.Battle.isRandomEncounter = false;
