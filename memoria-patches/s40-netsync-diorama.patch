+                    bw.Write(targetSlot);
+                    bw.Write(target.fig.info);
+                    bw.Write(target.fig.hp);
+                    bw.Write(target.fig.mp);
+                    bw.Write(caster.fig.info);
+                    bw.Write(caster.fig.hp);
+                    bw.Write(caster.fig.mp);
+                    bw.Write(target.cur.hp);               // RAW post-application, never logical CurrentHp
+                    bw.Write(target.cur.mp);
+                    bw.Write(caster.cur.hp);
+                    bw.Write(caster.cur.mp);
