+        // ---------------------------------------------------------------------------------------
+        // B3.4 -- THE RECONCILER: the host's type-1 truth (HP/MP/death/trance/ATB) applied onto the
+        // diorama's actors every fresh wire sample (~150 ms). Full verified design =
+        // studies/battle-coop/b34-recon.md; the essentials encoded here:
+        //   RESOLUTION -- wire Index == the btl_data ARRAY SLOT (GetIndex is log2(btl_id); players are
+        //     the host's COMPACTED party positions 0-3, enemies 4-7 in pattern order). Resolve by
+        //     DIRECT btl_data access + guards; NEVER EnumerateBattleUnits (btl_list is blind to
+        //     DelCharacter'd units) and NEVER GetIndex() on a slot (btl_id==0 loops forever). Players
+        //     resolve by CHARACTER (bi.slot_no vs the host compaction replayed over NetSyncParty.Slots)
+        //     which is compaction-proof against the unseatable-character fallback.
+        //   THE HP SPLIT -- btl_para's +/-10000 boss transform is ENEMY-only and the IsHpMpFull booster
+        //     snap is PLAYER-only: players get RAW cur/max writes (exact, booster-immune), enemies get
+        //     the LOGICAL properties (the inverse of the host's logical sample). Max lane FIRST
+        //     (CheckPointData clamps cur to max the next frame).
+        //   DEATH -- raw cur.hp = 0 once + AlterStatus(Death) (bypassResistances latches on raw 0) +
+        //     SetDefaultIdle for same-tick onset; the stock pipeline (die_seq -> fade -> DelCharacter)
+        //     runs by itself, its dangerous ends gated by R1/R2 and the bracket. Dead + Death status =
+        //     write NOTHING (idempotent). REVIVE = HP FIRST then RemoveStatus(Death) -- the engine's
+        //     own AutoLife idiom; DeathStatusScript.Remove resets die_seq/motion itself. A fully-faded
+        //     enemy (die_seq >= 5) is UNREACHABLE from a live wire (the host's copy fades first and
+        //     falls off EnumerateBattleUnits) -- deliberately unsupported, logged if ever seen.
+        //   MISSING-AS-DEAD (enemies) -- a wire frame OMITS DelCharacter'd units, so an enemy the guest
+        //     knows that is absent from the frame is DEAD on the host. This also makes LATE-JOIN boots
+        //     correct: the stock spawn raises every pattern enemy, and the first reconcile kills the
+        //     ones the host already destroyed. Players are never swept (a snorted/removed player is not
+        //     dead) -- they hold last state.
+        //   TRANCE -- the raw stat.cur Trance bit (REQUIRED for enemies too: the glow candidate list is
+        //     built from CurrentStatus; enable_trance_glow is only the inner key) + enable_trance_glow;
+        //     the player model swap keys on the STATELESS PROBE (gameObject == tranceGo) != wire --
+        //     corpse-safe and revive-self-healing where an edge-trigger is fragile (Death does NOT
+        //     strip the bit in a command-less diorama). Never AlterStatus(Trance) (SysTrans command +
+        //     achievement), never SetTranceModel on enemies (tranceGo null).
+        //   ATB -- players only (enemies have no gauge): raw max.at then cur.at clamped. Menu-wake is
+        //     impossible: AddPlayerToReady's only caller is inside the isDebug-gated ProcessActiveTime.
+        // ---------------------------------------------------------------------------------------
+        private static readonly NetSyncBattle.PeerUnit[] _wireUnits = new NetSyncBattle.PeerUnit[8];
+        private static UInt16 _lastAppliedSeq;
+        private static Boolean _seqSeen;
+        private static Boolean _reconcileLogged;
+        private static Boolean _reconcileErrLogged;
+        private static Int32 _reconcileSkipLogMask;   // one log per unresolvable wire index per boot
+        private static Int32 _hiddenMask;             // which enemy slots WE hid (mirrors the wire bit)
+
+        // B3.5 -- THE PER-SLOT HORIZON GATES. An applied action frame stamps its seqHorizon for both
+        // its wire slots; a type-1 sample OLDER than the horizon ((Int16)(seq - gate) < 0 -- the
+        // SIGNED-DIFF idiom, wrap-safe: UInt16 wraps in ~2.7 h of 150 ms sampling) skips the WHOLE
+        // unit record (not just hp/mp -- a stale Alive=true on a just-killed unit would otherwise
+        // fire the full revive lane: corpse-stand-up, then re-kill). A post-horizon sample clears
+        // the gate and wins. Cleared in the boot-reset block, Boot's failure path, and ForceDisarm.
+        private static readonly UInt16[] _gateSeq = new UInt16[8];
+        private static readonly Boolean[] _gated = new Boolean[8];
+        private static Boolean _actionErrLogged;      // once per boot, like _reconcileErrLogged
+
+        /// <summary>Called every frame from NetSyncClient.Update (after DioramaTick). Cheap no-op
+        /// outside a live diorama battle.</summary>
+        public static void ReconcileTick()
+        {
+            if (!_booted || !Active)
+                return;
+            try
+            {
+                FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+                if (b == null || b.btl_phase != FF9StateBattleSystem.PHASE_NORMAL)
+                    return;   // quiesce outside the steady state (PHASE_ENTER's per-frame fade re-stamp
+                              // would fight a death fade; post-NORMAL means something flipped the phase)
+                const Byte need = ff9btl.LOAD_INITNPC | ff9btl.LOAD_INITCHR;
+                if ((b.btl_load_status & need) != need)
+                    return;   // this battle's units aren't final yet (one BattleLoadLoop frame sets both)
+                UInt16 seq;
+                Int32 n = NetSyncBattle.TryGetPeerUnits(_wireUnits, out seq);
+                if (n <= 0)
+                    return;   // no live peer battle: freeze at last applied state (the leave follows)
+                if (_seqSeen && seq == _lastAppliedSeq)
+                    return;   // this sample is already applied
+                _lastAppliedSeq = seq;
+                _seqSeen = true;
+                ApplyUnits(b, _wireUnits, n, seq);
+                if (!_reconcileLogged)
+                {
+                    _reconcileLogged = true;
+                    Log.Message("[NetSync] diorama reconcile live: " + n + " wire unit(s) driving the scene");
+                }
+            }
+            catch (Exception ex)
+            {
+                if (!_reconcileErrLogged)
+                {
+                    _reconcileErrLogged = true;   // once per boot: never per-frame error spam
+                    Log.Error("[NetSync] diorama reconcile failed: " + ex);
+                }
+            }
+        }
+
+        private static void ApplyUnits(FF9StateBattleSystem b, NetSyncBattle.PeerUnit[] units, Int32 n, UInt16 seq)
+        {
+            // A wire frame missing an index the guest knows = HOLD LAST STATE (the recon's law). The
+            // host samples btl_data DIRECTLY, so dead units stay on the wire as Alive=false (which is
+            // what makes late-join boots correct) and script-hidden alive units arrive with the HIDDEN
+            // bit -- "missing" can only mean a scene-data mismatch, never a state to infer from.
+            // (An earlier cut swept missing enemies as dead; the verify pass killed it -- it would have
+            // permanently killed alive-but-unlinked enemies, the case-33 submerge idiom.)
+            for (Int32 k = 0; k < n; k++)
+                ApplyUnit(b, ref units[k], seq);
+        }
+
+        // The wire-slot -> BTL_DATA resolution, shared by the reconciler and the B3.5 action lane:
+        // players by COMPACTED character (compaction-proof), enemies by direct btl_data slot. NEVER
+        // EnumerateBattleUnits (blind to DelCharacter'd units), NEVER GetIndex (unbounded loop on a
+        // slave/teardown btl_id). Null = no local actor (the caller owns the skip-log).
+        private static BTL_DATA ResolveWireUnit(FF9StateBattleSystem b, Int32 index, Boolean isPlayer)
+        {
+            if (index < 0 || index > 7)
+                return null;
+            if (isPlayer)
+            {
+                Byte charId;
+                if (!CompactedCharId(index, out charId))
+                    return null;
+                for (Int32 i = 0; i < 4; i++)
+                {
+                    BTL_DATA c = b.btl_data[i];
+                    if (c != null && c.btl_id == (UInt16)(1 << i) && c.bi.player != 0 && c.bi.slot_no == charId)
+                        return c;
+                }
+                return null;
+            }
+            if (index >= 4)
+            {
+                BTL_DATA c = b.btl_data[index];
+                if (c != null && c.btl_id == (UInt16)(1 << index) && c.bi.player == 0)
+                    return c;
+            }
+            return null;
+        }
+
+        // One line per unresolvable wire index per boot (the reconciler + action lane share the mask).
+        private static void LogUnresolvedWireUnit(Int32 index, String lane)
+        {
+            if ((_reconcileSkipLogMask & (1 << index)) != 0)
+                return;
+            _reconcileSkipLogMask |= 1 << index;
+            Log.Message("[NetSync] diorama " + lane + ": wire unit " + index + " has no local actor (skipped)");
+        }
+
+        private static void ApplyUnit(FF9StateBattleSystem b, ref NetSyncBattle.PeerUnit u, UInt16 seq)
+        {
+            if (u.Index > 7)
+                return;
+            // B3.5 HORIZON GATE: a pre-horizon sample predates the last applied action frame for this
+            // slot -- skip the WHOLE record (all lanes; a partial skip would regress death/revive).
+            if (_gated[u.Index])
+            {
+                if ((Int16)(seq - _gateSeq[u.Index]) < 0)
+                    return;
+                _gated[u.Index] = false;   // post-horizon: the sample is fresher, it wins from here on
+            }
+            BTL_DATA d = ResolveWireUnit(b, u.Index, u.IsPlayer);
+            if (d == null)
+            {
+                LogUnresolvedWireUnit(u.Index, "reconcile");
+                return;
+            }
+
+            Boolean hasDeath = (d.stat.cur & BattleStatus.Death) != 0;
+            if (!u.Alive)
+            {
+                if (!hasDeath)
+                    KillUnit(d);
+                return;                              // dead: the death lane owns everything
+            }
+
+            BattleUnit unit = new BattleUnit(d);
+            // MAX lane first
+            if (u.IsPlayer)
+            {
+                if (u.HpMax > 0) d.max.hp = u.HpMax;
+                if (u.MpMax > 0) d.max.mp = u.MpMax;
+            }
+            else
+            {
+                if (u.HpMax > 0) unit.MaximumHp = u.HpMax;
+                if (u.MpMax > 0) d.max.mp = u.MpMax;
+            }
+            // REVIVE before the HP lane: HP FIRST, then RemoveStatus (the AutoLife idiom -- an aborted
+            // tick leaves a dead unit at hp>0, stable and retried; the reverse re-kills every frame)
+            UInt32 hp = u.HpCur == 0 ? 1u : u.HpCur;         // trust Alive over HpCur
+            if (u.IsPlayer)
+                d.cur.hp = Math.Min(hp, d.max.hp);
+            else
+                unit.CurrentHp = Math.Min(hp, unit.MaximumHp);
+            d.cur.mp = Math.Min(u.MpCur, d.max.mp);
+            if (hasDeath)
+            {
+                if (d.bi.player == 0 && d.die_seq >= 5)
+                {
+                    if ((_reconcileSkipLogMask & (1 << (8 + u.Index))) == 0)
+                    {
+                        _reconcileSkipLogMask |= 1 << (8 + u.Index);
+                        Log.Message("[NetSync] diorama: revive requested for a fully-faded enemy (die_seq "
+                                    + d.die_seq + ") -- unsupported, holding dead");
+                    }
+                    return;
+                }
+                btl_stat.RemoveStatus(unit, BattleStatusId.Death);   // resets die_seq/motion itself
+            }
+            // VISIBILITY (enemies): mirror the host's script-hide -- the case-33 renderer idiom,
+            // WITHOUT the list surgery (the guest's unit stays linked; visibility is cosmetic here).
+            if (!u.IsPlayer)
+            {
+                Boolean nowHidden = (_hiddenMask & (1 << u.Index)) != 0;
+                if (u.Hidden != nowHidden)
+                {
+                    for (Int32 m = 0; m < d.meshCount; m++)
+                        d.SetIsEnabledMeshRenderer(m, !u.Hidden);
+                    try { d.getShadow().SetActive(!u.Hidden); } catch { }
+                    d.SetIsEnabledWeaponRenderer(!u.Hidden);
+                    d.SetIsEnabledBattleModelRenderer(!u.Hidden);
+                    if (u.Hidden) _hiddenMask |= 1 << u.Index;
+                    else _hiddenMask &= ~(1 << u.Index);
+                }
+            }
+            // TRANCE
+            if (u.InTrance)
+                d.stat.cur |= BattleStatus.Trance;
+            else
+                d.stat.cur &= ~BattleStatus.Trance;
+            d.enable_trance_glow = u.InTrance;
+            if (u.IsPlayer)
+                d.trance = u.TranceGauge;   // v9: the live gauge byte -- the HUD's TranceBar reads
+                                            // Data.trance per frame (PLAYER.trance is stale mid-battle)
+            if (u.IsPlayer && d.tranceGo != null && d.gameObject != null)
+            {
+                Boolean wearing = ReferenceEquals(d.gameObject, d.tranceGo);
+                if (wearing != u.InTrance)
+                    btl_vfx.SetTranceModel(d, u.InTrance);
+            }
+            // ATB (players only)
+            if (u.IsPlayer)
+            {
+                Int16 maxAt = (Int16)Math.Min(Math.Max((Int32)u.AtbMax, 1), Int16.MaxValue);
+                d.max.at = maxAt;
+                d.cur.at = (Int16)Math.Min((Int32)u.AtbCur, (Int32)maxAt);
+            }
+        }
+
+        private static void KillUnit(BTL_DATA d)
+        {
+            d.cur.hp = 0;                                    // raw: bypasses both enemy-side floors by design
+            BattleUnit unit = new BattleUnit(d);
+            if (!btl_stat.CheckStatus(unit, BattleStatus.Death))
+                btl_stat.AlterStatus(unit, BattleStatusId.Death);   // same-tick onset; bypass latched on raw 0
+            btl_mot.SetDefaultIdle(d);                       // the pose now, not at the idle-cycle end
+        }
+
+        // The wire Index for players is the HOST's COMPACTED party position (InitPlayerData skips
+        // null members). Replay that compaction over the mirrored party sections -- NEVER over the
+        // guest's own party.member, which diverges exactly in the unseatable-character case. In the
+        // selftest bench (no mirror) the guest's own party IS the truth, compacted the same way.
+        private static Boolean CompactedCharId(Int32 index, out Byte charId)
+        {
+            charId = 0;
+            Int32 seen = 0;
+            if (NetSyncParty.MirrorActive)
+            {
+                for (Int32 i = 0; i < 4; i++)
+                {
+                    if (!NetSyncParty.Slots[i].Present)
+                        continue;
+                    if (seen == index) { charId = NetSyncParty.Slots[i].CharId; return true; }
+                    seen++;
+                }
+                return false;
+            }
+            try
+            {
+                PLAYER[] member = FF9StateSystem.Common.FF9.party.member;
+                for (Int32 i = 0; i < 4; i++)
+                {
+                    if (member[i] == null)
+                        continue;
+                    if (seen == index) { charId = (Byte)member[i].info.slot_no; return true; }
+                    seen++;
+                }
+            }
+            catch { }
+            return false;
+        }
+
+        // ---------------------------------------------------------------------------------------
+        // B3.5 -- THE ACTION LANE (guest side): the host's per-CalcResult frames applied between
+        // the wire drain and the reconcile. Ordering laws (the assembled apply order): figures ->
+        // motions -> state -> gate, inside each frame; frames in FIFO order; DRAIN BEFORE RECONCILE
+        // (NetSyncClient owns that call order). Death derives from raw wire hp + the type-1 lane
+        // only -- never from mirrored status bits (Death is deferred past the host's emit point on
+        // ordinary killing blows).
+        // ---------------------------------------------------------------------------------------
+
+        /// <summary>
+        /// Called every frame from NetSyncClient.Update BETWEEN NetSyncBattle.Pump and ReconcileTick.
+        /// Not booted -> drain-and-discard to exhaustion (F2: the emit is symmetric -- a guest fighting
+        /// its OWN battle streams action frames the host receives, and in the both-in-battle spectate
+        /// state nobody else drains them; battleNonce is a Byte, so the discard must be structural,
+        /// never nonce-probabilistic). Booted but not quiesced -> return WITHOUT draining (the boot
+        /// backlog IS the first real frames; GetFreeEntry dereferences the actor transform at figure
+        /// request time, so applying mid-boot NREs). Cheap no-op with an empty queue.
+        /// </summary>
+        internal static void ActionTick(INetTransport socket)
+        {
+            if (socket == null)
+                return;
+            try
+            {
+                if (!_booted)
+                {
+                    while (socket.NextRemoteAction() != null) { }   // F2: drain-and-discard
+                    return;
+                }
+                if (!Active)
+                    return;   // booted but the scene isn't ours (fade in flight) -- leave queued
+                FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+                if (b == null || b.btl_phase != FF9StateBattleSystem.PHASE_NORMAL)
+                    return;   // the reconciler's exact quiesce gate -- leave queued
+                const Byte need = ff9btl.LOAD_INITNPC | ff9btl.LOAD_INITCHR;
+                if ((b.btl_load_status & need) != need)
+                    return;   // units not final yet -- leave queued, drained in order on the first steady frame
+                Byte[] payload;
+                while ((payload = socket.NextRemoteAction()) != null)
+                {
+                    NetSyncBattle.PeerAction a;
+                    if (!NetSyncBattle.TryParseAction(payload, out a))
+                        continue;
+                    // (a) NONCE -- frames keyed to a battle this diorama did not boot are dropped;
+                    // a MANUAL F6 boot (BootedWireNonce < 0) drops everything (F3).
+                    if (BootedWireNonce < 0 || a.Nonce != (Byte)BootedWireNonce)
+                        continue;
+                    ApplyActionFrame(b, ref a);
+                }
+            }
+            catch (Exception ex)
+            {
+                if (!_actionErrLogged)
+                {
+                    _actionErrLogged = true;   // once per boot: never per-frame error spam
+                    Log.Error("[NetSync] diorama action apply failed: " + ex);
+                }
+            }
+        }
+
+        // The assembled per-frame apply (steps b-h; step a, the nonce, is the caller's).
+        private static void ApplyActionFrame(FF9StateBattleSystem b, ref NetSyncBattle.PeerAction a)
+        {
+            // (b) RESOLVE -- the reconciler's exact resolution; an unresolvable unit is skipped, the
+            // other still processes. Slot 0xFF = the host itself could not resolve it.
+            BTL_DATA dT = null, dC = null;
+            if (a.TargetSlot <= 7)
+            {
+                dT = ResolveWireUnit(b, a.TargetSlot, a.TargetIsPlayer);
+                if (dT == null)
+                    LogUnresolvedWireUnit(a.TargetSlot, "action");
+            }
+            if (a.CasterSlot <= 7)
+            {
+                dC = ResolveWireUnit(b, a.CasterSlot, a.CasterIsPlayer);
+                if (dC == null)
+                    LogUnresolvedWireUnit(a.CasterSlot, "action");
+            }
+            if (dT == null && dC == null)
+                return;
+            Boolean selfCast = ReferenceEquals(dT, dC);   // caster == target: one unit, one lane
+                                                          // (target.fig IS caster.fig on the host then --
+                                                          // popping both would double the figure)
+
+            // (c) DERIVE from RAW wire hp only -- never from wire status bits.
+            Boolean lethalT = a.TgtHpRaw == 0;
+            Boolean lethalC = a.CastHpRaw == 0;
+            Boolean reviveT = dT != null && !lethalT && (dT.stat.cur & BattleStatus.Death) != 0;
+            Boolean reviveC = dC != null && !lethalC && (dC.stat.cur & BattleStatus.Death) != 0;
+            Boolean hiddenT = dT != null && !a.TargetIsPlayer && (_hiddenMask & (1 << a.TargetSlot)) != 0;
+            Boolean hiddenC = dC != null && !a.CasterIsPlayer && (_hiddenMask & (1 << a.CasterSlot)) != 0;
+
+            // (d) FIGURES FIRST -- GetFreeEntry snapshots the bone transform at request time, so the
+            // number outlives the death fade exactly as in stock. HAND-BUILT param with EMPTY
+            // modifiers (F4): NEVER Btl2dReqInstant (it harvests live IFigurePointStatusScript
+            // effects -- the v9 status carry means Trouble could be seated, and its OnFigurePoint
+            // deals REAL spread damage), NEVER write d.fig (nothing on a command-less guest ever
+            // consumes it; a stale crit bit would even shove pos[2] in a later flinch). Skip hidden
+            // slots (F6: the guest hides via renderer toggles, so btl2d's own bi.disappear drop
+            // never fires here -- a figure would float over an invisible model).
+            if (dT != null && !hiddenT && (a.FigInfoT != 0 || a.FigHpT != 0 || a.FigMpT != 0))
+                btl2d.Btl2dReq(dT, new Btl2dParam { info = a.FigInfoT, hp = a.FigHpT, mp = a.FigMpT });
+            if (dC != null && !selfCast && !hiddenC && (a.FigInfoC != 0 || a.FigHpC != 0 || a.FigMpC != 0))
+                btl2d.Btl2dReq(dC, new Btl2dParam { info = a.FigInfoC, hp = a.FigHpC, mp = a.FigMpC });
+
+            // (e) MOTIONS -- cosmetic, decided from WIRE lethality BEFORE any HP write (F5: on a
+            // lethal frame KillUnit owns the pose; SetDamageMotion's enemy branch would write
+            // die_seq=1 itself if hp were already 0). SetDamageMotion(unit, null) is null-cmd-safe
+            // (forces MP_DAMAGE1) and slave-safe internally; guest fig.info stays 0, so no crit
+            // shove. The FrozenAnimation guard is LOAD-BEARING now that carried statuses can seat
+            // Petrify/Stop members at spawn.
+            if (dT != null && a.DmgMot && !lethalT && !reviveT && !hiddenT && CanPlayCosmeticMotion(dT))
+                btl_mot.SetDamageMotion(new BattleUnit(dT), null);
+            // Player-only caster swing: an enemy's mot table is String[6] -- setMotion(MP_ATTACK)
+            // would index out of range; enemy attack anims exist only as per-scene SEQ data.
+            if (dC != null && !selfCast && a.CasterIsPlayer && !lethalC && !reviveC && !hiddenC && CanPlayCosmeticMotion(dC))
+            {
+                btl_mot.setMotion(dC, BattlePlayerCharacter.PlayerMotionIndex.MP_ATTACK);
+                dC.evt.animFrame = 0;   // MANDATORY after setMotion: a stale frame counter can end the
+                                        // clip on the first DispCharacter and skip the visible swing
+            }
+
+            // (f) TARGET STATE, (g) CASTER STATE -- raw against RAW max, bypassing ApplyUnit's
+            // logical enemy lanes (feeding raw values through SetLogicalHP would double-offset an
+            // FLG boss by +10000 and clamp raw cur against logical max).
+            if (dT != null)
+                ApplyActionState(dT, a.TargetSlot, lethalT, reviveT, a.TgtHpRaw, a.TgtMpRaw);
+            if (dC != null && !selfCast)
+                ApplyActionState(dC, a.CasterSlot, lethalC, reviveC, a.CastHpRaw, a.CastMpRaw);
+
+            // (h) GATE both resolved slots: any type-1 sample with seq < seqHorizon predates this
+            // application and must not regress it (the signed-diff compare lives in ApplyUnit).
+            if (dT != null)
+            {
+                _gated[a.TargetSlot] = true;
+                _gateSeq[a.TargetSlot] = a.SeqHorizon;
+            }
+            if (dC != null)
+            {
+                _gated[a.CasterSlot] = true;
+                _gateSeq[a.CasterSlot] = a.SeqHorizon;
+            }
+        }
+
+        // The action lane's single state-write routine -- the reconciler's death/revive idioms with
+        // RAW hp/mp writes for BOTH sides (players raw = booster-immune, enemies raw = the wire's
+        // exact post-application value; the type-1 lane's logical view round-trips it exactly
+        // outside the FLG dying band, and the band's fixpoint is B3.4's shipping behavior).
+        private static void ApplyActionState(BTL_DATA d, Int32 slot, Boolean lethal, Boolean revive, UInt32 hpRaw, UInt32 mpRaw)
+        {
+            Boolean hasDeath = (d.stat.cur & BattleStatus.Death) != 0;
+            if (lethal)
+            {
+                // Controlled kill NOW, not CheckPointData's unowned next-frame kill (no SetDefaultIdle
+                // pose) and not the ~150 ms-late sample kill -- the exact latency this lane removes.
+                if (!hasDeath)
+                    KillUnit(d);
+                return;   // dead: the death lane owns everything
+            }
+            if (revive && d.bi.player == 0 && d.die_seq >= 5)
+            {
+                // fully faded -- unsupported, hold dead (the reconciler's exact refusal + log band)
+                if ((_reconcileSkipLogMask & (1 << (8 + slot))) == 0)
+                {
+                    _reconcileSkipLogMask |= 1 << (8 + slot);
+                    Log.Message("[NetSync] diorama: action revive for a fully-faded enemy (die_seq "
+                                + d.die_seq + ") -- unsupported, holding dead");
+                }
+                return;
+            }
+            // HP FIRST (the AutoLife idiom -- an aborted tick leaves a dead unit at hp>0, stable and
+            // retried; the reverse re-kills every frame), then the Death removal.
+            d.cur.hp = Math.Min(hpRaw, d.max.hp);
+            d.cur.mp = Math.Min(mpRaw, d.max.mp);
+            if (revive)
+                btl_stat.RemoveStatus(new BattleUnit(d), BattleStatusId.Death);   // resets die_seq/motion itself
+        }
+
+        // The motion lane's shared guard: never disturb a death freeze, a die sequence, or a
+        // FrozenAnimation status pose (setMotion clears animFlag, which would break the freeze).
+        private static Boolean CanPlayCosmeticMotion(BTL_DATA d)
+        {
+            return d.die_seq == 0
+                && d.bi.stop_anim == 0
+                && (d.stat.cur & BattleStatus.Death) == 0
+                && !btl_stat.CheckStatus(d, BattleStatusConst.FrozenAnimation);
+        }
+
+        // ---------------------------------------------------------------------------------------
+        // THE B3.5 FIGURE BENCH (the F6 "Figure bench" button, diorama only). Pops ONE hand-built
+        // 1234-damage figure over the first live enemy (or btl_data[4]) through the EXACT Btl2dReq
+        // path the action lane uses. This is the audit's in-game gate on the whole figure lane:
+        // Singleton<HUDMessage> has never been asked for a figure inside a diorama -- if
+        // FindObjectOfType misses, Singleton<T> would CREATE a bare component with a null prototype
+        // and throw inside Show. One button press settles it before trusting the wire.
+        // ---------------------------------------------------------------------------------------
+        internal static Boolean FigureBench(out String detail)
+        {
+            detail = "not in a diorama battle";
+            if (!_booted || !Active)
+                return false;
+            try
+            {
+                FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+                const Byte need = ff9btl.LOAD_INITNPC | ff9btl.LOAD_INITCHR;
+                if (b == null || (b.btl_load_status & need) != need)
+                {
+                    detail = "units not initialized yet -- wait for the wipe-in";
+                    return false;
+                }
+                BTL_DATA d = null;
+                Int32 slot = -1;
+                for (Int32 i = 4; i <= 7; i++)
+                {
+                    BTL_DATA c = b.btl_data[i];
+                    if (c == null || c.btl_id != (UInt16)(1 << i) || c.bi.player != 0)
+                        continue;
+                    if (d == null)
+                    {
+                        d = c;   // fallback: the first valid enemy slot, even if dead
+                        slot = i;
+                    }
+                    if (c.cur.hp > 0 && (c.stat.cur & BattleStatus.Death) == 0)
+                    {
+                        d = c;   // prefer a live one (a dead fade drops the figure at bi.disappear)
+                        slot = i;
+                        break;
+                    }
+                }
+                if (d == null)
+                {
+                    detail = "no enemy slot to pop over";
+                    return false;
+                }
+                btl2d.Btl2dReq(d, new Btl2dParam { info = Param.FIG_INFO_DISP_HP, hp = 1234, mp = 0 });
+                detail = "popped a hand-built 1234 over enemy slot " + slot
+                         + " -- PASS = the white number renders and fades";
+                return true;
+            }
+            catch (Exception ex)
+            {
+                detail = "threw: " + ex.Message;
+                return false;
+            }
+        }
+
+        // ---------------------------------------------------------------------------------------
+        // THE B3.4 SOLO BENCH (the F6 "State bench" button, diorama only). Fabricates a PeerUnit set
+        // with values that exist nowhere in a natural diorama and pushes it through the SAME ApplyUnits
+        // core the wire uses. Toggles: odd press = CARNAGE (every enemy but the first DEAD; the first
+        // at ~25% HP; player slot 0 at HP 123 / MP 45, TRANCE on, ATB half), even press = RESTORE (all
+        // alive, full, no trance -- pressed before the fade completes this exercises the real REVIVE
+        // lane). PASS = the corpses, the glow, and HP 123 on the HUD; a no-op apply shows none of them.
+        // ---------------------------------------------------------------------------------------
+        private static Boolean _benchCarnage;
+
+        internal static Boolean StateBench(out String detail)
+        {
+            detail = "not in a diorama battle";
+            if (!_booted || !Active)
+                return false;
+            try
+            {
+                FF9StateBattleSystem b = FF9StateSystem.Battle.FF9Battle;
+                const Byte need = ff9btl.LOAD_INITNPC | ff9btl.LOAD_INITCHR;
+                if (b == null || (b.btl_load_status & need) != need)
+                {
+                    detail = "units not initialized yet -- wait for the wipe-in";
+                    return false;
+                }
+                _benchCarnage = !_benchCarnage;
+                NetSyncBattle.PeerUnit[] units = new NetSyncBattle.PeerUnit[8];
+                Int32 n = 0;
+                Int32 playerNo = 0, enemyNo = 0;
+                for (Int32 i = 0; i <= 7; i++)
+                {
+                    BTL_DATA d = b.btl_data[i];
+                    if (d == null || d.btl_id != (UInt16)(1 << i))
+                        continue;
+                    BattleUnit unit = new BattleUnit(d);
+                    NetSyncBattle.PeerUnit u = default(NetSyncBattle.PeerUnit);
+                    u.Index = (Byte)i;
+                    u.IsPlayer = d.bi.player != 0;
+                    u.HpMax = unit.MaximumHp;
+                    u.MpMax = unit.MaximumMp;
+                    u.AtbMax = (UInt16)Math.Max((Int32)d.max.at, 1);
+                    if (!_benchCarnage)
+                    {
+                        u.Alive = true;
+                        u.HpCur = u.HpMax; u.MpCur = u.MpMax;
+                        u.InTrance = false;
+                        u.AtbCur = 0;
+                    }
+                    else if (u.IsPlayer)
+                    {
+                        u.Alive = true;
+                        Boolean first = playerNo++ == 0;
+                        u.HpCur = first ? 123u : u.HpMax;
+                        u.MpCur = first ? 45u : u.MpMax;
+                        u.InTrance = first;
+                        u.TranceGauge = first ? (Byte)128 : (Byte)0;   // v9: the bar visibly half-fills
+                        u.AtbCur = first ? (UInt16)(u.AtbMax / 2) : (UInt16)0;
+                    }
+                    else
+                    {
+                        // ALL enemies die: with everyone dead and CheckBattlePhase + the R1 auto-end
+                        // both gated, the diorama must simply STAND -- the bench doubles as the
+                        // phase-flipper proof (an ungated fourth flipper would end the battle here).
+                        enemyNo++;
+                        u.Alive = false;
+                        u.HpCur = 0u;
+                        u.MpCur = u.MpMax;
+                        u.InTrance = false;
+                    }
+                    units[n++] = u;
+                }
+                if (n == 0)
+                {
+                    detail = "no live units to bench";
+                    return false;
+                }
+                ApplyUnits(b, units, n, _lastAppliedSeq);   // as-if the freshest sample (gates respected)
+                detail = (_benchCarnage
+                    ? "CARNAGE: ALL enemies dead (the battle must keep standing), player 0 at HP 123/MP 45 + TRANCE + half ATB"
+                    : "RESTORE: everyone alive and full (the revive lane if pressed before the fade)")
+                    + " -- " + n + " unit(s)";
+                return true;
+            }
+            catch (Exception ex)
+            {
+                detail = "threw: " + ex.Message;
+                return false;
+            }
+        }
+
+        // ---------------------------------------------------------------------------------------
+        // THE SELFTEST -- rung 0's proof: solo, no peer, no battle, no scene.
+        // The previous version asserted `IsMirroringStory || !Active`, which is a TAUTOLOGY under every
+        // predicate (either disjunct is trivially true) -- it passed while proving nothing, and reported
+        // a green light on an untested gate. This one drives the SceneName seam so it can actually FAIL,
+        // and uses PRIVATE scratch so it can never hijack a live bracket.
+        // ---------------------------------------------------------------------------------------
+        public static Boolean SelfTest(out String detail)
+        {
+            if (_armed || _booted)
+            {
+                detail = "skipped: diorama live";
+                return false;
+            }
+            Func<String> realScene = SceneName;
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+
+                // (1) THE PREDICATE IS FALSIFIABLE, both ways. Armed+booted but a real battle scene ->
+                //     must stay OFF (a stuck flag can never suppress a real fight). Armed+booted in the
+                //     diorama scene -> must be ON (containment actually engages).
+                _armed = true;
+                _booted = true;
+                SceneName = () => "BattleMap";
+                Boolean offInRealBattle = !Active;
+                SceneName = () => "SwirlScene";
+                Boolean offInSwirl = !Active;
+                SceneName = () => DioramaScene;
+                Boolean onInDiorama = Active;
+                _armed = false;
+                _booted = false;
+                SceneName = () => DioramaScene;
+                Boolean offWhenDisarmed = !Active;
+
+                // (2) THE BRACKET IS LOSSLESS across every family -- including the battle fields Boot
+                //     stamps (added for B3.3: the wire now writes debugStartType + isRandomEncounter).
+                UInt32 gil0 = ff9.party.gil;
+                Int32 bno0 = ff9.party.battle_no;
+                Int16 cat0 = ff9.categoryKillCount != null && ff9.categoryKillCount.Length > 0 ? ff9.categoryKillCount[0] : (Int16)0;
+                Int32 models0 = ff9.modelKillCount != null ? ff9.modelKillCount.Count : 0;
+                Int32 bmap0 = FF9StateSystem.Battle.battleMapIndex;
+                Byte bpat0 = FF9StateSystem.Battle.patternIndex;
+                battle_start_type_tags bst0 = FF9StateSystem.Battle.debugStartType;
+                Boolean brand0 = FF9StateSystem.Battle.isRandomEncounter;
+                const Int16 ProbeKey = 0x7FF0;
+
+                Snapshot();
+                ff9.party.gil = gil0 == 12345u ? 999u : 12345u;
+                ff9.party.battle_no = bno0 + 7;
+                if (ff9.categoryKillCount != null && ff9.categoryKillCount.Length > 0)
+                    ff9.categoryKillCount[0] = (Int16)(cat0 + 77);
+                if (ff9.modelKillCount != null)
+                    ff9.modelKillCount[ProbeKey] = 1234;
+                FF9StateSystem.Battle.battleMapIndex = bmap0 + 31;
+                FF9StateSystem.Battle.patternIndex = (Byte)(bpat0 + 3);
+                FF9StateSystem.Battle.debugStartType = bst0 == battle_start_type_tags.BTL_START_FIRST_ATTACK
+                    ? battle_start_type_tags.BTL_START_BACK_ATTACK : battle_start_type_tags.BTL_START_FIRST_ATTACK;
+                FF9StateSystem.Battle.isRandomEncounter = !brand0;
+                Restore();
+
+                Boolean gilOk = ff9.party.gil == gil0;
+                Boolean bnoOk = ff9.party.battle_no == bno0;
+                Boolean catOk = ff9.categoryKillCount == null || ff9.categoryKillCount.Length == 0 || ff9.categoryKillCount[0] == cat0;
+                Boolean modelOk = ff9.modelKillCount == null || (ff9.modelKillCount.Count == models0 && !ff9.modelKillCount.ContainsKey(ProbeKey));
+                Boolean btlFieldsOk = FF9StateSystem.Battle.battleMapIndex == bmap0
+                                      && FF9StateSystem.Battle.patternIndex == bpat0
+                                      && FF9StateSystem.Battle.debugStartType == bst0
+                                      && FF9StateSystem.Battle.isRandomEncounter == brand0;
+
+                // (3) THE PARTY BRACKET restores by REFERENCE, and leaves the guest's own PLAYER objects
+                //     BYTE-UNTOUCHED. Both halves matter: reference identity proves the swap is undone,
+                //     and the probe writes prove we never mutated the real objects to begin with (the
+                //     whole point of choosing a reference bracket over a content one).
+                Boolean refsOk = false, probesOk = false;
+                CharacterId probeId = default(CharacterId);
+                Boolean haveProbe = false;
+                foreach (KeyValuePair<CharacterId, PLAYER> kv in ff9.player)
+                {
+                    if (kv.Value != null && kv.Value.info != null) { probeId = kv.Key; haveProbe = true; break; }
+                }
+                if (haveProbe)
+                {
+                    PLAYER realBefore = ff9.player[probeId];
+                    PLAYER[] memberBefore = (PLAYER[])ff9.party.member.Clone();
+                    UInt32 probeHp = realBefore.cur.hp;
+                    Int32 probeSaCount = realBefore.saExtended != null ? realBefore.saExtended.Count : -1;
+
+                    SnapshotParty();
+                    RememberOriginalPlayer(probeId);
+                    ff9.player[probeId] = new PLAYER();          // an impostor object in the dict slot
+                    ff9.party.member[0] = ff9.player[probeId];   // and in the party pointer
+                    RestoreParty();
+
+                    refsOk = ReferenceEquals(ff9.player[probeId], realBefore);
+                    for (Int32 i = 0; i < 4 && refsOk; i++)
+                        refsOk = ReferenceEquals(ff9.party.member[i], memberBefore[i]);
+                    // the real object was never written through -- not merely restored
+                    probesOk = realBefore.cur.hp == probeHp
+                               && (realBefore.saExtended != null ? realBefore.saExtended.Count : -1) == probeSaCount;
+                }
+
+                Boolean predicateOk = offInRealBattle && offInSwirl && onInDiorama && offWhenDisarmed;
+                detail = String.Format("predicate[realBattle={0} swirl={1} diorama={2} disarmed={3}] bracket[gil={4} battleNo={5} catKills={6} modelKills={7} btlFields={8}] party[refs={9} untouched={10}]",
+                    offInRealBattle ? "off" : "ON!", offInSwirl ? "off" : "ON!", onInDiorama ? "on" : "OFF!", offWhenDisarmed ? "off" : "ON!",
