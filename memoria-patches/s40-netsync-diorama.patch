+                        // IS CharacterParameterList's by construction (FF9Play_Init builds one from the other,
+                        // ff9play.cs:65-73), so this one ContainsKey also guards FF9Play_New's private
+                        // CharacterParameterList[slotId].
+                        if (!ff9.player.ContainsKey(id) || !ff9level.CharacterBaseStats.ContainsKey(id))
