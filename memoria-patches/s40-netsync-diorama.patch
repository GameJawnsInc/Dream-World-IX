+using System;
+using System.Collections.Generic;
+using Assets.Scripts.Common;
+using FF9;
+using Memoria.Data;
+using Memoria.Prime;
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    /// <summary>
+    /// THE BATTLE DIORAMA (B3) -- rung 0: THE CONTAINMENT GATE.
+    ///
+    /// The diorama boots the stock "BattleMapDebug" scene on a FOLLOWING guest so it can WATCH the
+    /// host's fight. That scene is a full battle: the sim runs. Rung 0 exists because of what the recon
+    /// found, which inverted the plan's own premise:
+    ///
+    ///   FF9StateSystem.Battle.isDebug IS A TRAP, NOT A TOOL. It is a DEAD flag (nothing in the tree
+    ///   ever sets it true; two writers, both `= false` -- BattleStateSystem.cs:52 via its own Awake,
+    ///   and HonoluluFieldMain.cs:238 on FIELD encounter start only). And it gates only the sim's INPUT
+    ///   half. battle.BattleMain() is called UNCONDITIONALLY at HonoluluBattleMain.cs:678; the
+    ///   `if (!isDebug)` gate at :679 opens AFTER it. So a stock BattleMapDebug boot still runs
+    ///   ManageBattleEnd -> btl_sys.SavePlayerData and writes the player's REAL party -- and because
+    ///   IsOver (the ATTR.EXITBATTLE bit) is ALSO set only inside that gate, the battle never ends and
+    ///   the writeback RE-FIRES EVERY FRAME.
+    ///
+    /// THE CONTAINMENT LAW: isDebug buys the input half for free and is worth setting -- but the
+    /// diorama's save-safety comes from the explicit suppression set keyed on <see cref="Active"/>,
+    /// NEVER from isDebug. Containment is rung ZERO: nothing renders until the save is untouchable.
+    ///
+    /// SAVE-SAFETY IS NOT CONTAINMENT (the Road A lesson). The save gates + the autoload exit ramp keep
+    /// the guest's DISK pristine; they say nothing about whether the SESSION is coherent.
+    ///
+    /// ---- WHY Active IS SHAPED THE WAY IT IS (three rejected designs, each a real hole) ----
+    ///  1. `_armed && NetSyncClient.IsMirroringStory` -- REJECTED. IsMirroringStory needs a live socket
+    ///     (NetSyncClient.cs:154), and the selftest branch returns before the socket is ever built, so
+    ///     it is STRUCTURALLY UNREACHABLE in Role=selftest -- this project's sanctioned solo-proof mode.
+    ///     It also made the containment selftest a TAUTOLOGY that could not fail.
+    ///  2. `CurrentScene != "BattleMap"` (suppress unless proven a real battle) -- REJECTED, and this
+    ///     one is dangerous: a real battle boots THROUGH THE SWIRL, so CurrentScene reads "SwirlScene"
+    ///     while the real BattleMap activates. The test would be TRUE there and a stuck flag would
+    ///     SUPPRESS A REAL BATTLE. It flips a fail-safe default into a fail-dangerous one.
+    ///  3. `SceneDirector.CurrentScene == "BattleMapDebug"` -- REJECTED: CurrentScene is SceneDirector's
+    ///     bookkeeping copy and LAGS the live scene (ChangeSceneAsync assigns it only after an awaited
+    ///     LoadLevelAsync, which ACTIVATES the scene first -- reachable whenever _discChange != 0, and
+    ///     that flag is never reset after a disc change). Scene live + predicate false = uncontained.
+    ///
+    /// The shipped shape reads `Application.loadedLevelName` -- the ENGINE's live scene name, correct by
+    /// the new scene's Awake and therefore before HonoluluBattleMain.Start and long before the first
+    /// UpdateBattleFrame. It is what SceneDirector itself seeds CurrentScene FROM (:183) and what
+    /// UIManager.OnLevelWasLoaded keys its own "BattleMapDebug" branch on. The test stays POSITIVE, so
+    /// the default is suppression OFF and a stuck flag can never reach a real battle (which is always
+    /// scene "BattleMap" -- HonoluluFieldMain.cs:322, WMScriptDirector.cs:222).
+    /// [ff9mapkit netsync diorama]
+    /// </summary>
+    public static class NetSyncDiorama
+    {
+        private const String DioramaScene = "BattleMapDebug";
+
+        /// <summary>The live scene name. A seam ONLY so SelfTest can be falsifiable; production reads Unity.</summary>
+        internal static Func<String> SceneName = () => Application.loadedLevelName;
+
+        private static Boolean _armed;      // containment requested
+        private static Boolean _booted;     // the diorama scene is ours, until teardown
+
+        /// <summary>
+        /// THE CONTAINMENT PREDICATE. Structural + engine-authoritative + POSITIVE, so every uncertainty
+        /// fails toward "not suppressed" (a diorama bug) rather than "suppressed" (a real battle broken).
+        /// Read from five hot battle sites; must never throw.
+        /// </summary>
+        public static Boolean Active
+        {
+            get
+            {
+                if (!_armed || !_booted)
+                    return false;
+                try { return String.Equals(SceneName(), DioramaScene); }
+                catch { return false; }
+            }
+        }
+
+        /// <summary>True while the diorama is ours to tear down. The teardown hook gates on THIS, never on Active.</summary>
+        public static Boolean Booted => _booted;
+
+        /// <summary>
+        /// B3.5 (F3) -- the wire nonce THIS diorama booted from, or -1. Set by NetSyncClient's watcher
+        /// after a successful wire boot (beside its own _dioramaWireNonce bookkeeping); reset to -1 in
+        /// Boot (a manual F6 / wire-bench boot has no wire nonce -- it is NOT the host's fight, so the
+        /// action drain drops EVERY frame) and in ForceDisarm. The action lane gates each frame's nonce
+        /// against this: battleNonce is a Byte (wraps at 256 battles), so the structural discard rules
+        /// (F2) do the heavy lifting and this check only pins frames to the booted battle.
+        /// </summary>
+        internal static Int32 BootedWireNonce = -1;
+
+        /// <summary>May this machine boot a diorama at all? A mirrored session, a LIVE followed session
+        /// (the mirror may simply not have armed yet -- its arming needs a field load that sees a host
+        /// snapshot; the diorama's save-safety never depended on it), or the sanctioned solo bench.</summary>
+        private static Boolean MayBoot => NetSyncClient.IsMirroringStory || NetSyncClient.IsLiveFollowedSession
+                                          || NetSyncClient.IsSelfTestRole;
+
+        /// <summary>The user-facing reason MayBoot is false, for the F6 panel.</summary>
+        public static String BootBlockedReason =>
+            MayBoot ? null
+                    : "needs a co-op session: join a host and follow, or set [Netsync] Enabled=1 + Role=selftest.";
+
+        // ---------------------------------------------------------------------------------------
+        // BOOT / LEAVE.
+        //
+        // The boot is the STOCK debug recipe, verbatim (BattleUI.cs:144-171). We do NOT reach for
+        // SceneTransition.SwirlInBlack yet: it buys swirl + SFX + BGM free and is the right end state,
+        // but it is an untested pairing AND its BGM song id resolves from the LOCAL fldMapNo
+        // (BattleSwirl.cs:91), so a guest elsewhere would hear its own field's theme. One proven piece
+        // at a time.
+        //
+        // THE RETURN is authored, because no stock one exists for us: with isDebug on, IsOver is never
+        // set, so UpdateOverFrame/GoToBattleResult never run and the battle simply never ends. That is
+        // LOAD-BEARING -- it is exactly what keeps the reward layer (BattleResultUI's EXP/AP/gil/drops)
+        // and GoToGameOver (a real loss is a KICK TO TITLE) unreachable.
+        //   *** NEVER set IsOver to end a diorama. *** It opens the entire reward path.
+        // ---------------------------------------------------------------------------------------
+        private static Byte _returnMode;
+
+        /// <summary>The F6 manual boot: a deliberate NORMAL start (deterministic -- BattleUI's debug
+        /// keys can leave debugStartType on anything, and BACK_ATTACK is enum value ZERO).</summary>
+        public static void Boot(Int32 battleMapIndex, Int32 patternIndex)
+        {
+            Boot(battleMapIndex, patternIndex, battle_start_type_tags.BTL_START_NORMAL_ATTACK, false);
+        }
+
+        /// <summary>
+        /// B3.3 -- boot from the peer's wire boot block (or the F6 wire bench). Validates every
+        /// wire-fed value here, because the caller's bytes are unchecked: an unregistered scene id is
+        /// REFUSED (the diorama analogue of OvlPeerNoField -- a modded host's custom battle scene may
+        /// not exist on this install), and an out-of-range start type clamps to NORMAL rather than
+        /// garbage-indexing (BACK_ATTACK == 0, so a zeroed byte is a legal value, never a sentinel).
+        /// </summary>
+        public static void BootFromWire(Int32 battleMapIndex, Int32 patternIndex, Int32 startType, Boolean isRandomEncounter)
+        {
+            try
+            {
+                Dictionary<Int32, String> names = FF9StateSystem.Battle.mapName;
+                if (names == null || !names.ContainsKey(battleMapIndex))
+                {
+                    Log.Warning("[NetSync] diorama wire boot REFUSED: battle scene " + battleMapIndex + " not on this install");
+                    return;
+                }
+            }
+            catch { return; }
+            battle_start_type_tags start = startType >= 0 && startType <= 2
+                ? (battle_start_type_tags)startType
+                : battle_start_type_tags.BTL_START_NORMAL_ATTACK;
+            Boot(battleMapIndex, patternIndex, start, isRandomEncounter);
+        }
+
+        private static void Boot(Int32 battleMapIndex, Int32 patternIndex, battle_start_type_tags startType, Boolean isRandomEncounter)
+        {
+            if (_booted)
+                return;
+            if (!MayBoot)
+            {
+                Log.Warning("[NetSync] diorama boot REFUSED: " + BootBlockedReason);
+                return;
+            }
+            // GATE ON THE FADE -- the most reachable leak. SceneDirector.Replace SILENTLY no-ops while a
+            // fade is in flight (`if (this.IsFading) return;`), so booting mid-fade would arm + set
+            // isDebug and then never change scene: isDebug stranded TRUE on a live field, which softlocks
+            // the NEXT real battle (the overworld encounter path never clears isDebug, and with it on the
+            // battle can never end).
+            try
+            {
+                SceneDirector sd = PersistenSingleton<SceneDirector>.Instance;
+                if (sd != null && sd.IsFading)
+                {
+                    Log.Warning("[NetSync] diorama boot REFUSED: a scene fade is in flight; try again.");
+                    return;
+                }
+            }
+            catch { }
+
+            try
+            {
+                Arm();                                   // containment BEFORE the scene, always
+                if (!_haveSnapshot)
+                {
+                    // THE CONTAINMENT LAW, enforced: Snapshot() swallows its own exceptions, so without
+                    // this check a failed snapshot would still render -- and with _haveSnapshot false
+                    // every Restore() is a no-op, so the un-gateable ++battle_no (battle.cs:61, before
+                    // the isDebug gate; the snapshot is its ONLY protection) would leak to the save.
+                    _armed = false;
+                    _havePartySnapshot = false;
+                    _realPlayer.Clear();
+                    _realMember = null;
+                    Log.Warning("[NetSync] diorama boot REFUSED: the state snapshot failed -- nothing renders without the bracket.");
+                    return;
+                }
+                _returnMode = PersistenSingleton<FF9StateSystem>.Instance.mode;
+                _booted = true;
+                _seqSeen = false;                    // the reconciler starts fresh per boot
+                _reconcileLogged = false;
+                _reconcileErrLogged = false;
+                _reconcileSkipLogMask = 0;
+                _hiddenMask = 0;
+                _benchCarnage = false;
+                // B3.5 -- the action lane's per-boot volatiles join the reset block: stale horizon
+                // gates from a previous boot could mute a unit's reconcile for up to ~82 min (the
+                // signed-diff half-wrap), and a manual boot must never inherit a wire nonce.
+                Array.Clear(_gated, 0, _gated.Length);
+                Array.Clear(_gateSeq, 0, _gateSeq.Length);
+                BootedWireNonce = -1;                // the watcher re-stamps it on a WIRE boot only
+                _actionErrLogged = false;
+
+                FF9StateSystem.Battle.isDebug = true;
+                FF9StateSystem.Battle.battleMapIndex = battleMapIndex;              // Int32
+                FF9StateSystem.Battle.patternIndex = (Byte)(patternIndex & 0xFF);   // Byte
+                // Under isDebug, btl_init.SetupBattleEnemy takes StartType from debugStartType INSTEAD
+                // of rolling btl_sys.StartType's RNG -- exactly the seam the wire needs: stamp the
+                // HOST's resolved value and the diorama gets their pre-emptive/back-attack layout.
+                // isRandomEncounter drives the actor fade speed + swirl look (battle.cs:490 etc.);
+                // un-mirrored it would pin every diorama to the scripted-battle presentation.
+                FF9StateSystem.Battle.debugStartType = startType;
+                FF9StateSystem.Battle.isRandomEncounter = isRandomEncounter;
+
+                Log.Message("[NetSync] diorama BOOT scene=" + battleMapIndex + " pattern=" + patternIndex
+                            + " start=" + startType + (isRandomEncounter ? " rand" : ""));
+                SceneDirector.Replace(DioramaScene, SceneTransition.FadeOutToBlack_FadeIn, true);
+            }
+            catch (Exception ex)
+            {
+                // RESTORE, not discard: Boot itself has scribbled by now (battleMapIndex/patternIndex/
+                // debugStartType/isRandomEncounter), and the snapshot was taken lines earlier in THIS
+                // call -- it is exact, not stale. (The old discard-comment reasoning predates the
+                // battle-field stamps joining the bracket.)
+                Log.Error("[NetSync] diorama boot failed: " + ex);
+                _booted = false;
+                _armed = false;
+                Restore();
+                _havePartySnapshot = false;   // party untouched at boot; just drop the reference snapshot
+                _realPlayer.Clear();
+                _realMember = null;
+                Array.Clear(_gated, 0, _gated.Length);      // B3.5: no gate survives a failed boot
+                Array.Clear(_gateSeq, 0, _gateSeq.Length);
+                BootedWireNonce = -1;
+                try { FF9StateSystem.Battle.isDebug = false; } catch { }
+            }
+        }
+
+        /// <summary>
+        /// REQUEST the exit. Deliberately does NOT tear down: teardown happens on arrival
+        /// (<see cref="ForceDisarm"/> from HonoluluBattleMain.OnDestroy).
+        ///
+        /// Clearing the flags here would be a save-corruption bug: Replace fades out over MULTIPLE
+        /// FRAMES during which BattleMapDebug is still live and HonoluluBattleMain.Update is still
+        /// pumping BattleMain() -- now unsuppressed, with btl_phase possibly parked in
+        /// PHASE_VICTORY/PHASE_DEFEAT whose branches call ManageBattleEnd -> SavePlayerData.
+        /// Keeping _booted true is also what keeps the F6 "Leave diorama" button on screen if the
+        /// Replace is dropped, so the user can retry instead of being stranded.
+        /// </summary>
+        public static void Leave()
+        {
+            if (!_booted)
+                return;
+            try
+            {
+                SceneDirector sd = PersistenSingleton<SceneDirector>.Instance;
+                if (sd != null && sd.IsFading)
+                {
+                    Log.Message("[NetSync] diorama leave deferred: a fade is in flight; press Leave again.");
+                    return;   // stay armed + booted: the retry button survives, suppression stays on
+                }
+                PersistenSingleton<FF9StateSystem>.Instance.mode = _returnMode;
+                Log.Message("[NetSync] diorama LEAVE requested -> FieldMap (mode " + _returnMode + ")");
+                SceneDirector.Replace("FieldMap", SceneTransition.FadeOutToBlack, true);
+            }
+            catch (Exception ex)
+            {
+                Log.Error("[NetSync] diorama leave failed: " + ex);
+            }
+        }
+
+        /// <summary>
+        /// Teardown, from the battle scene's OnDestroy. MUST be called gated on <see cref="Booted"/> --
+        /// never unconditionally, and never on <see cref="Active"/>: OnDestroy fires at the end of EVERY
+        /// REAL battle, so an unconditional call would Restore() a stale snapshot over a real battle's
+        /// rewards. Gating on _booted closes every exit that skips Leave (quit, exception, ramp, warp)
+        /// while never firing on a real fight. Active is unusable here -- loadedLevelName may already
+        /// have swapped by teardown.
+        /// </summary>
+        public static void ForceDisarm()
+        {
+            if (!_booted && !_armed)
+                return;
+            _booted = false;
+            try { FF9StateSystem.Battle.isDebug = false; } catch { }
+            Array.Clear(_gated, 0, _gated.Length);      // B3.5: the horizon gates die with the boot
+            Array.Clear(_gateSeq, 0, _gateSeq.Length);
+            BootedWireNonce = -1;
+            Disarm();
+            Log.Message("[NetSync] diorama torn down -- state restored, isDebug cleared");
+        }
+
+        private static void Arm()
+        {
+            // ALWAYS re-snapshot. The old early-return-if-armed was a loaded gun: a leaked _armed meant
+            // the NEXT Disarm restored a STALE snapshot over real progress.
+            Snapshot();
+            SnapshotParty();
+            _armed = true;
+        }
+
+        private static void Disarm()
+        {
+            _armed = false;
+            RestoreParty();
+            Restore();
+            // Tear the BENCH's fake mirror down -- but ONLY on a selftest machine. Production's mirror is
+            // FIELD-LOAD-SCOPED (ParseSections has one production caller, in ff9InitStateFieldMap), so an
+            // unconditional Clear here would wipe a real host's mirror on every diorama exit and only
+            // self-heal by scene-order accident. [ff9mapkit netsync diorama]
+            if (NetSyncClient.IsSelfTestRole)
+                NetSyncParty.Clear();
+        }
+
+        // ---------------------------------------------------------------------------------------
+        // THE PARTY BRACKET (rung 2.5) -- the net that must exist BEFORE B3.2's apply writes anything.
+        //
+        // WHY A REFERENCE BRACKET AND NOT A CONTENT ONE. B3.2 must render the HOST's party, and a
+        // SCRATCH party is structurally impossible: a battle actor's identity is a Byte
+        // (`btl.bi.slot_no = (Byte)p.info.slot_no`, btl_init.cs:378), and from that stamp on EVERY PLAYER
+        // resolution is a DICTIONARY LOOKUP keyed on it (btl_util.getPlayerPtr/getSerialNumber, and
+        // BattleUnit.Player -- the accessor the whole battle system uses). A PLAYER reachable only
+        // through party.member[] is abandoned at the handoff and the engine finds the guest's own
+        // character again. (Invariant: all 13 writes to party.member[] in the tree assign null or a
+        // DICT-RESOLVED PLAYER. No PLAYER outside the dict has ever been in that array.)
+        //
+        // So the apply must put its scratch INTO the dict -- and the safe way to undo that is to put the
+        // ORIGINAL OBJECT REFERENCES back. The guest's own PLAYER objects are then never mutated at all,
+        // which makes "the bracket missed a field" IMPOSSIBLE rather than carefully avoided. The
+        // alternative (mutate-in-place + a per-field content bracket) would need 14 reference members
+        // plus the scalars FF9Play_Update re-derives -- a list that rots. That it rots is not
+        // hypothetical: every copy helper in this family ALREADY has (btl_init.CopyPoints silently drops
+        // POINTS' 5th field `at_coef`; CharacterEquipment.Clone drops Comment + Id).
+        //
+        // There is also NO same-call bracket to hide in: CreateBattleData runs in Start, InitPlayerData
+        // runs N FRAMES LATER inside BattleMain, SFX.InitBattleParty later still. The swap necessarily
+        // spans the diorama's whole lifetime -- Boot -> ForceDisarm -- which is exactly this bracket.
+        // ---------------------------------------------------------------------------------------
+        private static PLAYER[] _realMember;
+        private static readonly Dictionary<CharacterId, PLAYER> _realPlayer = new Dictionary<CharacterId, PLAYER>();
+        private static Boolean _havePartySnapshot;
+
+        private static void SnapshotParty()
+        {
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                _realMember = (PLAYER[])ff9.party.member.Clone();   // the 4 slot REFERENCES, not the objects
+                _realPlayer.Clear();
+                _havePartySnapshot = true;
+            }
+            catch (Exception ex)
+            {
+                _havePartySnapshot = false;
+                Log.Warning("[NetSync] diorama party snapshot failed: " + ex);
+            }
+        }
+
+        /// <summary>
+        /// Record a dict slot's ORIGINAL PLAYER before the apply overwrites it. The apply calls this
+        /// immediately before `ff9.player[id] = scratch`. First write wins, so a re-entrant apply can
+        /// never bury the real object behind a scratch.
+        /// </summary>
+        internal static void RememberOriginalPlayer(CharacterId id)
+        {
+            if (!_havePartySnapshot || _realPlayer.ContainsKey(id))
+                return;
+            try
+            {
+                PLAYER original;
+                if (FF9StateSystem.Common.FF9.player.TryGetValue(id, out original))
+                    _realPlayer[id] = original;
+            }
+            catch (Exception ex)
+            {
+                Log.Warning("[NetSync] diorama could not remember player " + id + ": " + ex);
+            }
+        }
+
+        /// <summary>
+        /// B3.2 -- SEAT THE HOST'S PARTY. Called from HonoluluBattleMain.InitBattleScene's top, so it is
+        /// upstream of BOTH consumers: CreateBattleData (same call) and btl_init.InitPlayerData (N frames
+        /// later, off the load ladder) -- there is no same-call bracket to hide in, which is why the swap
+        /// spans Boot -> ForceDisarm.
+        ///
+        /// THE MECHANISM: install a SCRATCH into the dict slot. A scratch reachable only through
+        /// party.member[] is structurally impossible -- the actor's identity is a Byte
+        /// (btl.bi.slot_no = (Byte)p.info.slot_no) and every later resolution is a DICT lookup on it, so
+        /// the engine would find the guest's own character again and one HUD would disagree with itself.
+        /// The guest's real PLAYER objects are never mutated; RestoreParty puts the originals back by
+        /// reference.
+        /// </summary>
+        internal static void MirrorHostParty()
+        {
+            if (!Active || !_havePartySnapshot || !NetSyncParty.MirrorActive)
+                return;   // no host data -> the guest's own party stands (B3.1 behaviour)
+            FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+            try
+            {
+                Int32 seated = 0;
+                for (Int32 i = 0; i < 4; i++)
+                {
