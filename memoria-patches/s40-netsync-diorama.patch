+                        // guarded (they load from different files; GetEnabledSA's feature indexer and
+                        // the SaData gem indexers all THROW on a missing id). Negative ids are the
+                        // reserved global feature keys, never per-player.
+                        // *** NEVER call ValidateSupportAbility here: pre-Update the capa equation it
+                        // checks is false by construction and it would WIPE the whole carried SA set.
+                        // *** NEVER call ValidateBasisStatus either: at max level it re-runs Build and
+                        // destroys the wire basis writes above.
+                        Int32 saFiltered = 0;
+                        if (s.SaIds != null)
+                        {
+                            for (Int32 j = 0; j < s.SaIds.Length; j++)
+                            {
+                                Int32 saId = s.SaIds[j];
+                                if (saId < 0)
+                                    continue;
+                                SupportAbility sa = (SupportAbility)saId;
+                                if (!ff9abil._FF9Abil_SaData.ContainsKey(sa) || !ff9abil._FF9Abil_SaFeature.ContainsKey(sa))
+                                {
+                                    saFiltered++;
+                                    continue;
+                                }
+                                ff9abil.FF9Abil_SetEnableSA(scratch, sa, true);   // pure set-membership, triggers nothing
+                            }
+                            if (saFiltered > 0)
+                                Log.Message("[NetSync] diorama: " + saFiltered + " host support abilit"
+                                            + (saFiltered == 1 ? "y" : "ies") + " not on this install (slot "
+                                            + i + ") -- skipped; derived stats may differ until the type-1 lane lands");
+                        }
