+                        // at battle spawn (OrganizePlayerData); the achievement write is fenced at the
+                        // btl_stat definition gate.
+                        scratch.status = (BattleStatus)s.Status;
+                        if (!String.IsNullOrEmpty(s.Name))
+                            scratch.Name = s.Name;             // empty would silently fall back to the stock default
+                        ff9play.FF9Play_Update(scratch);       // NOT Build: Build re-derives basis and destroys the above
+                                                               // (the ONE derivation pass: TriggerOnEnable re-applies the
+                                                               // carried SAs' MaxHP/limits/gems onto the wire basis)
+
+                        scratch.trance = s.Trance;             // AFTER Update (Update never touches trance)
+                        scratch.cur.hp = Math.Min(s.CurHp, scratch.max.hp);   // LAST: clamped to the derived max
+                        scratch.cur.mp = Math.Min(s.CurMp, scratch.max.mp);
+                        ff9.party.member[i] = scratch;         // DIRECT: FF9Play_SetParty would mark the guest's
+                                                               // own character in-party, save-persistently
+                        seated++;
+                    }
+                    catch (Exception exSlot)
+                    {
+                        Log.Warning("[NetSync] diorama: slot " + i + " failed to seat -- left empty: " + exSlot);
+                        try { ff9.party.member[i] = null; } catch { }
+                        // the dict scratch (if installed) is harmless: RestoreParty puts the remembered
+                        // original back by reference at teardown
+                    }
+                }
+                Log.Message("[NetSync] diorama seated the host's party: " + seated + " slot(s)");
+            }
+            catch (Exception ex)
+            {
+                // HonoluluBattleMain.Start swallows everything InitBattleScene throws, so without this the
+                // failure would both HIDE and STRAND the swap (the guest's party left as scratches).
+                Log.Error("[NetSync] diorama party mirror failed -- restoring: " + ex);
+                RestoreParty();
+            }
+        }
