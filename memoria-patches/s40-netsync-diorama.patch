+                _dioramaSeenNonce = -1;
+            }
+            else if (nonce != _dioramaSeenNonce && _role == "client")
+            {
+                // RISING EDGE: the peer's battle just appeared on the wire. ONE diagnostic line per
+                // battle, whatever happens next -- the 2026-07-16 run was undiagnosable because every
+                // decline below was silent. Durable blocks get named; transient ones (mid-menu,
+                // mid-fade) self-resolve and stay quiet. Client-only: on a HOST whose guest is
+                // fighting, "FollowHost=0" would be true but describe nothing wrong.
+                _dioramaSeenNonce = nonce;
+                if (!_followHost || !_diorama)
+                    Log.Message("[NetSync] the host is fighting (scene " + mapNo + ") but the diorama is off: "
+                                + (!_followHost ? "FollowHost=0" : "Diorama=0"));
+                else if (!NetSyncParty.MirrorActive)
+                    Log.Message("[NetSync] diorama note: the party mirror hasn't armed yet -- the diorama "
+                                + "stages YOUR party for now (it syncs at your next field load)");
+            }
+            if (!_followHost || !_diorama)
+                return;                                  // hosts and non-followers never auto-boot
+
+            if (NetSyncDiorama.Booted)
+            {
+                if (_dioramaWireNonce < 0)
+                    return;                              // an F6 manual diorama -- not ours to end
+                if ((!live || nonce != _dioramaWireNonce) &&
+                    Environment.TickCount - _dioramaActionTick > 1000)
+                {
+                    _dioramaActionTick = Environment.TickCount;
+                    NetSyncDiorama.Leave();              // request-only; teardown happens on arrival
+                }
+                return;
+            }
+            if (!live)
+                return;
+            // Deliberately NOT gated on _storyMirroring: the mirror arms only at a field-load boundary
+            // that sees a host snapshot, and a session where that hasn't happened yet (the 2026-07-16
+            // run) must still get its diorama -- Boot's own MayBoot accepts a live followed session,
+            // and the diorama's save-safety is self-contained (the rung-2.5 bracket + save block).
+            if (nonce == _dioramaSkipNonce)
+                return;   // the user walked out of this battle's diorama -- respect it
+            try
+            {
+                if (!FF9StateSystem.Battle.mapName.ContainsKey(mapNo))
+                {
+                    // A modded host fighting in a scene this install lacks. Skip the whole battle with
+                    // ONE line -- without the skip-nonce, the rate-limited boot would re-refuse (and
+                    // re-log) every second for the fight's whole duration.
+                    _dioramaSkipNonce = nonce;
+                    Log.Message("[NetSync] peer battle scene " + mapNo + " not on this install -- spectate panel only");
+                    return;
+                }
+            }
+            catch (Exception ex)
+            {
+                _dioramaSkipNonce = nonce;               // same skip pattern: one line, not a spam loop
+                Log.Message("[NetSync] diorama blocked: the battle scene list is unavailable (" + ex.GetType().Name + ")");
+                return;
+            }
+            if (!onField)
+                return;   // free-standing on a field only -- never from my own battle/menu/transition
+            try
+            {
+                if (PersistenSingleton<UIManager>.Instance.State != UIManager.UIState.FieldHUD)
+                    return;
+            }
+            catch { return; }
+            if (Environment.TickCount - _dioramaActionTick < 1000)
+                return;                                  // the last Boot was refused (fade in flight)
+            _dioramaActionTick = Environment.TickCount;
+            NetSyncDiorama.BootFromWire(mapNo, patNum, startType, rand);
+            if (NetSyncDiorama.Booted)
+            {
+                _dioramaWireNonce = nonce;
+                // B3.5 (F3): the action lane needs the booted nonce INSIDE NetSyncDiorama to key each
+                // frame against (Boot resets it to -1, so a manual F6 diorama drops all action frames).
+                NetSyncDiorama.BootedWireNonce = nonce;
+            }
+        }
+
