+                        RememberOriginalPlayer(id);            // ALWAYS before the overwrite
+                        PLAYER scratch = new PLAYER();         // ctor builds neither info nor pa -> NRE without New
+                        ff9.player[id] = scratch;
+                        ff9play.FF9Play_New(id);               // mutates ff9.player[id]: info + pa sizing + category + bonus
+
