+        // real battle (debugStartType only matters under isDebug, but a stale isRandomEncounter
+        // changes a scripted fight's fade/swirl presentation, and a stale battleMapIndex lies to
+        // every NCalc "BattleId" script until the next encounter re-stamps it)
+        private static Int32 _bMapIndex;
+        private static Byte _bPatIndex;
+        private static battle_start_type_tags _bStartType;
+        private static Boolean _bRand;
+        private static Boolean _haveSnapshot;
+
+        private static void Snapshot()
+        {
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                _gil = ff9.party.gil;
+                _battleNo = ff9.party.battle_no;
+                _categoryKills = (Int16[])ff9.categoryKillCount.Clone();
+                _modelKills = new Dictionary<Int16, Int16>(ff9.modelKillCount);
+                _bMapIndex = FF9StateSystem.Battle.battleMapIndex;
+                _bPatIndex = FF9StateSystem.Battle.patternIndex;
+                _bStartType = FF9StateSystem.Battle.debugStartType;
+                _bRand = FF9StateSystem.Battle.isRandomEncounter;
+                _haveSnapshot = true;
+            }
+            catch (Exception ex)
+            {
+                _haveSnapshot = false;
+                Log.Warning("[NetSync] diorama snapshot failed: " + ex);
+            }
+        }
+
+        private static void Restore()
+        {
+            if (!_haveSnapshot)
+                return;
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                ff9.party.gil = _gil;
+                ff9.party.battle_no = _battleNo;
+                Array.Copy(_categoryKills, ff9.categoryKillCount, _categoryKills.Length);
+                ff9.modelKillCount.Clear();
+                foreach (KeyValuePair<Int16, Int16> kv in _modelKills)
+                    ff9.modelKillCount[kv.Key] = kv.Value;
+                FF9StateSystem.Battle.battleMapIndex = _bMapIndex;
+                FF9StateSystem.Battle.patternIndex = _bPatIndex;
+                FF9StateSystem.Battle.debugStartType = _bStartType;
+                FF9StateSystem.Battle.isRandomEncounter = _bRand;
+            }
+            catch (Exception ex)
+            {
+                Log.Warning("[NetSync] diorama restore failed: " + ex);
+            }
+            finally
+            {
+                _haveSnapshot = false;
+            }
+        }
