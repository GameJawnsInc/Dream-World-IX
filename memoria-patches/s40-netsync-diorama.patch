+                if ((v.Context.Flags & BattleCalcFlags.Dodge) != 0) flags |= 2;
+                if (v.Context.IsDrain) flags |= 16;
+                if (target.bi.player != 0) flags |= 32;
+                if (caster.bi.player != 0) flags |= 64;
