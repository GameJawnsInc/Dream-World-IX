+        /// <summary>
+        /// Put the guest's own party back, by reference. Safe to call when the apply never ran (the maps
+        /// are simply empty). Idempotent.
+        /// </summary>
+        internal static void RestoreParty()
+        {
+            if (!_havePartySnapshot)
+                return;
+            try
+            {
+                FF9StateGlobal ff9 = FF9StateSystem.Common.FF9;
+                foreach (KeyValuePair<CharacterId, PLAYER> kv in _realPlayer)
+                    ff9.player[kv.Key] = kv.Value;                  // the ORIGINAL object, untouched
+                if (_realMember != null)
+                    Array.Copy(_realMember, ff9.party.member, 4);   // element-wise: BattleHUD writes into this array
+            }
+            catch (Exception ex)
+            {
+                Log.Warning("[NetSync] diorama party restore failed: " + ex);
+            }
+            finally
+            {
+                _realPlayer.Clear();
+                _realMember = null;
+                _havePartySnapshot = false;
+            }
+        }
+
+        // ---------------------------------------------------------------------------------------
+        // THE COUNTER FAMILIES -- snapshot/restore, not per-site gating: they are fed from four
+        // different files, and a missed feeder is a silent leak. A bracket cannot be out-flanked.
+        // Real types (checked, not assumed): categoryKillCount is Int16[8]; modelKillCount is
+        // EntryCollection<Int16,Int16> (a Dictionary subclass whose indexer returns a default rather
+        // than throwing -- probe with ContainsKey); gil is UInt32; battle_no is Int32.
+        // battle_no is bracket-only by necessity: `++ff9.party.battle_no` (battle.cs:61) runs from
+        // InitBattle <- Start, with the isDebug gate AFTER it -- there is no call site to gate.
+        // ---------------------------------------------------------------------------------------
+        private static UInt32 _gil;
+        private static Int32 _battleNo;
+        private static Int16[] _categoryKills;
+        private static Dictionary<Int16, Int16> _modelKills;
