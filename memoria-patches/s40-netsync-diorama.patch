+                        // the post-SA max: seating post-SA max into basis while also carrying the SA
+                        // set would DOUBLE-APPLY every percentage SA (HP+10% is a TriggerOnEnable
+                        // `MaxHP + MaxHP / 10` formula). The legacy MaxHp/MaxMp wire fields remain as
+                        // fallback only.
+                        scratch.basis.dex = s.Dex;
+                        scratch.basis.str = s.Str;
+                        scratch.basis.mgc = s.Mgc;
+                        scratch.basis.wpr = s.Wpr;
+                        scratch.basis.max_hp = s.BasisMaxHp > 0 ? s.BasisMaxHp : s.MaxHp;
+                        scratch.basis.max_mp = s.BasisMaxMp > 0 ? s.BasisMaxMp : s.MaxMp;
