+                    return;
+                }
+                RemoteState rs = _socket.GetRemote();
+                if (!rs.Valid)
+                {
+                    TpDecline("the peer's position lane is stale");
+                    return;
+                }
+                Int32 myField = FF9StateSystem.Common.FF9.fldMapNo;
+                if (rs.Field == myField)
+                {
+                    if (SnapToHost(ee, rs.Pos))
+                    {
+                        _tpDeclineReason = "";
+                        Log.Message("[NetSync] teleport-to-host: snapped to the host on field " + myField);
+                    }
+                    else
+                        TpDecline("the host's position is off this walkmesh (landed at the default spawn)");
+                    return;
+                }
+                if (!EventEngineUtils.eventIDToFBGID.ContainsKey(rs.Field))
+                {
+                    // FollowHostTick's own registration decline is SILENT (the overlay explains) --
+                    // a deliberate keypress deserves a spoken reason.
+                    TpDecline("the host's field (" + rs.Field + ") is not on this install");
+                    return;
+                }
+                // Cross-field: re-arm the follow so the NEXT FollowHostTick fires the proven
+                // fade+warp immediately (clear the already-warped latch, pre-age the debounce).
+                // Never duplicate the warp logic here.
+                _followWarpedTo = -1;
+                _followCandidate = rs.Field;
+                _followCandidateSince = Environment.TickCount - FollowStableMs;
+                _tpDeclineReason = "";
+                Log.Message("[NetSync] teleport-to-host: following the peer to field " + rs.Field);
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] teleport-to-host failed");
+            }
+        }
+
+        // The snap primitive: through ee.fieldmap.playerController -- populated on EVERY player
+        // spawn path (actor.fieldMapActorController is null on the AddPlayer path, so do NOT use
+        // it). SetPosition(pos, true, true) re-triangulates onto the NEAREST-Y floor (multi-floor
+        // correct) and rebinds activeFloor/activeTri; keep it SetPosition-ONLY -- HonoLateUpdate
+        // writes curPos back to pos[] next frame and TreadQuad reads the live transform, so poking
+        // pos[]/lastx here would only fight the controller (verified non-issue). Returns
+        // SetPosition's OWN verdict (verify find): false = the target was off this walkmesh and the
+        // engine dumped the player at the default spawn instead -- callers must not report success.
+        // No logging here: the manual and auto callers own their distinct latched lines.
+        private Boolean SnapToHost(EventEngine ee, Vector3 target)
+        {
+            FieldMapActorController pc = ee.fieldmap != null ? ee.fieldmap.playerController : null;
+            if (pc == null)
+                return false;
+            return pc.SetPosition(target, true, true);
+        }
+
+        // F1 AUTO-TELEPORT -- a RECOVERY, not a leash: fires only on real sustained separation and
+        // never interrupts ordinary nearby walking. Called from BOTH position sources (the selftest
+        // branch returns before the real-coop block, so a single call site would be structurally
+        // un-benchable -- the recon-verify's find): real clients pass rs.Pos, the selftest bench
+        // passes the mirror. Own try/catch: this runs UPSTREAM of the battle lane's Pump in Update,
+        // and an unguarded throw here would starve the diorama via the Update-level catch.
+        private void AutoTeleportTick(Actor local, Vector3 hostPos, Boolean benchArm)
+        {
+            try
+            {
+                Boolean scoped = benchArm ? (IsSelfTestRole && NetSyncField.BenchGates)
+                                          : IsLiveFollowedSession;
+                if (!scoped || local == null || local.fieldMapActor == null || _followWarpPending >= 0)
+                {
+                    _autoTpSeparated = false;
+                    return;
+                }
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                Vector3 gp = local.fieldMapActor.transform.localPosition;
+                Single sep = Vector3.Distance(hostPos, gp);
+                if (sep <= AutoTpDistanceFloor)
+                {
+                    _autoTpSeparated = false;
+                    _autoTpHoldLogged = false;
+                    return;
+                }
+                // busy: dialogue/menu/event/transition -- never yank the player mid-anything
+                Boolean busy = !ee.GetUserControl();
+                if (!busy)
+                {
+                    UIManager ui = PersistenSingleton<UIManager>.Instance;
+                    busy = ui == null || ui.State != UIManager.UIState.FieldHUD
+                        || (ui.Dialogs != null && ui.Dialogs.Visible);
+                }
+                if (busy)
+                {
+                    _autoTpSeparated = false;
+                    return;
+                }
+                // steering: the engine's own component-wise stick thresholds + the digital keys
+                // (FieldMapActorController's movingUp/Down/Left/Right form -- NOT .magnitude).
+                // An UNREADABLE input subsystem must fail toward HOLD, never toward the yank
+                // (verify find: a swallowed throw here used to leave steering=false and fire).
+                Boolean steering = false;
+                try
+                {
+                    Vector2 ax = PersistenSingleton<HonoInputManager>.Instance.GetAxis();
+                    Single th = Configuration.AnalogControl.StickThreshold;
+                    steering = UIManager.Input.GetKey(Control.Up) || UIManager.Input.GetKey(Control.Down)
+                            || UIManager.Input.GetKey(Control.Left) || UIManager.Input.GetKey(Control.Right)
+                            || ax.x > th || ax.x < -th || ax.y > th || ax.y < -th;
+                }
+                catch
+                {
+                    _autoTpSeparated = false;  // can't tell if they're steering -> hold this frame
+                    return;
+                }
+                if (steering && sep <= AutoTpHardCap)
+                {
+                    // held by active input -- say so once, keep waiting (past the cap, softlock
+                    // recovery MAY beat input courtesy, but only if the gap keeps GROWING -- below)
+                    if (!_autoTpHoldLogged)
+                    {
+                        _autoTpHoldLogged = true;
+                        Log.Message("[NetSync] auto-teleport held: you're steering (sep " + (Int32)sep + ")");
+                    }
+                    _autoTpSeparated = false;
+                    return;
+                }
+                _autoTpHoldLogged = false;
+                if (!_autoTpSeparated)
+                {
+                    _autoTpSeparated = true;
+                    _autoTpSeparatedSince = Environment.TickCount;
+                    _autoTpArmSep = sep;       // the growth baseline for the steering override
+                    return;
+                }
+                // THE RATIFIED "KEEPS GROWING" QUALIFIER (verify find restored it; re-verify fixed
+                // it AGAIN): a guest who is STEERING past the hard cap is only overridden when the
+                // gap has WIDENED >= the margin since the dwell FIRST armed. Hold WITHOUT disarming
+                // -- a disarm here re-stamped the baseline next frame, so growth was measured
+                // frame-to-frame (< 100u always) and the override could never fire. With the
+                // baseline persistent: stable/shrinking sep while steering = held indefinitely
+                // (exploring, correct); genuinely walking away crosses armSep+margin and recovers.
+                // (This hold is silent by design -- the below-cap hold already logged the episode.)
+                if (steering && sep < _autoTpArmSep + AutoTpGrowthMargin)
+                    return;
+                if (Environment.TickCount - _autoTpSeparatedSince < AutoTpDwellMs)
+                    return;
+                if (Environment.TickCount - _autoTpLastFireTick < AutoTpCooldownMs)
+                    return;
+                if (SnapToHost(ee, hostPos))
+                {
+                    _autoTpLastFireTick = Environment.TickCount;
+                    Log.Message("[NetSync] auto-teleport: recovered to the host (sep was " + (Int32)sep + ")");
+                }
+                else
+                {
+                    // honest telemetry (EVERY-GATE-LOGS): the target was off this walkmesh -- the
+                    // engine dumped us at the default spawn, NOT on the host. Stamp the cooldown
+                    // anyway so a persistently off-mesh host position retries at ~10s, not 4.5s
+                    // (each attempt moves the player; unbounded retries would thrash).
+                    _autoTpLastFireTick = Environment.TickCount;
+                    Log.Message("[NetSync] auto-teleport: the host's spot is off this walkmesh -- landed at"
+                                + " the default spawn instead (will retry after the cooldown)");
+                }
+                _autoTpSeparated = false;      // fired (or missed): re-arm from scratch either way
+            }
+            catch (Exception err)
+            {
+                _autoTpSeparated = false;
+                Log.Error(err, "[NetSync] auto-teleport tick failed");
+            }
+        }
+
         // Compose the overlay text once per state (or detail) CHANGE (Update calls this every frame).
         private void SetOverlay(Int32 state)
         {
diff --git a/Assembly-CSharp/Memoria/Netsync/NetSyncField.cs b/Assembly-CSharp/Memoria/Netsync/NetSyncField.cs
new file mode 100644
index 0000000..3aa0a29
--- /dev/null
+++ b/Assembly-CSharp/Memoria/Netsync/NetSyncField.cs
@@ -0,0 +1,140 @@
+using System;
+using System.Collections.Generic;
+using Memoria.Prime;
+using UnityEngine;
+
+namespace Memoria.Netsync
+{
+    // F1 FIELD CO-OP (2026-07-20): the spectator-field gate frame. A FOLLOWING guest is a combat
+    // participant and a field SPECTATOR -- interaction authority is the HOST's alone (the paradigm,
+    // studies/field-coop/DESIGN.md; build spec F1-BUILD.md). This class holds the shared gate
+    // predicate, the solo-bench lever, the latched decline telemetry, and the teleport hotkey
+    // reader. The gates themselves are surgical edits at the engine seams (EventCollision's
+    // Check*Input, DoEventCode MAPJUMP/MENU, UIKeyTrigger); the state-touching teleport logic
+    // lives on NetSyncClient (it needs the follow-warp privates). [ff9mapkit netsync field-coop]
+    public static class NetSyncField
+    {
+        // THE BENCH LEVER: substitutes for a live followed session in Role=selftest so every F1
+        // gate is solo-provable (IsLiveFollowedSession needs role=client; IsMirroringStory needs a
+        // socket -- BOTH are structurally unreachable in selftest). Set ONLY from the ~ debug menu
+        // (the toggle renders only under IsSelfTestRole); default false so an ordinary selftest
+        // ghost session stays fully vanilla. Deliberately NOT a [Netsync] ini knob (the
+        // Diorama-knob verdict: no per-feature knobs, dev levers only where a bench needs one).
+        public static Boolean BenchGates;
+
+        // THE F1 SUPPRESSION PREDICATE -- one predicate for every field gate. The union closes
+        // both windows the single predicates leave open: IsLiveFollowedSession is true from
+        // PAIRING (before the mirror's first field-load arm), and IsMirroringStory stays true
+        // after link death until the exit ramp (the guest's world still holds HOST story in that
+        // gap, so spectator rules must too). Every conjunct defaults false on a vanilla install =
+        // fail-safe vanilla / positive containment. The s38-era gates (ENCOUNT, the UIKeyTrigger
+        // menu keys, the achievement funnel, the save block) stay on bare IsMirroringStory --
+        // proven two-machine, not retouched by F1.
+        public static Boolean SpectatorField
+        {
+            get
+            {
+                try
+                {
+                    return NetSyncClient.IsLiveFollowedSession || NetSyncClient.IsMirroringStory
+                        || (NetSyncClient.IsSelfTestRole && BenchGates);
+                }
+                catch { return false; }
+            }
+        }
+
+        // EVERY-GATE-LOGS, latched: one line per gate-class per FIELD -- never per-frame spam,
+        // never a silent decline. Keyed (gate-class -> fldMapNo); a new field or a different
+        // gate-class speaks again. No TickCount anywhere (the tick-baseline law is out of reach
+        // by construction).
+        private static readonly Dictionary<String, Int32> _lastDeclineField = new Dictionary<String, Int32>();
+
+        public static void DeclineOnce(String what)
+        {
+            try
+            {
+                Int32 fld = FF9StateSystem.Common.FF9.fldMapNo;
+                Int32 last;
+                if (_lastDeclineField.TryGetValue(what, out last) && last == fld)
+                    return;
+                _lastDeclineField[what] = fld;
+                Log.Message("[NetSync] " + what + " suppressed (following guest) on field " + fld);
+            }
+            catch { }
+        }
+
+        // THE KEYON MASK (the Decision-4 closure, built when the FIRST playtest surfaced the hole:
+        // a Phoenix Down ground pickup on field 206 was lootable through the interaction gates --
+        // stock loot/chests are tag-2 tread bodies polling Confirm INSIDE the script, invisible to
+        // the Check*Input funnel). Called from EBin's B_KEYON (pressed) and B_KEY (held) script
+        // reads: while a spectator guest HAS user control, the Confirm/Special bits vanish from
+        // script-visible input -- so pickup/chest/dig polls read nothing. CONTROL-OFF READS PASS
+        // UNTOUCHED: the 817-field census found 2,010 blocking `while(IsButton(...))` waits, 271 of
+        // them on these very bits -- those are cutscene "press Confirm" beats a mirrored guest MUST
+        // still be able to advance, and every blocking wait runs with user control seized by the
+        // scene. The control state is the discriminator: control ON = free-walk poll idiom (mask),
+        // control OFF = a scene owns input (pass). B_KEYOFF (release) is deliberately unmasked --
+        // a release completes gestures, it cannot initiate one.
+        public static UInt32 FilterScriptButtons(UInt32 keys)
+        {
+            try
+            {
+                if (!SpectatorField)
+                    return keys;
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                if (ee == null || !ee.GetUserControl())
+                    return keys;
+                if ((keys & (EventInput.Confirm | EventInput.Special)) != 0)
+                    DeclineOnce("script button-poll (pickup/loot)");
+                return keys & ~(EventInput.Confirm | EventInput.Special);
+            }
+            catch { return keys; }
+        }
+
+        // TELEPORT-TO-HOST hotkey: F11 tap OR held L3 (~0.7s). Evaluated every UIKeyTrigger.Update
+        // pass -- the L3 hold accumulator only advances while this is called each frame, so the
+        // call itself must be unconditional at the intercept (the FieldHUD/session checks live
+        // INSIDE the fired branch, never around the call). Time.deltaTime, not Environment
+        // .TickCount, so the tick-baseline law is sidestepped entirely. L3 = KeyCode
+        // .JoystickButton8, UNBOUND in the default (non-iOS) input profile; which PHYSICAL button
+        // that is on the live pad is a needs-in-game confirm -- F11 is the always-available
+        // keyboard fallback.
+        private const Single HoldSeconds = 0.7f;
+        private static Single _l3Hold;
+        private static Boolean _l3Fired;
+
+        // Session-boundary hygiene (re-verify find): the accumulator only self-resets while the key
+        // is being polled, and the session gate stops polling the moment a session ends -- a hold
+        // in flight at that instant would otherwise carry stale state into the NEXT session.
+        public static void ResetTeleportKey()
+        {
+            _l3Hold = 0f;
+            _l3Fired = false;
+        }
+
+        public static Boolean TeleportKeyPressed()
+        {
+            try
+            {
+                if (UnityXInput.Input.GetKeyDown(KeyCode.F11))
+                    return true;
+                if (UnityXInput.Input.GetKey(KeyCode.JoystickButton8))
+                {
+                    _l3Hold += Time.deltaTime;
+                    if (_l3Hold >= HoldSeconds && !_l3Fired)
+                    {
+                        _l3Fired = true;
+                        return true;
+                    }
+                }
+                else
+                {
+                    _l3Hold = 0f;
+                    _l3Fired = false;
+                }
+            }
+            catch { }
+            return false;
+        }
+    }
+}
