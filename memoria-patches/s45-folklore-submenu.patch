diff --git a/Assembly-CSharp/Global/FolkloreUI.cs b/Assembly-CSharp/Global/FolkloreUI.cs
new file mode 100644
index 00000000..27619d67
--- /dev/null
+++ b/Assembly-CSharp/Global/FolkloreUI.cs
@@ -0,0 +1,133 @@
+using Memoria;
+using Memoria.Assets;
+using Memoria.Prime;
+using System;
+using UnityEngine;
+
+// ff9mapkit s45 -- THE FOLKLORE CODEX submenu (Phase A: the row + the empty shell).
+// A first-class UIScene reached from a new main-menu row (the Party-row runtime-clone precedent,
+// MainMenuUI.Awake). Phase A ships the SHELL: a stock-framed panel (GenericInfoPanel clone, the
+// ControlPanel cloning idiom) + caption + clean cancel-back with the cursor restored to the Folklore
+// row. The entry list / detail text / display window land in later phases (studies/folklore-codex/
+// SUBMENU.md). Everything is gated on Memoria.ini [Folklore] Enabled=1 (default OFF = stock behavior;
+// the s43/s44 fail-safe-vanilla convention).
+//
+// SERIALIZATION LAW: this component is AddComponent'd onto a RUNTIME GameObject (UIManager.Start), so
+// its fields are safe -- but every field ADDED to the baked UIManager/MainMenuUI for this feature must
+// be [NonSerialized] (the WMWorld serialization-layout blackscreen law).
+public class FolkloreUI : UIScene
+{
+    public override void Hide(UIScene.SceneVoidDelegate afterFinished = null)
+    {
+        base.Hide(afterFinished);
+        // THE ItemUI IDIOM (ItemUI.cs Hide override): re-tween the main menu's row COLUMN back in
+        // while this scene fades out. Entering a submenu TweenOut-COLLAPSED the row clip and
+        // deactivated it; StartSubmenuTweenIn is the ONLY thing that reopens it -- every vanilla
+        // submenu calls it on return, and omitting it leaves the row column invisible for the rest
+        // of the session (the s45 review's HIGH find).
+        PersistenSingleton<UIManager>.Instance.MainMenuScene.StartSubmenuTweenIn();
+    }
+
+    public override Boolean OnKeyCancel(GameObject go)
+    {
+        if (base.OnKeyCancel(go))
+        {
+            FF9Sfx.FF9SFX_Play(101);
+            this.Hide(delegate
+            {
+                // the ItemUI return idiom: cursor back on OUR row; the row-column tween-in rides
+                // the Hide override above
+                PersistenSingleton<UIManager>.Instance.MainMenuScene.NeedTweenAndHideSubMenu = false;
+                PersistenSingleton<UIManager>.Instance.MainMenuScene.CurrentSubMenu = MainMenuUI.SubMenu.Folklore;
+                PersistenSingleton<UIManager>.Instance.ChangeUIState(UIManager.UIState.MainMenu);
+            });
+        }
+        return true;
+    }
+
+    private void Awake()
+    {
+        // Build the widget tree IN CODE from cloned stock pieces (zero new Unity assets -- the
+        // ControlPanel idiom). Awake runs on the first Show (the GameObject is created inactive).
+        MainMenuUI menu = PersistenSingleton<UIManager>.Instance.MainMenuScene;
+
+        // the stock cross-fade: a clone of the main menu's screen-fade object carries HonoFading +
+        // its ForegroundSprite; without a FadingComponent the stock transition never runs
+        GameObject fadeGo = UnityEngine.Object.Instantiate(menu.ScreenFadeGameObject);
+        fadeGo.name = "Folklore Fade";
+        fadeGo.transform.parent = base.transform;
+        fadeGo.transform.localPosition = menu.ScreenFadeGameObject.transform.localPosition;
+        fadeGo.transform.localScale = Vector3.one;
+        base.FadingComponent = fadeGo.GetComponent<HonoFading>();
+
+        // the shell pane: one stock framed panel (Phase B splits it into the list + detail panes).
+        // GenericInfoPanel = the main menu's framed time/gil box; its sprites are "Window Color"-
+        // tagged, so UIScene.Show's DisplayWindowBackground auto-skins the frame onto the stock atlas.
+        this.shellPanel = UnityEngine.Object.Instantiate(menu.GenericInfoPanel);
+        this.shellPanel.name = "Folklore Shell";
+        this.shellPanel.transform.parent = base.transform;
+        this.shellPanel.transform.localScale = Vector3.one;
+        // strip the time/gil content but KEEP child 2 -- the ROOT is a bare container and child 2 IS
+        // the visible window frame (ControlPanel.InstantiatePanel re-adds exactly GetChild(2) as the
+        // frame; the s45 review caught the all-children strip rendering NO frame at all)
+        for (Int32 i = 0; i < this.shellPanel.transform.childCount; i++)
+            this.shellPanel.transform.GetChild(i).gameObject.SetActive(i == 2);
+        UIWidget shellWidget = this.shellPanel.GetComponent<UIWidget>();
+        if (shellWidget != null)
+            shellWidget.SetRawRect(-500f, 300f, 1000f, 640f);
+
+        // the caption: a clone of the location-name label, re-texted to the localized menu label
+        GameObject captionGo = UnityEngine.Object.Instantiate(menu.LocationInfoPanel.GetChild(0));
+        captionGo.name = "Folklore Caption";
+        captionGo.transform.parent = this.shellPanel.transform;
+        captionGo.transform.localScale = Vector3.one;
+        captionGo.SetActive(true);
+        this.captionLabel = captionGo.GetComponent<UILabel>();
+        if (this.captionLabel != null)
+        {
+            this.captionLabel.SetAnchor((GameObject)null);
+            this.captionLabel.SetRawRect(-480f, 280f, 960f, 80f);
+            this.captionLabel.rawText = Localization.GetWithDefault("Folklore");
+        }
+    }
+
+    public void OnLocalize()
+    {
+        if (this.captionLabel != null)
+            this.captionLabel.rawText = Localization.GetWithDefault("Folklore");
+    }
+
+    [NonSerialized]
+    private GameObject shellPanel;
+    [NonSerialized]
+    private UILabel captionLabel;
+}
+
+// The s45 feature gate: Memoria.ini [Folklore] Enabled (default 0 = the row/scene/filter never exist;
+// fail-safe vanilla). Read ONCE per process (the row is cloned in MainMenuUI.Awake, long before any
+// hot-reload could matter); the netsync IniFile idiom.
+internal static class FolkloreConfig
+{
+    private static Int32 _enabled = -1;
+
+    internal static Boolean Enabled
+    {
+        get
+        {
+            if (_enabled < 0)
+            {
+                try
+                {
+                    IniFile ini = new IniFile(IniFile.MemoriaIniPath);
+                    _enabled = ini.GetSetting("Folklore", "Enabled", "0").Trim() == "1" ? 1 : 0;
+                }
+                catch (Exception err)
+                {
+                    Log.Error(err);
+                    _enabled = 0;                          // unreadable ini -> stock behavior
+                }
+            }
+            return _enabled > 0;
+        }
+    }
+}
