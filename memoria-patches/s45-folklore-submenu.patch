+using Assets.Sources.Scripts.UI.Common;
+using Memoria;
+using Memoria.Assets;
+using Memoria.Prime;
+using Memoria.Scenes;
+using System;
+using System.Collections.Generic;
+using System.IO;
+using UnityEngine;
+
+// ff9mapkit s45 -- THE FOLKLORE CODEX submenu (Phase B: the entry list + detail text + categories).
+// A first-class UIScene reached from the Folklore main-menu row (Phase A). The screen: the stock
+// full-screen menu backdrop + a LEFT framed pane holding the scrollable entry list (the
+// ControlPanel-proven SupportAbilityListPanel clone -> RecycleListPopulator; the pane's window
+// caption = the current category, paged with L1/R1) + a RIGHT framed pane (window caption = the
+// entry name, body = the P0 KeyItem lore text). Entries come from FolkloreRegistry (the mod-shipped
+// FolklorePatch.txt); OWNED entries (rare_item_obtained) show name + text, unowned rows show the
+// locked "???" form. Design: studies/folklore-codex/SUBMENU.md; the data spine is the kit's
+// DLL-free [[folklore]] P0. Everything gates on Memoria.ini [Folklore] Enabled (default OFF =
+// fail-safe vanilla).
+//
+// ROUND-2 LAWS (the first playtest's three mechanisms -- keep these invariants):
+//  * Every runtime clone that must outlive a field load lives UNDER this scene's transform
+//    (UIManager's DontDestroyOnLoad tree). An un-parented Instantiate lands at the SCENE root and
+//    dies on the next field load -- the itemPrefab template did exactly that, and RefreshPool
+//    destroys the whole cell pool BEFORE re-instantiating, so one dead template = a permanently
+//    blank list until process restart.
+//  * NGUI anchors RE-ASSERT every frame (UIRect.Update -> OnAnchor). A cloned widget that keeps
+//    baked anchor targets snaps back to its donor's screen position; every repositioned clone
+//    must SetAnchor(null) first (and the GenericInfoPanel FRAME child must be re-anchored onto
+//    OUR pane root -- the ControlPanel.InstantiatePanel recipe).
+//  * The grey/blue window skin is an IMPERATIVE sweep (UIScene.DisplayWindowBackground over
+//    "Window Color"-tagged sprites), applied per list row at populate time -- rows built after
+//    base.Show's scene sweep stay on their baked (blue) atlas without the per-row call.
+//
+// SERIALIZATION LAW: this component is AddComponent'd onto a RUNTIME GameObject (UIManager.Start), so
+// its fields are safe -- but every field ADDED to the baked UIManager/MainMenuUI for this feature must
+// be [NonSerialized] (the WMWorld serialization-layout blackscreen law).
+public class FolkloreUI : UIScene
+{
+    private const String ListGroupButton = "Folklore.List";
+
+    public override void Show(UIScene.SceneVoidDelegate afterFinished = null)
+    {
+        // REDESIGN instrumentation: the ~3s first-open hang must NAME itself (Awake fires inside
+        // the first Show's activation, so this timer brackets the whole burst)
+        System.Diagnostics.Stopwatch showWatch = System.Diagnostics.Stopwatch.StartNew();
+        UIScene.SceneVoidDelegate afterShowAction = delegate
+        {
+            // the ItemUI Show idiom: scroll + pointer plumbing per group, then arm the list
+            if (this.listPopulator != null)
+            {
+                ButtonGroupState.SetScrollButtonToGroup(this.listPopulator.ScrollButton, ListGroupButton);
+                ButtonGroupState.SetPointerLimitRectToGroup(this.listClipWidget, this.listPopulator.cellHeight, ListGroupButton);
+                ButtonGroupState.SetPointerOffsetToGroup(new Vector2(54f, 0f), ListGroupButton);   // the ItemUI key-item offset
+                ButtonGroupState.SetPointerDepthToGroup(this.listPopulator.panel.depth + 2, ListGroupButton);
+                // ^ +2, not +1: the caption rail's panel sits at list+1, and equal panel depths
+                //   sort arbitrarily in NGUI -- the finger must deterministically top the stack
+                // ^ the finger renders in a POOLED panel at per-group depth (DEFAULT 5 -- under our
+                //   rows at 6, which is why it vanished the moment the panes arrived; Dialog.cs idiom)
+                ButtonGroupState.ActiveGroup = ListGroupButton;
+            }
+            if (afterFinished != null)
+                afterFinished();
+        };
+        base.Show(afterShowAction);
+        this.RefreshCategoryList(true);
+        if (showWatch.ElapsedMilliseconds > 50)
+            Log.Message($"[FolkloreUI] Show took {showWatch.ElapsedMilliseconds}ms");
+        if (!this.firstFramesLogged)
+        {
+            // the synchronous stopwatches CANNOT see the likeliest hang homes -- RepositionList is
+            // Invoke-deferred and NGUI's geometry/drawcall fill runs in LateUpdate after Show
+            // returns (review find) -- so bracket the first rendered frames too
+            this.firstFramesLogged = true;
+            base.StartCoroutine(this.LogFirstFrames());
+        }
+    }
+
+    private System.Collections.IEnumerator LogFirstFrames()
+    {
+        Single t0 = Time.realtimeSinceStartup;
+        yield return null;
+        Single t1 = Time.realtimeSinceStartup;
+        yield return null;
+        Single t2 = Time.realtimeSinceStartup;
+        yield return null;
+        Single t3 = Time.realtimeSinceStartup;
+        Log.Message($"[FolkloreUI] first frames ms: {(t1 - t0) * 1000f:F0} / {(t2 - t1) * 1000f:F0} / {(t3 - t2) * 1000f:F0}");
+    }
+
+    public override void Hide(UIScene.SceneVoidDelegate afterFinished = null)
+    {
+        // strand insurance: deactivation kills coroutines, so a Hide landing inside the 2-frame
+        // unmute window would otherwise leave the cursor-move sound muted GAME-WIDE
+        this.muteSettleDepth = 0;
+        ButtonGroupState.MuteActiveSound = false;
+        base.Hide(afterFinished);
+        // THE ItemUI IDIOM (ItemUI.cs Hide override): re-tween the main menu's row COLUMN back in
+        // while this scene fades out -- StartSubmenuTweenIn is the ONLY thing that reopens the
+        // TweenOut-collapsed row clip (the Phase A review's HIGH find).
+        PersistenSingleton<UIManager>.Instance.MainMenuScene.StartSubmenuTweenIn();
+    }
+
+    public override Boolean OnKeyCancel(GameObject go)
+    {
+        if (base.OnKeyCancel(go))
+        {
+            FF9Sfx.FF9SFX_Play(101);
+            this.Hide(delegate
+            {
+                PersistenSingleton<UIManager>.Instance.MainMenuScene.NeedTweenAndHideSubMenu = false;
+                PersistenSingleton<UIManager>.Instance.MainMenuScene.CurrentSubMenu = MainMenuUI.SubMenu.Folklore;
+                PersistenSingleton<UIManager>.Instance.ChangeUIState(UIManager.UIState.MainMenu);
+            });
+        }
+        return true;
+    }
+
+    public override Boolean OnKeyConfirm(GameObject go)
+    {
+        if (base.OnKeyConfirm(go))
+        {
+            // browse-only in Phase B: Confirm acknowledges (owned = the stock confirm chime,
+            // locked = the refusal buzz) and CLEARS the New! bang -- the ItemUI skin-view idiom
+            // (FF9Item_UseImportant marks the entry read, save-persistent). The s46 display window
+            // gives Confirm a bigger job.
+            if (this.entries != null && this.currentIndex < this.entries.Count
+                && ff9item.FF9Item_IsExistImportant(this.entries[this.currentIndex].Id))
+            {
+                FF9Sfx.FF9SFX_Play(103);
+                if (!ff9item.FF9Item_IsUsedImportant(this.entries[this.currentIndex].Id))
+                {
+                    ff9item.FF9Item_UseImportant(this.entries[this.currentIndex].Id);
+                    this.RefreshCategoryList(false);       // re-populate the rows (bang off)
+                }
+            }
+            else
+                FF9Sfx.FF9SFX_Play(102);
+        }
+        return true;
+    }
+
+    public override Boolean OnKeyLeftBumper(GameObject go)
+    {
+        if (base.OnKeyLeftBumper(go))
+            this.StepCategory(-1);
+        return true;
+    }
+
+    public override Boolean OnKeyRightBumper(GameObject go)
+    {
+        if (base.OnKeyRightBumper(go))
+            this.StepCategory(+1);
+        return true;
+    }
+
+    public override Boolean OnItemSelect(GameObject go)
+    {
+        if (base.OnItemSelect(go))
+        {
+            if (ButtonGroupState.ActiveGroup == ListGroupButton && go != null)
+            {
+                RecycleListItem cell = go.GetComponent<RecycleListItem>();
+                if (cell != null && this.currentIndex != cell.ItemDataIndex)
+                {
+                    this.currentIndex = cell.ItemDataIndex;
+                    this.RefreshDetail();
+                }
+            }
+        }
+        return true;
+    }
+
+    private void StepCategory(Int32 dir)
+    {
+        Int32[] cats = FolkloreRegistry.CategoriesPresent();
+        if (cats.Length < 2)
+            return;                                        // one (or zero) categories -> nothing to page
+        Int32 at = Array.IndexOf(cats, this.currentCategory);
+        Int32 next = cats[((at < 0 ? 0 : at) + dir + cats.Length) % cats.Length];
+        if (next == this.currentCategory)
+            return;
+        FF9Sfx.FF9SFX_Play(1047);                          // the universal page-flip id (Status/Card
+                                                           // bumper paging -- VOCABULARY SS4)
+        this.currentCategory = next;
+        // the rebuild destroys the row pool and re-seats the cursor on the new rows, and
+        // ActiveButtonChanged fires the cursor-move beep on the new button (ButtonGroupState.cs:557)
+        // ON TOP of the page flip -- stock bumper-paging never trips this because it pages with the
+        // SUB-MENU group active, not a live list. MuteActiveSound is the stock counter-instrument
+        // (AbilityUI.cs:1480-1482); held across frames because part of the settle is
+        // Invoke-deferred (RepositionList) -- the SaveLoadUI cross-window idiom (SaveLoadUI.cs:565-576).
+        ButtonGroupState.MuteActiveSound = true;
+        this.muteSettleDepth++;
+        this.RefreshCategoryList(true);
+        base.StartCoroutine(this.UnmuteAfterSettle());
+    }
+
+    private System.Collections.IEnumerator UnmuteAfterSettle()
+    {
+        yield return null;                                 // the Invoke(0) pump runs RepositionList
+        yield return null;                                 // the select settle
+        if (--this.muteSettleDepth <= 0)
+        {
+            this.muteSettleDepth = 0;
+            ButtonGroupState.MuteActiveSound = false;
+        }
+    }
+
+    // rebuild the list for the current category (cursor to row 0 when `reset`), then the detail pane
+    private void RefreshCategoryList(Boolean reset)
+    {
+        if (this.listPopulator == null)
+            return;
+        this.entries = FolkloreRegistry.ForCategory(this.currentCategory);
+        if (this.entries.Count == 0)                       // registry empty -> try the first non-empty category
+        {
+            Int32[] cats = FolkloreRegistry.CategoriesPresent();
+            if (cats.Length > 0 && cats[0] != this.currentCategory)
+            {
+                this.currentCategory = cats[0];
+                this.entries = FolkloreRegistry.ForCategory(this.currentCategory);
+            }
+        }
+        if (this.categoryLabel != null)
+            this.categoryLabel.rawText = Localization.GetWithDefault(FolkloreRegistry.CategoryKey(this.currentCategory));
+        List<ListDataTypeBase> data = new List<ListDataTypeBase>();
+        foreach (FolkloreRegistry.Entry e in this.entries)
+            data.Add(new FolkloreListData { Entry = e });
+        if (reset)
+            this.currentIndex = 0;
+        System.Diagnostics.Stopwatch listWatch = System.Diagnostics.Stopwatch.StartNew();
+        try
+        {
+            if (data.Count > 0)
+            {
+                if (this.listPopulator.ItemsPool.Count == 0)
+                {
+                    this.listPopulator.PopulateListItemWithData = this.PopulateListCell;
+                    this.listPopulator.InitTableView(data, this.currentIndex);
+                }
+                else if (reset)
+                {
+                    this.listPopulator.InitTableView(data, 0);
+                }
+                else
+                {
+                    this.listPopulator.SetOriginalData(data);
+                }
+            }
+        }
+        catch (Exception err)
+        {
+            Log.Error(err);                                // a codex glitch must never brick the whole
+        }                                                  // menu until restart (the round-1 failure)
+        if (listWatch.ElapsedMilliseconds > 50)
+            Log.Message($"[FolkloreUI] list populate took {listWatch.ElapsedMilliseconds}ms (rows={data.Count})");
+        this.RefreshDetail();
+    }
+
+    private void PopulateListCell(Transform item, ListDataTypeBase data, Int32 index, Boolean isInit)
+    {
+        FolkloreListData row = (FolkloreListData)data;
+        Boolean owned = ff9item.FF9Item_IsExistImportant(row.Entry.Id);
+        // THE VANILLA POPULATE (ItemUI.DisplayKeyItemDetail, mirrored): trust the baked cell
+        // completely -- name text, the New! bang, the per-row window-color sweep, nothing else.
+        // Cell shape (KeyItemDetailHUD): child 0 = Name label, child 1 = the New! icon pair.
+        if (isInit)
+            this.DisplayWindowBackground(item.gameObject, null);   // the row wears the CURRENT
+        ButtonGroupState button = item.GetComponent<ButtonGroupState>();   // grey/blue window atlas
+        UILabel nameLabel = item.GetChild(0).GetComponent<UILabel>();
+        UISprite newIconSprite = item.GetChild(1).GetChild(0).GetComponent<UISprite>();
+        UISprite newIconLabelSprite = item.GetChild(1).GetChild(1).GetComponent<UISprite>();
+        // one-shot geometry census of the donor cell (numbers for styling rounds; log-only)
+        if (isInit && index == 0 && !this.dumpedCellOnce)
+        {
+            this.dumpedCellOnce = true;
+            foreach (UIWidget w in item.GetComponentsInChildren<UIWidget>(true))
+                Log.Message($"[FolkloreUI] cell child '{w.name}' tag={w.gameObject.tag} local={w.transform.localPosition} size={w.width}x{w.height} pivot={w.pivot}");
+        }
+        if (button != null && button.Help != null)
+            button.Help.Enable = false;                    // no help bar on the codex screen
+        nameLabel.gameObject.SetActive(true);
+        nameLabel.rawText = owned ? FF9TextTool.ImportantItemName(row.Entry.Id)
+                                  : Localization.GetWithDefault("FolkloreLocked");
+        nameLabel.color = owned ? FF9TextTool.White : FF9TextTool.Gray;
+        if (owned && !ff9item.FF9Item_IsUsedImportant(row.Entry.Id))
+        {
+            newIconSprite.spriteName = "icon_new_exclamation";   // the stock New! bang, cleared by
+            newIconLabelSprite.gameObject.SetActive(true);       // Confirm (the ItemUI skin idiom)
+        }
+        else
+        {
+            newIconSprite.spriteName = String.Empty;
+            newIconLabelSprite.gameObject.SetActive(false);
+        }
+    }
+
+    private void RefreshDetail()
+    {
+        if (this.detailNameLabel == null)
+            return;
+        if (this.entries == null || this.entries.Count == 0 || this.currentIndex >= this.entries.Count)
+        {
+            this.detailNameLabel.rawText = String.Empty;
+            this.detailBodyLabel.rawText = String.Empty;
+            return;
+        }
+        FolkloreRegistry.Entry e = this.entries[this.currentIndex];
+        if (ff9item.FF9Item_IsExistImportant(e.Id))
+        {
+            this.detailNameLabel.rawText = FF9TextTool.ImportantItemName(e.Id);
+            String lore = FF9TextTool.ImportantItemSkin(e.Id);
+            if (String.IsNullOrEmpty(lore))
+                lore = FF9TextTool.ImportantItemHelpDescription(e.Id);
+            this.detailBodyLabel.rawText = lore;
+        }
+        else
+        {
+            this.detailNameLabel.rawText = Localization.GetWithDefault("FolkloreLocked");
+            this.detailBodyLabel.rawText = Localization.GetWithDefault("FolkloreLockedHint");
+        }
+    }
+
+    // A stock framed window pane, THE ControlPanel.InstantiatePanel recipe (the FieldCreator-proven
+    // way to reuse GenericInfoPanel): clone the root for its UIWidget, clone the FRAME child (child 2
+    // = Border/Body/Shadow/Caption) SEPARATELY, strip every baked child (their anchors target
+    // MAIN-MENU transforms and re-assert each frame), re-anchor the frame onto OUR pane root, then
+    // de-anchor + pivot + place the root. The frame's own caption label is the pane's title plate.
+    // bordered=false drops the frame's white Border + Shadow, keeping the flat Body sheet + the
+    // caption -- the stock ITEM-page list style (an open sheet, not a windowed box; the playtest
+    // round-8 find: a bordered window manufactures margins a fixed-width row list can never fill)
+    private GameObject BuildFramedPane(MainMenuUI menu, String name, Single x, Single y, Single w, Single h, Boolean bordered, out UILabel caption)
+    {
+        GameObject paneGo = UnityEngine.Object.Instantiate(menu.GenericInfoPanel);
+        paneGo.name = name;
+        UIWidget pane = paneGo.GetComponent<UIWidget>();
+        GameObject frameGo = UnityEngine.Object.Instantiate(menu.GenericInfoPanel.GetChild(2));
+        paneGo.transform.DestroyChildren();
+        frameGo.name = name + " Frame";
+        frameGo.transform.parent = paneGo.transform;
+        frameGo.transform.localScale = Vector3.one;
+        UILocalize frameLoc = frameGo.GetComponentInChildren<UILocalize>();
+        if (frameLoc != null)
+            frameLoc.key = String.Empty;                   // the caption plate is OURS to write
+        caption = frameGo.GetComponentInChildren<UILabel>();
+        caption.fontSize = 34;                             // the baked tab reads tiny on a full pane
+        if (!bordered)
+        {
+            GameObject borderGo = frameGo.FindChild("Border");   // GOFrameBackground children are
+            if (borderGo != null)                                // found BY NAME ("not always in
+                borderGo.SetActive(false);                       // the same order")
+            GameObject shadowGo = frameGo.FindChild("Shadow");
+            if (shadowGo != null)
+                shadowGo.SetActive(false);
+        }
+        UIWidget frame = frameGo.GetComponent<UIWidget>();
+        frame.leftAnchor.Set(pane.transform, 0f, 0);       // the frame FILLS the pane rect
+        frame.rightAnchor.Set(pane.transform, 1f, 0);
+        frame.topAnchor.Set(pane.transform, 1f, 0);
+        frame.bottomAnchor.Set(pane.transform, 0f, 0);
+        paneGo.transform.parent = base.transform;
+        paneGo.transform.localScale = Vector3.one;
+        pane.SetAnchor((GameObject)null);
+        pane.pivot = UIWidget.Pivot.Center;
+        pane.SetRawRect(x, y, w, h);
+        frameGo.SetActive(true);
+        paneGo.SetActive(true);
+        return paneGo;
+    }
+
+    private void Awake()
+    {
+        // Built IN CODE from cloned stock pieces (zero new Unity assets -- the ControlPanel idiom).
+        // Awake runs on the first Show (the GameObject is created inactive by UIManager.Start).
+        // UI space: center origin, +y up, 1080 tall (1920 wide at 16:9); panes stay inside the
+        // pillarbox-safe +-771 band so non-widescreen keeps the whole screen.
+        // REDESIGN (Option B, studies/folklore-codex/REDESIGN.md): per-stage timings, so the
+        // first-open burst is attributed before anything gets optimized.
+        System.Diagnostics.Stopwatch watch = System.Diagnostics.Stopwatch.StartNew();
+        MainMenuUI menu = PersistenSingleton<UIManager>.Instance.MainMenuScene;
+
+        // the stock full-screen menu backdrop (MainMenuUI child 4, already GOMenuBackground-sized
+        // to UIContentSize) -- without it the panes float on black
+        GameObject bgGo = UnityEngine.Object.Instantiate(menu.transform.GetChild(4).gameObject);
+        bgGo.name = "Folklore Background";
+        bgGo.transform.parent = base.transform;
+        bgGo.transform.localScale = Vector3.one;
+        bgGo.transform.localPosition = Vector3.zero;
+        foreach (UIWidget bgWidget in bgGo.GetComponentsInChildren<UIWidget>(true))
+            bgWidget.SetAnchor((GameObject)null);
+        UISprite bgSprite = bgGo.GetComponent<UISprite>();
+        if (bgSprite != null && bgSprite.atlas != null && bgSprite.atlas.GetSprite("item_bg") != null)
+            bgSprite.spriteName = "item_bg";               // the stock SUBMENU backdrop flavor
+        bgGo.SetActive(true);
+        Int64 tBg = watch.ElapsedMilliseconds;
+
+        // the stock cross-fade (HonoFading re-derives its sprite from the CLONE's own object)
+        GameObject fadeGo = UnityEngine.Object.Instantiate(menu.ScreenFadeGameObject);
+        fadeGo.name = "Folklore Fade";
+        fadeGo.transform.parent = base.transform;
+        fadeGo.transform.localPosition = menu.ScreenFadeGameObject.transform.localPosition;
+        fadeGo.transform.localScale = Vector3.one;
+        base.FadingComponent = fadeGo.GetComponent<HonoFading>();
+
+        // RIGHT pane: the detail WINDOW (bordered -- the stock skin-popup style); caption = entry name.
+        // (The LEFT side is NOT a built pane: the list donor carries its own AUTHENTIC dressing --
+        // sheet + capped rails + header caption -- resurrected below; the round-9 borderless-frame
+        // approximation had no edges and an inset body.)
+        this.detailPanel = this.BuildFramedPane(menu, "Folklore Detail Pane", 410f, -40f, 780f, 880f, true, out this.detailNameLabel);
+        this.detailNameLabel.rawText = String.Empty;
+
+        // the lore body label inside the right pane
+        GameObject bodyGo = UnityEngine.Object.Instantiate(menu.LocationInfoPanel.GetChild(0));
+        bodyGo.name = "Folklore Detail Body";
+        bodyGo.transform.parent = this.detailPanel.transform;
+        bodyGo.transform.localScale = Vector3.one;
+        bodyGo.SetActive(true);
+        this.detailBodyLabel = bodyGo.GetComponent<UILabel>();
+        this.detailBodyLabel.SetAnchor((GameObject)null);
+        this.detailBodyLabel.pivot = UIWidget.Pivot.Top;   // lore reads from the TOP of the pane
+        this.detailBodyLabel.SetRawRect(0f, 330f, 600f, 640f);
+        this.detailBodyLabel.alignment = NGUIText.Alignment.Left;
+        this.detailBodyLabel.overflowMethod = UILabel.Overflow.ShrinkContent;   // long lore SHRINKS, never clips
+        this.detailBodyLabel.multiLine = true;
+        this.detailBodyLabel.rawText = String.Empty;
+        Int64 tPane = watch.ElapsedMilliseconds;
+
+        // the scrollable entry list -- THE KEY ITEMS LIST donor (ItemUI.KeyItemListPanel): name-only
+        // fixed-size window-bar rows, the codex's exact shape (ROUND-4 LAW: the donor cell is a
+        // FINISHED design -- style nothing, stretch nothing; the round-3 anchor surgery is why rows
+        // sheared). The clone's serialized refs (table / panel / draggablePanel / ScrollButton) all
+        // point IN-subtree, so Unity remaps them to the clone -- trust them, reassign NOTHING.
+        GameObject listRoot = UnityEngine.Object.Instantiate(
+            PersistenSingleton<UIManager>.Instance.ItemScene.KeyItemListPanel);
+        listRoot.name = "Folklore List";
+        listRoot.transform.parent = base.transform;        // scene-level, like the donor in ItemUI
+        listRoot.transform.localScale = Vector3.one;
+        GameObject listPanelGo = listRoot.GetChild(1);
+        this.listPopulator = listPanelGo.GetComponent<RecycleListPopulator>();
+        // THE PRESERVE-THE-BAKE CAPTURE (the REDESIGN law): snapshot the donor's solved geometry
+        // BEFORE any mutation -- the panel seat, the baked clip rect (center + height; the height
+        // IS the dressing's rail-to-rail content box), the dressing seat. Every vertical number
+        // downstream COPIES this bake; nothing vertical is re-derived (the Phase-B formula refit
+        // is exactly how row 1 ended up under the top rail).
+        Vector3 bakedPanelPos = listPanelGo.transform.localPosition;
+        Vector4 bakedClip = this.listPopulator.panel.baseClipRegion;   // (cx, cy, width, height)
+        Vector2 bakedClipOffset = this.listPopulator.panel.clipOffset; // the OTHER half of the NGUI
+        // scroll state: the donor is the LIVE ItemScene panel, and every scroll moves localPosition
+        // and clipOffset in exact opposition (UIScrollView.MoveRelative) -- P+O is the
+        // scroll-INVARIANT window anchor, P alone is contaminated by any leftover Key-Items scroll
+        // (the redesign review's blocker: dressing seated n rows off after the player scrolls
+        // Key Items then first-opens Folklore).
+        Vector3 bakedDressingPos = listRoot.GetChild(2).transform.localPosition;
