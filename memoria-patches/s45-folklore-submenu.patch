+
+// The mod-shipped codex registry: each mod folder may carry a root-level `FolklorePatch.txt`
+// (the DictionaryPatch/ForkDonorPatch idiom -- read via TryFindAssetInModOnDisc, low->high, higher
+// folders override per id). Line grammar: `<keyItemId> <category> [displayRef]` -- category =
+// bestiary|places|lore (or 0|1|2); `#`-prefixed lines are comments; the optional third token is the
+// s46 display-window asset reference (parsed + stored now, unused in Phase B). The registry is the
+// single source of truth for WHICH key-item ids are Folklore -- the ItemUI Key-Items filter keys on
+// the REGISTERED SET, never a blind id band (the SUBMENU.md M5 correction).
+public static class FolkloreRegistry
+{
+    public const String PatchPath = "FolklorePatch.txt";
+
+    public class Entry
+    {
+        public Int32 Id;
+        public Int32 Category;
+        public String Display;                             // reserved for the s46 render rig
+    }
+
+    private static readonly Dictionary<Int32, Entry> _entries = new Dictionary<Int32, Entry>();
+    private static Boolean _loaded;
+
+    public static String CategoryKey(Int32 cat)
+    {
+        switch (cat)
+        {
+            case 0: return "FolkloreBestiary";
+            case 1: return "FolklorePlaces";
+            default: return "FolkloreLore";
+        }
+    }
+
+    private static Int32 ParseCategory(String token)
+    {
+        switch (token.Trim().ToLowerInvariant())
+        {
+            case "bestiary": case "0": return 0;
+            case "places": case "1": return 1;
+            case "lore": case "2": return 2;
+            default: return -1;
+        }
+    }
+
+    private static void EnsureLoaded()
+    {
+        if (_loaded)
+            return;
+        _loaded = true;
+        foreach (AssetManager.AssetFolder folder in AssetManager.FolderLowToHigh)
+        {
+            if (String.IsNullOrEmpty(folder.FolderPath))
+                continue;                                  // patches load from MOD folders only (the
+            try                                            // DataPatchers idiom -- never the base dir)
+            {
+                if (!folder.TryFindAssetInModOnDisc(PatchPath, out String path))
+                    continue;
+                foreach (String raw in File.ReadAllLines(path))
+                {
+                    String line = raw.Trim();
+                    if (line.Length == 0 || line.StartsWith("#") || line.StartsWith("//"))
+                        continue;
+                    String[] tok = line.Split(DataPatchers.SpaceSeparators, StringSplitOptions.RemoveEmptyEntries);
+                    if (tok.Length < 2 || !Int32.TryParse(tok[0], out Int32 id))
+                    {
+                        Log.Warning($"[FolkloreRegistry] bad line in {path}: '{raw}'");
+                        continue;
+                    }
+                    Int32 cat = ParseCategory(tok[1]);
+                    if (cat < 0)
+                    {
+                        Log.Warning($"[FolkloreRegistry] unknown category in {path}: '{raw}'");
+                        continue;
+                    }
+                    _entries[id] = new Entry { Id = id, Category = cat, Display = tok.Length > 2 ? tok[2] : null };
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err);                            // per-FOLDER isolation: one unreadable file
+            }                                              // must not half-load the whole registry
+        }
+        if (_entries.Count > 0)
+            Log.Message($"[FolkloreRegistry] {_entries.Count} codex entries registered");
+    }
+
+    public static Boolean IsFolklore(Int32 keyItemId)
+    {
+        EnsureLoaded();
+        return _entries.ContainsKey(keyItemId);
+    }
+
+    public static List<Entry> ForCategory(Int32 cat)
+    {
+        EnsureLoaded();
+        List<Entry> outList = new List<Entry>();
+        foreach (Entry e in _entries.Values)
+            if (e.Category == cat)
+                outList.Add(e);
+        outList.Sort((a, b) => a.Id.CompareTo(b.Id));      // stable curated order = id order
+        return outList;
+    }
+
+    public static Int32[] CategoriesPresent()
+    {
+        EnsureLoaded();
+        List<Int32> cats = new List<Int32>();
+        for (Int32 c = 0; c <= 2; c++)
+        {
+            foreach (Entry e in _entries.Values)
+            {
+                if (e.Category == c)
+                {
+                    cats.Add(c);
+                    break;
+                }
+            }
+        }
+        return cats.ToArray();
+    }
+}
+
+// The s45 feature gate: Memoria.ini [Folklore] Enabled (default 0 = the row/scene/filter never exist;
+// fail-safe vanilla). Read ONCE per process; the netsync IniFile idiom.
+internal static class FolkloreConfig
+{
+    private static Int32 _enabled = -1;
+
+    internal static Boolean Enabled
+    {
+        get
+        {
+            if (_enabled < 0)
+            {
+                try
+                {
+                    IniFile ini = new IniFile(IniFile.MemoriaIniPath);
+                    _enabled = ini.GetSetting("Folklore", "Enabled", "0").Trim() == "1" ? 1 : 0;
+                }
+                catch (Exception err)
+                {
+                    Log.Error(err);
+                    _enabled = 0;                          // unreadable ini -> stock behavior
+                }
+            }
+            return _enabled > 0;
+        }
+    }
+}
