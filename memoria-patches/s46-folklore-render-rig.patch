+                                                                     // codebase's anti-culling-override
+                                                                     // idiom, e.g. Single.MaxValue*0.01f --
+                                                                     // FieldMapActor.cs:316,323,327)
+            Vector3 c = mesh.bounds.center;
+            for (Int32 sx = -1; sx <= 1; sx += 2)
+                for (Int32 sy = -1; sy <= 1; sy += 2)
+                    for (Int32 sz = -1; sz <= 1; sz += 2)
+                    {
