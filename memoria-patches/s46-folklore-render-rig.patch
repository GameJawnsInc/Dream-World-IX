+    // bind a clip that was never attached to this rig -- a cross-rig/garbage clip, not merely a wrong
+    // idle. Match order: (a) exact case-sensitive hit; (b) a suffix hit -- a discovered name ends with
+    // '_' + payload (so 'idle:002' finds 'ANH_MON_B3_009_002'); a suffix matching MORE THAN ONE
+    // discovered name is ambiguous and defaults rather than guessing.
+    private static String ResolveFolkloreIdleClip(String token, List<String> discovered, String defaultClip, Int32 entryId)
+    {
+        if (String.IsNullOrEmpty(token))
+            return defaultClip;                                 // no override requested -- today's
+                                                                  // behavior, unchanged, no warning
+        try
+        {
+            Int32 colon = token.IndexOf(':');
+            if (colon < 0)
+            {
+                Log.Warning($"[FolkloreUI] entry {entryId}: idle clip token '{token}' missing the 'idle:' scheme, using default clip");
+                return defaultClip;
+            }
+            String scheme = token.Substring(0, colon);
+            String payload = token.Substring(colon + 1);
+            if (scheme != "idle")
+            {
+                Log.Warning($"[FolkloreUI] entry {entryId}: unknown idle clip scheme in '{token}', using default clip");
+                return defaultClip;
+            }
+            if (String.IsNullOrEmpty(payload))
+            {
+                // the skeptic's diagnostics nit: an 'idle:' with nothing after it is NOT an unknown
+                // scheme -- name the real failure so the FolklorePatch.txt author fixes the right thing
+                Log.Warning($"[FolkloreUI] entry {entryId}: idle clip token '{token}' has an empty payload, using default clip");
+                return defaultClip;
+            }
+            if (discovered.Contains(payload))                   // exact case-sensitive match first
+                return payload;
