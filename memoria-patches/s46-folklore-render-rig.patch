+    private Boolean GatherFolkloreStaticBounds(GameObject model, out Vector3 min, out Vector3 max)
+    {
+        min = Vector3.zero; max = Vector3.zero;
+        Boolean any = false;
+        foreach (Renderer r in model.GetComponentsInChildren<Renderer>(true))
+        {
+            if (!r.enabled)
+                continue;
+            Mesh mesh = null;
+            SkinnedMeshRenderer smr = r as SkinnedMeshRenderer;
+            if (smr != null)
+                mesh = smr.sharedMesh;
+            else
+            {
+                MeshFilter mf = r.GetComponent<MeshFilter>();
+                if (mf != null)
+                    mesh = mf.sharedMesh;
+            }
+            if (mesh == null)
