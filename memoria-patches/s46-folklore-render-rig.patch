+                                                                           // (Unity default; confirmed no
+                                                                           // horizontal-FOV math anywhere in
+                                                                           // this codebase's 13 fieldOfView
+                                                                           // call sites)
+        Single tanHalfV = Mathf.Tan(fovV * 0.5f);
