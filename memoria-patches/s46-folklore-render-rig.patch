+    // static-mount path keeps calling the (min,max) wrapper unchanged.
+    private Boolean ApplyFolkloreFitCore(Vector3 center, Vector3 halfExtents)
+    {
+        if (halfExtents.x < FolkloreAutoFitMinExtent && halfExtents.y < FolkloreAutoFitMinExtent && halfExtents.z < FolkloreAutoFitMinExtent)
