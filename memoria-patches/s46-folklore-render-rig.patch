+    // half of the static gather's math is still needed here. SAME per-renderer absurd-extent guard as
+    // the static gather (FolkloreAutoFitMaxExtent).
+    private Boolean GatherFolkloreLiveBounds(GameObject model, out Vector3 min, out Vector3 max)
+    {
+        min = Vector3.zero; max = Vector3.zero;
+        Boolean any = false;
+        foreach (Renderer r in model.GetComponentsInChildren<Renderer>(true))
+        {
+            if (!r.enabled)
+                continue;
+            Bounds b = r.bounds;
+            Vector3 e = b.extents;
+            if (e.x > FolkloreAutoFitMaxExtent || e.y > FolkloreAutoFitMaxExtent || e.z > FolkloreAutoFitMaxExtent)
+                continue;
