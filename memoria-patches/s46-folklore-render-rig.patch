+            return true;
+        }
+        catch (Exception err)
+        {
+            Log.Error(err);
+            geoName = null;
+            return false;
+        }
+    }
+
+    // s46 rung 2 -- re-implements ModelViewerScene.GetAnimationsOfModel's GEO-suffix filter
+    // (ModelViewerScene.cs:1679-1691) against a bare GEO name string instead of its PRIVATE ModelObject
+    // wrapper (FolkloreUI spawns via bare ModelFactory.CreateModel, not the viewer's own wrapper type).
+    private static List<String> GetFolkloreAnimationNames(String geoName)
+    {
+        List<String> result = new List<String>();
+        if (String.IsNullOrEmpty(geoName) || geoName.Length <= 4)
+            return result;
+        String identifier = geoName.Substring(4);
+        foreach (KeyValuePair<Int32, String> anim in FF9DBAll.AnimationDB)
+            if (!String.IsNullOrEmpty(anim.Value) && anim.Value.Length > 4 && anim.Value.Substring(4).StartsWith(identifier))
+                result.Add(anim.Value);
