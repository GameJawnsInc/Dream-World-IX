+    private Boolean ApplyFolkloreFit(Vector3 min, Vector3 max)
+    {
+        Vector3 boundsCenter = (min + max) * 0.5f;
+        Vector3 halfExtents = (max - min) * 0.5f;
+        return this.ApplyFolkloreFitCore(boundsCenter, halfExtents);
+    }
+
+    // s46 rung 5 -- THE BODY-BLEND FIT CORE: the FOV/distance math extracted verbatim out of
