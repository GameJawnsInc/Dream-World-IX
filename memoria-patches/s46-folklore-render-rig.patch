+            return defaultClip;
+        }
+        catch (Exception err)
+        {
+            Log.Error(err);
+            return defaultClip;                                 // fail-soft law: never brick the mount
+        }
+    }
+
+    // s46 rung 3 (split in rung 4 -- see ApplyFolkloreFit below): the STATIC bind-pose bounds gather
+    // (no in-tree precedent; standard perspective-fit math). Walks the model's
+    // SkinnedMeshRenderer/MeshRenderer set, SKIPPING disabled renderers (isBattle:false only disables
+    // the "battle_model" Renderer COMPONENTS -- ModelFactory.cs:189-198 -- it does NOT deactivate their
