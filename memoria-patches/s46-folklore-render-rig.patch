+    // call chain -- an uncaught throw here would unwind out of NGUI's own callback, worse than the
+    // documented text-only degrade (and it would skip DestroyFolkloreModel, leaving a PREVIOUS
+    // entry's creature standing next to the new entry's text). Matches this file's standing law
+    // (every new method that can fail catches Exception, logs, degrades -- never rethrows).
+    private static Boolean ResolveFolkloreDisplay(String token, out String geoName)
+    {
+        geoName = null;
+        if (String.IsNullOrEmpty(token))
+            return false;
+        try
+        {
+            String scheme, payload;
+            Int32 colon = token.IndexOf(':');
+            if (colon < 0) { scheme = "model"; payload = token; }
+            else { scheme = token.Substring(0, colon); payload = token.Substring(colon + 1); }
+            if (scheme != "model" || String.IsNullOrEmpty(payload))
+                return false;
