+            }
+        }
+
+        // Mirrors SFXRender.Add()'s own `tag->code & 252` switch 1:1, for LABELING only -- if
+        // that switch's case set ever changes, this table needs to move with it. Case values are
+        // Global/SFXRender/SFXRender.cs:210-294's exact literals.
+        private static String TypeLabel(Byte code, out Boolean hasVertex)
+        {
+            switch (code & 252)
+            {
+                case 32: hasVertex = true; return "F3";
+                case 36: hasVertex = true; return "FT3";
+                case 40: hasVertex = true; return "F4";
+                case 44: hasVertex = true; return "FT4";
+                case 48: hasVertex = true; return "G3";
+                case 52: hasVertex = true; return "GT3";
+                case 56: hasVertex = true; return "G4";
+                case 60: hasVertex = true; return "GT4";
+                case 64: hasVertex = true; return "LINE_F2";
+                case 68: hasVertex = true; return "FT4_BLUR";
+                case 72: hasVertex = true; return "GT4_BLUR";
+                case 76: hasVertex = true; return "FT4_POINT";
+                case 80: hasVertex = true; return "LINE_G2";
+                case 96: hasVertex = true; return "TILE";
+                case 100: hasVertex = true; return "SPRT";
+                case 104: hasVertex = true; return "TILE_1";
+                case 112: hasVertex = true; return "TILE_8";
+                case 116: hasVertex = true; return "SPRT_8";
+                case 120: hasVertex = true; return "TILE_16";
+                case 124: hasVertex = true; return "SPRT_16";
+                default:
+                    hasVertex = false;
+                    switch (code)
+                    {
+                        case 225: return "DR_TPAGE";
+                        case 228: return "DR_AREA";
+                        case 229: return "DR_OFFSET";
+                        case 231: return "DR_MOVE";
+                        default: return "UNKNOWN_" + code.ToString(CultureInfo.InvariantCulture);
+                    }
+            }
+        }
+
+        private static Int32 _primRowCount;
+        private static Boolean _primCapWarned;
+
+        private static Int32 _sumFrame = Int32.MinValue;
+        private static Int32 _sumEffectId;
+        private static Int32 _sumCount;
+        private static Int32 _sumMinX, _sumMinY, _sumMaxX, _sumMaxY;
+
+        private static void AccumulateSummary(Int32 frame, Int32 effectId, Int32 x, Int32 y)
+        {
+            if (frame != _sumFrame)
+            {
+                FlushSummary();
+                _sumFrame = frame;
+                _sumEffectId = effectId;
+                _sumCount = 0;
+                _sumMinX = Int32.MaxValue;
+                _sumMinY = Int32.MaxValue;
+                _sumMaxX = Int32.MinValue;
+                _sumMaxY = Int32.MinValue;
+            }
+            _sumCount++;
+            if (x < _sumMinX) _sumMinX = x;
+            if (x > _sumMaxX) _sumMaxX = x;
+            if (y < _sumMinY) _sumMinY = y;
+            if (y > _sumMaxY) _sumMaxY = y;
+        }
+
+        private static void FlushSummary()
+        {
+            if (_sumCount == 0)
+                return;
+            StreamWriter w = Writer;
+            if (w == null)
+                return;
+            try
+            {
+                w.WriteLine(String.Format(CultureInfo.InvariantCulture,
+                    "PRIMSUM,{0},{1},{2},{3},{4},{5},{6}",
+                    _sumEffectId, _sumFrame, _sumCount, _sumMinX, _sumMinY, _sumMaxX, _sumMaxY));
+                w.Flush();
+            }
+            catch
+            {
+            }
+        }
+
+        // Called from SFXDataMesh.cs, Runtime.End() -- flushes the last frame's pending PRIMSUM
+        // row (AccumulateSummary only flushes on a FRAME-BOUNDARY transition, so the very last
+        // frame of a cast would otherwise never reach the file). No-op unless CapturePrims=1 AND
+        // PrimSummary=1; also resets the accumulator so the next effect's frame-0 primitives
+        // never merge into a stale row from this one.
+        public static void FlushPrimSummary()
+        {
+            if (!CapturePrims || !PrimSummary)
+                return;
+            FlushSummary();
+            _sumFrame = Int32.MinValue;
+            _sumCount = 0;
+        }
     }
 }
