+        // s48 -- raw native-primitive capture (Memoria.ini [SfxProbe] CapturePrims=1). Hooked at
+        // the TOP of SFXRender.Add() (Global/SFXRender/SFXRender.cs:208) -- the single funnel
+        // every decoded PS1 GPU primitive returned by the native SFX_GetPrim loop
+        // (SFXRender.Update(), same file :76-85) passes through, BEFORE SFXRender batches it
+        // into a keyed SFXMesh. This is strictly richer than the s47 MESH rows for understanding
+        // a native effect's own decoded output: it sees every individual triangle/quad/line/
+        // tile/sprite in native decode + depth-sort order, with its own tag type and PSX-native
+        // screen-space vertex -- the SFXMesh commandBuffer only exposes the POST-BATCH merged
+        // mesh (many primitives of one key collapsed together, draw order and per-primitive
+        // type lost). This does not read shippable creature/effect asset data any more than the
+        // s47 mesh hook already does -- it is the same category of read-the-decoded-OUTPUT
+        // introspection, at finer granularity, for reuse of TIMING and GEOMETRY (not extraction
+        // of packaged content).
+        //
+        // GEOMETRY, GENERICALLY: every PSX GPU primitive tag this engine decodes (POLY_F3/FT3/
+        // F4/FT4/G3/GT3/G4/GT4, LINE_F2/G2, TILE/SPRT and their fixed-size variants) places its
+        // first vertex (x0,y0, each Int16) at the SAME fixed byte offset 8 from the tag pointer
+        // -- immediately after the shared 8-byte P_TAG header (a 32-bit OT-link word, then the
+        // r0/g0/b0/code byte word). See PSX_LIBGPU.cs: P_TAG's `code` sits at byte 7, and every
+        // POLY_*/LINE_*/TILE/SPRT struct places x0 right at byte 8, whether or not it then uses
+        // [StructLayout(Explicit)] to interleave uv/clut fields after later vertices. That means
+        // vertex0 can be read WITHOUT a per-type cast for every case SFXRender.Add() itself
+        // switches on (mirrored below by `tag->code & 252`, 1:1 with that switch).
+        //
+        // The DR_* rendering-STATE tags (DR_TPAGE/DR_AREA/DR_OFFSET/DR_MOVE -- matched by EXACT
+        // `tag->code`, never by the masked switch) carry no vertex and are logged as STATE rows
+        // with no coordinate read. DR_TPAGE in particular is only an 8-byte struct (the tag word
+        // + one code word); its own offset 8 would already be the START of the NEXT primitive in
+        // the stream, so it is deliberately excluded from the generic vertex read -- not merely
+        // skipped for tidiness.
+        //
+        // VOLUME (a real concern -- a full cast logged 19,436 s47 MESH rows, one per BATCHED
+        // mesh; nothing is batched yet at this hook, so the raw primitive count can run
+        // 10-100x that). Two independent, DOCUMENTED controls -- this probe never silently
+        // truncates:
+        //   - PrimSummary=1 (Memoria.ini [SfxProbe]): collapses to ONE PRIMSUM row per frame
+        //     (a primitive count + the frame's vertex0 bounding box) instead of one row per
+        //     primitive. Flushed on the next frame boundary, and on effect end via
+        //     FlushPrimSummary() (called from SFXDataMesh.cs Runtime.End()).
+        //   - PrimCap=<N> (Memoria.ini [SfxProbe], default 200000): a hard cap on per-primitive
+        //     PRIM/STATE rows for the process lifetime. The row that crosses it writes ONE
+        //     "# PRIM CAPTURE TRUNCATED" marker line and every row after that is dropped for
+        //     the rest of the session -- so a short log always SAYS it is short; it never just
+        //     quietly stops matching the cast.
+        //
+        // index = this primitive's 0-based position in the frame's SFX_GetPrim stream
+        // (SFXRender.primCount at call time, read before Update() increments it -- see
+        // SFXRender.cs:78-85); code = the primitive's raw tag->code byte (decimal, matches
+        // SFXRender.Add()'s own switch cases 1:1, e.g. 60 = POLY_GT4); vertHint/label = a human
+        // shape/state name, informational only; otz = SFXMesh.GzDepth at capture time (the same
+        // depth-sort value SFXMesh.PolyXxx() ultimately writes as the vertex's own Z -- see
+        // SFXMesh.cs:340-351); x,y = vertex0 in the SAME post-drOffset space SFXMesh.PolyXxx()
+        // writes into its mesh (raw x0/y0 + SFXMeshBase.drOffsetX/Y -- directly comparable to a
+        // MESH row's cx/cy).
+        public unsafe static void LogPrim(PSX_LIBGPU.P_TAG* tag, Int32 index)
+        {
+            if (!CapturePrims || tag == null)
+                return;
+            try
+            {
+                Byte code = tag->code;
+                Boolean hasVertex;
+                String label = TypeLabel(code, out hasVertex);
+                Int32 frame = SFX.frameIndex;
+                Int32 effectId = (Int32)SFX.currentEffectID;
+                Int32 x = 0, y = 0;
+                if (hasVertex)
+                {
+                    Int16* v = (Int16*)((Byte*)tag + 8);
+                    x = v[0] + SFXMeshBase.drOffsetX;
+                    y = v[1] + SFXMeshBase.drOffsetY;
+                }
+                if (PrimSummary)
+                {
+                    if (hasVertex)
+                        AccumulateSummary(frame, effectId, x, y);
+                    return;
+                }
+                StreamWriter w = Writer;
+                if (w == null)
+                    return;
+                if (_primRowCount >= PrimRowCap)
+                {
+                    if (!_primCapWarned)
+                    {
+                        _primCapWarned = true;
+                        w.WriteLine("# PRIM CAPTURE TRUNCATED at " + PrimRowCap.ToString(CultureInfo.InvariantCulture) +
+                            " rows (raise [SfxProbe] PrimCap=<N>, or set PrimSummary=1 for a bounded one-row-per-frame mode instead)");
+                        w.Flush();
+                    }
+                    return;
+                }
+                _primRowCount++;
+                if (hasVertex)
+                    w.WriteLine(String.Format(CultureInfo.InvariantCulture,
+                        "PRIM,{0},{1},{2},{3},{4},{5:F4},{6},{7}",
+                        effectId, frame, index, code, label, SFXMesh.GzDepth, x, y));
+                else
+                    w.WriteLine(String.Format(CultureInfo.InvariantCulture,
