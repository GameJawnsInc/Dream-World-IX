+    // [ff9mapkit s59] Drive the arrival hold armed by ServicePendingWarp: wait for the destination to be
+    // live (map id flipped + FieldHUD back — the load itself renders black), then re-assert the wipe to
+    // black each frame for WarpSettleFrames (out-shouting any early scripted fade-in) while the smooth
+    // camera eases onto the spawn, then fade in. A deadline clears a hold that never arms (e.g. the
+    // destination instantly chain-warped elsewhere) so the screen can never be stranded black.
+    private void ServiceArrivalHold()
+    {
+        if (_settleMap < 0)
+            return;
+        try
+        {
+            if (Time.realtimeSinceStartup > _settleDeadline)
+            {
+                if (_settleFramesLeft >= 0)                  // we forced black -> hand it back
+                    SceneDirector.FF9Wipe_FadeInEx(WarpFadeInFrames);
+                _settleMap = -1;
+                return;
+            }
+            if (_settleFramesLeft < 0)
+            {
+                if (FF9StateSystem.Common.FF9.fldMapNo != _settleMap
+                    || PersistenSingleton<UIManager>.Instance.State != UIManager.UIState.FieldHUD)
+                    return;                                  // still loading (black by itself)
+                _settleFramesLeft = WarpSettleFrames;
+            }
+            if (_settleFramesLeft > 0)
+            {
+                SceneDirector.FF9Wipe_FadeOutEx(1);          // hold: black wins this frame
+                _settleFramesLeft--;
+                return;
+            }
+            SceneDirector.FF9Wipe_FadeInEx(WarpFadeInFrames);
+            _settleMap = -1;
+        }
+        catch (Exception)
+        {
+            _settleMap = -1;                                 // stop re-blacking on any fault
+        }
+    }
+
