diff --git a/Assembly-CSharp/Global/Honolulu/HonoluluFieldMain.cs b/Assembly-CSharp/Global/Honolulu/HonoluluFieldMain.cs
index 4a05c25..8120047 100644
--- a/Assembly-CSharp/Global/Honolulu/HonoluluFieldMain.cs
+++ b/Assembly-CSharp/Global/Honolulu/HonoluluFieldMain.cs
@@ -90,8 +90,21 @@ public class HonoluluFieldMain : HonoBehavior
         }
         String text = FF9DBAll.EventDB[MapNo];
         map.evtPtr = EventEngineUtils.loadEventData(text, EventEngineUtils.ebSubFolderField);
-        AnimationFactory.LoadAnimationUseInEvent(text);
-        vib.LoadVibData(text);
+        // [ff9mapkit s62] the EventAnimation preload list and the VibrationData blob are NAME-KEYED on the
+        // field's own event name -- a FORK's minted name misses both (the s31/s33 name-key class). The anim
+        // miss is a benign lazy-load; the VIB miss leaves vib.Parms.vibPtr NULL and the donor script's VIB
+        // ops then THROW mid-DoEventCode (Nullable.get_Value), aborting the whole event frame: hung cutscene
+        // actors + skipped story writes (F2 2026-07-27: the 6003 walk-snap; VIB throws logged in the forked
+        // cargo-ship fields). Resolve the DONOR's event name for both loads.
+        String assetKeyName = text;
+        Int32 vibDonorId = Memoria.DataPatchers.EffectiveFieldId(MapNo);
+        if (vibDonorId != MapNo)
+        {
+            try { assetKeyName = FF9DBAll.EventDB[vibDonorId]; }
+            catch (Exception) { assetKeyName = text; }
+        }
+        AnimationFactory.LoadAnimationUseInEvent(assetKeyName);
+        vib.LoadVibData(assetKeyName);
         map.mcfPtr = MapConfiguration.LoadMapConfigData(text);
         GameObject mapRootGo = GameObject.Find("FieldMap Root");
         GameObject mapGo = new GameObject("FieldMap");
