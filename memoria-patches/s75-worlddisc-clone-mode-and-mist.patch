@@ -222,6 +222,18 @@
 
         public static Boolean UseMist()
         {
+            // [ff9mapkit s75] DWIX PATH D: a synthetic world is mist-free by owner decision. This is the ONLY clean
+            // lever -- mist is not position-keyed and has NO script route: w_frameFog's sole source is
+            // w_weatherFogCheck() -> UseMist(), which stock-tests the SCENARIO COUNTER, and no
+            // w_frameSetParameter/RunWorldCode case writes w_frameFog at all (its one weather case hardwires
+            // fog=2, "keep current"). Placed ahead of the data hook so a Path D world is unambiguous; gated on
+            // Engaged, which Latch() ALWAYS assigns, so a real disc-1/4 load reads false by construction and stock
+            // mist behaviour is byte-identical.
+            // WARNING -- NOT purely cosmetic: w_frameFog is part of the ENCOUNTER lookup key
+            // (ff9.w_worldGetBattleScenePtr), so a mist-free world draws each zone's fog=0 encounter twin instead
+            // of its fog=1 one. Near Dali's topograph-10 ground that is battle scene 245 instead of 247.
+            if (Memoria.World.WorldDiscSpike.Engaged && Memoria.World.WorldDiscSpike.SuppressMist)
+                return false;
             // Custom usage condition
             if (_customMistModifier.HasCondition)
                 return _customMistModifier.IsActive;
