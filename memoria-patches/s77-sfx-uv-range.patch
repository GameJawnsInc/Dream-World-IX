+        // ---- s77: per-mesh UV-range accumulation ----------------------------------------------
+        // One UvAcc per textured mesh key, folded from the primitives' OWN u,v bytes in LogPrim
+        // and emitted as a UVR row beside the key's MESH row in LogFrame. PASS-STAMP REUSE, not
+        // Clear(): _uvPass advances at each frame's first primitive (index == 0); an entry whose
+        // pass is stale is re-initialised in place on first touch. ~20 entries ever allocated
+        // (measured on the cast-2 archive), zero steady-state GC -- and because nothing clears at
+        // emit, a repeated Render() over an unchanged commandBuffer re-emits the same correct UVR
+        // rows beside the same MESH rows.
+        private sealed class UvAcc
+        {
+            public Int32 pass, prims, uMin, uMax, vMin, vMax, srcMask, tpage, clut;
+        }
