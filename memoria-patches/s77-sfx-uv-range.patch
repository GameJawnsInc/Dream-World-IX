+        private static readonly Dictionary<UInt32, UvAcc> _uv = new Dictionary<UInt32, UvAcc>();
+        private static Int32 _uvPass;
+
+        private static UvAcc UvEntry(UInt32 key, Int32 clut)
+        {
+            UvAcc acc;
+            if (!_uv.TryGetValue(key, out acc))
+            {
+                acc = new UvAcc();
+                acc.pass = Int32.MinValue;
+                _uv[key] = acc;
+            }
+            if (acc.pass != _uvPass)
+            {
+                acc.pass = _uvPass;
+                acc.prims = 0;
+                acc.uMin = 256; acc.uMax = -1;
+                acc.vMin = 256; acc.vMax = -1;
+                acc.srcMask = 0;
+                acc.tpage = -1;
+            }
+            acc.clut = clut;
+            return acc;
+        }
+
+        private static void UvFold(UvAcc acc, Int32 u, Int32 v)
+        {
+            if (u < acc.uMin) acc.uMin = u;
+            if (u > acc.uMax) acc.uMax = u;
+            if (v < acc.vMin) acc.vMin = v;
+            if (v > acc.vMax) acc.vMax = v;
+        }
