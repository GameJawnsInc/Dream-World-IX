+    // here is a hint, not a clearance.
+    // *** These are BIT indices. *** A Bit var's index is a bit address (byte = n>>3, bit = n&7); a
+    // Byte/Int16/Int24 var's index is a RAW BYTE offset. So "bit 184" (inside byte 23) and "byte 184" (the
+    // chocograph field, bits 1472+) are DIFFERENT LOCATIONS. Both are labelled below on purpose -- the
+    // single-bit tests at 184/191 are byte 23's engine handshake and are NOT a broken byte-range test.
     private static String RegionLabel(Int32 bit)
     {
-        if (bit >= 8376 && bit <= 8511) return "  [chest_opened, RESERVED]";
+        // --- byte 23, bit-addressed: the engine handshake (flags.py field_menu_guard / boot_scratch)
+        if (bit == 184) return "  [field menu guard (byte 23.0), RESERVED]";
+        if (bit == 191) return "  [boot scratch (byte 23.7), RESERVED]";
+        // --- BYTES 184-191, i.e. bits 1472-1535: chocograph found/opened + Choco's dig level
+        if (bit >= 1472 && bit <= 1535) return "  [chocograph/dig, BYTES 184-191, RESERVED]";
         if (bit >= 736 && bit <= 823) return "  [worldmap_unlocks, RESERVED]";
-        if (bit == 184 || bit == 191) return "  [byte-23 engine handshake, RESERVED]";
+        // --- stock MOGNET. Whole-byte-written by ordinary play; a custom bit here is corrupted AND corrupts.
+        if (bit >= 8192 && bit <= 8367) return "  [mognet mailbox, RESERVED]";
+        if (bit >= 8376 && bit <= 8439) return "  [mognet GIVE locks, RESERVED]";
+        if (bit >= 8440 && bit <= 8503) return "  [mognet READ locks, RESERVED]";
+        if (bit >= 8504 && bit <= 8511) return "  [mognet lock margin, RESERVED]";
+        if (bit >= 8512 && bit <= 8711) return "  [stock read-mail payload, RESERVED]";
+        // --- kit/engine scratch ABOVE the safe band (flags.py NAMEPLATE_EXPLORED_FLOOR and up)
+        if (bit >= 16048 && bit <= 16143) return "  [nameplate explored words, kit-RESERVED]";
+        if (bit >= 16144 && bit <= 16255) return "  [qte scratch, kit-RESERVED]";
+        if (bit >= 16256 && bit <= 16319) return "  [netsync coop cells, RESERVED]";
         if (bit >= 16320 && bit <= 16335) return "  [choice_scratch, RESERVED]";
