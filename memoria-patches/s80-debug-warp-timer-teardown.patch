+    // [ff9mapkit s69] Fully disarm the countdown HUD (the field-timer leak fix). ShowTimer/RunTimer write the
+    // SAVE-PERSISTED mirrors `_ff9.timerDisplay/timerControl`, and EventEngine.StartEvents re-stamps TimerUI
+    // from them on EVERY map load -- deliberately cross-field in stock (the Festival of the Hunt spans
+    // Lindblum), so nothing but an explicit ShowTimer(0)/RunTimer(0) ever clears it. A debug warp bypasses
+    // the field's own scripted exits (which the kit teaches to disarm), so a bench countdown otherwise rides
+    // onto the overworld and every later field, and even through save/load (the fort-condor siege leak,
+    // 2026-07-28). Mirrors the .eb pair RunTimer(0) + ShowTimer(0), exactly as DoEventCode applies them.
+    private static void KillCountdown()
+    {
+        try
+        {
+            FF9StateSystem.Common.FF9.timerControl = false;
+            TimerUI.SetPlay(false);
+            FF9StateSystem.Common.FF9.timerDisplay = false;
+            TimerUI.SetEnable(false);
+            TimerUI.SetDisplay(false);
+        }
+        catch (Exception) { }   // a half-initialized TimerUI must never break the warp itself
+    }
