+using Assets.Sources.Scripts.UI.Common;
+using Memoria;
+using Memoria.Prime;
+using System;
+using UnityEngine;
+
+// ff9mapkit s81 -- THE COMPLETION JOURNAL submenu, rung M0: the skeleton screen.
+// The Journal takes Folklore's main-menu seat (owner ratification 2026-08-26: Folklore hidden
+// entirely; three tabs STORY / SIDE QUESTS / RECORDS; unreached story sections render "????";
+// the story tab merges the NOW-objective banner with the per-section checklist). Design + the
+// rung ladder: studies/completion-journal/MENU-DESIGN.md. Data will arrive per-deploy via
+// JournalPatch.txt (the s45 FolklorePatch.txt idiom) -- the DLL never bakes catalog content.
+//
+// M0 deliberately renders ONE static pane and nothing live: the playtest verdict must land on
+// the row swap + scene plumbing + clean return, not on list machinery. Key routing needs no
+// armed button group -- UIKeyTrigger dispatches OnKeyCancel by UIState (UIKeyTrigger.cs:646),
+// so this scene is exitable with zero interactive widgets.
+//
+// The s45 laws carried forward (each was paid for with a playtest round):
+//  * every runtime clone lives UNDER this scene's transform (the DontDestroyOnLoad tree law);
+//  * every repositioned clone gets SetAnchor(null) -- NGUI anchors re-assert every frame;
+//  * the scene GameObject is built on the UI layer by UIManager.Start (a fresh GameObject lands
+//    on layer 0, which every UI camera culls -- the s45 invisible-shell find).
+public class JournalUI : UIScene
+{
+    public override void Show(UIScene.SceneVoidDelegate afterFinished = null)
+    {
+        base.Show(afterFinished);
+    }
+
+    public override void Hide(UIScene.SceneVoidDelegate afterFinished = null)
+    {
+        base.Hide(afterFinished);
+        // THE ItemUI IDIOM (via s45): re-tween the main menu's row column back in while this
+        // scene fades -- StartSubmenuTweenIn is the ONLY thing that reopens the collapsed clip.
+        PersistenSingleton<UIManager>.Instance.MainMenuScene.StartSubmenuTweenIn();
+    }
+
+    public override Boolean OnKeyCancel(GameObject go)
+    {
+        if (base.OnKeyCancel(go))
+        {
+            FF9Sfx.FF9SFX_Play(101);
+            this.Hide(delegate
+            {
+                PersistenSingleton<UIManager>.Instance.MainMenuScene.NeedTweenAndHideSubMenu = false;
+                PersistenSingleton<UIManager>.Instance.MainMenuScene.CurrentSubMenu = MainMenuUI.SubMenu.Folklore;
+                PersistenSingleton<UIManager>.Instance.ChangeUIState(UIManager.UIState.MainMenu);
+            });
+        }
+        return true;
+    }
+
+    private void Awake()
+    {
+        // Built IN CODE from cloned stock pieces (the ControlPanel idiom; zero new Unity assets).
+        // Awake runs on the first Show -- UIManager.Start creates the GameObject INACTIVE, so the
+        // clone-source menu widgets all exist by now. UI space: center origin, +y up, 1080 tall;
+        // panes stay inside the pillarbox-safe +-771 band.
+        MainMenuUI menu = PersistenSingleton<UIManager>.Instance.MainMenuScene;
+
+        // the stock full-screen menu backdrop (MainMenuUI child 4, GOMenuBackground-sized)
+        GameObject bgGo = UnityEngine.Object.Instantiate(menu.transform.GetChild(4).gameObject);
+        bgGo.name = "Journal Background";
+        bgGo.transform.parent = base.transform;
+        bgGo.transform.localScale = Vector3.one;
+        bgGo.transform.localPosition = Vector3.zero;
+        foreach (UIWidget bgWidget in bgGo.GetComponentsInChildren<UIWidget>(true))
+            bgWidget.SetAnchor((GameObject)null);
+        UISprite bgSprite = bgGo.GetComponent<UISprite>();
+        if (bgSprite != null && bgSprite.atlas != null && bgSprite.atlas.GetSprite("item_bg") != null)
+            bgSprite.spriteName = "item_bg";               // the stock submenu backdrop flavor
+        bgGo.SetActive(true);
+
+        // the stock cross-fade (HonoFading re-derives its sprite from the clone's own object)
+        GameObject fadeGo = UnityEngine.Object.Instantiate(menu.ScreenFadeGameObject);
+        fadeGo.name = "Journal Fade";
+        fadeGo.transform.parent = base.transform;
+        fadeGo.transform.localPosition = menu.ScreenFadeGameObject.transform.localPosition;
+        fadeGo.transform.localScale = Vector3.one;
+        base.FadingComponent = fadeGo.GetComponent<HonoFading>();
+
+        // M0's one visible element: a bordered framed pane, caption JOURNAL, a static body naming
+        // what lands next -- so the playtest can SEE the scene rendered (an empty screen and a
+        // failed screen look identical).
+        UILabel caption;
+        GameObject pane = this.BuildFramedPane(menu, "Journal M0 Pane", 0f, 0f, 900f, 700f, true, out caption);
+        caption.rawText = "Journal";
+        GameObject bodyGo = UnityEngine.Object.Instantiate(menu.LocationInfoPanel.GetChild(0));
+        bodyGo.name = "Journal M0 Body";
+        bodyGo.transform.parent = pane.transform;
+        bodyGo.transform.localScale = Vector3.one;
+        bodyGo.SetActive(true);
+        UILabel body = bodyGo.GetComponent<UILabel>();
+        body.SetAnchor((GameObject)null);
+        body.pivot = UIWidget.Pivot.Top;
+        body.SetRawRect(0f, 240f, 700f, 480f);
+        body.alignment = NGUIText.Alignment.Center;
+        body.overflowMethod = UILabel.Overflow.ShrinkContent;
+        body.multiLine = true;
+        body.rawText = "M0 skeleton\n\nStory\nSide Quests\nRecords\n\n(cancel returns to the menu)";
+    }
+
+    // the s45 pane recipe, verbatim mechanics: clone GenericInfoPanel, gut it, re-anchor its
+    // FRAME child onto OUR pane rect (the ControlPanel.InstantiatePanel pattern)
+    private GameObject BuildFramedPane(MainMenuUI menu, String name, Single x, Single y, Single w, Single h, Boolean bordered, out UILabel caption)
+    {
+        GameObject paneGo = UnityEngine.Object.Instantiate(menu.GenericInfoPanel);
+        paneGo.name = name;
+        UIWidget pane = paneGo.GetComponent<UIWidget>();
+        GameObject frameGo = UnityEngine.Object.Instantiate(menu.GenericInfoPanel.GetChild(2));
+        paneGo.transform.DestroyChildren();
+        frameGo.name = name + " Frame";
+        frameGo.transform.parent = paneGo.transform;
+        frameGo.transform.localScale = Vector3.one;
+        UILocalize frameLoc = frameGo.GetComponentInChildren<UILocalize>();
+        if (frameLoc != null)
+            frameLoc.key = String.Empty;                   // the caption plate is OURS to write
+        caption = frameGo.GetComponentInChildren<UILabel>();
+        caption.fontSize = 34;
+        if (!bordered)
+        {
+            GameObject borderGo = frameGo.FindChild("Border");
+            if (borderGo != null)
+                borderGo.SetActive(false);
+            GameObject shadowGo = frameGo.FindChild("Shadow");
+            if (shadowGo != null)
+                shadowGo.SetActive(false);
+        }
+        UIWidget frame = frameGo.GetComponent<UIWidget>();
+        frame.leftAnchor.Set(pane.transform, 0f, 0);
+        frame.rightAnchor.Set(pane.transform, 1f, 0);
+        frame.topAnchor.Set(pane.transform, 1f, 0);
+        frame.bottomAnchor.Set(pane.transform, 0f, 0);
+        paneGo.transform.parent = base.transform;
+        paneGo.transform.localScale = Vector3.one;
+        pane.SetAnchor((GameObject)null);
+        pane.pivot = UIWidget.Pivot.Center;
+        pane.SetRawRect(x, y, w, h);
+        frameGo.SetActive(true);
+        paneGo.SetActive(true);
+        return paneGo;
+    }
+}
+
+// The s81 feature gate: Memoria.ini [Journal] Enabled, DEFAULT ON ("1") -- the Journal is core to
+// the Dream World IX bundle (it takes Folklore's menu seat per the owner's direction), and
+// [Journal] Enabled=0 is the off switch that also un-hides Folklore (MainMenuUI's row mint reads
+// both gates). Read once per process; the s45 FolkloreConfig idiom.
+internal static class JournalConfig
+{
+    private static Int32 _enabled = -1;
+
+    internal static Boolean Enabled
+    {
+        get
+        {
+            if (_enabled < 0)
+            {
+                try
+                {
+                    IniFile ini = new IniFile(IniFile.MemoriaIniPath);
+                    _enabled = ini.GetSetting("Journal", "Enabled", "1").Trim() == "1" ? 1 : 0;
+                }
+                catch (Exception err)
+                {
+                    Log.Error(err);
+                    _enabled = 1;                          // unreadable ini -> the bundle default
+                }
+            }
+            return _enabled > 0;
+        }
+    }
+}
