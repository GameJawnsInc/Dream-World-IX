+    // ============================ the live reads ============================
+    private static Int32 CurrentSectionIndex(List<JournalRegistry.Section> main)
+    {
+        // The next-objective ladder, the C# copy of the kit's one source (main_story_ladder):
+        // sum(SC >= enter) over the MAIN sections excluding the first, so a fresh save (SC below
+        // the first anchor) indexes row 0. ScenarioCounter is not monotonic (7 real fields
+        // decrement it) -- this is "where the story clock stands", never an N-of-M progress bar.
+        Int32 sc = FF9StateSystem.EventState.ScenarioCounter;
+        Int32 idx = 0;
+        for (Int32 i = 1; i < main.Count; i++)
+            if (sc >= main[i].Enter)
+                idx++;
+        return idx;
+    }
+
+    private void RefreshNowBanner()
+    {
+        if (this.nowLabel == null)
+            return;
+        List<JournalRegistry.Section> main = JournalRegistry.MainSections();
+        if (main.Count == 0)
+        {
+            // the registry found no JournalPatch.txt in any mod folder -- say so rather than
+            // rendering an empty banner that reads as a bug
+            this.nowLabel.rawText = "(no JournalPatch.txt in any mod folder)";
+            return;
+        }
+        // the BEAT-refined ladder: the game writes intermediate SC values inside a section
+        // (census-measured -- 1150 fires at the Alexandria shop when the ticket is declared
+        // fake), and each authored beat refines the banner without touching the section list
+        this.nowLabel.rawText = JournalRegistry.NowText(FF9StateSystem.EventState.ScenarioCounter);
+    }
+
+    private static Boolean LatchSet(Int32 bit)
+    {
+        // the collected mark: one gEventGlobal bit, the documented layout (byte = n>>3, bit =
+        // n&7) read straight off the save heap -- the SAME bit the bench's `.eb` publishes
+        return bit >= 0 && ((FF9StateSystem.EventState.gEventGlobal[bit >> 3] >> (bit & 7)) & 1) != 0;
+    }
+
+    private void RefreshDetail()
+    {
+        if (this.detailPopulator == null || this.detailListRoot == null)
+            return;
+        List<JournalRegistry.Section> main = JournalRegistry.MainSections();
+        if (main.Count == 0 || this.currentIndex >= main.Count)
+        {
+            this.detailListRoot.SetActive(false);
+            this.detailHasRows = false;
+            return;
+        }
+        Boolean reached = this.currentIndex <= CurrentSectionIndex(main);
+        JournalRegistry.Section sec = main[this.currentIndex];
+        List<JournalRegistry.Entry> entries = JournalRegistry.EntriesFor(sec.Id);
+        if (!reached || entries.Count == 0)
+        {
+            // an unreached section's checklist is a spoiler; a reached one with no authored
+            // entries yet has nothing to draw -- either way the pane HIDES rather than sitting
+            // empty (an empty sheet reads as a bug; the M1 screenshot proved it)
+            this.detailListRoot.SetActive(false);
+            this.detailHasRows = false;
+            return;
+        }
+        this.detailListRoot.SetActive(true);
+        Int32 got = 0;
+        foreach (JournalRegistry.Entry e in entries)
+            if (LatchSet(e.Latch))
+                got++;
+        if (this.detailHeaderLabel != null)
+            this.detailHeaderLabel.rawText = $"{sec.Title}  --  {got}/{entries.Count}";
+        List<ListDataTypeBase> data = new List<ListDataTypeBase>();
+        foreach (JournalRegistry.Entry e in entries)
+            data.Add(new JournalEntryData { Entry = e });
+        try
+        {
+            if (this.detailPopulator.ItemsPool.Count == 0)
+            {
+                this.detailPopulator.PopulateListItemWithData = this.PopulateDetailCell;
+                this.detailPopulator.OnRecycleListItemClick += this.OnListItemClick;   // same chain
+            }
+            this.detailPopulator.InitTableView(data, 0);
+            this.detailHasRows = true;
+        }
+        catch (Exception err)
+        {
+            Log.Error(err);
+            this.detailHasRows = false;
+        }
+    }
+
+    private void PopulateDetailCell(Transform item, ListDataTypeBase data, Int32 index, Boolean isInit)
+    {
+        JournalEntryData row = (JournalEntryData)data;
+        JournalRegistry.Entry e = row.Entry;
+        Boolean got = LatchSet(e.Latch);
+        if (isInit)
+            this.DisplayWindowBackground(item.gameObject, null);
+        // LAW 5, runtime name resolution: the catalog ships only the unified item id and
+        // ETb.GetItemName reads the LIVE tables (regular/important/card, ETb.cs:237-246) -- a
+        // Moguri rename renders the Moguri name. A gil reward is literal; a titled row is ours.
+        String name = e.Item >= 0 ? ETb.GetItemName(e.Item)
+                    : e.Gil >= 0 ? $"{e.Gil} Gil"
+                    : e.Title;
+        if (String.IsNullOrEmpty(name))
+            name = e.Id;                                   // never a blank row; the id names the bug
+        UILabel nameLabel = item.GetChild(0).GetComponent<UILabel>();
+        GameObject newIconGo = item.GetChild(1).gameObject;
+        newIconGo.SetActive(false);
+        nameLabel.gameObject.SetActive(true);
+        nameLabel.rawText = (got ? "OK  " : "--  ") + name;
+        nameLabel.color = got ? FF9TextTool.White : FF9TextTool.Gray;
+        // the locator prose rides the stock help bubble on cursor rest (HelpDetail.Text takes
+        // raw text) -- the walkthrough's own words, shown only inside the checklist
+        ButtonGroupState button = item.GetComponent<ButtonGroupState>();
+        if (button != null)
+            button.Help = new ButtonGroupState.HelpDetail
+            {
+                Enable = !String.IsNullOrEmpty(e.Detail),
+                Text = e.Detail,
+                Tail = true,
+            };
+    }
