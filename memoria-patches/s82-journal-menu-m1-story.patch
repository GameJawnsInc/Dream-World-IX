+    private void PopulateListCell(Transform item, ListDataTypeBase data, Int32 index, Boolean isInit)
+    {
+        JournalSectionData row = (JournalSectionData)data;
+        List<JournalRegistry.Section> main = JournalRegistry.MainSections();
+        Int32 curIdx = main.Count > 0 ? CurrentSectionIndex(main) : 0;
+        // The ratified spoiler policy: a section PAST where the story clock stands renders "????"
+        // -- a first playthrough discovers the walkthrough as it goes. The rows and the ladder
+        // index the SAME sorted list, so position against the ladder index IS the reached test
+        // (and row 0 is always reached: a fresh save is standing in it).
+        Boolean reached = index <= curIdx;
+        Boolean current = index == curIdx;
+        if (isInit)
+            this.DisplayWindowBackground(item.gameObject, null);   // the row wears the CURRENT
+        ButtonGroupState button = item.GetComponent<ButtonGroupState>();   // grey/blue window atlas
+        if (button != null && button.Help != null)
+            button.Help.Enable = false;
+        UILabel nameLabel = item.GetChild(0).GetComponent<UILabel>();
+        // the KeyItemDetailHUD cell: child 1 = the New!-icon pair -- the Journal repurposes NOTHING
+        // there in M1; keep it off
+        GameObject newIconGo = item.GetChild(1).gameObject;
+        newIconGo.SetActive(false);
+        nameLabel.gameObject.SetActive(true);
+        nameLabel.rawText = reached ? row.Section.Title : "????";
+        nameLabel.color = current ? FF9TextTool.Yellow : (reached ? FF9TextTool.White : FF9TextTool.Gray);
+    }
