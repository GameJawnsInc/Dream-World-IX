+// The mod-shipped Journal catalog: each mod folder may carry a root-level `JournalPatch.txt`
+// (JSON; the FolklorePatch/DictionaryPatch idiom -- read via TryFindAssetInModOnDisc, low->high,
+// a higher folder's copy REPLACES the whole document: the catalog is one coherent unit, never a
+// per-id merge). Emitted by the kit from data/journal_catalog.toml at every deploy
+// (ff9mapkit.journalcatalog.render_patch), so the DLL never bakes catalog content.
+public static class JournalRegistry
+{
+    public const String PatchPath = "JournalPatch.txt";
+
+    public class Section
+    {
+        public String Id;
+        public Int32 Disc;
+        public String Title;
+        public String Objective;
+        public Int32 Enter;
+        public Int32 Leave;
+        public Boolean Side;
+    }
+
+    private static List<Section> _sections;
+    private static Boolean _loaded;
+
+    private static void EnsureLoaded()
+    {
+        if (_loaded)
+            return;
+        _loaded = true;
+        _sections = new List<Section>();
+        foreach (AssetManager.AssetFolder folder in AssetManager.FolderLowToHigh)
+        {
+            if (String.IsNullOrEmpty(folder.FolderPath))
+                continue;                                  // patches load from MOD folders only
+            try
+            {
+                if (!folder.TryFindAssetInModOnDisc(PatchPath, out String path))
+                    continue;
+                // TAB-separated records (journalcatalog.render_patch): `S id disc enter leave
+                // side title objective` -- NOT JSON, because this Unity-5.2 Mono profile throws
+                // TypeLoadException the moment a method referencing Newtonsoft's types is JITted
+                // (measured in-game 2026-08-26, Memoria.log). Prose rides the LAST columns;
+                // `-` is the absent sentinel.
+                List<Section> parsed = new List<Section>();
+                foreach (String raw in File.ReadAllLines(path))
+                {
+                    if (raw.Length == 0 || raw[0] == '#' || raw[0] != 'S')
+                        continue;                          // M1 consumes section records only
+                    String[] tok = raw.Split('	');
+                    if (tok.Length < 8 || tok[0] != "S")
+                        continue;
+                    if (!Int32.TryParse(tok[2], out Int32 disc) || !Int32.TryParse(tok[3], out Int32 enter)
+                        || !Int32.TryParse(tok[4], out Int32 leave))
+                    {
+                        Log.Warning($"[JournalRegistry] bad section line in {path}: '{raw}'");
+                        continue;
+                    }
+                    parsed.Add(new Section
+                    {
+                        Id = tok[1],
+                        Disc = disc,
+                        Enter = enter,
+                        Leave = leave,
+                        Side = tok[5] == "1",
+                        Title = tok[6] == "-" ? String.Empty : tok[6],
+                        Objective = tok[7] == "-" ? String.Empty : tok[7],
+                    });
+                }
+                if (parsed.Count > 0)
+                    _sections = parsed;                    // whole-document replace, low->high
+            }
+            catch (Exception err)
+            {
+                Log.Error(err);                            // per-FOLDER isolation: one unreadable
+            }                                              // file must not half-load the registry
+        }
+        if (_sections.Count > 0)
+            Log.Message($"[JournalRegistry] {_sections.Count} sections registered");
+    }
+
+    public static List<Section> MainSections()
+    {
+        EnsureLoaded();
+        List<Section> main = new List<Section>();
+        foreach (Section s in _sections)
+            if (!s.Side)
+                main.Add(s);
+        main.Sort((a, b) => a.Enter.CompareTo(b.Enter));
+        return main;
+    }
 }
 
