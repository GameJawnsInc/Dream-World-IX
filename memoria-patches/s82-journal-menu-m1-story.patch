+    private static Int32 CurrentSectionIndex(List<JournalRegistry.Section> main)
+    {
+        // The next-objective ladder, the C# copy of the kit's one source (main_story_ladder):
+        // sum(SC >= enter) over the MAIN sections excluding the first, so a fresh save (SC below
+        // the first anchor) indexes row 0. ScenarioCounter is not monotonic (7 real fields
+        // decrement it) -- this is "where the story clock stands", never an N-of-M progress bar.
+        Int32 sc = FF9StateSystem.EventState.ScenarioCounter;
+        Int32 idx = 0;
+        for (Int32 i = 1; i < main.Count; i++)
+            if (sc >= main[i].Enter)
+                idx++;
+        return idx;
+    }
