+    private void RefreshSectionList()
+    {
+        if (this.listPopulator == null)
+            return;
+        List<JournalRegistry.Section> main = JournalRegistry.MainSections();
+        List<ListDataTypeBase> data = new List<ListDataTypeBase>();
+        foreach (JournalRegistry.Section s in main)
+            data.Add(new JournalSectionData { Section = s });
+        this.currentIndex = main.Count > 0 ? CurrentSectionIndex(main) : 0;
+        try
+        {
+            if (data.Count > 0)
+            {
+                if (this.listPopulator.ItemsPool.Count == 0)
+                {
+                    this.listPopulator.PopulateListItemWithData = this.PopulateListCell;
+                    // a cell CLICK routes through the stock chain (RecycleListItem.OnClick ->
+                    // itemClicked -> this delegate -> UIScene.OnListItemClick -> onPress ->
+                    // OnKeyConfirm) -- without this line the mouse can hover but never confirm
+                    // (the M2 playtest find: "clicking a Story row doesn't move focus")
+                    this.listPopulator.OnRecycleListItemClick += this.OnListItemClick;
+                    this.listPopulator.InitTableView(data, this.currentIndex);
+                }
+                else
+                {
+                    this.listPopulator.InitTableView(data, this.currentIndex);
+                }
+            }
+        }
+        catch (Exception err)
+        {
+            Log.Error(err);                                // a journal glitch must never brick the
+        }                                                  // whole menu until restart (s45 round 1)
+    }
