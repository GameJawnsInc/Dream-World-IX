+// The mod-shipped Journal catalog: each mod folder may carry a root-level `JournalPatch.txt`
+// (JSON; the FolklorePatch/DictionaryPatch idiom -- read via TryFindAssetInModOnDisc, low->high,
+// a higher folder's copy REPLACES the whole document: the catalog is one coherent unit, never a
+// per-id merge). Emitted by the kit from data/journal_catalog.toml at every deploy
+// (ff9mapkit.journalcatalog.render_patch), so the DLL never bakes catalog content.
+public static class JournalRegistry
+{
+    public const String PatchPath = "JournalPatch.txt";
+
+    public class Section
+    {
+        public String Id;
+        public Int32 Disc;
+        public String Title;
+        public String Objective;
+        public Int32 Enter;
+        public Int32 Leave;
+        public Boolean Side;
+    }
+
+    public class Entry
+    {
+        public String Id;
+        public String SectionId;
+        public String Category;
+        public Int32 Latch = -1;                           // -1 = absent (the `-` sentinel)
+        public Int32 Item = -1;                            // unified item id (LAW 5: name resolves live)
+        public Int32 Gil = -1;
+        public Int32 Th;
+        public String Verify;
+        public String Title;
+        public String Detail;
+    }
+
+    private static List<Section> _sections;
+    private static List<Entry> _entries;
+    private static List<KeyValuePair<Int32, String>> _beats;   // (enter, objective), B records
+    private static Boolean _loaded;
+
+    private static void EnsureLoaded()
+    {
+        if (_loaded)
+            return;
+        _loaded = true;
+        _sections = new List<Section>();
+        foreach (AssetManager.AssetFolder folder in AssetManager.FolderLowToHigh)
+        {
+            if (String.IsNullOrEmpty(folder.FolderPath))
+                continue;                                  // patches load from MOD folders only
+            try
+            {
+                if (!folder.TryFindAssetInModOnDisc(PatchPath, out String path))
+                    continue;
+                // TAB-separated records (journalcatalog.render_patch): `S id disc enter leave
+                // side title objective` -- NOT JSON, because this Unity-5.2 Mono profile throws
+                // TypeLoadException the moment a method referencing Newtonsoft's types is JITted
+                // (measured in-game 2026-08-26, Memoria.log). Prose rides the LAST columns;
+                // `-` is the absent sentinel.
+                List<Section> parsed = new List<Section>();
+                List<Entry> parsedEntries = new List<Entry>();
+                List<KeyValuePair<Int32, String>> parsedBeats = new List<KeyValuePair<Int32, String>>();
+                foreach (String raw in File.ReadAllLines(path))
+                {
+                    if (raw.Length == 0 || raw[0] == '#')
+                        continue;
+                    String[] tok = raw.Split('	');
+                    if (tok[0] == "S" && tok.Length >= 8)
+                    {
+                        if (!Int32.TryParse(tok[2], out Int32 disc) || !Int32.TryParse(tok[3], out Int32 enter)
+                            || !Int32.TryParse(tok[4], out Int32 leave))
+                        {
+                            Log.Warning($"[JournalRegistry] bad section line in {path}: '{raw}'");
+                            continue;
+                        }
+                        parsed.Add(new Section
+                        {
+                            Id = tok[1],
+                            Disc = disc,
+                            Enter = enter,
+                            Leave = leave,
+                            Side = tok[5] == "1",
+                            Title = tok[6] == "-" ? String.Empty : tok[6],
+                            Objective = tok[7] == "-" ? String.Empty : tok[7],
+                        });
+                    }
+                    else if (tok[0] == "E" && tok.Length >= 18)
+                    {
+                        // E id section category latch win_on win_off inventory counter manual
+                        //   item gil th miss_close miss_conf verify title detail
+                        Entry e = new Entry
+                        {
+                            Id = tok[1],
+                            SectionId = tok[2],
+                            Category = tok[3],
+                            Verify = tok[15],
+                            Title = tok[16] == "-" ? String.Empty : tok[16],
+                            Detail = tok[17] == "-" ? String.Empty : tok[17],
+                        };
+                        if (Int32.TryParse(tok[4], out Int32 latch))
+                            e.Latch = latch;
+                        if (Int32.TryParse(tok[10], out Int32 itemId))
+                            e.Item = itemId;
+                        if (Int32.TryParse(tok[11], out Int32 gil))
+                            e.Gil = gil;
+                        if (Int32.TryParse(tok[12], out Int32 th))
+                            e.Th = th;
+                        parsedEntries.Add(e);
+                    }
+                    else if (tok[0] == "B" && tok.Length >= 4)
+                    {
+                        // B section enter objective -- a WITHIN-section beat: the game's own
+                        // intermediate SC write (census-measured), refining the NOW banner
+                        if (Int32.TryParse(tok[2], out Int32 bEnter) && tok[3] != "-")
+                            parsedBeats.Add(new KeyValuePair<Int32, String>(bEnter, tok[3]));
+                    }
+                }
+                if (parsed.Count > 0)
+                {
+                    _sections = parsed;                    // whole-document replace, low->high
+                    _entries = parsedEntries;              // entries travel WITH their sections
+                    _beats = parsedBeats;                  // and so do the beats
+                }
+            }
+            catch (Exception err)
+            {
+                Log.Error(err);                            // per-FOLDER isolation: one unreadable
+            }                                              // file must not half-load the registry
+        }
+        if (_sections.Count > 0)
+            Log.Message($"[JournalRegistry] {_sections.Count} sections registered");
+    }
+
+    public static String NowText(Int32 scenarioCounter)
+    {
+        // The NEXT-OBJECTIVE text: the deepest rung of the flat (sections + beats) ladder at or
+        // below SC -- the same fold the kit's main_story_ladder() computes for the offline report
+        // and the bench .eb, so all three surfaces answer identically. The first rung is the
+        // floor (a fresh save, SC below the first anchor, reads rung 0).
+        EnsureLoaded();
+        List<Section> main = MainSections();
+        if (main.Count == 0)
+            return "(no JournalPatch.txt in any mod folder)";
+        List<KeyValuePair<Int32, String>> ladder = new List<KeyValuePair<Int32, String>>();
+        foreach (Section s in main)
+            ladder.Add(new KeyValuePair<Int32, String>(s.Enter,
+                String.IsNullOrEmpty(s.Objective) ? s.Title : s.Objective));
+        if (_beats != null)
+            ladder.AddRange(_beats);
+        ladder.Sort((a, b) => a.Key.CompareTo(b.Key));
+        Int32 idx = 0;
+        for (Int32 i = 1; i < ladder.Count; i++)
+            if (scenarioCounter >= ladder[i].Key)
+                idx = i;
+        return ladder[idx].Value;
+    }
+
+    public static List<Entry> EntriesFor(String sectionId)
+    {
+        EnsureLoaded();
+        List<Entry> outList = new List<Entry>();
+        if (_entries != null)
+            foreach (Entry e in _entries)
+                if (e.SectionId == sectionId)
+                    outList.Add(e);                        // authored (walkthrough) order preserved
+        return outList;
+    }
+
+    public static List<Section> MainSections()
+    {
+        EnsureLoaded();
+        List<Section> main = new List<Section>();
+        foreach (Section s in _sections)
+            if (!s.Side)
+                main.Add(s);
+        main.Sort((a, b) => a.Enter.CompareTo(b.Enter));
+        return main;
+    }
 }
 
