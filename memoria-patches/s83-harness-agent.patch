+        /// <summary>Close the game the way the game closes itself.</summary>
+        /// <remarks>
+        /// ⚠ `Application.Quit()` DOES NOT QUIT THIS GAME. `UIKeyTrigger.OnApplicationQuit` calls
+        /// `Application.CancelQuit()` unless its private `quitConfirm` is set, and instead pops the
+        /// in-game "really quit?" dialog -- which, in a harness run, nobody answers. Diagnosed from a
+        /// live run: the `quit` step was accepted, executed and ACKED at frame 842, and the agent was
+        /// still publishing 900 frames later. The driver then waited out its budget and hard-killed
+        /// the process, every single run.
+        ///
+        /// `ConfirmQuit()` is the game's own path: it sets quitConfirm, broadcasts "OnQuit" so the
+        /// subsystems can stand down, and only then quits -- reaching the branch that actually closes
+        /// the window. Falling back to a bare Quit() is deliberate: on a screen with no UIKeyTrigger
+        /// there is nothing to cancel the quit either, so it works there.
+        /// </remarks>
+        private static void Quit()
+        {
+            try
+            {
+                UIKeyTrigger trigger = UnityEngine.Object.FindObjectOfType<UIKeyTrigger>();
+                if (trigger != null)
+                {
+                    trigger.ConfirmQuit();
+                    return;
+                }
+            }
+            catch (Exception err)
+            {
+                Memoria.Prime.Log.Message("[ff9mk harness] ConfirmQuit failed, falling back: " + err);
+            }
+            Application.Quit();
+        }
+
+        private void Block(Int32 frames)
+        {
+            Int32 until = Time.frameCount + Math.Max(0, frames);
+            if (until > _blockUntilFrame)
+                _blockUntilFrame = until;
+        }
+
+        // Schedule a virtual press starting NEXT frame -- see the FRAME MODEL note at the top of the file.
+        private static Int32 Index(Control c)
+        {
+            Int32 i = (Int32)c;
+            if (i < 0 || i >= ControlCount)
+                throw new ArgumentOutOfRangeException("button");
+            return i;
+        }
+
+        private static void Schedule(Control c, Int32 frames)
+        {
+            Int32 i = Index(c);
+            _downFrame[i] = Time.frameCount + 1;
+            _upFrame[i] = _downFrame[i] + frames;
+        }
+
+        /// <summary>Hold a button, LENGTHENING a hold already in progress instead of restarting it.</summary>
+        /// <remarks>
+        /// ⚠ RE-ISSUING A HOLD USED TO DROP THE BUTTON FOR EXACTLY ONE FRAME, and that hole is why
+        /// this harness could not run away from a fight. Schedule sets _downFrame = frameCount + 1,
+        /// so on the frame the second hold arrives IsHeld is false -- an invisible up/down edge in
+        /// the middle of what the driver believes is one continuous press. Nothing that SAMPLES the
+        /// button notices; anything counting CONTINUOUS held time restarts from zero.
+        ///
+        /// BattleHUD.Update accumulates _runCounter while both bumpers are down and only calls
+        /// btl_sys.CheckEscape(TRUE) -- the call that actually rolls -- once it passes 1.0 REAL
+        /// seconds, resetting to zero the instant either bumper lifts. The driver re-issued its hold
+        /// every 0.8s, so the counter never reached 1.0 and the escape NEVER ROLLED ONCE, while
+        /// btl_escape_key (set before the counter is even tested) kept the character running on
+        /// screen throughout. Owner-observed as "the flee animation for a couple of seconds but he
+        /// didn't actually leave". The failure was then written up as an ATB deadlock. It was this.
+        ///
+        /// Extending never shortens a hold in progress, so overlapping requests compose: the button
+        /// is down from the first request until the last one's window ends, with no seam.
+        /// </remarks>
+        private static void Extend(Control c, Int32 frames)
+        {
+            Int32 i = Index(c);
+            Int32 f = Time.frameCount;
+            if (f >= _downFrame[i] && f < _upFrame[i])
+                _upFrame[i] = Math.Max(_upFrame[i], f + frames);
+            else
+            {
+                _downFrame[i] = f + 1;
+                _upFrame[i] = _downFrame[i] + frames;
+            }
+        }
+
+        private static Int32 Arg(Step s, Int32 i, Int32 fallback)
+        {
+            Int32 v;
+            if (s.Args.Length > i && Int32.TryParse(s.Args[i], NumberStyles.Integer, CultureInfo.InvariantCulture, out v))
+                return v;
+            return fallback;
+        }
+
+        private static Single ArgF(Step s, Int32 i, Single fallback)
+        {
+            Single v;
+            if (s.Args.Length > i && Single.TryParse(s.Args[i], NumberStyles.Float, CultureInfo.InvariantCulture, out v))
+                return v;
+            return fallback;
+        }
+
+        // Accepts the Control enum names plus the aliases a human (or a scenario author) actually types.
+        private static Control ParseControl(String name)
+        {
+            switch ((name ?? "").ToLowerInvariant())
+            {
+                case "confirm": case "ok": case "x": case "circle": case "a": return Control.Confirm;
+                case "cancel": case "back": case "b": return Control.Cancel;
+                case "menu": case "triangle": case "y": return Control.Menu;
+                case "special": case "square": return Control.Special;
+                case "l1": case "leftbumper": return Control.LeftBumper;
+                case "r1": case "rightbumper": return Control.RightBumper;
+                case "l2": case "lefttrigger": return Control.LeftTrigger;
+                case "r2": case "righttrigger": return Control.RightTrigger;
+                case "start": case "pause": return Control.Pause;
+                case "select": return Control.Select;
+                case "up": case "north": return Control.Up;
+                case "down": case "south": return Control.Down;
+                case "left": case "west": return Control.Left;
+                case "right": case "east": return Control.Right;
+                default: throw new ArgumentException("unknown button '" + name + "'");
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // Screenshots. ReadPixels at end-of-frame rather than Application.CaptureScreenshot: the latter
+        // is fire-and-forget with an engine-chosen path, so the driver can never know WHEN the file is
+        // complete. This version owns the path and decrements _shotsPending only once the bytes are on
+        // disk, which is what lets DrainQueue hold the ack until every frame is actually captured.
+        //
+        // It also beats the external PrintWindow capture on two counts: it needs no window focus and it
+        // cannot return the all-black frame that exclusive fullscreen gives game_snap.ps1.
+        // ------------------------------------------------------------------------------------------
+        private IEnumerator CaptureShot(String name)
+        {
+            yield return new WaitForEndOfFrame();
+            String path = null;
+            try
+            {
+                Texture2D tex = new Texture2D(Screen.width, Screen.height, TextureFormat.RGB24, false);
+                tex.ReadPixels(new Rect(0f, 0f, Screen.width, Screen.height), 0, 0, false);
+                tex.Apply();
+                Byte[] png = tex.EncodeToPNG();
+                UnityEngine.Object.Destroy(tex);
+                path = Path.Combine(_shotDir, Sanitize(name) + ".png");
+                File.WriteAllBytes(path, png);
+                _shotsTaken++;
+                Event("shot", "name", name, "path", path, "w", Screen.width.ToString(CultureInfo.InvariantCulture), "h", Screen.height.ToString(CultureInfo.InvariantCulture));
+            }
+            catch (Exception err)
+            {
+                _lastError = "shot: " + err.Message;
+                _errorSeq = _seq;
+                Event("error", "op", "shot", "message", err.Message);
+            }
+            _shotsPending = Math.Max(0, _shotsPending - 1);
+        }
+
+        private static String Sanitize(String name)
+        {
+            StringBuilder sb = new StringBuilder();
+            foreach (Char c in name ?? "shot")
+                sb.Append(Char.IsLetterOrDigit(c) || c == '-' || c == '_' || c == '.' ? c : '_');
+            return sb.Length == 0 ? "shot" : sb.ToString();
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // state.json -- what the driver asserts against. EVERY read is individually try/caught and
+        // degrades to null: this file is sampled at the title screen, mid-transition and mid-battle,
