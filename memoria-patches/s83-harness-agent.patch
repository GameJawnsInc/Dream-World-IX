+            Num(sb, "id", Try(() => (Int32)FF9StateSystem.Common.FF9.wldMapNo, -1)); sb.Append(",");
+            Num(sb, "x", Try(() => ff9.w_moveActorPtr.RealPosition.x, Single.NaN)); sb.Append(",");
+            Num(sb, "z", Try(() => ff9.w_moveActorPtr.RealPosition.z, Single.NaN)); sb.Append(",");
+            Num(sb, "vehicle", Try(() => (Int32)FF9StateSystem.EventState.gEventGlobal[190], -1));
