+            // the two produce an identical silence on the driver side, and the driver used to guess.
+            Bool(sb, "armed", Active); sb.Append(",");
+            Bool(sb, "faulted", _faulted); sb.Append(",");
+            Str(sb, "note", _note); sb.Append(",");
+            Str(sb, "error", _lastError); sb.Append(",");
+            Num(sb, "error_seq", _errorSeq); sb.Append(",");
