+        // Undo anything the `netsync` verbs did to THIS process. Runs on disarm, fault and `reset`:
+        // the selftest override is process-local, so a leaked run must not leave a ghost beside the
+        // next player, a bench gate swallowing their chest, or an L1 pin holding their control. A
+        // session the harness did NOT force (a human's own ini-configured selftest) is left alone.
+        private static void ReleaseNetsyncOverride()
+        {
+            try
+            {
+                String why;
+                Memoria.Netsync.NetSyncClient.HarnessSelfTest(false, out why);
+            }
+            catch (Exception err)
+            {
+                Memoria.Prime.Log.Message("[ff9mk harness] netsync release failed: " + err.Message);
+            }
+        }
