+        /// <summary>What the box actually draws, falling back to the source when no parser exists yet.</summary>
+        private static String Rendered(Dialog d)
+        {
+            if (d == null)
+                return null;
+            try
+            {
+                if (d.CurrentParser != null && !String.IsNullOrEmpty(d.CurrentParser.ParsedText))
+                    return d.CurrentParser.ParsedText;
+            }
+            catch (Exception)
+            {
+            }
+            return d.Phrase;
+        }
+
+        // WHAT IS HIGHLIGHTED. Without this a scenario can move a menu cursor but has no idea where it
