+            Num(sb, "y", po != null && po.pos != null && po.pos.Length > 1 ? po.pos[1] : Single.NaN); sb.Append(",");
+            Num(sb, "z", po != null && po.pos != null && po.pos.Length > 2 ? po.pos[2] : Single.NaN); sb.Append(",");
+            Num(sb, "dir", po != null && po.rot != null && po.rot.Length > 1 ? po.rot[1] : -1); sb.Append(",");
+            Num(sb, "floor", po != null ? po.activeFloor : -1); sb.Append(",");
+            Num(sb, "tri", po != null ? po.activeTri : -1); sb.Append(",");
