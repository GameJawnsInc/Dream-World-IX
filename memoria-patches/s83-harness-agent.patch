+                // driver saw a perfectly healthy-looking state and reported "steps were not
+                // acknowledged", blaming the game for the agent's own crash.
+                _lastError = err.Message;
+                _errorSeq = _seq;
+                _faulted = true;
+                Active = false;
+                ClearAllButtons();
+                Time.timeScale = 1f;
+                try { RedirectSaves(false); } catch (Exception) { }
+                try { PublishState(true); } catch (Exception) { }
+                Memoria.Prime.Log.Message("[ff9mk harness] FAULTED and disarmed: " + err);
+            }
+        }
+
+        // The arm file is POLLED rather than read once, so a run can arm or disarm a LIVE game with no
+        // relaunch. Twice a second is far below noise -- File.Exists on a warm directory is microseconds.
+        private void PollArm()
+        {
+            EnsurePaths();
+            if (Time.frameCount - _armPollFrame < 30)
+                return;
+            _armPollFrame = Time.frameCount;
+
+            Boolean armed = File.Exists(Path.Combine(_dir, "arm"));
+            if (armed == Active)
+                return;
+
+            // A FAULTED agent does not come back on its own. Re-arming here would be a silent
+            // self-heal that erases the diagnosis; the driver must disarm and re-arm deliberately.
+            if (armed && _faulted)
+                return;
+
+            Active = armed;
+            _queue.Clear();
+            ClearAllButtons();
+            if (armed)
+            {
+                Directory.CreateDirectory(_shotDir);
+                _seq = -1;
+                _ack = -1;
+                _errorSeq = -1;
+                _pendingAck = false;
+                _blockUntilFrame = 0;
+                _lastError = null;
+                _shotsTaken = 0;
+                _shotsPending = 0;
+                // Per-run scratch that used to survive a re-arm. A stale watch list keeps publishing
+                // the previous run's bits, and a stale note mislabels this run's events.
+                _watch.Clear();
+                _note = "";
+                _stateEvery = 2;
+                Time.timeScale = 1f;
+                RedirectSaves(true);
+                Event("armed", "protocol", ProtocolVersion.ToString(CultureInfo.InvariantCulture));
+                Memoria.Prime.Log.Message("[ff9mk harness] ARMED -- channel at " + _dir);
+            }
+            else
+            {
+                // PUBLISH ONE LAST DOCUMENT SAYING SO. Otherwise the file left on disk describes a
+                // live game, and "disarmed", "hung" and "merely slow" are indistinguishable to the
+                // driver -- which is how a healthy game got reported as hung.
+                Time.timeScale = 1f;
+                RedirectSaves(false);
+                Event("disarmed");
+                // Active is already false here, which is the point: this final document publishes
+                // "armed": false. Forcing it true to "make the publish work" would have made the one
+                // signal that distinguishes a clean stand-down from a hang say the opposite.
+                try { PublishState(true); } catch (Exception) { }
+                Memoria.Prime.Log.Message("[ff9mk harness] disarmed");
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // THE SAVE SANDBOX. While armed, the game's save containers live in the channel directory
+        // instead of the player's save folder.
+        //
+        // WHY, MEASURED RATHER THAN ASSUMED: `EventEngine` autosaves on ordinary field entry, gated
+        // only by `Configuration.SaveFile.DisableAutoSave` (0 on this install). A scenario's opening
+        // is `newgame()` then `warp()`, so every harness run was stamping a scenario-zero autosave
+        // over the player's file. Confirmed in-game on 2026-08-31 -- both SavedData_ww.dat and
+        // SavedData_ww_Memoria_Autosave.dat changed across a single run
+        // (studies/test-harness/scenarios/save_untouched.py). Manual slots were untouched; the
+        // autosave was not.
+        //
+        // Redirecting FilePath moves BOTH containers, because the Memoria sidecar path is derived
+        // from it (MetaData.GetMemoriaExtraSaveFilePath). The sandbox starts EMPTY, which is a
+        // second benefit: an armed run cannot accidentally load, and therefore cannot accidentally
+        // resave, the player's game.
+        //
+        // The path is PUBLISHED in state.json so the driver can VERIFY the redirect instead of
+        // trusting it. A sandbox nobody checked is a check that cannot fail.
+        private static void RedirectSaves(Boolean on)
+        {
+            try
+            {
+                if (on)
+                {
+                    if (_saveRedirected)
+                        return;
+                    String real = SharedDataBytesStorage.MetaData.FilePath;
+                    if (String.IsNullOrEmpty(real))
+                        return;                 // paths not resolved yet; the next arm will catch it
+                    _realSaveFilePath = real;
+                    _realSaveDirPath = SharedDataBytesStorage.MetaData.DirPath;
+                    Directory.CreateDirectory(_saveDir);
+                    SharedDataBytesStorage.MetaData.DirPath = _saveDir;
+                    SharedDataBytesStorage.MetaData.FilePath =
+                        Path.Combine(_saveDir, Path.GetFileName(real));
+                    _saveRedirected = true;
+                    Memoria.Prime.Log.Message("[ff9mk harness] saves sandboxed to " + _saveDir
+                                              + " (real: " + _realSaveDirPath + ")");
+                }
+                else
+                {
+                    if (!_saveRedirected)
+                        return;
+                    SharedDataBytesStorage.MetaData.FilePath = _realSaveFilePath;
+                    SharedDataBytesStorage.MetaData.DirPath = _realSaveDirPath;
+                    _saveRedirected = false;
+                    Memoria.Prime.Log.Message("[ff9mk harness] saves restored to " + _realSaveDirPath);
+                }
+            }
+            catch (Exception err)
+            {
+                // A failed redirect must not be silent -- it means the next autosave lands on the
+                // player's file, which is the entire thing this exists to prevent.
+                Memoria.Prime.Log.Message("[ff9mk harness] SAVE SANDBOX FAILED: " + err);
+            }
+        }
+
+        private static void ClearAllButtons()
+        {
+            for (Int32 i = 0; i < ControlCount; i++)
+            {
+                _downFrame[i] = -1;
+                _upFrame[i] = -1;
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // req.txt -- a line-oriented text protocol, deliberately NOT JSON. The game side needs no JSON
+        // parser (Assembly-CSharp bundles none, and hand-rolling one inside the frame loop is a bug
+        // farm); the driver side needs three lines of Python to emit it. State comes BACK as JSON,
+        // where the asymmetry reverses: C# writes it with a StringBuilder, Python reads it for free.
+        //
+        // The first line must be `seq <n>`. A request whose seq is not GREATER than the last accepted
+        // one is ignored, which makes the read idempotent: the driver writes the file once and we may
+        // poll it any number of times, including while it is mid-rewrite.
+        // ------------------------------------------------------------------------------------------
+        private void PollRequest()
+        {
+            // Poll hard while idle (latency between steps is the driver's round-trip cost), gently
+            // while a queue is already running.
+            Int32 every = _queue.Count == 0 ? 2 : 10;
+            if (Time.frameCount - _reqPollFrame < every)
+                return;
+            _reqPollFrame = Time.frameCount;
+
+            String path = Path.Combine(_dir, "req.txt");
+            if (!File.Exists(path))
+                return;
+
+            String[] lines;
+            try
+            {
+                lines = File.ReadAllLines(path);
+            }
+            catch (IOException)
+            {
+                return;     // mid-write by the driver; the next poll gets it
+            }
+            if (lines.Length == 0)
+                return;
+
+            Int64 seq;
+            String[] head = Split(lines[0]);
+            if (head.Length < 2 || head[0] != "seq" || !Int64.TryParse(head[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out seq))
+                return;
+            if (seq <= _seq)
+                return;
+
+            _seq = seq;
+            // Per-REQUEST, not per-run: see the _errorSeq comment. The driver can then attribute a
+            // refusal to the step that caused it instead of to whatever ran next.
+            _lastError = null;
+            Int32 added = 0;
+            for (Int32 i = 1; i < lines.Length; i++)
+            {
+                String[] tok = Split(lines[i]);
+                if (tok.Length == 0 || tok[0].StartsWith("#"))
+                    continue;
+                String[] args = new String[tok.Length - 1];
+                Array.Copy(tok, 1, args, 0, args.Length);
+                _queue.Enqueue(new Step { Op = tok[0].ToLowerInvariant(), Args = args });
+                added++;
+            }
+            _pendingAck = true;
+            Event("accepted", "seq", seq.ToString(CultureInfo.InvariantCulture), "steps", added.ToString(CultureInfo.InvariantCulture));
+        }
+
+        private static String[] Split(String line)
+        {
+            if (String.IsNullOrEmpty(line))
+                return new String[0];
+            return line.Trim().Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
+        }
+
+        private void DrainQueue()
+        {
+            while (_queue.Count > 0 && Time.frameCount >= _blockUntilFrame)
+            {
+                Step s = _queue.Dequeue();
+                try
+                {
+                    Execute(s);
+                }
+                catch (Exception err)
+                {
+                    _lastError = s.Op + ": " + err.Message;
+                    _errorSeq = _seq;
+                    Event("error", "op", s.Op, "message", err.Message);
+                }
+            }
+            // The ack must be latched on PERSISTENT state, not on "was the queue busy at the top of
+            // THIS tick". When the final step blocks -- which is almost all of them: press, wait, warp,
+            // shot -- the queue empties on the frame it is dequeued but the block has not elapsed, and
+            // by the next frame a frame-local "was busy" is already false. That loses the ack forever
+            // and every command hangs until the driver's timeout. Caught by the offline stand-in
+            // (ff9mapkit/tests/test_harness.py) before it ever cost a game launch.
+            if (_pendingAck && _queue.Count == 0 && Time.frameCount >= _blockUntilFrame && _shotsPending == 0)
+            {
+                _pendingAck = false;
+                _ack = _seq;
+                Event("ack", "seq", _ack.ToString(CultureInfo.InvariantCulture));
+                PublishState(true);
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // The verbs. `press` BLOCKS for its own duration (tap-then-continue is the 99% case); `hold`
+        // does NOT (so a scenario can walk and act in the same breath) -- the explicit sync is `wait`.
+        // Everything else is instantaneous.
+        // ------------------------------------------------------------------------------------------
+        private void Execute(Step s)
+        {
+            switch (s.Op)
+            {
+                case "wait":
+                    Block(Arg(s, 0, 1));
+                    break;
+
+                case "press":
+                {
+                    Control c = ParseControl(s.Args.Length > 0 ? s.Args[0] : "");
+                    Int32 frames = Math.Max(1, Arg(s, 1, 2));
+                    Schedule(c, frames);
+                    Block(frames + 2);          // +1 for the scheduling offset, +1 so IsInputUp lands inside the step
+                    break;
+                }
+
+                case "hold":
+                {
+                    Control c = ParseControl(s.Args.Length > 0 ? s.Args[0] : "");
+                    Schedule(c, Math.Max(1, Arg(s, 1, 30)));
+                    break;
+                }
+
+                case "release":
+                {
+                    Int32 i = (Int32)ParseControl(s.Args.Length > 0 ? s.Args[0] : "");
+                    // ⚠ A RELEASE MUST NEVER PRESS. Writing _upFrame alone made IsHeld true for one
+                    // frame on a button that was NOT down (ClearAllButtons leaves _downFrame at -1, so
+                    // `f >= -1 && f < f+1` holds) -- a defensive release injected a phantom press, a
+                    // phantom Up edge, and on a menu a phantom cursor step. A verb whose whole purpose
+                    // is to stop input must not be able to produce any.
+                    if (Time.frameCount >= _downFrame[i] && Time.frameCount < _upFrame[i])
+                    {
+                        // Land it on the NEXT frame so a consumer that already sampled this frame still
+                        // sees a consistent held state; _upFrame in the past would never report Up.
+                        _upFrame[i] = Time.frameCount + 1;
+                    }
+                    else
+                    {
+                        _downFrame[i] = -1;
+                        _upFrame[i] = -1;
+                    }
+                    break;
+                }
+
+                case "warp":
+                    if (!Ff9mkDebugMenu.HarnessWarp(Arg(s, 0, -1), Arg(s, 1, -1), Arg(s, 2, -1)))
+                        throw new InvalidOperationException("warp refused (not on a field?)");
+                    Block(2);
+                    break;
+
+                // ⚠ THESE USED TO ACK CLEAN WHILE DOING NOTHING. Between them the debug menu has
+                // seven refusal paths ("world warp: overworld only", "not in world mode", "teleport:
+                // outside the 24x20 grid" ...), and every one of them returned silently. The driver
+                // then timed out blaming a destination the engine never attempted, or asserted on an
+                // untouched position and wrote a placement verdict about the map. The menu's own
+                // status line already said what was wrong; nothing was reading it.
+                case "worldwarp":
+                    if (!Ff9mkDebugMenu.HarnessWorldWarp(Arg(s, 0, -1), Arg(s, 1, -1), Arg(s, 2, -1)))
+                        throw new InvalidOperationException(Ff9mkDebugMenu.HarnessStatus ?? "world warp refused");
+                    Block(2);
+                    break;
+
+                case "teleport":
+                    if (!Ff9mkDebugMenu.HarnessWorldTeleport(ArgF(s, 0, 0f), ArgF(s, 1, 0f)))
+                        throw new InvalidOperationException(Ff9mkDebugMenu.HarnessStatus ?? "teleport refused");
+                    Block(2);
+                    break;
+
+                case "newgame":
+                {
+                    TitleUI title = UnityEngine.Object.FindObjectOfType<TitleUI>();
+                    if (title == null)
+                        throw new InvalidOperationException("newgame: not at the title screen");
+                    title.HarnessStartNewGame();
+                    Block(2);
+                    break;
+                }
+
+                case "control":
+                    PersistenSingleton<EventEngine>.Instance.SetUserControl(Arg(s, 0, 1) != 0);
+                    break;
+
+                case "flag":
+                {
+                    Int32 n = Arg(s, 0, -1);
+                    if (n < 0 || (n >> 3) >= FF9StateSystem.EventState.gEventGlobal.Length)
+                        throw new ArgumentOutOfRangeException("flag", "bit " + n + " is out of range");
+                    Byte[] g = FF9StateSystem.EventState.gEventGlobal;
+                    if (Arg(s, 1, 1) != 0)
+                        g[n >> 3] |= (Byte)(1 << (n & 7));
+                    else
+                        g[n >> 3] &= (Byte)~(1 << (n & 7));
+                    break;
+                }
+
+                case "byte":
+                {
+                    Int32 idx = Arg(s, 0, -1);
+                    if (idx < 0 || idx >= FF9StateSystem.EventState.gEventGlobal.Length)
+                        throw new ArgumentOutOfRangeException("byte", "index " + idx + " is out of range");
+                    FF9StateSystem.EventState.gEventGlobal[idx] = (Byte)Arg(s, 1, 0);
+                    break;
+                }
+
+                case "watch":
+                    foreach (String a in s.Args)
+                    {
+                        Int32 n;
+                        if (!Int32.TryParse(a, NumberStyles.Integer, CultureInfo.InvariantCulture, out n))
+                            continue;
+                        // ⚠ THE BOUND TEST MUST BE ON n, NOT ON n >> 3. In C# -1 >> 3 is -1, so a
+                        // negative bit passed the old `(n >> 3) < Length` check, then threw on the
+                        // array read AFTER its key and comma were already in the document buffer. The
+                        // catch does not roll back, so every state.json from then on was invalid JSON
+                        // -- and the driver reads unparseable state as "the agent never published",
+                        // i.e. "this engine predates s83", about a perfectly healthy game. A re-arm
+                        // did not clear it. This was the worst self-inflicted wound in the agent.
+                        if (n < 0 || (n >> 3) >= FF9StateSystem.EventState.gEventGlobal.Length)
+                            throw new ArgumentOutOfRangeException("watch", "bit " + n + " is out of range");
+                        if (!_watch.Contains(n))
+                            _watch.Add(n);
+                    }
+                    break;
+
+                case "unwatch":
+                    _watch.Clear();
+                    break;
+
+                case "timescale":
+                {
+                    // ⚠ NOT ZERO. At timeScale 0 the engine runs no LOGICAL ticks -- HonoBehaviorSystem
+                    // stops stepping, a pending warp can never service -- while Block(), IsHeld() and
+                    // the ack all keep advancing on RENDER frames. Presses open and close, waits
+                    // elapse, every step acks, against a game that executed nothing. Nothing about
+                    // that is distinguishable from success, which makes it the most dangerous value
+                    // the verb could accept.
+                    Single scale = ArgF(s, 0, 1f);
+                    if (scale < 0.1f || scale > 8f)
+                        throw new ArgumentOutOfRangeException("timescale", "must be 0.1 .. 8 (got " + scale + ")");
+                    Time.timeScale = scale;
+                    break;
+                }
+
+                case "stateevery":
+                    _stateEvery = Math.Max(1, Arg(s, 0, 2));
+                    break;
+
+                case "shot":
+                    _shotsPending++;
+                    StartCoroutine(CaptureShot(s.Args.Length > 0 ? s.Args[0] : "shot"));
+                    Block(2);
+                    break;
+
+                // THE ISOLATION PRIMITIVE. `hold` is non-blocking and frame-counted, so a scenario
+                // that raises mid-hold leaves a button DOWN into whatever runs next -- and buttons
+                // were only ever cleared on an arm transition, which is a whole disarm/re-arm cycle.
+                // Without this, running two scenarios in one launch means the first one's leftovers
+                // steering the second, and a suite that cannot isolate its members cannot be believed.
+                case "reset":
+                    ClearAllButtons();
+                    _watch.Clear();
+                    _note = "";
+                    _lastError = null;
+                    _errorSeq = -1;
+                    _stateEvery = 2;
+                    Time.timeScale = 1f;
+                    Event("reset");
+                    Block(2);
+                    break;
+
+                case "note":
+                    _note = String.Join(" ", s.Args);
+                    Event("note", "text", _note);
+                    break;
+
+                case "quit":
+                    Event("quit");
+                    FlushEvents();
+                    // Leave the SHARED install as we found it. A run that crashed with the scale
+                    // turned up used to hand the next person's game a fast-forward it never asked for.
+                    Time.timeScale = 1f;
+                    Application.Quit();
+                    break;
+
+                default:
+                    throw new NotSupportedException("unknown op '" + s.Op + "'");
+            }
+        }
+
+        private void Block(Int32 frames)
+        {
+            Int32 until = Time.frameCount + Math.Max(0, frames);
+            if (until > _blockUntilFrame)
+                _blockUntilFrame = until;
+        }
+
+        // Schedule a virtual press starting NEXT frame -- see the FRAME MODEL note at the top of the file.
+        private static void Schedule(Control c, Int32 frames)
+        {
+            Int32 i = (Int32)c;
+            if (i < 0 || i >= ControlCount)
+                throw new ArgumentOutOfRangeException("button");
+            _downFrame[i] = Time.frameCount + 1;
+            _upFrame[i] = _downFrame[i] + frames;
+        }
+
+        private static Int32 Arg(Step s, Int32 i, Int32 fallback)
+        {
+            Int32 v;
+            if (s.Args.Length > i && Int32.TryParse(s.Args[i], NumberStyles.Integer, CultureInfo.InvariantCulture, out v))
+                return v;
+            return fallback;
+        }
+
+        private static Single ArgF(Step s, Int32 i, Single fallback)
+        {
+            Single v;
+            if (s.Args.Length > i && Single.TryParse(s.Args[i], NumberStyles.Float, CultureInfo.InvariantCulture, out v))
+                return v;
+            return fallback;
+        }
+
+        // Accepts the Control enum names plus the aliases a human (or a scenario author) actually types.
+        private static Control ParseControl(String name)
+        {
+            switch ((name ?? "").ToLowerInvariant())
+            {
+                case "confirm": case "ok": case "x": case "circle": case "a": return Control.Confirm;
+                case "cancel": case "back": case "b": return Control.Cancel;
+                case "menu": case "triangle": case "y": return Control.Menu;
+                case "special": case "square": return Control.Special;
+                case "l1": case "leftbumper": return Control.LeftBumper;
+                case "r1": case "rightbumper": return Control.RightBumper;
+                case "l2": case "lefttrigger": return Control.LeftTrigger;
+                case "r2": case "righttrigger": return Control.RightTrigger;
+                case "start": case "pause": return Control.Pause;
+                case "select": return Control.Select;
+                case "up": case "north": return Control.Up;
+                case "down": case "south": return Control.Down;
+                case "left": case "west": return Control.Left;
+                case "right": case "east": return Control.Right;
+                default: throw new ArgumentException("unknown button '" + name + "'");
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // Screenshots. ReadPixels at end-of-frame rather than Application.CaptureScreenshot: the latter
+        // is fire-and-forget with an engine-chosen path, so the driver can never know WHEN the file is
+        // complete. This version owns the path and decrements _shotsPending only once the bytes are on
+        // disk, which is what lets DrainQueue hold the ack until every frame is actually captured.
+        //
+        // It also beats the external PrintWindow capture on two counts: it needs no window focus and it
+        // cannot return the all-black frame that exclusive fullscreen gives game_snap.ps1.
+        // ------------------------------------------------------------------------------------------
+        private IEnumerator CaptureShot(String name)
+        {
+            yield return new WaitForEndOfFrame();
+            String path = null;
+            try
+            {
+                Texture2D tex = new Texture2D(Screen.width, Screen.height, TextureFormat.RGB24, false);
+                tex.ReadPixels(new Rect(0f, 0f, Screen.width, Screen.height), 0, 0, false);
+                tex.Apply();
+                Byte[] png = tex.EncodeToPNG();
+                UnityEngine.Object.Destroy(tex);
+                path = Path.Combine(_shotDir, Sanitize(name) + ".png");
+                File.WriteAllBytes(path, png);
+                _shotsTaken++;
+                Event("shot", "name", name, "path", path, "w", Screen.width.ToString(CultureInfo.InvariantCulture), "h", Screen.height.ToString(CultureInfo.InvariantCulture));
+            }
+            catch (Exception err)
+            {
+                _lastError = "shot: " + err.Message;
+                _errorSeq = _seq;
+                Event("error", "op", "shot", "message", err.Message);
+            }
+            _shotsPending = Math.Max(0, _shotsPending - 1);
+        }
+
+        private static String Sanitize(String name)
+        {
+            StringBuilder sb = new StringBuilder();
+            foreach (Char c in name ?? "shot")
+                sb.Append(Char.IsLetterOrDigit(c) || c == '-' || c == '_' || c == '.' ? c : '_');
+            return sb.Length == 0 ? "shot" : sb.ToString();
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // state.json -- what the driver asserts against. EVERY read is individually try/caught and
+        // degrades to null: this file is sampled at the title screen, mid-transition and mid-battle,
+        // where half of these singletons do not exist yet. One missing subsystem must cost one null
+        // field, never the whole state document.
+        // ------------------------------------------------------------------------------------------
+        private void PublishState(Boolean force)
+        {
+            if (!force && Time.frameCount - _stateFrame < _stateEvery)
+                return;
+            _stateFrame = Time.frameCount;
+
+            StringBuilder sb = new StringBuilder(1024);
+            sb.Append("{");
+            Num(sb, "v", ProtocolVersion); sb.Append(",");
+            Num(sb, "frame", Time.frameCount); sb.Append(",");
+            Num(sb, "seq", _seq); sb.Append(",");
+            Num(sb, "ack", _ack); sb.Append(",");
+            Num(sb, "queue", _queue.Count); sb.Append(",");
+            Bool(sb, "busy", _queue.Count > 0 || _shotsPending > 0 || Time.frameCount < _blockUntilFrame); sb.Append(",");
+            Num(sb, "shots", _shotsTaken); sb.Append(",");
+            Num(sb, "timescale", Time.timeScale); sb.Append(",");
+            // `armed` is what makes "the agent stood down" distinguishable from "the game hung" --
+            // the two produce an identical silence on the driver side, and the driver used to guess.
+            Bool(sb, "armed", Active); sb.Append(",");
+            Bool(sb, "faulted", _faulted); sb.Append(",");
+            Str(sb, "note", _note); sb.Append(",");
+            Str(sb, "error", _lastError); sb.Append(",");
+            Num(sb, "error_seq", _errorSeq); sb.Append(",");
+            // The debug menu's own one-line status: why a refused engine action refused.
+            Str(sb, "debug_status", Try(() => Ff9mkDebugMenu.HarnessStatus)); sb.Append(",");
+            // Where saves are ACTUALLY going right now. Published so the driver can assert the
+            // sandbox is in force before it does anything that could write one.
+            Str(sb, "save_path", Try(() => SharedDataBytesStorage.MetaData.FilePath)); sb.Append(",");
+            Bool(sb, "save_sandboxed", _saveRedirected); sb.Append(",");
+
+            Str(sb, "ui_state", Try(() => PersistenSingleton<UIManager>.Instance.State.ToString())); sb.Append(",");
+            Str(sb, "scene", Try(() => PersistenSingleton<SceneDirector>.Instance.CurrentScene)); sb.Append(",");
+            Bool(sb, "fading", Try(() => PersistenSingleton<SceneDirector>.Instance.IsFading, false)); sb.Append(",");
+            Num(sb, "sys_mode", Try(() => (Int32)PersistenSingleton<FF9StateSystem>.Instance.mode, -1)); sb.Append(",");
+            Num(sb, "scenario", Try(() => FF9StateSystem.EventState.ScenarioCounter, -1)); sb.Append(",");
+
+            // field
+            Int32 fld = Try(() => (Int32)FF9StateSystem.Common.FF9.fldMapNo, -1);
