index e69de29..01014e4 100644
--- /dev/null
+++ b/Assembly-CSharp/Memoria/Harness/HarnessAgent.cs
@@ -0,0 +1,1919 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.Globalization;
+using System.IO;
+using System.Text;
+using Assets.Scripts.Common;
+using UnityEngine;
+
+// [ff9mapkit s83] THE TEST HARNESS AGENT -- the in-process half of the automated play/verify loop.
+//
+// WHY THIS EXISTS: the agent developing this toolkit cannot play the game. It could deploy a build and
+// capture a static PNG of the window (tools/game_snap.ps1), but it could not press a button, could not
+// know WHERE the character was, and could not read a line of dialogue -- so every behavioural claim had
+// to be paid for with a human playtest. This class closes that loop from inside the engine:
+//
+//   IN   a plain-text request file  (ff9harness/req.txt)    -- frame-exact button presses, warps, flags
+//   OUT  a JSON state file          (ff9harness/state.json) -- where you are, what you can see
+//   OUT  an append-only event log   (ff9harness/events.jsonl)
+//   OUT  PNG frames                 (ff9harness/shots/)
+//
+// Input is injected at HonoInputManager.IsInput/IsInputDown/IsInputUp -- the single choke point every
+// consumer (field, world, battle, menus) reads. That means the harness needs NO window focus and does
+// NOT steal the keyboard: the game believes a virtual controller button is held while the human can
+// still type in another window, and real input is OR-ed in so a human can drive the same session.
+//
+// DORMANT BY DEFAULT -- and that is load-bearing, not politeness. One game install is shared by every
+// concurrent worktree on this machine. With no `ff9harness/arm` file present, `Active` is false, the
+// three input hooks early-out on a static bool, nothing is written, and behaviour is bit-identical to
+// an unpatched engine. The driver creates `arm` before launching and removes it when the run ends.
+//
+// FRAME MODEL: every schedule is expressed in ABSOLUTE Time.frameCount values decided at least one frame
+// ahead. Unity does not order component Updates, so a press scheduled for "now" could be sampled by
+// HonoInputManager either side of our own Update and would be seen once, twice, or never -- the exact
+// flakiness that makes a harness worthless. Scheduling into the future makes every consumer in a given
+// frame agree regardless of execution order.
+namespace Memoria.Harness
+{
+    public sealed class HarnessAgent : MonoBehaviour
+    {
+        // 5 (rev 5): the `netsync` block + verbs -- the co-op client's F3 dialogue-lockstep
+        // observables and the solo-bench entry points, so the F1-F3 benches run unattended.
+        public const Int32 ProtocolVersion = 5;
+
+        // ---- arming ----------------------------------------------------------------------------
+        // Read by the HonoInputManager hooks on EVERY key query of every frame, so it is a plain static
+        // field -- no property, no file check, no allocation on the hot path.
+        public static Boolean Active;
+
+        private static HarnessAgent _instance;
+        private static String _dir;             // <game>/x64/ff9harness
+        private static String _shotDir;
+        private static String _saveDir;         // <game>/x64/ff9harness/save -- the sandbox
+        // The player's REAL save paths, stashed while the sandbox is in force.
+        private static String _realSaveFilePath;
+        private static String _realSaveDirPath;
+        private static Boolean _saveRedirected;
+
+        // ---- virtual controller ----------------------------------------------------------------
+        // Absolute frame numbers, one slot per Control (the enum has 16 members). A button is HELD on
+        // frames [_downFrame, _upFrame), reports Down on exactly _downFrame and Up on exactly _upFrame.
+        private const Int32 ControlCount = 16;
+        private static readonly Int32[] _downFrame = new Int32[ControlCount];
+        private static readonly Int32[] _upFrame = new Int32[ControlCount];
+
+        public static Boolean IsHeld(Control c)
+        {
+            Int32 i = (Int32)c;
+            if (!Active || i < 0 || i >= ControlCount)
+                return false;
+            Int32 f = Time.frameCount;
+            return f >= _downFrame[i] && f < _upFrame[i];
+        }
+
+        public static Boolean WasPressed(Control c)
+        {
+            Int32 i = (Int32)c;
+            return Active && i >= 0 && i < ControlCount && Time.frameCount == _downFrame[i];
+        }
+
+        public static Boolean WasReleased(Control c)
+        {
+            Int32 i = (Int32)c;
+            return Active && i >= 0 && i < ControlCount && Time.frameCount == _upFrame[i];
+        }
+
+        /// <summary>
+        /// The analog axis the harness is currently "pushing", synthesised from the held directions.
+        /// Returns false when the harness holds no direction, so real input passes through untouched.
+        /// </summary>
+        /// <remarks>
+        /// This exists because hooking the key booleans alone produced a character who turned to face
+        /// the right way and then stood still. With [AnalogControl] Enabled=1, MovePC zeroes the move
+        /// vector whenever the axis is under the stick threshold, and the axis comes from Unity's own
+        /// input -- which a physical keyboard feeds and an injected press does not. Reporting a full
+        /// unit vector (rather than a ramp) also makes harness movement deterministic: the same hold
+        /// for the same frame count covers the same distance on every run, which is what lets a
+        /// scenario assert on a position at all.
+        /// </remarks>
+        public static Boolean TryGetAxis(out Vector2 axis)
+        {
+            axis = Vector2.zero;
+            if (!Active)
+                return false;
+            if (IsHeld(Control.Up))
+                axis.y += 1f;
+            if (IsHeld(Control.Down))
+                axis.y -= 1f;
+            if (IsHeld(Control.Left))
+                axis.x -= 1f;
+            if (IsHeld(Control.Right))
+                axis.x += 1f;
+            if (axis.x == 0f && axis.y == 0f)
+                return false;
+            if (axis.sqrMagnitude > 1f)
+                axis.Normalize();
+            return true;
+        }
+
+        /// <summary>
+        /// The NGUI navigation axis ("Horizontal" / "Vertical") the harness is pushing. False when the
+        /// harness holds no relevant direction, or for any other axis name, so real input is untouched.
+        /// </summary>
+        /// <remarks>
+        /// Separate from <see cref="TryGetAxis"/> on purpose. That one feeds the FIELD movement vector
+        /// and is normalised, so a diagonal is ~0.707 on each component -- correct for walking, wrong
+        /// here, where NGUI thresholds the raw value to decide whether the cursor steps at all. This one
+        /// reports a full +/-1 per axis.
+        /// </remarks>
+        public static Boolean TryGetNavigationAxis(String axisName, out Single value)
+        {
+            value = 0f;
+            if (!Active)
+                return false;
+            if (axisName == "Horizontal")
+            {
+                if (IsHeld(Control.Left))
+                    value -= 1f;
+                if (IsHeld(Control.Right))
+                    value += 1f;
+            }
+            else if (axisName == "Vertical")
+            {
+                if (IsHeld(Control.Up))
+                    value += 1f;
+                if (IsHeld(Control.Down))
+                    value -= 1f;
+            }
+            else
+            {
+                return false;
+            }
+            return value != 0f;
+        }
+
+        // ---- request queue ---------------------------------------------------------------------
+        private sealed class Step
+        {
+            public String Op;
+            public String[] Args;
+        }
+
+        private readonly Queue<Step> _queue = new Queue<Step>();
+        private readonly List<Int32> _watch = new List<Int32>();   // gEventGlobal bit indices published in state
+        // The last `menus` collection: what one party slot can do. Flat Int32 tuples exactly as
+        // BattleHUD.CollectNetMenus fills them -- commands in 4s, abilities in 6s, items in 4s.
+        private readonly List<Int32> _menuCommands = new List<Int32>();
+        private readonly List<Int32> _menuAbilities = new List<Int32>();
+        private readonly List<Int32> _menuItems = new List<Int32>();
+        private Int32 _menuSlot = -1;       // -1 = never collected, or the last collection threw
+        private Int32 _menuEpoch = -1;      // which battle it describes; a stale read must be visible
+        private Int64 _seq = -1;            // last request sequence ACCEPTED
+        private Int64 _ack = -1;            // last request sequence COMPLETED (queue drained)
+        private Boolean _pendingAck;        // a request is accepted but not yet fully completed
+        private Int32 _blockUntilFrame;     // the queue does not advance until Time.frameCount reaches this
+        private Int32 _tickedFrame = -1;    // Update re-entry guard (one logical tick per rendered frame)
+        private Int32 _armPollFrame;
+        private Int32 _reqPollFrame;
+        private Int32 _stateFrame;
+        private Int32 _stateEvery = 2;      // frames between state writes; `stateevery N` tunes it
+        private String _lastError;
+        // WHICH REQUEST the error belongs to. The latch alone made one refusal poison every later
+        // step: the driver saw a non-null error on a healthy ack and raised, quoting a stale message
+        // against an innocent request -- which turned one bad warp into a sweep reporting every
+        // remaining field as unreachable. Stamped here, cleared per request in PollRequest.
+        private Int64 _errorSeq = -1;
+        // Latched when Update's catch fires. A fault must be TERMINAL, not something that heals
+        // itself 30 frames later having wiped the error that explained it.
+        private Boolean _faulted;
+        private String _note = "";
+        private Int32 _shotsTaken;
+        private Int32 _shotsPending;
+
+        // ------------------------------------------------------------------------------------------
+        // Bootstrap. Called once per frame from UIKeyTrigger.Update (idempotent -- one null compare once
+        // built). A DontDestroyOnLoad MonoBehaviour rather than a call-through so the agent outlives
+        // every scene change: title -> field -> battle -> world all keep the same queue and the same
+        // held buttons.
+        // ------------------------------------------------------------------------------------------
+        // Is a harness run armed? Answered WITHOUT the agent existing, because the earliest caller runs
+        // in BundleSceneSelector.Awake -- before any scene, let alone our MonoBehaviour. Same gate as
+        // everything else here: no arm file, no behaviour change anywhere.
+        public static Boolean ArmFileExists()
+        {
+            try
+            {
+                EnsurePaths();
+                return File.Exists(Path.Combine(_dir, "arm"));
+            }
+            catch (Exception)
+            {
+                return false;
+            }
+        }
+
+        // ONE place that resolves the channel paths, because there are now two entry points into this
+        // class and they raced: ArmFileExists (called from BundleSceneSelector.Awake, before any scene)
+        // used to assign only _dir, so PollArm's own `if (_dir == null)` block never ran and _shotDir
+        // stayed null -- Directory.CreateDirectory(null) threw on the first arm and the agent disarmed
+        // itself before publishing a single state. Two lazy initialisers over one piece of state, where
+        // whichever runs first silently starves the other.
+        private static void EnsurePaths()
+        {
+            if (_dir != null)
+                return;
+            _dir = Path.GetFullPath(Path.Combine(Path.Combine(Application.dataPath, ".."), "ff9harness"));
+            _shotDir = Path.Combine(_dir, "shots");
+            _saveDir = Path.Combine(_dir, "save");
+        }
+
+        public static void Ensure()
+        {
+            if (_instance != null)
+                return;
+            GameObject go = new GameObject("Ff9mkHarnessAgent");
+            UnityEngine.Object.DontDestroyOnLoad(go);
+            _instance = go.AddComponent<HarnessAgent>();
+        }
+
+        private void Update()
+        {
+            if (_tickedFrame == Time.frameCount)
+                return;
+            _tickedFrame = Time.frameCount;
+
+            try
+            {
+                PollArm();
+                if (!Active)
+                    return;
+                // RETRY THE SANDBOX until it takes. The arm transition can land before
+                // SharedDataBytesStorage has resolved its paths (the statics are set from a type
+                // initialiser, on first touch), and a one-shot redirect that silently no-ops in that
+                // window leaves the very autosave this exists to prevent pointed at the player's
+                // file. One bool test per frame is nothing; a missed redirect is their save.
+                if (!_saveRedirected)
+                    RedirectSaves(true);
+                PollRequest();
+                DrainQueue();
+                PublishState(false);
+            }
+            catch (Exception err)
+            {
+                // The harness must never be able to crash the game it is testing: a malformed request
+                // line or a locked file becomes a reported error and a disarm, not a dead frame loop.
+                //
+                // ⚠ AND IT MUST STAY DOWN. Before the latch, a fault disarmed, discarded the in-flight
+                // request, released every held button mid-action -- and then re-armed within 30 frames
+                // because the arm file was still there, wiping the very error that explained it. The
+                // driver saw a perfectly healthy-looking state and reported "steps were not
+                // acknowledged", blaming the game for the agent's own crash.
+                _lastError = err.Message;
+                _errorSeq = _seq;
+                _faulted = true;
+                Active = false;
+                ClearAllButtons();
+                Time.timeScale = 1f;
+                try { RedirectSaves(false); } catch (Exception) { }
+                ReleaseNetsyncOverride();
+                try { PublishState(true); } catch (Exception) { }
+                Memoria.Prime.Log.Message("[ff9mk harness] FAULTED and disarmed: " + err);
+            }
+        }
+
+        // The arm file is POLLED rather than read once, so a run can arm or disarm a LIVE game with no
+        // relaunch. Twice a second is far below noise -- File.Exists on a warm directory is microseconds.
+        private void PollArm()
+        {
+            EnsurePaths();
+            if (Time.frameCount - _armPollFrame < 30)
+                return;
+            _armPollFrame = Time.frameCount;
+
+            Boolean armed = File.Exists(Path.Combine(_dir, "arm"));
+            if (armed == Active)
+                return;
+
+            // A FAULTED agent does not come back on its own. Re-arming here would be a silent
+            // self-heal that erases the diagnosis; the driver must disarm and re-arm deliberately.
+            if (armed && _faulted)
+                return;
+
+            Active = armed;
+            _queue.Clear();
+            ClearAllButtons();
+            if (armed)
+            {
+                Directory.CreateDirectory(_shotDir);
+                _seq = -1;
+                _ack = -1;
+                _errorSeq = -1;
+                _pendingAck = false;
+                _blockUntilFrame = 0;
+                _lastError = null;
+                _shotsTaken = 0;
+                _shotsPending = 0;
+                // Per-run scratch that used to survive a re-arm. A stale watch list keeps publishing
+                // the previous run's bits, and a stale note mislabels this run's events.
+                _watch.Clear();
+                _note = "";
+                _stateEvery = 2;
+                ForgetMenus();
+                Time.timeScale = 1f;
+                RedirectSaves(true);
+                Event("armed", "protocol", ProtocolVersion.ToString(CultureInfo.InvariantCulture));
+                Memoria.Prime.Log.Message("[ff9mk harness] ARMED -- channel at " + _dir);
+            }
+            else
+            {
+                // PUBLISH ONE LAST DOCUMENT SAYING SO. Otherwise the file left on disk describes a
+                // live game, and "disarmed", "hung" and "merely slow" are indistinguishable to the
+                // driver -- which is how a healthy game got reported as hung.
+                Time.timeScale = 1f;
+                RedirectSaves(false);
+                ReleaseNetsyncOverride();
+                Event("disarmed");
+                // Active is already false here, which is the point: this final document publishes
+                // "armed": false. Forcing it true to "make the publish work" would have made the one
+                // signal that distinguishes a clean stand-down from a hang say the opposite.
+                try { PublishState(true); } catch (Exception) { }
+                Memoria.Prime.Log.Message("[ff9mk harness] disarmed");
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // THE SAVE SANDBOX. While armed, the game's save containers live in the channel directory
+        // instead of the player's save folder.
+        //
+        // WHY, MEASURED RATHER THAN ASSUMED: `EventEngine` autosaves on ordinary field entry, gated
+        // only by `Configuration.SaveFile.DisableAutoSave` (0 on this install). A scenario's opening
+        // is `newgame()` then `warp()`, so every harness run was stamping a scenario-zero autosave
+        // over the player's file. Confirmed in-game on 2026-08-31 -- both SavedData_ww.dat and
+        // SavedData_ww_Memoria_Autosave.dat changed across a single run
+        // (studies/test-harness/scenarios/save_untouched.py). Manual slots were untouched; the
+        // autosave was not.
+        //
+        // Redirecting FilePath moves BOTH containers, because the Memoria sidecar path is derived
+        // from it (MetaData.GetMemoriaExtraSaveFilePath). The sandbox starts EMPTY, which is a
+        // second benefit: an armed run cannot accidentally load, and therefore cannot accidentally
+        // resave, the player's game.
+        //
+        // The path is PUBLISHED in state.json so the driver can VERIFY the redirect instead of
+        // trusting it. A sandbox nobody checked is a check that cannot fail.
+        private static void RedirectSaves(Boolean on)
+        {
+            try
+            {
+                if (on)
+                {
+                    if (_saveRedirected)
+                        return;
+                    String real = SharedDataBytesStorage.MetaData.FilePath;
+                    if (String.IsNullOrEmpty(real))
+                        return;                 // paths not resolved yet; the next arm will catch it
+                    _realSaveFilePath = real;
+                    _realSaveDirPath = SharedDataBytesStorage.MetaData.DirPath;
+                    Directory.CreateDirectory(_saveDir);
+                    SharedDataBytesStorage.MetaData.DirPath = _saveDir;
+                    SharedDataBytesStorage.MetaData.FilePath =
+                        Path.Combine(_saveDir, Path.GetFileName(real));
+                    _saveRedirected = true;
+                    Memoria.Prime.Log.Message("[ff9mk harness] saves sandboxed to " + _saveDir
+                                              + " (real: " + _realSaveDirPath + ")");
+                }
+                else
+                {
+                    if (!_saveRedirected)
+                        return;
+                    SharedDataBytesStorage.MetaData.FilePath = _realSaveFilePath;
+                    SharedDataBytesStorage.MetaData.DirPath = _realSaveDirPath;
+                    _saveRedirected = false;
+                    Memoria.Prime.Log.Message("[ff9mk harness] saves restored to " + _realSaveDirPath);
+                }
+            }
+            catch (Exception err)
+            {
+                // A failed redirect must not be silent -- it means the next autosave lands on the
+                // player's file, which is the entire thing this exists to prevent.
+                Memoria.Prime.Log.Message("[ff9mk harness] SAVE SANDBOX FAILED: " + err);
+            }
+        }
+
+        private static void ClearAllButtons()
+        {
+            for (Int32 i = 0; i < ControlCount; i++)
+            {
+                _downFrame[i] = -1;
+                _upFrame[i] = -1;
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // req.txt -- a line-oriented text protocol, deliberately NOT JSON. The game side needs no JSON
+        // parser (Assembly-CSharp bundles none, and hand-rolling one inside the frame loop is a bug
+        // farm); the driver side needs three lines of Python to emit it. State comes BACK as JSON,
+        // where the asymmetry reverses: C# writes it with a StringBuilder, Python reads it for free.
+        //
+        // The first line must be `seq <n>`. A request whose seq is not GREATER than the last accepted
+        // one is ignored, which makes the read idempotent: the driver writes the file once and we may
+        // poll it any number of times, including while it is mid-rewrite.
+        // ------------------------------------------------------------------------------------------
+        private void PollRequest()
+        {
+            // Poll hard while idle (latency between steps is the driver's round-trip cost), gently
+            // while a queue is already running.
+            Int32 every = _queue.Count == 0 ? 2 : 10;
+            if (Time.frameCount - _reqPollFrame < every)
+                return;
+            _reqPollFrame = Time.frameCount;
+
+            String path = Path.Combine(_dir, "req.txt");
+            if (!File.Exists(path))
+                return;
+
+            String[] lines;
+            try
+            {
+                lines = File.ReadAllLines(path);
+            }
+            catch (IOException)
+            {
+                return;     // mid-write by the driver; the next poll gets it
+            }
+            if (lines.Length == 0)
+                return;
+
+            Int64 seq;
+            String[] head = Split(lines[0]);
+            if (head.Length < 2 || head[0] != "seq" || !Int64.TryParse(head[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out seq))
+                return;
+            if (seq <= _seq)
+                return;
+
+            _seq = seq;
+            // Per-REQUEST, not per-run: see the _errorSeq comment. The driver can then attribute a
+            // refusal to the step that caused it instead of to whatever ran next.
+            _lastError = null;
+            Int32 added = 0;
+            for (Int32 i = 1; i < lines.Length; i++)
+            {
+                String[] tok = Split(lines[i]);
+                if (tok.Length == 0 || tok[0].StartsWith("#"))
+                    continue;
+                String[] args = new String[tok.Length - 1];
+                Array.Copy(tok, 1, args, 0, args.Length);
+                _queue.Enqueue(new Step { Op = tok[0].ToLowerInvariant(), Args = args });
+                added++;
+            }
+            _pendingAck = true;
+            Event("accepted", "seq", seq.ToString(CultureInfo.InvariantCulture), "steps", added.ToString(CultureInfo.InvariantCulture));
+        }
+
+        private static String[] Split(String line)
+        {
+            if (String.IsNullOrEmpty(line))
+                return new String[0];
+            return line.Trim().Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
+        }
+
+        private void DrainQueue()
+        {
+            while (_queue.Count > 0 && Time.frameCount >= _blockUntilFrame)
+            {
+                Step s = _queue.Dequeue();
+                try
+                {
+                    Execute(s);
+                }
+                catch (Exception err)
+                {
+                    _lastError = s.Op + ": " + err.Message;
+                    _errorSeq = _seq;
+                    Event("error", "op", s.Op, "message", err.Message);
+                }
+            }
+            // The ack must be latched on PERSISTENT state, not on "was the queue busy at the top of
+            // THIS tick". When the final step blocks -- which is almost all of them: press, wait, warp,
+            // shot -- the queue empties on the frame it is dequeued but the block has not elapsed, and
+            // by the next frame a frame-local "was busy" is already false. That loses the ack forever
+            // and every command hangs until the driver's timeout. Caught by the offline stand-in
+            // (ff9mapkit/tests/test_harness.py) before it ever cost a game launch.
+            if (_pendingAck && _queue.Count == 0 && Time.frameCount >= _blockUntilFrame && _shotsPending == 0)
+            {
+                _pendingAck = false;
+                _ack = _seq;
+                Event("ack", "seq", _ack.ToString(CultureInfo.InvariantCulture));
+                PublishState(true);
+            }
+        }
+
+        // ------------------------------------------------------------------------------------------
+        // The verbs. `press` BLOCKS for its own duration (tap-then-continue is the 99% case); `hold`
+        // does NOT (so a scenario can walk and act in the same breath) -- the explicit sync is `wait`.
+        // Everything else is instantaneous.
+        // ------------------------------------------------------------------------------------------
+        private void Execute(Step s)
+        {
+            switch (s.Op)
+            {
+                case "wait":
+                    Block(Arg(s, 0, 1));
+                    break;
+
+                case "press":
+                {
+                    Control c = ParseControl(s.Args.Length > 0 ? s.Args[0] : "");
+                    Int32 frames = Math.Max(1, Arg(s, 1, 2));
+                    Schedule(c, frames);
+                    Block(frames + 2);          // +1 for the scheduling offset, +1 so IsInputUp lands inside the step
+                    break;
+                }
+
+                case "hold":
+                {
+                    Control c = ParseControl(s.Args.Length > 0 ? s.Args[0] : "");
+                    // Extend, not Schedule: a re-issued hold must not punch a one-frame hole in a
+                    // press the driver believes is continuous. See Extend for what that cost.
+                    Extend(c, Math.Max(1, Arg(s, 1, 30)));
+                    break;
+                }
+
+                case "release":
+                {
+                    Int32 i = (Int32)ParseControl(s.Args.Length > 0 ? s.Args[0] : "");
+                    // ⚠ A RELEASE MUST NEVER PRESS. Writing _upFrame alone made IsHeld true for one
+                    // frame on a button that was NOT down (ClearAllButtons leaves _downFrame at -1, so
+                    // `f >= -1 && f < f+1` holds) -- a defensive release injected a phantom press, a
+                    // phantom Up edge, and on a menu a phantom cursor step. A verb whose whole purpose
+                    // is to stop input must not be able to produce any.
+                    if (Time.frameCount >= _downFrame[i] && Time.frameCount < _upFrame[i])
+                    {
+                        // Land it on the NEXT frame so a consumer that already sampled this frame still
+                        // sees a consistent held state; _upFrame in the past would never report Up.
+                        _upFrame[i] = Time.frameCount + 1;
+                    }
+                    else
+                    {
+                        _downFrame[i] = -1;
+                        _upFrame[i] = -1;
+                    }
+                    break;
+                }
+
+                case "warp":
+                    if (!Ff9mkDebugMenu.HarnessWarp(Arg(s, 0, -1), Arg(s, 1, -1), Arg(s, 2, -1)))
+                        throw new InvalidOperationException("warp refused (not on a field?)");
+                    Block(2);
+                    break;
+
+                // ⚠ THESE USED TO ACK CLEAN WHILE DOING NOTHING. Between them the debug menu has
+                // seven refusal paths ("world warp: overworld only", "not in world mode", "teleport:
+                // outside the 24x20 grid" ...), and every one of them returned silently. The driver
+                // then timed out blaming a destination the engine never attempted, or asserted on an
+                // untouched position and wrote a placement verdict about the map. The menu's own
+                // status line already said what was wrong; nothing was reading it.
+                case "worldwarp":
+                    if (!Ff9mkDebugMenu.HarnessWorldWarp(Arg(s, 0, -1), Arg(s, 1, -1), Arg(s, 2, -1)))
+                        throw new InvalidOperationException(Ff9mkDebugMenu.HarnessStatus ?? "world warp refused");
+                    Block(2);
+                    break;
+
+                case "teleport":
+                    if (!Ff9mkDebugMenu.HarnessWorldTeleport(ArgF(s, 0, 0f), ArgF(s, 1, 0f)))
+                        throw new InvalidOperationException(Ff9mkDebugMenu.HarnessStatus ?? "teleport refused");
+                    Block(2);
+                    break;
+
+                // ---- BATTLE -------------------------------------------------------------------
+                // Boot a REAL battle from a field. Deliberately not the diorama: that sets
+                // isDebug, under which the battle can never END, so every result or reward
+                // assertion there is green-having-observed-nothing.
+                case "battle":
+                    if (!Ff9mkDebugMenu.HarnessBattle(Arg(s, 0, -1), Arg(s, 1, -1)))
+                        throw new InvalidOperationException(Ff9mkDebugMenu.HarnessStatus ?? "battle refused");
+                    Block(2);
+                    break;
+
+                // Issue an exact command instead of steering a cursor -- the difference between
+                // testing a damage formula and testing NGUI navigation. This is the same entry
+                // point co-op uses to replay a remote player's command, so it is the game's own
+                // path rather than a second implementation of one.
+                case "battlecmd":
+                {
+                    BattleHUD hud = Try(() => UIManager.Battle);
+                    if (hud == null)
+                        throw new InvalidOperationException("battlecmd: no battle HUD (not in a battle?)");
+                    Int32 slot = Arg(s, 0, 0);
+                    // ⚠ THE LOCAL SLOT IS THE ENTIRE FIGHT, and SendNetCommand refuses it. It opens
+                    // with `if (playerIndex == CurrentPlayerIndex) return false;` -- correctly, for
+                    // what it was built for: it replays a REMOTE co-op player's command and must lose
+                    // a race against the menu that slot has open locally. In a solo battle that is
+                    // always the one slot you want, which is exactly what left this harness able to
+                    // SEE a battle and unable to PLAY one.
+                    //
+                    // The key is the UI's own post-commit teardown, and it is public. SetIdle() is
+                    // what OnTargetConfirm calls the instant a command is sent (BattleHUD.Unity.cs:
+                    // "if (commandSent) { SetTargetVisibility(false); SetIdle(); }"): it closes the
+                    // command/target/item/ability panels and sets CurrentPlayerIndex = -1. Running it
+                    // FIRST hands the slot back, so the call below races nothing -- and the menu had
+                    // to close regardless, or it would sit open over a slot whose turn is already
+                    // spent, freezing the gauges in WAIT ATB mode.
+                    //
+                    // If SendNetCommand still refuses, the slot is NOT added to InputFinishList, so
+                    // the HUD re-opens its menu on the next Update: the failure heals instead of
+                    // stranding the fight with a closed menu and no queued command.
+                    // ⚠ REFUSE A BATTLE THAT IS NOT ASKING. SendNetCommand will happily queue a
+                    // command on a unit whose battle is still in its opening camera -- and doing so
+                    // FREEZES the fight, which is how this guard was earned. _commandEnable is the
+                    // engine's own gate for "the command phase is live".
+                    if (!Try(() => hud.FF9BMenu_IsEnable(), false))
+                        throw new InvalidOperationException(
+                            "battlecmd: the battle is not asking for commands yet (the intro is " +
+                            "still running, or the fight is already over). Wait for turn.enabled.");
+                    if (hud.CurrentPlayerIndex == slot)
+                        hud.SetIdle();
+                    if (!hud.SendNetCommand(slot, (Memoria.Data.BattleCommandId)Arg(s, 1, 0), Arg(s, 2, 0),
+                                            (UInt16)Arg(s, 3, 0), (UInt32)Arg(s, 4, 0)))
+                        throw new InvalidOperationException(
+                            "battlecmd: the HUD refused the command for slot " + slot + " -- " +
+                            DescribeSlotRefusal(slot));
+                    Block(2);
+                    break;
+                }
+
+                // What this character can actually DO, resolved by the engine instead of read off
+                // the on-screen buttons. CollectNetMenus is the co-op menu mirror (s37): the list the
+                // HUD would draw, already filtered for unlearned abilities, MP, silence, and items
+                // with no battle effect.
+                //
+                // ⚠ DELIBERATELY A VERB, NOT PART OF EVERY PUBLISH. CollectNetMenus calls
+                // SetAbilityAp, which WRITES the HUD's ability-detail cache. A publisher running it
+                // thirty times a second would be mutating the game it exists to observe -- the one
+                // thing an instrument may never do. So it is collected when a scenario asks, and
+                // stamped with the slot and battle epoch it describes, which is what makes a stale
+                // read VISIBLE rather than a confident answer about a fight that already ended.
+                case "menus":
+                {
+                    BattleHUD menuHud = Try(() => UIManager.Battle);
+                    if (menuHud == null)
+                        throw new InvalidOperationException("menus: no battle HUD (not in a battle?)");
+                    Int32 menuSlot = Arg(s, 0, -1);
+                    if (menuSlot < 0 || menuSlot >= 32)
+                        throw new ArgumentOutOfRangeException("slot", "menus needs a party slot (0-31)");
+                    // ⚠ CollectNetMenus indexes _abilityDetailDict UNGUARDED, and that dict is empty
+                    // until InitialBattle's ManageAbility has run. Asking during the battle intro is
+                    // an ordinary "too early", not a fault -- but without this it arrives as a bare
+                    // KeyNotFoundException and disarms the agent mid-scenario.
+                    // ⚠ AND THE SAME GATE HERE, BEFORE NetMenusReady -- which cannot catch this on
+                    // its own. It is `_abilityDetailDict.ContainsKey(slot)`, and InitialBattle
+                    // clears that dictionary's VALUES while leaving its KEYS, so from the second
+                    // battle of a session onward it answers true from the very first frame.
+                    if (!Try(() => menuHud.FF9BMenu_IsEnable(), false))
+                        throw new InvalidOperationException(
+                            "menus: the battle is not asking for commands yet (the intro is still " +
+                            "running, or the fight is already over). Wait for turn.enabled.");
+                    if (!menuHud.NetMenusReady(menuSlot))
+                        throw new InvalidOperationException(
+                            "menus: slot " + menuSlot + " has no ability detail yet (the battle is " +
+                            "still initialising, or the slot holds no party member)");
+                    _menuCommands.Clear();
+                    _menuAbilities.Clear();
+                    _menuItems.Clear();
