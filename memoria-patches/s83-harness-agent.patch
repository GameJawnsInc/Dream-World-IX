+                    Num(sb, "mp_max", Try(() => (Int32)unit.MaximumMp, -1)); sb.Append(",");
+                    Num(sb, "atb", Try(() => (Int32)unit.CurrentAtb, -1)); sb.Append(",");
+                    Num(sb, "atb_max", Try(() => (Int32)unit.MaximumAtb, -1)); sb.Append(",");
+                    Bool(sb, "can_act", Try(() => unit.CanMove, false)); sb.Append(",");
+                    Bool(sb, "alive", Try(() => !unit.IsUnderStatus(Memoria.Data.BattleStatus.Death), false)); sb.Append(",");
+                    Bool(sb, "targetable", Try(() => unit.IsTargetable, false)); sb.Append(",");
+                    Num(sb, "level", Try(() => (Int32)unit.Level, -1)); sb.Append(",");
+                    // A [Flags] ULONG with a bit at 63 -- published as a decimal STRING so nothing
+                    // downstream has to survive it arriving as a float.
+                    Str(sb, "status", Try(() => ((UInt64)unit.CurrentStatus).ToString(CultureInfo.InvariantCulture)));
+                    sb.Append("}");
+                }
+            }
+            catch (Exception)
+            {
+                // A half-written unit list would be a lie about the battle; an empty one is not.
+            }
+            sb.Append("]");
+        }
+
+        /// <summary>Drop FF9's bracketed text tags, leaving what a UILabel would actually draw.</summary>
+        private static String StripTags(String text)
+        {
+            if (String.IsNullOrEmpty(text) || text.IndexOf('[') < 0)
+                return text;
+            StringBuilder sb = new StringBuilder(text.Length);
+            Int32 depth = 0;
+            foreach (Char c in text)
+            {
+                if (c == '[')
+                    depth++;
+                else if (c == ']')
+                {
+                    if (depth > 0)
+                        depth--;
+                }
+                else if (depth == 0)
+                    sb.Append(c);
+            }
+            return sb.ToString();
+        }
+
+        /// <summary>The 0-based slot for a btl_id bitmask, WITHOUT the engine's unbounded loop.</summary>
+        private static Int32 SafeSlot(Int32 btlId)
+        {
+            for (Int32 i = 0; i < 32; i++)
+                if ((1 << i) == btlId)
+                    return i;
+            return -1;
+        }
+
+        private void AppendWatch(StringBuilder outer)
+        {
+            StringBuilder sb = new StringBuilder(128);
+            try
+            {
+                Byte[] g = FF9StateSystem.EventState.gEventGlobal;
+                for (Int32 i = 0; i < _watch.Count; i++)
+                {
+                    Int32 n = _watch[i];
+                    // Belt and braces behind the `watch` verb's own guard: the bound must be tested on
+                    // n itself, because -1 >> 3 is -1 and would sail through a shifted comparison.
+                    if (n < 0 || (n >> 3) >= g.Length)
+                        continue;
+                    if (sb.Length > 0) sb.Append(",");
+                    Boolean set = (g[n >> 3] & (1 << (n & 7))) != 0;
+                    Bool(sb, n.ToString(CultureInfo.InvariantCulture), set);
+                }
+            }
+            catch (Exception)
+            {
+                outer.Append("\"flags\":{}");
+                return;
+            }
+            outer.Append("\"flags\":{").Append(sb).Append("}");
+        }
+
+        // The co-op client's observables -- above all the F3 dialogue-lockstep state machine, since
+        // the solo benches assert on it: which window is under lockstep (`align_*`), whether a
+        // fabricated frame is HELD waiting for a matching window (`pending` + `wait_*` against the
+        // DialogWaitMs escape), and whether the guest's own Confirm is suppressed right now. With no
+        // client every value sits at its "nothing" sentinel -- a missing subsystem is one null
+        // section, never a missing document (the same law as every other section here).
+        private static void AppendNetsync(StringBuilder outer)
+        {
+            StringBuilder sb = new StringBuilder(320);
+            try
+            {
+                Bool(sb, "enabled", Memoria.Netsync.NetSyncClient.HarnessEnabled); sb.Append(",");
+                Str(sb, "role", Memoria.Netsync.NetSyncClient.HarnessRole); sb.Append(",");
+                Bool(sb, "instance", Memoria.Netsync.NetSyncClient.HarnessHasInstance); sb.Append(",");
+                Bool(sb, "selftest", Memoria.Netsync.NetSyncClient.IsSelfTestRole); sb.Append(",");
+                Bool(sb, "forced", Memoria.Netsync.NetSyncClient.HarnessSelfTestForced); sb.Append(",");
+                Bool(sb, "bench", Memoria.Netsync.NetSyncField.BenchGates); sb.Append(",");
+                Bool(sb, "l1", Memoria.Netsync.NetSyncClient.DebugHostEventFlag != 0); sb.Append(",");
+                Bool(sb, "l1_pinned", Memoria.Netsync.NetSyncClient.HarnessL1Pinned); sb.Append(",");
+                Bool(sb, "l1_forced_control", Memoria.Netsync.NetSyncClient.HarnessL1ForcedControl); sb.Append(",");
+                Bool(sb, "suppress", Memoria.Netsync.NetSyncClient.SuppressLocalDialogInput); sb.Append(",");
+                Int64 key = Memoria.Netsync.NetSyncClient.HarnessDialogAlignKey;
+                Num(sb, "align_win", key < 0 ? -1L : (key >> 24) & 0xFF); sb.Append(",");
+                Num(sb, "align_text", key < 0 ? -1L : key & 0xFFFF); sb.Append(",");
+                Num(sb, "applied_seq", Memoria.Netsync.NetSyncClient.HarnessDialogLastAppliedSeq); sb.Append(",");
+                Bool(sb, "wait_armed", Memoria.Netsync.NetSyncClient.HarnessDialogWaitArmed); sb.Append(",");
+                Num(sb, "wait_ms", Memoria.Netsync.NetSyncClient.HarnessDialogWaitElapsedMs); sb.Append(",");
+                Num(sb, "wait_limit_ms", Memoria.Netsync.NetSyncClient.HarnessDialogWaitMs); sb.Append(",");
+                Byte[] p = Memoria.Netsync.NetSyncClient.HarnessPendingDialogFrame;
+                if (p == null || p.Length < 8)
+                    sb.Append("\"pending\":null");
+                else
+                {
+                    sb.Append("\"pending\":{");
+                    Num(sb, "field", p[0] | (p[1] << 8)); sb.Append(",");
+                    Num(sb, "win", p[2]); sb.Append(",");
+                    Num(sb, "text", p[3] | (p[4] << 8)); sb.Append(",");
+                    Num(sb, "kind", p[5]); sb.Append(",");
+                    Num(sb, "index", p[6]); sb.Append(",");
+                    Num(sb, "seq", p[7]);
+                    sb.Append("}");
+                }
+            }
+            catch (Exception)
+            {
+                outer.Append("\"netsync\":{\"enabled\":false,\"role\":null,\"instance\":false,\"selftest\":false,\"forced\":false,\"bench\":false,\"l1\":false,\"l1_pinned\":false,\"l1_forced_control\":false,\"suppress\":false,\"align_win\":-1,\"align_text\":-1,\"applied_seq\":-1,\"wait_armed\":false,\"wait_ms\":-1,\"wait_limit_ms\":-1,\"pending\":null}");
+                return;
+            }
+            outer.Append("\"netsync\":{").Append(sb).Append("}");
+        }
+
+        private static void AppendHeld(StringBuilder sb)
+        {
+            sb.Append("\"held\":[");
+            Boolean first = true;
+            for (Int32 i = 0; i < ControlCount; i++)
+            {
+                if (!IsHeld((Control)i))
+                    continue;
+                if (!first) sb.Append(",");
+                sb.Append(Quote(((Control)i).ToString()));
+                first = false;
+            }
+            sb.Append("]");
+        }
+
+        // ---- events.jsonl ------------------------------------------------------------------------
+        private readonly List<String> _pendingEvents = new List<String>();
+
+        private void Event(String kind, params String[] kv)
+        {
+            StringBuilder sb = new StringBuilder(128);
+            sb.Append("{");
+            Num(sb, "frame", Time.frameCount); sb.Append(",");
+            Str(sb, "kind", kind);
+            for (Int32 i = 0; i + 1 < kv.Length; i += 2)
+            {
+                sb.Append(",");
+                Str(sb, kv[i], kv[i + 1]);
+            }
+            sb.Append("}");
+            _pendingEvents.Add(sb.ToString());
+            FlushEvents();
+        }
+
+        private void FlushEvents()
+        {
+            if (_pendingEvents.Count == 0 || _dir == null)
+                return;
+            try
+            {
+                File.AppendAllText(Path.Combine(_dir, "events.jsonl"), String.Join("\n", _pendingEvents.ToArray()) + "\n");
+                _pendingEvents.Clear();
+            }
+            catch (IOException)
+            {
+                // The driver may be reading; keep them buffered and retry on the next event.
+            }
+        }
+
+        // ---- tiny JSON writer + guarded readers ---------------------------------------------------
+        // Write to a sibling temp file then Replace, so the driver never parses a half-written document.
+        // The driver retries on a parse failure anyway -- belt and braces, because a torn state read is
+        // the kind of 1-in-500 flake that would discredit the whole harness.
+        private static void WriteAtomic(String path, String text)
+        {
+            // WRITTEN IN PLACE, SHARING READS -- deliberately NOT the replace-a-temp idiom.
+            //
+            // Replacing a temp file is the textbook way to publish atomically, and it is the wrong
+            // tool for a channel like this. ReplaceFile needs EXCLUSIVE access to the destination,
+            // while this file is rewritten ~30x/second and polled by the driver every few
+            // milliseconds. The two fight: the driver's open blocks the replace, the agent skips the
+            // publish, the driver's next read hits the replace that did get through, and the channel
+            // stalls for seconds at a stretch -- leaving `state.json~RF********.TMP` wreckage behind
+            // as proof.
+            //
+            // What made it expensive was the diagnosis, not the stall. The driver reported the stall
+            // as "no state published", concluded the game was hung, and the blame landed on the
+            // FIELD -- "walking out of room 30820 hangs the game". The game was fine the whole time,
+            // walking around with control; the channel's own transport was the entire bug.
+            //
+            // FileShare.Read means a reader is never locked out. It can instead catch a partly
+            // written document, which is by far the cheaper failure: the driver already retries a
+            // JSON parse error, and the next publish is two frames away. A torn read recovers on its
+            // own; a lock does not.
+            //
+            // UTF8Encoding(false) also drops the BOM that File.WriteAllText(Encoding.UTF8) emits and
+            // that json.loads rejects outright.
+            try
+            {
+                Byte[] bytes = new UTF8Encoding(false).GetBytes(text);
+                using (FileStream fs = new FileStream(path, FileMode.Create, FileAccess.Write,
+                                                      FileShare.Read))
+                    fs.Write(bytes, 0, bytes.Length);
+            }
+            catch (IOException)
+            {
+                // Never spin for a file inside the frame loop -- that would stutter the very game we
+                // are measuring. The next publish is two frames away.
+            }
+            catch (UnauthorizedAccessException)
+            {
+            }
+        }
+
+        private static T Try<T>(Func<T> read, T fallback = default(T))
+        {
+            try
+            {
+                return read();
+            }
+            catch (Exception)
+            {
+                return fallback;
+            }
+        }
+
+        private static void Str(StringBuilder sb, String key, String value)
+        {
+            sb.Append(Quote(key)).Append(":").Append(Quote(value));
+        }
+
+        private static void Num(StringBuilder sb, String key, Int64 value)
+        {
+            sb.Append(Quote(key)).Append(":").Append(value.ToString(CultureInfo.InvariantCulture));
+        }
+
+        private static void Num(StringBuilder sb, String key, Single value)
+        {
+            sb.Append(Quote(key)).Append(":");
+            if (Single.IsNaN(value) || Single.IsInfinity(value))
+                sb.Append("null");
+            else
+                sb.Append(value.ToString("0.###", CultureInfo.InvariantCulture));
+        }
+
+        private static void Bool(StringBuilder sb, String key, Boolean value)
+        {
+            sb.Append(Quote(key)).Append(":").Append(value ? "true" : "false");
+        }
+
+        private static String Quote(String s)
+        {
+            if (s == null)
+                return "null";
+            StringBuilder sb = new StringBuilder(s.Length + 8);
+            sb.Append('"');
+            foreach (Char c in s)
+            {
+                switch (c)
+                {
+                    case '"': sb.Append("\\\""); break;
+                    case '\\': sb.Append("\\\\"); break;
+                    case '\n': sb.Append("\\n"); break;
+                    case '\r': sb.Append("\\r"); break;
+                    case '\t': sb.Append("\\t"); break;
+                    default:
+                        if (c < ' ' || c > '~')
+                            sb.Append("\\u").Append(((Int32)c).ToString("x4", CultureInfo.InvariantCulture));
+                        else
+                            sb.Append(c);
+                        break;
+                }
+            }
+            sb.Append('"');
+            return sb.ToString();
+        }
+    }
+}
