+            StringBuilder sb = new StringBuilder(1024);
+            sb.Append("{");
+            Num(sb, "v", ProtocolVersion); sb.Append(",");
+            Num(sb, "frame", Time.frameCount); sb.Append(",");
+            Num(sb, "seq", _seq); sb.Append(",");
+            Num(sb, "ack", _ack); sb.Append(",");
+            Num(sb, "queue", _queue.Count); sb.Append(",");
+            Bool(sb, "busy", _queue.Count > 0 || _shotsPending > 0 || Time.frameCount < _blockUntilFrame); sb.Append(",");
+            Num(sb, "shots", _shotsTaken); sb.Append(",");
+            Num(sb, "timescale", Time.timeScale); sb.Append(",");
