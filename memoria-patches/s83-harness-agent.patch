+            Bool(sb, "key_confirm", Try(() => UIManager.Input.GetKey(Control.Confirm), false)); sb.Append(",");
+            Bool(sb, "move_key", Try(() => FieldMapActorController.ccSMoveKey, false)); sb.Append(",");
+            Num(sb, "dash_inh", Try(() => (Int32)PersistenSingleton<EventEngine>.Instance.GetDashInh(), -1)); sb.Append(",");
+            Num(sb, "axis_x", Try(() => PersistenSingleton<HonoInputManager>.Instance.GetAxis().x, Single.NaN)); sb.Append(",");
+            Num(sb, "axis_y", Try(() => PersistenSingleton<HonoInputManager>.Instance.GetAxis().y, Single.NaN));
+            sb.Append("}");
+        }
+
+        // The on-screen text. This is the assertion that was flatly impossible before -- a scenario can
