+                payload[3] = (Byte)(textId & 0xFF);
+                payload[4] = (Byte)((textId >> 8) & 0xFF);
+                payload[5] = kind;
+                payload[6] = choiceIndex;
+                payload[7] = seq;
+                i._socket.SendDialog(payload);       // the transport wraps it in a TypeDialog frame (type-6 precedent)
+                Log.Message("[NetSync] dialog tap: win " + winnum + " text " + textId + " kind " + kind + " idx " + choiceIndex + " seq " + seq);
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] dialog tap failed");
+            }
+        }
+
+        // GUEST pump (Update, right after ServiceEventCoLocate -- L1 is L2's prerequisite). Drives the
+        // frontmost host-matched window on the host's cadence; outside a live L1 the lane is drained and
+        // the guest's dialogue is 100% local (S2). The engage gate IS the primary softlock escape: any
+        // conjunct going false (link stale, host flag fell, field left, follow-warp pending) disengages
+        // and releases suppress within ~2 s. Same shape for the selftest bench (the L1 toggle stands in).
+        private void ServiceDialogLockstep(RemoteState rs, Int32 myField, Boolean onField)
+        {
+            try
+            {
+                Boolean engaged;
+                if (_role == "client")
+                {
+                    // S1a: engage ONLY under a live L1 -- host event flag set + co-located + session fresh
+                    // + no follow-warp mid-fade. The host-event flag is read FRESH each tick (never cached
+                    // across the reset), exactly as ServiceEventCoLocate reads it.
+                    engaged = IsLiveFollowedSession && onField && rs.Valid && rs.Field == myField
+                              && _followWarpPending < 0 && HostEventFlagFromWire();
+                }
+                else if (IsSelfTestRole && NetSyncField.BenchGates)
+                {
+                    engaged = DebugHostEventFlag != 0;   // bench: the L1 toggle simulates the host event flag
+                }
+                else
+                {
+                    engaged = false;
+                }
+
+                if (!engaged)
+                {
+                    DisengageDialogLockstep();
+                    return;
+                }
+                ServiceDialogApply(myField);
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] dialogue L2 tick failed");
+            }
+        }
+
+        // Read the host's blocking-event flag off the FRESH state lane (null/stale -> false, ~2 s staleness).
+        private Boolean HostEventFlagFromWire()
+        {
+            if (_socket == null)
+                return false;
+            Byte[] state = _socket.GetRemoteState();
+            Byte[] body;
+            if (state != null && NetSyncState.TryReadSection(state, NetSyncState.SectionEvent, out body) && body.Length >= 1)
+                return body[0] != 0;
+            return false;
+        }
+
+        // Not engaged: discard any queued frames and release ALL per-window lockstep state (suppress off).
+        // Called every non-engaged tick -- so a disengaged/left/stale window regains local input at once.
+        private void DisengageDialogLockstep()
+        {
+            if (_socket != null)
+                while (_socket.NextRemoteDialog() != null) { }   // drain-and-discard (nothing to apply)
+            _dialogPending = null;
+            _dialogSuppressActive = false;
+            _dialogAlignKey = -1;
+            _dialogLastAppliedSeq = -1;
+            _dialogWaitArmed = false;
+            _dialogTimeoutLogged = false;
+            _dialogRangeLogged = false;
+        }
+
+        // The §8.2 apply state machine over the one-slot peek holder (_dialogPending). Peek-until-match is
+        // load-bearing (the (fld,winnum,textId) triple is not an instance id -- it reopens corpus-wide), so
+        // a frame is applied strictly in host-emission order against the CURRENTLY-open window, never matched
+        // by scanning history. Shared by the live guest pump and the selftest bench.
+        private void ServiceDialogApply(Int32 myField)
+        {
+            // peek-via-hold: pull the next frame only when the slot is free (the queue has no peek)
+            if (_dialogPending == null && _socket != null)
+                _dialogPending = _socket.NextRemoteDialog();
+
+            if (_dialogPending == null)
+            {
+                // No queued frame. HOLD suppress only while the last-matched window is still open (lockstep
+                // wait for the host's next confirm); release the instant it closes. A dead host is caught by
+                // the engage gate (staleness / flag fall), so an open matched window needs no timeout here.
+                if (_dialogAlignKey >= 0 && IsAlignKeyWindowOpen(_dialogAlignKey))
+                    _dialogSuppressActive = true;
+                else
+                {
+                    _dialogSuppressActive = false;
+                    _dialogAlignKey = -1;
+                    _dialogLastAppliedSeq = -1;
+                }
+                return;
+            }
+
+            if (_dialogPending.Length < 8)
+            {
+                _dialogPending = null;               // malformed -- drop, try the next
+                return;
+            }
+            Int32 fld = _dialogPending[0] | (_dialogPending[1] << 8);
+            Int32 winnum = _dialogPending[2];
+            Int32 textId = _dialogPending[3] | (_dialogPending[4] << 8);
+            Byte kind = _dialogPending[5];
+            Int32 choiceIndex = _dialogPending[6];
+            Byte seq = _dialogPending[7];
+
+            if (fld != myField)
+            {
+                _dialogPending = null;               // stale/cross-field frame -- discard, try the next
+                return;
+            }
+
+            Int64 alignKey = DialogAlignKey(fld, winnum, textId);
+            Dialog d = ResolveOpenDialog(winnum, textId);
+
+            if (d != null)
+            {
+                // MATCHED: engage-on-first-match (S3). A new alignKey resets the per-key dedup + logs.
+                if (alignKey != _dialogAlignKey)
+                {
+                    _dialogAlignKey = alignKey;
+                    _dialogLastAppliedSeq = -1;
+                    _dialogRangeLogged = false;
+                }
+                _dialogSuppressActive = true;
+                _dialogWaitArmed = false;            // matched -> the hold clock is irrelevant
+                _dialogTimeoutLogged = false;
+
+                if (seq == _dialogLastAppliedSeq)    // dedup within this window (transport double-deliver)
+                {
+                    _dialogPending = null;
+                    return;
+                }
+                if (d.CurrentState != Dialog.State.CompleteAnimation)
+                {
+                    // still opening/printing: fast-forward the guest's typewriter (a no-op while opening)
+                    // and HOLD the frame -- next tick the window is CompleteAnimation and the SAME frame
+                    // applies (B6: one clean advance, never two page-skips).
+                    d.OnKeyConfirm(d.gameObject);
+                    return;
+                }
+                // CompleteAnimation: force the host's choice (bounds-checked) then drive the confirm.
+                if (kind == 1)
+                {
+                    if (d.TrySetCurrentChoice(choiceIndex))
+                        Log.Message("[NetSync] dialog lockstep: choice win " + winnum + " -> index " + choiceIndex);
+                    else if (!_dialogRangeLogged)
+                    {
+                        _dialogRangeLogged = true;
+                        Log.Message("[NetSync] dialog choice index " + choiceIndex + " out of range on field " + fld + " win " + winnum + " -- local default");
+                    }
+                }
+                d.OnKeyConfirm(d.gameObject);        // :770 re-reads ActiveButton=host index -> :772-773 Hide (page-turn/close)
+                _dialogLastAppliedSeq = seq;
+                _dialogPending = null;               // consumed
+                Log.Message("[NetSync] dialog lockstep: advanced win " + winnum + " (text " + textId + ")");
+            }
+            else
+            {
+                // NO matching open window yet (my copy hasn't opened / a different textId). HOLD + arm the
+                // timeout -- the load-bearing softlock escape for a lost/never-arriving frame. Do NOT set
+                // suppress: S3 keeps a window the host never drove fully local even transiently.
+                if (!_dialogWaitArmed)
+                {
+                    _dialogWaitArmed = true;
+                    _dialogWaitSince = Environment.TickCount;   // tick-baseline law: real tick, armed by the bool
+                }
+                else if (Environment.TickCount - _dialogWaitSince > DialogWaitMs)
+                {
+                    if (!_dialogTimeoutLogged)
+                    {
+                        _dialogTimeoutLogged = true;
+                        Log.Message("[NetSync] dialog frame for win " + winnum + "/text " + textId + " timed out -- local advance restored");
+                    }
+                    _dialogPending = null;           // discard the frame
+                    _dialogSuppressActive = false;   // disengage this alignKey -> local input restored
+                    _dialogAlignKey = -1;
+                    _dialogLastAppliedSeq = -1;
+                    _dialogWaitArmed = false;
+                }
+                // else: keep _dialogPending held; leave suppress at its prior state
+            }
+        }
+
+        // winnum-scoped resolve (RATIFIED): the specific open Dialog matching BOTH winnum AND textId --
+        // ~19% of fields hold two live windows at once. Read-only scan (returns before any OnKeyConfirm).
+        private static Dialog ResolveOpenDialog(Int32 winnum, Int32 textId)
+        {
+            DialogManager dm = null;
+            try
+            {
+                UIManager ui = PersistenSingleton<UIManager>.Instance;
+                dm = ui != null ? ui.Dialogs : null;
+            }
+            catch { dm = null; }
+            if (dm == null || dm.ActiveDialogList == null)
+                return null;
+            foreach (Dialog dialog in dm.ActiveDialogList)
+                if (dialog != null && dialog.Id == winnum && dialog.TextId == textId)
+                    return dialog;
+            return null;
+        }
+
+        private Boolean IsAlignKeyWindowOpen(Int64 alignKey)
+        {
+            Int32 winnum = (Int32)((alignKey >> 24) & 0xFF);
+            Int32 textId = (Int32)(alignKey & 0xFFFF);
+            return ResolveOpenDialog(winnum, textId) != null;
+        }
+
+        private static Int64 DialogAlignKey(Int32 fld, Int32 winnum, Int32 textId)
+        {
+            return ((Int64)(fld & 0xFFFF) << 32) | ((Int64)(winnum & 0xFF) << 24) | (Int64)(textId & 0xFFFF);
+        }
+
+        // Session-boundary reset for the L2 statics + per-window state (called from ResetIntentAndL1State,
+        // which OnDestroy + the redial/reconfigure path both run). _dialogSeq resets so a fresh session
+        // starts its dedup counter at 0.
+        private void ResetDialogLockstepState()
+        {
+            _dialogPending = null;
+            _dialogSuppressActive = false;
+            _dialogAlignKey = -1;
+            _dialogLastAppliedSeq = -1;
+            _dialogWaitArmed = false;
+            _dialogWaitSince = 0;
+            _dialogTimeoutLogged = false;
+            _dialogRangeLogged = false;
+            _dialogSeq = 0;
+        }
+
+        // SELFTEST BENCH (the ~ debug menu, gated IsSelfTestRole + BenchGates + the L1 toggle): fabricate a
+        // TypeDialog frame for `winnum`/`textId`, prove it round-trips the REAL codec (BuildFrame ->
+        // TryParseHeader), then push it into the SAME ServiceDialogApply path against the selftest field's
+        // own open window. No socket needed -- the codec IS the wire, exercised solo (B1-B6).
+        public static void DebugInjectDialogAdvance(Int32 winnum, Int32 textId, Int32 kind, Int32 choiceIndex)
+        {
+            NetSyncClient i = _instance;
+            if (i == null || !(IsSelfTestRole && NetSyncField.BenchGates) || DebugHostEventFlag == 0)
+            {
+                Log.Message("[NetSync] dialog bench: needs Role=selftest + the field-gate bench ON + the host-event (L1) flag ON");
+                return;
+            }
+            i.DebugInjectDialogAdvanceImpl(winnum, textId, kind, choiceIndex);
+        }
+
+        private void DebugInjectDialogAdvanceImpl(Int32 winnum, Int32 textId, Int32 kind, Int32 choiceIndex)
+        {
+            try
+            {
+                Int32 fld = FF9StateSystem.Common.FF9.fldMapNo;
+                Byte seq = _dialogSeq++;
+                Byte[] payload = new Byte[8];
+                payload[0] = (Byte)(fld & 0xFF);
+                payload[1] = (Byte)((fld >> 8) & 0xFF);
+                payload[2] = (Byte)(winnum & 0xFF);
+                payload[3] = (Byte)(textId & 0xFF);
+                payload[4] = (Byte)((textId >> 8) & 0xFF);
+                payload[5] = (Byte)(kind & 0xFF);
+                payload[6] = (Byte)(choiceIndex & 0xFF);
+                payload[7] = seq;
+                // round-trip the REAL frame codec, exactly as a peer would receive it
+                Byte[] frame = NetSyncWire.BuildFrame(NetSyncWire.TypeDialog, payload);
+                Byte type;
+                Int32 len;
+                if (!NetSyncWire.TryParseHeader(frame, out type, out len) || type != NetSyncWire.TypeDialog || len != 8)
+                {
+                    Log.Message("[NetSync] dialog bench: codec round-trip FAILED");
+                    return;
+                }
+                Byte[] body = new Byte[len];
+                Array.Copy(frame, NetSyncWire.HeaderSize, body, 0, len);
+                Log.Message("[NetSync] dialog bench: fabricated TypeDialog win " + winnum + " text " + textId + " kind " + kind + " idx " + choiceIndex + " seq " + seq + " -- applying");
+                // push into the SAME apply path (the one-slot peek holder); the ongoing selftest
+                // ServiceDialogLockstep re-checks a held frame each frame (so B5's timeout is provable solo).
+                _dialogPending = body;
+                ServiceDialogApply(fld);
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] dialog bench failed");
+            }
+        }
+
