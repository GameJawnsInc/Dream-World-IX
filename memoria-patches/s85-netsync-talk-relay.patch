+        // ===== F3.1 TALK RELAY =============================================================================
+
+        private static Byte[] TalkSectionBody(Int32 fld, Int32 uid, Byte nonce)
+        {
+            return new Byte[] { (Byte)(fld & 0xFF), (Byte)((fld >> 8) & 0xFF), (Byte)(uid & 0xFF), (Byte)((uid >> 8) & 0xFF), nonce };
+        }
+
+        // HOST tap (EventCollision.CheckNPCInput / CheckQuadInput, at the Request accept): stamp the start,
+        // push the state frame out-of-band so it leaves at the press, not the next 7 Hz tick. Role-gated
+        // first, never throws -- vanilla and a guest are untouched.
+        internal static void EmitTalkStartIfHost(Int32 uid)
+        {
+            try
+            {
+                NetSyncClient i = _instance;
+                if (_role != "host" || i == null || i._socket == null)
+                    return;
+                Int32 fld = FF9StateSystem.Common.FF9.fldMapNo;
+                if (fld <= 0 || uid < 0 || uid > 0xFFFF)
+                    return;
+                i._talkField = fld;
+                i._talkUid = uid;
+                i._talkNonce = (Byte)(i._talkNonce + 1);
+                i._talkSince = Environment.TickCount;
+                Byte[] frame = i.BuildStateFrame();
+                if (frame != null)
+                    i._socket.SetLocalState(frame);
+                Log.Message("[NetSync] talk relay: host started obj " + uid + " on field " + fld + " (nonce " + i._talkNonce + ")");
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] talk-relay emit failed");
+            }
+        }
+
+        // GUEST tick (and the selftest bench): apply a fresh relayed start on MY copy of the same field.
+        // DEFERS (does not mark the nonce seen) while I am on another field, mid-menu or mid-battle -- the
+        // follow-warp is bringing me there, and the host's TTL retires a start I arrive too late for.
+        private void ServiceTalkFollow(RemoteState rs, Int32 myField, Boolean onField)
+        {
+            Byte[] body = null;
+            Boolean bench = false;
+            if (_role == "client")
+            {
+                if (_socket == null || !_followHost || _followWarpPending >= 0)
+                    return;
+                Byte[] state = _socket.GetRemoteState();
+                if (state == null || !NetSyncState.TryReadSection(state, NetSyncState.SectionTalk, out body) || body == null || body.Length < 5)
+                    return;
+            }
+            else if (IsSelfTestRole && NetSyncField.BenchGates && _talkPending != null)
+            {
+                body = _talkPending;
+                bench = true;
+            }
+            else
+                return;
+            try
+            {
+                Int32 fld = body[0] | (body[1] << 8);
+                Int32 uid = body[2] | (body[3] << 8);
+                Int32 nonce = body[4];
+                if (nonce == _lastTalkNonce)
+                {
+                    if (bench) _talkPending = null;
+                    return;
+                }
+                if (!onField || fld != myField)
+                {
+                    if (bench) _talkPending = null;      // a bench frame for another field is just wrong -- drop it
+                    return;                              // live: DEFER
+                }
+                if (!bench && !(rs.Valid && rs.Field == myField))
+                    return;                              // co-located only (the peer lane must agree on the field)
+                UIManager ui = PersistenSingleton<UIManager>.Instance;
+                if (ui == null || ui.State != UIManager.UIState.FieldHUD)
+                    return;                              // DEFER: mid-menu / mid-battle
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                if (ee == null)
+                    return;
+                _lastTalkNonce = nonce;
+                if (bench) _talkPending = null;
+                ApplyTalkStart(ee, uid, bench ? (Vector3?)null : rs.Pos);
+            }
+            catch (Exception err)
+            {
+                Log.Error(err, "[NetSync] talk-relay tick failed");
+            }
+        }
+
+        // The replay itself: the SAME three steps CheckNPCInput performs after its distance/angle checks --
+        // listener, Request(obj, 1, 3) -- on my own copy of the object. Snaps to the host first on a live
+        // link so the camera and the NPC's facing match the host's screen.
+        private void ApplyTalkStart(EventEngine ee, Int32 uid, Vector3? snapTo)
+        {
+            Obj obj = ee.FindObjByUID(uid);
+            if (obj == null)
+            {
+                Log.Message("[NetSync] talk relay: no object with uid " + uid + " on this field -- ignored");
+                return;
+            }
+            Actor actor = ee.GetControlChar() as Actor;
+            if (actor == null)
+            {
+                Log.Message("[NetSync] talk relay: no controlled actor -- ignored");
+                return;
+            }
+            if (snapTo.HasValue && SnapToHost(ee, snapTo.Value))
+                Log.Message("[NetSync] talk relay: snapped to the host first");
+            actor.listener = obj.uid;
+            if (ee.Request(obj, 1, 3, false))
+                Log.Message("[NetSync] talk relay: started obj " + uid + " (tag 3) on my copy of field " + FF9StateSystem.Common.FF9.fldMapNo);
+            else
+                Log.Message("[NetSync] talk relay: Request refused for obj " + uid + " (busy, or no tag-3 handler) -- ignored");
+        }
