+            else if (!NetSyncField.BenchGates)
+                why = "netsync talk: the field-gate bench is OFF (netsync bench 1)";
+            else if (uid < 0 || uid > 0xFFFF)
+                why = "netsync talk: uid " + uid + " is outside 0..65535";
+            if (why != null)
