+                        Boolean coll = !debug && !((player.flags & 4) != 0 && (flags & 2) != 0);
+                        Int32 r = 4 * (actor.collRad + player.collRad);
+                        Num(sb, "r", r); sb.Append(",");
+                        Bool(sb, "solid", coll && (neverReleases || (flags & 16) != 0)); sb.Append(",");
+                        Bool(sb, "coll", coll); sb.Append(",");
+                        // WalkMesh.Collision, (mode & 6) != 0: both searches add the object's speed + 60.
+                        if (coll && hasRange)
