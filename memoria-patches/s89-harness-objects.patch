+                        sb.Append(",");
+                        if (!debug && hasTalk && (flags & 8) == 0)
+                            Num(sb, "talk_r", 4 * (actor.talkRad + player.talkRad) + actor.speed + 60);
+                        else
+                            sb.Append("\"talk_r\":null");
+                        sb.Append(",");
+                    }
+                    // The renderer gate (ProcessEvents SetRenderer): it only drives a GameObject that carries a
+                    // HonoBehavior, and enables a mesh only while HideMesh has not set its meshflags bit.
