+                throw new ArgumentException("opposite directions cancel to no direction");
+            // A physical stick or key over the threshold walks him whatever the harness holds (see PhysicalAxis).
+            // Mid-turn the same test CUTS the turn (ServiceTurn), and turn_end's `moved` is the witness for the
+            // frame the cut can take to land.
+            Single stick = PhysicalAxis();
+            if (stick > Memoria.Configuration.AnalogControl.StickThreshold)
+                throw new InvalidOperationException("a physical stick or key is pushing the axis (|a| "
+                    + stick.ToString("0.###", CultureInfo.InvariantCulture) + ") -- MovePC's axis branch would walk him");
+            // A pending click-to-move path: the turn keys clear the target (:643-644, ClearMoveTargetAndPath keeps
+            // movePaths) and each call under control pops the next leg (:648-657) -- the turn would consume a walk
+            // the player asked for.
+            if (ctrl.hasTarget || (ctrl.movePaths != null && ctrl.movePaths.Count > 0))
+                throw new InvalidOperationException("a click-to-move path is pending -- the turn keys would consume it");
+            // Standing, the one branch of a zero-step MovePC that can shove him is the object test at :765:
+            // overlapping a collidable body he now faces, the push-out (:772-793) shoves him clear. A blocked press
+            // does the same; standing never runs it. Asked with the engine's own mode-0 query (WalkMesh.cs:899-965,
+            // a pure read) at his current position. A body that walks into him mid-turn is not caught here --
+            // turn_end's `moved` is the witness for that. (Not refused, and also witnessed by `moved`: MovePC's own
+            // UpdateActiveTri (:795) re-projects him onto his triangle BEFORE ServiceChar -- float noise, twice a
+            // call with UpdateMovement's own (:366), so it builds over a turn and grows with the coordinates: a
+            // float32 emulation of a 16-call turn put its worst at 0.075u at +-16000 and 0.18u at +-30000 -- so
+            // ServiceChar's walkmesh pass (:950-1010) runs on that noise where standing's never does, exactly as for
+            // a blocked press; at a spot closer to a walkmesh edge than his radius, its edge force can move him
