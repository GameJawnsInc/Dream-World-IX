+            // (FieldMapActorController.cs:710-711) and nothing zeroes it -- the threshold test (:736-737) sits
+            // inside the analog block.
+            if (!Memoria.Configuration.AnalogControl.Enabled)
+                throw new InvalidOperationException("[AnalogControl] Enabled=0 -- MovePC's key path would step him,"
+                    + " not turn him");
+            // A direction held by hold/press feeds the axis, and the axis wins MovePC's branch (:693-697): the turn
+            // keys would only steer that walk. So no direction may be down NOW or on any later frame -- the start
+            // below is read this frame, and this frame's tick can run after the agent's Update (the FRAME MODEL
+            // note), so a key down on its last frame would step and turn him after the snapshot. Composing, the
+            // turn's own keys are exempt (no other direction can be down then: this refusal, and ClaimForMove, its
+            // mirror).
+            Boolean fresh = _turnFrom < 0;
