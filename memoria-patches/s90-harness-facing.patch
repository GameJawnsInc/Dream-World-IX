+        // `turn`. Refusals throw (the per-request error latch) and NOTHING is written unless every check passed:
+        // the start is read into locals, every refusal runs, and only then is the turn committed.
+        private static void BeginTurn(Int32 mask, Int32 frames)
+        {
+            PosObj po;
+            FieldMapActorController ctrl;
+            String why = TurnBlocker(out po, out ctrl);
+            if (why != null)
+                throw new InvalidOperationException("needs a field with a controlled player under user control ("
+                    + why + ")");
+            Int32 f = Time.frameCount;
+            Int32 field = Try(() => (Int32)FF9StateSystem.Common.FF9.fldMapNo, -1);
+            Single x = Try(() => po.pos[0], Single.NaN);
+            Single y = Try(() => po.pos[1], Single.NaN);
+            Single z = Try(() => po.pos[2], Single.NaN);
+            Single yaw = Try(() => po.rotAngle[1], Single.NaN);
+            if (field < 0 || Single.IsNaN(x) || Single.IsNaN(y) || Single.IsNaN(z) || Single.IsNaN(yaw))
+                throw new InvalidOperationException("the player's field, position or facing is unreadable");
+            // A turn composes onto another only while that one's keys are down. Once they are up (this very frame
+            // included: the queue drains before ServiceTurn sees the lift) the field is still judging it, and
+            // folding a new turn in would swallow its turn_end and merge two turns' yaw0/frames/moved.
+            if (_turnFrom >= 0 && (_turnLift >= 0 || TurnKeysFrom(f) == 0))
+                throw new InvalidOperationException("the last turn's keys are up and the field is still judging it"
+                    + " -- wait for its turn_end");
+            // Composing onto a turn in progress needs the SAME actor on the same field: after a same-id reload or a
+            // control hand-off, ServiceTurn cuts that turn this very frame and would take these keys with it.
+            if (_turnFrom >= 0 && (po != _turnPo || field != _turnField))
+                throw new InvalidOperationException("the turn in progress began on another actor or field -- it is cut"
+                    + " this frame; turn again after its turn_end");
