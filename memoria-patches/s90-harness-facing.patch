+                        + " lift) first");
+            }
+            // Opposite keys cancel in the key branch (:700-707) to a ZERO vector, whose atan2(-0,-0) at :751 is
+            // -180 degrees -- a facing nobody pressed for.
+            Int32 all = TurnKeysFrom(f + 1) | mask;
