+        // Once per armed frame, after the queue. A turn is a FIELD verb under control and it ends the moment the
+        // field stops honouring it: MovePC already ignores the keys then, but they would stay DOWN for the rest of
+        // their frames -- into a choice window, a menu, the next field. Beyond TurnBlocker it is cut when the
+        // field id or the controlled ACTOR changes (a same-id reload, or a script handing control to another
+        // character, keeps the id) and when a physical stick crosses the threshold ("axis": he would walk).
+        // Once the keys lift the report stays open for TurnSettlePasses event passes (see _turnLift) under the
+        // same tests: one that trips then is the field taking him on the final facing -- a door gate that fires
+        // runs DisableMove (DoEventCode.cs:1046-1062) in the pass that reads it, so it shows as `control` -- and
+        // `ended` means the field ran its passes on that facing and did not. Never throws.
+        private void ServiceTurn()
+        {
+            Int32 f = Time.frameCount;
+            if (_turnFrom < 0)
+            {
+                // No report open: nothing, or a cut turn whose keys lift this frame. Once every key is up its
+                // bits are stale.
+                if (_turnMask != 0 && TurnKeysFrom(f) == 0)
+                    _turnMask = 0;
+                return;
+            }
+            Boolean down = TurnKeysFrom(f) != 0;
+            if (!down && _turnLift < 0)
+            {
+                // The keys lifted: the facing is final, and the field's next pass reads it.
+                _turnLift = f;
+                _turnMask = 0;              // every turn key is up: the bits are stale
+                _turnPasses = 0;
+                _turnPassMark = Try(() => EventEngine.LastProcessTime, 0f);
+            }
+            PosObj po;
+            FieldMapActorController ctrl;
+            String why = TurnBlocker(out po, out ctrl);
+            if (why == null && Try(() => (Int32)FF9StateSystem.Common.FF9.fldMapNo, -1) != _turnField)
+                why = "field";
+            if (why == null && po != _turnPo)
+                why = "player";
+            if (why == null && PhysicalAxis() > Memoria.Configuration.AnalogControl.StickThreshold)
+                why = "axis";
+            if (why == null)
+            {
+                if (down)
+                    return;
+                Single mark = Try(() => EventEngine.LastProcessTime, _turnPassMark);
+                if (mark != _turnPassMark)
+                {
+                    _turnPassMark = mark;
+                    _turnPasses++;
+                }
+                if (_turnPasses < TurnSettlePasses)
+                    return;
+                why = "ended";
+            }
+            if (!down)
+            {
+                EndTurn(why, _turnLift - _turnFrom);
+                return;
+            }
+            // Lift every turn key by the `release` rule (A RELEASE MUST NEVER PRESS): a key that is down gets its Up
+            // on the next frame, a key not yet down is cleared. The keys are still down on THIS frame, so the turn
+            // held them for f + 1 - _turnFrom frames.
+            for (Int32 i = (Int32)Control.Up; i <= (Int32)Control.Right; i++)
+            {
+                if ((_turnMask & (1 << i)) == 0 || _upFrame[i] <= f)
+                    continue;
+                if (f >= _downFrame[i])
+                    _upFrame[i] = f + 1;
+                else
+                {
+                    _downFrame[i] = -1;
+                    _upFrame[i] = -1;
+                }
+            }
+            EndTurn(why, f + 1 - _turnFrom);
+        }
