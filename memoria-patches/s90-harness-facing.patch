+        // `up`, `up+right`, ... -- ParseControl's names and aliases, directions only.
+        private static Int32 ParseTurnDirections(String arg)
+        {
+            if (String.IsNullOrEmpty(arg))
+                throw new ArgumentException("needs a direction (up|down|left|right, '+'-joined)");
+            Int32 mask = 0;
+            foreach (String part in arg.Split('+'))
+            {
+                Control c = ParseControl(part);
+                if (c != Control.Up && c != Control.Down && c != Control.Left && c != Control.Right)
+                    throw new ArgumentException("'" + part + "' is not a direction (up|down|left|right, '+'-joined)");
+                mask |= 1 << (Int32)c;
+            }
+            return mask;
+        }
+
+        // Why the field would not honour a turn right now, as a token -- null when it would. The gates a held key
+        // already meets on its way to the facing, in MovePC's own terms (FieldMapActorController.cs):
+        //   field     gMode 1 and the field scene;
+        //   player    a controlled actor (GetControlChar, EventEngine.cs:425-431) whose controller runs MovePC at
+        //             all (isPlayer, :324);
+        //   control   user control (MovePC masks every key with it, :636-642);
+        //   movement  no movement pad-mask and no battle backup position (MovePC returns at :586; HonoUpdate at
+        //             :170-173);
+        //   actor     the actor is running (MovePC returns at :588);
+        //   hud       the field HUD. UIKeyTrigger.GetKey answers false for every key outside FieldHUD, WorldHUD,
+        //             BattleHUD, QuadMistBattle and the EndGame scene (UIKeyTrigger.cs:94-95); FieldHUD alone is
+        //             this verb's own, stricter rule.
+        // Never throws: it runs from Update, where a throw FAULTS the agent.
+        private static String TurnBlocker(out PosObj po, out FieldMapActorController ctrl)
+        {
+            po = null;
+            ctrl = null;
+            try
+            {
+                EventEngine ee = PersistenSingleton<EventEngine>.Instance;
+                if (ee == null || ee.gMode != 1 || !SceneDirector.IsFieldScene())
+                    return "field";
+                po = ee.GetControlChar();
+                Actor actor = po as Actor;
+                ctrl = actor != null ? actor.fieldMapActorController : null;
+                if (ctrl == null || !ctrl.isPlayer)
+                    return "player";
+                if (!ee.GetUserControl())
+                    return "control";
+                if (!EventInput.IsMovementControl || (ctrl.fieldMap != null && ctrl.fieldMap.isBattleBackupPos))
+                    return "movement";
+                if (po.state != EventEngine.stateRunning)
+                    return "actor";
+                if (PersistenSingleton<UIManager>.Instance.State != UIManager.UIState.FieldHUD)
+                    return "hud";
+                return null;
+            }
+            catch (Exception)
+            {
+                po = null;
+                ctrl = null;
+                return "unreadable";
+            }
+        }
+
+        // |axis| from a PHYSICAL stick or key (or the mouse's virtual analog) -- the value MovePC compares with the
+        // stick threshold (FieldMapActorController.cs:601-608). A turn is in place only while it stays at or under
+        // the threshold: above it `analogMove` is true, the axis branch wins (:693-697) and the step is not zeroed
+        // (:736-737) -- he WALKS. Readable only while the harness pushes no axis of its own (GetAxis answers with
+        // TryGetAxis's vector first, HonoInputManager.cs:951-957): -1 then, and when unreadable.
+        private static Single PhysicalAxis()
+        {
+            Vector2 own;
+            if (TryGetAxis(out own))
+                return -1f;
+            return Try(() => PersistenSingleton<HonoInputManager>.Instance.GetAxis().magnitude, -1f);
+        }
