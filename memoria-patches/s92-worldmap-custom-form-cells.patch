diff --git a/Assembly-CSharp/Memoria/World/CustomFormCells.cs b/Assembly-CSharp/Memoria/World/CustomFormCells.cs
new file mode 100644
index e69de29..c950949 100644
--- /dev/null
+++ b/Assembly-CSharp/Memoria/World/CustomFormCells.cs
@@ -0,0 +1,138 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using Memoria.Prime;
+using NCalc;
+
+namespace Memoria.World
+{
+    // [ff9mapkit s92] Dream World IX -- STORY TERRAIN ON ANY CELL (terrain study P1; the forms lane's F15 sketch).
+    //
+    // Stock FF9 swaps exactly 26 cells between two block forms (ff9.w_worldChangeBlockSet: 9 places, decided by
+    // WorldConfiguration.UsePlaceAlternateForm or a mod's Environment.txt). Every other cell is baked IsSwitchable =
+    // false with no form-2 parts, so WMBlock.SetForm is a no-op there and no data file could change that.
+    //
+    // This makes any cell switchable from DATA, adding no serialized field (WMBlock and WMWorld are baked):
+    //   * ARM (WMWorld.Initialize, before any block loads): a cell that is not stock-switchable and has a loose
+    //     "Block[x][y] Terrain2.ff9mesh" override in the active override namespace is set IsSwitchable at runtime.
+    //   * LOAD (WMWorld.LoadBlock): an armed cell registers a second copy of its form-1 terrain under the child name
+    //     "Terrain2" -- the s34 key, so the loose Terrain2 replaces it, render and walk -- and keeps its form-1 Object
+    //     in form 2 too (stock registers it for form 1 only), unless a loose "Object2" override replaces it there.
+    //   * SWITCH (end of ff9.w_worldChangeBlockSet, once per world load like the stock places): an armed cell whose
+    //     "Block[x][y] Form.txt" sidecar holds an NCalc condition that evaluates true switches to form 2. It is
+    //     evaluated like an Environment.txt [Condition=...] (WorldDisc, ScenarioCounter, GetEventGlobalByte(i), ...).
+    //     No Form.txt, or a condition that throws, = form 1 (logged).
+    // Identity-safe: with no Terrain2 file on a non-stock cell nothing is armed and every load is stock. The 26 stock
+    // cells are never touched: their own form 2 and Place condition rule them.
+    public static class CustomFormCells
+    {
+        private const Int32 GridX = 24;
+        // x + y * GridX -> the cell's Form.txt condition (null: none)
+        private static readonly Dictionary<Int32, String> Armed = new Dictionary<Int32, String>();
+
+        public static Boolean IsArmed(Int32 x, Int32 y)
+        {
+            return Armed.ContainsKey(x + y * GridX);
+        }
+
+        // Does a loose override of this part exist for the cell (e.g. "Object2")?
+        public static Boolean HasPart(Int32 overrideDisc, Int32 x, Int32 y, String part)
+        {
+            return WorldMeshOverride.Exists(Key(overrideDisc, x, y, part));
+        }
+
+        public static void Arm(WMBlock[,] blocks, Int32 overrideDisc)
+        {
+            Armed.Clear();
+            if (blocks == null)
+                return;
+            for (Int32 x = 0; x < blocks.GetLength(0); x++)
+            {
+                for (Int32 y = 0; y < blocks.GetLength(1); y++)
+                {
+                    WMBlock block = blocks[x, y];
+                    if (block == null || block.IsSwitchable || !HasPart(overrideDisc, x, y, "Terrain2"))
+                        continue;
+                    String condition = ReadCondition(overrideDisc, x, y);
+                    block.IsSwitchable = true;
+                    Armed[x + y * GridX] = condition;
+                    Log.Message("[CustomFormCells] armed Block[" + x + "][" + y + "] (Disc" + overrideDisc
+                        + "): it has a loose Terrain2, and switches to it when "
+                        + (condition ?? "<no Form.txt: never>"));
+                }
+            }
+        }
+
+        public static void SetForms()
+        {
+            foreach (KeyValuePair<Int32, String> cell in Armed)
+            {
+                Int32 x = cell.Key % GridX;
+                Int32 y = cell.Key / GridX;
+                if (!Evaluate(cell.Value, x, y))
+                    continue;
+                global::ff9.mw_worldSetFormBit(x, y);
+                Log.Message("[CustomFormCells] Block[" + x + "][" + y + "] switched to form 2 (" + cell.Value + ")");
+            }
+        }
+
+        private static Boolean Evaluate(String condition, Int32 x, Int32 y)
+        {
+            if (String.IsNullOrEmpty(condition))
+                return false;
+            try
+            {
+                Expression c = new Expression(condition);
+                c.EvaluateFunction += NCalcUtility.commonNCalcFunctions;
+                c.EvaluateParameter += NCalcUtility.commonNCalcParameters;
+                c.EvaluateParameter += NCalcUtility.worldNCalcParameters;
+                return NCalcUtility.EvaluateNCalcCondition(c.Evaluate());
+            }
+            catch (Exception ex)
+            {
+                Log.Error("[CustomFormCells] Block[" + x + "][" + y + "] Form.txt: cannot evaluate '" + condition
+                    + "' (" + ex.Message + "); the cell stays in form 1");
+                return false;
+            }
+        }
+
+        // The first line of the highest-priority "Block[x][y] Form.txt" that is neither blank nor a comment (# or //),
+        // or null. Same folder search and base key as WorldMeshOverride.TryReadDonorPath.
+        private static String ReadCondition(Int32 overrideDisc, Int32 x, Int32 y)
+        {
+            if (AssetManager.FolderHighToLow == null)
+                return null;
+            String rel = AssetManagerUtil.GetResourcesAssetsPath(true) + "/" + Key(overrideDisc, x, y, "Form") + ".txt";
+            foreach (AssetManager.AssetFolder folder in AssetManager.FolderHighToLow)
+            {
+                if (folder == null || String.IsNullOrEmpty(folder.FolderPath))
+                    continue;
+                String full = folder.FolderPath + rel;
+                if (!File.Exists(full))
+                    continue;
+                try
+                {
+                    foreach (String line in File.ReadAllLines(full))
+                    {
+                        String s = line.Trim();
+                        if (s.Length > 0 && !s.StartsWith("#") && !s.StartsWith("//"))
+                            return s;
+                    }
+                    Log.Error("[CustomFormCells] empty Form.txt: " + full);
+                    return null;
+                }
+                catch (Exception ex)
+                {
+                    Log.Error("[CustomFormCells] failed Form.txt " + full + ": " + ex.Message);
+                    return null;
+                }
+            }
+            return null;
+        }
+
+        private static String Key(Int32 disc, Int32 x, Int32 y, String part)
+        {
+            return String.Format("WorldMap/Disc{0}/0_1/r{1}/Block[{2}][{3}] {4}", disc, y, x, y, part);
+        }
+    }
+}
