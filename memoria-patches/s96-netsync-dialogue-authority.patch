+        private static String InboxScript()
+        {
+            NetSyncDialog d = new NetSyncDialog();
+            const Int32 T0 = 3000000;
+            Byte[] seqs = { 254, 255, 255, 0, 1 };
+            for (Int32 k = 0; k < seqs.Length; k++)
+                d.IngestQuiet(Frame(5, 3, 40 + (k % 2), 0, 0, seqs[k]), 1, T0);
+            if (d._inbox.Count != 4)
+                return "inbox: the repeated seq was not dropped (" + d._inbox.Count + " queued)";
+            for (Int32 k = 1; k < d._inbox.Count; k++)
+                if (d._inbox[k].Seq <= d._inbox[k - 1].Seq)
+                    return "inbox: the u8 wrap did not unwrap monotonically";
