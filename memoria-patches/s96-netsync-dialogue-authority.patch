+            w.Field = 5;
+            w.Id = 3;
+            w.TextId = 41;
+            DlgEvent head = d.EarliestFor(w);
+            if (head == null || head.Raw != 255)
+                return "inbox: the per-key FIFO head is not the earliest event of that key";
+            for (Int32 k = 0; k < InboxCap + 8; k++)
+                d.IngestQuiet(Frame(5, 3, 40, 0, 0, (Byte)(2 + k)), 1, T0);
+            if (d._inbox.Count != InboxCap)
+                return "inbox: the cap did not hold (" + d._inbox.Count + ")";
+            // the relay-accept purge drops only EARLIER scenes: the accepted talk's own scene and later ones stay
+            if (!SceneBefore(3, 5) || SceneBefore(5, 5) || SceneBefore(6, 5) || !SceneBefore(255, 1) || SceneBefore(1, 255)
+                || !SceneBefore(-1, 5) || SceneBefore(3, -1))
+                return "inbox: the scene order is not wrap-aware";
+            NetSyncDialog p = new NetSyncDialog();
+            p._quiet = true;
+            p.Ingest(Frame(5, 3, 40, 0, 0, 10), 4, T0);
+            p.Ingest(Frame(5, 3, 40, 0, 0, 11), 5, T0);
+            p.Ingest(Frame(5, 3, 40, 0, 0, 12), 6, T0);
+            p.Ingest(Frame(5, 3, 40, 0, 0, 13), -1, T0);
+            p.PurgeAtRelayAccept(5);
+            if (p._inbox.Count != 2 || p._inbox[0].Scene != 5 || p._inbox[1].Scene != 6)
+                return "inbox: the relay-accept purge did not keep exactly the talk's scene and later (" + p._inbox.Count + " kept)";
+            return null;
+        }
+
+        private static Byte[] Frame(Int32 fld, Int32 win, Int32 text, Byte kind, Byte idx, Byte seq)
+        {
+            return new Byte[] { (Byte)(fld & 0xFF), (Byte)((fld >> 8) & 0xFF), (Byte)win, (Byte)(text & 0xFF), (Byte)((text >> 8) & 0xFF), kind, idx, seq };
+        }
+
+        // Ingest without the per-event log lines (SelfTest only -- it pushes ~75 synthetic frames).
+        private void IngestQuiet(Byte[] f, Int32 scene, Int32 now)
+        {
+            _quiet = true;
+            try { Ingest(f, scene, now); }
+            finally { _quiet = false; }
+        }
+    }
+}
