+using System;
+using System.Collections.Generic;
+using Memoria.Prime;
+
+namespace Memoria.Netsync
+{
+    // [ff9mapkit netsync F3.2] C2 S-SYNC core -- HOST-AUTHORITATIVE DIALOGUE on a following guest
+    // (studies/field-coop/F3.2-DESIGN.md "sync_changes", S1-S8). NetSyncClient owns ONE instance (_dlg) and
+    // only FEEDS it: the wire reads, the session predicate and the relay-accept edge stay there (they need its
+    // privates); everything about WINDOWS lives here --
+    //   * the window tracker: every lockable ETb window on the guest, keyed by reference + Id + TextId
+    //     (dialogs are pooled), classed Locked (the host drives it), Orphaned (the host provably lacks it:
+    //     auto-closed at reading pace) or Local (handed back, or it predates the lock);
+    //   * the event inbox: the host's type-7 taps normalized to DlgEvent, seq-ordered, capped at 64, applied
+    //     per window KEY (fld, win, text) in host order -- an event for a window the guest never opens blocks
+    //     nothing (DLG-2/WIRE-4), and nothing is ever drained while the session holds (DLG-3);
+    //   * the orphan rule, the chip text, the helpers, and a pure SelfTest of the two state machines.
+    // THE LOCK LAW: a lockable window is locked from the frame it opens (an UNTRACKED window counts as locked)
+    // and is released ONLY by host state -- a host event, the orphan rule (the host settled and idle), the
+    // link dead for LinkGraceMs, the session ending, or the deliberate ~ menu unlock. Never by a guest-side
+    // timeout and never by guest input. Main thread only, except IsLocal (copy-on-write, see _local).
+    internal sealed class NetSyncDialog
+    {
+        // ---- tuning (owner decision 9 -- every value is a playtest seed, not a law) ----------------------
+        internal const Int32 SceneFallMs = 500;        // HOST: control back this long ends the sticky scene
+        internal const Int32 LinkGraceMs = 3000;       // GUEST: the lock outlives a dead-reading session this long
+        internal const Int32 MinShowMs = 350;          // a host event never pages a line shown for less (catch-up)
+        internal const Int32 PendingTtlMs = 20000;     // an event its window is not waiting on ages out after this
+        internal const Int32 OrphanGraceMs = 2000;     // the host must read settled this long before an orphan
+        internal const Int32 AutoReadMs = 2000;        // an orphaned page stays up this long before its auto-confirm
+        internal const Int32 HostElsewhereMs = 5000;   // host on another field (no intent here) this long = settled
+        internal const Int32 OffFieldMaxMs = 20000;    // host off-field (no live battle) this long = settled
+        internal const Int32 RelayOwnMs = 3000;        // a just-accepted relayed start claims every locked window
+        private const Int32 InboxCap = 64;
+
+        internal const Byte KindAdv = 0;               // a confirm page-turn or close (incl. the host's VA dismiss)
+        internal const Byte KindCho = 1;               // a choice-committing confirm
+
+        internal const Byte ClsLocked = 0, ClsOrphaned = 1, ClsLocal = 2;
+
+        // The chip (S5 step 8), drawn by NetSyncClient.OnGUI and published to the harness. No emoji.
+        internal const String ChipHiccup = "Co-op: link hiccup -- holding this conversation for the host";
+        internal const String ChipClosing = "Co-op: this line isn't on the host's screen -- closing it";
+        internal const String ChipFollowing = "Co-op: following the host's conversation";
+        internal const String ChipHostScene = "Co-op: the host is in a scene";
+
+        // One host event, normalized at ingest. Seq orders + dedups; Raw is the host's own u8 seq -- the value
+        // its "dialog tap" log line prints, so every guest close can be matched to the host press by grep.
+        internal sealed class DlgEvent
+        {
+            public Int32 Seq;
+            public Byte Raw;
+            public Byte Kind;
+            public Int32 Scene;            // the host's section-5 scene nonce at ingest (-1 = none on the lane)
+            public Int32 Fld, Win, Text, C;
+            public Int32 FirstSeen;        // ingest tick (a real tick; read by delta only)
+            public Boolean Tried;          // applied at least once without advancing its window
+            public Boolean TriedLogged;
+            public Boolean FallbackLogged;
+        }
+
+        private sealed class Win
+        {
+            public Dialog D;
+            public Int32 Field, Id, TextId;
+            public Byte Cls;
+            public Int32 Page;             // CurrentPage at the last sample (a page turn re-arms the read clock)
+            public Boolean CompleteArmed;  // guards CompleteSince (tick-baseline law)
+            public Int32 CompleteSince;
+            public Int32 OrphanSince;      // read only while Cls == ClsOrphaned
+            // OUR apply (a host event / the orphan rule) was the confirm that CLOSED it, so its departure is ours. Set
+            // only by a closing confirm that advanced -- a host page turn does not, so a later close by the window's
+            // own script/timer (or a leaked input) is still logged as such (the box-16 / A1 close audit).
+            public Boolean ClosedByUs;
+            public Boolean Seen;           // mark-and-sweep against the live list
+            public Boolean RetryLogged;    // orphan auto-confirm: one "did not advance" line
+        }
+
+        // A Local mark. The array is COPY-ON-WRITE: built whole on the main thread and published by one
+        // volatile reference swap, never mutated after -- so VoicePlayer's off-thread IsGuestLockedDialog read
+        // always sees a complete array (S4, the threading risk).
+        private sealed class Mark
+        {
+            public readonly Dialog D;
+            public readonly Int32 Id, TextId;
+            public Mark(Dialog d, Int32 id, Int32 textId) { D = d; Id = id; TextId = textId; }
+        }
+
+        private static readonly Mark[] NoMarks = new Mark[0];
+        private readonly List<DlgEvent> _inbox = new List<DlgEvent>(16);
+        private readonly List<Win> _wins = new List<Win>(4);
+        private volatile Mark[] _local = NoMarks;
+        private readonly SettleClock _settle = new SettleClock();
+        private Boolean _haveSeq;              // the seq unwrap's baseline is set
+        private Byte _lastRaw;
+        private Int32 _lastSeq;
+        private Boolean _capLogged;            // one "inbox hit its cap" line per overflow episode
+        private Int32 _orphanCloses;           // windows the orphan rule closed this session (telemetry)
+        private String _chip;
+        private Boolean _quiet;                // SelfTest's synthetic ingest: no per-event log lines
+
+        internal String Chip { get { return _chip; } }
+        internal Int32 OrphanCloses { get { return _orphanCloses; } }
+        internal Int32 HostSettledMs { get { return _settle.SettledMs; } }
+        internal Int32 InboxCount { get { return _inbox.Count; } }
+
+        // ---- helpers ------------------------------------------------------------------------------------
+
+        // An ETb field line: UI dialogs carry Id 9 + IsETbDialog=false (DialogManager.cs:83/:89) and TextId -1 --
+        // never a script's window (DLG-8). A MANAGED null test on purpose: VoicePlayer calls this off the main
+        // thread, where Unity's overloaded == may not run (dialogs are pooled, never destroyed).
+        internal static Boolean IsLockable(Dialog d)
+        {
+            return !ReferenceEquals(d, null) && d.IsETbDialog && d.Id != DialogManager.UIDialogId && d.TextId >= 0;
+        }
+
+        // Any ETb line open (includeInh = count FlagButtonInh windows too). Allocation-free scan of the live
+        // list (no ToList). Main thread only.
+        internal static Boolean AnyEtbLine(Boolean includeInh)
+        {
+            List<Dialog> list = LiveList();
+            if (list == null)
+                return false;
+            for (Int32 k = 0; k < list.Count; k++)
+            {
+                Dialog d = list[k];
+                if (IsLockable(d) && (includeInh || !d.FlagButtonInh))
+                    return true;
+            }
+            return false;
+        }
+
+        internal static List<Dialog> LiveList()
+        {
+            try
+            {
+                UIManager ui = PersistenSingleton<UIManager>.Instance;
+                DialogManager dm = ui != null ? ui.Dialogs : null;
+                return dm != null ? dm.ActiveDialogList : null;
+            }
+            catch { return null; }
+        }
+
+        private static Boolean InList(List<Dialog> list, Dialog d)
+        {
+            if (list == null)
+                return false;
+            for (Int32 k = 0; k < list.Count; k++)
+                if (ReferenceEquals(list[k], d))
+                    return true;
+            return false;
+        }
+
+        // Off-thread safe (see Mark): one volatile read, then a scan of an immutable array.
+        internal Boolean IsLocal(Dialog d)
+        {
+            Mark[] m = _local;
+            for (Int32 k = 0; k < m.Length; k++)
+                if (ReferenceEquals(m[k].D, d) && m[k].Id == d.Id && m[k].TextId == d.TextId)
+                    return true;
+            return false;
+        }
+
+        // TRUE while a lockable, non-Local, non-FlagButtonInh window is open -- the S4 SuppressLocalDialogInput
+        // body. FlagButtonInh is excluded: confirm is a no-op on it (Dialog.cs:789), and excluding it keeps a
+        // persistent [NFOC] HUD strip from swallowing Pause. Main thread (UIKeyTrigger / DialogManager.OnClick).
+        internal Boolean AnyLockedLine()
+        {
+            List<Dialog> list = LiveList();
+            if (list == null)
+                return false;
+            for (Int32 k = 0; k < list.Count; k++)
+            {
+                Dialog d = list[k];
+                if (IsLockable(d) && !d.FlagButtonInh && !IsLocal(d))
+                    return true;
+            }
+            return false;
+        }
+
+        private void RebuildMarks()
+        {
+            Int32 n = 0;
+            for (Int32 k = 0; k < _wins.Count; k++)
+                if (_wins[k].Cls == ClsLocal)
+                    n++;
+            Mark[] m = new Mark[n];
+            n = 0;
+            for (Int32 k = 0; k < _wins.Count; k++)
+                if (_wins[k].Cls == ClsLocal)
+                    m[n++] = new Mark(_wins[k].D, _wins[k].Id, _wins[k].TextId);
+            _local = m;                        // the one publish (volatile swap)
+        }
+
+        // Host-driven calls run under NetSyncClient.HostApplying so the DialogManager.OnItemSelect gate lets the
+        // engine's own re-select through (TrySetCurrentChoice -> ActiveButton -> Notify OnItemSelect).
+        private static void HostConfirm(Dialog d)
+        {
+            NetSyncClient.HostApplying = true;
+            try { d.OnKeyConfirm(d.gameObject); }
+            finally { NetSyncClient.HostApplying = false; }
+        }
+
+        private static Boolean HostSetChoice(Dialog d, Int32 c)
+        {
+            NetSyncClient.HostApplying = true;
+            try { return d.TrySetCurrentChoice(c); }
+            finally { NetSyncClient.HostApplying = false; }
+        }
+
+        // A choice is only ever written -- and a choice window only ever confirmed -- while the DIALOG's own button
+        // group is the active one: TrySetCurrentChoice writes ButtonGroupState.ActiveButton for whatever group is
+        // active (it would corrupt a menu's cursor), and Dialog.OnKeyConfirm commits IndexOf(ActiveButton).
+        private static Boolean DialogOwnsCursor()
+        {
+            return ButtonGroupState.ActiveGroup == Dialog.DialogGroupButton;
+        }
+
+        // ---- session edges --------------------------------------------------------------------------------
+
+        // The session ended (or never was): forget EVERYTHING -- inbox, windows, marks, clocks, the seq baseline.
+        internal void ResetAll()
+        {
+            _inbox.Clear();
+            _wins.Clear();
+            if (_local.Length > 0)
+                _local = NoMarks;              // allocation-free: this runs every frame on a host / plain selftest
+            _settle.Reset();
+            _haveSeq = false;
+            _capLogged = false;
+            _chip = null;
+        }
+
+        // The ~ menu panic unlock holds on THIS field (S5 step 1, "lock off: clear the inbox"): the host's events for
+        // it would otherwise sit for PendingTtlMs and page a re-opened line once a reload re-arms the lock. The seq
+        // baseline goes too -- the caller discards the FIFO unread, so the next ingest must re-baseline (a stale
+        // _lastRaw could read a fresh frame as a double-deliver after exactly 256 discarded).
+        internal void ClearInbox()
+        {
+            _inbox.Clear();
+            _haveSeq = false;
+            _capLogged = false;
+        }
+
+        // The lock is off while the session holds and the guest is OFF-field (a load/battle): the windows are gone,
+        // so forget them -- the inbox is KEPT (purged by field + TTL), so a guest that loads into the host's field
+        // behind it still catches up (TALK-7). (A panic-unlocked field clears the inbox instead: ClearInbox.)
+        internal void ForgetWindows()
+        {
+            _wins.Clear();
+            if (_local.Length > 0)
+                _local = NoMarks;
+            _settle.Reset();
+        }
+
+        // The session part of the lock ROSE this tick: every window already open predates it -> Local.
+        internal void MarkOpenLocal(Int32 myField)
+        {
+            List<Dialog> list = LiveList();
+            Int32 n = 0;
+            if (list != null)
+                for (Int32 k = 0; k < list.Count; k++)
+                {
+                    Dialog d = list[k];
+                    if (!IsLockable(d))
+                        continue;
+                    Win w = FindWin(d);
+                    if (w == null)
+                    {
+                        w = NewWin(d, myField);
+                        _wins.Add(w);
+                    }
+                    w.Cls = ClsLocal;
+                    n++;
+                }
+            RebuildMarks();
+            if (n > 0)
+                Log.Message("[NetSync] dialogue lock engaged -- " + n + " window(s) already open stay local (they predate it)");
+        }
+
+        // ---- ingest + purge ---------------------------------------------------------------------------------
+
+        // Normalize one type-7 payload ([fld u16][win u8][text u16][kind u8][idx u8][seq u8], the NetSyncSocket
+        // type table) into the seq-ordered inbox. The u8 seq is unwrapped by forward delta -- the FIFO is
+        // reliable and in order on a live link -- and a repeat of the last seq is a transport double-deliver.
+        internal void Ingest(Byte[] f, Int32 scene, Int32 now)
+        {
+            if (f == null || f.Length < 8)
+                return;
+            Byte raw = f[7];
+            Int32 seq;
+            if (!_haveSeq)
+            {
+                seq = raw;
+                _haveSeq = true;
+            }
+            else
+            {
+                Int32 delta = (raw - _lastRaw) & 0xFF;
+                if (delta == 0)
+                    return;                    // double-deliver
+                seq = _lastSeq + delta;
+            }
+            _lastRaw = raw;
+            _lastSeq = seq;
+            DlgEvent e = new DlgEvent();
+            e.Seq = seq;
+            e.Raw = raw;
+            e.Kind = f[5];
+            e.Scene = scene;
+            e.Fld = f[0] | (f[1] << 8);
+            e.Win = f[2];
+            e.Text = f[3] | (f[4] << 8);
+            e.C = f[6];
+            e.FirstSeen = now;
+            if (e.Kind != KindAdv && e.Kind != KindCho)
+            {
+                Log.Message("[NetSync] dialogue: host seq " + raw + " has unknown kind " + e.Kind + " -- ignored");
+                return;
+            }
+            _inbox.Add(e);                     // arrival order IS seq order (monotonic unwrap)
+            if (!_quiet)
+                Log.Message("[NetSync] dialogue: host seq " + raw + " queued (field " + e.Fld + " win " + e.Win + " text " + e.Text
+                            + " kind " + e.Kind + (e.Kind == KindCho ? " choice " + e.C : "") + ")");
+            if (_inbox.Count > InboxCap)
+            {
+                DlgEvent old = _inbox[0];
+                _inbox.RemoveAt(0);
+                if (!_capLogged && !_quiet)
+                {
+                    _capLogged = true;
+                    Log.Message("[NetSync] dialogue inbox hit its cap (" + InboxCap + ") -- oldest dropped (host seq " + old.Raw
+                                + ", win " + old.Win + " text " + old.Text + ")");
+                }
+            }
+            else if (_inbox.Count <= InboxCap / 2)
+                _capLogged = false;
+        }
+
+        // At a relay ACCEPT (ServiceTalkFollow): drop every event left over from an EARLIER host scene whose window
+        // is not open -- the guard against the 14.2% duplicate-key reopens catching a stale page. `talkScene` is the
+        // ACCEPTED start's own scene (the section-5 nonce in the first state frame that carried it), NOT the host's
+        // scene right now: a deferred start can be accepted after the host's next scene rose, and comparing against
+        // that would drop the very events the late start catches up from (TALK-7). Only EARLIER scenes are dropped
+        // (divergence E) -- a later scene's events are current, never leftovers.
+        internal void PurgeAtRelayAccept(Int32 talkScene)
+        {
+            for (Int32 k = _inbox.Count - 1; k >= 0; k--)
+            {
+                DlgEvent e = _inbox[k];
+                if (!SceneBefore(e.Scene, talkScene) || KeyOpen(e))
+                    continue;
+                _inbox.RemoveAt(k);
+                if (!_quiet)
+                    Log.Message("[NetSync] dialogue: host seq " + e.Raw + " (win " + e.Win + " text " + e.Text
+                                + ") dropped -- from an earlier host scene (a new talk was relayed)");
+            }
+        }
+
+        // TRUE when an event stamped `scene` predates the scene `current` (u8 nonces, wrap-aware: within 128 scenes,
+        // far beyond the PendingTtlMs window). An event stamped -1 (no section 5 on the lane at ingest) counts as
+        // earlier; a `current` of -1 (unknown) makes nothing earlier.
+        internal static Boolean SceneBefore(Int32 scene, Int32 current)
+        {
+            if (current < 0)
+                return false;
+            if (scene < 0)
+                return true;
+            Int32 d = (current - scene) & 0xFF;
+            return d != 0 && d < 128;
+        }
+
+        private void Purge(ref GuestView v)
+        {
+            for (Int32 k = _inbox.Count - 1; k >= 0; k--)
+            {
+                DlgEvent e = _inbox[k];
+                String why = null;
+                if (e.Fld != v.MyField && e.Fld != v.WarpField && e.Fld != v.HostField)
+                    why = "dropped -- it is for field " + e.Fld;
+                else if (v.Now - e.FirstSeen >= PendingTtlMs && !AwaitedByOpenWindow(e))
+                    why = e.Tried ? "aged out -- it never advanced its window" : "aged out -- no matching window opened";
+                if (why == null)
+                    continue;
+                _inbox.RemoveAt(k);
+                Log.Message("[NetSync] dialogue: host seq " + e.Raw + " (win " + e.Win + " text " + e.Text + ") " + why);
+            }
+        }
+
+        private Boolean KeyOpen(DlgEvent e)
+        {
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                if (w.Field == e.Fld && w.Id == e.Win && w.TextId == e.Text)
+                    return true;
+            }
+            return false;
+        }
+
+        // The TTL exemption: an untried event whose OPEN, driven, non-FlagButtonInh window is still on its way
+        // to applying it (printing, MinShowMs, a pause, IsChoiceReady). A FlagButtonInh window's event ages out
+        // (memory LAW :1369 -- a frame is never fabricated for, or forced onto, an input-inhibited line), and one
+        // that was tried without advancing ages out too, so no event can claim a window forever.
+        private Boolean AwaitedByOpenWindow(DlgEvent e)
+        {
+            if (e.Tried)
+                return false;
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                if (w.Cls != ClsLocal && w.Field == e.Fld && w.Id == e.Win && w.TextId == e.Text && !w.D.FlagButtonInh)
+                    return true;
+            }
+            return false;
+        }
+
+        private DlgEvent EarliestFor(Win w)
+        {
+            for (Int32 k = 0; k < _inbox.Count; k++)
+            {
+                DlgEvent e = _inbox[k];
+                if (e.Fld == w.Field && e.Win == w.Id && e.Text == w.TextId)
+                    return e;
+            }
+            return null;
+        }
+
+        // ---- the guest tick (S5 steps 3-8; NetSyncClient did 1-2) ---------------------------------------------
+
+        internal struct GuestView
+        {
+            public Boolean Engaged;        // the lock this tick (NetSyncClient._lockEngaged)
+            public Boolean Live;           // the session reads live right now (false = inside LinkGraceMs)
+            public Int32 MyField;
+            public Int32 WarpField;        // a follow-warp in flight (-1 = none)
+            public Int32 HostField;        // the host's field when its lane is valid (-1 = unknown)
+            public Boolean HostSceneUp;    // section 5: the host's sticky scene
+            public Boolean TalkLiveHere;   // section 6: a relayed start for MY field is on the lane
+            public Boolean CoLocated;
+            public Boolean HostElsewhere;  // on another real field and no SectionIntent points here
+            public Boolean HostOffField;   // field 0 and no live host battle
+            public Boolean RelayOwned;     // a relayed start was accepted < RelayOwnMs ago
+            public Int32 Now;
+        }
+
+        internal void GuestTick(ref GuestView v)
+        {
+            Purge(ref v);
+            if (!v.Engaged)
+            {
+                ForgetWindows();
+                _chip = v.HostSceneUp && v.CoLocated ? ChipHostScene : null;
+                return;
+            }
+            List<Dialog> list = LiveList();
+            Track(list, ref v);
+            Boolean paused = false;
+            try
+            {
+                UIManager ui = PersistenSingleton<UIManager>.Instance;
+                paused = ui == null || ui.IsPause;
+            }
+            catch { paused = true; }
+            if (!paused)
+            {
+                ApplyEvents(list, ref v);      // step 5 -- stock DialogManager.cs:337 parity: nothing is driven while paused
+                CursorLock(list);              // step 6 (the pause menu owns the cursor while paused)
+            }
+            Orphans(list, paused, ref v);      // step 7
+            UpdateChip(ref v);                 // step 8
+        }
+
+        private static Win NewWin(Dialog d, Int32 field)
+        {
+            Win w = new Win();
+            w.D = d;
+            w.Field = field;
+            w.Id = d.Id;
+            w.TextId = d.TextId;
+            w.Page = d.CurrentPage;
+            w.Cls = ClsLocked;
+            return w;
+        }
+
+        private Win FindWin(Dialog d)
+        {
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                if (ReferenceEquals(w.D, d) && w.Id == d.Id && w.TextId == d.TextId)
+                    return w;
+            }
+            return null;
+        }
+
+        // Step 4: register each new lockable window (Locked unless already marked Local), keep the read clock,
+        // drop departed ones -- attributing a close we did NOT apply to the window's own script/timer.
+        private void Track(List<Dialog> list, ref GuestView v)
+        {
+            for (Int32 k = 0; k < _wins.Count; k++)
+                _wins[k].Seen = false;
+            if (list != null)
+                for (Int32 k = 0; k < list.Count; k++)
+                {
+                    Dialog d = list[k];
+                    if (!IsLockable(d))
+                        continue;
+                    Win w = FindWin(d);
+                    if (w == null)
+                    {
+                        w = NewWin(d, v.MyField);
+                        if (IsLocal(d))
+                            w.Cls = ClsLocal;
+                        _wins.Add(w);
+                        if (w.Cls == ClsLocked)
+                            Log.Message("[NetSync] dialogue lock: win " + w.Id + " text " + w.TextId + " opened locked (the host drives it)");
+                    }
+                    w.Seen = true;
+                    Int32 page = d.CurrentPage;
+                    if (page != w.Page)
+                    {
+                        w.Page = page;
+                        w.CompleteArmed = false;
+                    }
+                    if (d.CurrentState == Dialog.State.CompleteAnimation)
+                    {
+                        if (!w.CompleteArmed)
+                        {
+                            w.CompleteArmed = true;
+                            w.CompleteSince = v.Now;
+                        }
+                    }
+                    else
+                        w.CompleteArmed = false;
+                }
+            Boolean marksDirty = false;
+            for (Int32 k = _wins.Count - 1; k >= 0; k--)
+            {
+                Win w = _wins[k];
+                if (w.Seen)
+                    continue;
+                _wins.RemoveAt(k);
+                if (w.Cls == ClsLocal)
+                    marksDirty = true;
+                else if (!w.ClosedByUs)
+                    Log.Message("[NetSync] dialogue: win " + w.Id + " text " + w.TextId + " closed by its own script/timer");
+            }
+            if (marksDirty)
+                RebuildMarks();
+        }
+
+        private static Boolean Advanced(List<Dialog> list, Dialog d, Int32 id, Int32 textId, Int32 page, Boolean choice)
+        {
+            return !InList(list, d) || d.Id != id || d.TextId != textId
+                || d.CurrentState != Dialog.State.CompleteAnimation || d.CurrentPage != page
+                || (choice && VoicePlayer.closeDialogOnFinish);   // a voiced choice closes later via VoicePlayer's own OnKeyConfirm(null)
+        }
+
+        // Step 5: at most one event per window per tick, per KEY in host order.
+        private void ApplyEvents(List<Dialog> list, ref GuestView v)
+        {
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                if (w.Cls == ClsLocal)
+                    continue;
+                Dialog d = w.D;
+                if (!InList(list, d) || d.Id != w.Id || d.TextId != w.TextId)
+                    continue;                  // left since Track (a confirm on another window can't do that, but be exact)
+                DlgEvent e = EarliestFor(w);
+                if (e == null)
+                    continue;
+                if (w.Cls == ClsOrphaned)
+                {
+                    w.Cls = ClsLocked;
+                    Log.Message("[NetSync] dialogue: late host event for win " + w.Id + " text " + w.TextId + " (host seq " + e.Raw + ") -- back under the host");
+                }
+                if (d.FlagButtonInh)
+                    continue;                  // memory LAW :1369: never forced onto an input-inhibited line -- the event ages out
+                Dialog.State st = d.CurrentState;
+                if (st == Dialog.State.TextAnimation)
+                {
+                    HostConfirm(d);            // fast-forward the typewriter (Dialog.cs:803-806) and HOLD the event
+                    continue;
+                }
+                if (st != Dialog.State.CompleteAnimation || !w.CompleteArmed || v.Now - w.CompleteSince < MinShowMs)
+                    continue;                  // opening / just completed: catch-up readability
+                Boolean choice = d.HasChoices;
+                if (choice && (!d.IsChoiceReady || !DialogOwnsCursor()))
+                    continue;                  // DLG-7 (Dialog.cs:163-164); and never under another UI's cursor
+                Int32 picked = -1;
+                if (choice)
+                {
+                    Int32 want = e.Kind == KindCho ? e.C : d.SelectChoice;
+                    if (HostSetChoice(d, want))
+                        picked = want;
+                    else
+                    {
+                        HostSetChoice(d, d.DefaultChoice);   // DLG-10: never the guest's cursor
+                        picked = d.DefaultChoice;
+                        if (!e.FallbackLogged)
+                        {
+                            e.FallbackLogged = true;
+                            Log.Message("[NetSync] dialogue: host choice " + want + " is out of range on win " + w.Id + " text " + w.TextId
+                                        + " -- its default (" + d.DefaultChoice + ") instead");
+                        }
+                    }
+                }
+                Boolean closes = !(d.SubPage.Count > d.CurrentPage);   // Hide()'s own test (Dialog.cs:621), read BEFORE it
+                Int32 page = d.CurrentPage;
+                HostConfirm(d);
+                if (Advanced(list, d, w.Id, w.TextId, page, choice))
+                {
+                    _inbox.Remove(e);
+                    if (closes)
+                        w.ClosedByUs = true;       // its departure is the host's close (a voiced choice departs later, still ours)
+                    Log.Message("[NetSync] dialogue: win " + w.Id + " text " + w.TextId + (closes ? " closed" : " advanced") + " (host seq " + e.Raw
+                                + (picked >= 0 ? ", choice " + picked : "") + ")");
+                }
+                else
+                {
+                    e.Tried = true;            // kept: retried every tick; it ages out from the TTL (AwaitedByOpenWindow)
+                    if (!e.TriedLogged)
+                    {
+                        e.TriedLogged = true;
+                        Log.Message("[NetSync] dialogue: host seq " + e.Raw + " did not advance win " + w.Id + " text " + w.TextId + " -- kept, retrying");
+                    }
+                }
+            }
+        }
+
+        // Step 6: the guest's arrows / hover / drag never move a locked choice (OnItemSelect is gated, so
+        // SelectChoice holds) -- re-assert the highlight onto the window's own SelectChoice. (C3: the host's cursor.)
+        // FlagButtonInh (script-polled) windows are SKIPPED, like the OnDrag/OnItemSelect gates
+        // (NetSyncClient.IsGuestLockedChoice): in C2 their confirm/cancel stay the guest's own (design D -- the KEY
+        // relay is C3), so freezing only the cursor would let the guest's poll commit nothing but the default.
+        // C2 GAP, documented: a NON-Inh choice that a script POLLS (IsButton + GetDialogChoice) keeps the frozen
+        // cursor while the raw poll still reads the guest's confirm, so it commits the default unless the host's
+        // CHO lands first -- until C3 carries the host cursor and press.
+        private void CursorLock(List<Dialog> list)
+        {
+            if (!DialogOwnsCursor())
+                return;
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                if (w.Cls == ClsLocal)
+                    continue;
+                Dialog d = w.D;
+                if (d.FlagButtonInh)
+                    continue;
+                if (!InList(list, d) || d.Id != w.Id || d.TextId != w.TextId)
+                    continue;
+                if (d.CurrentState != Dialog.State.CompleteAnimation || !d.IsChoiceReady)
+                    continue;
+                Int32 expected = d.SelectChoice;
+                if (!d.IsCurrentChoice(expected))
+                    HostSetChoice(d, expected);
+            }
+        }
+
+        private Boolean HasEventFor(Win w)
+        {
+            return EarliestFor(w) != null;
+        }
+
+        // Step 7: release a window ONLY when the host provably lacks it. HostSettled = the sticky scene is down,
+        // no relayed start for this field is live, and the host is co-located (now) / elsewhere with no intent
+        // here (HostElsewhereMs) / off-field with no live battle (OffFieldMaxMs); settledLong = that, held for
+        // OrphanGraceMs. Then an UNCLAIMED locked window (no inbox event for its key, no relay accepted in the
+        // last RelayOwnMs) is handed back if script-polled (FlagButtonInh) or orphaned -- and an orphan is
+        // auto-confirmed page by page at reading pace, choice = Cancel else Default (owner decision 2).
+        private void Orphans(List<Dialog> list, Boolean paused, ref GuestView v)
+        {
+            _settle.Step(!v.HostSceneUp, v.TalkLiveHere, v.CoLocated, v.HostElsewhere, v.HostOffField, v.Now);
+            Boolean marksDirty = false;
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                if (w.Cls == ClsLocal)
+                    continue;
+                Dialog d = w.D;
+                if (!InList(list, d) || d.Id != w.Id || d.TextId != w.TextId)
+                    continue;
+                Boolean eventPending = HasEventFor(w);
+                Boolean choice = d.HasChoices;
+                Boolean ready = !paused && d.CurrentState == Dialog.State.CompleteAnimation && w.CompleteArmed
+                             && (!choice || (d.IsChoiceReady && DialogOwnsCursor()));   // never under another UI's cursor
+                Int32 act = OrphanStep(w.Cls, _settle.Long, eventPending, v.RelayOwned, d.FlagButtonInh, ready,
+                                       w.CompleteSince, w.OrphanSince, v.Now);
+                if (act == OrphNone)
+                    continue;
+                if (act == OrphToLocal)
+                {
+                    w.Cls = ClsLocal;
+                    marksDirty = true;
+                    Log.Message("[NetSync] dialogue: win " + w.Id + " text " + w.TextId + " handed back: script-polled line, host idle");
+                    continue;
+                }
+                if (act == OrphToOrphaned)
+                {
+                    w.Cls = ClsOrphaned;
+                    w.OrphanSince = v.Now;
+                    w.RetryLogged = false;
+                    Log.Message("[NetSync] dialogue orphan: win " + w.Id + " text " + w.TextId + " is not on the host's screen (host idle "
+                                + (_settle.SettledMs / 1000) + "s) -- closing it at reading pace");
+                    continue;
+                }
+                if (act == OrphToLocked)
+                {
+                    w.Cls = ClsLocked;         // never auto-close mid-scene, nor over a host event (ApplyEvents drives it)
+                    Log.Message("[NetSync] dialogue orphan: win " + w.Id + " text " + w.TextId
+                                + (eventPending ? " held -- a late host event arrived" : " held -- the host is busy again"));
+                    continue;
+                }
+                // OrphConfirm: the page has been up AutoReadMs -- confirm it as the host would, choice = Cancel else Default
+                Int32 pick = -1;
+                if (choice)
+                {
+                    pick = OrphanChoice(d.CancelChoice, d.DefaultChoice);
+                    if (!HostSetChoice(d, pick))
+                    {
+                        pick = d.DefaultChoice;
+                        HostSetChoice(d, pick);
+                    }
+                }
+                Boolean closes = !(d.SubPage.Count > d.CurrentPage);   // Hide()'s own test (Dialog.cs:621), read BEFORE it
+                Int32 page = d.CurrentPage;
+                HostConfirm(d);
+                if (Advanced(list, d, w.Id, w.TextId, page, choice))
+                {
+                    if (closes)
+                    {
+                        w.ClosedByUs = true;
+                        _orphanCloses++;
+                        Log.Message("[NetSync] dialogue orphan: win " + w.Id + " text " + w.TextId + " auto-closed (host idle "
+                                    + (_settle.SettledMs / 1000) + "s, choice " + pick + ")");
+                    }
+                }
+                else
+                {
+                    w.OrphanSince = v.Now;     // re-arm the read clock: one attempt per AutoReadMs, never a per-tick confirm
+                    if (!w.RetryLogged)
+                    {
+                        w.RetryLogged = true;
+                        Log.Message("[NetSync] dialogue orphan: win " + w.Id + " text " + w.TextId + " did not take the auto-confirm -- retrying");
+                    }
+                }
+            }
+            if (marksDirty)
+                RebuildMarks();
+        }
+
+        // The per-window orphan decision (S5 step 7) as a PURE step, so SelfTest scripts it (A11) -- Orphans() only
+        // reads the engine and acts on the verdict. Inputs: the window's class; settledLong (the host settled for
+        // OrphanGraceMs); eventPending (an inbox event for its key) and relayOwned (a relayed start accepted under
+        // RelayOwnMs ago) -- the two claims; inh (FlagButtonInh: script-polled); ready (not paused, the page complete
+        // with its read clock armed, and a choice IsChoiceReady under the dialog's own cursor); the two read-clock
+        // ticks and now (wrap-safe deltas only). One action per tick.
+        internal const Int32 OrphNone = 0, OrphToOrphaned = 1, OrphToLocal = 2, OrphToLocked = 3, OrphConfirm = 4;
+
+        internal static Int32 OrphanStep(Byte cls, Boolean settledLong, Boolean eventPending, Boolean relayOwned, Boolean inh,
+                                         Boolean ready, Int32 completeSince, Int32 orphanSince, Int32 now)
+        {
+            if (cls == ClsLocked)
+            {
+                if (!settledLong || eventPending || relayOwned)
+                    return OrphNone;           // the host is busy, or the window is claimed: it stays the host's
+                return inh ? OrphToLocal : OrphToOrphaned;
+            }
+            if (cls != ClsOrphaned)
+                return OrphNone;               // Local is never touched
+            if (eventPending || !settledLong)
+                return OrphToLocked;           // a late host event (ApplyEvents flips it first when not paused), or the host busy again
+            if (inh)
+                return OrphToLocal;
+            if (!ready)
+                return OrphNone;
+            // reading pace: AutoReadMs from the LATER of "this page completed" and "orphaned" (wrap-safe compare) --
+            // a failed confirm re-arms orphanSince, so a retry is one attempt per AutoReadMs, never per tick
+            Int32 since = (orphanSince - completeSince) > 0 ? orphanSince : completeSince;
+            return now - since >= AutoReadMs ? OrphConfirm : OrphNone;
+        }
+
+        // The orphan's auto-close choice (owner decision 2): the window's Cancel choice, else its Default.
+        internal static Int32 OrphanChoice(Int32 cancelChoice, Int32 defaultChoice)
+        {
+            return cancelChoice >= 0 ? cancelChoice : defaultChoice;
+        }
+
+        private void UpdateChip(ref GuestView v)
+        {
+            Boolean locked = false, orphaned = false;
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                if (w.Cls == ClsOrphaned)
+                    orphaned = true;
+                else if (w.Cls == ClsLocked && !w.D.FlagButtonInh)
+                    locked = true;             // a script-polled strip is not "a conversation"
+            }
+            if (!v.Live && (locked || orphaned))
+                _chip = ChipHiccup;
+            else if (orphaned)
+                _chip = ChipClosing;
+            else if (locked)
+                _chip = ChipFollowing;
+            else if (v.HostSceneUp && v.CoLocated)
+                _chip = ChipHostScene;
+            else
+                _chip = null;
+        }
+
+        // ---- telemetry (HarnessAgent, main thread) ---------------------------------------------------------
+
+        internal struct WindowView
+        {
+            public Int32 Field, Win, Text, Page;
+            public String Cls, State;
+            public Boolean Inh;
+        }
+
+        internal struct EventView
+        {
+            public Int32 Field, Win, Text, Kind, Index, Seq, Scene, AgeMs;
+            public Boolean Tried;
+        }
+
+        internal static String ClsName(Byte cls)
+        {
+            return cls == ClsLocked ? "locked" : cls == ClsOrphaned ? "orphaned" : "local";
+        }
+
+        internal List<WindowView> SnapshotWindows()
+        {
+            List<WindowView> r = new List<WindowView>(_wins.Count);
+            for (Int32 k = 0; k < _wins.Count; k++)
+            {
+                Win w = _wins[k];
+                WindowView x = new WindowView();
+                x.Field = w.Field;
+                x.Win = w.Id;
+                x.Text = w.TextId;
+                x.Page = w.Page;
+                x.Cls = ClsName(w.Cls);
+                x.State = w.D.CurrentState.ToString();
+                x.Inh = w.D.FlagButtonInh;
+                r.Add(x);
+            }
+            return r;
+        }
+
+        // The HEAD (earliest) event of each key -- what each window would apply next -- at most `max`.
+        internal List<EventView> SnapshotHeads(Int32 now, Int32 max)
+        {
+            List<EventView> r = new List<EventView>();
+            for (Int32 k = 0; k < _inbox.Count && r.Count < max; k++)
+            {
+                DlgEvent e = _inbox[k];
+                Boolean head = true;
+                for (Int32 p = 0; p < k; p++)
+                {
+                    DlgEvent q = _inbox[p];
+                    if (q.Fld == e.Fld && q.Win == e.Win && q.Text == e.Text)
+                    {
+                        head = false;
+                        break;
+                    }
+                }
+                if (!head)
+                    continue;
+                EventView x = new EventView();
+                x.Field = e.Fld;
+                x.Win = e.Win;
+                x.Text = e.Text;
+                x.Kind = e.Kind;
+                x.Index = e.C;
+                x.Seq = e.Raw;
+                x.Scene = e.Scene;
+                x.AgeMs = now - e.FirstSeen;
+                x.Tried = e.Tried;
+                r.Add(x);
+            }
+            return r;
+        }
+
+        // ---- the two state machines (pure: driven by NetSyncClient with engine reads, by SelfTest with scripts) --
+
+        // HOST (S2): the STICKY scene flag. The old flag (!control && a dialog visible) dropped in every gap between
+        // windows -- a window leaves the list in AfterHidden and the waiting script resumes only on a later pass
+        // (EBin.cs:144-156) -- bumping the nonce per window. Sticky: RISE when a line opens with control off; HOLD
+        // through gaps, walks, script menus and off-field (a scripted Battle() continues through Main_Reinit); FALL
+        // only on control back for SceneFallMs, a field change, or the world map. One nonce per scene; StartAt forces
+        // a new one (each relayed talk gets its own scene from the press). Rule from design A: a rule keyed on
+        // windows CLOSING would never fall on a field with a persistent [NFOC] HUD strip.
+        internal sealed class HostSceneMachine
+        {
+            public Boolean Active;
+            public Byte Nonce;
+            public Int32 Field = -1;
+            private Boolean _quietArmed;
+            private Int32 _quietSince;
+
+            // 0 = no edge, 1 = rose, 2 = fell; `why` names the edge.
+            public Int32 Step(Boolean onField, Int32 fld, Boolean ctl, Boolean worldMap, Boolean anyLine, Int32 now, out String why)
+            {
+                why = null;
+                if (!Active)
+                {
+                    if (onField && !ctl && anyLine)
+                    {
+                        Rise(fld);
+                        why = "a line opened with control off";
+                        return 1;
+                    }
+                    return 0;
+                }
+                if (onField && fld != Field)
+                {
+                    Fall();
+                    why = "field change";
+                    return 2;
+                }
+                if (worldMap)
+                {
+                    Fall();
+                    why = "world map";
+                    return 2;
+                }
+                if (onField && ctl)
+                {
+                    if (!_quietArmed)
+                    {
+                        _quietArmed = true;
+                        _quietSince = now;     // tick-baseline law: a real tick, read only while armed
+                    }
+                    else if (now - _quietSince >= SceneFallMs)
+                    {
+                        Fall();
+                        why = "control back";
+                        return 2;
+                    }
+                    return 0;
+                }
+                _quietArmed = false;           // control still off (gaps, walks, script menus) or off-field (battle): HOLD
+                return 0;
+            }
+
+            // A relayed talk / promoted quad: a scene of its own from the press. TRUE when an active scene fell first.
+            public Boolean StartAt(Int32 fld)
+            {
+                Boolean fell = Active;
+                if (Active)
+                    Fall();
+                Rise(fld);
+                return fell;
+            }
+
+            public void Reset()
+            {
+                Active = false;
+                Nonce = 0;
+                Field = -1;
+                _quietArmed = false;
+            }
+
+            private void Rise(Int32 fld)
+            {
+                Active = true;
+                Nonce = (Byte)(Nonce + 1);
+                Field = fld;
+                _quietArmed = false;
+            }
+
+            private void Fall()
+            {
+                Active = false;
+                _quietArmed = false;
+            }
+        }
+
+        // GUEST (S5 step 7): HostSettled and its OrphanGraceMs hold. Every leg is an armed bool + delta.
+        internal sealed class SettleClock
+        {
+            private Boolean _elseArmed, _offArmed, _setArmed;
+            private Int32 _elseSince, _offSince, _setSince;
+            public Boolean Settled;
+            public Boolean Long;
+            public Int32 SettledMs = -1;
+
+            public void Step(Boolean sceneDown, Boolean talkLive, Boolean coLocated, Boolean elsewhere, Boolean offField, Int32 now)
+            {
+                if (elsewhere)
+                {
+                    if (!_elseArmed)
+                    {
+                        _elseArmed = true;
+                        _elseSince = now;
+                    }
+                }
+                else
+                    _elseArmed = false;
+                if (offField)
+                {
+                    if (!_offArmed)
+                    {
+                        _offArmed = true;
+                        _offSince = now;
+                    }
+                }
+                else
+                    _offArmed = false;
+                Boolean where = coLocated
+                             || (_elseArmed && now - _elseSince >= HostElsewhereMs)
+                             || (_offArmed && now - _offSince >= OffFieldMaxMs);
+                Settled = sceneDown && !talkLive && where;
+                if (Settled)
+                {
+                    if (!_setArmed)
+                    {
+                        _setArmed = true;
+                        _setSince = now;
+                    }
+                    SettledMs = now - _setSince;
+                }
+                else
+                {
+                    _setArmed = false;
+                    SettledMs = -1;
+                }
+                Long = Settled && SettledMs >= OrphanGraceMs;
+            }
+
+            public void Reset()
+            {
+                _elseArmed = _offArmed = _setArmed = false;
+                Settled = Long = false;
+                SettledMs = -1;
+            }
+        }
+
+        // ---- SelfTest (S1; logged by NetSyncClient's selftest proof block) -----------------------------------
+        // PURE: scripted (onField, field, control, line) and (scene, talk, where) sequences against the two state
+        // machines, the per-window orphan step (OrphanStep, with the Int32 tick wrap), plus the inbox's seq unwrap /
+        // dedup / per-key FIFO / cap. Touches no engine object, so it proves the logic solo at selftest start; the
+        // in-game behaviour (Orphans() acting on a live Dialog) is the harness's job (A1-A12).
+        internal static Boolean SelfTest(out String detail)
+        {
+            String fail = null;
+            try
+            {
+                fail = HostSceneScript() ?? SettleScript() ?? OrphanScript() ?? InboxScript();
+            }
+            catch (Exception err)
+            {
+                fail = "threw " + err.GetType().Name + ": " + err.Message;
+            }
+            detail = fail ?? "host scene: one nonce across gaps, holds through control-off and battle, falls "
+                           + SceneFallMs + " ms after control returns, a new press forces a new nonce; guest orphan clock: "
+                           + OrphanGraceMs + " ms grace, elsewhere " + HostElsewhereMs + " ms, off-field " + OffFieldMaxMs
+                           + " ms, battle never; orphan step: claims hold, polled lines hand back, auto-close "
+                           + AutoReadMs + " ms after the later of complete/orphaned (Cancel else Default), late event or busy host re-locks;"
+                           + " inbox: seq unwrap/dedup/per-key FIFO/cap " + InboxCap + ", relay-accept purge = earlier scenes only";
+            return fail == null;
+        }
+
+        private static String HostSceneScript()
+        {
+            HostSceneMachine m = new HostSceneMachine();
+            String why;
+            const Int32 F = 100, T0 = 1000000;   // an arbitrary base tick: the machine reads deltas only
+            if (m.Step(true, F, true, false, false, T0, out why) != 0 || m.Active)
+                return "host: rose with control on and no line";
+            if (m.Step(true, F, true, false, true, T0 + 10, out why) != 0)
+                return "host: rose on an ambient line with control on";
+            if (m.Step(true, F, false, false, true, T0 + 20, out why) != 1 || m.Nonce != 1)
+                return "host: did not rise on a line with control off";
+            if (m.Step(true, F, false, false, false, T0 + 200, out why) != 0 || !m.Active)
+                return "host: fell in a window gap";
+            if (m.Step(true, F, true, false, false, T0 + 300, out why) != 0 || m.Step(true, F, true, false, false, T0 + 700, out why) != 0)
+                return "host: fell before SceneFallMs of control";
+            if (m.Step(true, F, false, false, true, T0 + 750, out why) != 0 || m.Nonce != 1)
+                return "host: a control-off blip after a quiet start bumped the nonce";
+            if (m.Step(true, F, true, false, false, T0 + 800, out why) != 0 || m.Step(true, F, true, false, false, T0 + 1200, out why) != 0)
+                return "host: the quiet clock did not restart after control went off again";
+            if (m.Step(false, 0, false, false, false, T0 + 1250, out why) != 0 || m.Step(false, 0, false, false, false, T0 + 60000, out why) != 0 || !m.Active)
+                return "host: did not hold through off-field (battle)";
+            if (m.Step(true, F, true, false, false, T0 + 60010, out why) != 0 || m.Step(true, F, true, false, false, T0 + 60510, out why) != 2 || m.Active)
+                return "host: did not fall " + SceneFallMs + " ms after control returned";
+            m.StartAt(F);
+            if (!m.Active || m.Nonce != 2)
+                return "host: StartAt did not open a fresh scene";
+            if (!m.StartAt(F) || m.Nonce != 3)
+                return "host: StartAt on an active scene did not force a new nonce";
+            if (m.Step(true, F + 1, false, false, true, T0 + 70000, out why) != 2)
+                return "host: a field change did not end the scene";
+            m.Step(true, F + 1, false, false, true, T0 + 70010, out why);
+            if (!m.Active || m.Nonce != 4 || m.Step(false, 0, false, true, false, T0 + 70020, out why) != 2)
+                return "host: the world map did not end the scene";
+            return null;
+        }
+
+        private static String SettleScript()
+        {
+            SettleClock c = new SettleClock();
+            const Int32 T0 = 2000000;
+            c.Step(true, false, true, false, false, T0);
+            if (!c.Settled || c.Long)
+                return "guest: co-located idle host did not read settled (or read long at once)";
+            c.Step(true, false, true, false, false, T0 + OrphanGraceMs - 1);
+            if (c.Long)
+                return "guest: settledLong before OrphanGraceMs";
+            c.Step(true, false, true, false, false, T0 + OrphanGraceMs);
+            if (!c.Long)
+                return "guest: not settledLong after OrphanGraceMs";
+            c.Step(false, false, true, false, false, T0 + OrphanGraceMs + 10);
+            if (c.Settled || c.Long)
+                return "guest: a host scene did not unsettle";
+            c.Step(true, true, true, false, false, T0 + OrphanGraceMs + 20);
+            if (c.Settled)
+                return "guest: a live relayed start did not unsettle";
+            c.Reset();
+            c.Step(true, false, false, true, false, T0);
+            c.Step(true, false, false, true, false, T0 + HostElsewhereMs - 1);
