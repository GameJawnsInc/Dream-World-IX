+                return "orphan: a fresh page was not auto-confirmed after AutoReadMs";
+            if (OrphanStep(ClsOrphaned, true, false, false, false, false, c, o, unchecked(c + 100000)) != OrphNone)
+                return "orphan: auto-confirmed a page that is not ready (printing, paused, or a choice not ready)";
