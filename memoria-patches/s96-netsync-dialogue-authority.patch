+            if (OrphanStep(ClsLocked, true, true, false, false, true, c, o, t0) != OrphNone)
+                return "orphan: a line with a host event pending was orphaned";
+            if (OrphanStep(ClsLocked, true, false, true, false, true, c, o, t0) != OrphNone)
+                return "orphan: a line inside RelayOwnMs was orphaned";
+            if (OrphanStep(ClsLocked, true, false, false, false, true, c, o, t0) != OrphToOrphaned)
